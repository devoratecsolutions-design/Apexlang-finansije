    region izv-dokumenti (
        name: Pregled dokumenata
        title: Pregled dokumenata
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT d.id,
                       d.naziv,
                       d.vrsta_naziv,
                       to_char(d.datum, 'DD.MM.YYYY') AS datum,
                       d.skladiste_sifra AS skladiste,
                       coalesce(d.klijent_naziv, d.mjesto_troska_naziv, d.zaduzeni_radnik_naziv, d.skladiste_prenos_naziv) AS partner,
                       CASE WHEN d.stornirano = 'Y' THEN 'Storniran' WHEN d.glavna_knjiga_id IS NOT NULL THEN 'Proknjižen'
                            WHEN d.status = 'Z' THEN 'Zaključen' ELSE 'U pripremi' END AS status,
                       d.stavki,
                       to_char(d.iznos, 'FM999G999G999G990D00') AS iznos,
                       CASE WHEN d.v2 = 'Y' THEN apex_page.get_url(p_page => 331, p_items => 'P331_ID', p_values => d.id, p_clear_cache => 331)
                            ELSE apex_page.get_url(p_page => 332, p_items => 'P332_ID', p_values => d.id) END AS url
                FROM vw_rm_dokumenti d
                WHERE d.ooj_id = :APP_OOJ_ID
                  AND (:P371_SKLADISTE_ID IS NULL OR d.skladiste_id = to_number(:P371_SKLADISTE_ID))
                  AND (:P371_SKLADISTE_ID IS NOT NULL OR nvl(rm_skladiste_pkg.modul(d.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                  AND d.datum BETWEEN to_date(:P371_OD, 'DD.MM.YYYY') AND to_date(:P371_DO, 'DD.MM.YYYY')
                  AND (:P371_VRSTA IS NULL OR d.vrsta_sifra = :P371_VRSTA)
                ORDER BY d.datum DESC, d.id DESC
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
                P371_OD
                P371_DO
                P371_VRSTA
            ]
        }
        layout {
            sequence: 60
            parentRegion: @izvjestaj
            slot: subRegions
        }
