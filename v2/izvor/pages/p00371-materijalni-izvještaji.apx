    region izv-starost (
        name: Starost zaliha (bez izlaza)
        title: Starost zaliha (bez izlaza)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT x.artikal_sifra,
                       x.artikal_naziv,
                       x.jm_naziv,
                       x.kolicina,
                       x.vrijednost,
                       x.zadnji_ulaz,
                       x.zadnji_izlaz,
                       trunc(sysdate) - trunc(nvl(x.zadnji_izlaz, x.zadnji_ulaz)) AS dana
                FROM (SELECT p.stavka_id, p.artikal_sifra, p.artikal_naziv, p.jm_naziv,
                             sum(p.ulaz_kolicina - p.izlaz_kolicina) AS kolicina,
                             sum(p.ulaz_vrijednost - p.izlaz_vrijednost) AS vrijednost,
                             max(CASE WHEN p.tip_kretanja = 'U' THEN p.datum END) AS zadnji_ulaz,
                             max(CASE WHEN p.tip_kretanja = 'I' THEN p.datum END) AS zadnji_izlaz
                        FROM vw_rm_promet p
                       WHERE p.ooj_id = :APP_OOJ_ID
                         AND (nvl(:P371_SKLADISTE_ID, '0') = '0' OR p.skladiste_id = to_number(:P371_SKLADISTE_ID))
                         AND p.skladiste_id IN (SELECT k.skladiste_id FROM skladiste_korisnici k
                                                  WHERE k.korisnik_id = :APP_USER_ID
                                                    AND nvl(rm_skladiste_pkg.modul(k.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                         AND (:P371_ARTIKL IS NULL OR p.stavka_id = to_number(:P371_ARTIKL))
                         AND p.status = 'Z'
                       GROUP BY p.stavka_id, p.artikal_sifra, p.artikal_naziv, p.jm_naziv) x
                WHERE x.kolicina > 0
                  AND trunc(sysdate) - trunc(nvl(x.zadnji_izlaz, x.zadnji_ulaz)) >= nvl(to_number(:P371_DANA), 0)
                ORDER BY dana DESC, x.vrijednost DESC
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
                P371_ARTIKL
                P371_DANA
            ]
        }
        layout {
            sequence: 30
            parentRegion: @izvjestaj
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-izv-tabela
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(',sz,', ',' || :P371_IZV || ',') > 0
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nema artikala na stanju bez izlaza duže od zadatog broja dana.
        }
        actionsMenu {
            chart: false
            flashback: false
            subscription: false
        }
