    process podrazumijevano (
        name: Podrazumijevane vrijednosti
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- nepoznat izvještaj (npr. stara veza): prvi u katalogu
                if :P371_IZV is not null and instr(',sd,pl,sz,km,pp,dok,pmt,zad,dc,', ',' || :P371_IZV || ',') = 0 then
                    :P371_IZV := 'sd';
                end if;
                -- period: radna godina do danas; skladište: trenutno skladište ('0' = sva skladišta modula)
                :P371_OD    := nvl(:P371_OD, to_char(to_date('01.01.' || :APP_GODINA, 'DD.MM.YYYY'), 'DD.MM.YYYY'));
                :P371_DO    := nvl(:P371_DO, to_char(least(trunc(sysdate), to_date('31.12.' || :APP_GODINA, 'DD.MM.YYYY')), 'DD.MM.YYYY'));
                :P371_DATUM := nvl(:P371_DATUM, :P371_DO);
                :P371_DANA  := nvl(:P371_DANA, '90');
                :P371_SKLADISTE_ID := nvl(:P371_SKLADISTE_ID, :A_SKLADISTE_ID);
                :P371_NAZIV := case :P371_IZV when 'sd' then 'Stanje zaliha na dan' when 'pl' then 'Popisna lista' when 'sz' then 'Starost zaliha' when 'km' then 'Kartica artikla' when 'pp' then 'Promet po artiklima' when 'dok' then 'Pregled dokumenata' when 'pmt' then 'Potrošnja po mjestu troška' when 'zad' then 'Zaduženja' when 'dc' then 'Dokumenti na čekanju' end;
                -- opis parametara (zaglavlje pri štampi)
                :P371_PARAMETRI :=
                    case when nvl(:P371_SKLADISTE_ID, '0') = '0' then 'sva skladišta modula'
                         else (select max('skladište ' || sifra || ' - ' || naziv) from skladista where id = to_number(:P371_SKLADISTE_ID)) end
                    || case when :P371_IZV in ('sd', 'pl') then ' · na dan ' || :P371_DATUM
                            when :P371_IZV in ('km', 'pp', 'dok', 'pmt') then ' · period ' || :P371_OD || ' - ' || :P371_DO end
                    || case when :P371_ARTIKL is not null and :P371_IZV <> 'dok' and :P371_IZV <> 'dc' then
                                (select ' · artikal ' || sifra || ' ' || naziv from sec_stavke where id = to_number(:P371_ARTIKL)) end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process novi-izvjestaj (
        name: Novi izvještaj - parametri ispočetka
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- izbor drugog izvještaja: filteri prethodnog se ne prenose (trenutno skladište, bez artikla)
                :P371_SKLADISTE_ID := :A_SKLADISTE_ID;
                :P371_ARTIKL := null;
                :P371_MT     := null;
                :P371_VRSTA  := null;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: IZV
        }
    )

    branch (
        name: Ostani na izvještaju
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 371
            }
        }
    )

)
