    region izv-stanje (
        name: Stanje zaliha na dan
        title: Stanje zaliha na dan
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT p.artikal_sifra,
                       p.artikal_naziv,
                       p.jm_naziv,
                       rtrim(to_char(sum(p.ulaz_kolicina - p.izlaz_kolicina), 'FM999G999G999G990D999'), '.,') AS kolicina,
                       to_char(sum(p.ulaz_vrijednost - p.izlaz_vrijednost) / nullif(sum(p.ulaz_kolicina - p.izlaz_kolicina), 0), 'FM999G999G999G990D0000') AS cijena,
                       to_char(sum(p.ulaz_vrijednost - p.izlaz_vrijednost), 'FM999G999G999G990D00') AS vrijednost
                FROM vw_rm_promet p
                WHERE p.ooj_id = :APP_OOJ_ID
                  AND (:P371_SKLADISTE_ID IS NULL OR p.skladiste_id = to_number(:P371_SKLADISTE_ID))
                  AND (:P371_SKLADISTE_ID IS NOT NULL OR nvl(rm_skladiste_pkg.modul(p.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                  AND (:P371_ARTIKL IS NULL OR p.stavka_id = to_number(:P371_ARTIKL))
                  AND p.status = 'Z'
                  AND p.datum <= nvl(to_date(:P371_DATUM, 'DD.MM.YYYY'), trunc(sysdate))
                GROUP BY p.stavka_id, p.artikal_sifra, p.artikal_naziv, p.jm_naziv
                HAVING sum(p.ulaz_kolicina - p.izlaz_kolicina) <> 0 OR sum(p.ulaz_vrijednost - p.izlaz_vrijednost) <> 0
                ORDER BY p.artikal_sifra
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
                P371_ARTIKL
                P371_DATUM
            ]
        }
        layout {
            sequence: 10
            parentRegion: @izvjestaj
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: fin-list fin-izv-tabela
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: Nema zaliha na izabrani dan.
        }
        advanced {
            htmlDomId: izv_sd
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(',sd,', ',' || :P371_IZV || ',') > 0
        }

