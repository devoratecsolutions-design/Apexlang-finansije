    pageItem P371_SKLADISTE_ID (
        type: selectList
        label {
            label: Skladište
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT d, r
                FROM (
                    SELECT '— sva skladišta modula —' AS d, 0 AS r, ' ' AS sifra FROM dual
                    UNION ALL
                    SELECT s.sifra || ' - ' || s.naziv, s.id, s.sifra
                    FROM skladista s
                    JOIN skladiste_korisnici k ON k.skladiste_id = s.id AND k.korisnik_id = :APP_USER_ID
                    WHERE s.ooj_id = :APP_OOJ_ID
                      AND s.valid = 'Y'
                      AND nvl(rm_skladiste_pkg.modul(s.id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                ORDER BY sifra
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @parametri
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(',sd,pl,sz,km,pp,dok,pmt,zad,dc,', ',' || :P371_IZV || ',') > 0
        }
    )

