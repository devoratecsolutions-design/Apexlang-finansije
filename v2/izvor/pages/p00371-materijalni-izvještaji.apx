    region finansijski-izvještaji-prometa-po-kontima-i-mjestu-troška-fin (
        name: Finansijski izvještaji prometa po kontima i mjestu troška - fin
        title: Finansijski izvještaji prometa po kontima i mjestu troška
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    operacija_id,
                    operacija_naziv,
                    oj_id,
                    oj_naziv,
                    skladiste_id,
                    skladiste_naziv,
                    stavka_id,
                    stavka_sifra,
                    stavka_naziv,
                    kolicina,
                    iznos,
                    tip_kretanja_id,
                    tip_kretanja,
                    tip_kretanja_naziv,
                    datum_knjizenja,
                    glavna_knjiga_id,
                    lpad(glavna_knjiga_broj, 6, '0') as glavna_knjiga_broj,
                    vrsta_naloga_naziv
                
                
                
                FROM
                    vw_operacija_stavke
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND godina = :APP_GODINA
                    AND tip_stavke_id = 4
                    AND (datum_knjizenja = coalesce(to_date(:P371_DATUM, 'DD.MM.YYYY'), datum_knjizenja))
                ```
            pageItemsToSubmit: P371_DATUM
        }
        layout {
            sequence: 160
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: item=value
            item: P371_IZVJESTAJ_SIFRA
            value: fin
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

