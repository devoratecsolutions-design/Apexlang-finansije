    region izv-cekanje (
        name: Dokumenti na čekanju
        title: Dokumenti na čekanju
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT c.operacija_id AS id,
                       c.dokument AS naziv,
                       c.vrsta_naziv,
                       to_char(c.datum, 'DD.MM.YYYY') AS datum,
                       c.dana,
                       c.razlog,
                       to_char(c.iznos, 'FM999G999G999G990D00') AS iznos,
                       apex_page.get_url(p_page => 331, p_items => 'P331_ID', p_values => c.operacija_id, p_clear_cache => 331) AS url
                FROM vw_rm_na_cekanju c
                WHERE c.ooj_id = :APP_OOJ_ID
                  AND (:P371_SKLADISTE_ID IS NULL OR c.skladiste_id = to_number(:P371_SKLADISTE_ID))
                  AND (:P371_SKLADISTE_ID IS NOT NULL OR nvl(rm_skladiste_pkg.modul(c.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                ORDER BY c.dana DESC, c.datum
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
            ]
        }
        layout {
            sequence: 90
            parentRegion: @izvjestaj
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: fin-list fin-izv-tabela
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
