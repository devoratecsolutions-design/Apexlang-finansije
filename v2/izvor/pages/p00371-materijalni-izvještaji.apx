        }
        advanced {
            htmlDomId: izv_dc
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(',dc,', ',' || :P371_IZV || ',') > 0
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Dokument
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    type: url
                    url: #URL#
                }
                linkText: <span class="fin-doc"><span class="fin-doc__no">#NAZIV#</span><span class="fin-sub">#VRSTA_NAZIV#</span></span>
            }
            sorting {
