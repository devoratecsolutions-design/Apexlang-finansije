    region stanje-skladišta-na-dan-sd (
        name: Stanje skladišta na dan - sd
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    skladiste_id,
                    skladiste_naziv,
                    grupa_id,
                    grupa_naziv,
                    stavka_id,
                    stavka_naziv,
                    stanje_kolicina,
                    saldo
                
                FROM
                    vw_skladiste_stavke
                WHERE
                    tip_stavke_id = 4
                    AND ooj_id = :APP_OOJ_ID
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: item=value
            item: P371_IZVJESTAJ_SIFRA
            value: sd
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column GRUPA_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column GRUPA_NAZIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Grupa stavke
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column SALDO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Saldo
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column SKLADISTE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column SKLADISTE_NAZIV (
