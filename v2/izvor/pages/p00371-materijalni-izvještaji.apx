    region izv-kartica (
        name: Kartica artikla
        title: Kartica artikla
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH p AS (
                    SELECT p.*
                      FROM vw_rm_promet p
                     WHERE p.ooj_id = :APP_OOJ_ID
                       AND (nvl(:P371_SKLADISTE_ID, '0') = '0' OR p.skladiste_id = to_number(:P371_SKLADISTE_ID))
                      AND p.skladiste_id IN (SELECT k.skladiste_id FROM skladiste_korisnici k
                                               WHERE k.korisnik_id = :APP_USER_ID
                                                 AND nvl(rm_skladiste_pkg.modul(k.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                       AND p.stavka_id = to_number(:P371_ARTIKL)
                       AND p.status = 'Z'
                ), x AS (
                    SELECT 0 AS red, to_date(:P371_OD, 'DD.MM.YYYY') AS datum, 0 AS operacija_id, 0 AS stavka_dok_id, 'Početno stanje' AS dokument,
                           CAST(NULL AS VARCHAR2(255)) AS vrsta_naziv, CAST(NULL AS VARCHAR2(500)) AS partner, CAST(NULL AS VARCHAR2(100)) AS skladiste,
                           to_number(NULL) AS ulaz_kolicina, to_number(NULL) AS izlaz_kolicina, to_number(NULL) AS cijena,
                           to_number(NULL) AS ulaz_vrijednost, to_number(NULL) AS izlaz_vrijednost,
                           nvl(sum(ulaz_kolicina - izlaz_kolicina), 0) AS d_kol, nvl(sum(ulaz_vrijednost - izlaz_vrijednost), 0) AS d_vr
                      FROM p WHERE p.datum < to_date(:P371_OD, 'DD.MM.YYYY')
                    UNION ALL
                    SELECT 1, p.datum, p.operacija_id, p.stavka_dok_id, p.dokument, p.vrsta_naziv,
                           coalesce(p.klijent_naziv, p.mjesto_troska_naziv, p.radnik_naziv,
                                    nvl2(p.skladiste_prenos_naziv, CASE WHEN p.tip_kretanja = 'U' THEN 'sa skladišta ' ELSE 'na skladište ' END || p.skladiste_prenos_naziv, NULL)),
                           p.skladiste_sifra,
                           p.ulaz_kolicina, p.izlaz_kolicina, p.cijena, p.ulaz_vrijednost, p.izlaz_vrijednost,
                           p.ulaz_kolicina - p.izlaz_kolicina, p.ulaz_vrijednost - p.izlaz_vrijednost
                      FROM p WHERE p.datum BETWEEN to_date(:P371_OD, 'DD.MM.YYYY') AND to_date(:P371_DO, 'DD.MM.YYYY')
                )
                SELECT x.datum,
                       x.dokument,
                       x.vrsta_naziv,
                       x.partner,
                       x.skladiste,
                       nullif(x.ulaz_kolicina, 0) AS ulaz,
                       nullif(x.izlaz_kolicina, 0) AS izlaz,
                       sum(x.d_kol) OVER (ORDER BY x.red, x.datum, x.operacija_id, x.stavka_dok_id) AS saldo,
                       x.cijena,
                       nullif(x.ulaz_vrijednost, 0) AS ulaz_vrijednost,
                       nullif(x.izlaz_vrijednost, 0) AS izlaz_vrijednost,
                       sum(x.d_vr) OVER (ORDER BY x.red, x.datum, x.operacija_id, x.stavka_dok_id) AS saldo_vrijednost
                FROM x
                WHERE :P371_ARTIKL IS NOT NULL
                ORDER BY x.red, x.datum, x.operacija_id, x.stavka_dok_id
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
                P371_ARTIKL
                P371_OD
                P371_DO
            ]
        }
        layout {
            sequence: 40
            parentRegion: @izvjestaj
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-izv-tabela
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(',km,', ',' || :P371_IZV || ',') > 0
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Izaberite artikal (kartica se prikazuje za jedan artikal).
        }
        actionsMenu {
            chart: false
            flashback: false
            subscription: false
        }
        advanced {
            htmlDomId: izv_km
            savedReportMappingIdentifier: 371000000000000004
        }

