    region izv-potrosnja (
        name: Potrošnja po mjestu troška
        title: Potrošnja po mjestu troška
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT nvl(p.mjesto_troska_naziv, '(bez mjesta troška)') AS mjesto_troska,
                       p.vrsta_naziv,
                       p.artikal_sifra,
                       p.artikal_naziv,
                       p.jm_naziv,
                       rtrim(to_char(sum(p.izlaz_kolicina), 'FM999G999G999G990D999'), '.,') AS kolicina,
                       to_char(sum(p.izlaz_vrijednost), 'FM999G999G999G990D00') AS vrijednost
                FROM vw_rm_promet p
                WHERE p.ooj_id = :APP_OOJ_ID
                  AND (:P371_SKLADISTE_ID IS NULL OR p.skladiste_id = to_number(:P371_SKLADISTE_ID))
                  AND (:P371_SKLADISTE_ID IS NOT NULL OR nvl(rm_skladiste_pkg.modul(p.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                  AND (:P371_ARTIKL IS NULL OR p.stavka_id = to_number(:P371_ARTIKL))
                  AND p.status = 'Z'
                  AND p.vrsta_sifra IN ('IZD', 'IIN', 'IOS', 'ISI')
                  AND p.datum BETWEEN to_date(:P371_OD, 'DD.MM.YYYY') AND to_date(:P371_DO, 'DD.MM.YYYY')
                  AND (:P371_MT IS NULL OR p.mjesto_troska_id = to_number(:P371_MT))
                GROUP BY p.mjesto_troska_naziv, p.vrsta_naziv, p.stavka_id, p.artikal_sifra, p.artikal_naziv, p.jm_naziv
                ORDER BY 1, 2, p.artikal_sifra
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
                P371_ARTIKL
                P371_OD
                P371_DO
                P371_MT
            ]
