                       to_char(sum(p.ulaz_vrijednost - p.izlaz_vrijednost), 'FM999G999G999G990D00') AS vrijednost,
                       NULL AS popisano,
                       NULL AS razlika
                FROM vw_rm_promet p
                WHERE p.ooj_id = :APP_OOJ_ID
                  AND (:P371_SKLADISTE_ID IS NULL OR p.skladiste_id = to_number(:P371_SKLADISTE_ID))
