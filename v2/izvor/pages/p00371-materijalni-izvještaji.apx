page 371 (
    name: Materijalni izvještaji
    alias: MATERIJALNI-IZVJEŠTAJI
    title: Materijalni izvještaji
    pageGroup: @robno-materijalno
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#jasper-server#MIN#.js
    }
    security {
        authorizationScheme: @glavna-knjiga-izvještaji
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Stranica <b><em>"Izvještaji"</em></b> kreirana je tako da povlači 
            sve izvještaje iz <b><em>"Glavne knjige."</em></b> 
            Izvještaji su grupisani po tabovima i klikom na određeni tab otvara se željeni izvještaj. </br>
            Za svaki izvještaj potrebno je unijeti određene parametre kako bi se prikazali rezultati.</br>
            </br>
            Najčešće se unose period od, period do, klasa konta, konto, organizaciona jedinica, klijenti, 
            vrsta naloga, PDV indikator i vrsta klijenta, ali se parametri razlikuju zavisno od izvještaja. </br>
            Nakon unosa podataka, izborom opcije <b><em>"Generiši"</em></b> izvještaj dobijate traženi prikaz.
            ```
    }

    region dokumenti-na-čekanju-dc (
        name: Dokumenti na čekanju - dc
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    naziv,
                    skladiste_id,
                    tip_kretanja,
                    tip_kretanja_id,
                    datum,
                    status_naziv,
                    status_color_code,
                    status_id
                FROM
                    vw_trebovanja t
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND godina = :APP_GODINA
                ORDER BY
                    broj DESC
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: item=value
            item: P371_IZVJESTAJ_SIFRA
            value: dc
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATUM (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            layout {
                sequence: 0
            }
            link {
                target: {
                    page: 322
                    items: {
                        P322_ID: #ID#
                    }
                    clearCache: 322
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column NAZIV (
