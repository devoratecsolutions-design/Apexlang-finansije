    region izv-kartica (
        name: Kartica artikla
        title: Kartica artikla
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH p AS (
                    SELECT p.*
                      FROM vw_rm_promet p
                     WHERE p.ooj_id = :APP_OOJ_ID
                       AND (:P371_SKLADISTE_ID IS NULL OR p.skladiste_id = to_number(:P371_SKLADISTE_ID))
                      AND (:P371_SKLADISTE_ID IS NOT NULL OR nvl(rm_skladiste_pkg.modul(p.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                       AND p.stavka_id = to_number(:P371_ARTIKL)
                       AND p.status = 'Z'
                ), x AS (
                    SELECT 0 AS red, to_date(:P371_OD, 'DD.MM.YYYY') AS datum, 0 AS operacija_id, 0 AS stavka_dok_id, 'Početno stanje' AS dokument,
                           NULL AS vrsta_naziv, NULL AS partner, NULL AS skladiste,
                           to_number(NULL) AS ulaz_kolicina, to_number(NULL) AS izlaz_kolicina, to_number(NULL) AS cijena,
                           to_number(NULL) AS ulaz_vrijednost, to_number(NULL) AS izlaz_vrijednost,
                           nvl(sum(ulaz_kolicina - izlaz_kolicina), 0) AS d_kol, nvl(sum(ulaz_vrijednost - izlaz_vrijednost), 0) AS d_vr
                      FROM p WHERE p.datum < to_date(:P371_OD, 'DD.MM.YYYY')
                    UNION ALL
                    SELECT 1, p.datum, p.operacija_id, p.stavka_dok_id, p.dokument, p.vrsta_naziv,
                           coalesce(p.klijent_naziv, p.mjesto_troska_naziv, p.radnik_naziv), p.skladiste_sifra,
                           p.ulaz_kolicina, p.izlaz_kolicina, p.cijena, p.ulaz_vrijednost, p.izlaz_vrijednost,
                           p.ulaz_kolicina - p.izlaz_kolicina, p.ulaz_vrijednost - p.izlaz_vrijednost
                      FROM p WHERE p.datum BETWEEN to_date(:P371_OD, 'DD.MM.YYYY') AND to_date(:P371_DO, 'DD.MM.YYYY')
                )
                SELECT to_char(x.datum, 'DD.MM.YYYY') AS datum,
                       x.dokument,
                       x.vrsta_naziv,
                       x.partner,
                       x.skladiste,
                       rtrim(to_char(nullif(x.ulaz_kolicina, 0), 'FM999G999G999G990D999'), '.,') AS ulaz,
                       rtrim(to_char(nullif(x.izlaz_kolicina, 0), 'FM999G999G999G990D999'), '.,') AS izlaz,
                       rtrim(to_char(sum(x.d_kol) OVER (ORDER BY x.red, x.datum, x.operacija_id, x.stavka_dok_id), 'FM999G999G999G990D999'), '.,') AS saldo,
                       to_char(x.cijena, 'FM999G999G999G990D0000') AS cijena,
                       to_char(nullif(x.ulaz_vrijednost, 0), 'FM999G999G999G990D00') AS ulaz_vrijednost,
                       to_char(nullif(x.izlaz_vrijednost, 0), 'FM999G999G999G990D00') AS izlaz_vrijednost,
                       to_char(sum(x.d_vr) OVER (ORDER BY x.red, x.datum, x.operacija_id, x.stavka_dok_id), 'FM999G999G999G990D00') AS saldo_vrijednost
                FROM x
                WHERE :P371_ARTIKL IS NOT NULL
                ORDER BY x.red, x.datum, x.operacija_id, x.stavka_dok_id
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
                P371_ARTIKL
                P371_OD
                P371_DO
            ]
        }
