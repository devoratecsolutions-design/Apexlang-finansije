    region izv-promet (
        name: Promet po artiklima
        title: Promet po artiklima
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT p.artikal_sifra,
                       p.artikal_naziv,
                       p.jm_naziv,
                       sum(CASE WHEN p.datum < to_date(:P371_OD, 'DD.MM.YYYY') THEN p.ulaz_kolicina - p.izlaz_kolicina ELSE 0 END) AS pocetno,
                       sum(CASE WHEN p.datum >= to_date(:P371_OD, 'DD.MM.YYYY') THEN p.ulaz_kolicina ELSE 0 END) AS ulaz,
                       sum(CASE WHEN p.datum >= to_date(:P371_OD, 'DD.MM.YYYY') THEN p.izlaz_kolicina ELSE 0 END) AS izlaz,
                       sum(p.ulaz_kolicina - p.izlaz_kolicina) AS krajnje,
                       sum(CASE WHEN p.datum < to_date(:P371_OD, 'DD.MM.YYYY') THEN p.ulaz_vrijednost - p.izlaz_vrijednost ELSE 0 END) AS pocetno_vr,
                       sum(CASE WHEN p.datum >= to_date(:P371_OD, 'DD.MM.YYYY') THEN p.ulaz_vrijednost ELSE 0 END) AS ulaz_vr,
                       sum(CASE WHEN p.datum >= to_date(:P371_OD, 'DD.MM.YYYY') THEN p.izlaz_vrijednost ELSE 0 END) AS izlaz_vr,
                       sum(p.ulaz_vrijednost - p.izlaz_vrijednost) AS krajnje_vr
                FROM vw_rm_promet p
                WHERE p.ooj_id = :APP_OOJ_ID
                  AND (nvl(:P371_SKLADISTE_ID, '0') = '0' OR p.skladiste_id = to_number(:P371_SKLADISTE_ID))
                  AND p.skladiste_id IN (SELECT k.skladiste_id FROM skladiste_korisnici k
                                           WHERE k.korisnik_id = :APP_USER_ID
                                             AND nvl(rm_skladiste_pkg.modul(k.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                  AND (:P371_ARTIKL IS NULL OR p.stavka_id = to_number(:P371_ARTIKL))
                  AND p.status = 'Z'
                  AND p.datum <= to_date(:P371_DO, 'DD.MM.YYYY')
                GROUP BY p.stavka_id, p.artikal_sifra, p.artikal_naziv, p.jm_naziv
                HAVING sum(CASE WHEN p.datum >= to_date(:P371_OD, 'DD.MM.YYYY') THEN p.ulaz_kolicina + p.izlaz_kolicina ELSE 0 END) <> 0
                    OR sum(p.ulaz_kolicina - p.izlaz_kolicina) <> 0
                ORDER BY p.artikal_sifra
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
                P371_ARTIKL
                P371_OD
                P371_DO
            ]
        }
        layout {
            sequence: 50
            parentRegion: @izvjestaj
            slot: subRegions
        }
