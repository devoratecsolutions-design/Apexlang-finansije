    region kartica-materijala-na-nivou-skladišta-km (
        name: Kartica materijala na nivou skladišta - km
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    stavka_id,
                    skladiste_id,
                    tip_kretanja,
                    tip_kretanja_id,
                    operacija_naziv,
                    operacija_datum,
                    datum_knjizenja,
                    kolicina,
                    opis,
                    iznos, 
                    
                    (
                        SELECT
                            listagg(kk.kuf_naziv_fakture, '~')
                        FROM
                            vw_kalkulacija_kuf kk
                        WHERE
                            kk.kalkulacija_id = (
                                SELECT
                                    kalkulacija_id
                                FROM
                                    kalkulacija_operacije ko
                                WHERE
                                    ko.operacija_id = os.operacija_id
                            )
                    ) AS kuf_list,
                
                    (
                        SELECT
                            kalkulacija_id
                        FROM
                            kalkulacija_operacije ko
                        WHERE
                            ko.operacija_id = os.operacija_id
                    ) AS kalkulacija_id
                FROM
                    vw_operacija_stavke os
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND godina = :APP_GODINA
                    AND tip_stavke_id = 4
                ORDER BY
                    operacija_datum DESC
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: item=value
            item: P371_IZVJESTAJ_SIFRA
            value: km
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        breakFormatting {
            reportSumLabel: Ukupno
        }

