                sequence: 80
            }
        )

        column STATUS_NAZIV (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if STATUS_ID/}
                    <span class="t-Button #STATUS_COLOR_CODE# t-Button--small">
                        <span class="t-Button-label">#STATUS_NAZIV#</span>
