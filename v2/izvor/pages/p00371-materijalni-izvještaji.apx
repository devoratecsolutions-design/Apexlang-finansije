    region izv-stanje (
        name: Stanje zaliha na dan
        title: Stanje zaliha na dan
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT p.artikal_sifra,
                       p.artikal_naziv,
                       p.jm_naziv,
                       sum(p.ulaz_kolicina - p.izlaz_kolicina) AS kolicina,
                       round(sum(p.ulaz_vrijednost - p.izlaz_vrijednost) / nullif(sum(p.ulaz_kolicina - p.izlaz_kolicina), 0), 4) AS cijena,
                       sum(p.ulaz_vrijednost - p.izlaz_vrijednost) AS vrijednost
                FROM vw_rm_promet p
                WHERE p.ooj_id = :APP_OOJ_ID
                  AND (nvl(:P371_SKLADISTE_ID, '0') = '0' OR p.skladiste_id = to_number(:P371_SKLADISTE_ID))
                  AND p.skladiste_id IN (SELECT k.skladiste_id FROM skladiste_korisnici k
                                           WHERE k.korisnik_id = :APP_USER_ID
                                             AND nvl(rm_skladiste_pkg.modul(k.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                  AND (:P371_ARTIKL IS NULL OR p.stavka_id = to_number(:P371_ARTIKL))
                  AND p.status = 'Z'
                  AND p.datum <= nvl(to_date(:P371_DATUM, 'DD.MM.YYYY'), trunc(sysdate))
                GROUP BY p.stavka_id, p.artikal_sifra, p.artikal_naziv, p.jm_naziv
                HAVING sum(p.ulaz_kolicina - p.izlaz_kolicina) <> 0 OR sum(p.ulaz_vrijednost - p.izlaz_vrijednost) <> 0
                ORDER BY p.artikal_sifra
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
                P371_ARTIKL
                P371_DATUM
            ]
        }
        layout {
            sequence: 10
            parentRegion: @izvjestaj
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-izv-tabela
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(',sd,', ',' || :P371_IZV || ',') > 0
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nema zaliha na izabrani dan.
        }
        actionsMenu {
            chart: false
            flashback: false
            subscription: false
        }
        advanced {
