    pageItem P371_SKLADISTE_ID (
        type: selectList
        label {
            label: Skladište
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT s.sifra || ' - ' || s.naziv AS d, s.id AS r
                FROM skladista s
                WHERE s.ooj_id = :APP_OOJ_ID
                  AND s.valid = 'Y'
                  AND nvl(rm_skladiste_pkg.modul(s.id), 'MAT') = nvl(:A_RM_MODUL, 'MAT')
                ORDER BY s.sifra
                ```
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: - sva skladišta modula -
        }
        layout {
            sequence: 10
            region: @parametri
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(',sd,pl,sz,km,pp,dok,pmt,zad,dc,', ',' || :P371_IZV || ',') > 0
        }
    )

    pageItem P371_DATUM (
