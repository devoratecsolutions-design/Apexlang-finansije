page 371 (
    name: Izvještaji
    alias: MATERIJALNI-IZVJEŠTAJI
    title: Izvještaji
    pageGroup: @robno-materijalno
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            finRmIzvjestaji.init('P371');
            ```
    }
    security {
        authorizationScheme: @glavna-knjiga-izvještaji
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Izaberite izvještaj u katalogu (grupe: stanje i vrijednost, promet, potrošnja i zaduženja, kontrola),
            podesite parametre (skladište, period, artikal...) i kliknite <b>Prikaži</b>.
            Izvještaji koriste zaključene dokumente skladišta (knjigovodstveno stanje); <b>Dokumenti na čekanju</b>
            prikazuju ono što još nije zaključeno.
            ```
    }

    region izvjestaji-naslov (
        name: Izvještaji
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region katalog (
        name: Katalog izvještaja
        type: staticContent
        source {
            htmlCode: <div class="fin-izv-katalog"><div class="fin-izv-grupa"><div class="fin-izv-grupa__naslov"><span class="fa fa-cubes" aria-hidden="true"></span>Stanje i vrijednost</div><button type="button" class="fin-izv-kartica" data-izv="sd"><span class="fin-izv-kartica__naziv">Stanje zaliha na dan</span><span class="fin-izv-kartica__opis">Količina, prosječna cijena i vrijednost po artiklu</span></button><button type="button" class="fin-izv-kartica" data-izv="pl"><span class="fin-izv-kartica__naziv">Popisna lista</span><span class="fin-izv-kartica__opis">Knjigovodstveno stanje sa poljima za popis</span></button><button type="button" class="fin-izv-kartica" data-izv="sz"><span class="fin-izv-kartica__naziv">Starost zaliha</span><span class="fin-izv-kartica__opis">Artikli na stanju bez izlaza duže od N dana</span></button></div><div class="fin-izv-grupa"><div class="fin-izv-grupa__naslov"><span class="fa fa-exchange" aria-hidden="true"></span>Promet</div><button type="button" class="fin-izv-kartica" data-izv="km"><span class="fin-izv-kartica__naziv">Kartica artikla</span><span class="fin-izv-kartica__opis">Hronološki ulazi, izlazi i stanje jednog artikla</span></button><button type="button" class="fin-izv-kartica" data-izv="pp"><span class="fin-izv-kartica__naziv">Promet po artiklima</span><span class="fin-izv-kartica__opis">Početno, ulaz, izlaz i krajnje stanje za period</span></button><button type="button" class="fin-izv-kartica" data-izv="dok"><span class="fin-izv-kartica__naziv">Pregled dokumenata</span><span class="fin-izv-kartica__opis">Svi dokumenti skladišta za period</span></button></div><div class="fin-izv-grupa"><div class="fin-izv-grupa__naslov"><span class="fa fa-users" aria-hidden="true"></span>Potrošnja i zaduženja</div><button type="button" class="fin-izv-kartica" data-izv="pmt"><span class="fin-izv-kartica__naziv">Potrošnja po mjestu troška</span><span class="fin-izv-kartica__opis">Izdatnice i izlazi na investiciju, OS i sitni inventar</span></button><button type="button" class="fin-izv-kartica" data-izv="zad"><span class="fin-izv-kartica__naziv">Zaduženja</span><span class="fin-izv-kartica__opis">Otvoreni reversi i zaduženja radnika / komitenata</span></button></div><div class="fin-izv-grupa"><div class="fin-izv-grupa__naslov"><span class="fa fa-bell-o" aria-hidden="true"></span>Kontrola</div><button type="button" class="fin-izv-kartica" data-izv="dc"><span class="fin-izv-kartica__naziv">Dokumenti na čekanju</span><span class="fin-izv-kartica__opis">Dokumenti u pripremi, prijemnice bez kalkulacije, prenosi bez prijema</span></button></div></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: fin_izv_katalog
        }
    )

