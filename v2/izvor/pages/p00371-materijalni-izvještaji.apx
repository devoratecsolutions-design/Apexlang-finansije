                ```sql
                SELECT c.operacija_id AS id,
                       c.dokument AS naziv,
                       c.vrsta_naziv,
                       c.datum,
                       c.dana,
                       c.razlog,
                       c.iznos,
                       apex_page.get_url(p_page => 331, p_items => 'P331_ID', p_values => c.operacija_id, p_clear_cache => 331) AS url
                FROM vw_rm_na_cekanju c
                WHERE c.ooj_id = :APP_OOJ_ID
                  AND (nvl(:P371_SKLADISTE_ID, '0') = '0' OR c.skladiste_id = to_number(:P371_SKLADISTE_ID))
                  AND c.skladiste_id IN (SELECT k.skladiste_id FROM skladiste_korisnici k
                                           WHERE k.korisnik_id = :APP_USER_ID
                                             AND nvl(rm_skladiste_pkg.modul(k.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                ORDER BY c.dana DESC, c.datum
