    region izv-zaduzenja (
        name: Zaduženja po radniku i komitentu
        title: Zaduženja po radniku i komitentu
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT z.partner_naziv,
                       z.vrsta,
                       z.dokument,
                       to_char(z.datum, 'DD.MM.YYYY') AS datum,
                       z.artikal_sifra,
                       z.artikal_naziv,
                       z.jm_naziv,
                       rtrim(to_char(z.zaduzeno, 'FM999G999G999G990D999'), '.,') AS zaduzeno,
                       to_char(z.vrijednost, 'FM999G999G999G990D00') AS vrijednost
                FROM vw_rm_zaduzenja z
                WHERE z.ooj_id = :APP_OOJ_ID
                  AND (:P371_SKLADISTE_ID IS NULL OR z.skladiste_id = to_number(:P371_SKLADISTE_ID))
                  AND (:P371_ARTIKL IS NULL OR z.stavka_id = to_number(:P371_ARTIKL))
                ORDER BY z.partner_naziv, z.datum, z.dokument
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
                P371_ARTIKL
            ]
        }
        layout {
            sequence: 80
            parentRegion: @izvjestaj
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: fin-list fin-izv-tabela
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
