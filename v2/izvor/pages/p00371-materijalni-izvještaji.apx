    pageItem P371_VRSTA (
        type: selectList
        label {
            label: Vrsta dokumenta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT vd.naziv AS d, upper(vd.sifra) AS r
                FROM sif.vrste_dokumenata vd
                JOIN sif.acc_moduli m ON m.id = vd.acc_modul_id AND upper(m.sifra) = 'MAT'
                WHERE vd.ooj_id = :APP_OOJ_ID
                  AND vd.valid = 'Y'
                  AND rm_dokument_pkg.u_modulu(vd.sifra, nvl(:A_RM_MODUL, 'MAT')) = 'Y'
                ORDER BY vd.naziv
                ```
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: - sve vrste -
        }
        layout {
            sequence: 60
            region: @parametri
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(',dok,', ',' || :P371_IZV || ',') > 0
        }
    )

    pageItem P371_DANA (
        type: numberField
        label {
            label: Dana bez izlaza (najmanje)
            alignment: left
        }
        layout {
            sequence: 60
            region: @parametri
            slot: regionBody
