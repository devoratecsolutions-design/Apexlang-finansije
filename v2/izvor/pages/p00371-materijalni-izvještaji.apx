    region izv-promet (
        name: Promet po artiklima
        title: Promet po artiklima
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT p.artikal_sifra,
                       p.artikal_naziv,
                       p.jm_naziv,
                       rtrim(to_char(sum(CASE WHEN p.datum < to_date(:P371_OD, 'DD.MM.YYYY') THEN p.ulaz_kolicina - p.izlaz_kolicina ELSE 0 END), 'FM999G999G999G990D999'), '.,') AS pocetno,
                       rtrim(to_char(sum(CASE WHEN p.datum >= to_date(:P371_OD, 'DD.MM.YYYY') THEN p.ulaz_kolicina ELSE 0 END), 'FM999G999G999G990D999'), '.,') AS ulaz,
                       rtrim(to_char(sum(CASE WHEN p.datum >= to_date(:P371_OD, 'DD.MM.YYYY') THEN p.izlaz_kolicina ELSE 0 END), 'FM999G999G999G990D999'), '.,') AS izlaz,
                       rtrim(to_char(sum(p.ulaz_kolicina - p.izlaz_kolicina), 'FM999G999G999G990D999'), '.,') AS krajnje,
                       to_char(sum(CASE WHEN p.datum < to_date(:P371_OD, 'DD.MM.YYYY') THEN p.ulaz_vrijednost - p.izlaz_vrijednost ELSE 0 END), 'FM999G999G999G990D00') AS pocetno_vr,
                       to_char(sum(CASE WHEN p.datum >= to_date(:P371_OD, 'DD.MM.YYYY') THEN p.ulaz_vrijednost ELSE 0 END), 'FM999G999G999G990D00') AS ulaz_vr,
                       to_char(sum(CASE WHEN p.datum >= to_date(:P371_OD, 'DD.MM.YYYY') THEN p.izlaz_vrijednost ELSE 0 END), 'FM999G999G999G990D00') AS izlaz_vr,
                       to_char(sum(p.ulaz_vrijednost - p.izlaz_vrijednost), 'FM999G999G999G990D00') AS krajnje_vr
                FROM vw_rm_promet p
                WHERE p.ooj_id = :APP_OOJ_ID
                  AND (:P371_SKLADISTE_ID IS NULL OR p.skladiste_id = to_number(:P371_SKLADISTE_ID))
                  AND (:P371_SKLADISTE_ID IS NOT NULL OR nvl(rm_skladiste_pkg.modul(p.skladiste_id), 'MAT') = nvl(:A_RM_MODUL, 'MAT'))
                  AND (:P371_ARTIKL IS NULL OR p.stavka_id = to_number(:P371_ARTIKL))
                  AND p.status = 'Z'
                  AND p.datum <= to_date(:P371_DO, 'DD.MM.YYYY')
                GROUP BY p.stavka_id, p.artikal_sifra, p.artikal_naziv, p.jm_naziv
                HAVING sum(CASE WHEN p.datum >= to_date(:P371_OD, 'DD.MM.YYYY') THEN p.ulaz_kolicina + p.izlaz_kolicina ELSE 0 END) <> 0
                    OR sum(p.ulaz_kolicina - p.izlaz_kolicina) <> 0
                ORDER BY p.artikal_sifra
                ```
            pageItemsToSubmit: [
                P371_SKLADISTE_ID
                P371_ARTIKL
                P371_OD
                P371_DO
            ]
        }
