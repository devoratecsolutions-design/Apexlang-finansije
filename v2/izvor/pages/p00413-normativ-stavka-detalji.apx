page 413 (
    name: Normativ stavke / Detalji
    alias: NORMATIV-STAVKA-DETALJI
    title: Normativ stavke / Detalji
    pageGroup: @proizvodnja
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region normativ-stavke (
        name: Normativ Stavke
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P413_ID (
        type: hidden
        layout {
            sequence: 20
            region: @normativ-stavke
            slot: regionBody
        }
    )

    pageItem P413_JM_ID (
        type: selectOne
        label {
            label: Jedinica mjere
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @sif-jm
        }
        layout {
            sequence: 50
            region: @normativ-stavke
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P413_KOLICINA (
        type: numberField
        label {
            label: Količina
            alignment: left
        }
        layout {
            sequence: 60
            region: @normativ-stavke
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D0000
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P413_NORMATIV_ID (
        type: hidden
        layout {
            sequence: 30
            region: @normativ-stavke
            slot: regionBody
        }
    )

    pageItem P413_STAVKA_ID (
        type: selectOne
        label {
            label: Stavka
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @sec-stavke
        }
        layout {
            sequence: 40
            region: @normativ-stavke
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P413_VALID (
        type: radioGroup
        label {
            label: Aktivno
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @normativ-stavke
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P413_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P413_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P413_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P413_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: REQUEST
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 150863506913634076
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                proizvodnja_pkg.delete_normativ_stavka (
                    p_id => :P413_ID
                );
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 150637500469527520
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                proizvodnja_pkg.get_normativ_stavka (
                    p_id          => :P413_ID,
                    p_normativ_id => :P413_NORMATIV_ID,
                    p_stavka_id   => :P413_STAVKA_ID,
                    p_jm_id       => :P413_JM_ID,
                    p_kolicina    => :P413_KOLICINA,
                    p_valid       => :P413_VALID
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 150637230777527517
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P413_ID
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                proizvodnja_pkg.insert_normativ_stavka (
                    p_normativ_id => :P413_NORMATIV_ID,
                    p_stavka_id   => :P413_STAVKA_ID,
                    p_jm_id       => :P413_JM_ID,
                    p_kolicina    => to_number(:P413_KOLICINA, '999G999G999G999G990D0000')
                );
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 150637334058527518
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                proizvodnja_pkg.update_normativ_stavka (
                    p_id          => :P413_ID,
                    p_normativ_id => :P413_NORMATIV_ID,
                    p_stavka_id   => :P413_STAVKA_ID,
                    p_jm_id       => :P413_JM_ID,
                    p_kolicina    => to_number(:P413_KOLICINA, '999G999G999G999G990D0000'),
                    p_valid       => :P413_VALID
                );
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 150637485511527519
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

