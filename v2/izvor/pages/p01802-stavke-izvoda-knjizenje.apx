page 1802 (
    name: Stavke Izvoda-knjizenje
    alias: STAVKE-IZVODA-KNJIZENJE
    title: Transakcije izvoda
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1600
        height: 800
        maxWidth: 1600
    }
    navigation {
        cursorFocus: doNotFocusCursor
