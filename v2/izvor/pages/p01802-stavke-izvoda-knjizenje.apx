    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region transakcije (
        name: Transakcije
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select izs.rbr,zr.sifra||'/'||i.broj||'/'||i.godina as izvod, case when izs.smjer='P' then 'Priliv' else 'Odliv' end as smjer, izs.uplatio, izs.svrha_doznake, izs.poziv_na_broj,izs.ref_ziro_racun, 
                       izs.vrsta_placanja, izs.vrsta_prihoda, lpad(gg.sifra, 3, '0')||'-'||gg.naziv as opstina, izs.budzetska_organizacija, 
                       v.sifra as valuta, izs.iznos_valutno, izs.iznos, 
                       kl.naziv as partner, rpad(ak.code, :APP_KONTO_DUZINA, '0')||'-'||ak.naziv  as konto, izs.id as dodaj_stavku 
                from accounting.izvodi i
                join sif.sif_ziro_racuni zr on i.ziro_racun_id=zr.id
                join accounting.izvod_stavke izs on i.id=izs.izvod_id
                left join accounting.sec_klijenti kl on kl.id=izs.klijent_id
                left join sif.acc_kontni_okvir_klase ak on ak.id=izs.konto_id
                left join sif.sif_gradovi gg on gg.id=izs.opstina
                join sif.acc_valute v on v.id=izs.valuta_id
                where izs.izvod_id in (
                                        select distinct n005
                                        from apex_collections
                                        where collection_name = 'SADRZAJ_GK_IZVODI'
                                       )
                order by izs.izvod_id,rbr
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
