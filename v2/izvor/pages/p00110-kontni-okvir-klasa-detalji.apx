    dynamicAction hide-pdv-indikator-sifra (
        name: Hide PDV INDIKATOR SIFRA
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P110_PDV_INDIKATOR
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P110_PDV_INDIKATOR_SIFRA
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item!=value
                item: P110_PDV_INDIKATOR
                value: Y
            }
        )

    )

    dynamicAction set-sifra (
        name: Set sifra
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P110_KONTNA_KLASA_ID
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                        select  kk.code
                        FROM sif.acc_kontni_okvir_klase kk 
                        where kk.id=:P110_KONTNA_KLASA_ID;
                    
                    
                    ```
                itemsToSubmit: P110_KONTNA_KLASA_ID
            }
            affectedElements {
                selectionType: items
                items: P110_CODE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction show-pdv-indikator-sifra (
        name: Show PDV INDIKATOR SIFRA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P110_PDV_INDIKATOR
        }
        clientSideCondition {
            type: item=value
            item: P110_PDV_INDIKATOR
            value: Y
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P110_PDV_INDIKATOR_SIFRA
            }
            execution {
                sequence: 10
            }
        )

    )

    validation code-length (
        name: Code VALID
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    v_nad_code varchar2(12);
                    v_pom      number;
                begin
                
                    -----------------------------------------------------------
                    -- 1) jedinstvenost šifre (bez trailing nula) u okviru OOJ-a
                    -----------------------------------------------------------
                    select count(1)
                    into v_pom
                    from sif.acc_kontni_okvir_klase k
                    where rtrim(k.code,'0') = rtrim(:P110_CODE,'0')
                      and k.ooj_id = :APP_OOJ_ID
                      and k.id <> nvl(:P110_ID,0);
                
                    if v_pom > 0 then
                        return 'Šifra konta "' || :P110_CODE || '" već postoji u kontnom planu - šifra mora biti jedinstvena!';
                    end if;
                
                    -----------------------------------------------------------
                    -- 2) šifra nadređenog konta
                    -----------------------------------------------------------
                    select k.code
                    into v_nad_code
                    from sif.acc_kontni_okvir_klase k
                    where id = :P110_KONTNA_KLASA_ID;
                
                    -----------------------------------------------------------
                    -- 3) šifra mora počinjati šifrom nadređenog konta
                    -----------------------------------------------------------
                    if substr(:P110_CODE, 1, length(v_nad_code)) != v_nad_code then
                        return 'Šifra konta mora počinjati šifrom nadređenog konta ("' || v_nad_code || '")!';
                    end if;
                
                    -----------------------------------------------------------
                    -- 4) šifra mora biti duža od šifre nadređenog konta
                    -----------------------------------------------------------
                    if length(:P110_CODE) = length(v_nad_code) then
                        return 'Šifra podređenog konta mora biti duža od šifre nadređenog konta ("' || v_nad_code || '") - dodajte bar jedan karakter!';
                    end if;
                
                    -----------------------------------------------------------
                    -- 5) maksimalna dužina šifre konta
                    -----------------------------------------------------------
                    if length(:P110_CODE) > nvl(:APP_KONTO_DUZINA, 6) then
                        return 'Šifra konta može imati najviše ' || nvl(:APP_KONTO_DUZINA, 6) || ' karaktera (trenutno: ' || length(:P110_CODE) || ')!';
                    end if;
                
                end;
                ```
        }
        error {
            associatedItem: @P110_CODE
        }
    )

