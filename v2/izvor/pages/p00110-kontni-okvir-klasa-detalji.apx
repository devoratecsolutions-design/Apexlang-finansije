page 110 (
    name: Kontni okvir klasa / Detalji
    alias: KONTNI-OKVIR-KLASA-DETALJI
    title: Kontni okvir klasa / Detalji
    pageGroup: @konfiguracija
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region audit-information (
        name: Audit Information
        type: staticContent
        layout {
            sequence: 160
            parentRegion: @kontni-okvir-klasa-detalji
            slot: regionBody
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P110_ID
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM sif.acc_kontni_okvir_klase
                WHERE
                    (id = :P110_ID or :P110_ID is null)
                    AND (length(code) > 3)
                ```
        }
        settings {
            outputAs: text
        }
    )

    region kontni-okvir-klasa-detalji (
        name: Kontni okvir klasa / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM sif.acc_kontni_okvir_klase
                WHERE
                    (id = :P110_ID or :P110_ID is null)
                    AND (length(code) > 3)
                ```
        }
    )

    region ne-možete-izmijeniti-ovaj-podatak (
        name: Ne možete izmijeniti ovaj podatak
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    code,
                    naziv,
                    os,
                    klijent,
                    oj,
                    radnik,
                    pdv_indikator, 
                    otvorene_stavke
                FROM
                    sif.acc_kontni_okvir_klase
                WHERE
                    id = :P110_ID
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--wizard
                t-Alert--defaultIcons
                t-Alert--danger
            ]
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM sif.acc_kontni_okvir_klase
                WHERE
                    (id = :P110_ID or :P110_ID is null)
                    AND (length(code) > 3)
                ```
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
            ]
        }

        column CODE (
            reportColumnQueryId: 1
            derivedColumn: N
