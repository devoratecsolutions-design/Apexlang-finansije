    pageItem P110_KONTNA_KLASA_ID (
        type: selectOne
        label {
            label: Nadređena kontna klasa
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    CASE
                        WHEN LENGTH(code) IN (3,4) THEN code
                        ELSE RPAD(code, NVL(:APP_KONTO_DUZINA, 6), '0')
                    END || ' - ' || naziv AS d ,
                    id r
                FROM
                    sif.acc_kontni_okvir_klase
                WHERE
                    valid = 'Y'
                    AND ((ooj_id IS null AND length(code) =3) or (ooj_id = :APP_OOJ_ID and length(code) <NVL(:APP_KONTO_DUZINA, 6)))
                    
                ORDER BY
                    code ASC 
                ```
        }
        layout {
            sequence: 30
            region: @kontni-okvir-klasa-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

