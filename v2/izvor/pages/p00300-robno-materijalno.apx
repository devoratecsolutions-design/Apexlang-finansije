page 300 (
    name: Robno - materijalno
    alias: ROBNO-MATERIJALNO
    title: &A_RM_NAZIV.
    pageGroup: @robno-materijalno
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @robno-materijalno-osnovni-pristup
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region robno-materijalno (
        name: Robno - materijalno
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region pokazatelji (
        name: Pokazatelji
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                RETURN dashboard_pkg.kpi_zalihe(:APP_OOJ_ID, :APP_GODINA, :APP_USER_ID, nvl(:A_RM_MODUL, 'ROB'));
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rm-dokumenti (
        name: Dokumenti po mjesecima
        type: chart
        layout {
            sequence: 20
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: fin-panel
        }
        chartLayout {
            height: 280
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: Nema podataka za izabrani period.
        }

        series dokumenti (
            name: Broj dokumenata
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH m AS (
                        SELECT level AS mj FROM dual CONNECT BY level <= 12
                    )
                    SELECT
                        substr('JanFebMarAprMajJunJulAvgSepOktNovDec', (m.mj - 1) * 3 + 1, 3) AS mjesec,
                        coalesce(count(k.id), 0) AS vrijednost
                    FROM
                        m
                        LEFT JOIN operacije k
                            ON  k.ooj_id = :APP_OOJ_ID
                            AND k.godina = :APP_GODINA
                            AND extract(month FROM k.datum) = m.mj
                            AND k.valid = 'Y'
                            AND coalesce(k.stornirano, 'N') = 'N'
                            AND k.skladiste_id IN (SELECT ks.skladiste_id FROM vw_rm_korisnik_skladista ks
                                                    WHERE ks.korisnik_id = :APP_USER_ID AND ks.modul = nvl(:A_RM_MODUL, 'ROB'))
                    GROUP BY
                        m.mj
                    ORDER BY
                        m.mj
                    ```
            }
            columnMapping {
                label: MJESEC
                value: VRIJEDNOST
            }
            appearance {
                color: #2271b1
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            minorTicks {
                show: false
            }
        )

    )

    region rm-posljednji (
        name: Posljednji dokumenti
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    o.datum,
                    o.naziv AS dokument,
                    o.vrsta_naziv AS tip,
                    o.skladiste_naziv AS skladiste
                FROM
                    vw_rm_dokumenti o
                    JOIN vw_rm_korisnik_skladista ks ON ks.skladiste_id = o.skladiste_id AND ks.korisnik_id = :APP_USER_ID AND ks.modul = nvl(:A_RM_MODUL, 'ROB')
                WHERE
                    o.ooj_id = :APP_OOJ_ID
                    AND o.stornirano = 'N'
                ORDER BY
                    o.datum DESC,
                    o.id DESC
                FETCH FIRST 10 ROWS ONLY
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noPadding
            ]
            cssClasses: fin-panel
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Nema stavki.
        }

        column DATUM (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 10
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
            sorting {
                sortable: false
            }
        )

        column DOKUMENT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Dokument
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column TIP (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Vrsta
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column SKLADISTE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Skladište
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

)

