page 103 (
    name: Numeracija dokumenata
    alias: NUMERACIJA-DOKUMENATA
    title: Numeracija dokumenata
    pageGroup: @konfiguracija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @finansije-konfiguracija
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Stranica <b><em>„Numeracija dokumenata“</em></b> odnosi se na proces dodjeljivanja jedinstvenih brojeva 
            ili oznaka svakom dokumentu u okviru sistema za upravljanje dokumentacijom.</br> 
            Ovaj postupak se koristi kako bi se osigurala organizacija, praćenje i lako prepoznavanje 
            dokumenata unutar organizacije ili sistema. </br>
            Ukoliko želite da kreirate numeraciju neophodno je da idete na dugme <b><em>„Novi unos“</em></b>. 
            Klikom na dugme otvoriće se modalni dijalog u kome ćete unijeti sljedeće podatke: 
            <ul>
                <li>vrsta naloga,</li> 
                <li>prefix,</li> 
                <li>dužina brojača,</li> 
                <li>sufix,</li>
                <li>auto restart.</li>
            </ul>
            ```
    }

    region numeracija-dokumenata (
        name: Numeracija dokumenata
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region numeracija-dokumenata-report (
        name: Numeracija dokumenata Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    null as list_title,
                    null as list_text,
                    null as list_badge,
                    
                    vrsta_naloga_naziv,
                    godina,
                    prefix,
                    lpad(broj, duzina, '0') as broj,
                    sufix,
                    auto_restart,
                
                    apex_page.get_url(
                        p_page   => 104,
                        p_items  => 'P104_ID',
                        p_values => id
                    ) as link,
                    case 
                        when valid = 'Y' then
                            'u-color-5'
                        else
                            'u-color-9'
                    end as icon_color_class,
                    'fa fa-file-wrench' as icon_class
                FROM
                    core.vw_protokoli
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND godina = :APP_GODINA
                    AND upper(vrsta_naloga_app_naziv) = 'FINANSIJE' 
                ORDER BY
                    vrsta_naloga_sifra ASC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: [
                fin-list
                fin-list--media
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                t-MediaList--stack
                t-MediaList--iconsRounded
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column AUTO_RESTART (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Auto Restart
            }
            layout {
                sequence: 150
            }
            sorting {
                sortable: false
            }
        )

        column BROJ (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Broj
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column GODINA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Godina
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column ICON_CLASS (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Icon Class
            }
            layout {
                sequence: 140
            }
            sorting {
                sortable: false
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Icon Color Class
            }
            layout {
                sequence: 130
            }
            sorting {
                sortable: false
            }
        )

        column LINK (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Link
            }
            layout {
                sequence: 120
            }
            sorting {
                sortable: false
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: List Badge
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if AUTO_RESTART/}
                        <span class="t-Button t-Button--noLabel u-color-5 t-Button--iconLeft">
                            <span class="t-Icon t-Icon--left fa fa-refresh"></span>
                        </span>
                    {elseif !=AUTO_RESTART/}
                        <span class="t-Button t-Button--noLabel u-color-9 t-Button--iconLeft">
                            <span class="t-Icon t-Icon--left fa fa-ban"></span>
                        </span>
                    {endif/}
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: List Text
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: Poslednji dokument: <b>#PREFIX##BROJ##SUFIX#</b>
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: List Title
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: #VRSTA_NALOGA_NAZIV# / #GODINA#
            }
            sorting {
                sortable: false
            }
        )

        column PREFIX (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Prefix
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column SUFIX (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Sufix
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column VRSTA_NALOGA_NAZIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Vrsta Naloga Naziv
            }
            layout {
                sequence: 110
            }
            sorting {
                sortable: false
            }
        )

    )

    region pretraga (
        name: Pretraga
        type: smartFilters
        source {
            filteredRegion: @numeracija-dokumenata-report
        }
        layout {
            sequence: 9
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P103_SEARCH (
            type: search
            label {
                label: Pretraga
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

    )

    button copy (
        buttonName: COPY
        label: Kopiraj osnovnu numeraciju
        layout {
            sequence: 10
            region: @numeracija-dokumenata
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 106
                clearCache: 106
                request: copy_basic
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: APP_OOJ_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 30
            region: @numeracija-dokumenata
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 104
                clearCache: 104
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: APP_OOJ_ID
        }
    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 2
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @numeracija-dokumenata-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-2 (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @numeracija-dokumenata-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @numeracija-dokumenata-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-3 (
        name: Dialog Closed - Refresh 3
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @copy
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @numeracija-dokumenata-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

