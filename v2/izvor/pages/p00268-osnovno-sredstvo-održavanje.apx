            item: P268_DATUM
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P268_DATUM
        }
    )

    validation naziv-not-null (
        name: Naziv NOT NULL
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P268_NAZIV
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P268_NAZIV
        }
    )

    validation opis-not-null (
        name: Opis NOT NULL
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P268_OPIS
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P268_OPIS
        }
    )

    validation os-not-null (
        name: OS NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P268_OSNOVNO_SREDSTVO_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P268_OSNOVNO_SREDSTVO_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 97450052478142970
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_os_odrzavanje t_sec_osnovno_sredstvo_odrzavanje;
                BEGIN
                    l_os_odrzavanje := t_sec_osnovno_sredstvo_odrzavanje ();
                    l_os_odrzavanje.id := :P268_ID;
                    
                    os_pkg.delete_osnovno_sredstvo_odrzavanje (
                        p_os_odrzavanje => l_os_odrzavanje
                    );
                END;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 97428655423182218
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_os_odrzavanje t_sec_osnovno_sredstvo_odrzavanje;
                BEGIN
                    l_os_odrzavanje := t_sec_osnovno_sredstvo_odrzavanje();
                    
                    l_os_odrzavanje.osnovno_sredstvo_id := :P268_OSNOVNO_SREDSTVO_ID;
                    l_os_odrzavanje.naziv := :P268_NAZIV;
                    l_os_odrzavanje.opis := :P268_OPIS;
                    l_os_odrzavanje.datum := :P268_DATUM;
                    l_os_odrzavanje.cijena := to_number(:P268_CIJENA, '999G999G999G999G990D00');
                    l_os_odrzavanje.sledeci_servis := :P268_SLEDECI_SERVIS;
                
                    os_pkg.insert_osnovno_sredstvo_odrzavanje (
                        p_os_odrzavanje => l_os_odrzavanje
                    );
                END;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 97428557478182217
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

