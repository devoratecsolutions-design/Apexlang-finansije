    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                l_jed_cijena_valuta number;
                l_cijena number;
                begin 
                
                        if :P58_ID is not null then 
                            
                            finansije_pkg.get_kif_stavka (
                                p_id               => :P58_ID,
                                p_kif_id           => :P58_KIF_ID,
                                p_stavka_id        => :P58_STAVKA_ID,
                                p_jm_id            => :P58_JM_ID,
                                p_kolicina         => :P58_KOLICINA,
                                p_cijena           => :P58_CIJENA,
                                p_rabat            => :P58_RABAT,
                                p_pdv              => :P58_PDV,
                                p_iznos            => :P58_IZNOS,
                                p_pdv_indikator_id => :P58_PDV_INDIKATOR_ID
                            );
                
                            :P58_IZNOS_PDV:=round(:P58_IZNOS + (:P58_IZNOS * :P58_PDV / 100),2);
                            
                            :P58_IZNOS:=to_char(:P58_IZNOS,'999G999G999G999G990D00');
                            :P58_IZNOS_PDV:=to_char(:P58_IZNOS_PDV,'999G999G999G999G990D00');
                
                            if :P54_VALUTA_SIFRA !='BAM' then
                                
                                l_jed_cijena_valuta:= :P58_CIJENA/:P54_KURS;
                                l_cijena :=l_jed_cijena_valuta - (l_jed_cijena_valuta * :P58_RABAT / 100);
                                
                                :P58_CIJENA_VALUTA:=l_jed_cijena_valuta;
                                :P58_IZNOS_VALUTA := round(:P58_KOLICINA * l_cijena,2);
                                :P58_IZNOS_VALUTA_PDV := round(:P58_IZNOS_VALUTA + (:P58_IZNOS_VALUTA * :P58_PDV / 100),2);
                                :P58_IZNOS_VALUTA:=to_char(:P58_IZNOS_VALUTA,'999G999G999G999G990D00');
                                :P58_IZNOS_VALUTA_PDV:=to_char(:P58_IZNOS_VALUTA_PDV,'999G999G999G999G990D00');
                
                            end if;
                
                
                        else
                
                            null;
                            :P58_KOLICINA:=1;
                            :P58_PDV_INDIKATOR_ID:=:P54_PDV_INDIKATOR_ID;
                        end if;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 157319147210796169
        }
    )

