page 20010 (
    name: Push obaveštenja
    alias: PUSH-OBAVEŠTENJA
    title: Push obaveštenja
    pageGroup: @erp-globalne-stranice
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads: apex.pwa.initPushSubscriptionPage();
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: This page contains the settings for controlling push notification subscription for the current user.
    }
    config {
        buildOption: @feature-push-notifications
    }

    region obaveštenja-nisu-podržana (
        name: Obaveštenja nisu podržana
        type: staticContent
        source {
            htmlCode: Obaviještenja trenutno nisu dostupna na vašem pretraživaču.
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--warning
            ]
            cssClasses: a-pwaPush--subscriptionRegion--not-supported
            icon: fa-bell-slash-o
            renderComponents: belowContent
        }
        advanced {
            customAttributes: style="display:none;"
        }
    )

    region push-notifications (
        name: Push Notifications
        type: staticContent
        source {
            htmlCode: Push obaveštenja moraju biti omogućena za svaki uređaj na kojem želite da primate obaveštenja. Kada prvi put omogućite push obaveštenja, moraćete da date dozvolu svom pretraživaču. Ovo podešavanje se može promeniti u bilo kom trenutku.
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--wizard
                t-Alert--noIcon
                t-Alert--info
                t-Alert--removeHeading js-removeLandmark
            ]
            cssClasses: a-pwaPush--subscriptionRegion
            icon: fa-bell-o
            renderComponents: belowContent
        }
    )

    pageItem P20010_ENABLE_PUSH (
        type: checkbox
        label {
            label: Uključite obaveštenja na ovom uređaju
            alignment: left
        }
        layout {
            sequence: 10
            region: @push-notifications
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
        }
    )

    button back (
        buttonName: BACK
        label: Podešavanja
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--link
                t-Button--iconLeft
            ]
            cssClasses: t-Button--inlineLink
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 20000
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction change-p20010-enable-push (
        name: Change P20010_ENABLE_PUSH
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P20010_ENABLE_PUSH
        }
        clientSideCondition {
            type: item=value
            item: P20010_ENABLE_PUSH
            value: Y
        }

        action subscribe-to-push-notifications (
            name: Subscribe to push notifications
            action: executeJsCode
            settings {
                jsCode: apex.pwa.subscribePushNotifications();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action unsubscribe-from-push-notifications (
            name: Unsubscribe from push notifications
            action: executeJsCode
            settings {
                jsCode: apex.pwa.unsubscribePushNotifications();
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

    )

)

