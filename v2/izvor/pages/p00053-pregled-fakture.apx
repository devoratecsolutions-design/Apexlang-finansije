    region osnovni-podaci (
        name: Osnovni podaci
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    :P53_NAZIV_FAKTURE as naziv_fakture,
                    coalesce(:P53_DANI, :P51_DANI_NEW) as dani,
                    :P53_DATUM_FAKTURE as datum_fakture,
                    :P53_DATUM_VALUTE as datum_valute,
                    :P53_TIP_PLACANJA_ID as tip_placanja,
                    :P53_VALUTA_ID as valuta,
                    :P53_TIP_DOKUMENTA_NAZIV as uio_tip_dokumenta,
                    :P51_FAKTURA_ID as faktura_id,
                    :P51_UGOVOR_ID as ugovor_id,
                    :P51_OJ_ID as oj_id
                FROM
                    dual
                ```
        }
        layout {
            sequence: 10
            parentRegion: @osnovni-podaci_1
            slot: subRegions
            columnSpan: 6
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
                t-Report--hideNoPagination
            ]
        }
