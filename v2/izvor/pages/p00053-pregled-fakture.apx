    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                SELECT
                
                    to_char(sum(c007),'999G999G999G999G990D00') osnovica, 
                    to_char(round(sum(c007)/:P53_KURS,2),'999G999G999G999G990D00') osnovica_valuta,
                    to_char(sum(c008) - sum(c007),'999G999G999G999G990D00') pdv, 
                    to_char(round(sum(c008)/:P53_KURS,2) - round(sum(c007)/:P53_KURS,2),'999G999G999G999G990D00') pdv_valuta,
                    to_char(sum(c008),'999G999G999G999G990D00') ukupno, 
                    to_char(round(sum(c008)/:P53_KURS,2),'999G999G999G999G990D00') ukupno_valuta
                
                INTO
                    :P53_OSNOVICA,
                    :P53_OSNOVICA_VALUTA,
                    :P53_PDV,
                    :P53_PDV_VALUTA, 
                    :P53_UKUPNO,
                    :P53_UKUPNO_VALUTA
                
                FROM
                    apex_collections
                WHERE
                    collection_name = 'FAKTURA_STAVKE';
                
                
                
                with avans_konvert as (select  case when :P53_VALUTA_SIFRA=val.sifra then to_number(c002)
                                                    when :P53_VALUTA_SIFRA='BAM' then     round(sif.acc_pkg.convert_valuta_to_bam(val.id,:APP_OOJ_ID,k.datum_fakture,to_number(c002)),2)
                                                    else round(sif.acc_pkg.convert_valuta_from_bam(:P53_VALUTA_ID,:APP_OOJ_ID,k.datum_fakture,to_number(c002)),2)
                                                    end as iznos_valuta, 
                                                    pdv.vrijednost as pdv_v 
                                        from apex_collections ak 
                                        join kif k on ak.c001=k.id
                                        join sif.acc_valute val on val.id=k.valuta_id
                                        join sif.acc_pdv_indikatori pdv on pdv.id=k.pdv_indikator_id
                                        where collection_name = 'FAKTURA_AVANS')
                
                select  '-'||to_char(round(sum(iznos_valuta / (1 + pdv_v / 100)), 2),'999G999G999G999G990D00') as osnovica,
                        '-'||to_char((sum(iznos_valuta)- round(sum(iznos_valuta / (1 + pdv_v / 100)), 2)),'999G999G999G999G990D00') as pdv,
                        '-'||to_char(sum(iznos_valuta),'999G999G999G999G990D00') ukupno
                into    :P53_AV_OSNOVICA,
                        :P53_AV_PDV,
                        :P53_AV_UKUPNO
                from avans_konvert;
                
                :P53_UKUPNO_PLACANJE:=to_number(:P53_UKUPNO,'999G999G999G999G990D00')-to_number(nvl(replace(:P53_AV_UKUPNO,'-',''),'0.00'),'999G999G999G999G990D00');
                :P53_UKUPNO_PLACANJE_VALUTA:=to_number(:P53_UKUPNO_VALUTA,'999G999G999G999G990D00')-to_number(nvl(replace(:P53_AV_UKUPNO,'-',''),'0.00'),'999G999G999G999G990D00');
                
                :P53_UKUPNO_PLACANJE:=to_char(:P53_UKUPNO_PLACANJE,'999G999G999G999G990D00');
                :P53_UKUPNO_PLACANJE_VALUTA:=to_char(:P53_UKUPNO_PLACANJE_VALUTA,'999G999G999G999G990D00');
                
                
                
                
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 78193501222625322
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR c_stavke IS (
                        SELECT
                            c001 as stavka_id,
                            c002 as jm_id,
                            c003 as kolicina,
                            c004 as cijena,
                            c005 as rabat,
                            c006 as pdv,
                            c007 as iznos,
                            c008 as iznos_pdv,
                            c010 as pdv_indikator
                        FROM
                            apex_collections c
                        WHERE
                            collection_name = 'FAKTURA_STAVKE'
                        ) ORDER BY seq_id ASC;
                
                    l_faktura_id    NUMBER;
                
                    l_iznos_slovima VARCHAR2(1000);
                    l_iznos         NUMBER;
                    l_iznos_nopdv   NUMBER;
                    l_iznos_valuta  NUMBER;
                    l_iznos_valuta_npdv NUMBER;
                
                    l_sifra         VARCHAR2(64);
                    l_av_id     number;
                    l_avz_id    number:=null;
                    l_av_nf     varchar2(100);
                    l_av_broj   number;
                    l_av_slovima varchar2(200);
                    l_av_iznos_km number;
                BEGIN
                    SELECT sifra
                    INTO l_sifra
                    FROM sif.vrste_dokumenata
                    WHERE
                        id = :P53_VRSTA_FAKTURE_ID;
                
                    FOR c1 IN (
                        SELECT
                            CASE
                                WHEN :P53_VALUTA_SIFRA = 'BAM' THEN 
                                    sif.spell_pkg.spell_serbian_number (coalesce(round(sum(c008), 2), 0), 'Y', 'J', :P53_VALUTA_NAZIV)
                                ELSE
                                    sif.spell_pkg.spell_serbian_number (coalesce(round(sum(c008/:P53_KURS), 2), 0), 'Y', 'J', :P53_VALUTA_NAZIV)
                            END as slovima,
                            sum(c008) as iznos,
                            sum(c007) as iznos_nopdv,
                
                            round(sum(c008/:P53_KURS), 2) as iznos_valuta,
                            round(sum(c007/:P53_KURS), 2) as iznos_valuta_npdv
                
                        FROM
                            apex_collections
                        WHERE
                            collection_name = 'FAKTURA_STAVKE'
                
                    ) LOOP
                        l_iznos_slovima := c1.slovima;
                        l_iznos := c1.iznos;
                        l_iznos_nopdv := c1.iznos_nopdv;
                        l_iznos_valuta := c1.iznos_valuta;
                        l_iznos_valuta_npdv := c1.iznos_valuta_npdv;
                
                    END LOOP;
                
                    l_faktura_id := finansije_pkg.insert_kif (
                        p_glavna_knjiga_id     => null,
                        p_klijent_id           => :P53_KLIJENT_ID,
                        p_valuta_id            => :P53_VALUTA_ID,
                        p_valuta_iznos         => l_iznos_valuta,
                        p_valuta_iznos_pdv     => l_iznos_valuta_npdv,
                        p_ooj_id               => :APP_OOJ_ID,
                        p_predracun_id         => null,
                        p_faktura_broj         => :P53_FAKTURA_BROJ,
                        p_naziv_fakture        => :P53_NAZIV_FAKTURE,
                        p_godina               => :APP_GODINA,
                        p_datum_uplatnice      => null,
                        p_iznos_fakture        => l_iznos,
                        p_iznos_slovima        => l_iznos_slovima,
                        p_datum_valute         => :P53_DATUM_VALUTE,
                        p_iznos_fakture_nopdv  => l_iznos_nopdv,
                        p_uplaceno             => 'N',
                        p_posebne_napomene     => :P53_POSEBNE_NAPOMENE,
                        p_datum_fakture        => :P53_DATUM_FAKTURE,
                        p_print_pn             => :P53_PRINT_PN,
                        p_tip_placanja_id      => :P53_TIP_PLACANJA_ID,
                        p_uio_tip_dokumenta_id => :P53_TIP_DOKUMENTA_ID,
                        p_vrsta_fakture_id     => :P53_VRSTA_FAKTURE_ID,
                        p_faktura_id           => :P51_FAKTURA_ID,
                        p_tip_cijene           => :P51_TIP_CIJENE,
                        p_dani_dospijeca       => coalesce(:P53_DANI, :P51_DANI_NEW),
                        p_ugovor_id            => :P51_UGOVOR_ID,
                        p_oj_id                => :P51_OJ_ID,
                        p_skladiste_id         => :A_SKLADISTE_ID, 
                        p_pdv_indikator_id     => :P53_PDV_INDIKATOR_ID
                    );
                
                    FOR stavka IN c_stavke LOOP
                        finansije_pkg.insert_kif_stavka (
                            p_kif_id           => l_faktura_id,
                            p_stavka_id        => stavka.stavka_id,
                            p_jm_id            => stavka.jm_id,
                            p_kolicina         => stavka.kolicina,
                            p_cijena           => stavka.cijena,
                            p_rabat            => stavka.rabat,
                            p_pdv              => stavka.pdv,
                            p_iznos            => stavka.iznos,
                            p_pdv_indikator_id => stavka.pdv_indikator
                        );
                
                    END LOOP;
                
                    core.protokoli_pkg.update_brojac (
                        p_ooj_id             => :APP_OOJ_ID,
                        p_vrsta_naloga_sifra => l_sifra,
                        p_godina             => :APP_GODINA,
                        p_value              => 1
                    );
                
                    :P53_FAKTURA_ID := l_faktura_id;
                
                    --- avansi zatvaranje  -----
                
                    for k in ( select c001 as avans_id, c002 iznos from apex_collections c where collection_name='FAKTURA_AVANS')
                    loop
                
                
                        
                        --storno iznosa originalnog avansa---
                
                        for ki in (select kk.*,val.sifra as valuta_sifra, val.naziv as valuta_naziv,  pdv.vrijednost, vd.sifra as vrsta_dokumenta_sifra
                                  from kif kk 
                                  join sif.acc_valute val on val.id=kk.valuta_id
                                  join sif.acc_pdv_indikatori pdv on pdv.id=kk.pdv_indikator_id
                                  join sif.vrste_dokumenata vd on vd.id=kk.vrsta_fakture_id
                                  where kk.id=k.avans_id)
                        loop
                
                           apex_debug.info('BROJAC ulaz: ooj=%s sifra=%s godina=%s',
                                :APP_OOJ_ID, ki.vrsta_dokumenta_sifra, :APP_GODINA);
                
                            core.protokoli_pkg.get_brojac (
                                            p_ooj_id             => :APP_OOJ_ID,
                                            p_vrsta_naloga_sifra => 'AVZ',
                                            p_godina             => :APP_GODINA,
                                            p_broj               => l_av_broj,
                                            p_naziv              => l_av_nf
                                        );
                
                            apex_debug.info('BROJAC izlaz: broj=%s naziv=%s', l_av_broj, l_av_nf);
                
                            l_av_iznos_km:=round(sif.acc_pkg.convert_valuta_to_bam(ki.valuta_id,:APP_OOJ_ID,ki.datum_fakture,to_number(k.iznos)),2);
                
                            l_av_id := finansije_pkg.insert_kif (
                                                        p_glavna_knjiga_id     => null,
                                                        p_klijent_id           => ki.klijent_id,
                                                        p_valuta_id            => ki.valuta_id,
                                                        p_valuta_iznos         => -round(k.iznos / (1 + ki.vrijednost / 100), 2),
                                                        p_valuta_iznos_pdv     => -k.iznos,
                                                        p_ooj_id               => ki.ooj_id,
                                                        p_predracun_id         => null,
                                                        p_faktura_broj         => l_av_broj,
                                                        p_naziv_fakture        => l_av_nf,
                                                        p_godina               => :APP_GODINA,
                                                        p_datum_uplatnice      => null,
                                                        p_iznos_fakture        => -l_av_iznos_km,
                                                        p_iznos_slovima        => '-'||sif.spell_pkg.spell_serbian_number (k.iznos, 'Y', 'J', ki.valuta_naziv),
                                                        p_datum_valute         => :P53_DATUM_FAKTURE,
                                                        p_iznos_fakture_nopdv  => -round(l_av_iznos_km / (1 + ki.vrijednost / 100), 2),
                                                        p_uplaceno             => 'Y',
                                                        p_posebne_napomene     => :P53_NAZIV_FAKTURE,
                                                        p_datum_fakture        => :P53_DATUM_FAKTURE,
                                                        p_print_pn             => ki.print_pn,
                                                        p_tip_placanja_id      => ki.tip_placanja_id,
                                                        p_uio_tip_dokumenta_id => ki.uio_tip_dokumenta_id,
                                                        p_vrsta_fakture_id     => ki.vrsta_fakture_id,
                                                        p_faktura_id           => ki.id,
                                                        p_tip_cijene           => ki.tip_cijene,
                                                        p_dani_dospijeca       => 0,
                                                        p_ugovor_id            => ki.ugovor_id,
                                                        p_oj_id                => ki.oj_id,
                                                        p_skladiste_id         => ki.skladiste_id, 
                                                        p_pdv_indikator_id     => ki.pdv_indikator_id
                                                    );
                            for av_stavka in (select * from kif_stavke ks where ks.kif_id=ki.id)
                            loop
                                 
                                 finansije_pkg.insert_kif_stavka (
                                        p_kif_id           => l_av_id,
                                        p_stavka_id        => av_stavka.stavka_id,
                                        p_jm_id            => av_stavka.jm_id,
                                        p_kolicina         => -av_stavka.kolicina,
                                        p_cijena           => l_av_iznos_km,
                                        p_rabat            => av_stavka.rabat,
                                        p_pdv              => av_stavka.pdv,
                                        p_iznos            => -l_av_iznos_km,
                                        p_pdv_indikator_id => av_stavka.pdv_indikator_id
                                    );
                
                            end loop;
                
                             core.protokoli_pkg.update_brojac (
                                    p_ooj_id             => :APP_OOJ_ID,
                                    p_vrsta_naloga_sifra =>  'AVZ',
                                    p_godina             => :APP_GODINA,
                                    p_value              => 1
                                );
                
                            ------veza kif-avans-----
                
                            finansije_pkg.insert_kif_avansi_zatvaranje (
                                  p_ooj_id            =>  :APP_OOJ_ID,
                                  p_avans_id          =>  k.avans_id,
                                  p_faktura_id        =>  l_faktura_id,
                                  P_avans_zatvaranja_id  => l_av_id,
                                  p_datum_zatvaranja  =>  :P53_DATUM_FAKTURE,
                                  p_iznos             =>  k.iznos,
                                  p_napomena          =>  :P53_NAZIV_FAKTURE,
                                  p_id                =>  l_avz_id
                            );
                
                
                
                
                        end loop; 
                
                    end loop;
                
                    --------
                
                    -- IF :P53_VRSTA_FAKTURE_ID = 1 THEN
                    --     skladista_pkg.insert_kif (
                    --         p_ooj_id => :APP_OOJ_ID,
                    --         p_godina => :APP_GODINA,
                    --         p_kif_id => l_faktura_id
                    --     );
                    -- END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Uspješno ste kreirali fakturu.
        }
        advanced {
            executionMappingIdentifier: 157240417026773843
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: FINISH,FINISH_FISKALIZACIJA
        }
    )

    process new (
        name: Uračunaj avanse
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_iznos_avansa number;
                    v_avans_id number;
                BEGIN
                
                    apex_collection.create_or_truncate_collection (
                            p_collection_name => 'FAKTURA_AVANS');
                
                    if :P53_AVANS_SWITCH='Y' THEN 
                
                       for i in 1..apex_application.g_f01.count
                        loop
                        
                            v_iznos_avansa := to_number(replace(replace(trim(apex_application.g_f01(i)), ','), ' '),'999999999999990D99','NLS_NUMERIC_CHARACTERS=''.,''');
                            v_avans_id     := apex_application.g_f03(i);
                
                
                          if v_iznos_avansa>0 then 
                
                              apex_collection.add_member (
                                    p_collection_name => 'FAKTURA_AVANS',
                                    p_c001            => v_avans_id,
                                    p_c002            => v_iznos_avansa
                                );
                                
                          end if;
                
                        end loop;
                
                    end if;
                
                 :P53_AVANS_URACUNAT:=:P53_AVANS_SWITCH;
                    
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 78194435934625331
        }
        serverSideCondition {
            type: request=Value
            value: AVANS_TOGGLE
        }
    )

