    dynamicAction uračunaj-avanse (
        name: Uračunaj avanse
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P53_AVANS_URACUNAT
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P53_AVANS_URACUNAT='Y' then 
                    
                        :P53_AVANS_SWITCH:='N';
                    
                    else
                    
                        :P53_AVANS_SWITCH:='Y';
                    
                    end if;
                    ```
                itemsToSubmit: P53_AVANS_URACUNAT
                itemsToReturn: P53_AVANS_SWITCH
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                      var novo  = $v("P53_AVANS_URACUNAT");
                      var staro = $v("P53_AVANS_SWITCH");
                    
                      // vrati switch na staro stanje, bez novog change događaja
                      $s("P53_AVANS_URACUNAT", staro, null, true);
                    
                      // pošalji željeno stanje i submituj
                      $s("P53_AVANS_SWITCH", novo);
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P53_AVANS_KLIKNUT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: AVANS_TOGGLE
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    validation print-not-null (
        name: Print NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P53_PRINT_PN
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P53_PRINT_PN
        }
        serverSideCondition {
            type: request=Value
            value: FINISH,FINISH_FISKALIZACIJA
        }
    )

    validation uračunaj-avans (
        name: Uračunaj AVANS
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                
                v_iznos_fakture number;
                v_1 number:=0;
                v_2 number:=0;
                v_3 number:=0;
                v_iznos_avansa_uk number:=0;
                v_iznos_avansa number:=0;
                v_iznos_avansa_rasp number:=0;
                
                v_poruka varchar2(200):='';
                v_protokol_pom number;
                
                
                
                
                begin
                
                
                
                
                    if :P53_AVANS_SWITCH='Y' then 
                
                
                        select count(*)
                        into v_protokol_pom
                        from sif.vrste_dokumenata vd
                        join core.protokoli cp on vd.id=cp.vrsta_naloga_id
                        where  vd.sifra = 'AVZ'
                        and vd.ooj_id=:APP_OOJ_ID
                        and cp.godina=:APP_GODINA;
                
                        if v_protokol_pom=0 then 
                
                           return  'Najprije je potrebno definisati numeraciju za vrstu dokumenta Avansna faktura - Zatvaranje!'; 
                
                        else
                
                   
                                for i in 1..apex_application.g_f01.count
                                loop
                                
                                    v_iznos_avansa := to_number(replace(replace(trim(apex_application.g_f01(i)), ','), ' '),'999999999999990D99','NLS_NUMERIC_CHARACTERS=''.,''');
                                    v_iznos_avansa_rasp:=to_number(apex_application.g_f02(i), 'FM999G999G999G999G990D00');
                
                                    if v_iznos_avansa>0 then
                                        v_2:=v_2+1;
                                    end if;
                
                                    if v_iznos_avansa<0 then
                                        v_1:=v_1+1;
                                    end if;
                
                                    if v_iznos_avansa>v_iznos_avansa_rasp then
                                        v_3:=v_3+1;
                                    end if;
                
                                    v_iznos_avansa_uk:=v_iznos_avansa_uk+v_iznos_avansa;
                                end loop;
                
                
                                if v_1>0 then
                
                                    return 'Uračunati avans ne može biti manji od 0!'; 
                
                
                                elsif v_2=0 then
                
                                    return 'Morate unijeti barem jedan iznos već od 0!'; 
                            
                
                                elsif v_3>0 then
                
                                    return 'Uračunati avans ne može bit veći od raspoloživog!'; 
                            
                
                                else 
                
                                    
                                    SELECT sum(nvl(c008,0))
                                    into v_iznos_fakture
                                    from apex_collections c
                                    where collection_name = 'FAKTURA_STAVKE';
                
                                    if v_iznos_fakture<v_iznos_avansa_uk then 
                
                                        return 'Uračunati avans ne može biti veći od iznosa fakture!';
                
                                    end if;
                
                
                
                                end if;
                
                        end if;
                
                    else
                
                               
                        return  null;
                    end if;
                
                
                end;
                ```
        }
        serverSideCondition {
            type: request=Value
            value: AVANS_TOGGLE
        }
    )

