page 53 (
    name: Pregled fakture
    alias: PREGLED-FAKTURE
    title: Pregled fakture
    pageGroup: @fakture-računi
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
               #avansi_rpt th#R,
               #avansi_rpt td[headers="R"] {
                 display: none;
               }
            
            .iznosi-forma .t-Form-fieldContainer {
              display: flex !important;
              align-items: baseline;
              justify-content: space-between;
              gap: 12px;
              width: 100%;
            }
            .iznosi-forma .t-Form-labelContainer {
              flex: 1 1 auto !important;
              width: auto !important;
              max-width: none !important;
              text-align: left !important;
              padding-left: 0;
            }
            .iznosi-forma .t-Form-inputContainer {
              flex: 0 0 auto !important;
              width: auto !important;
              max-width: none !important;
            }
            .iznosi-forma .display_only {
              display: block;
              text-align: right;
              font-weight: 600;
            }
            
            .iznosi-forma .rk-ukupno {
              border-top: 1px solid #d5d8dd;
              margin-top: 8px;
              padding-top: 8px;
            }
            
            .iznosi-forma .rk-ukupno .display_only {
              font-size: 1rem;
              font-weight: 700;
            }
            /* labela */
            .iznosi-forma .rk-ukupno .t-Form-label {
              font-size: 1rem;
              font-weight: 700;
              color: inherit;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    help {
        helpText:
            ```html
            U završnoj fazi unosa otvara se stranica na kojoj ćete završiti kreiranje fakture 
            na kojoj imate mogućnost za unos posebnih napomena koje će biti prikazane na fakturi. 
            Nakon toga korisnik dobija pregled svih ključnih podataka: 
            <ul>
                <li>osnovni podaci o fakturi, </li>
                <li>podaci o klijentu,</li> 
                <li>stavke </li>
                <li>ukupna cijena</li>
            </ul>
            Kada se provjeri ispravnost, faktura se 
            kreira potvrdom na dugme <b><em>"Kreiraj"</em></b>. </br>
            Nakon kreiranja potrebno je odštampati fakturu i 
            fiskalni račun potvrdom na dugme kreiraj i fiskalizuj.</br>
            Ovakav proces unosa i obrade izlaznih faktura omogućava dosljednu evidenciju, 
            te potpunu integraciju sa KIF-om i PDV prijavom.
            ```
    }

    region klijent (
        name: Klijent
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    tip_klijenta_naziv,
                    naziv,
                    drzava_naziv,
                    adresa,
                    grad,
                    email,
                    jib,
                    pib
                FROM
                    vw_klijenti
                WHERE
                    id = :P53_KLIJENT_ID
                ```
        }
