    region primljeni-avansi (
        name: Uračunj primljene avanse
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *,
                
                        APEX_ITEM.HIDDEN(
                            p_idx        => 3,
                            p_value      => id
                        ) AS id_r,
                  
                        APEX_ITEM.DISPLAY_AND_SAVE(
                            p_idx        => 2,
                            p_value      =>TO_CHAR(raspolozivo, 'FM999G999G999G999G990D00')
                
                        ) AS raspolozivo_r,
                
                
                        APEX_ITEM.TEXT(
                        p_idx        => 1,
                        p_value      => TO_CHAR(0, 'FM999G999G999G999G990D00'), 
                        p_size       => 13,
                        p_attributes => 'style="text-align: right;" class="u-textRight"'
                    ) AS za_uracunavanje
                from vw_kif_raspolozivi_avansi v
                where v.ooj_id=:APP_OOJ_ID
                and (:P53_VALUTA_SIFRA='BAM' or v.valuta_sifra='BAM' or v.valuta_sifra=:P53_VALUTA_SIFRA)
                and v.klijent_id=:P53_KLIJENT_ID
                order by v.datum_fakture 
                ```
        }
        layout {
            sequence: 40
            parentRegion: @osnovni-podaci_1
            slot: subRegions
            columnSpan: 12
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: fin-ir
        }
        advanced {
            htmlDomId: avansi_rpt
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                v_pom number;
                begin 
                
                select count(*) 
                into v_pom 
                from vw_kif_raspolozivi_avansi v
                where v.ooj_id=:APP_OOJ_ID;
                
                if v_pom>0 then 
                    return true;
                else 
                    return false;
                end if;
                
                
                end;
                ```
        }
        pagination {
            type: rowRangesXToY
        }
