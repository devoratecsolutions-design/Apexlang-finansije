    region referentni-dokumenti (
        name: Referentni dokumenti
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vk.godina, vk.broj, vk.datum_fakture, vk.datum_valute,vk.tip_dokumenta as vrsta_fakture, vk.partner_naziv, vk.pdv_indikator,vk.iznos_bez_pdv, vk.iznos_sa_pdv, vk.naziv_fakture 
                from vw_kufovi vk 
                join (select distinct n003 as dok_id
                      from apex_collections
                      where collection_name = 'SADRZAJ_GK_UF') kol on vk.kuf_id=kol.dok_id
                order by vk.datum_fakture
                ```
        }
        layout {
            sequence: 10
            parentRegion: @nalog
            slot: subRegions
            columnSpan: 8
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

