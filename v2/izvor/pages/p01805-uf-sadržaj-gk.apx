    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @nova-stavka
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT to_char(sum (case when c005='D' then n001 else 0 end ), '999G999G999G999G990D00') as duguje,
                           to_char(sum (case when c005='P' then n001 else 0 end), '999G999G999G999G990D00') as potrazuje 
                    into :P1805_DUGUJE, :P1805_POTRAZUJE
                    FROM apex_collections
                    WHERE collection_name = 'SADRZAJ_GK_UF';
                    ```
                itemsToReturn: [
                    P1805_DUGUJE
                    P1805_POTRAZUJE
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: checkDugujePotrazuje();
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stavke-konta-grid
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

