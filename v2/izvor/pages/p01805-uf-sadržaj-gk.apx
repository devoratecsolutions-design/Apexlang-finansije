    validation proknjiži-izvod (
        name: Proknjiži fakturu
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                
                    v_stavka_suma_knjig number;
                    v_stavka_suma_izvod number;
                    v_rbr number:=0;
                    v_ukupno number;
                    v_izvod_porknjizen varchar2(1);
                    v_konto_unesen number;
                
                
                
                begin
                
                
                
                        if :P1805_DATUM_NALOGA is null then 
                
                            return 'Datum naloga je obavezno polje!';
                
                        elsif :P1805_OPIS_NALOGA is null then 
                
                             return 'Opis naloga je obavezno polje!';
                        end if;
                
                
                        ------provjera da li je svaka faktura ispravno razbijena za knjiženje-----
                
                        for r in (SELECT 
                                           sum(n001) as iznos,
                                           c009 as dokument
                
                                        FROM apex_collections
                                        WHERE collection_name = 'SADRZAJ_GK_UF'
                                        group by n003,c009
                                        order by n003)
                
                        loop
                
                            if r.iznos<>0 then 
                                return 'Za dokument '||r.dokument||' knjiženje nije u ravnoteži!';
                            end if;
                
                        end loop;
                
                
                        
                        -----------provjera da li je nalog u ravnoteži-------
                
                        SELECT sum(n001)  AS iznos
                        into v_ukupno
                        FROM apex_collections
                        WHERE collection_name = 'SADRZAJ_GK_UF';
                
                        if v_ukupno!=0 then 
                
                           return 'Nalog nije u ravnoteži!'; 
                
                        end if;
                        --------
                
                    
                
                        --------- provjera da li su konta sva unesena----
                        select count(n002)
                        into v_konto_unesen
                        from  apex_collections
                        where collection_name = 'SADRZAJ_GK_UF'
                        and c006 is null;
                
                        if v_konto_unesen>0 then 
                            return 'Neophodno je za savki red unijeti odgovarajuće konto!'; 
                        end if;
                
                        ---------------provjera da li su za izabrana konta unijeti obavezni parametri----
                       for r in (SELECT 
                                    c002 AS partner,
                                    null AS opstina,
                                    null  AS radnik,
                                    c003  AS mjesto_tr,
                                    c006  AS konto,
                                    c004  AS pdv_indikator
                                 FROM apex_collections
                                 WHERE collection_name = 'SADRZAJ_GK_UF')
                
                        loop
                
                        return sif.acc_pkg.validate_konto_obavezna_polja(
                                p_kontna_klasa_id     => r.konto,
                                p_ooj_id              => :APP_OOJ_ID,
                                p_klijent_id          => r.partner,
                                p_oj_id               => r.mjesto_tr,
                                p_radnik_id           => r.radnik,
                                p_pdv_indikator_id    => r.pdv_indikator,
                                p_osnovno_sredstvo_id => null
                            );
                
                        end loop;
                
                
                end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @proknjizi
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                SELECT to_char(sum (case when c005='D' then n001 else 0 end ), '999G999G999G999G990D00') as duguje,
                       to_char(sum (case when c005='P' then n001 else 0 end), '999G999G999G999G990D00') as potrazuje 
                into :P1805_DUGUJE, :P1805_POTRAZUJE
                FROM apex_collections
                WHERE collection_name = 'SADRZAJ_GK_UF';
                
                
                
                
                
                select  max(sn.id),max(sn.sifra||' - '||sn.naziv),'Ulazna faktura - '||listagg(grp.dio_opisa, ': ') within group (order by grp.godina)
                into :P1805_VRSTA_NALOGA_ID, :P1805_VRSTA_NALOGA, :P1805_OPIS_NALOGA
                from (
                        select 
                            k.godina,
                            'UF/' || 
                            listagg(to_char(k.broj), ',') within group (order by k.broj) || '/' || k.godina as dio_opisa
                        from accounting.kuf k
                        where k.id in (
                                        select distinct n003
                                        from apex_collections
                                        where collection_name = 'SADRZAJ_GK_UF'
                                       )
                        group by k.godina
                    ) grp
                join sif.sif_vrste_naloga sn on sn.id = :P1805_VRSTA_NALOGA_ID;
                
                :P1805_DATUM_NALOGA:=TRUNC(SYSDATE);
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 280460743607043124
        }
    )

    process proknjiži-izvod (
        name: Proknjiži fakturu
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                
                v_godina number;
                v_broj_naloga number;
                v_id_naloga_gk number;
                v_id_stavke_gk number;
                v_id_gks_dok number;
                v_id_gks_zat number;
                v_broj_zat number;
                v_opis_dok varchar2(1000);
                
                begin 
                
                ---------- kreiranje zaglavlja glavne knjige -------
                    v_godina:=EXTRACT(YEAR FROM TO_DATE(:P1805_DATUM_NALOGA, 'DD.MM.YYYY'));
                    v_broj_naloga:=accounting.glavna_knjiga_pkg.get_broj_naloga(:APP_OOJ_ID,:P1805_VRSTA_NALOGA_ID,v_godina);
                
                
                    v_id_naloga_gk:=accounting.glavna_knjiga_pkg.insert_glavna_knjiga (
                                                                p_ooj_id           => :APP_OOJ_ID,
                                                                p_vrsta_naloga_id  => :P1805_VRSTA_NALOGA_ID,
                                                                p_godina           => v_godina,
                                                                p_broj             => v_broj_naloga,
                                                                p_datum_dokumenta  => null,
                                                                p_datum_knjizenja  => :P1805_DATUM_NALOGA,
                                                                p_opis             => :P1805_OPIS_NALOGA,
                                                                p_stornirano       => 'N',
                                                                p_storniran_id     => NULL,
                                                                p_ooj_banka_id     => NULL,
                                                                p_broj_izvoda      => NULL,
                                                                p_pocetno_stanje   => NULL,
                                                                p_zakljucno_stanje => NULL, 
                                                                p_proknjizeno      => 'Y'
                                                            );
                --------------------------------------------------
                
                ------kreiranje stavke glavne knjige-------------
                
                
                    for r in (SELECT    c001  AS opis_transakcije,
                                                c002  AS partner,
                                                c003  AS mjesto_tr,
                                                c004  AS pdv_indikator,
                                                c005  AS strana_knjizenja,
                                                c006  AS konto,
                                                c007  AS valuta,
                                                c008  AS otvorena_stavka,
                                                c009  AS dokument,
                                                c010  AS opis_dokumenta,
                                                n001  AS iznos,
                                                n002  AS rbr,
                                                n003  AS id_dok,
                                                d001  AS datum_dokumenta
                                            FROM apex_collections
                                            WHERE collection_name = 'SADRZAJ_GK_UF'
                                            order by n003, c005)
                
                            loop
                
                            accounting.glavna_knjiga_pkg.insert_glavna_knjiga_stavka (
                                p_glavna_knjiga_id      => v_id_naloga_gk,
                                p_kontna_klasa_id       => r.konto,
                                p_klijent_id            => r.partner,
                                p_tip_stavke            => r.strana_knjizenja,
                                p_opis                  => r.opis_transakcije,
                                p_iznos                 => r.iznos,
                                p_oj_id                 => null,
                                p_grad_id               => null,
                                p_prihod_rashod         => null,
                                p_vrsta_prihoda_id      => null,
                                p_vrsta_rashoda_id      => null,
                                p_nacin_placanja_izvoda => null,
                                p_automatska            => null,
                                p_valuta_id             => r.valuta,
                                p_valuta_iznos          => round(r.iznos/sif.acc_pkg.get_kurs_na_dan(r.valuta,:APP_OOJ_ID,r.datum_dokumenta),2),
                                p_kurs                  => null,
                                p_kif_id                => null,
                                p_kuf_id                => null,
                                p_priznat_rashod        => null,
                                p_datum_dokumenta       => r.datum_dokumenta,
                                p_otvorena              => case when NVL(r.otvorena_stavka,'N')='N' then 'Z' else 'O'  end,
                                p_otvoreni_iznos        => case when NVL(r.otvorena_stavka,'N')='N' then  0  else r.iznos  end,
                                p_mjesto_troska_id      => r.mjesto_tr,
                                p_acc_radnik_id         => null,
                                p_id                    => v_id_stavke_gk
                            );
                
                
                
                
                --------------------------------------------------
                
                ---------------kreiranje veze stavke glavne knjige sa originalnim dokumentom----
                
                        
                    accounting.glavna_knjiga_pkg.insert_gk_stavka_dokument (
                        p_ooj_id                  => :APP_OOJ_ID,
                        p_modul_id                => 3,
                        p_dokument_id             => r.id_dok,
                        p_dokument                => r.dokument,
                        p_opis                    => r.opis_dokumenta,
                        p_glavna_knjiga_stavka_id => v_id_stavke_gk,
                        p_id                      => v_id_gks_dok
                    );
                --------
                
                ------------------------------------------------------------------
                end loop;
                
                -----------updejt FAKTURA-----
                update accounting.kuf k
                set k.status='K', k.glavna_knjiga_id=v_id_naloga_gk
                where k.id in ( select distinct n003 
                                FROM apex_collections
                                WHERE collection_name = 'SADRZAJ_GK_UF');
                -----------------------------
                
                
                :P1805_NALOG_ID:=v_id_naloga_gk;
                
                
                
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Fakture uspješno proknjižene.
        }
        advanced {
            executionMappingIdentifier: 280461102429043125
        }
        serverSideCondition {
            whenButtonPressed: @proknjizi
        }
    )

    process save-stavke (
        name: Save stavke
        type: executeCode
        editableRegion: @stavke-konta-grid
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                v_otvorena_stavka varchar2(1);
                v_mt_naziv varchar2(500);
                v_konto_naziv varchar2(500);
                
                BEGIN
                
                
                
                        IF :APEX$ROW_STATUS = 'D' THEN
                
                
                
                            APEX_COLLECTION.DELETE_MEMBER(
                            p_collection_name => 'SADRZAJ_GK_UF',
                            p_seq             => :SEQ_ID 
                            );
                
                
                            
                
                
                        ELSIF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN
                
                        NULL;
                
                        ELSIF :APEX$ROW_STATUS = 'U' THEN
                
                
                            for r in (SELECT    c001  AS opis_transakcije,
                                                c002  AS partner,
                                                c003  AS mjesto_tr,
                                                c004  AS pdv_indikator,
                                                c005  AS strana_knjizenja,
                                                c006  AS konto,
                                                c007  AS valuta,
                                                c008  AS otvorena_stavka,
                                                c009  AS dokument,
                                                c010  AS opis_dokumenta,
                                                n001  AS iznos,
                                                n002  AS rbr,
                                                n003  AS id_dok,
                                                d001  AS datum_dokumenta
                                            FROM apex_collections
                                            WHERE collection_name = 'SADRZAJ_GK_UF'
                                            AND SEQ_ID=:SEQ_ID)
                
                            loop
                
                
                                IF :KONTO is not null then 
                
                                        select nvl(acc.otvorene_stavke,'N'), acc.naziv
                                        into v_otvorena_stavka, v_konto_naziv
                                        from sif.acc_kontni_okvir_klase acc 
                                        where acc.id=:KONTO;
                
                                end if;
                                
                                IF :MJESTO_TR is not null then 
                
                                       select mt.naziv 
                                       into v_mt_naziv
                                       from sif.vw_mjesta_troska mt 
                                       where mt.id=:MJESTO_TR;
                
                                end if;
                
                
                
                                if to_number(:IZNOS,'999G999G999G999G990D00')=0 then 
                                        apex_error.add_error(
                                        p_message          => 'Vrijednost u polju iznos mora biti različita od nule!',
                                        p_display_location => apex_error.c_inline_in_notification);
                
                                end if;
                
                               
                
                               APEX_COLLECTION.UPDATE_MEMBER(
                                      p_collection_name => 'SADRZAJ_GK_UF',
                                      p_seq  => :SEQ_ID,
                                      p_c001 => :OPIS_TRANSAKCIJE,
                                      p_c002 => :PARTNER,
                                      p_c003 => :MJESTO_TR,
                                      p_c004 => :PDV_INDIKATOR,
                                      p_c005 => :STRANA_KNJIZENJA,
                                      p_c006 => :KONTO,
                                      p_c007 => :VALUTA,
                                      p_c008 => v_otvorena_stavka,
                                      p_c009 => r.dokument,
                                      p_c010 => r.opis_dokumenta,
                                      p_c012 => v_mt_naziv,
                                      p_c013 => v_konto_naziv,
                                      p_n001 => to_number(:IZNOS,'999G999G999G999G990D00'),
                                      p_n002 => r.rbr,
                                      p_n003 => r.id_dok,
                                      p_d001 => r.datum_dokumenta
                                    ); 
                
                                end loop;       
                
                        END IF;
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Izmjene sačuvane
        }
        advanced {
            executionMappingIdentifier: 280455548682043071
        }
        serverSideCondition {
            whenButtonPressed: @snimi-stavke
            executionScope: allSubmittedRows
        }
    )

    branch (
        name: Go to pregled naloga
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1851
                items: {
                    P1851_NALOG_ID: &P1805_NALOG_ID.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @proknjizi
        }
    )

)

