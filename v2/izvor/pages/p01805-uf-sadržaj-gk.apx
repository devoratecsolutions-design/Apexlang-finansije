    region stavke-konta-grid (
        name: Stavke konta Grid
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    seq_id,
                    c001  AS opis_transakcije,
                    c002  AS partner,
                    c003  AS mjesto_tr,
                    c004  AS pdv_indikator,
                    c005  AS strana_knjizenja,
                    c006  AS konto,
                    c007  AS valuta,
                    c008  AS v_otvorena_stavka,
                    c009  AS dokument,
                    c010  AS opis_dokumenta,
                    c011  as komentar,
                    c012  as mt_naziv,
                    c013  as konto_naziv,
                    n001  AS iznos,
                    n002  AS rbr,
                    n003  AS id_dok,
                    d001  AS datum_dokumenta
                FROM apex_collections
                WHERE collection_name = 'SADRZAJ_GK_UF'
                
                
                ```
        }
        layout {
            sequence: 20
            parentRegion: @nalog
            slot: subRegions
        }
        appearance {
