    dynamicAction change-proknizeno (
        name: Change proknizeno
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P1851_PROKNJIZENO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: P1851_PROKNJIZENO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @nalog
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('Glavna Knjiga row(s) updated.');
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @nalog
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction print (
        name: Print
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: button
            button: @print
        }
        config {
            buildOption: @feature-printing
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    generate_report(
                        filename = 'nalog.pdf',
                        report_path = '/reports/ACCOUNTING/glavna_knjiga/nalog_knjizenje', 
                        report_parameters = {
                            ID: $v("P1851_ID")
                        },
                        new_tab = false
                    );
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            config {
                buildOption: @feature-printing
            }
        )

    )

    dynamicAction refresh-after-deialog-close (
        name: Refresh   after deialog close
        execution {
            sequence: 130
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @stavke-konta-knjizeno
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stavke-konta-knjizeno
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction submit-page (
        name: Submit Page
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P1851_NALOG_ID
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: CHANGE_NALOG
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction toggle (
        name: Toggle
        execution {
            sequence: 110
        }
        when {
            selectionType: items
            items: P1851_TOTAL
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P1851_TOTAL
        }
        config {
            buildOption: @commented-out
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P1851_TOTAL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
            clientSideCondition {
                type: itemIsNull
                item: P1851_TOTAL
            }
            config {
                buildOption: @commented-out
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P1851_TOTAL
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P1851_TOTAL
            }
            config {
                buildOption: @commented-out
            }
        )

    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select g.sifra||'-'||g.naziv as nalog, g.datum_naloga, g.broj, to_char(g.duguje,'999G999G999G999G990D00'), to_char(g.potrazuje,'999G999G999G999G990D00'),g.nalog_kreirao, g.stornirano, g.opis
                into   :P1851_VRSTA_NALOGA, :P1851_DATUM_NALOGA, :P1851_BROJ, :P1851_DUGUJE, :P1851_POTRAZUJE, :P1851_KREIRAO, :P1851_NALOG_STORNIRAN, :P1851_OPIS
                from accounting.vw_nalozi_gk  g
                where g.nalog_id=:P1851_NALOG_ID;
                
                select distinct sn.modul_id
                into :P1851_MODUL
                from vw_nalozi_gk_stavke sn 
                where sn.nalog_id=:P1851_NALOG_ID;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 274470628831735405
        }
    )

)

