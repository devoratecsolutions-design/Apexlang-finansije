        }
        behavior {
            action: redirectThisApp
            target: {
                page: 202
                items: {
                    P202_ID: &P1851_ID.
                }
                clearCache: 202
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
