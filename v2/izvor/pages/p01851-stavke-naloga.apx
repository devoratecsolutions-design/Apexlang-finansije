    region referentni-dokumenti (
        name: Referentni dokumenti
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rd.*
                from vw_gk_referentni_dokumenti rd
                join (select distinct sn.modul_id, sn.ref_dokument_id 
                     from vw_nalozi_gk_stavke sn 
                     where sn.nalog_id=:P1851_NALOG_ID) st on rd.dokument_id=st.ref_dokument_id and rd.modul_id=st.modul_id;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @nalog
            slot: subRegions
            columnSpan: 6
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

