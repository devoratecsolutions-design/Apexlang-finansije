page 89 (
    name: Automatski unos KUF / Detalji
    alias: AUTOMATSKI-UNOS-KUF-DETALJI
    title: Automatski unos KUF / Detalji
    pageGroup: @uio-dokumentacija
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--xl
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region učitani-kuf-fajl-pregled (
        name: Učitani KUF fajl (pregled)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    c001 as vrsta_sloga,
                    c002 as redni_br,
                    c003 as poreski_period,
                    c004 as tip_dokumenta,
                    c005 as broj_fakture,
                    -- to_date(c006, :P89_KUF_DATE_FORMAT) as datum_fakture,
                    -- to_date(c007, :P89_KUF_DATE_FORMAT) as datum_prijema_fakture,
                    c006 as datum_fakture,
                    c007 as datum_prijema_fakture,
                    c008 as naziv_dobavljaca,
                    c009 as sjediste_dobavljaca,
                    c010 as pdv_broj_dobavljaca,
                    c011 as jib_broj_dobavljaca,
                    c012 as iznos_fakture_bezpdv,
                    c013 as iznos_fakture_sapdv,
                    c014 as iznos_pausal,
                    c015 as iznos_ulaznog_pdv,
                    c016 as iznos_ulazpdv_odbiti,
                    c017 as iznos_ulazpdv_neodbiti,
                    c018 as iznos_pdv_32polje,
                    c019 as iznos_pdv_33polje,
                    c020 as iznos_pdv_34polje
                FROM
                    apex_collections
                WHERE
                    collection_name = 'LOAD_KUF'
                
                
                    
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }

        column BROJ_FAKTURE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Broj fakture
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column DATUM_FAKTURE (
