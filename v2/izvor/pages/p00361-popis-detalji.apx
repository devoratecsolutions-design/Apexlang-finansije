page 361 (
    name: Popis / Detalji
    alias: POPIS-DETALJI
    title: Popis / Detalji
    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region popis-detalji (
        name: Popis / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P361_BROJ (
        type: hidden
        layout {
            sequence: 20
            region: @popis-detalji
            slot: regionBody
        }
    )

    pageItem P361_DATUM (
        type: datePicker
        label {
            label: Datum
            alignment: left
        }
        settings {
            showTime: true
        }
        layout {
            sequence: 40
            region: @popis-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY HH24:MI
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P361_ID (
        type: hidden
        layout {
            sequence: 10
            region: @popis-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P361_NAZIV (
        type: displayOnly
        label {
            label: Naziv
            alignment: left
        }
        layout {
            sequence: 30
            region: @popis-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P361_OPIS (
        type: textarea
        label {
            label: Opis
            alignment: left
        }
        settings {
            autoHeight: true
            charCounter: true
        }
        layout {
            sequence: 50
            region: @popis-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 255
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P361_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 191455847412397003
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                skladista_pkg.insert_popis (
                    p_ooj_id       => :APP_OOJ_ID,
                    p_skladiste_id => :A_SKLADISTE_ID,
                    p_godina       => :APP_GODINA,
                    p_naziv        => :P361_NAZIV,
                    p_broj         => :P361_BROJ,
                    p_datum        => to_date(:P361_DATUM, 'DD.MM.YYYY HH24:MI'),
                    p_opis         => :P361_OPIS
                );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 191474383490484207
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process setup-new (
        name: Setup NEW
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.protokoli_pkg.get_brojac (
                    p_ooj_id             => :APP_OOJ_ID,
                    p_godina             => :APP_GODINA,
                    p_vrsta_naloga_sifra => 'pop',
                    p_broj               => :P361_BROJ,
                    p_naziv              => :P361_NAZIV
                );
                
                :P361_DATUM := to_char(current_date, 'DD.MM.YYYY HH24:MI');
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 191474077108484204
        }
        serverSideCondition {
            type: itemIsNull
            item: P361_ID
        }
    )

)

