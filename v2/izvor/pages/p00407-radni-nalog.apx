    region radna-snaga (
        name: Radna snaga
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    obrazovanje_id,
                    radnik_id,
                    broj_sati,
                    iznos
                FROM
                    radni_nalog_radna_snaga
                WHERE 
                    radni_nalog_id = :P407_ID
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
