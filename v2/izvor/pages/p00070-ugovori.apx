            }
            sorting {
                sortable: false
            }
        )

        column PREDMET (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Predmet
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column STATUS (
            reportColumnQueryId: 19
            derivedColumn: N
            type: hidden
            layout {
                sequence: 250
            }
        )

        column STATUS_NAZIV (
            reportColumnQueryId: 20
