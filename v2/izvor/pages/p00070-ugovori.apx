page 70 (
    name: Ugovori
    alias: UGOVORI
    title: Ugovori
    pageGroup: @ugovori
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @finansije-ugovori
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Stranica <b><em>"Ugovori"</em></b> namijenjena je korisnicima radi jednostavnijeg i preglednijeg 
            evidentiranja ugovora u sistemu. Kada se kreira ugovor, naredni korak je izrada izlazne fakture, 
            čime se proces administrativno i finansijski zaokružuje. </br>
            </br>
            Iznad liste dostupni su pretraga i filteri. </br>
            Ove opcije omogućavaju brzo pronalaženje željenih ugovora i efikasno 
            upravljanje postojećim evidencijama.</br>
            </br>
            Kreiranje ugovora započinje klikom na dugme <b><em>"Novi unos"</em></b>, nakon čega se otvara modalni 
            dijalog u kojem je potrebno unijeti osnovne podatke. 
            Ugovor se može povezati s postojećim ugovorom kao referencom. 
            Takođe, postoji mogućnost dodavanja dokumentacije koja je vezana za ugovor. 
            ```
    }

    region facet-search (
        name: Facet Search
        type: smartFilters
        source {
            filteredRegion: @ugovori
        }
        layout {
            sequence: 9
            parentRegion: @wrapper
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P70_INTERVAL_ID (
            type: checkboxGroup
            label {
                label: Interval fakturisanja
            }
            lov {
                type: sharedComponent
                lov: @sif-intervali
            }
            layout {
                sequence: 40
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: INTERVAL_ID
            }
        )

        filter P70_KLIJENT_ID (
            type: checkboxGroup
            label {
                label: Klijent
            }
            lov {
                type: sharedComponent
                lov: @sec-klijenti
            }
            layout {
                sequence: 20
            }
            listEntries {
                clientSideFiltering: true
            }
            source {
                databaseColumn: KLIJENT_ID
            }
        )

        filter P70_OJ_ID (
            type: checkboxGroup
            label {
                label: Organizaciona jedinica
            }
            lov {
                type: sharedComponent
                lov: @oj
            }
            layout {
                sequence: 30
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: OJ_ID
            }
        )

        filter P70_SEARCH (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

        filter P70_STATUS_NAZIV (
            type: checkboxGroup
            label {
                label: Status
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 60
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: STATUS_NAZIV
            }
        )

        filter P70_VRSTA_UGOVORA_ID (
            type: checkboxGroup
            label {
                label: Vrsta ugovora
            }
            lov {
                type: sharedComponent
                lov: @vrste-ugovora
            }
            layout {
                sequence: 50
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: VRSTA_UGOVORA_ID
            }
        )

    )

    region potrebna-konfiguracija (
        name: Potrebna konfiguracija
        type: staticContent
        source {
            htmlCode: Neophodno je da konfigurišete formu numeracije dokumenata.
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: return not core.protokoli_pkg.check_brojac(:APP_OOJ_ID, 'ug', :APP_GODINA);
        }
    )

    region ugovori (
        name: Ugovori
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    naziv,
                    predmet,
                    klijent_naziv,
                    oj_naziv,
                    izvrsilac_narucioc,
                    ugovor_start,
                    ugovor_end,
                    iznos,
                    valuta_sifra,
                    broj,
                    interval_id,
                    interval_naziv,
                    interval_broj_mjeseci,
                    klijent_id,
                    oj_id,
                    vrsta_ugovora_id,
                    vrsta_ugovora_naziv,
                    status,
                    status_naziv,
                
                    CASE
                        WHEN status = 'P' THEN
                            'u-color-15'
                        WHEN status = 'R' OR ugovor_end < trunc(sysdate) THEN
                            'u-color-9'
                        WHEN trunc(sysdate) BETWEEN (ugovor_end - 15) AND ugovor_end THEN
                            'u-color-6'
                        ELSE
                            'u-color-5'
                    END AS color_class,
                
                    CASE
                        WHEN EXISTS (SELECT 1 FROM kif WHERE kif.ugovor_id = u.id) THEN
                            apex_page.get_url (
                                p_page   => 74,
                                p_items  => 'P74_UGOVOR_ID',
                                p_values => id
                            )
                        ELSE
                            null
                    END AS fakture_link,
                
                    CASE
                        WHEN EXISTS (SELECT 1 FROM ugovor_dokumenta d WHERE d.ugovor_id = u.id) THEN
                            apex_page.get_url (
                                p_page   => 72,
                                p_items  => 'P72_UGOVOR_ID',
                                p_values => id
                            )
                        ELSE
                            null
                    END AS dokumentacija_link,
                
                    -- Link za novi aneks; aneks se uvijek veže za osnovni ugovor.
                    CASE
                        WHEN status = 'Z' THEN
                            apex_page.get_url (
                                p_page        => 71,
                                p_clear_cache => '71',
                                p_items       => 'P71_REFERENCA_ID',
                                p_values      => coalesce(referenca_id, id)
                            )
                        ELSE
                            null
                    END AS aneks_link
                
                FROM
                    vw_ugovori u
                WHERE
                    ooj_id = :APP_OOJ_ID
                ORDER BY
                    broj DESC
                
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: broj DESC
        }
        layout {
            sequence: 10
            parentRegion: @wrapper
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column ANEKS_LINK (
            reportColumnQueryId: 24
            derivedColumn: N
            heading {
                heading: Aneks
            }
            layout {
                sequence: 270
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if ANEKS_LINK/}
                    <a href="#ANEKS_LINK#">
                        <span class="t-Button t-Button--noLabel #COLOR_CLASS# t-Button--iconLeft t-Button--small">
                            <span class="t-Icon t-Icon--left fa fa-copy"></span>
                        </span>
                    </a>
                    {endif/}
                    
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column BROJ (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 150
            }
        )

        column COLOR_CLASS (
            reportColumnQueryId: 21
            derivedColumn: N
            type: hidden
            layout {
                sequence: 160
            }
        )

        column DOKUMENTACIJA_LINK (
            reportColumnQueryId: 23
            derivedColumn: N
            heading {
                heading: Dokumentacija
            }
            layout {
                sequence: 220
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if DOKUMENTACIJA_LINK/}
                    <a href="#DOKUMENTACIJA_LINK#">
                        <span class="t-Button t-Button--noLabel #COLOR_CLASS# t-Button--iconLeft t-Button--small">     
                            <span class="t-Icon t-Icon--left fa fa-files-o"></span> 
                        </span>
                    </a>
                    {endif/}
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column FAKTURE_LINK (
            reportColumnQueryId: 22
            derivedColumn: N
            heading {
                heading: "Fakture "
            }
            layout {
                sequence: 210
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if FAKTURE_LINK/}
                    <a href="#FAKTURE_LINK#">
                        <span class="t-Button t-Button--noLabel #COLOR_CLASS# t-Button--iconLeft t-Button--small">     
                            <span class="t-Icon t-Icon--left fa fa-arrow-right-alt"></span> 
                        </span>
                    </a>
                    {endif/}
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            layout {
                sequence: 280
            }
            link {
                target: {
                    page: 71
                    items: {
                        P71_ID: #ID#
                    }
                    clearCache: 71
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column INTERVAL_BROJ_MJESECI (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 190
            }
        )

        column INTERVAL_ID (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 200
            }
        )

        column INTERVAL_NAZIV (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Interval fakturisanja
            }
            layout {
                sequence: 90
            }
