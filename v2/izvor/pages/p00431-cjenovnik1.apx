page 431 (
    name: Cjenovnik
    alias: CJENOVNIK1
    title: Cjenovnik
    pageGroup: @proizvodnja
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @proizvodnja-cjenovnik
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cjenovnik (
        name: Cjenovnik
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region obrazovanje (
        name: Obrazovanje
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region obrazovanje-report (
        name: Obrazovanje Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    oj_naziv,
                    obrazovanje_naziv,
                    cijena_sata,
                
                    oj_id,
                    obrazovanje_id
                
                FROM
                    hrm.vw_obrazovanje_cjenovnik
                WHERE
                    ooj_id = :APP_OOJ_ID
                ORDER BY
                    oj_naziv
                ```
        }
        layout {
            sequence: 20
            parentRegion: @obrazovanje
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column CIJENA_SATA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Cijena sata
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 432
                    items: {
                        P432_ID: #ID#
                    }
                    clearCache: 432
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column OBRAZOVANJE_ID (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 60
            }
        )

        column OBRAZOVANJE_NAZIV (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Obrazovanje
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column OJ_ID (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column OJ_NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Organizaciona jedinica
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

    )

    region obrazovanje-search (
        name: Obrazovanje Search
        type: smartFilters
        source {
            filteredRegion: @obrazovanje-report
        }
        layout {
            sequence: 10
            parentRegion: @obrazovanje
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P431_OBRAZOVANJE_ID (
            type: checkboxGroup
            label {
                label: Obrazovanje
            }
            lov {
                type: sharedComponent
                lov: @hr-obrazovanje
            }
            layout {
                sequence: 30
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: OBRAZOVANJE_ID
            }
        )

        filter P431_OJ_ID (
            type: checkboxGroup
            label {
                label: Organizaciona jedinica
            }
            lov {
                type: sharedComponent
                lov: @oj
            }
            layout {
                sequence: 20
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: OJ_ID
            }
        )

        filter P431_SEARCH (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

    )

    region radnik (
        name: Radnik
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region radnik-report (
        name: Radnik Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    ime || ' ' || prezime AS radnik_naziv,
                    oj_naziv,
                    tip_ugovora_naziv,
                    cijena_sata,
                
                    oj_id,
                    tip_ugovora_id
                FROM
                    hrm.vw_radnici
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND zaposlen_do IS null
                ORDER BY
                    oj_id,
                    tip_ugovora_id
                ```
        }
        layout {
            sequence: 20
            parentRegion: @radnik
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: fin-list
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column CIJENA_SATA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Cijena sata
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 433
                    items: {
                        P433_RADNIK_ID: #ID#
                    }
                    clearCache: 433
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column OJ_ID (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 60
            }
        )

        column OJ_NAZIV (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Organizaciona jedinica
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column RADNIK_NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Radnik
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column TIP_UGOVORA_ID (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 70
            }
        )

        column TIP_UGOVORA_NAZIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Tip ugovora
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

    region radnik-search (
        name: Radnik Search
        type: smartFilters
        source {
            filteredRegion: @radnik-report
        }
        layout {
            sequence: 10
            parentRegion: @radnik
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P431_OJ_ID_2 (
            type: checkboxGroup
            label {
                label: Organizaciona jedinica
            }
            lov {
                type: sharedComponent
                lov: @oj
            }
            layout {
                sequence: 20
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: OJ_ID
            }
        )

        filter P431_SEARCH_2 (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

        filter P431_TIP_UGOVORA_ID (
            type: checkboxGroup
            label {
                label: Tip ugovora
            }
            lov {
                type: sharedComponent
                lov: @sif-tipovi-ugovora
            }
            layout {
                sequence: 30
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: TIP_UGOVORA_ID
            }
        )

    )

    region rds (
        name: RDS
        type: regionDisplaySelector
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            includeShowAll: false
        }
    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 10
            region: @cjenovnik
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 432
                clearCache: 432
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @radnik-report
        }

        action native-refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @radnik-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @obrazovanje-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-2 (
        name: Dialog Closed - Refresh 2
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @obrazovanje-report
        }

        action native-refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @obrazovanje-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

