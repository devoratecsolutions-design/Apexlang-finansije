page 109 (
    name: Kontni okvir
    alias: KONTNI-OKVIR
    title: Kontni okvir
    pageGroup: @konfiguracija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function treeSearchHighlight(pStaticId, pSearchString, pClassName) {
                var tree$ = apex.region(pStaticId).widget();
            
                apex.jQuery("." + apex.util.escapeCSS(pClassName), "#" + apex.util.escapeCSS(pStaticId))
                    .removeClass(pClassName);
            
                // uvijek prvo zatvori sve grane - bez obzira da li ima novih rezultata
                tree$.treeView("collapseAll");
            
                if (!pSearchString) {
                    return;
                }
            
                var lTerm = pSearchString.toLowerCase();
                var lMatches$ = tree$.treeView("find", {
                    depth: -1,
                    findAll: true,
                    match: function(n) {
                        return n.label.toLowerCase().indexOf(lTerm) >= 0;
                    }
                });
            
                if (lMatches$.length === 0) {
                    return;
                }
            
                lMatches$.find(".a-TreeView-label").addClass(pClassName);
            
                var lAncestorNodes$ = lMatches$.parents(".a-TreeView-node");
                var lAncestors$ = lAncestorNodes$.children(".a-TreeView-content");
            
                if (lAncestors$.length > 0) {
                    tree$.treeView("expand", lAncestors$);
                }
            }
            ```
    }
    css {
        inline:
            ```css
            .tree-search-highlight {
                background-color: #1b3a5c;
                color: #ffffff;
                border-radius: 3px;
                padding: 0 2px;
            }
            ```
    }
    security {
        authorizationScheme: @finansije-konfiguracija
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <b><em>Kontni okviri</em></b> služi za uspostavljanje i održavanje strukture kontnog plana koju koristi organizacija. 
            Sistem podržava standardnu hijerarhiju klasa → grupa → konto → analitika, 
            a svaki novi konto može se precizno definisati kroz sljedeća polja: </br>
            <ul>
                <li>Nadređena klasa (konto-klasa): postavlja lokaciju konta u hijerarhiji i osigurava usklađenost s propisanim klasama (0–9). </li>
                <li>Šifra i naziv: jedinstvena oznaka i opis konta. </li>
                <li>Osnovno sredstvo (obavezno/da-ne): označava da li se konto koristi za evidentiranje dugoročne imovine (npr. nekretnine, oprema), što utiče na obračun amortizacije i izvještavanje.</li>
                <li>Klijent obavezan / Organizacijska jedinica / Radnik: poslovna pravila koja kontrolišu da li je pri knjiženju obavezno povezati konto s kupcem/dobavljačem, osnovnom organizacionom jedinicom ili zaposlenim — važno za precizno segmentno i odgovorno izvještavanje.</li>
                <li>PDV indikator: određuje tretman prometa prema PDV pravilima (npr. ulazni odbitak, obračun izlaznog PDV-a, oslobođenja), čime se automatizuje knjiženje i umanjuje rizik od greške u obračunu. </li>
            </ul>
            
            Na dugme <b><em>Novi Unos</em></b> kreiraj konto definisanjem nadređene klase, šifre, 
            naziva i odgovarajućih “obavezno”/“nije obavezno” pravila (osnovno sredstvo, klijent, OOJ, radnik, PDV). </br>
            </br>
            Postoji i opcija na aplikaciji <b><em> Export / Import</em></b>:
            da klijenti dostave fajl sistem administratoru. 
            Administrator je zadužen da izvrši konfiguraciju dostavljenog fajla, 
            a nakon što potvrdi da je konfiguracija uspješno završena, korisniku 
            preostaje da koristi aplikaciju na jednostavan način kroz opcije Export i Import.  
            
            ```
    }

    region kontni-okvir (
        name: Kontni okvir
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region kontni-okvir-tree (
        name: Kontni okvir Tree
        title: Kontni okvir
        type: tree
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    id,
                    nadredjena_id,
                    --rpad(code, nvl(:APP_KONTO_DUZINA, 6), '0') || ' - ' || naziv as label
                    CASE
                        WHEN LENGTH(code) IN (1, 2, 3) THEN code
                        ELSE RPAD(code, NVL(:APP_KONTO_DUZINA, 6), '0')
                    END || ' - ' || naziv AS label
                FROM
                    sif.vw_kontni_okvir_klase
                WHERE
                    ((ooj_id IS null and LENGTH(code) IN (1, 2, 3)) OR ooj_id = :APP_OOJ_ID)
                AND  EXISTS (
                           select 1
                           from   sif.acc_kontni_okvir_klase e
                           where  e.ooj_id = :APP_OOJ_ID
                       )
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-tree
        }
        advanced {
            htmlDomId: KONTNI_OKVIR_ID
            regionDisplaySelector: true
        }
        settings {
            nodeLabelColumn: LABEL
            nodeIdColumn: ID
            parentKeyColumn: NADREDJENA_ID
            orderSiblingsBy: LABEL
            activateNodeLinkWith: doubleClick
            link: {
                page: 110
                items: {
                    P110_ID: &ID.
                }
            }
            defaultIconCssClass: fa-list
            iconTypeCssClass: fa
        }
    )

