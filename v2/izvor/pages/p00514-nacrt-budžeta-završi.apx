page 514 (
    name: Nacrt budžeta / Završi
    alias: NACRT-BUDŽETA-ZAVRŠI
    title: Nacrt budžeta / Završi
    pageGroup: @budžet
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P514_BUDZET_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P514_KOMENTAR (
        type: textarea
        label {
            label: Komentar
            alignment: left
        }
        settings {
            autoHeight: true
            charCounter: true
        }
        layout {
            sequence: 30
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 1000
        }
    )

    pageItem P514_OJ_ID (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button finish (
        buttonName: FINISH
        label: Završi prijedlog budžeta
        layout {
            sequence: 20
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-send-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process send-nacrt (
        name: Send nacrt
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                budzet_pkg.insert_budzet_oj_hist (
                    p_budzet_id => :P514_BUDZET_ID,
                    p_oj_id     => :P514_OJ_ID,
                    p_status_id => sif.budzet_pkg.get_status_with_sifra('20'),
                    p_radnik_id => :APP_RADNIK_ID,
                    p_komentar  => :P514_KOMENTAR,
                    p_datum     => sysdate
                );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 145404248194423409
        }
        serverSideCondition {
            whenButtonPressed: @finish
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 509
            }
        }
        serverSideCondition {
            whenButtonPressed: @finish
        }
    )

)

