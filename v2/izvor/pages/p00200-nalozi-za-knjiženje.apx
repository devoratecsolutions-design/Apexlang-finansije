page 200 (
    name: Nalozi za knjiženje
    alias: NALOZI-ZA-KNJIŽENJE
    title: Nalozi za knjiženje
    pageGroup: @glavna-knjiga
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#jasper-server#MIN#.js
    }
    security {
        authorizationScheme: @glavna-knjiga-nalozi
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    help {
        helpText:
            ```html
            Iznad liste nalaze se pretraga i filteri pomoću kojih je moguće filtrirati kreirane naloge. 
            Unos novog naloga za knjiženje vrši se klikom na dugme <b><em>"Novi unos"</em></b> gdje se otvara stranica 
            <b><em>"Glavna knjiga / Nalog"</em></b>. </br>
            </br>
            Na osnovu poslovne promjene koja se knjiži, potrebno je odrediti vrstu naloga. </br>
            Ručni nalozi glavne knjige imaju vrstu naloga GK. 
            Datum dokumenta je informativnog karaktera i predstavlja datum iskazan na dokumentu koji se unosi. </br>
            Datum knjiženja je datum pod kojim se nalog knjiži i koji je osnov za izvještavanje. </br>
            Polje <b><em>"Opis"</em></b> služi za unos broja ili opisa dokumenta.</br>
            </br>
            Nakon unosa podataka zaglavlja naloga, klikom na dugme <b><em>"Kreiraj"</em></b> formira se nalog. 
            Za formirani nalog potrebno je unijeti stavke naloga. </br>
            U stavkama naloga unose se konta, iznosi i ključevi knjiženja (dugovna ili potržna strana konta).  </br>
            U koliko konto ima subanalitiku (konta kupaca i dobaljača), neophodan je unos polja klijent. </br>
            </br>
            Za konta osnovnih sredstava potrebno je unijeti subanalitiku broj osnovnog sredstva. </br>
            Polja PDV indikator obavezna su za svaki konto. </br>
            Polje <b><em>"Organizaciona jedinica"</em></b> obavezna je kod unosa konta prihoda i rashoda, dok se polje 
            <b><em>"Radnik"</em></b> unosi za konta potraživanja i obaveza od zaposlenih. </br>
            Sistem kontroliše da zbir stavki naloga bude jednak nuli, jer bez toga nalog ne može biti proknjižen. </br>
            
            ```
    }

    region master-records (
        name: Master Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    gk.id,
                    CASE
                        WHEN lower(gk.vrsta_naloga_sifra) = 'iz' THEN
                            apex_page.get_url (
                                p_page   => 220,
                                p_items  => 'P220_ID',
                                p_values => gk.id
                            )
                        ELSE
                            apex_page.get_url (
                                p_page   => 201,
                                p_items  => 'P201_ID,P201_VRSTA_NALOGA_ID',
                                p_values => '' || gk.id || ',' || gk.vrsta_naloga_id || ''
                            )
                    END AS url,
                
                    lpad(gk.broj, 6, '0') as broj,
                    gk.vrsta_naloga_naziv,
                    gk.datum_knjizenja,
                    gk.stavke_count,
                    gk.d_sum,
                    gk.p_sum,
                    gk.stavke_sum,
                    gk.opis,
                    
                    to_char(trunc(gk.datum_knjizenja, 'MM'), 'YYMM') AS pp,
                    gk.vrsta_naloga_id,
                    gk.proknjizeno,
                    gk.created_by,
                
                    CASE
                        WHEN lower(gk.vrsta_naloga_sifra) = 'iz' THEN
                            null
                        ELSE
                            apex_page.get_url (
                                p_page   => 202,
                                p_items  => 'P202_COPY_ID,P205_VRSTA_NALOGA_ID',
                                p_values => '' || gk.id || ',' || gk.vrsta_naloga_id || '',
                                p_clear_cache => 202
                            )
                    END AS copy_link,
                
                    kif.klijent_naziv
                    
                FROM 
                    vw_glavna_knjiga gk
                    left join vw_kif kif on kif.glavna_knjiga_id = gk.id
                WHERE 
                    gk.ooj_id = :APP_OOJ_ID
                    AND gk.godina = :APP_GODINA
                    AND ( CASE
                        WHEN lower(gk.vrsta_naloga_sifra) = 'iz' AND gk.proknjizeno = 'Y' THEN
                            1
                        WHEN lower(gk.vrsta_naloga_sifra) != 'iz' THEN
                            1
                        ELSE
                            0
                    END) = 1
                ORDER BY
                    to_number(gk.broj) DESC,
                    gk.datum_knjizenja DESC
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: [
                search-results
                fin-list
            ]
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlightOff
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">Nema pronađenih podataka.</div>
        }

        column BROJ (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column COPY_LINK (
            reportColumnQueryId: 15
            derivedColumn: N
            heading {
                heading: Kopiraj
            }
            layout {
                sequence: 150
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if ?COPY_LINK/}
                        <a href="#COPY_LINK#">
                            <span class="t-Button t-Button--noLabel  t-Button--icon t-Button--simple t-Button--small">
                                <span class="t-Icon t-Icon--left fa fa-copy"></span>
                            </span>
                        </a>
                    {endif/}
                    ```
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 48
            }
        )

        column CREATED_BY (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Kreirao nalog
            }
            layout {
                sequence: 110
            }
            sorting {
                sortable: false
            }
        )

        column DATUM_KNJIZENJA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Datum knjiženja
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column DERIVED$01 (
            reportColumnQueryId: 16
            derivedColumn: Y
            heading {
                heading: Štampa
            }
            layout {
                sequence: 160
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="t-Button t-Button--noLabel t-Button--simple t-Button--iconLeft t-Button--small nalog-print" data-id=#ID#>
                        <span class="t-Icon t-Icon--left fa fa-print"></span>
                    </span>
                    ```
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 48
            }
        )

        column D_SUM (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Dugovna strana
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column KLIJENT_NAZIV (
            reportColumnQueryId: 16
            derivedColumn: N
            heading {
                heading: Klijent
            }
            layout {
                sequence: 120
            }
            sorting {
                sortable: false
            }
        )

        column OPIS (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Opis
            }
            layout {
                sequence: 100
            }
            sorting {
                sortable: false
            }
        )

        column PP (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 180
            }
        )

        column PROKNJIZENO (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Proknjiženo
            }
            layout {
                sequence: 140
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if PROKNJIZENO/}
                    <span class="t-Button t-Button--noLabel u-color-5 t-Button--iconLeft t-Button--small">
                        <span class="t-Icon t-Icon--left fa fa-check-circle-o"></span>
                    </span>
                    {else/}
                    <span class="t-Button t-Button--noLabel u-color-9 t-Button--iconLeft t-Button--small">
                        <span class="t-Icon t-Icon--left fa fa-circle-o"></span>
                    </span>
                    {endif/}
                    ```
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 48
            }
        )

        column P_SUM (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Potražna strana
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column STAVKE_COUNT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Broj stavki
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column STAVKE_SUM (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Suma stavki
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column URL (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Pregled
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    type: url
                    url: #URL#
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column VRSTA_NALOGA_ID (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 170
            }
        )

        column VRSTA_NALOGA_NAZIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Nalog
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression: #VRSTA_NALOGA_NAZIV# / #BROJ#
            }
            sorting {
                sortable: false
            }
        )

    )

    region nalozi-za-knjiženje (
        name: Nalozi za knjiženje
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region search (
        name: Search
        type: smartFilters
        source {
            filteredRegion: @master-records
        }
        layout {
            sequence: 19
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P200_CREATED_BY (
            type: radioGroup
            label {
                label: Kreirao nalog
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT DISTINCT
                        created_by as d,
                        created_by as r
                    FROM
                        vw_glavna_knjiga
                    WHERE 
                        ooj_id = :APP_OOJ_ID
                        AND godina = :APP_GODINA
                        AND lower(vrsta_naloga_sifra) != 'iz'
                    ```
            }
            layout {
                sequence: 60
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: CREATED_BY
            }
        )

        filter P200_PP (
            type: radioGroup
            label {
                label: Poreski period
            }
            lov {
                type: sharedComponent
                lov: @poreski-period-yymm
            }
            layout {
                sequence: 30
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: PP
            }
        )

        filter P200_PROKNJIZENO (
            type: radioGroup
            label {
                label: Proknjiženo
            }
            lov {
                type: sharedComponent
                lov: @da-ne
            }
            layout {
                sequence: 40
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: PROKNJIZENO
            }
        )

        filter P200_SEARCH (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 20
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

        filter P200_VRSTA_NALOGA_ID (
            type: radioGroup
            label {
                label: Vrsta naloga
            }
            lov {
                type: sharedComponent
                lov: @sif-vrste-naloga
            }
            layout {
                sequence: 50
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: VRSTA_NALOGA_ID
            }
        )

    )

    pageItem P200_PRINT_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 20
            region: @nalozi-za-knjiženje
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 202
                clearCache: 202
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction change-proknizeno (
        name: Change proknizeno
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P200_PROKNJIZENO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: P200_PROKNJIZENO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @master-records
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @search
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction print (
        name: Print
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .nalog-print
        }
        config {
            buildOption: @feature-printing
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    generate_report(
                        filename = 'nalog.pdf',
                        report_path = '/reports/ACCOUNTING/glavna_knjiga/nalog_knjizenje', 
                        report_parameters = {
                            ID: $v("P200_PRINT_ID")
                        },
                        new_tab = false
                    );
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            config {
                buildOption: @feature-printing
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).data('id')
            }
            affectedElements {
                selectionType: items
                items: P200_PRINT_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

