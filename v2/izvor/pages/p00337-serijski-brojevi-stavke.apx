    region sb-raspolozivi (
        name: Raspoloživi serijski brojevi
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    x.serijski_broj,
                    to_char(x.datum_ulaza, 'DD.MM.YYYY') AS datum_ulaza
                FROM vw_rm_sb_stanje x
                JOIN operacija_stavke os ON os.id = :P337_STAVKA_DOK_ID
                JOIN operacije o ON o.id = os.operacija_id
                WHERE x.ooj_id = :APP_OOJ_ID
                  AND x.skladiste_id = o.skladiste_id
                  AND x.stavka_id = os.stavka_id
                  AND x.raspolozivo > 0
                  AND x.serijski_broj NOT IN (SELECT sb.serijski_broj FROM operacija_stavke_sb sb WHERE sb.operacija_stavka_id = os.id)
                ORDER BY x.serijski_broj
                ```
            pageItemsToSubmit: P337_STAVKA_DOK_ID
        }
        layout {
            sequence: 20
            parentRegion: @sb-izbor
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: fin-sb-raspolozivi
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Nema raspoloživih serijskih brojeva ovog artikla na skladištu.
        }
        advanced {
            htmlDomId: rm_sb_raspolozivi
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P337_TIP = 'I'
        }

        column SERIJSKI_BROJ (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Serijski broj
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-sb-red"><span><span class="fin-sb-red__broj">#SERIJSKI_BROJ#</span>{if DATUM_ULAZA/}<span class="fin-sub">primljen #DATUM_ULAZA#</span>{endif/}</span><a class="fin-act fin-sb-dodaj" href="javascript:void(0)" data-sb="#SERIJSKI_BROJ#" title="Dodaj" aria-label="Dodaj"><span class="fa fa-plus" aria-hidden="true"></span></a></span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column DATUM_ULAZA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 320
            }
        )

    )

    region sb-lista (
        name: Uneseni serijski brojevi
        title: Uneseni serijski brojevi
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    serijski_broj,
                    CASE WHEN :P337_IZMJENJIVA = 'Y' THEN 'Y' END AS brisanje
                FROM vw_rm_sb
                WHERE operacija_stavka_id = :P337_STAVKA_DOK_ID
                  AND ooj_id = :APP_OOJ_ID
                ORDER BY id DESC
                ```
            pageItemsToSubmit: [
                P337_STAVKA_DOK_ID
                P337_IZMJENJIVA
            ]
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
            cssClasses: fin-form fin-section
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Nema unesenih serijskih brojeva.
        }
        advanced {
            htmlDomId: rm_sb_lista
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 310
            }
        )

        column SERIJSKI_BROJ (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Serijski broj
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-sb-red"><span class="fin-sb-red__broj">#SERIJSKI_BROJ#</span>{if BRISANJE/}<a class="fin-act fin-act--danger fin-sb-brisi" href="javascript:void(0)" data-id="#ID#" title="Obriši" aria-label="Obriši"><span class="fa fa-trash-o" aria-hidden="true"></span></a>{endif/}</span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column BRISANJE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 330
            }
        )

    )

