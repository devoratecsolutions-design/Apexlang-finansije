    pageItem P337_NACIN (
        type: radioGroup
        label {
            label: Način unosa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT d, r FROM (
                    SELECT 'Barkod / ručno' AS d, 'B' AS r, 1 AS o FROM dual
                    UNION ALL SELECT 'Iz liste raspoloživih', 'L', 2 FROM dual WHERE :P337_TIP = 'I'
                    UNION ALL SELECT 'QR kod', 'Q', 3 FROM dual
                    UNION ALL SELECT 'Excel / CSV', 'F', 4 FROM dual
                )
                ORDER BY o
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        default {
            type: static
            staticValue: B
        }
        layout {
            sequence: 5
            region: @sb-detalji
            slot: regionBody
            columnSpan: 12
        }
        appearance {
