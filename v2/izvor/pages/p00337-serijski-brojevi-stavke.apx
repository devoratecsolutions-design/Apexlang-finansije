    button obrisi-sve (
        buttonName: OBRISI_SVE
        label: Obriši sve
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Obrisati sve serijske brojeve ove stavke?
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P337_IZMJENJIVA = 'Y'
        }
    )

    process ucitaj (
        name: Učitavanje stavke
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for s in (select s.sifra, s.naziv, s.kolicina, s.sb_uneseno, s.sb_ok, d.naziv as dok, s.operacija_id,
                                 -- zamjena šifara: brojevi zamjenskog artikla (artikal stavke se ne prati po SB) unose se kao na ulazu
                                 case when s.sb_zamjenskog = 'Y' then 'U' else d.tip_kretanja end as tip,
                                 s.sb_zamjenskog, s.zamjena_sifra, s.zamjena_naziv
                            from vw_rm_dokument_stavke s
                            join vw_rm_dokumenti d on d.id = s.operacija_id
                           where s.id = :P337_STAVKA_DOK_ID and s.ooj_id = :APP_OOJ_ID) loop
                    :P337_ARTIKAL  := case when s.sb_zamjenskog = 'Y'
                                           then s.zamjena_sifra || ' - ' || s.zamjena_naziv || ' (zamjenski artikal, novi serijski brojevi)'
                                           when s.zamjena_sifra is not null
                                           then s.sifra || ' - ' || s.naziv || ' → ' || s.zamjena_sifra || ' (isti brojevi prelaze na zamjenski artikal)'
                                           else s.sifra || ' - ' || s.naziv end;
                    :P337_KOLICINA := rtrim(to_char(s.kolicina, 'FM999G999G990D999'), '.,');
                    :P337_UNESENO  := s.sb_uneseno;
                    :P337_KLASA    := case when s.sb_ok = 'Y' then 'is-ok' else 'is-nok' end;
                    :P337_DOKUMENT := s.dok;
                    :P337_TIP      := s.tip;
                    :P337_IZMJENJIVA := rm_dokument_pkg.izmjenjiv(s.operacija_id);
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process ajax-dodaj-sb (
        name: DODAJ_SB
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sys.htp.p(rm_dokument_pkg.dodaj_sb_json(p_stavka_dok_id => :P337_STAVKA_DOK_ID, p_sb => apex_application.g_x01));
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
    )

    process ajax-obrisi-sb (
        name: OBRISI_SB
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    rm_dokument_pkg.obrisi_sb(p_id => to_number(apex_application.g_x01));
                    sys.htp.p(rm_dokument_pkg.sb_stanje_json(:P337_STAVKA_DOK_ID));
                exception
                    when others then
                        sys.htp.p('{"greska":"' || apex_escape.json(regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-RM: )?', '')) || '"}');
                end;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
    )

    process dodaj (
        name: Dodaj serijske brojeve iz QR koda
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P337_PORUKA := rm_dokument_pkg.dodaj_sb(p_stavka_dok_id => :P337_STAVKA_DOK_ID, p_tekst => :P337_UNOS);
                :P337_UNOS := null;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &P337_PORUKA.
        }
        serverSideCondition {
            whenButtonPressed: @dodaj
        }
    )

    process uvezi (
        name: Uvezi serijske brojeve iz fajla
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P337_PORUKA := rm_dokument_pkg.dodaj_sb_fajl(p_stavka_dok_id => :P337_STAVKA_DOK_ID, p_naziv_fajla => :P337_FAJL);
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: &P337_PORUKA.
        }
        serverSideCondition {
            whenButtonPressed: @uvezi
        }
    )

    process obrisi-sve (
        name: Obriši sve serijske brojeve
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                rm_dokument_pkg.obrisi_sve_sb(p_stavka_dok_id => :P337_STAVKA_DOK_ID);
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Serijski brojevi su obrisani.
        }
        serverSideCondition {
            whenButtonPressed: @obrisi-sve
        }
    )

    process close-dialog (
        name: Zatvori dijalog
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ZATVORI
        }
    )

    branch (
        name: Ostani na unosu
        execution {
            sequence: 50
        }
        behavior {
            target: {
                page: 337
                items: {
                    P337_STAVKA_DOK_ID: &P337_STAVKA_DOK_ID.
                }
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST <> 'ZATVORI'
        }
    )

)
