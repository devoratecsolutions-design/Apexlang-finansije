        type: staticContent
        layout {
            sequence: 10
            parentRegion: @sb-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
