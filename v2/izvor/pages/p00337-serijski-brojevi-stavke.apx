page 337 (
    name: Serijski brojevi stavke
    alias: SERIJSKI-BROJEVI-STAVKE
    title: Serijski brojevi
    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 760
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            finRmSb.init('P337', 'rm_sb_lista', 'rm_sb_raspolozivi');
            ```
    }
    security {
        authorizationScheme: @robno-materijalno-dokumenti
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region sb-traka (
        name: Artikal
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="fin-docbar">
                  <span class="fin-docbar__no">&P337_ARTIKAL.</span>
                  <span id="finSbOznaka" class="fin-sb &P337_KLASA."><span id="finSbN">&P337_UNESENO.</span> / <span id="finSbK">&P337_KOLICINA.</span></span>
                  <span class="fin-docbar__meta">&P337_DOKUMENT.</span>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region sb-detalji (
        name: Unos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P337_IZMJENJIVA = 'Y'
        }
    )

    region sb-barkod (
        name: Barkod čitač ili ručni unos
