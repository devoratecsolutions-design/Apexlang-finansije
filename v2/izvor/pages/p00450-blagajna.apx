page 450 (
    name: Blagajna
    alias: BLAGAJNA
    title: Blagajna
    pageGroup: @blagajna
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @blagajna-osnovni-pristup
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region blagajna (
        name: Blagajna
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region pokazatelji (
        name: Pokazatelji
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                RETURN dashboard_pkg.kpi_blagajna(:APP_OOJ_ID, :APP_GODINA);
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region blagajna-promet (
        name: Prijem i plaćanja po mjesecima (KM blagajne)
        type: chart
        layout {
            sequence: 20
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: fin-panel
        }
        chartLayout {
            height: 280
        }
        messages {
            whenNoDataFound: Nema podataka za izabrani period.
        }

        series prijem (
            name: Prijem
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH m AS (
                        SELECT level AS mj FROM dual CONNECT BY level <= 12
                    )
                    SELECT
                        substr('JanFebMarAprMajJunJulAvgSepOktNovDec', (m.mj - 1) * 3 + 1, 3) AS mjesec,
                        coalesce(sum(k.prijem), 0) AS vrijednost
                    FROM
                        m
                        LEFT JOIN blagajna_dnevnik k
                            ON  k.ooj_id = :APP_OOJ_ID
                            AND k.godina = :APP_GODINA
                            AND extract(month FROM k.datum) = m.mj
                            AND k.blagajna_id IN (SELECT id FROM blagajne WHERE valuta_id = 1)
                    GROUP BY
                        m.mj
                    ORDER BY
                        m.mj
                    ```
            }
            columnMapping {
                label: MJESEC
                value: VRIJEDNOST
            }
            appearance {
                color: #00a982
            }
        )

        series placanja (
            name: Plaćanja
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH m AS (
                        SELECT level AS mj FROM dual CONNECT BY level <= 12
                    )
                    SELECT
                        substr('JanFebMarAprMajJunJulAvgSepOktNovDec', (m.mj - 1) * 3 + 1, 3) AS mjesec,
                        coalesce(sum(k.placanja), 0) AS vrijednost
                    FROM
                        m
                        LEFT JOIN blagajna_dnevnik k
                            ON  k.ooj_id = :APP_OOJ_ID
                            AND k.godina = :APP_GODINA
                            AND extract(month FROM k.datum) = m.mj
                            AND k.blagajna_id IN (SELECT id FROM blagajne WHERE valuta_id = 1)
                    GROUP BY
                        m.mj
                    ORDER BY
                        m.mj
                    ```
            }
            columnMapping {
                label: MJESEC
                value: VRIJEDNOST
            }
            appearance {
                color: #c4473a
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            minorTicks {
                show: false
            }
        )

    )

    region stanje-blagajni (
        name: Stanje po blagajnama
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv,
                    datum_dnevnika,
                    stanje,
                    valuta
                FROM
                    vw_dash_blagajna_stanje
                WHERE
                    ooj_id = :APP_OOJ_ID
                ORDER BY
                    naziv
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noPadding
            ]
            cssClasses: fin-panel
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Nema definisanih blagajni.
        }

        column NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Blagajna
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column DATUM_DNEVNIKA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Posljednji dnevnik
            }
            layout {
                sequence: 20
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
            sorting {
                sortable: false
            }
        )

        column STANJE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Stanje
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column VALUTA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

    )

)

