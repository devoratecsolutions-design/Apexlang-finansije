page 362 (
    name: Popis / Pregled
    alias: POPIS-PREGLED
    title: Popis / Pregled
    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region osnovne-informacije (
        name: Osnovne informacije
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv,
                    datum,
                    opis,
                    zakljucano
                FROM
                    popisi
                WHERE
                    id = :P362_ID
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATUM (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 20
            }
        )

        column NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Naziv
            }
            layout {
                sequence: 10
            }
        )

        column OPIS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Opis
            }
            layout {
                sequence: 30
            }
        )

        column ZAKLJUCANO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Zaključano
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if ZAKLJUCANO/}
                    <span class="t-Button t-Button--noLabel u-color-5 t-Button--iconLeft t-Button--small">
                        <span class="t-Icon t-Icon--left fa fa-check-circle-o"></span>
                    </span>
                    {else/}
                    <span class="t-Button t-Button--noLabel u-color-9 t-Button--iconLeft t-Button--small">
                        <span class="t-Icon t-Icon--left fa fa-circle-o"></span>
                    </span>
                    {endif/}
                    
                    ```
            }
        )

    )

    region stavke (
        name: Stavke
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    redni_broj,
                    stavka_id,
                    prethodna_kolicina,
                    popis_kolicina
                FROM
                    popis_stavke
                WHERE
                    popis_id = :P362_ID
                ORDER BY
                    redni_broj ASC
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-expanded
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column POPIS_KOLICINA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Količina (popis)
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column PRETHODNA_KOLICINA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Količina (aplikativno)
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column REDNI_BROJ (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: RB
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 64
            }
        )

        column STAVKA_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Stavka
            }
            lov {
                type: sharedComponent
                lov: @sec-stavke
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P362_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

