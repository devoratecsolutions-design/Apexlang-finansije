    pageItem P115_OOJ_ID (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P115_ROW_VERSION (
        type: displayOnly
        label {
            label: Row Version
            alignment: left
        }
        layout {
            sequence: 10
            region: @audit-information
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P115_SIFRA (
        type: textField
        label {
            label: Šifra
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @grupa-stavke-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 64
        }
    )

    pageItem P115_UPDATED (
        type: displayOnly
        label {
            label: Updated
            alignment: left
        }
        layout {
            sequence: 10
            region: @audit-information
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P115_UPDATED_BY (
        type: displayOnly
        label {
            label: Updated By
            alignment: left
        }
        layout {
            sequence: 10
            region: @audit-information
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P115_VALID (
        type: radioGroup
        label {
            label: Aktivno
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @grupa-stavke-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P115_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P115_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P115_ID IS NOT null AND :P115_OOJ_ID IS NOT null
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-pencil-square-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P115_ID IS NOT null AND :P115_OOJ_ID IS NOT null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation naziv-not-null (
        name: Naziv NOT NULL
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P115_NAZIV
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P115_NAZIV
        }
    )

    validation sifra-not-null (
        name: Sifra NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P115_SIFRA
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P115_SIFRA
        }
    )

    validation sifra-jedinstvena (
        name: Šifra jedinstvena
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM sif.acc_grupe_stavki
                WHERE (ooj_id = :APP_OOJ_ID OR ooj_id IS NULL)
                  AND upper(trim(sifra)) = upper(trim(:P115_SIFRA))
                  AND id != nvl(:P115_ID, -1)
                ```
        }
        error {
            errorMessage: Grupa sa šifrom &P115_SIFRA. već postoji.
            associatedItem: @P115_SIFRA
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 54165609804625741
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_broj NUMBER;
                BEGIN
                    SELECT count(*) INTO l_broj FROM sec_stavke WHERE grupa_id = :P115_ID;
                    IF l_broj > 0 THEN
                        raise_application_error(-20105,
                            'Grupa je dodijeljena stavkama i ne može se obrisati. Deaktivirajte je (Aktivno = NE).');
                    END IF;
                    sif.acc_pkg.delete_grupa_stavke(p_id => :P115_ID);
                END;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 54167228162625740
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sif.acc_pkg.get_grupa_stavke (
                    p_id          => :P115_ID,
                    p_ooj_id      => :P115_OOJ_ID,
                    p_sifra       => :P115_SIFRA,
                    p_naziv       => :P115_NAZIV,
                    p_valid       => :P115_VALID,
                    p_row_version => :P115_ROW_VERSION,
                    p_created     => :P115_CREATED,
                    p_created_by  => :P115_CREATED_BY,
                    p_updated     => :P115_UPDATED,
                    p_updated_by  => :P115_UPDATED_BY
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 54166055696625741
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P115_ID
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P115_ID := sif.acc_pkg.insert_grupa_stavke (
                    p_ooj_id => :APP_OOJ_ID,
                    p_sifra  => :P115_SIFRA,
                    p_naziv  => :P115_NAZIV
                );
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 54166477896625741
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process konta-ig-save-interactive-grid-data (
        name: Konta IG - Save Interactive Grid Data
        type: executeCode
        editableRegion: @konta-ig
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS = 'D' THEN
                    sif.acc_pkg.delete_grupa_stavke_konta (
                        p_id => :ID
                    );
                    RETURN;
                
                ELSIF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN
                    sif.acc_pkg.insert_grupa_stavke_konta (
                        p_grupa_stavke_id => :P115_ID,
                        p_kontna_klasa_id => :KONTNA_KLASA_ID,
                        p_tip_kretanja_id => :TIP_KRETANJA_ID,
                        p_tip_stavke      => :TIP_STAVKE
                    );
                
                    RETURN;
                
                ELSIF :APEX$ROW_STATUS = 'U' THEN
                    sif.acc_pkg.update_grupa_stavke_konta (
                        p_id              => :ID,
                        p_grupa_stavke_id => :P115_ID,
                        p_kontna_klasa_id => :KONTNA_KLASA_ID,
                        p_tip_kretanja_id => :TIP_KRETANJA_ID,
                        p_tip_stavke      => :TIP_STAVKE
                    );
                    RETURN;
                
                END IF;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 54164392503625748
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sif.acc_pkg.update_grupa_stavke (
                    p_id     => :P115_ID,
                    p_ooj_id => :APP_OOJ_ID,
                    p_sifra  => :P115_SIFRA,
                    p_naziv  => :P115_NAZIV,
                    p_valid  => :P115_VALID
                );
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 54166887956625740
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

