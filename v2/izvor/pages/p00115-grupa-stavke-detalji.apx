page 115 (
    name: Grupa stavke / Detalji
    alias: GRUPA-STAVKE-DETALJI
    title: Grupa stavke / Detalji
    pageGroup: @konfiguracija
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region audit-information (
        name: Audit Information
        type: staticContent
        layout {
            sequence: 70
            parentRegion: @grupa-stavke-detalji
            slot: regionBody
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P115_ID
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region grupa-stavke-detalji (
        name: Grupa stavke / Detalji
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P115_ID IS NULL OR :P115_OOJ_ID IS NOT NULL
        }
    )

    region konta-ig (
        name: Konta IG
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    tip_kretanja_id,
                    kontna_klasa_id,
                    tip_stavke
                FROM
                    sif.acc_grupe_stavki_konta
                WHERE
                    grupa_stavke_id = :P115_ID
                ```
        }
        layout {
            sequence: 50
            parentRegion: @grupa-stavke-detalji
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    let $ = apex.jQuery,
                        toolbarData = $.apex.interactiveGrid.copyDefaultToolbar();
                        addrowAction = toolbarData.toolbarFind("selection-add-row"),
                        addrowAction.label = "Nova stavka"; // Pick name you need
                        editrowAction = toolbarData.toolbarFind("edit"),
                        editrowAction.label = "Izmjeni"; // Pick name you need
                        saverowAction = toolbarData.toolbarFind("save"),
                        saverowAction.label = "Sačuvaj izmjene"
                    options.toolbarData = toolbarData;
                    
                    options.defaultGridViewOptions = {
                        reorderColumns: false
                    }
                    return options;
                }
                
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 107215063046298192
        }

        savedReport 530764 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @KONTNA_KLASA_ID
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @TIP_KRETANJA_ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @TIP_STAVKE
                layout {
                    sequence: 5
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column KONTNA_KLASA_ID (
            type: popupLov
            heading {
                heading: Kontna klasa
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @kontni-okvir-klase-ooj
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: KONTNA_KLASA_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column TIP_KRETANJA_ID (
            type: selectList
            heading {
                heading: Tip kretanja
            }
            lov {
                type: sharedComponent
                lov: @sif-tipovi-kretanja-robe
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: TIP_KRETANJA_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column TIP_STAVKE (
            type: radioGroup
            heading {
                heading: Tip stavke (D/P)
            }
            lov {
                type: sharedComponent
                lov: @duguje-potrazuje
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: TIP_STAVKE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    region ne-možete-izmijeniti-ovu-grupu (
        name: Ne možete izmijeniti ovu grupu
        type: staticContent
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--wizard
                t-Alert--defaultIcons
                t-Alert--danger
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P115_ID IS NOT NULL AND :P115_OOJ_ID IS NULL
        }
    )

    pageItem P115_CREATED (
        type: displayOnly
        label {
            label: Created
            alignment: left
        }
        layout {
            sequence: 10
            region: @audit-information
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P115_CREATED_BY (
        type: displayOnly
        label {
            label: Created By
            alignment: left
        }
        layout {
            sequence: 10
            region: @audit-information
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P115_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P115_NAZIV (
        type: textField
        label {
            label: Naziv
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @grupa-stavke-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
