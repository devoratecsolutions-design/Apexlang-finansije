    dynamicAction enable-disable-items (
        name: Enable/Disable Items
        execution {
            sequence: 150
        }
        when {
            event: ready
        }

        action disable-on-domaća-valuta (
            name: Disable on domaća valuta
            action: disable
            affectedElements {
                selectionType: items
                items: P52_CIJENA_VALUTA
            }
            execution {
                sequence: 30
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    if :P52_VALUTA_SIFRA='BAM' and :P51_VRSTA_DOKUMENTA_SIFRA IN ('AV','AVZ') then 
                        return true;
                    else 
                        return false;
                    end if;
                    ```
            }
        )

        action disable-on-redovne-fakture (
            name: Disable on Redovne fakture
            action: disable
            affectedElements {
                selectionType: items
                items: [
                    P52_CIJENA
                    P52_CIJENA_VALUTA
                ]
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :P51_VRSTA_FAKTURE_SIFRA NOT IN ('AV', 'AVZ')
            }
        )

        action disable-on-strana-valuta (
            name: Disable on strana valuta
            action: disable
            affectedElements {
                selectionType: items
                items: P52_CIJENA
            }
            execution {
                sequence: 40
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    if :P52_VALUTA_SIFRA!='BAM' and :P51_VRSTA_FAKTURE_SIFRA in ('AV','AVZ') then 
                        return true;
                    else 
                        return false;
                    end if;
                    ```
            }
        )

        action native-disable (
            name: "Disable on Avans "
            action: disable
            affectedElements {
                selectionType: items
                items: P52_PDV_INDIKATOR_ID
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :P51_VRSTA_FAKTURE_SIFRA IN ('AV', 'AVZ') AND :APP_PDV_SISTEM='Y'
            }
        )

    )

    dynamicAction get-iznos (
        name: Get iznos
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: [
                P52_CIJENA
                P52_PDV
            ]
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: $v('P52_KOLICINA') !== "" && $v('P52_CIJENA') !== "" && $v('P52_RABAT') !== "" && $v('P52_PDV') !== ""
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_cijena NUMBER;
                        l_cijena_valuta number;
                        l_jed_cijena number;
                        l_jed_cijena_valuta number;
                    BEGIN
                        l_jed_cijena:=to_number(:P52_CIJENA,'999G999G999G999G990D00');
                        
                        l_cijena :=l_jed_cijena - (l_jed_cijena * :P52_RABAT / 100);
                    
                        :P52_IZNOS := round(:P52_KOLICINA * l_cijena,2);
                        :P52_IZNOS_PDV := round(:P52_IZNOS + (:P52_IZNOS * :P52_PDV / 100),2);
                    
                    
                        :P52_IZNOS:=to_char(:P52_IZNOS,'999G999G999G999G990D00');
                        :P52_IZNOS_PDV:=to_char(:P52_IZNOS_PDV,'999G999G999G999G990D00');
                    
                        
                        
                        if :P52_VALUTA_NAZIV !='KM' then
                    
                            l_jed_cijena_valuta:= to_number(:P52_CIJENA,'999G999G999G999G990D00')/:P52_KURS;
                            l_cijena :=l_jed_cijena_valuta - (l_jed_cijena_valuta * :P52_RABAT / 100);
                    
                            :P52_IZNOS_VALUTA := round(:P52_KOLICINA * l_cijena,2);
                            :P52_IZNOS_VALUTA_PDV := round(:P52_IZNOS_VALUTA + (:P52_IZNOS_VALUTA * :P52_PDV / 100),2);
                            :P52_IZNOS_VALUTA:=to_char(:P52_IZNOS_VALUTA,'999G999G999G999G990D00');
                            :P52_IZNOS_VALUTA_PDV:=to_char(:P52_IZNOS_VALUTA_PDV,'999G999G999G999G990D00');
                    
                        end if;
                    
                    
                        
                    EXCEPTION
                        WHEN others THEN
                            raise_application_error(-20001, 'Pogrešan unos jedinične cijene.');
                    END;
                    ```
                itemsToSubmit: [
                    P52_KOLICINA
                    P52_CIJENA
                    P52_RABAT
                    P52_PDV
                    P52_IZNOS_VALUTA
                    P52_IZNOS_PDV
                    P52_CIJENA_VALUTA
                ]
                itemsToReturn: [
                    P52_IZNOS
                    P52_IZNOS_PDV
                    P52_IZNOS_VALUTA
                    P52_IZNOS_VALUTA_PDV
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P52_IZNOS := null;
                    :P52_IZNOS_PDV := null;
                    :P52_IZNOS_VALUTA := null;
                    :P52_IZNOS_VALUTA_PDV := null;
                    ```
                itemsToSubmit: [
                    P52_KOLICINA
                    P52_CIJENA
                    P52_RABAT
                    P52_PDV
                ]
                itemsToReturn: [
                    P52_IZNOS_VALUTA
                    P52_IZNOS_PDV
                    P52_IZNOS_VALUTA_PDV
                    P52_IZNOS
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

    )

