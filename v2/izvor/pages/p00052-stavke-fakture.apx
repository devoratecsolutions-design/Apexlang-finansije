            valueProtected: false
        }
        layout {
            sequence: 180
            region: @unos
            slot: regionBody
        }
        help {
            helpText:
                ```html
                <div>
                <ol>
                    <li>A1 -Izlazna faktura kupcu sa IB om <b><em>-polja PDV prijave:11,51</b></em></li>
                    <li>A2 -Interna faktura.. utrošena sredsva i treba pdv <b><em>-polja PDV prijave:11,51 i (32 ili 33 ili 34)</b></em></li>
                    <li>A4 -Manjak <b><em>-polja PDV prijave:11,51 i (32 ili 33 ili 34)</b></em></li>
                    <li>A5 -Polog pazara… <b><em>-polja PDV prijave:11,51</b></em></li>
                    <li>A6 -Usluge od inostranih dobavljača <b><em>-polja PDV prijave: 51</b></em></li>
                    <li>A7 -PDV na primljeni avans <b><em>-polja PDV prijave:11,51</b></em></li>
                    <li>B1 -Fakture kupcu bez IB a <b><em>-polja PDV prijave:11,51 i (32 ili 33 ili 34)</b></em></li>
                    <li>B4 -Avans kupaca bez IB-a <b><em>-polja PDV prijave:11,51 i (32 ili 33 ili 34)</b></em></li>
                    <li>C1 -Stavka koja je oslobodjena plaćanja <b><em>-polja PDV prijave:13</b></em></li>
                    <li>C2 -Kamata u računu <b><em>-polja PDV prijave:-</b></em></li>
                    <li>C4 -PDV za prodaju vozila gdje se nije koristo odbitni pdv <b><em>-polja PDV prijave:-</b></em></li>
                    <li>C5 -Fakture za nato- nemaju pdv <b><em>-polja PDV prijave:11</b></em></li>
                    <li>D1 -KO za obveznike <b><em>-polja PDV prijave:11,51</b></em></li>
                    <li>D2 -KO neobveznicima <b><em>-polja PDV prijave:11,51 i (32 ili 33 ili 34)</b></em></li>
                    <li>I1 -Izvoz <b><em>-polja PDV prijave:12</b></em></li>
                </ol>
                </div>
                ```
        }
    )

