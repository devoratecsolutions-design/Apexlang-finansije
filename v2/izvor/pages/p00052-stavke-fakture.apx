    dynamicAction add-to-collection (
        name: Add to collection
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @add
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression:
                ```javascript-browser
                $v('P52_STAVKA_ID') !== "" && 
                $v('P52_JM_ID') !== "" &&
                $v('P52_KOLICINA') !== "" && 
                $v('P52_CIJENA') !== "" && 
                $v('P52_RABAT') !== "" && 
                $v('P52_PDV') !== "" && 
                $v('P52_IZNOS') !== "" && 
                $v('P52_IZNOS_PDV') !== "" && 
                ($v('P52_PDV_INDIKATOR_ID') !== "" || $v('P52_PDV_HIDDEN') !== "")
                ```
        }

        action native-alert (
            action: alert
            settings {
                title: Nedovoljno podataka
                message: Morate popuniti sva označena polja.
                icon: fa-exclamation-circle-o
                cssClasses: u-color-9
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P52_STAVKA_ID
                    P52_JM_ID
                    P52_CIJENA
                ]
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-clear_1 (
            action: clear
            affectedElements {
                selectionType: items
                items: P52_KOLICINA
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            serverSideCondition {
                type: itemIsNotInColonDelimitedList
                item: P51_VRSTA_FAKTURE_SIFRA
                list: AV,AVZ
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_tip_stavke_id NUMBER;
                        l_pom number;
                    BEGIN
                    
                    
                        if :P52_KOLICINA<=0 then 
                             raise_application_error(-20001, 'Količina mora biti veća od 0.');
                        end if;
                    
                        SELECT
                            tip_stavke_id
                        INTO
                            l_tip_stavke_id
                        FROM
                            sec_stavke
                        WHERE
                            id = :P52_STAVKA_ID;
                    
                        /*IF l_tip_stavke_id = 1 THEN
                            IF stavke_pkg.get_stavka_stanje_kolicina (
                                p_stavka_id    => :P52_STAVKA_ID,
                                p_skladiste_id => :A_SKLADISTE_ID
                            ) < :P52_KOLICINA THEN
                                raise_application_error(-20001, 'Nemate tu količinu na stanju.');
                            END IF;
                        END IF;*/
                    
                        select count(1)
                        into   l_pom
                        from   apex_collections
                        where  collection_name = 'FAKTURA_STAVKE'
                        and    c001             = :P52_STAVKA_ID;
                    
                        if l_pom>0 then 
                    
                            raise_application_error(-20001, 'Već ste dodali tu stavku u fakturu.');
                    
                        else 
                    
                            apex_collection.add_member (
                            p_collection_name => 'FAKTURA_STAVKE',
                            p_c001            => :P52_STAVKA_ID,
                            p_c002            => :P52_JM_ID,
                            p_c003            => :P52_KOLICINA,
                            p_c004            => to_number(:P52_CIJENA,'999G999G999G999G990D00'),
                            p_c005            => :P52_RABAT,
                            p_c006            => :P52_PDV,
                            p_c007            => to_number(:P52_IZNOS,'999G999G999G999G990D00'),
                            p_c008            => to_number(:P52_IZNOS_PDV,'999G999G999G999G990D00'),
                            p_c009            => :P52_TIP_CIJENE,
                            p_c010            => :P52_PDV_INDIKATOR_ID
                        );
                    
                        end if;
                    
                    
                    END;
                    ```
                itemsToSubmit: [
                    P52_STAVKA_ID
                    P52_JM_ID
                    P52_KOLICINA
                    P52_CIJENA
                    P52_RABAT
                    P52_PDV
                    P52_IZNOS_VALUTA
                    P52_IZNOS_PDV
                    P52_PDV_INDIKATOR_DOKUMENT_ID
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-stavki
            }
