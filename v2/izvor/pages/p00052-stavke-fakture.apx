    region ukupno (
        name: Ukupno
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    CASE
                        WHEN :P52_VALUTA_ID = 1 THEN 
                            sif.spell_pkg.spell_serbian_number (coalesce(round(sum(c008), 2), 0), 'Y', 'J', :P52_VALUTA_NAZIV)
                        ELSE
                            sif.spell_pkg.spell_serbian_number (coalesce(round(sum(sif.acc_pkg.convert_bam(
                                p_valuta_id => :P52_VALUTA_ID,
                                p_bam => c008
                            )), 2), 0), 'Y', 'J', :P52_VALUTA_NAZIV)
                    END as slovima,
                    sum(c008) as ukupno_pdv,
                    sum(c007) as ukupno,
                
                    sum(sif.acc_pkg.convert_bam(
                        p_valuta_id => :P52_VALUTA_ID,
                        p_bam => c008
                    )) as ukupno_valuta
                FROM
                    apex_collections
                WHERE
                    collection_name = 'FAKTURA_STAVKE'
                ```
        }
        layout {
            sequence: 70
            parentRegion: @stavke-wrapper
            slot: regionBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: stavke_ukupno
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo-item--stacked
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

