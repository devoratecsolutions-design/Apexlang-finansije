        name: Get jedinicna cijena
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P52_STAVKA_ID
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: "$v('P52_STAVKA_ID') !== \"\" "
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P52_CIJENA := null;
                    :P52_CIJENA_VALUTA:=null;
                    ```
                itemsToSubmit: [
                    P52_STAVKA_ID
                    P52_KOLICINA
                    P52_CIJENA
                ]
                itemsToReturn: [
