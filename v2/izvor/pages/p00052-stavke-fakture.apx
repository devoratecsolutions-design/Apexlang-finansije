    button add (
        buttonName: ADD
        label: Dodaj stavku
        layout {
            sequence: 270
            region: @unos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--simple
                t-Button--iconLeft
                t-Button--stretch
                t-Button--padTop
                t-Button--gapBottom
            ]
            icon: fa-plus
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                v_pom number;
                begin
                
                
                
                    IF UPPER(:P51_VRSTA_FAKTURE_SIFRA)  IN ('KO','KZ','AVZ')  THEN 
                
                        return  FALSE;
                
                    ELSIF UPPER(:P51_VRSTA_FAKTURE_SIFRA)  IN ('AV') THEN
                
                        select count(*)
                        into v_pom
                        from  apex_collections c
                        where collection_name = 'FAKTURA_STAVKE';
                        
                        if v_pom>0 then
                            return false;
                        end if;
                
                
                    END IF;
                
                    return true;
                end;
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @stavke
            slot: close
        }
        appearance {
