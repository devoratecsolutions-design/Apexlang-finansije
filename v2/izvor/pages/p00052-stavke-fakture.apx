                        select count(1)
                        into   l_pom
                        from   apex_collections
                        where  collection_name = 'FAKTURA_STAVKE'
                        and    c001             = :P52_STAVKA_ID
                        and    seq_id!=:P52_SEQ_ID;
                    
                        if l_pom>0 then 
                    
                            raise_application_error(-20001, 'Već ste dodali tu stavku u fakturu.');
                    
                        else 
                    
                            apex_collection.update_member (
                                p_collection_name => 'FAKTURA_STAVKE',
                                p_seq             => :P52_SEQ_ID,
                                p_c001            => :P52_STAVKA_ID,
