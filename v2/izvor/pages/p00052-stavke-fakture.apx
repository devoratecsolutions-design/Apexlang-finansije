    process edit-stavka (
        name: Edit stavka
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P52_SEQ_ID!=0 THEN
                    SELECT
                        c001,
                        c002,
                        c003,
                        c004,
                        round(c004/:P51_KURS,2),
                        c005,
                        c006,
                        c007,
                        round(c007/:P51_KURS,2),
                        c008,
                        round(c008/:P51_KURS,2)
                    INTO
                        :P52_STAVKA_ID,
                        :P52_JM_ID,
                        :P52_KOLICINA,
                        :P52_CIJENA,
                        :P52_CIJENA_VALUTA,
                        :P52_RABAT,
                        :P52_PDV,
                        :P52_IZNOS,
                        :P52_IZNOS_VALUTA, 
                        :P52_IZNOS_PDV,
                        :P52_IZNOS_VALUTA_PDV
                    FROM
                    	apex_collections
                    WHERE
                    	collection_name = 'FAKTURA_STAVKE'
                    	AND seq_id = :P52_SEQ_ID;
                
                
                        :P52_IZNOS_VALUTA:=to_char(:P52_IZNOS_VALUTA,'999G999G999G999G990D00');
                        :P52_IZNOS_VALUTA_PDV:=to_char(:P52_IZNOS_VALUTA_PDV,'999G999G999G999G990D00');
                        :P52_IZNOS:=to_char(:P52_IZNOS,'999G999G999G999G990D00');
                        :P52_IZNOS_PDV:=to_char(:P52_IZNOS_PDV,'999G999G999G999G990D00');
                
                
                
                else
                
                        :P52_STAVKA_ID:=null;
                        :P52_JM_ID:=null;
                        :P52_KOLICINA:=null;
                        :P52_CIJENA:=null;
                        :P52_CIJENA_VALUTA:=null;
                        :P52_RABAT:=null;
                        :P52_PDV:=null;
                        :P52_IZNOS:=null;
                        :P52_IZNOS_PDV:=null;
                        :P52_IZNOS_VALUTA:=null;
                        :P52_IZNOS_VALUTA_PDV:=null;
                
                        if :APP_PDV_SISTEM!='Y' then
                
                            :P52_PDV:=0;
                
                        else 
                
                            :P52_PDV:=null;
                
                        end if;
                
                        if :P51_VRSTA_FAKTURE_SIFRA in ('AV','AVZ') then 
                            :P52_KOLICINA:=1;
                        end if;
                
                
                
                END IF;
                
                
                
                apex_collection.create_or_truncate_collection (
                            p_collection_name => 'FAKTURA_AVANS');
                
                ```
        }
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 157194973591764769
        }
    )

    process insert-to-collection (
        name: Insert to collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P51_VRSTA_FAKTURE_SIFRA = 'KO' THEN -- Knjizno odobrenje
                    apex_collection.delete_collection (
                        p_collection_name => 'FAKTURA_STAVKE'
                    );
                
                    apex_collection.create_collection_from_query (
                        p_collection_name => 'FAKTURA_STAVKE',
                        p_query           => '
                            SELECT
                                stavka_id,
                                jm_id,
                                kolicina,
                                cijena * (-1),
                                rabat,
                                pdv * (-1),
                                iznos * (-1),
                                (iznos + (iznos * pdv / 100)) * (-1) as iznos_pdv,
                                tip_cijene,
                                pdv_indikator_id
                            FROM
                                vw_kif_stavke
                            WHERE
                                kif_id = ' || :P51_FAKTURA_ID || '
                    ');
                ELSIF :P51_VRSTA_FAKTURE_SIFRA = 'KZ' THEN -- Knjizno zaduzenje
                    apex_collection.delete_collection (
                        p_collection_name => 'FAKTURA_STAVKE'
                    );
                
                    apex_collection.create_collection_from_query (
                        p_collection_name => 'FAKTURA_STAVKE',
                        p_query           => '
                            SELECT
                                stavka_id,
                                jm_id,
                                kolicina,
                                cijena,
                                rabat,
                                pdv,
                                iznos,
                                (iznos + (iznos * pdv / 100)) as iznos_pdv,
                                tip_cijene,
                                pdv_indikator_id
                            FROM
                                vw_kif_stavke
                            WHERE
                                kif_id = ' || :P51_FAKTURA_ID || '
                    ');
                
                ELSIF  :P51_VRSTA_FAKTURE_SIFRA = 'AVZ' THEN -- Knjizno zaduzenje
                    apex_collection.delete_collection (
                        p_collection_name => 'FAKTURA_STAVKE'
                    );
                
                    apex_collection.create_collection_from_query (
                        p_collection_name => 'FAKTURA_STAVKE',
                        p_query           => '
                                  select  stavka_id,
                                            jm_id,
                                            -kolicina,
                                            zat.preostalo_osnovica,
                                            rabat,
                                            zat.pdv_stopa,
                                            -zat.preostalo_osnovica,
                                            -zat.preostalo_pdv,
                                            tip_cijene,
                                            pdv_indikator_id
                                 from vw_kif_stavke ks
                                 join (select id, 
                                             pdv_stopa, 
                                             round((iznos_fakture-zatvoreno_km)/(1+pdv_stopa/100),2) preostalo_osnovica,
                                             iznos_fakture-zatvoreno_km preostalo_pdv
                                       from (select k.id, ap.vrijednost as pdv_stopa,
                                                  k.iznos_fakture,
                                                  sum(round(sif.acc_pkg.convert_valuta_to_bam(av.id,k.ooj_id,k.datum_fakture,nvl(kz.iznos,0)),2)) as zatvoreno_km
                                           from accounting.kif k
                                           join sif.acc_valute av on av.id=k.valuta_id
                                           join sif.acc_pdv_indikatori ap on ap.id=k.pdv_indikator_id
                                           left join accounting.kif_avansi_zatvaranje kz on kz.avans_id=k.id 
                                           where k.id=' || :P51_FAKTURA_ID || '
                                           group by ap.vrijednost,k.iznos_fakture, k.id)) zat on ks.kif_id=zat.id
                    ');
                
                
                
                END IF;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 157194578509764769
        }
        serverSideCondition {
            type: request=Value
            value: stavke
        }
    )

