    region najčešće-stavke-cards (
        name: Najčešće stavke - Cards
        title: Najčešće stavke
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    s.id,
                    s.sifra || ': ' || s.naziv AS naziv,
                    to_char(stavke_pkg.get_stavka_cijena(:P51_CJENOVNIK_ID, s.id, null), '999G999G999G999G990D00') || ' KM' as cijena
                FROM 
                    sec_stavke s
                    JOIN (
                        SELECT 
                            stavka_id
                        FROM 
                            vw_kif_stavke
                        WHERE
                            ooj_id = :APP_OOJ_ID
                        GROUP BY 
                            stavka_id
                        ORDER BY 
                            COUNT(*) DESC
                        FETCH FIRST 10 ROWS ONLY
                    ) k ON k.stavka_id = s.id
                WHERE
                    s.valid = 'Y'
                ```
        }
        layout {
            sequence: 30
            parentRegion: @stavke-wrapper
            slot: regionBody
        }
        appearance {
            template: @cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--removeHeader js-removeLandmark
                t-CardsRegion--styleC
                margin-top-md
                margin-bottom-md
            ]
        }
        advanced {
            htmlDomId: stavke-cards
            customAttributes: data-id="#ID#"
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 
                    1
                
                FROM 
                    sec_stavke s
                    JOIN (
                        SELECT 
                            stavka_id
                        FROM 
                            vw_kif_stavke
                        WHERE
                            ooj_id = :APP_OOJ_ID
                        GROUP BY 
                            stavka_id
                        ORDER BY 
                            COUNT(*) DESC
                        FETCH FIRST 10 ROWS ONLY
                    ) k ON k.stavka_id = s.id
                WHERE 1=0
                ```
        }
        componentAppearance {
            gridColumns: 5
        }
        card {
            primaryKeyColumn1: ID
        }
        subtitle {
            column: NAZIV
            cssClasses: u-bold
        }
        secondaryBody {
            column: CIJENA
        }
    )

