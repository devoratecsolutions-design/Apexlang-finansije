    dynamicAction clicked-delete-stavka (
        name: Clicked - Delete stavka
        execution {
            sequence: 140
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .delete-stavka
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var stavka_id = $(this.triggeringElement).data('id');
                    
                    // Call PL/SQL to add to collection
                    apex.server.process(
                        "DELETE_FROM_COLLECTION",   
                        { x01: stavka_id }, 
                        {
                            success: function(pData) {
                                console.log("Removed fromed collection:", stavka_id);
                    
                                apex.region("stavke_ukupno").refresh();
                                apex.region("stavke_list").refresh();
                            }
                        }
                    );
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

