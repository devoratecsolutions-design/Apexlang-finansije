                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P52_CIJENA := stavke_pkg.get_stavka_cijena (
                        p_cjenovnik_id  => :P51_CJENOVNIK,
                        p_stavka_id     => :P52_STAVKA_ID,
                        p_tip_cijene    => :P52_TIP_CIJENE
                    
                    );
                    
                     :P52_CIJENA_VALUTA:=:P52_CIJENA/:P52_KURS;
                    
                    
                     --:P52_CIJENA := to_char(:P52_CIJENA,'999G999G999G999G990D00');
                     --:P52_CIJENA_VALUTA := to_char(:P52_CIJENA_VALUTA,'999G999G999G999G990D00');
                    
                    
                     
