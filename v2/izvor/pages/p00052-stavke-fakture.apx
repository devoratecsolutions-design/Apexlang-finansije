                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P52_IZNOS := null;
                    :P52_IZNOS_PDV := null;
                    :P52_IZNOS_VALUTA := null;
                    :P52_IZNOS_VALUTA_PDV := null;
                    ```
                itemsToSubmit: [
                    P52_KOLICINA
                    P52_CIJENA
