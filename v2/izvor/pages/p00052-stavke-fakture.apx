page 52 (
    name: Stavke fakture
    alias: STAVKE-FAKTURE
    title: Stavke fakture
    pageGroup: @fakture-računi
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .t-MediaList-item:hover {
                --ut-medialist-item-background-color: var(--ut-medialist-item-hover-background-color, var(--ut-component-highlight-background-color));
            }
            
            .a-CardView:hover {
                background-color: var(--ut-medialist-item-hover-background-color, var(--ut-component-highlight-background-color));
            }
            
            /* Popup LOV – širine kolona: 1 Tip | 2 Šifra | 3 Naziv | 4 Cijena */
            .a-PopupLOV-dialog col[data-idx="1"] { width: 80px  !important; }
            .a-PopupLOV-dialog col[data-idx="2"] { width: 80px  !important; }
            .a-PopupLOV-dialog col[data-idx="3"] { width: auto  !important; }  /* Naziv dobija ostatak */
            .a-PopupLOV-dialog col[data-idx="4"] { width: 110px !important;  text-align: right;}
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            U narednom koraku definišu se stavke fakturisanja.</br> 
            Ukoliko se fakturiše nova stavka, koja nije postojeća u sistemu, 
            moguće je iz ovog dijaloga definisati novu stavku.</br>
            Na stavci se definiše, da li je stavka oporeziva (pun iznos PDV-a) kao i cijena stavke.</br>
            U tabu <b><em>"Najčešće stavke"</em></b> svakom korisniku biće prikazane one stavke koje se u 
            radu najčešće koriste. </br>
            Na ovaj način obezbjeđena je intuitivnost i brzina unosa – dovoljno je da kliknete na karticu 
            željene stavke, nakon čega će se ta stavka automatski pojaviti u izvještaju ispod.</br>
            Ukoliko želite da izvršite izmjenu podataka za neku od stavki, 
            potrebno je da kliknete na dugme <b><em>"Ažuriraj"</em></b>, nakon čega se prebacujete na tab <b><em>"Unos"</em></b>. 
            Tamo možete promijeniti podatke koje želite za odabranu stavku, a proces završavate 
            klikom na dugme <b><em>"Ažuriraj stavku"</em></b>. </br>
            U tabu <b><em>"Lista stavki"</em></b> prikazuje se pregled svih dostupnih stavki.</br> 
            Na dnu izvještaja nalaze se opcije Previous i Next, koje vam omogućavaju da lako 
            pretražujete i pronalazite željenu stavku. </br>
            Klikom na stavku iz liste, ona se automatski unosi u izvještaj ispod. </br>
            Nakon što je stavka dodata, dovoljno je da kliknete na dugme <b><em>"Sljedeći korak"</em></b> kako biste nastavili proces.
            Nakon što se unese odabarana stavka i količina fakturisanja sistem povlači podatke sa stavke. 
            Definisanu cijenu, ukoliko je potrebno, moguće je ručno izmijeniti.
            ```
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @stavke
            slot: wizardSubRegions
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
        serverSideCondition {
            type: never
        }
    )

    region lista (
        name: "Lista "
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @stavke-wrapper
            slot: regionBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region lista-report (
        name: Lista Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    null as list_title,
                    null as list_text,
                    null as list_badge,
                    null as link,
                
                    sc.naziv,
                    CASE
                        WHEN c.tip = 'M' THEN
                            'MPC: ' || to_char(cs.mpc, '999G999G999G999G990D00') || ' KM'
                        ELSE
                            'VPC: ' || to_char(cs.vpc, '999G999G999G999G990D00') || ' KM'
                    END AS  cijena,
                
                    'padding-left-none' AS link_class,
                    'data-id=' || sc.id AS link_attr
                FROM skladista sk
                JOIN cjenovnici c on sk.cjenovnik_id=c.id 
                JOIN cjenovnik_stavke cs  on c.id=cs.cjenovnik_id and cs.valid='Y'
                JOIN sec_stavke sc on cs.stavka_id=sc.id 
                WHERE sc.ooj_id = :APP_OOJ_ID
                AND sc.valid = 'Y'
                AND sk.id=:A_SKLADISTE_ID
                    
                ```
        }
        layout {
            sequence: 20
            parentRegion: @lista
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: [
                fin-list
                fin-list--media
            ]
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @media-list
            templateOptions: [
                t-MediaList--showDesc
                t-MediaList--stack
                t-MediaList--iconsRounded
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound:
                ```
                Nema pronađenih podataka.
                
                ```
        }

