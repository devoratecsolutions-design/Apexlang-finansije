    process add-to-collection (
        name: ADD_TO_COLLECTION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_stavka_id NUMBER := apex_application.g_x01;
                    l_tip_stavke_id NUMBER;
                    l_jm_id  NUMBER;
                    l_cijena NUMBER;
                
                    l_pdv    NUMBER;
                    l_pdv_indikator   VARCHAR2(1);
                    l_pdv_indikator_id NUMBER;
                
                    l_seq_id NUMBER;
                    l_kolicina NUMBER;
                    l_iznos NUMBER;
                    l_iznos_pdv NUMBER;
                BEGIN
                    SELECT
                        tip_stavke_id
                    INTO
                        l_tip_stavke_id
                    FROM
                        sec_stavke
                    WHERE
                        id = l_stavka_id;
                
                    IF :APP_TIP_PREDUZETNIKA_SIFRA IN ('msp', 'vsp_prosto') THEN
                        stavke_pkg.get_stavka (
                            p_id               => l_stavka_id,
                            p_jm_id            => l_jm_id,
                            p_pdv_indikator    => l_pdv_indikator,
                            p_pdv_indikator_id => l_pdv_indikator_id
                        );
                
                    ELSIF :APP_TIP_PREDUZETNIKA_SIFRA IN ('doo', 'ad', 'vsp_dvojno') THEN
                        stavke_pkg.get_stavka (
                            p_id               => l_stavka_id,
                            p_jm_id            => l_jm_id,
                            p_pdv_indikator    => l_pdv_indikator,
                            p_pdv_indikator_id => l_pdv_indikator_id
                        );
                
                        IF l_pdv_indikator = 'Y' THEN
                            l_pdv_indikator_id := :P51_PDV_INDIKATOR_ID;
                        END IF;
                        
                        sif.acc_pkg.get_pdv_indikator (
                            p_id         => l_pdv_indikator_id,
                            p_vrijednost => l_pdv
                        );
                    END IF;
                
                    l_cijena := stavke_pkg.get_stavka_cijena (
                        p_id         => l_stavka_id,
                        p_tip_cijene => :P52_TIP_CIJENE
                    );
                
                    SELECT
                        seq_id,
                        c003,
                        c007,
                        c008
                    INTO
                        l_seq_id,
                        l_kolicina,
                        l_iznos,
                        l_iznos_pdv
                    FROM
                        apex_collections
                    WHERE
                        collection_name = 'FAKTURA_STAVKE'
                        AND c001 = l_stavka_id;
                
                    IF l_seq_id IS NOT null THEN
                        l_kolicina := l_kolicina + 1;
                        l_iznos := l_cijena * l_kolicina;
                        l_iznos_pdv := round(l_iznos + (l_iznos * l_pdv / 100), 2);
                        
                        IF l_tip_stavke_id = 1 THEN
                            IF stavke_pkg.get_stavka_stanje_kolicina (
                                p_stavka_id    => l_stavka_id,
                                p_skladiste_id => :A_SKLADISTE_ID
                            ) < l_kolicina THEN
                                raise_application_error(-20001, 'Nemate tu količinu na stanju.');
                            END IF;
                        END IF;
                
                        apex_collection.update_member (
                            p_collection_name => 'FAKTURA_STAVKE',
                            p_seq             => l_seq_id,
                            p_c001            => l_stavka_id,
                            p_c002            => l_jm_id,
                            p_c003            => l_kolicina,
                            p_c004            => l_cijena,
                            p_c005            => 0,
                            p_c006            => l_pdv,
                            p_c007            => l_iznos,
                            p_c008            => l_iznos_pdv,
                            p_c009            => :P52_TIP_CIJENE,
                            p_c010            => l_pdv_indikator_id
                        );
                    END IF;
                
                    apex_json.open_object;
                    apex_json.write('status','success');
                    apex_json.close_object;
                
                    EXCEPTION
                        WHEN no_data_found THEN
                            IF l_tip_stavke_id = 1 THEN
                                IF stavke_pkg.get_stavka_stanje_kolicina (
                                    p_stavka_id    => l_stavka_id,
                                    p_skladiste_id => :A_SKLADISTE_ID
                                ) < l_kolicina THEN
                                    raise_application_error(-20001, 'Nemate tu količinu na stanju.');
                                END IF;
                            END IF;
                
                            apex_collection.add_member (
                                p_collection_name => 'FAKTURA_STAVKE',
                                p_c001            => l_stavka_id,
                                p_c002            => l_jm_id,
                                p_c003            => 1,
                                p_c004            => l_cijena,
                                p_c005            => 0,
                                p_c006            => l_pdv,
                                p_c007            => l_cijena,
                                p_c008            => round(l_cijena + (l_cijena * l_pdv / 100), 2),
                                p_c009            => :P52_TIP_CIJENE,
                                p_c010            => l_pdv_indikator_id
                            );
                            
                            apex_json.open_object;
                            apex_json.write('status','success');
                            apex_json.close_object;
                    
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 186399848551573801
        }
    )

