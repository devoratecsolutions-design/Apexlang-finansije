    region lista-stavki (
        name: Lista stavki
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    seq_id,
                    c001 as stavka_id,
                    s.sifra as stavka_sifra,
                    s.naziv as stavka_naziv,
                    c002 as jm_id,
                    jm.naziv as jm_naziv,
                    c003 as kolicina,
                    to_char(c004, '999G999G999G999G990D00') as cijena,
                    to_char(c004/:P52_KURS, '999G999G999G999G990D00') as cijena_u_valuti,
                    c005 as rabat,
                    c006 as pdv,
                    to_char(c007, '999G999G999G999G990D00') as iznos,
                    to_char(c007/:P52_KURS, '999G999G999G999G990D00') as iznos_u_valuti_bez_pdv,
                    to_char(c008, '999G999G999G999G990D00') as iznos_pdv,
                    to_char(c008/:P52_KURS, '999G999G999G999G990D00') as iznos_u_valuti_sa_pdv,
                    c010 as PDV_INDIKATOR
                FROM
                    apex_collections c
                    LEFT JOIN sec_stavke s ON c.c001 = s.id
                    LEFT JOIN sif.acc_jedinice_mjere jm ON c.c002 = jm.id
                WHERE
                    collection_name = 'FAKTURA_STAVKE'
                ORDER BY
                    seq_id ASC
                ```
        }
        layout {
            sequence: 60
            parentRegion: @stavke-wrapper
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        advanced {
            htmlDomId: stavke_list
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

