    button delete (
        buttonName: DELETE
        label: Obriši poreski period
        layout {
            sequence: 30
            region: @wrapper
            slot: buttonEnd
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Da li ste sigurni da želite obrisati izabrani poreski period?
            style: danger
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_count NUMBER;
                BEGIN
                    IF uio_pkg.is_pp_editable(:APP_OOJ_ID, :P81_PORESKI_PERIOD) THEN
                        RETURN true;
                    END IF;
                
                    SELECT
                        count(*)
                    INTO
                        l_count
                    FROM
                        uio_kif
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND poreski_period = to_char(:P81_PORESKI_PERIOD);
                    
                    IF l_count > 0 THEN
                        RETURN true;
                    END IF;
                
                    RETURN false; 
                
                END;
                ```
        }
    )

    button generate-csv (
        buttonName: GENERATE_CSV
        label: Generiši CSV
        layout {
            sequence: 10
            region: @wrapper
            slot: buttonEnd
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-file-csv-o
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT
                    1
                FROM
                    uio_kif
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND poreski_period = to_char(:P81_PORESKI_PERIOD)
                ```
        }
    )

    button generate-kif-uio (
        buttonName: GENERATE_KIF_UIO
        label: Generiši KIF
        layout {
            sequence: 10
            region: @uio-kif
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 90
                items: {
                    P90_TIP: KIF
                }
                clearCache: 90
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj - UIO KIF
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: return uio_pkg.is_pp_editable(:APP_OOJ_ID, :P81_PORESKI_PERIOD);
        }
    )

    dynamicAction delete-row (
        name: Delete Row
        execution {
            sequence: 20
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .delete-kif
        }

        action da-li-ste-sigurni (
            name: Da li ste sigurni
            action: confirm
            settings {
                title: Brisanje Fakture
                message: Da li ste sigurni?
                style: warning
                icon: fa-remove
                confirmLabel: Da, obriši
                cancelLabel: Ne, odustani
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @uio-kif-grid
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).parent().data('id')
            }
            affectedElements {
                selectionType: items
                items: P81_DELETE_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action procedura-brisanja (
            name: procedura brisanja
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    uio_pkg.delete_uio_kif (
                        p_id => :P81_DELETE_ID
                    );
                    
                    :P81_DELETE_ID := null;
                    ```
                itemsToSubmit: P81_DELETE_ID
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @generate-kif-uio
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @uio-kif-grid
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P90_PP
            }
            affectedElements {
                selectionType: items
                items: P81_PORESKI_PERIOD
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction start-download (
        name: Start Download
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @generate-csv
        }

        action native-confirm (
            action: confirm
            settings {
                title: Generisanje CSV fajlova
                message: Da li ste sigurni da želite preuzeti CSV fajlove?
                style: information
                icon: fa-arrow-circle-o-down fa-lg
                confirmLabel: Preuzmi
                cancelLabel: Odustani
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: startDownload('P81_DOWNLOAD_TOKEN');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DOWNLOAD_UIO
                showProcessing: false
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction submit-page (
        name: Submit Page
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P81_PORESKI_PERIOD
        }

        action native-submit-page (
            action: submitPage
            settings {
                showProcessing: false
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

