page 81 (
    name: UIO - KIF
    alias: UIO-KIF
    title: UIO - KIF
    pageGroup: @uio-dokumentacija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#download_with_token#MIN#.js
    }
    css {
        inline:
            ```css
            #kif_grid_ig_report_settings {
                display: none;
            }
            ```
    }
    security {
        authorizationScheme: @uio-kif
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Na stranici <b><em>"UIO KIF"</em></b> potrebno je unijeti poreski period i odabrati mjesec za koji želite 
            da dobijete podatke o unosima. </br>
            Ako ne postoje kreirani podaci, novi unos se pokreće klikom na dugme <b><em>"Novi unos".</em></b> </br>
            </br>
            Odabirom određenog perioda u izvještaju se prikazuju 
            detaljne informacije, a putem linka <b><em>"Obriši"</em></b> moguće je ukloniti izlaznu fakturu za UIO.</br>
            Dvoklikom na neko od polja u izvještaju otvara se opcija za ažuriranje, koje se potvrđuje 
            klikom na dugme <b><em>"Ažuriraj – UIO KIF."</em></b> </br>
            </br>
            Funkcija <b><em>"Generiši CSV"</em></b> omogućava kreiranje datoteke sa podacima iz KIF-a, 
            pri čemu se nakon potvrde otvara stranica sa opcijom preuzimanja. </br>
            </br>
            <b><em>"Obriši poreski period"</em></b> koja uklanja sve podatke za izabrani period, što je korisno u 
            slučaju grešaka ili potrebe za ponovnim unosom. </br>
            Na dugme <b><em>"Generiši KIF"</em></b> otvara se modalni dijalog u kojem se bira željeni period, 
            a odabirom mjeseca dobija se izvještaj faktura koje se trebaju generisati. 
            Klikom na dugme <b><em>"Generiši"</em></b> postupak se završava i fakture se uspješno generišu.
            ```
    }

    region download-overlay (
        name: Download Overlay
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="text-align:center;">
                    <div style="font-size:14px; color:#666; margin-bottom:8px;">Molimo sačekajte...</div>
                    <div style="font-weight:600; font-size:18px; margin-bottom:16px;">Generisanje vašeg fajla</div>
                    <div class="dl-spinner" style="width:36px; height:36px; margin:0 auto 14px; border:3px solid rgba(0,0,0,.1); border-top-color:#2271B1; border-radius:50%; animation:dlspin 1s linear infinite;"></div>
                    <div style="font-size:12px; color:#888;">Ne osvježavajte stranicu dok se ne završi.</div>
                </div>
                
                <style>
                    @keyframes dlspin { 
                    to { transform: rotate(360deg); } 
                    }
                </style>
                
                ```
        }
        layout {
            sequence: 60
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @inline-popup
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-size480x320
            ]
        }
        advanced {
            htmlDomId: download_popup
        }
    )

    region uio-kif (
        name: UIO - KIF
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region uio-kif-grid (
        name: UIO KIF - Grid
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    vrsta_sloga,
                    poreski_period,
                    redni_br,
                    tip_dokumenta,
                    broj_fakture,
                    to_date(datum_fakture, 'YYYY-MM-DD') AS datum_fakture,
                    naziv_kupca,
                    sjediste_kupca,
                    pdv_broj_kupca,
                    jib_broj_kupca,
                    
                    iznos_fakture,
                    iznos_fakture_interne,
                    iznos_fakture_izvozne,
                    iznos_ostale_bez_pdv,
                    iznos_osnovice_za_pdv,
                    iznos_izlaz_pdv_za_pdv,
                    iznos_osnovice_za_nepdv,
                    iznos_izlaz_pdv_za_nepdv,
                    iznos_pdv_32polje,
                    iznos_pdv_33polje,
                    iznos_pdv_34polje
                FROM
                    vw_uio_kif
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND poreski_period = to_char(:P81_PORESKI_PERIOD)
                ```
            pageItemsToSubmit: P81_PORESKI_PERIOD
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
            cssClasses: fin-grid
        }
        advanced {
            htmlDomId: kif_grid
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P81_PORESKI_PERIOD
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        toolbar {
            controls: actionsMenu
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
        }
        download {
            formats: [
                pdf
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    options.defaultGridViewOptions = {
                        reorderColumns:false,
                        hideEmptyFooter:true,
                        noDataIcon:"fa fa-404",
                        skipReadonlyCells:true,
                        rowsPerPage:25
                    }
                    return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 29499019906291743
        }

