        name: Tip dokumenta EXPRESSION
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @uio-kif-grid
            plsqlExpression: :TIP_DOKUMENTA >= 1 and :TIP_DOKUMENTA <= 9
        }
        error {
            errorMessage: #COLUMN_HEADER# mora biti u rasponu 01-09.
            associatedColumn: TIP_DOKUMENTA
        }
        serverSideCondition {
            whenButtonPressed: @save
            executionScope: allSubmittedRows
        }
    )

