    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                uio_pkg.delete_uio_kif (
                    p_id => :P81_DELETE_ID
                );
                
                :P81_DELETE_ID := null;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 29599370882573839
        }
        serverSideCondition {
            type: request=Value
            value: delete
        }
    )

    process delete-pp (
        name: Delete PP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                uio_pkg.delete_uio_kif (
                    p_ooj_id         => :APP_OOJ_ID,
                    p_poreski_period => :P81_PORESKI_PERIOD
                );
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 29599176405573837
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process update-uio-kif (
        name: Update UIO KIF
        type: executeCode
        editableRegion: @uio-kif-grid
        source {
            plsqlCode:
                ```plsql
                uio_pkg.update_uio_kif (
                    p_id                       => :ID,
                    p_ooj_id                   => :APP_OOJ_ID,
                    p_vrsta_sloga              => :VRSTA_SLOGA,
                    p_poreski_period           => :PORESKI_PERIOD,
                    p_redni_br                 => :REDNI_BR,
                    p_tip_dokumenta            => :TIP_DOKUMENTA,
                    p_broj_fakture             => :BROJ_FAKTURE,
                    p_datum_fakture            => :DATUM_FAKTURE,
                    p_naziv_kupca              => :NAZIV_KUPCA,
                    p_sjediste_kupca           => :SJEDISTE_KUPCA,
                    p_pdv_broj_kupca           => :PDV_BROJ_KUPCA,
                    p_jib_broj_kupca           => :JIB_BROJ_KUPCA,
                    p_iznos_fakture            => :IZNOS_FAKTURE,
                    p_iznos_fakture_interne    => :IZNOS_FAKTURE_INTERNE,
                    p_iznos_fakture_izvozne    => :IZNOS_FAKTURE_IZVOZNE,
                    p_iznos_ostale_bez_pdv     => :IZNOS_OSTALE_BEZ_PDV,
                    p_iznos_osnovice_za_pdv    => :IZNOS_OSNOVICE_ZA_PDV,
                    p_iznos_izlaz_pdv_za_pdv   => :IZNOS_IZLAZ_PDV_ZA_PDV,
                    p_iznos_osnovice_za_nepdv  => :IZNOS_OSNOVICE_ZA_NEPDV,
                    p_iznos_izlaz_pdv_za_nepdv => :IZNOS_IZLAZ_PDV_ZA_NEPDV,
                    p_iznos_pdv_32polje        => :IZNOS_PDV_32POLJE,
                    p_iznos_pdv_33polje        => :IZNOS_PDV_33POLJE,
                    p_iznos_pdv_34polje        => :IZNOS_PDV_34POLJE
                );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 29598626924573832
        }
        serverSideCondition {
            whenButtonPressed: @save
            executionScope: allSubmittedRows
        }
    )

    branch (
        name: Go To Page 85 - Download Only
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 85
                items: {
                    P85_DOWNLOAD_TOKEN: &P81_DOWNLOAD_TOKEN.
                    P85_PORESKI_PERIOD: &P81_PORESKI_PERIOD.
                    P85_TYPE: 2
                }
                clearCache: 85
                request: DOWNLOAD_UIO
            }
        }
        serverSideCondition {
            type: request=Value
            value: DOWNLOAD_UIO
        }
    )

)

