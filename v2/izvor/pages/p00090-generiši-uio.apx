page 90 (
    name: Generiši UIO
    alias: GENERIŠI-UIO
    title: Generiši UIO
    pageGroup: @uio-dokumentacija
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region lista-naloga-kif (
        name: Lista naloga / KIF
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    vrsta_naloga_naziv,
                    lpad(broj, 6, '0') as glavna_knjiga_broj,
                    datum_knjizenja,
                    opis
                
                FROM
                    vw_glavna_knjiga
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND godina = :APP_GODINA
                    AND trunc(datum_knjizenja, 'MM') = trunc(to_date(:P90_PP, 'YYMM'), 'MM')
                    AND lower(vrsta_naloga_sifra) IN ('if', 'ifs', 'kz', 'kzs', 'ko', 'kos', 'av', 'avs')
                    AND proknjizeno = 'Y'
                    AND kif_id NOT IN (
                        SELECT faktura_id
                        FROM uio_kif
                        WHERE 
                            ooj_id = :APP_OOJ_ID
                            AND faktura_id IS NOT null
                    )
                    AND kif_id IS NOT null
                ```
            pageItemsToSubmit: P90_PP
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P90_TIP
            value: KIF
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATUM_KNJIZENJA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Datum knjiženja
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column GLAVNA_KNJIGA_BROJ (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column OPIS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Opis
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column VRSTA_NALOGA_NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nalog
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: #VRSTA_NALOGA_NAZIV# / #GLAVNA_KNJIGA_BROJ#
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    region lista-naloga-kuf (
        name: Lista naloga / KUF
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    vrsta_naloga_naziv,
                    lpad(broj, 6, '0') as glavna_knjiga_broj,
                    datum_knjizenja,
                    opis
                
                FROM
                    vw_glavna_knjiga
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND godina = :APP_GODINA
                    AND trunc(datum_knjizenja, 'MM') = trunc(to_date(:P90_PP, 'YYMM'), 'MM')
                    AND lower(vrsta_naloga_sifra) IN ('uf', 'ufs')
                    AND proknjizeno = 'Y'
                    AND kuf_id NOT IN (
                        SELECT faktura_id
                        FROM uio_kuf
                        WHERE 
                            ooj_id = :APP_OOJ_ID
                            AND faktura_id IS NOT null
                    )
                    AND kuf_id IS NOT null
                ```
            pageItemsToSubmit: P90_PP
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P90_TIP
            value: KUF
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATUM_KNJIZENJA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Datum knjiženja
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column GLAVNA_KNJIGA_BROJ (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column OPIS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Opis
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column VRSTA_NALOGA_NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nalog
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: #VRSTA_NALOGA_NAZIV# / #GLAVNA_KNJIGA_BROJ#
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    pageItem P90_COUNT (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P90_PP (
        type: selectOne
        label {
            label: Poreski period
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @poreski-period-yymm
        }
        layout {
            sequence: 30
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P90_TIP (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button nalog-to-kif-uio (
        buttonName: NALOG_TO_KIF_UIO
        label: Generiši
        layout {
            sequence: 20
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-arrow-left-alt
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P90_TIP
            value: KIF
        }
    )

    button nalog-to-kuf-uio (
        buttonName: NALOG_TO_KUF_UIO
        label: Generiši
        layout {
            sequence: 10
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-arrow-right-alt
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P90_TIP
            value: KUF
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction poreski-period-change (
        name: Poreski period - Change
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P90_PP
        }

        action refresh-kif (
            name: Refresh - KIF
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-naloga-kif
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action refresh-kuf (
            name: Refresh - KUF
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-naloga-kuf
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process nalog-to-kif-uio (
        name: Nalog to KIF UIO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                glavna_knjiga_pkg.nalog_to_kif_uio (
                    p_ooj_id => :APP_OOJ_ID,
                    p_godina => :APP_GODINA,
                    p_pp     => to_date(:P90_PP, 'YYMM')
                ); 
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 157493255278763022
        }
        serverSideCondition {
            whenButtonPressed: @nalog-to-kif-uio
        }
    )

    process nalog-to-kuf-uio (
        name: Nalog to KUF UIO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                glavna_knjiga_pkg.nalog_to_kuf_uio (
                    p_ooj_id => :APP_OOJ_ID,
                    p_godina => :APP_GODINA,
                    p_pp     => to_date(:P90_PP, 'YYMM')
                ); 
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 157493123897763021
        }
        serverSideCondition {
            whenButtonPressed: @nalog-to-kuf-uio
        }
    )

    branch (
        name: Go To Page 81 - KIF
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 81
                items: {
                    P81_PORESKI_PERIOD: &P90_PP.
                }
                clearCache: 81
            }
        }
        serverSideCondition {
            whenButtonPressed: @nalog-to-kif-uio
        }
    )

    branch (
        name: Go To Page 83 - KUF
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 83
                items: {
                    P83_PORESKI_PERIOD: &P90_PP.
                }
                clearCache: 83
            }
        }
        serverSideCondition {
            whenButtonPressed: @nalog-to-kuf-uio
        }
    )

)

