page 451 (
    name: Blagajne
    alias: BLAGAJNE
    title: Blagajne
    pageGroup: @blagajna
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @blagajna-konfiguracija
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Prije početka rada sa <b><em>"Blagajnama"</em></b> potrebno je izvršiti povezivanje konta na koji će se 
            evidentirati sve poslovne promjene. Ukoliko postoji više blagajni, svaka od njih se mora 
            vezati na odgovarajući konto, a to je uobičajena praksa kada organizacija ima više 
            organizacionih jedinica kojima je potrebna posebna blagajna.</br>
            </br>
            Za unos nove blagajne koristi se dugme <b><em>"Novi unos"</em></b> nakon čega se otvara modalni 
            dijalog u kojem je potrebno unijeti naziv blagajne, odabrati konto na koji se 
            veže blagajna, te označiti da li se radi o blagajni ili deviznoj blagajni. </br>
            Proces se završava klikom na dugme <b><em>"Kreiraj"</em></b>.</br>
            ```
    }

    region blagajne (
        name: Blagajne
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region blagajne-report (
        name: Blagajne Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    naziv,
                    kontna_klasa_id,
                    tip,
                    valuta_id,
                    case 
                        when valid = 'Y' then
                            'u-color-5'
                        else
                            'u-color-9'
                    end as color_class,
                    valid
                FROM
                    blagajne
                WHERE
                    ooj_id = :APP_OOJ_ID
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column COLOR_CLASS (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 452
                    items: {
                        P452_ID: #ID#
                    }
                    clearCache: 452
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column KONTNA_KLASA_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Konto
            }
            lov {
                type: sharedComponent
                lov: @kontni-okvir-klase-ooj
            }
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Naziv
            }
            layout {
                sequence: 20
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column TIP (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Tip
            }
            lov {
                type: sharedComponent
                lov: @tip-blagajne
            }
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

        column VALID (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 90
            }
        )

        column VALUTA_ID (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Valuta
            }
            lov {
                type: sharedComponent
                lov: @sif-valute
            }
            layout {
                sequence: 50
            }
            sorting {
                defaultSequence: 1
                sortable: false
            }
        )

    )

    region search (
        name: Search
        type: smartFilters
        source {
            filteredRegion: @blagajne-report
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P451_SEARCH (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 10
            region: @blagajne
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 452
                clearCache: 452
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 2
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @blagajne-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-2 (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @blagajne-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @blagajne-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

