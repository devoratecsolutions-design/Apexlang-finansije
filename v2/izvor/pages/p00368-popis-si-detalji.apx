            icon: fa-clone
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Prepisati zaduženje u popisanu količinu za sve stavke kod kojih popisana količina nije unesena? Zatim ispravite samo stavke sa razlikom (serijski broj koji nije pronađen = 0).
            style: information
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P368_IZMJENJIV = 'Y'
        }
    )

    button save (
        buttonName: SAVE
        label: Snimi
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P368_IZMJENJIV = 'Y'
        }
    )

    button zakljucaj (
        buttonName: ZAKLJUCAJ
        label: Zaključaj popis
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-lock
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Zaključati popis? Gdje se popisane i knjigovodstvene količine ne slažu nastaju dokumenti Razlika inventure sitnog inventara u upotrebi - manjak (razduženje radnika) i - višak (zaduženje radnika), zaključeni i sa serijskim brojevima. Popis se poslije ne može mijenjati.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P368_IZMJENJIV = 'Y'
        }
    )

    process ucitaj (
        name: Učitavanje popisa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for p in (select * from vw_rm_popisi where id = :P368_ID and ooj_id = :APP_OOJ_ID) loop
                    :P368_NAZIV        := p.naziv;
                    :P368_DATUM        := to_char(p.datum, 'DD.MM.YYYY');
                    :P368_SKLADISTE    := 'Radnik: ' || p.radnik_naziv;
                    :P368_OPIS         := p.opis;
                    :P368_ZAKLJUCANO   := p.zakljucano;
                    :P368_STATUS_KLASA := case when p.zakljucano = 'Y' then 'zakljucena' else 'priprema' end;
                    :P368_STATUS_NAZIV := case when p.zakljucano = 'Y' then 'Zaključen' else 'Otvoren' end;
                    :P368_STATUS_IKONA := case when p.zakljucano = 'Y' then 'fa-lock' else 'fa-pencil' end;
                end loop;
                :P368_ADMIN        := case when apex_authorization.is_authorized('MAIN ADMIN') then 'Y' else 'N' end;
                :P368_RAZLOG       := rm_popis_pkg.razlog_zabrane(:P368_ID);
                :P368_IZMJENJIV    := rm_popis_pkg.izmjenjiv(:P368_ID);
                :P368_OTKLJ_RAZLOG := rm_popis_pkg.razlog_zabrane_otkljucavanja(:P368_ID, :P368_ADMIN);
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process snimi (
        name: Snimi zaglavlje
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    rm_popis_pkg.snimi_zaglavlje(p_id => :P368_ID, p_opis => :P368_OPIS);
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ', 'POPUNI', 'OSVJEZI') and :P368_IZMJENJIV = 'Y'
        }
    )

    process stavke-snimi (
        name: Stavke popisa - snimi redove
        type: executeCode
        editableRegion: @stavke
        source {
            plsqlCode:
                ```plsql
                begin
                    declare
                        l_id number := kuf_pkg.broj(:ID);
                    begin
                        if :APEX$ROW_STATUS = 'D' then
                            rm_popis_pkg.obrisi_stavku(p_id => l_id);
                        else
                            rm_popis_pkg.snimi_stavku(
                                p_id             => l_id,
                                p_popis_id       => :P368_ID,
                                p_stavka_id      => kuf_pkg.broj(:STAVKA_ID),
                                p_popis_kolicina => kuf_pkg.broj(:POPISANO),
                                p_opis           => :OPIS,
                                p_serijski_broj  => :SERIJSKI_BROJ
                            );
                            :ID := l_id;
                        end if;
                    end;
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Popis je snimljen.
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ', 'POPUNI', 'OSVJEZI') and :P368_IZMJENJIV = 'Y'
        }
    )

    process popuni (
        name: Prepiši knjigovodstveno stanje
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    :P368_PORUKA := rm_popis_pkg.popuni(:P368_ID);
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: &P368_PORUKA.
        }
        serverSideCondition {
            whenButtonPressed: @popuni
        }
    )

    process osvjezi (
        name: Osvježi knjigovodstveno stanje
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    :P368_PORUKA := rm_popis_pkg.osvjezi(:P368_ID);
