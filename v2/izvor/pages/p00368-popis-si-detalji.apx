    button delete (
        buttonName: DELETE
        label: Obriši popis
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Obrisati otvoren popis sa svim stavkama i unesenim količinama?
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P368_IZMJENJIV = 'Y'
        }
    )

    button otkljucaj (
        buttonName: OTKLJUCAJ
        label: Otključaj popis
        layout {
            sequence: 30
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
