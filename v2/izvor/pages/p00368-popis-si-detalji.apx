                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 32
        }
        successMessage {
            successMessage: &P368_PORUKA.
        }
        serverSideCondition {
            whenButtonPressed: @osvjezi
        }
    )

    process zakljucaj (
        name: Zaključaj popis
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    :P368_PORUKA := rm_popis_pkg.zakljucaj(:P368_ID);
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
