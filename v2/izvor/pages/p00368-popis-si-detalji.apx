                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Popis je obrisan.
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process close-dialog (
        name: Zatvori dijalog
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,ZATVORI
        }
    )

    branch (
        name: Ostani na popisu
        execution {
            sequence: 50
        }
        behavior {
            target: {
                page: 368
                items: {
                    P368_ID: &P368_ID.
                }
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,ZAKLJUCAJ,OTKLJUCAJ,POPUNI,OSVJEZI
        }
    )

)
