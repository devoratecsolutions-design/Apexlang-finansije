                        end if;
                end;
                ```
        }
        execution {
            sequence: 45
        }
        successMessage {
            successMessage: Popis je otključan - dokumenti razlike inventure (manjak / višak) su obrisani.
        }
        serverSideCondition {
            whenButtonPressed: @otkljucaj
        }
    )

    process ajax-artikl (
        name: ARTIKL_POPIS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_rad   number;
                    l_datum date;
                    l_art   number := kuf_pkg.broj(apex_application.g_x01);
                    l_json  varchar2(4000);
                begin
                    select radnik_id, trunc(datum) into l_rad, l_datum from popisi where id = :P368_ID and ooj_id = :APP_OOJ_ID;
                    select json_object('jm'  value a.jm_naziv,
                                       'knj' value case when a.prati_sb = 'Y' then 0
                                                        else rm_dokument_pkg.si_saldo(:APP_OOJ_ID, l_rad, a.id, null, l_datum, 'Y') end,
                                       'c'   value rm_dokument_pkg.si_cijena(:APP_OOJ_ID, l_rad, a.id))
                      into l_json
                      from vw_rm_artikli a
                     where a.id = l_art and a.ooj_id = :APP_OOJ_ID;
                    sys.htp.p(l_json);
                exception
                    when no_data_found then
                        sys.htp.p('{}');
                end;
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
    )

    process obrisi (
        name: Obriši popis
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    rm_popis_pkg.obrisi(p_id => :P368_ID);
                exception
                    when others then
