page 368 (
    name: Popis sitnog inventara - detalji
    alias: POPIS-SI-DETALJI
    title: Popis sitnog inventara u upotrebi
    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--xl
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            finRmPopis.init('rm_popis_stavke', 'P368');
            ```
    }
    security {
        authorizationScheme: @robno-materijalno-popis
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region popis-traka (
        name: Traka popisa
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="fin-docbar">
                  <span class="fin-docbar__no">&P368_NAZIV.</span>
                  <span class="fin-status fin-status--&P368_STATUS_KLASA."><span class="fa &P368_STATUS_IKONA." aria-hidden="true"></span>&P368_STATUS_NAZIV.</span>
                  <span class="fin-docbar__meta">Popis na dan &P368_DATUM.</span>
                  <span class="fin-docbar__meta">&P368_SKLADISTE.</span>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region zakljucan (
        name: Popis se ne može mijenjati
        type: staticContent
        source {
            htmlCode: &P368_RAZLOG.
        }
        layout {
            sequence: 7
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P368_IZMJENJIV = 'N'
        }
    )

    region dokumenti (
        name: Dokumenti iz popisa
        title: Dokumenti iz popisa (razlika inventure SI u upotrebi - manjak / višak)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT d.id,
                       d.naziv,
                       d.vrsta_naziv,
                       d.stavki,
                       to_char(d.iznos, 'FM999G999G999G990D00') AS iznos,
                       CASE WHEN d.status = 'Z' THEN 'zakljucena' ELSE 'priprema' END AS dok_status,
                       CASE WHEN d.status = 'Z' THEN 'Zaključen'
                            WHEN d.vrsta_sifra = 'RIV' THEN 'U pripremi - unesite cijene i zaključite'
                            ELSE 'U pripremi' END AS dok_status_naziv,
                       CASE WHEN d.status = 'Z' THEN 'fa-lock' ELSE 'fa-pencil' END AS dok_status_ikona,
                       apex_page.get_url(p_page => 331, p_items => 'P331_ID', p_values => d.id, p_clear_cache => 331) AS url
                FROM vw_rm_popis_dokumenti d
                WHERE d.popis_id = :P368_ID
                ORDER BY d.id
                ```
            pageItemsToSubmit: P368_ID
        }
        layout {
            sequence: 8
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: fin-list fin-popis-dok
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Zaduženje radnika odgovara popisanom stanju - dokumenti nisu kreirani.
        }
        advanced {
            htmlDomId: rm_popis_dok
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P368_ZAKLJUCANO = 'Y'
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Dokument
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                cssClasses: u-nowrap
            }
            link {
                target: {
                    type: url
                    url: #URL#
                }
                linkText: <span class="fin-doc"><span class="fin-doc__no">#NAZIV#</span><span class="fin-sub">#VRSTA_NAZIV#</span></span>
            }
            sorting {
                sortable: false
            }
        )

        column NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 300
            }
        )

        column VRSTA_NAZIV (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 310
            }
        )

        column STAVKI (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Artikala
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            columnFormatting {
                cssClasses: fin-num
            }
            sorting {
                sortable: false
            }
        )

        column IZNOS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Iznos
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            columnFormatting {
                cssClasses: fin-num fin-num--strong
            }
            sorting {
                sortable: false
            }
        )

        column DOK_STATUS (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 320
            }
        )

        column DOK_STATUS_NAZIV (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-status fin-status--#DOK_STATUS#"><span class="fa #DOK_STATUS_IKONA#" aria-hidden="true"></span>#DOK_STATUS_NAZIV#</span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column DOK_STATUS_IKONA (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 330
            }
        )

        column URL (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 340
            }
        )

    )

    region popis-detalji (
        name: Popis / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
        readOnly {
            type: expression
            plsqlExpression: :P368_IZMJENJIV = 'N'
        }
    )

    region zaglavlje (
        name: Popis
        title: Popis
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @popis-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region stavke-sekcija (
        name: Stavke
        title: Stavke popisa
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @popis-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region sazetak (
        name: Sažetak
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="fin-popis-sazetak" id="fin_popis_sazetak">
                  <span class="fin-chip"><b data-s="n">0</b> artikala</span>
                  <span class="fin-chip fin-chip--warning"><b data-s="np">0</b> nepopisano</span>
                  <span class="fin-chip fin-chip--success"><b data-s="v">0</b> višak</span>
                  <span class="fin-chip fin-chip--danger"><b data-s="m">0</b> manjak</span>
                </div>
                ```
        }
        layout {
            sequence: 10
            parentRegion: @stavke-sekcija
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region stavke (
        name: Stavke popisa - tabela
        title: Stavke popisa
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    s.id,
                    s.redni_broj,
                    s.stavka_id,
                    s.serijski_broj,
                    s.jm_naziv,
                    rtrim(to_char(s.knjigovodstveno, 'FM999999999990D999999'), '.,') AS knjigovodstveno,
                    rtrim(to_char(s.popisano, 'FM999999999990D999999'), '.,') AS popisano,
                    rtrim(to_char(s.razlika, 'FM999999999990D999999'), '.,') AS razlika,
                    CASE WHEN s.cijena = round(s.cijena, 2) THEN to_char(s.cijena, 'FM999G999G999G990D00')
                         ELSE rtrim(to_char(s.cijena, 'FM999G999G999G990D9999'), '0') END AS cijena,
                    s.vrijednost_razlike,
                    s.opis,
                    CASE WHEN s.popisano IS NULL THEN 'fin-raz'
                         WHEN s.razlika > 0 THEN 'fin-raz fin-raz--visak'
                         WHEN s.razlika < 0 THEN 'fin-raz fin-raz--manjak'
                         ELSE 'fin-raz fin-raz--ok' END AS razlika_klasa,
                    'fin-unos' AS unos_klasa
                FROM vw_rm_popis_stavke s
                WHERE s.popis_id = :P368_ID
                ORDER BY s.redni_broj, s.id
                ```
            pageItemsToSubmit: P368_ID
        }
        layout {
            sequence: 20
            parentRegion: @stavke-sekcija
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ig
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Popis nema stavki.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = "Dodaj pronađen artikal / serijski broj"; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("actions");
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: true, autoAddRecord: false };
                    if (options.editable) { options.editable.autoAddRow = false; }
                    return options;
                }
                ```
        }
        advanced {
            htmlDomId: rm_popis_stavke
            savedReportMappingIdentifier: 3680000000000001
        }
        readOnly {
            type: expression
            plsqlExpression: :P368_IZMJENJIV = 'N'
        }

