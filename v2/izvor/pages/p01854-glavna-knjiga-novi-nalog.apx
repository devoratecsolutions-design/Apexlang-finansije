    process sadržaj-naloga-gk (
        name: Sadržaj naloga GK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_ids SYS.ODCINUMBERLIST := SYS.ODCINUMBERLIST();
                BEGIN
                
                    FOR i IN 1 .. APEX_APPLICATION.G_F01.COUNT LOOP
                        l_ids.EXTEND;
                        l_ids(l_ids.COUNT) := TO_NUMBER(APEX_APPLICATION.G_F01(i));
                    END LOOP;
                
                    if :P1850_MODUL=1 then  --izvodi
                
                       accounting.sadrzaj_gk_pkg.izvodi_sgk(p_izvod_ids => l_ids);
                
                    elsif :P1850_MODUL=3 then  --ulazne fakture
                
                        accounting.sadrzaj_gk_pkg.uf_sgk(p_uf_ids => l_ids);
                
                    end if;
                END;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 274664901407677177
        }
        serverSideCondition {
            whenButtonPressed: @sadrzaj-gk
        }
    )

    branch (
        name: Redirect to Izvodi
        execution {
            sequence: 10
        }
