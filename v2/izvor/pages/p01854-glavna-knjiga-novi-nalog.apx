    region referentni-dokumenti (
        name: Referentni dokumenti
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from 
                (select izv.izvod_id as dok_id, izv.godina, izv.sifra_racuna as vrsta_dokumenta, izv.broj, izv.datum,izv.opis, izv.novo_stanje-izv.prethodno_stanje as promet, null as iznos_sa_pdv, null as iznos_bez_pdv, null pdv_indikator, null partner,  apex_item.checkbox(1,izv.izvod_id) as označi
                from accounting.vw_izvodi izv
                where izv.ooj_id=:APP_OOJ_ID
                and izv.proknjizen_v='N'
                and izv.zakljucan_v='Y'
                and izv.vrsta_naloga_id=:P1850_VRSTA_NALOGA
                and :P1850_MODUL=1
                union
                select k.kuf_id as dok_id,  k.godina, 'UF' as vrsta_dokumenta, k.broj, k.datum_fakture as datum,k.naziv_fakture as opis, k.iznos_sa_pdv as promet,k.iznos_sa_pdv, k.iznos_bez_pdv, k.pdv_indikator, k.partner_naziv as partner,  apex_item.checkbox(1,k.kuf_id) as označi
                from accounting.vw_kufovi k
                where k.ooj_id=:APP_OOJ_ID
                and NVL(k.status,'K')='Z'
                and k.vrsta_naloga_id=:P1850_VRSTA_NALOGA
                and :P1850_MODUL=3)
                order by dok_id
                ```
            pageItemsToSubmit: [
                P1850_MODUL
                P1850_VRSTA_NALOGA
            ]
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
