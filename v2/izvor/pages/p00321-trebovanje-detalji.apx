    process stavke-ig (
        name: Stavke IG
        type: executeCode
        editableRegion: @stavke-trebovanja-ig
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS = 'D' THEN -- DELETE
                    skladista_pkg.delete_trebovanje_stavka (
                        p_id => :ID
                    );
                
                ELSIF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN -- CREATE
                    skladista_pkg.insert_trebovanje_stavka(
                        p_trebovanje_id => :P321_ID,
                        p_stavka_id     => :STAVKA_ID,
                        p_kolicina      => :KOLICINA
                    );
                
                    RETURN;
                ELSIF :APEX$ROW_STATUS = 'U' THEN -- UPDATE
                    skladista_pkg.update_trebovanje_stavka (
                        p_id            => :ID,
                        p_trebovanje_id => :P321_ID,
                        p_stavka_id     => :STAVKA_ID,
                        p_kolicina      => :KOLICINA
                    );
                
                    RETURN;
                END IF;
                ```
