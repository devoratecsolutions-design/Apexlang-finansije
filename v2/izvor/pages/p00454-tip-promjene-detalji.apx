page 454 (
    name: Tip promjene / Detalji
    alias: TIP-PROMJENE-DETALJI
    title: Tip promjene / Detalji
    pageGroup: @blagajna
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region tip-promjene-detalji (
        name: Tip promjene / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P454_ID (
        type: hidden
        layout {
            sequence: 10
            region: @tip-promjene-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P454_KLIJENT (
        type: radioGroup
        label {
            label: Da li je klijent obavezno polje u dnevniku?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @tip-promjene-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
    )

    pageItem P454_KONTNA_KLASA_ID (
        type: selectOne
        label {
            label: Konto
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @kontni-okvir-klase-ooj
        }
        layout {
            sequence: 40
            region: @tip-promjene-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P454_NAZIV (
        type: textField
        label {
            label: Naziv
            alignment: left
        }
        layout {
            sequence: 30
            region: @tip-promjene-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P454_OJ (
        type: radioGroup
        label {
            label: Da li je organizaciona jedinica obavezno polje u dnevniku?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @tip-promjene-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
    )

    pageItem P454_OOJ_ID (
        type: hidden
        layout {
            sequence: 20
            region: @tip-promjene-detalji
            slot: regionBody
        }
    )

    pageItem P454_RADNIK (
        type: radioGroup
        label {
            label: Da li je radnik obavezno polje u dnevniku?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @tip-promjene-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
    )

    pageItem P454_VALID (
        type: radioGroup
        label {
            label: Aktivno
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @tip-promjene-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P454_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P454_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P454_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P454_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation klijent-not-null (
        name: Klijent NOT NULL
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P454_KLIJENT
        }
        error {
            errorMessage: #LABEL# Polje je obavezno za unos.
            associatedItem: @P454_KLIJENT
        }
    )

    validation kontna-klasa-not-null (
        name: Kontna klasa NOT NULL
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P454_KONTNA_KLASA_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P454_KONTNA_KLASA_ID
        }
    )

    validation naziv-not-null (
        name: Naziv NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P454_NAZIV
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P454_NAZIV
        }
    )

    validation oj-not-null (
        name: Oj NOT NULL
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P454_OJ
        }
        error {
            errorMessage: #LABEL# Polje je obavezno za unos.
            associatedItem: @P454_OJ
        }
    )

    validation radnik-not-null (
        name: Radnik NOT NULL
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P454_RADNIK
        }
        error {
            errorMessage: #LABEL# Polje je obavezno za unos.
            associatedItem: @P454_RADNIK
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 134870170979668523
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                blagajna_pkg.delete_blagajna_tip_promjene (
                    p_id => :P454_ID
                );
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 134887158150764903
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                blagajna_pkg.get_blagajna_tip_promjene (
                    p_id              => :P454_ID,
                    p_ooj_id          => :P454_OOJ_ID,
                    p_kontna_klasa_id => :P454_KONTNA_KLASA_ID,
                    p_naziv           => :P454_NAZIV,
                    p_radnik          => :P454_RADNIK,
                    p_klijent         => :P454_KLIJENT,
                    p_oj              => :P454_OJ,
                    p_valid           => :P454_VALID
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 129789297514618450
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P454_ID
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                blagajna_pkg.insert_blagajna_tip_promjene (
                    p_ooj_id          => :APP_OOJ_ID,
                    p_kontna_klasa_id => :P454_KONTNA_KLASA_ID,
                    p_naziv           => :P454_NAZIV,
                    p_radnik          => :P454_RADNIK,
                    p_klijent         => :P454_KLIJENT,
                    p_oj              => :P454_OJ
                );
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 134886943647764901
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                blagajna_pkg.update_blagajna_tip_promjene (
                    p_id              => :P454_ID,
                    p_ooj_id          => :APP_OOJ_ID,
                    p_kontna_klasa_id => :P454_KONTNA_KLASA_ID,
                    p_naziv           => :P454_NAZIV,
                    p_radnik          => :P454_RADNIK,
                    p_klijent         => :P454_KLIJENT,
                    p_oj              => :P454_OJ,
                    p_valid           => :P454_VALID
                );
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 134887063428764902
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

