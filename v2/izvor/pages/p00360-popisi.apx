page 360 (
    name: Popisi
    alias: POPISI
    title: Popisi
    pageGroup: @robno-materijalno
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @robno-materijalno-popis
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region popisi (
        name: Popisi
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    id,
                    naziv,
                    datum,
                    opis,
                
                    CASE
                        WHEN zakljucano = 'N' THEN
                            apex_page.get_url (
                                p_page   => 363,
                                p_items  => 'P363_ID',
                                p_values => id
                            )
                        ELSE
                            null
                    END as popis_link,
                    zakljucano
                FROM
                    popisi
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND skladiste_id = :A_SKLADISTE_ID
                ORDER BY
                    datum DESC, broj DESC
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: RETURN core.protokoli_pkg.check_brojac(:APP_OOJ_ID, 'pop', :APP_GODINA);
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATUM (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 20
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            layout {
                sequence: 0
            }
            link {
                target: {
                    page: 362
                    items: {
                        P362_ID: \#ID#\
                    }
                    action: resetPagination
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            advanced {
                cellWidth: 64
            }
        )

        column NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Naziv
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column OPIS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Opis
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column POPIS_LINK (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Popis
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if ?POPIS_LINK/}
                        <a href="#POPIS_LINK#">
                            <span class="t-Button t-Button--noLabel u-hot t-Button--iconLeft t-Button--small">
                                <span class="t-Icon t-Icon--left fa fa-signature"></span>
                            </span>
                        </a>
                    {endif/}
                    ```
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 92
            }
        )

        column ZAKLJUCANO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Zaključano
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if ZAKLJUCANO/}
                    <span class="t-Button t-Button--noLabel u-color-5 t-Button--iconLeft t-Button--small">
                        <span class="t-Icon t-Icon--left fa fa-check-circle-o"></span>
                    </span>
                    {else/}
                    <span class="t-Button t-Button--noLabel u-color-9 t-Button--iconLeft t-Button--small">
                        <span class="t-Icon t-Icon--left fa fa-circle-o"></span>
                    </span>
                    {endif/}
                    
                    ```
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            advanced {
                cellWidth: 92
            }
        )

    )

    region popisi-p360-skladiste-sifra (
        name: "Popisi [&P360_SKLADISTE_SIFRA.]"
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region potrebna-konfiguracija (
        name: Potrebna konfiguracija
        type: staticContent
        source {
            htmlCode: Neophodno je da konfigurišete formu numeracije dokumenata.
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: RETURN NOT core.protokoli_pkg.check_brojac(:APP_OOJ_ID, 'pop', :APP_GODINA);
        }
    )

    region pretraga (
        name: Pretraga
        type: smartFilters
        source {
            filteredRegion: @popisi
        }
        layout {
            sequence: 19
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: RETURN core.protokoli_pkg.check_brojac(:APP_OOJ_ID, 'pop', :APP_GODINA);
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P360_SEARCH (
            type: search
            label {
                label: Pretraga
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

    )

    pageItem P360_SKLADISTE_SIFRA (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    button configuration (
        buttonName: CONFIGURATION
        label: Numeracija dokumenata
        layout {
            sequence: 10
            region: @potrebna-konfiguracija
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-file-wrench
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 103
                clearCache: 103
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 10
            region: @popisi-p360-skladiste-sifra
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 361
                clearCache: 361
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: RETURN core.protokoli_pkg.check_brojac(:APP_OOJ_ID, 'pop', :APP_GODINA) AND :A_SKLADISTE_ID IS NOT null;
        }
    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @popisi
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-2 (
        name: Dialog Closed - Refresh 2
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @popisi
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @popisi
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p360-skladiste-sifra (
        itemName: P360_SKLADISTE_SIFRA
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    sifra
                FROM
                    skladista
                WHERE
                    id = :A_SKLADISTE_ID
                ```
        }
    )

)

