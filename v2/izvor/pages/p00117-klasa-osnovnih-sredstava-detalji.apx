                    p_naziv          => :P117_NAZIV,
                    p_procenat       => :P117_PROCENAT,
                    p_vijek_trajanja => :P117_VIJEK_TRAJANJA,
                    p_valid          => :P117_VALID,
                    p_row_version    => :P117_ROW_VERSION,
                    p_created        => :P117_CREATED,
                    p_created_by     => :P117_CREATED_BY,
                    p_updated        => :P117_UPDATED,
                    p_updated_by     => :P117_UPDATED_BY
                );
                
                if apex_collection.collection_exists ('KLASE_OS_KONTA') then
                    apex_collection.delete_collection ('KLASE_OS_KONTA');
                end if;
                
                apex_collection.create_collection_from_query (
                    p_collection_name => 'KLASE_OS_KONTA',
