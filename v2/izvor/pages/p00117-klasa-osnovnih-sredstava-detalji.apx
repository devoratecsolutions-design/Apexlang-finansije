    process save-stavke (
        name: Save stavke
        type: executeCode
        editableRegion: @konta-ig
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS = 'D' THEN
                    apex_collection.delete_member (
                        p_collection_name => 'KLASE_OS_KONTA',
                        p_seq             => :SEQ_ID
                    );
                    RETURN;
                
                ELSIF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN
                    apex_collection.add_member (
                        p_collection_name => 'KLASE_OS_KONTA',
                        p_c001            => :TRANSAKCIJA_ID,
                        p_c002            => :KONTNA_KLASA_ID
                    );
                
                    RETURN;
                
                ELSIF :APEX$ROW_STATUS = 'U' THEN
                    apex_collection.update_member (
                        p_collection_name => 'KLASE_OS_KONTA',
                        p_seq             => :SEQ_ID,
                        p_c001            => :TRANSAKCIJA_ID,
                        p_c002            => :KONTNA_KLASA_ID
                    );
                    RETURN;
                
                END IF;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 107977696022788247
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

