    dynamicAction setup-with-parent (
        name: Setup with Parent
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P117_PARENT_ID
        }
        serverSideCondition {
            type: itemIsNull
            item: P117_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    sif.acc_pkg.get_klasa_os (
                        p_id             => :P117_PARENT_ID,
                        p_sifra          => :P117_SIFRA,
                        p_naziv          => :P117_NAZIV,
                        p_procenat       => :P117_PROCENAT,
                        p_vijek_trajanja => :P117_VIJEK_TRAJANJA
                    );
                    
                    if apex_collection.collection_exists ('KLASE_OS_KONTA') then
                        apex_collection.delete_collection ('KLASE_OS_KONTA');
                    end if;
                    
                    apex_collection.create_collection_from_query (
                        p_collection_name => 'KLASE_OS_KONTA',
                        p_query => '
                    SELECT
                        transakcija_id,
                        kontna_klasa_id
                    FROM
                        sif.acc_klase_os_konta
                    WHERE
                        klasa_id = ' || :P117_PARENT_ID || '
                    ');
                    ```
                itemsToSubmit: [
                    P117_PARENT_ID
                    P117_SIFRA
                    P117_NAZIV
                    P117_PROCENAT
                    P117_VIJEK_TRAJANJA
                ]
                itemsToReturn: [
                    P117_SIFRA
                    P117_NAZIV
                    P117_PROCENAT
                    P117_VIJEK_TRAJANJA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @konta-ig
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

