page 82 (
    name: UIO KIF - Unos
    alias: UIO-KIF-UNOS
    title: UIO KIF - Unos
    pageGroup: @uio-dokumentacija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region faktura-wrapper (
        name: Faktura Wrapper
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @kif-unos
            slot: regionBody
        }
        appearance {
            template: @item-container
            templateOptions: [
                #DEFAULT#
                t-ItemContainer--alignStretch
            ]
        }
    )

    region kif-unos (
        name: KIF - Unos
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P82_BROJ_FAKTURE (
        type: textField
        label {
            label: Broj fakture
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 110
            region: @kif-unos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        help {
            inlineHelpText: Za objašnjenje klikni upitnik.
            helpText:
                ```html
                Ako je Tip dokumenta 01-03 – za broj fakture ili drugog dokumenta unosi se broj fakture <br>
                Ako je Tip dokumenta 04 - za broj fakture ili drugog dokumenta unosi se broj JCI <br>
                Ako je Tip dokumenta 05 - za broj fakture ili drugog dokumenta unosi se broj dokumenta koji se evidentira u poslovnim knjigama<br>
                Ako je Tip dokumenta 06, 07 i 09 - za broj fakture ili drugog dokumenta unosi se broj dokumenta koji se evidentira u poslovnim knjigama<br>
                Ako je Tip dokumenta 08 - za broj fakture ili dokumenta unosi se broj Obrasca I-DH-broj koji donator određuje
                
                ```
        }
    )

    pageItem P82_DATUM_FAKTURE (
        type: datePicker
        label {
            label: Datum fakture
            alignment: left
        }
        layout {
            sequence: 120
            region: @kif-unos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        help {
            inlineHelpText: Za objašnjenje klikni upitnik.
            helpText:
                ```html
                Ako je Tip dokumenta 01-03 – za datum fakture ili drugog dokumenta unosi se datum fakture <br>
                Ako je Tip dokumenta 04 - za datum fakture ili drugog dokumenta unosi se datum JCI <br>
                Ako je Tip dokumenta 05 - za datum fakture ili drugog dokumenta unosi se datum dokumenta koji se evidentira u poslovnim knjigama<br>
                Ako je Tip dokumenta 06, 07 i 09 - za datum fakture ili drugog dokumenta, unosi se datum dokumenta koji se evidentira u poslovnim knjigama<br>
                Ako je Tip dokumenta 08 - za datum fakture ili drugog dokumenta, unosi se datum naveden od primaoca donacije-kada je isporuka izvršena
                
                
                ```
        }
    )

    pageItem P82_DUMMY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @faktura-wrapper
            slot: item
        }
    )

    pageItem P82_FAKTURA_ID (
        type: selectOne
        label {
            label: Faktura
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv_fakture || ' - ' || klijent_naziv d,
                    id r
                FROM
                    vw_kif
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND id NOT IN (
                        SELECT faktura_id
                        FROM uio_kif
                        WHERE
                            ooj_id = :APP_OOJ_ID
                            and faktura_id is not null
                    )
                ORDER BY
                    faktura_broj ASC
                ```
        }
        layout {
            sequence: 10
            region: @faktura-wrapper
            slot: item
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            authorizationScheme: @fakture-kif
        }
    )

