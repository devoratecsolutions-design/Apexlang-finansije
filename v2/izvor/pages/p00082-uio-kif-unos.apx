    dynamicAction racunaj-polja (
        name: racunaj polja
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P82_IZNOS_FAKTURE
        }
        clientSideCondition {
            type: item!=value
            item: P82_KK
            value: Y
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    
                    v_osnovica number;
                    v_pdv number;
                    -- V_APP_PDV_BROJ varchar2(13);
                    begin
                    
                    v_pdv :=  :P82_IZNOS_FAKTURE*14.5299/100;
                    v_osnovica :=:P82_IZNOS_FAKTURE-v_pdv;
                    case when (:P82_PDV_BROJ_KUPCA is not null and :P82_PDV_BROJ_KUPCA <> '000000000000' and :P82_PDV_BROJ_KUPCA <> '0') then
                    :P82_IZNOS_PDV_32POLJE := null;
                    :P82_IZNOS_PDV_33POLJE := null;
                    :P82_IZNOS_PDV_34POLJE := null;
                    :P82_IZNOS_OSNOVICE_ZA_NEPDV :=null;
                    :P82_IZNOS_IZLAZ_PDV_ZA_NEPDV := null;
                    
                    :P82_IZNOS_OSNOVICE_ZA_PDV := to_char(v_osnovica,'fm99999990.00');
                    :P82_IZNOS_IZLAZ_PDV_ZA_PDV :=to_char(v_pdv,'fm99999990.00') ;
                    when (:P82_PDV_BROJ_KUPCA <> '000000000000' or :P82_PDV_BROJ_KUPCA is null or (:P82_KK !='Y' and (:P82_PDV_BROJ_KUPCA = '000000000000'or :P82_PDV_BROJ_KUPCA = '0') )) then
                    :P82_IZNOS_OSNOVICE_ZA_PDV := null;
                    :P82_IZNOS_IZLAZ_PDV_ZA_PDV := null;
                    
                    :P82_IZNOS_OSNOVICE_ZA_NEPDV := to_char(v_osnovica,'fm99999990.00');
                    :P82_IZNOS_IZLAZ_PDV_ZA_NEPDV :=to_char(v_pdv,'fm99999990.00') ;
                    --------------Koriguj logiku za federaciju i distrikt
                    --:P82_IZNOS_PDV_33POLJE := to_char(v_pdv,'fm99999990.00');
                        case when substr(:APP_PDV_BROJ,0,1) in (2,3) then
                        :P82_IZNOS_PDV_32POLJE := to_char(v_pdv,'fm99999990.00');
                        when substr(:APP_PDV_BROJ,0,1) in (4,5) then
                        :P82_IZNOS_PDV_33POLJE := to_char(v_pdv,'fm99999990.00');
                        when substr(:APP_PDV_BROJ,0,1) in (6,7) then
                        :P82_IZNOS_PDV_34POLJE := to_char(v_pdv,'fm99999990.00');
                        else
                        null;
                        end case;
                    end case;
                    end;
                    ```
                itemsToSubmit: [
                    P82_IZNOS_FAKTURE
                    " P82_IZNOS_FAKTURE_INTERNE"
                    " P82_IZNOS_FAKTURE_IZVOZNE"
                    " P82_IZNOS_OSTALE_BEZ_PDV"
                    " P82_IZNOS_OSNOVICE_ZA_PDV"
                    " P82_IZNOS_IZLAZ_PDV_ZA_PDV"
                    " P82_IZNOS_IZLAZ_PDV_ZA_NEPDV"
                    " P82_IZNOS_OSNOVICE_ZA_NEPDV"
                    " P82_IZNOS_PDV_32POLJE"
                    " P82_IZNOS_PDV_33POLJE"
                    " P82_IZNOS_PDV_34POLJE"
                ]
                itemsToReturn: [
                    P82_IZNOS_FAKTURE_INTERNE
                    " P82_IZNOS_FAKTURE_IZVOZNE"
                    " P82_IZNOS_OSTALE_BEZ_PDV"
                    " P82_IZNOS_OSNOVICE_ZA_PDV"
                    " P82_IZNOS_IZLAZ_PDV_ZA_PDV"
                    " P82_IZNOS_IZLAZ_PDV_ZA_NEPDV"
                    " P82_IZNOS_OSNOVICE_ZA_NEPDV"
