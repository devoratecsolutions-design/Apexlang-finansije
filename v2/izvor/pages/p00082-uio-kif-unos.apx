    validation poreski-period-not-null (
        name: Poreski period not null
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                
                if length(:P82_PORESKI_PERIOD) <>4 then
                        return 'Poreski period mora biti u formatu GGMM, npr. 2408';
                    elsif (substr(:P82_PORESKI_PERIOD,3,2)>12 or substr(:P82_PORESKI_PERIOD,3,2)<01) then
                        return 'Mjeseci moraju biti u rasponu od 01-12, npr. XX08';
                    elsif substr(:P82_PORESKI_PERIOD,1,2)>substr(:APP_GODINA,3,2) then
                        return 'Godina(prve dvije cifre) ne mogu biti veće od trenutno odabrane poreske godine, npr. '||substr(:APP_GODINA,3,2)||'XX';
                    elsif :P82_PORESKI_PERIOD is null then
                        return 'Polje Poreski period ne moze biti prazno';   
                end if;
                return null; 
                
                end;
                ```
        }
        error {
            associatedItem: @P82_PORESKI_PERIOD
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

