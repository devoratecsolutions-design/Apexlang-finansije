    dynamicAction get-kif-data (
        name: GET KIF DATA
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P82_FAKTURA_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_vrsta_fak varchar2(50);
                    begin
                    if(:P82_FAKTURA_ID is not null) then
                    finansije_pkg.get_kif (  
                        p_id                    => :P82_FAKTURA_ID,
                        p_klijent_id            => :P82_KLIJENT_ID,
                        p_naziv_fakture         => :P82_BROJ_FAKTURE,
                        p_iznos_fakture         => :P82_IZNOS_FAKTURE,
                        p_datum_fakture         => :P82_DATUM_FAKTURE,
                        p_UIO_TIP_DOKUMENTA_ID  => :P82_TIP_DOKUMENTA
                    );
                    select vrsta_Fakture_sifra into v_vrsta_fak from vw_kif
                    where id= :P82_FAKTURA_ID;
                        if(v_vrsta_fak in ('KO','KZ')) then
                            :P82_IZNOS_FAKTURE := -1*:P82_IZNOS_FAKTURE;
                        end if;
                    end if;
                    
                    end;
                    ```
                itemsToSubmit: [
                    P82_FAKTURA_ID
                    P82_KLIJENT_ID
                    P82_IZNOS_FAKTURE
                    P82_TIP_DOKUMENTA
                    P82_BROJ_FAKTURE
                    P82_DATUM_FAKTURE
                ]
                itemsToReturn: [
                    P82_BROJ_FAKTURE
                    P82_KLIJENT_ID
                    P82_IZNOS_FAKTURE
                    P82_DATUM_FAKTURE
                    P82_TIP_DOKUMENTA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction on-change-pp-set-rb (
        name: On change PP set RB
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P82_PORESKI_PERIOD
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P82_REDNI_BR := uio_pkg.get_uio_kif_redni_broj (
                        p_ooj_id         => :APP_OOJ_ID,
                        p_poreski_period => :P82_PORESKI_PERIOD
                    );
                    ```
                itemsToSubmit: [
                    P82_REDNI_BR
                    P82_PORESKI_PERIOD
                ]
                itemsToReturn: P82_REDNI_BR
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction on-tip-09-ostalo-set-values (
        name: on tip 09 ostalo set values
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P82_TIP_DOKUMENTA
        }
        clientSideCondition {
            type: item=value
            item: P82_TIP_DOKUMENTA
            value: 9
        }

        action setuj-isti-iznos-fakture-i-polje-ostale-bez-pdv (
            name: setuj isti iznos fakture i polje ostale bez pdv
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P82_IZNOS_OSTALE_BEZ_PDV := :P82_IZNOS_FAKTURE;
                    :P82_IZNOS_OSNOVICE_ZA_PDV :=null;
                    :P82_IZNOS_IZLAZ_PDV_ZA_PDV :=null;
                    :P82_IZNOS_IZLAZ_PDV_ZA_NEPDV := to_char(0,'fm99999990.00');
                    :P82_IZNOS_OSNOVICE_ZA_NEPDV := to_char(0,'fm99999990.00');
                    case when substr(:APP_PDV_BROJ,0,1) in (2,3) then
                        :P82_IZNOS_PDV_32POLJE := to_char(0,'fm99999990.00');
                        when substr(:APP_PDV_BROJ,0,1) in (4,5) then
                        :P82_IZNOS_PDV_33POLJE := to_char(0,'fm99999990.00');
                        when substr(:APP_PDV_BROJ,0,1) in (6,7) then
                        :P82_IZNOS_PDV_34POLJE := to_char(0,'fm99999990.00');
                        else
                        null;
                        end case;
                    
                    ```
                itemsToSubmit: [
                    P82_IZNOS_OSTALE_BEZ_PDV
                    P82_IZNOS_OSNOVICE_ZA_PDV
                    P82_IZNOS_IZLAZ_PDV_ZA_PDV
                    P82_IZNOS_PDV_32POLJE
                    P82_IZNOS_PDV_33POLJE
                    P82_IZNOS_PDV_34POLJE
                    P82_IZNOS_OSNOVICE_ZA_NEPDV
                    P82_IZNOS_IZLAZ_PDV_ZA_NEPDV
                ]
                itemsToReturn: [
