        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_mj varchar2(2);
                    v_god varchar2(2);
                    v_sa_pdv number;
                    v_pdv_in number;
                    v_app_pdv varchar2(12);
                    
                    begin
                        if(:P82_FAKTURA_ID is not null) then
                            select substr(datum_fakture,9,2),substr(datum_fakture,4,2),klijent_id into v_god,v_mj,:P82_KLIJENT_ID
                            from kif
                            where id = :P82_FAKTURA_ID;
                    
                            :P82_PORESKI_PERIOD := v_god||v_mj;
                    
                            SEC_PKG.get_klijent (
                                    p_id     => :P82_KLIJENT_ID,
                                    p_naziv  => :P82_NAZIV_KUPCA,
                                    p_sjediste => :P82_SJEDISTE_KUPCA,       
                                    p_pib    =>   :P82_PDV_BROJ_KUPCA,
                                    p_jib    =>   :P82_JIB_BROJ_KUPCA
                                );
                        end if;
                    end;
                    ```
