                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    
                    v_osnovica number;
                    v_pdv number;
                    V_APP_PDV_BROJ varchar2(13);
                    begin
                    select pib into V_APP_PDV_BROJ from core.ooj
                    where id = :APP_OOJ_ID;
                    --:P82_izvozna_carina :=to_char(:P82_IZNOS_FAKTURE*2.5,'fm99999990.00');
                    v_pdv :=  :P82_IZNOS_FAKTURE*14.5299/100;
