    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_uio_code VARCHAR2(2);
                BEGIN
                    SELECT
                        code
                    INTO
                        l_uio_code
                    FROM
                        sif.acc_uio_tipovi_dokumenata
                    WHERE
                        id = :P82_TIP_DOKUMENTA;
                    
                
                    uio_pkg.insert_uio_kif (
                        p_ooj_id                   => :APP_OOJ_ID,
                        p_faktura_id               => :P82_FAKTURA_ID,
                        p_vrsta_sloga              => 2,
                        p_poreski_period           => :P82_PORESKI_PERIOD,
                        p_redni_br                 => :P82_REDNI_BR,
                        p_tip_dokumenta            => l_uio_code,
                        p_broj_fakture             => :P82_BROJ_FAKTURE,
                        p_datum_fakture            => :P82_DATUM_FAKTURE,
                        p_naziv_kupca              => :P82_NAZIV_KUPCA,
                        p_sjediste_kupca           => :P82_SJEDISTE_KUPCA,
                        p_pdv_broj_kupca           => lpad(:P82_PDV_BROJ_KUPCA,12,0),
                        p_jib_broj_kupca           => lpad(:P82_JIB_BROJ_KUPCA,13,0),
                        p_iznos_fakture            => to_char(:P82_IZNOS_FAKTURE,'fm9999999990.00'),
                        p_iznos_fakture_interne    => to_char(nvl(:P82_IZNOS_FAKTURE_INTERNE,0),'fm9999999990.00'),
                        p_iznos_fakture_izvozne    => to_char(nvl(:P82_IZNOS_FAKTURE_IZVOZNE,0),'fm9999999990.00'),
                        p_iznos_ostale_bez_pdv     => to_char(nvl(:P82_IZNOS_OSTALE_BEZ_PDV,0),'fm9999999990.00'),
                        p_iznos_osnovice_za_pdv    => to_char(nvl(:P82_IZNOS_OSNOVICE_ZA_PDV,0),'fm9999999990.00'),
                        p_iznos_izlaz_pdv_za_pdv   => to_char(nvl(:P82_IZNOS_IZLAZ_PDV_ZA_PDV,0),'fm9999999990.00'),
                        p_iznos_osnovice_za_nepdv  => to_char(nvl(:P82_IZNOS_OSNOVICE_ZA_NEPDV,0),'fm9999999990.00'),
                        p_iznos_izlaz_pdv_za_nepdv => to_char(nvl(:P82_IZNOS_IZLAZ_PDV_ZA_NEPDV,0),'fm9999999990.00'),
                        p_iznos_pdv_32polje        => to_char(nvl(:P82_IZNOS_PDV_32POLJE,0),'fm9999999990.00'),
                        p_iznos_pdv_33polje        => to_char(nvl(:P82_IZNOS_PDV_33POLJE,0),'fm9999999990.00'),
                        p_iznos_pdv_34polje        => to_char(nvl(:P82_IZNOS_PDV_34POLJE,0),'fm9999999990.00')
                    );
                
                end;
                ```
        }
