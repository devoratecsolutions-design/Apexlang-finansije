page 1850 (
    name: Nalozi - Pregled
    alias: NALOZI
    title: Nalozi
    pageGroup: @glavna-knjiga
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: [
            #WORKSPACE_FILES#left-side-toggle#MIN#.js
            #WORKSPACE_FILES#jasper-server#MIN#.js
        ]
    }
    css {
        fileUrls: #WORKSPACE_FILES#left-side-toggle#MIN#.css
    }
    security {
        authorizationScheme: @glavna-knjiga-nalozi
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    help {
        helpText:
            ```html
            Na lijevoj strani prikazuje se lista parametara pomoću kojih je moguće filtrirati kreirane naloge. 
            Unos novog naloga za knjiženje vrši se klikom na dugme <b><em>"Novi unos"</em></b> gdje se otvara stranica 
            <b><em>"Glavna knjiga / Nalog"</em></b>. </br>
            </br>
            Na osnovu poslovne promjene koja se knjiži, potrebno je odrediti vrstu naloga. </br>
            Ručni nalozi glavne knjige imaju vrstu naloga GK. 
            Datum dokumenta je informativnog karaktera i predstavlja datum iskazan na dokumentu koji se unosi. </br>
            Datum knjiženja je datum pod kojim se nalog knjiži i koji je osnov za izvještavanje. </br>
            Polje <b><em>"Opis"</em></b> služi za unos broja ili opisa dokumenta.</br>
            </br>
            Nakon unosa podataka zaglavlja naloga, klikom na dugme <b><em>"Kreiraj"</em></b> formira se nalog. 
            Za formirani nalog potrebno je unijeti stavke naloga. </br>
            U stavkama naloga unose se konta, iznosi i ključevi knjiženja (dugovna ili potržna strana konta).  </br>
            U koliko konto ima subanalitiku (konta kupaca i dobaljača), neophodan je unos polja klijent. </br>
            </br>
            Za konta osnovnih sredstava potrebno je unijeti subanalitiku broj osnovnog sredstva. </br>
            Polja PDV indikator obavezna su za svaki konto. </br>
            Polje <b><em>"Organizaciona jedinica"</em></b> obavezna je kod unosa konta prihoda i rashoda, dok se polje 
            <b><em>"Radnik"</em></b> unosi za konta potraživanja i obaveza od zaposlenih. </br>
            Sistem kontroliše da zbir stavki naloga bude jednak nuli, jer bez toga nalog ne može biti proknjižen. </br>
            
            ```
    }

    region nalozi (
        name: Nalozi
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select gk.*, gk.nalog_id as štampa
                from vw_nalozi_gk gk
                where  gk.ooj_id = :APP_OOJ_ID
                and gk.datum_naloga between :P1850_DATUM_OD and :P1850_DATUM_DO
                and (:P1850_STORNO='-' or gk.stornirano=:P1850_STORNO)
                and (:P1850_MODUL is null or gk.modul_id=:P1850_MODUL)
                and (:P1850_VRSTA_NALOGA is null or gk.vrsta_naloga_id=:P1850_VRSTA_NALOGA)
                order by gk.datum_naloga desc, gk.broj desc
                
                ```
            pageItemsToSubmit: [
                P1850_DATUM_OD
                P1850_DATUM_DO
                P1850_MODUL
                P1850_STORNO
                P1850_VRSTA_NALOGA
            ]
        }
        layout {
            sequence: 10
            parentRegion: @pregled-naloga
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
                margin-top-lg
            ]
            cssClasses: [
                search-results
                fin-ir
            ]
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 100000
        }
        advanced {
            savedReportMappingIdentifier: 274064581222449610
        }

