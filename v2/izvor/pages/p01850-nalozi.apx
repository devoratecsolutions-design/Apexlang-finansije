    region pregled-naloga (
        name: Pregled  naloga
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P1850_DATUM_DO (
        type: datePicker
        label {
            label: Datum do
            alignment: left
        }
        layout {
            sequence: 30
            region: @pregled-naloga
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: [
                #DEFAULT#
                margin-top-sm
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
    )

    pageItem P1850_DATUM_OD (
        type: datePicker
        label {
            label: Datum od
            alignment: left
        }
        layout {
            sequence: 20
            region: @pregled-naloga
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: [
                #DEFAULT#
                margin-top-sm
            ]
            width: 30
