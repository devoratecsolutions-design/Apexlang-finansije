        }
    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 20
            slot: NEXT
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 202
                clearCache: 202
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create-2 (
        buttonName: CREATE_2
        label: Dokumenti na čekanju
        layout {
            sequence: 10
            region: @nalozi
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1854
                items: {
                    P1854_MODUL_ID: &P1850_MODUL.
                    P1854_VRSTA_NALOGA_ID: &P1850_VRSTA_NALOGA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button pretraga (
        buttonName: PRETRAGA
        label: <span title="Pretraži">     <img src="#APP_IMAGES#icons/search.png" alt="Obriši" style="width:32px; height:32px; vertical-align:middle;"> </span>
        layout {
            sequence: 10
            region: @pregled-naloga
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--link
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction pretraga (
        name: Pretraga
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @pretraga
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @nalozi
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction print (
        name: Print
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .nalog-print
        }
        config {
            buildOption: @feature-printing
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    generate_report(
                        filename = 'nalog.pdf',
                        report_path = '/reports/ACCOUNTING/glavna_knjiga/nalog_knjizenje', 
                        report_parameters = {
                            ID: $v("P1850_PRINT_ID")
                        },
                        new_tab = false
                    );
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            config {
                buildOption: @feature-printing
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).data('id')
            }
            affectedElements {
                selectionType: items
                items: P1850_PRINT_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-pom-value-m (
        name: Set pom value m
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P1850_MODUL
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :P1850_MODUL
                itemsToSubmit: P1850_MODUL
            }
            affectedElements {
                selectionType: items
                items: P1850_MODUL_POM
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-pom-value-vn (
        name: Set pom value vn
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P1850_VRSTA_NALOGA
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :P1850_VRSTA_NALOGA
                itemsToSubmit: P1850_VRSTA_NALOGA
            }
            affectedElements {
                selectionType: items
                items: P1850_VRSTA_NALOGA_POM
            }
            execution {
                sequence: 10
            }
        )

    )

)

