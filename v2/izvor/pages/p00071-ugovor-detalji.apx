    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                ugovori_pkg.get_ugovor (
                    p_id                 => :P71_ID,
                    p_ooj_id             => :P71_OOJ_ID,
                    p_klijent_id         => :P71_KLIJENT_ID,
                    p_valuta_id          => :P71_VALUTA_ID,
                    p_izvrsilac_narucioc => :P71_IZVRSILAC_NARUCIOC,
                    p_ugovor_start       => :P71_UGOVOR_START,
                    p_ugovor_end         => :P71_UGOVOR_END,
                    p_iznos              => :P71_IZNOS,
                    p_naziv              => :P71_NAZIV,
                    p_broj               => :P71_BROJ,
                    p_predmet            => :P71_PREDMET,
                    p_referenca          => :P71_REFERENCA,
                    p_referenca_id       => :P71_REFERENCA_ID,
                    p_oj_id              => :P71_OJ_ID,
                    p_interval_id        => :P71_INTERVAL_ID,
                    p_valid              => :P71_VALID
                );
                
                :P71_NAZIV_DISPLAY := :P71_NAZIV;
                
                ugovori_pkg.get_ugovor_dodatno (
                    p_id                    => :P71_ID,
                    p_vrsta_ugovora_id      => :P71_VRSTA_UGOVORA_ID,
                    p_status                => :P71_STATUS,
                    p_status_naziv          => :P71_STATUS_NAZIV,
                    p_kurs                  => :P71_KURS,
                    p_iznos_km              => :P71_IZNOS_KM,
                    p_dan_dospijeca         => :P71_DAN_DOSPIJECA,
                    p_otkazni_rok_dana      => :P71_OTKAZNI_ROK_DANA,
                    p_automatsko_produzenje => :P71_AUTOMATSKO_PRODUZENJE,
                    p_produzenje_mjeseci    => :P71_PRODUZENJE_MJESECI,
                    p_aneks_broj            => :P71_ANEKS_BROJ,
                    p_broj_stavki           => :P71_BROJ_STAVKI
                );
                
                :P71_EDITABLE := ugovori_pkg.is_ugovor_editable_yn(:P71_ID);
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 28516469463706321
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_ID
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_ugovor_id NUMBER;
                BEGIN
                    IF :P71_REFERENCA = 'N' THEN
                        :P71_REFERENCA_ID := null;
                    END IF;
                
                    l_ugovor_id := ugovori_pkg.insert_ugovor (
                        p_ooj_id                => :APP_OOJ_ID,
                        p_klijent_id            => :P71_KLIJENT_ID,
                        p_valuta_id             => :P71_VALUTA_ID,
                        p_izvrsilac_narucioc    => :P71_IZVRSILAC_NARUCIOC,
                        p_ugovor_start          => :P71_UGOVOR_START,
                        p_ugovor_end            => :P71_UGOVOR_END,
                        p_iznos                 => :P71_IZNOS,
                        p_naziv                 => :P71_NAZIV,
                        p_broj                  => :P71_BROJ,
                        p_predmet               => :P71_PREDMET,
                        p_referenca             => :P71_REFERENCA,
                        p_referenca_id          => :P71_REFERENCA_ID,
                        p_oj_id                 => :P71_OJ_ID,
                        p_interval_id           => :P71_INTERVAL_ID,
                        p_vrsta_ugovora_id      => :P71_VRSTA_UGOVORA_ID,
                        p_status                => 'P',
                        p_kurs                  => :P71_KURS,
                        p_dan_dospijeca         => :P71_DAN_DOSPIJECA,
                        p_otkazni_rok_dana      => :P71_OTKAZNI_ROK_DANA,
                        p_automatsko_produzenje => :P71_AUTOMATSKO_PRODUZENJE,
                        p_produzenje_mjeseci    => :P71_PRODUZENJE_MJESECI,
                        p_godina                => :APP_GODINA
                    );
                
                    ugovori_pkg.insert_ugovor_dokumenta (
                        p_ugovor_id => l_ugovor_id,
                        p_dokumenta => :P71_DOKUMENTA
                    );
                
                    IF :P71_REFERENCA = 'N' THEN
                        core.protokoli_pkg.update_brojac (
                            p_ooj_id             => :APP_OOJ_ID,
                            p_vrsta_naloga_sifra => 'ug',
                            p_godina             => :APP_GODINA,
                            p_value              => 1
                        );
                    END IF;
                END;
                
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 28516672648706323
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process pripremi-aneks (
        name: Pripremi aneks
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_osnovni NUMBER := :P71_REFERENCA_ID;
                    l_izvor   NUMBER := ugovori_pkg.get_posljednja_verzija(:P71_REFERENCA_ID);
                    l_naziv   VARCHAR2(255);
                    l_broj    VARCHAR2(50);
                    l_ref     VARCHAR2(1);
                    l_ref_id  NUMBER;
                    l_valid   VARCHAR2(1);
                BEGIN
                    -- Puni formu podacima posljednje zaključene verzije. Razlog: aneks nastaje kao kopija važećih uslova.
                    ugovori_pkg.get_ugovor (
                        p_id                 => l_izvor,
                        p_ooj_id             => :P71_OOJ_ID,
                        p_klijent_id         => :P71_KLIJENT_ID,
                        p_valuta_id          => :P71_VALUTA_ID,
                        p_izvrsilac_narucioc => :P71_IZVRSILAC_NARUCIOC,
                        p_ugovor_start       => :P71_UGOVOR_START,
                        p_ugovor_end         => :P71_UGOVOR_END,
                        p_iznos              => :P71_IZNOS,
                        p_naziv              => l_naziv,
                        p_broj               => l_broj,
                        p_predmet            => :P71_PREDMET,
                        p_referenca          => l_ref,
                        p_referenca_id       => l_ref_id,
                        p_oj_id              => :P71_OJ_ID,
                        p_interval_id        => :P71_INTERVAL_ID,
                        p_valid              => l_valid
                    );
                
                    ugovori_pkg.get_ugovor_dodatno (
                        p_id                    => l_izvor,
                        p_vrsta_ugovora_id      => :P71_VRSTA_UGOVORA_ID,
                        p_status                => :P71_STATUS,
                        p_status_naziv          => :P71_STATUS_NAZIV,
                        p_kurs                  => :P71_KURS,
                        p_iznos_km              => :P71_IZNOS_KM,
                        p_dan_dospijeca         => :P71_DAN_DOSPIJECA,
                        p_otkazni_rok_dana      => :P71_OTKAZNI_ROK_DANA,
                        p_automatsko_produzenje => :P71_AUTOMATSKO_PRODUZENJE,
                        p_produzenje_mjeseci    => :P71_PRODUZENJE_MJESECI,
                        p_aneks_broj            => :P71_ANEKS_BROJ,
                        p_broj_stavki           => :P71_BROJ_STAVKI
                    );
                
                    -- Računa kurs na dan početka kad ga prethodna verzija nema.
                    -- Razlog: ugovori napravljeni prije izmjena nemaju upisan kurs, pa bi forma aneksa ostala bez njega.
                    --         Valuta i datum se čitaju iz baze, a ne sa forme, da ne zavisi od formata datuma.
                    IF :P71_KURS IS NULL THEN
                        SELECT ugovori_pkg.get_kurs(p_valuta_id => valuta_id, p_ooj_id => ooj_id, p_datum => ugovor_start)
                        INTO :P71_KURS
                        FROM ugovori
                        WHERE id = l_izvor;
                    END IF;
                
                    -- Postavlja oznake aneksa i računa njegov naziv i broj.
                    :P71_REFERENCA    := 'Y';
                    :P71_REFERENCA_ID := l_osnovni;
                    :P71_STATUS       := 'P';
                    :P71_EDITABLE     := 'Y';
                
                    ugovori_pkg.get_referenca (
                        p_ooj_id       => :APP_OOJ_ID,
                        p_referenca_id => l_osnovni,
                        p_godina       => :APP_GODINA,
                        p_naziv        => :P71_NAZIV,
                        p_broj         => :P71_BROJ
                    );
                END;
                
                ```
        }
