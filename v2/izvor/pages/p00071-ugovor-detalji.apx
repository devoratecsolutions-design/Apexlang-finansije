page 71 (
    name: Ugovor / Detalji
    alias: UGOVOR-DETALJI
    title: Ugovor / Detalji
    pageGroup: @ugovori
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region dokumenta (
        name: Dokumenta
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region klijent-wrapper (
        name: Klijent Wrapper
        type: staticContent
        layout {
            sequence: 90
            parentRegion: @ugovor-detalji
            slot: regionBody
            columnSpan: 8
        }
        appearance {
            template: @item-container
            templateOptions: [
                #DEFAULT#
                t-ItemContainer--alignStretch
            ]
        }
        readOnly {
            type: expression
            plsqlExpression: :P71_EDITABLE = 'N'
        }
    )

    region stavke-ugovora (
        name: Stavke ugovora
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    redni_broj,
                    stavka_sifra || ' - ' || stavka_naziv AS stavka,
                    opis,
                    kolicina,
                    jm_naziv,
                    cijena,
                    rabat,
                    iznos,
                    valuta_sifra
                FROM
                    vw_ugovor_stavke
                WHERE
                    ugovor_id = :P71_ID
                ORDER BY
                    redni_broj
                
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_ID
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CIJENA (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Cijena
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            link {
                target: {
                    page: 75
                    items: {
                        P75_ID: #ID#
                        P75_UGOVOR_ID: &P71_ID.
                    }
                    clearCache: 75
                }
                linkText: <img  src="#APP_FILES#icons/pencil.png" class="apex-edit-view"   style="height:22px !important; width:22px !important" alt="" >
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :P71_EDITABLE = 'Y'
            }
        )

        column IZNOS (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Iznos
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column JM_NAZIV (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Jedinica mjere
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column KOLICINA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Količina
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column OPIS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Opis
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column RABAT (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Rabat %
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column REDNI_BROJ (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Redni Broj
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column STAVKA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Stavka
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column VALUTA_SIFRA (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Valuta
            }
            layout {
                sequence: 100
            }
            sorting {
                sortable: false
            }
        )

    )

    region ugovor-detalji (
        name: Ugovor / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            plsqlExpression: :P71_EDITABLE = 'N'
        }
    )

    pageItem P71_ANEKS_BROJ (
        type: hidden
        layout {
            sequence: 260
            region: @ugovor-detalji
            slot: regionBody
        }
    )

    pageItem P71_AUTOMATSKO_PRODUZENJE (
        type: switch
        label {
            label: Automatsko produženje
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Da
            offValue: N
            offLabel: Ne
        }
        layout {
            sequence: 290
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P71_BROJ (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @ugovor-detalji
            slot: regionBody
        }
    )

    pageItem P71_BROJ_STAVKI (
        type: hidden
        layout {
            sequence: 250
            region: @ugovor-detalji
            slot: regionBody
        }
    )

    pageItem P71_DAN_DOSPIJECA (
        type: numberField
        label {
            label: Dan dospijeća
            alignment: left
        }
        settings {
            minValue: 1
            maxValue: 31
        }
        layout {
            sequence: 270
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P71_DOKUMENTA (
        type: fileUpload
        label {
            label: Dokumentacija
            alignment: left
        }
        display {
            displayAs: blockDropzone
        }
        storage {
            type: appTempFiles
            allowMultipleFiles: true
        }
        layout {
            sequence: 10
            region: @dokumenta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P71_EDITABLE (
        type: hidden
        layout {
            sequence: 240
            region: @ugovor-detalji
            slot: regionBody
        }
        default {
            type: static
            staticValue: Y
        }
    )

    pageItem P71_ID (
        type: hidden
        layout {
            sequence: 10
            region: @ugovor-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P71_INTERVAL_ID (
        type: selectOne
        label {
            label: Interval
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @sif-intervali
        }
        layout {
            sequence: 190
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P71_IZNOS (
        type: textField
        label {
            label: Iznos
            alignment: left
        }
        layout {
            sequence: 150
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 32
        }
        validation {
            maxLength: 255
        }
        readOnly {
            type: expression
            plsqlExpression: to_number(nvl(:P71_BROJ_STAVKI, '0')) > 0
        }
        help {
            helpText: Kad ugovor ima stavke, iznos je njihov zbir.
        }
    )

    pageItem P71_IZNOS_KM (
        type: displayOnly
        label {
            label: Iznos u KM
            alignment: left
        }
        layout {
            sequence: 160
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_ID
        }
    )

    pageItem P71_IZVRSILAC_NARUCIOC (
        type: radioGroup
        label {
            label: Da li je klijent izvršilac / naručioc
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @izvrsilac-narucioc
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
    )

    pageItem P71_KLIJENT_ID (
        type: selectOne
        label {
            label: Klijent
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        messages {
            noDataFoundMessage: Nema pronađenih podataka.
        }
        lov {
            type: sharedComponent
            lov: @sec-klijenti
        }
        layout {
            sequence: 10
            region: @klijent-wrapper
            slot: item
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P71_KURS (
        type: numberField
        label {
            label: Kurs na dan početka
            alignment: left
        }
        layout {
            sequence: 170
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P71_NAZIV (
        type: textField
        label {
            label: Naziv ugovora
            alignment: left
        }
        layout {
            sequence: 70
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            cssClasses: apex_disabled
            width: 30
        }
        serverSideCondition {
            type: itemIsNull
            item: P71_ID
        }
    )

    pageItem P71_NAZIV_DISPLAY (
        type: displayOnly
        label {
            label: Naziv ugovora
            alignment: left
        }
        layout {
            sequence: 80
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_ID
        }
    )

    pageItem P71_OJ_ID (
        type: selectOne
        label {
            label: Organizaciona jedinica
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @oj
        }
        layout {
            sequence: 100
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P71_OOJ_ID (
        type: hidden
        layout {
            sequence: 20
            region: @ugovor-detalji
            slot: regionBody
        }
    )

    pageItem P71_OTKAZNI_ROK_DANA (
        type: numberField
        label {
            label: Otkazni rok (dana)
            alignment: left
        }
        settings {
            minValue: 0
        }
        layout {
            sequence: 280
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P71_PREDMET (
        type: textField
        label {
            label: Predmet
            alignment: left
        }
        layout {
            sequence: 120
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 4000
        }
    )

    pageItem P71_PRODUZENJE_MJESECI (
        type: numberField
        label {
            label: Produženje (mjeseci)
            alignment: left
        }
        settings {
            minValue: 1
        }
        layout {
            sequence: 300
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P71_REFERENCA (
        type: radioGroup
        label {
            label: Ugovor je referenca na drugi ugovor
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsNull
            item: P71_ID
        }
    )

    pageItem P71_REFERENCA_ID (
        type: selectOne
        label {
            label: Referenca
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv AS d,
                    id AS r
                FROM
                    ugovori
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND referenca = 'N'
                    AND valid = 'Y'
                    AND status = 'Z'
                ```
        }
        layout {
            sequence: 60
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNull
            item: P71_ID
        }
    )

    pageItem P71_STATUS (
        type: hidden
        layout {
            sequence: 220
            region: @ugovor-detalji
            slot: regionBody
        }
    )

    pageItem P71_STATUS_NAZIV (
        type: displayOnly
        label {
            label: Status
            alignment: left
        }
        layout {
            sequence: 230
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_ID
        }
    )

    pageItem P71_UGOVOR_END (
        type: datePicker
        label {
            label: Kraj ugovora
            alignment: left
        }
        settings {
            minDate: item
            minItem: P71_UGOVOR_START
        }
        layout {
            sequence: 140
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P71_UGOVOR_START (
        type: datePicker
        label {
            label: Početak ugovora
            alignment: left
        }
        layout {
            sequence: 130
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P71_VALID (
        type: radioGroup
        label {
            label: Aktivno
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 210
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P71_ID
        }
    )

    pageItem P71_VALUTA_ID (
        type: selectOne
        label {
            label: Valuta
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @sif-valute
        }
        layout {
            sequence: 180
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P71_VRSTA_UGOVORA_ID (
        type: selectOne
        label {
            label: Vrsta ugovora
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @vrste-ugovora
        }
        layout {
            sequence: 40
            region: @ugovor-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 70
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P71_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_ID IS NOT NULL AND :P71_EDITABLE = 'Y'
        }
    )

    button dodaj-stavku_1 (
        buttonName: DODAJ_STAVKU
        label: Dodaj Stavku
        layout {
            sequence: 10
            region: @stavke-ugovora
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 75
                items: {
                    P75_UGOVOR_ID: &P71_ID.
                }
                clearCache: 75
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_EDITABLE = 'Y'
        }
    )

    button new-client (
        buttonName: NEW_CLIENT
        label: Novi klijent
        layout {
            sequence: 10
            region: @klijent-wrapper
            slot: buttonEnd
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-user-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_EDITABLE = 'Y'
        }
    )

    button raskini (
        buttonName: RASKINI
        label: Raskini ugovor
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-times-square-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
            requiresConfirmation: true
        }
        confirmation {
            message: Ugovor i svi njegovi aneksi biće označeni kao raskinuti.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_STATUS = 'Z' AND :P71_REFERENCA_ID IS NULL
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
