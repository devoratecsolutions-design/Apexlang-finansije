            slot: body
        }
        appearance {
            template: @item-container
            templateOptions: [
                #DEFAULT#
                t-ItemContainer--alignStretch
            ]
        }
    )

    region kif (
        name: KIF
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv_fakture,
                    klijent_naziv,
                    datum_fakture,
                    datum_valute,
                    iznos_fakture,
                    pdv,
                    iznos_fakture_nopdv
                FROM
                    vw_kif
                WHERE
                    glavna_knjiga_id = :P201_ID
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-expanded
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
