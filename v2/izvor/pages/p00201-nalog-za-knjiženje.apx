    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                
                v_pom number;
                
                begin
                
                
                        glavna_knjiga_pkg.get_glavna_knjiga (
                            p_id                 => :P201_ID,
                            p_proknjizeno        => :P201_NALOG_PROKNJIZEN,
                            p_stornirano         => :P201_NALOG_STORNIRAN,
                            p_vrsta_naloga_id    => :P201_VRSTA_NALOGA_ID,
                            p_vrsta_naloga_sifra => :P201_VRSTA_NALOGA_SIFRA
                        );
                
                        :P201_NALOG_ID := :P201_ID;
                
                        SELECT
                            count(*)
                        INTO
                            :P201_OS_COUNT
                        FROM
                            glavna_knjiga_stavke
                        WHERE
                            glavna_knjiga_id = :P201_ID
                            AND osnovno_sredstvo_id IS NOT null;
                
                    
                        select count(*)
                        into v_pom 
                        from (select ki.id from kif ki where ki.glavna_knjiga_id=:P201_ID
                             union all
                             select ku.id from kuf ku where ku.glavna_knjiga_id=:P201_ID);
                
                        if v_pom>0 then 
                
                            select modul, id, dokument,opis, datum_valute, datum_fakture
                            into :P201_MODUL, :P201_DOKUMENT_ID, :P201_DOKUMENT, :P201_OPIS_DOKUMENTA, :P201_DATUM_DOSPJECA, :P201_DATUM_DOKUMENTA
                            from (  select 4 as modul, ki.id, 'KIF/'||ki.faktura_broj||'/'||ki.godina||'-'||vf.sifra as dokument, ki.naziv_fakture as opis,ki.datum_valute, ki.datum_fakture 
                                    from  accounting.kif ki
                                    join sif.acc_vrste_faktura vf on vf.id=ki.vrsta_fakture_id
                                    where ki.ooj_id=:APP_OOJ_ID
                                    and  ki.glavna_knjiga_id=:P201_ID
                                    union all
                                    select 3 as modul, ku.id, 'KUF/'||ku.broj||'/'||extract(year from ku.datum_fakture) as dokument, ku.naziv_fakture as opis, ku.datum_valute,ku.datum_fakture 
                                    from kuf ku 
                                    where ku.ooj_id=:APP_OOJ_ID
                                    and  ku.glavna_knjiga_id=:P201_ID);
                
                
                
                        else 
                
                            select 2, gk.id, 'Glavna knjiga-'||sn.sifra||'/'||gk.broj||gk.godina, gk.opis, gk.datum_knjizenja, gk.datum_knjizenja 
                            into :P201_MODUL, :P201_DOKUMENT_ID,:P201_DOKUMENT, :P201_OPIS_DOKUMENTA, :P201_DATUM_DOSPJECA, :P201_DATUM_DOKUMENTA
                            from accounting.glavna_knjiga gk
                            join sif.sif_vrste_naloga sn on gk.vrsta_naloga_id=sn.id
                            where gk.id=:P201_NALOG_ID;
                
                        end if;
                
                             
                    
                
                
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 46175286923763408
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P201_ID
        }
    )

