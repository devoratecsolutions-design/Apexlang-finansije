        column PDV_INDIKATOR_ID (
            type: selectList
            heading {
                heading: PDV indikator
            }
            lov {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    IF :P201_VRSTA_NALOGA_SIFRA IN ('if', 'ifs', 'av', 'avs', 'ko', 'kos', 'kz', 'kzs', 'in', 'ins') THEN
                        RETURN 'SELECT sifra || '' - '' || naziv AS d, id AS r FROM sif.acc_pdv_indikatori WHERE ui IN (''I'', ''O'') ORDER BY sifra';
                    ELSE
                        RETURN 'SELECT sifra || '' - '' || naziv AS d, id AS r FROM sif.acc_pdv_indikatori WHERE ui IN (''U'', ''O'') ORDER BY sifra';
                    END IF;
                    ```
                displayExtraValues: false
                displayNullValue: false
