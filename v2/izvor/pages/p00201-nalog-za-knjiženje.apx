    dynamicAction sum-total (
        name: Sum total
        execution {
            sequence: 100
        }
        when {
            selectionType: columns
            interactiveGrid: @stavke-konta-grid-neknjizeno
            columns: IZNOS
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    let ig$ = apex.region("StavkeIG").widget();
                    let model = ig$.interactiveGrid("getViews", "grid").model;
                    let total = 0;
                    let column_key = model.getFieldKey("IZNOS");
                    
                    /**
                     * Parses a number from a formatted string produced by Oracle format masks
                     * like 999G999G999G999G990D00 (handles both European and US NLS settings).
                     * G = thousands separator (can be '.' or ',')
                     * D = decimal separator  (can be ',' or '.')
                     */
                    function parseOracleFormattedNumber(val) {
                        // Already a valid number (raw value from model)
                        if (typeof val === "number") return val;
                    
                        // Null, undefined or empty string
                        if (val === null || val === undefined || val === "") return NaN;
                    
                        let str = String(val).trim();
                    
                        // Remove any non-numeric characters except digits, dots, commas, minus sign
                        str = str.replace(/[^\d.,-]/g, "");
                    
                        if (str === "" || str === "-") return NaN;
                    
                        const lastComma = str.lastIndexOf(",");
                        const lastDot   = str.lastIndexOf(".");
                    
                        if (lastComma > lastDot) {
                            // European NLS: dot = thousands (G), comma = decimal (D)
                            // e.g., "1.234.567,89" -> "1234567.89"
                            str = str.replace(/\./g, "").replace(",", ".");
                        } else if (lastDot > lastComma) {
                            // US/Standard NLS: comma = thousands (G), dot = decimal (D)
                            // e.g., "1,234,567.89" -> "1234567.89"
                            str = str.replace(/,/g, "");
                        } else {
                            // No separators, or only digits (e.g., "12345")
                            str = str.replace(/,/g, "");
                        }
                    
                        return parseFloat(str);
                    }
                    
                    model.forEach(function(record) {
                        const rawValue = record[column_key];
                        const value    = parseOracleFormattedNumber(rawValue);
                    
                        console.log("Raw:", rawValue, "-> Parsed:", value);
                    
                        if (!isNaN(value)) {
                            total += value;
                            console.log("Running Total:", total);
                        }
                    });
                    
                    const formattedTotal = total.toLocaleString("en-US", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                    
                    console.log("Final Total:", total);
                    apex.item("P201_TOTAL").setValue("Suma: " + formattedTotal);
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P201_TOTAL
            }
            execution {
                sequence: 40
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
