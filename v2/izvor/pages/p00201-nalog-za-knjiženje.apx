    process save-stavke-ig (
        name: Save stavke IG
        type: executeCode
        editableRegion: @stavke-konta-grid-neknjizeno
        source {
            plsqlCode:
                ```plsql
                declare
                
                v_ot_stavka varchar2(1);
                v_otvorena varchar2(2);
                v_otvoreni_iznos number;
                v_id number;
                v_id_dok number;
                
                begin
                
                
                    IF :APEX$ROW_STATUS = 'D' THEN -- DELETE
                
                        glavna_knjiga_pkg.delete_glavna_knjiga_stavka (
                            p_id => :ID
                        );
                
                    ELSIF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN -- CREATE
                
                        select ko.otvorene_stavke os
                        into v_ot_stavka
                        from sif.acc_kontni_okvir_klase ko 
                        where ko.id=:KONTNA_KLASA_ID;
                
                        glavna_knjiga_pkg.insert_glavna_knjiga_stavka(
                            p_glavna_knjiga_id    => :P201_ID,
                            p_kontna_klasa_id     => :KONTNA_KLASA_ID,
                            p_klijent_id          => :KLIJENT_ID,
                            p_tip_stavke          => :TIP_STAVKE,
                            p_opis                => :OPIS,
                            p_iznos               => TO_NUMBER(:IZNOS,'999G999G999G999G990D00'),
                            p_grad_id             => :GRAD_ID,
                            p_osnovno_sredstvo_id => :OSNOVNO_SREDSTVO_ID,
                            p_transakcija_id      => :TRANSAKCIJA_ID,
                            p_os_datum            => coalesce(:OS_DATUM,:P201_DATUM_DOSPJECA),
                            p_pdv_indikator_id    => :PDV_INDIKATOR_ID,
                            p_oj_id               => :OJ_ID,
                            p_radnik_id           => :RADNIK_ID,
                            p_dodjela             => :DODJELA,
                            p_datum_dokumenta     => :P201_DATUM_DOKUMENTA,
                            p_otvorena            => case v_ot_stavka when 'N' then 'Z' else 'O' end,
                            p_otvoreni_iznos      => case v_ot_stavka when 'N' then 0 else TO_NUMBER(:IZNOS,'999G999G999G999G990D00') end,
                            p_id                  => v_id
                        );
                
                        glavna_knjiga_pkg.insert_gk_stavka_dokument (
                            p_ooj_id                  => :APP_OOJ_ID,
                            p_modul_id                => :P201_MODUL,
                            p_dokument_id             => :P201_DOKUMENT_ID,
                            p_dokument                => :P201_DOKUMENT,
                            p_opis                    => :P201_OPIS_DOKUMENTA,
                            p_glavna_knjiga_stavka_id => v_id,
                            p_id                      => v_id_dok
                        );
                
                        RETURN;
                    ELSIF :APEX$ROW_STATUS = 'U' THEN -- UPDATE
                
                    
                        select ko.otvorene_stavke os
                        into v_ot_stavka
                        from sif.acc_kontni_okvir_klase ko 
                        where ko.id=:KONTNA_KLASA_ID;
                
                        glavna_knjiga_pkg.update_glavna_knjiga_stavka (  
                            p_id                  => :ID,
                            p_glavna_knjiga_id    => :P201_ID,
                            p_kontna_klasa_id     => :KONTNA_KLASA_ID,
                            p_klijent_id          => :KLIJENT_ID,
                            p_redni_broj          => :REDNI_BROJ,
                            p_tip_stavke          => :TIP_STAVKE,
                            p_opis                => :OPIS,
                            p_iznos               =>  TO_NUMBER(:IZNOS,'999G999G999G999G990D00'),
                            p_grad_id             => :GRAD_ID,
                            p_osnovno_sredstvo_id => :OSNOVNO_SREDSTVO_ID,
                            p_transakcija_id      => :TRANSAKCIJA_ID,
                            p_os_datum            => coalesce(:OS_DATUM,:P201_DATUM_DOSPJECA),
                            p_interni_nalog       => :INTERNI_NALOG,
                            p_pdv_indikator_id    => :PDV_INDIKATOR_ID,
                            p_oj_id               => :OJ_ID,
                            p_radnik_id           => :RADNIK_ID,
                            p_dodjela             => :DODJELA,
                            p_datum_dokumenta     => :P201_DATUM_DOKUMENTA,
                            p_otvorena            => case v_ot_stavka when 'N' then 'Z' else 'O' end,
                            p_otvoreni_iznos      => case v_ot_stavka when 'N' then 0 else TO_NUMBER(:IZNOS,'999G999G999G999G990D00') end
                        );
                
                        RETURN;
                    END IF;
                
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 47633511619790625
        }
        serverSideCondition {
            whenButtonPressed: @snimi-stavke
            executionScope: allSubmittedRows
        }
    )

    process save-stavke-ig-dodjela (
        name: Save stavke IG - Dodjela
        type: executeCode
        editableRegion: @stavke-konta-preview-knjizeno-2
