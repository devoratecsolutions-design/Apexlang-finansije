    validation iznos-sum (
        name: Iznos SUM = 0
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_iznos NUMBER;
                BEGIN
                    SELECT sum(iznos)
                    INTO l_iznos
                    FROM glavna_knjiga_stavke
                    WHERE glavna_knjiga_id = :P201_ID;
                
                    IF l_iznos != 0 THEN
                        RETURN 'Suma iznosa mora biti nula. Trenutna suma: ' || to_char(l_iznos, '999G999G999G999G990D00');
                    END IF;
                
                    RETURN null;
                END;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @proknjizi
        }
    )

