    region stavke-konta-grid-neknjizeno (
        name: Stavke konta Grid - Neknjizeno
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH stavke AS (
                    SELECT 	
                        id,
                        redni_broj,
                        glavna_knjiga_id,
                        kontna_klasa_id,
                        iznos,
                        tip_stavke,
                        opis,
                        klijent_id,
                        grad_id,
                        osnovno_sredstvo_id,
                        transakcija_id,
                        os_datum,
                        interni_nalog,
                        pdv_indikator_id,
                        oj_id,
                        radnik_id,
                        dodjela
                    FROM
                        glavna_knjiga_stavke
                    WHERE
                        glavna_knjiga_id = :P201_ID
                    ORDER BY
                        redni_broj ASC
                ) 
                SELECT
                    *
                FROM
                    stavke
                
                ```
            pageItemsToSubmit: P201_ID
        }
        layout {
            sequence: 20
            parentRegion: @stavke-konta-neknjizeno
            slot: regionBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                js-detail-region
                fin-grid
            ]
        }
        advanced {
            htmlDomId: StavkeIG
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        toolbar {
            controls: actionsMenu
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    let $ = apex.jQuery,
                        toolbarData = $.apex.interactiveGrid.copyDefaultToolbar();
                        addrowAction = toolbarData.toolbarFind("selection-add-row"),
                        addrowAction.label = "Nova stavka"; // Pick name you need
                        editrowAction = toolbarData.toolbarFind("edit"),
                        editrowAction.label = "Izmjeni"; // Pick name you need
                        saverowAction = toolbarData.toolbarFind("save"),
                        saverowAction.label = "Sačuvaj izmjene"
                        options.toolbarData = toolbarData;
                    
                    options.defaultGridViewOptions = {
                        reorderColumns: false
                    }
                    return options;
                }
                
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 45492987914322208
        }

