    region nalog (
        name: Nalog
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    vrsta_naloga_id,
                    godina,
                    broj,
                    datum_dokumenta,
                    datum_knjizenja,
                    proknjizeno,
                    opis,
                    stornirano,
                    storniran_id
                FROM
                    glavna_knjiga
                WHERE
                    id = :P201_ID
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: js-master-region
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P201_ID
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-label--stacked
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No Record Selected
        }
        componentAdvanced {
            stripHtml: true
        }

