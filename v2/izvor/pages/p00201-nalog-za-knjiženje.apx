        column OSNOVNO_SREDSTVO_ID (
            type: popupLov
            heading {
                heading: Osnovno sredstvo
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        os.naziv || ' ( ' || os.inventurni_naziv || ' )' as d,
                        os.id as r
                    FROM
                        sec_osnovna_sredstva os
                        JOIN sif.acc_klase_os_konta k ON k.klasa_id = os.klasa_id
                    WHERE
                        os.ooj_id = :APP_OOJ_ID
                        AND os.valid = 'Y'
                        AND os.history_id IS null
                        AND k.kontna_klasa_id = :KONTNA_KLASA_ID
                        AND k.transakcija_id = :TRANSAKCIJA_ID
                        AND ((:TRANSAKCIJA_ID = 161 AND os.priprema = 'Y') OR :TRANSAKCIJA_ID != 161)
                    ```
                nullDisplayValue: - Izaberite osnovno sredstvo -
            }
            cascadingLov {
                parentColumns: [
                    KONTNA_KLASA_ID
                    TRANSAKCIJA_ID
                ]
                itemsToSubmit: [
                    KONTNA_KLASA_ID
                    TRANSAKCIJA_ID
                ]
            }
            layout {
                sequence: 140
            }
            source {
                databaseColumn: OSNOVNO_SREDSTVO_ID
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                hide: false
            }
