                        lpad(sifra, 3, '0') as d,
                        id as r
                    FROM
                        sif.sif_gradovi
                    WHERE
                        (
                            :KLIJENT_ID IS NOT NULL 
                            AND drzava_id = (
                                SELECT drzava_id
                                FROM sec_klijenti k
                                WHERE k.id = :KLIJENT_ID
