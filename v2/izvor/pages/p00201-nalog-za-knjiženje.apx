    dynamicAction check (
        name: Check
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @check-plate
        }

        action native-alert (
            action: alert
            settings {
                title: Nije uredu
                message: Suma ukupnog iznosa bruta + suma ukupnog iznosa prevoza je različita od sume iznosa dugovne strane.
                style: danger
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P201_CHECKED
                value: N
            }
        )

        action native-alert-2 (
            action: alert
            settings {
                title: U redu
                message: Suma ukupnog iznosa bruta + suma ukupnog iznosa prevoza je jednaka sumi dugovne strane.
                style: success
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P201_CHECKED
                value: Y
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P201_CHECKED := glavna_knjiga_pkg.check_nalog_plate (
                        p_nalog_id => :P201_ID
                    );
                    ```
                itemsToSubmit: P201_CHECKED
                itemsToReturn: P201_CHECKED
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

