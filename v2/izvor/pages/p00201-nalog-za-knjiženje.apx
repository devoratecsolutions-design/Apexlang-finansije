    validation pdv-indikator-not-valid (
        name: PDV indikator NOT VALID
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @stavke-konta-grid-neknjizeno
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_kontna_klasa_code      VARCHAR2(32);
                    l_kontna_klasa_indikator VARCHAR2(1);
                    l_pdv_indikator_sifra    VARCHAR2(2); 
                    l_pdv_indikator_prefix   VARCHAR2(32);
                BEGIN
                    sif.acc_pkg.get_pdv_indikator(
                        p_id                  => :PDV_INDIKATOR_ID,
                        p_sifra               => l_pdv_indikator_sifra,
                        p_kontna_klasa_prefix => l_pdv_indikator_prefix
                    );
                    
                    sif.acc_pkg.get_kontni_okvir_klasa (
                        p_id            => :KONTNA_KLASA_ID,
                        p_code          => l_kontna_klasa_code,
                        p_pdv_indikator => l_kontna_klasa_indikator
                    );
                                
                    IF l_kontna_klasa_indikator = 'Y' THEN
                        IF (l_kontna_klasa_code NOT LIKE nvl(l_pdv_indikator_prefix, 0) || '%') THEN
                            RETURN 'Na konto ' || l_kontna_klasa_code || ' indikator ' || l_pdv_indikator_sifra || ' nije odgovarajući. 1';
                        END IF;
                    END IF;
                    
                    IF l_pdv_indikator_prefix IS NOT null THEN
                        IF (l_kontna_klasa_code NOT LIKE nvl(l_pdv_indikator_prefix, 0) || '%') THEN
                            RETURN 'Na konto ' || l_kontna_klasa_code || ' indikator ' || l_pdv_indikator_sifra || ' nije odgovarajući. 2';
                        END IF;
                    END IF;
                
                
                END;
                ```
        }
        error {
            associatedColumn: PDV_INDIKATOR_ID
        }
        serverSideCondition {
            type: itemIsInColonDelimitedList
            item: P201_VRSTA_NALOGA_SIFRA
            list: [
                uf
                if
                av
                ifs
                avs
            ]
        }
    )

