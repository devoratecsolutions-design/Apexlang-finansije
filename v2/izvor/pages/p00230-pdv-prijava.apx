    button generate-pdv (
        buttonName: GENERATE_PDV
        label: Generisanje PDV prijave
        layout {
            sequence: 10
            region: @pdv-prijava
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 231
                clearCache: 231
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @generate-pdv
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pdv-prjava
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction prikazi-podatke (
        name: Prikazi podatke
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P230_PORESKI_PERIOD
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pdv-prjava
            }
            execution {
                sequence: 110
                fireOnInit: false
            }
        )

    )

