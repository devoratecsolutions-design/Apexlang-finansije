page 230 (
    name: PDV Prijava
    alias: PDV-PRIJAVA
    title: PDV Prijava
    pageGroup: @glavna-knjiga
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #pdv .a-GV-header {
            
                height: 60px;
            
            }
            ```
    }
    security {
        authorizationScheme: @glavna-knjiga-pdv-prijava
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Na stranici <b><em>"PDV prijava"</em></b> nalazi se polje <b><em>"Poreski period"</em></b> 
            izvještaja u kojem je potrebno odabrati period za koji se popunjava prijava. </br>
            Nakon odabira perioda, pritiskom na dugme <b><em>"Generiši PDV"</em></b> prijavu sistem automatski 
            formira prijavu na osnovu evidentiranih ulaznih i izlaznih računa.</br>
            </br>
            Dugme <b><em>"Generisanje PDV"</em></b> prijave radi tako ukoliko u odabranom poreskom periodu nije 
            bilo promjena u dokumentima, sistem će generisati prijavu identičnu prethodnoj, 
            uz mogućnost pregleda i poređenja sa ranije kreiranim prijavama. </br>
            
            Nakon što unesete sva potrebna polja, sistem vam nudi dvije mogućnosti pregleda:
            <ul>
                <li>Pregled kroz izvještaj – odmah na istoj stranici prijava se prikazuje u obliku izvještaja.</li>
                <li>Link <b><em>„Pregled“</em></b> – klikom na ovaj link bićete preusmjereni na posebnu stranicu 
                kreiranu radi lakše preglednosti i detaljnog prikaza PDV prijave.</li>
            </ul> </br>
            Na stranici pregleda dostupne su sljedeće funkcionalnosti:
            <ul>
                <li>Dugme <b><em>„Štampaj“</em></b> – omogućava preuzimanje PDV prijave u PDF formatu, spremnom za arhiviranje 
                    ili slanje nadležnim organima.</li>
                <li>Dugme <b><em>„Knjiži“</em></b> – pokreće automatsko knjiženje PDV prijave u glavnu knjigu. 
                    Sistem tada zatvara konta PDV obaveze i pretporeza na odgovarajuće kontne pozicije, 
                    bez potrebe za ručnim unosom.</li>
            </ul>
            ```
    }

    region pdv-prijava (
        name: PDV Prijava
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        accessibility {
            useLandmark: false
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region pdv-prjava (
        name: PDV PRJAVA
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    isporuke_p11              as p_11,
                    izvoz_p12                 as p_12,
                    isporuke_osl_pdv_p13      as p_13,
                    nabavke_p21               as p_21,
                    uvoz_p22                  as p_22,
                    nabavke_poljoprivreda_p23 as p_23,
                    pdv_izlaz_p51             as p_51,
                    pdv_ulaz_p61              as p_61,
                    pdv_reg_obveznici_p41     as p_41,
                    pdv_uvoz_p42              as p_42,
                    pausal_poljoprivreda_p43  as p_43,
                    fbih_p32                  as p_32,
                    rs_p33                    as p_33,
                    dbr_p34                   as p_34,
                    pdv_uplata_povrat_p71     as p_71,
                    CASE
                        WHEN valid = 'Y' THEN
                            '<span class="t-Button t-Button--noLabel u-color-5 t-Button--iconLeft t-Button--small">
                                <span class="t-Icon t-Icon--left fa fa-check-circle-o"></span>
                            </span>'
                        ELSE
                            '<span class="t-Button t-Button--noLabel u-color-9 t-Button--iconLeft t-Button--small">
                                <span class="t-Icon t-Icon--left fa fa-circle-o"></span>
                            </span>'
                    END AS valid,
                    created
                FROM 
                    pdv_prijave
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND poreski_period = :P230_PORESKI_PERIOD
                ```
            pageItemsToSubmit: P230_PORESKI_PERIOD
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
            cssClasses: fin-grid
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        toolbar {
            show: false
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    options.defaultGridViewOptions = {
                        reorderColumns: false,
                        footer: false
                    }
                    return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 110504738538941632
        }

