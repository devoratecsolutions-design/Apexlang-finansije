    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @mjesto-troška-tree
        }

        action native-javascript-code_1 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.jQuery(document).one("apexafterrefresh", "#MJESTO_TROSKA_ID", function() {
                        finTree.reapply('MJESTO_TROSKA_ID');
                    });
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @mjesto-troška-tree
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

