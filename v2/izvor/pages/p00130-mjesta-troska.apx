page 130 (
    name: Mjesta troska
    alias: MJESTA-TROSKA
    title: Mjesta troska
    pageGroup: @konfiguracija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function treeSearchHighlight(pStaticId, pSearchString, pClassName) {
                var tree$ = apex.region(pStaticId).widget();
            
                apex.jQuery("." + apex.util.escapeCSS(pClassName), "#" + apex.util.escapeCSS(pStaticId))
                    .removeClass(pClassName);
            
                if (!pSearchString) {
                    tree$.treeView("collapseAll");
                    return;
                }
            
                tree$.treeView("collapseAll");
            
            
                var lTerm = pSearchString.toLowerCase();
            
                var lMatches$ = tree$.treeView("find", {
                    depth: -1,
                    findAll: true,
                    match: function(n) {
                        return n.label.toLowerCase().indexOf(lTerm) >= 0;
                    }
                });
            
                if (lMatches$.length === 0) {
                    tree$.treeView("collapseAll");
                    return;
                }
            
                lMatches$.find(".a-TreeView-label").addClass(pClassName);
            
                var lAncestorNodes$ = lMatches$.parents(".a-TreeView-node");
                var lAncestors$ = lAncestorNodes$.children(".a-TreeView-content");
            
                if (lAncestors$.length > 0) {
                    tree$.treeView("expand", lAncestors$);
                }
            }
            ```
    }
    css {
        inline:
            ```css
            .tree-search-highlight {
                background-color: #1b3a5c;
                color: #ffffff;
                border-radius: 3px;
                padding: 0 2px;
            }
            
            #MJESTO_TROSKA_ID .ik-mt-vrh   { color: #1f3a68; }
            #MJESTO_TROSKA_ID .ik-mt-grana { color: #2f6fb3; }
            #MJESTO_TROSKA_ID .ik-mt-list  { color: #2e7d32; }
            #MJESTO_TROSKA_ID .ik-mt-neakt { color: #9e9e9e; }
            ```
    }
    security {
        authorizationScheme: @finansije-konfiguracija
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <b><em>Kontni okviri</em></b> služi za uspostavljanje i održavanje strukture kontnog plana koju koristi organizacija. 
            Sistem podržava standardnu hijerarhiju klasa → grupa → konto → analitika, 
            a svaki novi konto može se precizno definisati kroz sljedeća polja: </br>
            <ul>
                <li>Nadređena klasa (konto-klasa): postavlja lokaciju konta u hijerarhiji i osigurava usklađenost s propisanim klasama (0–9). </li>
                <li>Šifra i naziv: jedinstvena oznaka i opis konta. </li>
                <li>Osnovno sredstvo (obavezno/da-ne): označava da li se konto koristi za evidentiranje dugoročne imovine (npr. nekretnine, oprema), što utiče na obračun amortizacije i izvještavanje.</li>
                <li>Klijent obavezan / Organizacijska jedinica / Radnik: poslovna pravila koja kontrolišu da li je pri knjiženju obavezno povezati konto s kupcem/dobavljačem, osnovnom organizacionom jedinicom ili zaposlenim — važno za precizno segmentno i odgovorno izvještavanje.</li>
                <li>PDV indikator: određuje tretman prometa prema PDV pravilima (npr. ulazni odbitak, obračun izlaznog PDV-a, oslobođenja), čime se automatizuje knjiženje i umanjuje rizik od greške u obračunu. </li>
            </ul>
            
            Na dugme <b><em>Novi Unos</em></b> kreiraj konto definisanjem nadređene klase, šifre, 
            naziva i odgovarajućih “obavezno”/“nije obavezno” pravila (osnovno sredstvo, klijent, OOJ, radnik, PDV). </br>
            </br>
            Postoji i opcija na aplikaciji <b><em> Export / Import</em></b>:
            da klijenti dostave fajl sistem administratoru. 
            Administrator je zadužen da izvrši konfiguraciju dostavljenog fajla, 
            a nakon što potvrdi da je konfiguracija uspješno završena, korisniku 
            preostaje da koristi aplikaciju na jednostavan način kroz opcije Export i Import.  
            
            ```
    }

    region mjesta-troška (
        name: Mjesta troška
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 70
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region mjesto-troška-tree (
        name: Mjesto troška Tree
        title: Kontni okvir
        type: tree
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select mt.id, 
                       mt.nad_id, 
                       mt.sifra||'-'||mt.naziv  as label,
                       case
                              when mt.valid = 'N' then 'fa fa-ban ik-mt-neakt'
                              when mt.nad_id is null then 'fa fa-building-o ik-mt-vrh'
                              when exists (select 1 
                                           from sif.acc_mjesta_troska c
                                           where c.nad_id = mt.id)
                                    then 'fa fa-sitemap ik-mt-grana'
                              else 'fa fa-money ik-mt-list'
                      end as ikona,
                      case when mt.valid = 'N' then 'Neaktivno' end as tooltip
                 from sif.acc_mjesta_troska mt
                 where mt.ooj_id=:APP_OOJ_ID;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-tree
        }
        advanced {
            htmlDomId: MJESTO_TROSKA_ID
            regionDisplaySelector: true
        }
        settings {
            nodeLabelColumn: LABEL
            nodeValueColumn: ID
            nodeIdColumn: ID
            parentKeyColumn: NAD_ID
            orderSiblingsBy: LABEL
            tooltip: databaseCol
            tooltipColumn: TOOLTIP
            activateNodeLinkWith: doubleClick
            link: {
                page: 131
                items: {
                    P131_ID: &ID.
                }
            }
            iconCssClassColumn: IKONA
        }
    )

    region alatna-traka (
        name: Alatna traka
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="fin-tree-toolbar" data-tree="MJESTO_TROSKA_ID">
                    <label class="fin-tree-search">
                        <span class="fa fa-search" aria-hidden="true"></span>
                        <input type="search" placeholder="Pretraga po šifri ili nazivu..." aria-label="Pretraga stabla" autocomplete="off">
                        <button type="button" class="fin-tree-clear" data-action="clear" title="Obriši pretragu" aria-label="Obriši pretragu"><span class="fa fa-times" aria-hidden="true"></span></button>
                    </label>
                    <span class="fin-tree-count" aria-live="polite"></span>
                    <span class="fin-tree-actions">
                        <button type="button" class="fin-tbtn" data-action="expand"><span class="fa fa-plus-square-o" aria-hidden="true"></span>Proširi sve</button>
                        <button type="button" class="fin-tbtn" data-action="collapse"><span class="fa fa-minus-square-o" aria-hidden="true"></span>Skupi sve</button>
                    </span>
                </div>
                ```
        }
        layout {
            sequence: 29
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
