    region stavke-konta-grid (
        name: Stavke konta Grid
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 	
                    id,
                    redni_broj,
                    glavna_knjiga_id,
                    kontna_klasa_id,
                    iznos,
                    tip_stavke,
                    tip_stavke_izvoda,
                    opis,
                    klijent_id,
                    grad_id,
                    prihod_rashod,
                    vrsta_prihoda_id,
                    vrsta_rashoda_id,
                    nacin_placanja_izvoda,
                    sifra_prihoda,
                    valuta_id,
                    kurs,
                    valuta_iznos,
                    kif_id,
                    kuf_id,
                    priznat_rashod,
                    oj_id
                FROM
                    glavna_knjiga_stavke
                WHERE
                    glavna_knjiga_id = :P220_ID
                ```
            pageItemsToSubmit: P220_ID
        }
        layout {
            sequence: 10
            parentRegion: @stavke-konta
            slot: regionBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                js-detail-region
                fin-grid
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        toolbar {
            controls: actionsMenu
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    let $ = apex.jQuery,
                        toolbarData = $.apex.interactiveGrid.copyDefaultToolbar();
                        addrowAction = toolbarData.toolbarFind("selection-add-row"),
                        addrowAction.label = "Nova stavka"; // Pick name you need
                        editrowAction = toolbarData.toolbarFind("edit"),
                        editrowAction.label = "Izmjeni"; // Pick name you need
                        saverowAction = toolbarData.toolbarFind("save"),
                        saverowAction.label = "Sačuvaj izmjene"
                    options.toolbarData = toolbarData;
                
                    options.defaultGridViewOptions = {
                        reorderColumns: false
                    }
                
                    return options;
                }
                ```
        }
