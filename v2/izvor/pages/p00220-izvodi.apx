        column KIF_ID (
            type: selectList
            heading {
                heading: Izlazne fakture
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        naziv_fakture || ' ( ' || to_char(iznos_fakture, '999G999G999G999G990D00') || ' )' AS d,
                        id AS r
                    FROM
                        vw_kif
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND uplaceno = 'N'
                        AND lower(vrsta_naloga_sifra) IN ('if')
                        AND (stornirano = 'N' AND storniran_id IS null)
                        AND klijent_id = :KLIJENT_ID
                    ORDER BY
                        faktura_broj
                    ```
                nullDisplayValue: - Izaberite izlaznu fakturu -
            }
            cascadingLov {
                parentColumns: KLIJENT_ID
            }
            layout {
                sequence: 240
            }
            source {
                databaseColumn: KIF_ID
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                hide: false
            }
        )

