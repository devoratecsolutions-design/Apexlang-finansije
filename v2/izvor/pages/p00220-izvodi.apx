    dynamicAction submit-items (
        name: Submit Items
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: [
                P220_OOJ_BANKA_ID
                P220_PROKNJIZENO
                P220_CURRENT
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_month_year VARCHAR2(255);
                    BEGIN
                        l_month_year := TRIM(UPPER(REPLACE(REPLACE(REPLACE(:P220_CURRENT,'P220_DATUM'),'_header'),'_',' ')));
                    
                        WITH available_dates AS (
                            SELECT DISTINCT
                                to_char(datum_dokumenta, 'YYYY-MM-DD') AS datum_dokumenta
                            FROM
                                vw_glavna_knjiga
                            WHERE
                                ooj_id = :APP_OOJ_ID
                                AND godina = :APP_GODINA
                                AND lower(vrsta_naloga_sifra) = 'iz'
                                AND ooj_banka_id = :P220_OOJ_BANKA_ID
                                AND proknjizeno = :P220_PROKNJIZENO
                                AND TRUNC(datum_dokumenta, 'MM') = trunc(to_date(l_month_year, 'MONTH YYYY'), 'MM')
                        )
                        SELECT
                            json_arrayagg(datum_dokumenta)
                        INTO
                            :P220_DATUM_ARRAY
                        FROM
                            available_dates;
                    END;
                    ```
                itemsToSubmit: [
                    P220_OOJ_BANKA_ID
                    P220_PROKNJIZENO
                    P220_DATUM_ARRAY
                    P220_CURRENT
                ]
                itemsToReturn: P220_DATUM_ARRAY
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var jsonString = $v('P220_DATUM_ARRAY');
                    document.querySelectorAll('.schDate').forEach(el => el.classList.remove('schDate'));
                    
                    if (jsonString.length > 0) {
                        var dateArray = JSON.parse(jsonString);
                        dateArray.forEach(function (date) {
                            var elements = document.querySelectorAll('[data-date="' + date + '"]');
                            elements.forEach(function (element) {
                                element.classList.add('schDate');
                            });
                        });
                    }
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

