    region stavke-koje-se-ne-slažu-sa-matičnim-podacima-klijenta (
        name: Stavke koje se ne slažu sa matičnim podacima klijenta
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 	
                    id,
                    redni_broj,
                    kontna_klasa_id,
                    opis,
                    klijent_id,
                    klijent_kontna_klasa_id
                FROM
                    vw_glavna_knjiga_stavke
                WHERE
                    glavna_knjiga_id = :P220_ID
                    AND klijent_id IS NOT null
                    AND kontna_klasa_id != klijent_kontna_klasa_id
                ORDER BY
                    redni_broj ASC
                ```
            pageItemsToSubmit: P220_ID
        }
        layout {
            sequence: 20
            parentRegion: @stavke-konta
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: [
                margin-md
                fin-list
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 	
                    1
                FROM
                    vw_glavna_knjiga_stavke
                WHERE
                    glavna_knjiga_id = :P220_ID
                    AND klijent_id IS NOT null
                    AND kontna_klasa_id != klijent_kontna_klasa_id
                ```
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
