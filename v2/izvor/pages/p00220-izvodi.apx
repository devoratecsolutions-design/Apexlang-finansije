    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                glavna_knjiga_pkg.get_glavna_knjiga (
                    p_id                 => :P220_ID,
                    p_proknjizeno        => :P220_NALOG_PROKNJIZEN,
                    p_stornirano         => :P220_NALOG_STORNIRAN,
                    p_vrsta_naloga_id    => :P220_VRSTA_NALOGA_ID,
                    p_vrsta_naloga_sifra => :P220_VRSTA_NALOGA_SIFRA
                );
                
                :P220_PROKNJIZENO := :P220_NALOG_PROKNJIZEN;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 50021448756361381
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P220_ID
        }
    )

    process knjizi (
        name: Knjizi
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :APP_TIP_PREDUZETNIKA_SIFRA IN ('doo', 'ad', 'vsp_dvojno') THEN
                    glavna_knjiga_pkg.insert_auto_izvod_stavka (
                        p_id => :P220_ID
                    );
                END IF;
                
                glavna_knjiga_pkg.set_proknjizeno (
                    p_id                     => :P220_ID,
                    p_value                  => 'Y',
                    p_tip_preduzetnika_sifra => :APP_TIP_PREDUZETNIKA_SIFRA
                );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 50021085273361382
        }
        serverSideCondition {
            whenButtonPressed: @proknjizi
        }
    )

    process return-to-edit (
        name: Return to Edit
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                glavna_knjiga_pkg.set_proknjizeno (
                    p_id    => :P220_ID,
                    p_value => 'N'
                );
                
                glavna_knjiga_pkg.delete_auto_izvod_stavka (
                    p_id => :P220_ID
                );
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 51415547162246135
        }
        serverSideCondition {
            whenButtonPressed: @return-to-edit
        }
    )

    process save-stavke (
        name: Save stavke
        type: executeCode
        editableRegion: @stavke-konta-grid
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS = 'D' THEN
                    glavna_knjiga_pkg.delete_glavna_knjiga_stavka (
                        p_id => :ID
                    );
                    RETURN;
                
                ELSIF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN
                    glavna_knjiga_pkg.insert_glavna_knjiga_stavka (
                        p_glavna_knjiga_id      => :P220_ID,
                        p_kontna_klasa_id       => :KONTNA_KLASA_ID,
                        p_klijent_id            => :KLIJENT_ID,
                        p_tip_stavke_izvoda     => :TIP_STAVKE_IZVODA,
                        p_opis                  => :OPIS,
                        p_iznos                 => to_number(:IZNOS, '999G999G999G999G990D00'),
                        p_grad_id               => :GRAD_ID,
                        p_prihod_rashod         => :PRIHOD_RASHOD,
                        p_vrsta_prihoda_id      => :VRSTA_PRIHODA_ID,
                        p_vrsta_rashoda_id      => :VRSTA_RASHODA_ID,
                        p_nacin_placanja_izvoda => :NACIN_PLACANJA_IZVODA,
                        p_automatska            => 'N',
                        p_valuta_id             => :VALUTA_ID,
                        p_valuta_iznos          => :VALUTA_IZNOS,
                        p_kurs                  => :KURS,
                        p_kif_id                => :KIF_ID,
                        p_kuf_id                => :KUF_ID,
                        p_priznat_rashod        => :PRIZNAT_RASHOD
                    );
                
                    RETURN;
                
                ELSIF :APEX$ROW_STATUS = 'U' THEN
                    glavna_knjiga_pkg.update_glavna_knjiga_stavka (
                        p_id                    => :ID,
                        p_glavna_knjiga_id      => :P220_ID,
                        p_kontna_klasa_id       => :KONTNA_KLASA_ID,
                        p_klijent_id            => :KLIJENT_ID,
                        p_redni_broj            => :REDNI_BROJ,
                        p_tip_stavke_izvoda     => :TIP_STAVKE_IZVODA,
                        p_opis                  => :OPIS,
                        p_iznos                 => to_number(:IZNOS, '999G999G999G999G990D00'),
                        p_grad_id               => :GRAD_ID,
                        p_prihod_rashod         => :PRIHOD_RASHOD,
                        p_vrsta_prihoda_id      => :VRSTA_PRIHODA_ID,
                        p_vrsta_rashoda_id      => :VRSTA_RASHODA_ID,
                        p_nacin_placanja_izvoda => :NACIN_PLACANJA_IZVODA,
                        p_sifra_prihoda         => :SIFRA_PRIHODA,
                        p_valuta_id             => :VALUTA_ID,
                        p_valuta_iznos          => :VALUTA_IZNOS,
                        p_kurs                  => :KURS,
                        p_kif_id                => :KIF_ID,
                        p_kuf_id                => :KUF_ID,
                        p_priznat_rashod        => :PRIZNAT_RASHOD,
                        p_oj_id                 => :OJ_ID
                    );
                    RETURN;
                
                END IF;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 49999721033361420
        }
        serverSideCondition {
            whenButtonPressed: @snimi-stavke
        }
    )

    branch (
        name: Go To Page 220
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 220
                items: {
                    P220_ID: &P220_NALOG_ID.
                }
            }
        }
        serverSideCondition {
            type: request=Value
            value: NALOG
        }
    )

)

