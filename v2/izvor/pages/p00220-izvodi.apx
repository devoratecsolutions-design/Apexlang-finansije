        column GRAD_ID (
            type: popupLov
            heading {
                heading: Šifra grada
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        lpad(sifra, 3, '0') as d,
                        id as r
                    FROM
                        sif.sif_gradovi g
                    WHERE
                        (
                            :KLIJENT_ID IS NOT NULL 
                            AND g.drzava_id = (
                                SELECT k.drzava_id
                                FROM sec_klijenti k
                                WHERE k.id = :KLIJENT_ID
                            )
                        ) OR (
                            :KLIJENT_ID IS NULL 
                            AND drzava_id = 28
                        )
                    ```
                displayExtraValues: false
                nullDisplayValue: - Izaberite grad -
            }
            cascadingLov {
                parentColumns: KLIJENT_ID
            }
            layout {
                sequence: 130
            }
            source {
                databaseColumn: GRAD_ID
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                hide: false
            }
        )

