    region nalog (
        name: Nalog
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    godina,
                    broj,
                    datum_dokumenta,
                    datum_knjizenja,
                    proknjizeno,
                    opis,
                    ooj_banka_id,
                    broj_izvoda,
                    pocetno_stanje,
                    zakljucno_stanje,
                    kontna_klasa_code,
                    kontna_klasa_naziv,
                    stornirano,
                    storniran_id
                    
                FROM
                    vw_glavna_knjiga
                WHERE
                    id = :P220_ID
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
