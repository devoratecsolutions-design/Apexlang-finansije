    validation iznos-sum (
        name: Iznos SUM
        execution {
            sequence: 100
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_iznos  NUMBER;
                    l_stanje NUMBER;
                BEGIN
                    SELECT zakljucno_stanje - pocetno_stanje  
                    INTO l_stanje
                    FROM glavna_knjiga
                    WHERE
                        id = :P220_ID;
                
                    SELECT sum(iznos)
                    INTO l_iznos
                    FROM glavna_knjiga_stavke
                    WHERE glavna_knjiga_id = :P220_ID;
                
                    IF :APP_TIP_PREDUZETNIKA_SIFRA IN ('doo', 'ad', 'vsp_dvojno') THEN
                        IF abs(l_stanje) != abs(l_iznos) THEN
                            RETURN false;
                        END IF;
                    ELSE
                        IF l_stanje = l_iznos THEN
                            RETURN true;
                        END IF;
                
                    END IF;
                    
                    IF l_stanje > 0 AND l_iznos < 0 THEN
                        RETURN true;
                    ELSIF l_stanje < 0 AND l_iznos > 0 THEN
                        RETURN true;
                    END IF;
                
                    apex_debug.message('DBG suma iznosa: ' || abs(l_iznos));
                    apex_debug.message('DBG zakljucno - pocetno: ' || abs(l_stanje));
                
                    RETURN false;
                END;
                ```
        }
        error {
            errorMessage: Suma iznosa mora biti jednaka razlici početnog i zaključnog stanja izvoda.
        }
        serverSideCondition {
            whenButtonPressed: @proknjizi
        }
    )

