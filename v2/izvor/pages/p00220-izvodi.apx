    dynamicAction change-calculate-iznos (
        name: Change - Calculate iznos
        execution {
            sequence: 110
        }
        when {
            selectionType: columns
            interactiveGrid: @stavke-konta-grid
            columns: [
                VALUTA_IZNOS
                KURS
            ]
        }
        clientSideCondition {
            type: itemColumn!=value
            column: VALUTA_ID
            value: 1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_datum DATE;
                    BEGIN
                        glavna_knjiga_pkg.get_glavna_knjiga (
                            p_id              => :P220_ID,
                            p_datum_dokumenta => l_datum
                        );
                    
                        :IZNOS := sif.acc_pkg.convert_to_bam (
                            p_valuta_id  => :VALUTA_ID,
                            p_vrijednost => TO_NUMBER(:VALUTA_IZNOS,'999G999G999G999G990D00'),
                            p_datum      => l_datum,
                            p_kurs       => :KURS
                        );
                    END;
                    ```
                itemsToSubmit: [
                    VALUTA_IZNOS
                    IZNOS
                    VALUTA_ID
                    KURS
                ]
                itemsToReturn: IZNOS
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode: :VALUTA_IZNOS := null;
                itemsToSubmit: VALUTA_IZNOS
                itemsToReturn: VALUTA_IZNOS
                showProcessing: true
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

    )

    dynamicAction change-get-kurs (
        name: Change - Get kurs
        execution {
            sequence: 120
        }
