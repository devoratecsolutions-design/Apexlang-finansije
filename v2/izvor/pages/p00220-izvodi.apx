    region stavke-konta-preview (
        name: Stavke Konta Preview
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 	
                    id,
                    redni_broj,
                    glavna_knjiga_id,
                    kontna_klasa_id,
                    iznos,
                    tip_stavke,
                    tip_stavke_izvoda,
                    opis,
                    klijent_id,
                    grad_id,
                    prihod_rashod,
                    vrsta_prihoda_id,
                    vrsta_rashoda_id,
                    nacin_placanja_izvoda,
                    sifra_prihoda,
                    valuta_id,
                    kurs,
                    valuta_iznos,
                    kif_naziv,
                    kuf_naziv
                FROM
                    vw_glavna_knjiga_stavke
                WHERE
                    glavna_knjiga_id = :P220_ID
                ORDER BY
                    redni_broj ASC
                ```
            pageItemsToSubmit: P220_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
            cssClasses: [
                js-detail-region
                fin-list
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P220_ID is not null AND :P220_NALOG_PROKNJIZEN = 'Y'
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
            showNullValuesAs: -
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column GLAVNA_KNJIGA_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column GRAD_ID (
            reportColumnQueryId: 10
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Grad
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        lpad(sifra, 3, '0') as d,
                        id as r
                    FROM
                        sif.sif_gradovi
                    WHERE
                        (
                            :KLIJENT_ID IS NOT NULL 
                            AND drzava_id = (
                                SELECT drzava_id
                                FROM sec_klijenti k
                                WHERE k.id = :KLIJENT_ID
                            )
                        ) OR (
                            :KLIJENT_ID IS NULL 
                            AND drzava_id = 28
                        )
                    ```
            }
            layout {
                sequence: 100
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column IZNOS (
            reportColumnQueryId: 5
