page 312 (
    name: Skladiste / Korisnik / Detalji
    alias: SKLADISTE-KORISNIK-DETALJI
    title: Skladiste / Korisnik / Detalji
    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region korisnik (
        name: Korisnik
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    skladiste_naziv,
                    skladiste_sifra,
                    korisnik_naziv,
                    korisnicko_ime
                FROM
                    vw_skladiste_korisnici
                WHERE
                    id = :P312_ID
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P312_ID
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column KORISNICKO_IME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Korisničko ime
            }
            layout {
                sequence: 40
            }
        )

        column KORISNIK_NAZIV (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Korisnik
            }
            layout {
                sequence: 30
            }
        )

        column SKLADISTE_NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Naziv
            }
            layout {
                sequence: 10
            }
        )

        column SKLADISTE_SIFRA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Šifra
            }
            layout {
                sequence: 20
            }
        )

    )

    region skladiste-korisnici (
        name: Skladiste Korisnici
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P312_ID
        }
    )

    pageItem P312_ID (
        type: hidden
        layout {
            sequence: 10
            region: @korisnik
            slot: regionBody
        }
    )

    pageItem P312_KORISNIK_ID (
        type: selectMany
        label {
            label: Korisnik
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    ime || ' ' || prezime AS d,
                    id AS r
                FROM
                    core.korisnici
                WHERE
                    id NOT IN (
                        SELECT
                            korisnik_id
                        FROM
                            skladiste_korisnici
                        WHERE
                            skladiste_id = :P312_SKLADISTE_ID
                    )
                    AND firma_id = :APP_FIRMA_ID
                ```
        }
        layout {
            sequence: 40
            region: @skladiste-korisnici
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P312_SKLADISTE_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P312_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P312_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation korisnik-not-null (
        name: KORISNIK NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P312_KORISNIK_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P312_KORISNIK_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: REQUEST
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 188985748095391194
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                skladista_pkg.delete_skladiste_korisnik (
                    p_id => :P312_ID
                );
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 188719219534453047
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                skladista_pkg.insert_skladiste_korisnici (
                    p_skladiste_id => :P312_SKLADISTE_ID,
                    p_korisnik_id  => :P312_KORISNIK_ID
                );
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 188719127867453046
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

