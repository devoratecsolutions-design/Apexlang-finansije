page 312 (
    name: Korisnici skladišta
    alias: SKLADISTE-KORISNIK-DETALJI
    title: Dodaj korisnike skladišta
    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 640
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @robno-materijalno-konfiguracija-skladišta
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region korisnici-detalji (
        name: Korisnici
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
    )

    pageItem P312_SKLADISTE_ID (
        type: hidden
        layout {
            sequence: 1
            region: @korisnici-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P312_KORISNIK_ID (
        type: selectMany
        label {
            label: Korisnici
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ime || ' ' || prezime AS d,
                       id AS r
                FROM core.korisnici
                WHERE firma_id = :APP_FIRMA_ID
                  AND id NOT IN (SELECT korisnik_id FROM skladiste_korisnici WHERE skladiste_id = :P312_SKLADISTE_ID)
                ORDER BY ime, prezime
                ```
        }
        layout {
            sequence: 10
            region: @korisnici-detalji
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Korisnici koji će vidjeti skladište i raditi sa njegovim dokumentima. Može se izabrati više korisnika.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button dodaj (
        buttonName: DODAJ
        label: Dodaj
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-user-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation korisnik-obavezno (
        name: Korisnik obavezno
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P312_KORISNIK_ID
        }
        error {
            errorMessage: Izaberite bar jednog korisnika.
            associatedItem: @P312_KORISNIK_ID
        }
        serverSideCondition {
            whenButtonPressed: @dodaj
        }
    )

    dynamicAction cancel-dialog (
        name: Odustani
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process dodaj (
        name: Dodaj korisnike
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                rm_skladiste_pkg.dodaj_korisnike(p_skladiste_id => :P312_SKLADISTE_ID, p_korisnici => :P312_KORISNIK_ID);
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @dodaj
        }
    )

    process close-dialog (
        name: Zatvori dijalog
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            whenButtonPressed: @dodaj
        }
    )

)
