page 350 (
    name: Nivelacija cijena
    alias: NIVELACIJA-CIJENA
    title: Nivelacija cijena
    pageGroup: @robno-materijalno
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @robno-materijalno-nivelacije-cijene
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region faceted-search (
        name: Faceted Search
        type: smartFilters
        source {
            filteredRegion: @operacije-report
        }
        layout {
            sequence: 19
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P350_OJ_ID (
            type: checkboxGroup
            label {
                label: Organizaciona jedinica
            }
            lov {
                type: sharedComponent
                lov: @oj
            }
            layout {
                sequence: 40
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: OJ_ID
            }
        )

        filter P350_SEARCH (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

    )

    region nivelacija-cijena-skladište-p350-skladiste-sifra (
        name: "Nivelacija cijena [Skladište: &P350_SKLADISTE_SIFRA.]"
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region operacije-report (
        name: Operacije Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    naziv,
                    skladiste_id,
                    tip_kretanja_id,
                    oj_id,
                    datum
                FROM
                    vw_operacije
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND godina = :APP_GODINA
                    AND skladiste_id = :A_SKLADISTE_ID
                    AND tip_kretanja_sifra = 'NIV'
                ORDER BY
                    datum DESC, broj DESC
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATUM (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            layout {
                sequence: 0
            }
            link {
                target: {
                    page: 352
                    items: {
                        P352_ID: #ID#
                    }
                    clearCache: 352
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Naziv
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column OJ_ID (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Organizaciona jedinica
            }
            lov {
                type: sharedComponent
                lov: @oj
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column SKLADISTE_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Skladište
            }
            lov {
                type: sharedComponent
                lov: @skladista
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column TIP_KRETANJA_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Tip kretanja
            }
            lov {
                type: sharedComponent
                lov: @sif-tipovi-kretanja-robe
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P350_SKLADISTE_SIFRA (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 10
            region: @nivelacija-cijena-skladište-p350-skladiste-sifra
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 351
                clearCache: 351
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: A_SKLADISTE_ID
        }
    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @operacije-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-2 (
        name: Dialog Closed - Refresh 2
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @operacije-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @operacije-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @faceted-search
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    computation p350-skladiste-sifra (
        itemName: P350_SKLADISTE_SIFRA
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    sifra
                FROM
                    skladista
                WHERE
                    id = :A_SKLADISTE_ID
                ```
        }
    )

)

