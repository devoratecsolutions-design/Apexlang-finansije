        layout {
            sequence: 20
            region: @osnovno-sredstvo-opšti-podaci
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: expression
            plsqlExpression:
                ```plsql
                os_pkg.is_osnovno_sredstvo_editable (
                    p_id => :P257_ID
                ) = false or :P257_PRIPREMA = 'Y'
