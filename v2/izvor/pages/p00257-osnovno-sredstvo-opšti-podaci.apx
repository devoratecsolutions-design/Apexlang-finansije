page 257 (
    name: Osnovno sredstvo / Opšti podaci
    alias: OSNOVNO-SREDSTVO-OPŠTI-PODACI
    title: Osnovno sredstvo / Opšti podaci
    pageGroup: @osnovna-sredstva
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region osnovno-sredstvo-opšti-podaci (
        name: Osnovno sredstvo / Opšti podaci
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P257_AKTIVIRANO (
        type: radioGroup
        label {
            label: Aktivno
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 150
            region: @osnovno-sredstvo-opšti-podaci
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
            cssClasses: apex_disabled
        }
    )

    pageItem P257_AUTOMATSKA_AMORTIZACIJA (
        type: radioGroup
        label {
            label: Automatska amortizacija
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @osnovno-sredstvo-opšti-podaci
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        help {
            helpText:
                ```html
                Ukoliko uključite automatsku amortizaciju, svakog 1. u mjesecu sistem će sam da amortizuje osnovno sredstvo.
                
                ```
        }
    )

    pageItem P257_DATUM (
        type: datePicker
        label {
            label: Datum kapitalizacije
            alignment: left
        }
        layout {
            sequence: 90
            region: @osnovno-sredstvo-opšti-podaci
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P257_HISTORY_KOMENTAR (
        type: textarea
        label {
            label: Komentar ažuriranja
            alignment: left
        }
        settings {
            autoHeight: true
            charCounter: true
        }
        layout {
            sequence: 130
            region: @osnovno-sredstvo-opšti-podaci
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 1000
        }
    )

