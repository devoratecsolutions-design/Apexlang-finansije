        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P257_STATUS_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 55241413768235966
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_os t_sec_osnovna_sredstva;
                BEGIN
                    l_os := t_sec_osnovna_sredstva();
                    l_os.id := :P257_ID;
                
                    os_pkg.get_osnovno_sredstvo (
                        p_os => l_os
                    );
                
                    :P257_KLASA_ID := l_os.klasa_id;
                    :P257_INVENTURNI_BROJ := l_os.inventurni_broj;
                    :P257_INVENTURNI_NAZIV := l_os.inventurni_naziv;
                    :P257_STARI_INVENTURNI_BROJ := l_os.stari_inventurni_broj;
                    :P257_NAZIV := l_os.naziv;
                    :P257_KOLICINA := l_os.kolicina;
                    :P257_JM_ID := l_os.jm_id;
                    :P257_DATUM := l_os.datum;
                    :P257_STATUS_ID := l_os.status_id;
                    :P257_AUTOMATSKA_AMORTIZACIJA := l_os.automatska_amortizacija;
                    :P257_INDIKATOR_ID := l_os.indikator_id;
                    
                    :P257_PRIPREMA := l_os.priprema;
                    :P257_AKTIVIRANO := l_os.aktivirano;
                    :P257_VALID := l_os.valid;
                 
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 55164748028702815
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P257_ID
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_os t_sec_osnovna_sredstva;
                BEGIN
                    l_os := t_sec_osnovna_sredstva();
                    
                    l_os.id := :P257_ID;
                    os_pkg.get_osnovno_sredstvo (
                        p_os => l_os
                    );
                
                    l_os.klasa_id := :P257_KLASA_ID;
                    l_os.inventurni_broj := :P257_INVENTURNI_BROJ;
                    l_os.inventurni_naziv := :P257_INVENTURNI_NAZIV;
                    l_os.stari_inventurni_broj := :P257_STARI_INVENTURNI_BROJ;
                    l_os.naziv := :P257_NAZIV;
                    l_os.kolicina := :P257_KOLICINA;
                    l_os.jm_id := :P257_JM_ID;
                    l_os.datum := :P257_DATUM;
                    l_os.automatska_amortizacija := :P257_AUTOMATSKA_AMORTIZACIJA;
                    l_os.priprema := :P257_PRIPREMA;
                    l_os.aktivirano := :P257_AKTIVIRANO;
                    l_os.status_id := :P257_STATUS_ID;
                    l_os.indikator_id := :P257_INDIKATOR_ID;
                    l_os.valid := :P257_VALID;
                
                    l_os.history_komentar := :P257_HISTORY_KOMENTAR;
                    os_pkg.update_osnovno_sredstvo (
                        p_os => l_os
                    );
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 55164897907702816
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

