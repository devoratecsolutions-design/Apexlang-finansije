    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P257_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation auto-am-not-null (
        name: Auto. am. NOT NULL
        execution {
            sequence: 90
        }
        validation {
            type: itemIsNotNull
            item: P257_AUTOMATSKA_AMORTIZACIJA
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P257_AUTOMATSKA_AMORTIZACIJA
        }
    )

    validation datum-not-null (
        name: Datum NOT NULL
        execution {
            sequence: 70
        }
        validation {
            type: itemIsNotNull
            item: P257_DATUM
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P257_DATUM
        }
    )

    validation inventurni-broj-not-null (
        name: Inventurni broj NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P257_INVENTURNI_NAZIV
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P257_INVENTURNI_NAZIV
        }
    )

    validation jm-not-null (
        name: JM NOT NULL
        execution {
            sequence: 50
        }
        validation {
