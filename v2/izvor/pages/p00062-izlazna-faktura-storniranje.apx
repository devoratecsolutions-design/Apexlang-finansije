page 62 (
    name: Izlazna faktura / Storniranje
    alias: IZLAZNA-FAKTURA-STORNIRANJE
    title: Izlazna faktura / Storniranje
    pageGroup: @fakture-računi
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P62_DATUM (
        type: datePicker
        label {
            label: Datum
            alignment: left
        }
        settings {
            useDefaults: false
            appearanceBehavior: [
                monthPicker
                yearPicker
                showTodayButton
            ]
            showOn: iconClick
        }
        layout {
            sequence: 30
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P62_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P62_STORNIRAJ_ID (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button storniraj (
        buttonName: STORNIRAJ
        label: Storniraj
        layout {
            sequence: 20
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-undo-arrow
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P54_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation datum-not-null (
        name: Datum NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P62_DATUM
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P62_DATUM
        }
    )

    computation p62-datum (
        itemName: P62_DATUM
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    datum_fakture
                FROM
                    kif
                WHERE
                    id = :P62_ID
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P62_STORNIRAJ_ID
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 102836630972921306
        }
        serverSideCondition {
            whenButtonPressed: @storniraj
        }
    )

    process storniraj (
        name: Storniraj
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P62_STORNIRAJ_ID := finansije_pkg.storniraj_kif (
                    p_id               => :P62_ID,
                    p_datum            => :P62_DATUM,
                    p_auto             => 'Y',
                    p_glavna_knjiga_id => null
                );
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
        }
        advanced {
            executionMappingIdentifier: 102842693957928999
        }
        serverSideCondition {
            whenButtonPressed: @storniraj
        }
    )

)

