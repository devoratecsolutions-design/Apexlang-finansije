page 88 (
    name: Automatski unos KIF / Detalji
    alias: AUTOMATSKI-UNOS-KIF-DETALJI
    title: Automatski unos KIF / Detalji
    pageGroup: @uio-dokumentacija
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--xl
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region učitani-kif-fajl-pregled (
        name: Učitani KIF fajl (pregled)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    c001 as vrsta_sloga,
                    c002 as poreski_period,
                    c003 as redni_br,
                    c004 as tip_dokumenta,
                    c005 as broj_fakture,
                    to_date(c006, :P88_KIF_DATE_FORMAT) as datum_fakture,
                    c007 as naziv_kupca,
                    c008 as sjediste_kupca,
                    c009 as pdv_broj_kupca,
                    c010 as jib_broj_kupca,
                    c011 as iznos_fakture,
                    c012 as iznos_fakture_interne,
                    c013 as iznos_fakture_izvozne,
                    c014 as iznos_ostale_bez_pdv,
                    c015 as iznos_osnovice_za_pdv,
                    c016 as iznos_izlaz_pdv_za_pdv,
                    c017 as iznos_osnovice_za_nepdv,
                    c018 as iznos_izlaz_pdv_za_nepdv,
                    c019 as iznos_pdv_32polje,
                    c020 as iznos_pdv_33polje,
                    c021 as iznos_pdv_34polje
                FROM
                    apex_collections
                WHERE
                    collection_name = 'LOAD_KIF'
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }

        column BROJ_FAKTURE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Broj fakture
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column DATUM_FAKTURE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Datum fakture
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column IZNOS_FAKTURE (
