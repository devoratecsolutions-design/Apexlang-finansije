page 20040 (
    name: Promjena teme
    alias: PROMJENA-TEME
    title: Promjena teme
    pageGroup: @erp-globalne-stranice
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    pageItem P20040_THEME_ID (
        type: selectOne
        label {
            label: Tema
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    case when is_current = 'Yes' then
                        name || ' (Podrazumijevano)'
                    else
                        name
                    end d,
                    theme_style_id
                from
                    apex_application_theme_styles
                where
                    application_id = :APP_ID
                    and is_public = 'Yes'
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                margin-top-sm
            ]
            width: 30
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Podešavanja
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--link
                t-Button--iconLeft
            ]
            cssClasses: t-Button--inlineLink
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 20000
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button change (
        buttonName: CHANGE
        label: Promijeni temu
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation theme-not-null (
        name: Theme NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P20040_THEME_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P20040_THEME_ID
        }
    )

    process change-theme (
        name: Change theme
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sif.utils_pkg.update_theme_accross_applications (
                    p_application_id => :APP_ID,
                    p_theme_style_id => :P20040_THEME_ID
                );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 385573320072114525
        }
        serverSideCondition {
            whenButtonPressed: @change
        }
    )

    branch (
        name: Go To Page 1
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1
                clearCache: 1
            }
        }
    )

)

