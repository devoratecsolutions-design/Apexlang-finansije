    dynamicAction print-os (
        name: Print - OS
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: button
            button: @print
        }
        config {
            buildOption: @feature-printing
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    generate_report(
                        filename = 'os_' + $v("P256_NAZIV"), 
                        report_path = '/reports/ACCOUNTING/os/kartica_os', 
                        report_parameters = {
                            ID: $v("P256_ID")
                        },
                        new_tab = false
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            config {
                buildOption: @feature-printing
            }
        )

    )

    computation p256-history-id (
        itemName: P256_HISTORY_ID
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    history_id
                FROM
                    sec_osnovna_sredstva
                WHERE
                    id = :P256_ID
                ```
        }
    )

    computation p256-history-komentar (
        itemName: P256_HISTORY_KOMENTAR
        execution {
            sequence: 20
            point: beforeHeader
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    history_komentar
                FROM
                    sec_osnovna_sredstva
                WHERE
                    id = :P256_ID
                ```
        }
    )

    computation p256-naziv (
        itemName: P256_NAZIV
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    naziv
                FROM
                    sec_osnovna_sredstva
                WHERE
                    id = :P256_ID
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 55879687037186409
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_os t_sec_osnovna_sredstva;
                BEGIN
                    l_os := t_sec_osnovna_sredstva (:P256_ID);
                    
                    os_pkg.delete_osnovno_sredstvo (
                        p_os => l_os
                    );
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 55879569573186408
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 201
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 201
                items: {
                    P201_ID: &P256_NALOG_ID.
                }
                clearCache: 201
            }
        }
        serverSideCondition {
            type: request=Value
            value: GO_TO_NALOG
        }
    )

)

