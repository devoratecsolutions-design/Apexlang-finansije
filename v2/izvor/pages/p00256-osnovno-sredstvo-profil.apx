page 256 (
    name: Osnovno sredstvo / Profil
    alias: OSNOVNO-SREDSTVO-PROFIL
    title: Osnovno sredstvo / Profil
    pageGroup: @osnovna-sredstva
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#jasper-server#MIN#.js
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region amortizacija (
        name: Amortizacija
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    vijek_trajanja,
                    amortizaciona_stopa,
                    procijenjeni_vijek_trajanja,
                    poreska_amortizaciona_stopa,
                    grad_naziv,
                    grad_sifra,
                    donacija,
                    rezidualna_vrijednost
                FROM
                    vw_osnovna_sredstva
                WHERE
                    id = :P256_ID
                ```
        }
        layout {
            sequence: 30
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }

        column AMORTIZACIONA_STOPA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Amortizaciona stopa ( % )
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression: #AMORTIZACIONA_STOPA# %
            }
        )

        column DONACIJA (
            reportColumnQueryId: 7
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Donacija
            }
            lov {
                type: sharedComponent
                lov: @da-ne
            }
            layout {
                sequence: 90
            }
        )

        column GRAD_NAZIV (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Grad
            }
            layout {
                sequence: 70
            }
            columnFormatting {
                htmlExpression: #GRAD_NAZIV# ( #GRAD_SIFRA# )
            }
        )

        column GRAD_SIFRA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

        column PORESKA_AMORTIZACIONA_STOPA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Poreska amortizaciona stopa ( % )
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                htmlExpression: #PORESKA_AMORTIZACIONA_STOPA# %
            }
        )

        column PROCIJENJENI_VIJEK_TRAJANJA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Procijenjeni vijek trajanja
            }
            layout {
                sequence: 50
            }
        )

        column REZIDUALNA_VRIJEDNOST (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Rezidualna vrijednost
            }
            layout {
                sequence: 100
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column VIJEK_TRAJANJA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Vijek trajanja
            }
            layout {
                sequence: 30
            }
        )

    )

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region dodatne-informacije (
        name: Dodatne informacije
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    reg_oznaka,
                    radnik_naziv,
                    klijent_naziv,
                    dbms_lob.getlength(dokument) as dokument,
                    dokument_filename,
                    dokument_mimetype,
                    dokument_lastupd,
                    dokument_charset,
                    dokument_broj,
                    dokument_datum
                FROM
                    vw_osnovna_sredstva
                WHERE
                    id = :P256_ID
                ```
        }
        layout {
            sequence: 40
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }

        column DOKUMENT (
            reportColumnQueryId: 5
            derivedColumn: N
            type: downloadBlob
            heading {
                heading: Dokument
            }
            layout {
                sequence: 50
            }
            appearance {
                viewFileAs: inline
                downloadText: Preuzmi
            }
            blobAttributes {
                tableName: VW_OSNOVNA_SREDSTVA
                blobColumn: DOKUMENT
                primaryKeyColumn1: ID
                mimeTypeColumn: DOKUMENT_MIMETYPE
                filenameColumn: DOKUMENT_FILENAME
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                    FROM sec_osnovna_sredstva
                    WHERE
                        id = :P256_ID
                        AND dokument IS NOT null
                    ```
            }
        )

        column DOKUMENT_BROJ (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Broj dokumenta
            }
            layout {
                sequence: 100
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                    FROM sec_osnovna_sredstva
                    WHERE
                        id = :P256_ID
                        AND dokument_broj IS NOT null
                    ```
            }
        )

        column DOKUMENT_CHARSET (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 90
            }
        )

        column DOKUMENT_DATUM (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Datum dokumenta
            }
            layout {
                sequence: 110
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                    FROM sec_osnovna_sredstva
                    WHERE
                        id = :P256_ID
                        AND dokument_datum IS NOT null
                    ```
            }
        )

        column DOKUMENT_FILENAME (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 60
            }
        )

        column DOKUMENT_LASTUPD (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

        column DOKUMENT_MIMETYPE (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 70
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column KLIJENT_NAZIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Klijent
            }
            layout {
                sequence: 40
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                    FROM sec_osnovna_sredstva
                    WHERE
                        id = :P256_ID
                        AND klijent_id IS NOT null
                    ```
            }
        )

        column RADNIK_NAZIV (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Radnik
            }
            layout {
                sequence: 30
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                    FROM sec_osnovna_sredstva
                    WHERE
                        id = :P256_ID
                        AND radnik_id IS NOT null
                    ```
            }
        )

        column REG_OZNAKA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Registarka oznaka
            }
            layout {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                    FROM sec_osnovna_sredstva
                    WHERE
                        id = :P256_ID
                        AND reg_oznaka IS NOT null
                    ```
            }
        )

    )

    region istorija-promjena (
        name: Istorija promjena
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    history_date,
                    history_komentar,
                    created_by
                FROM
                    sec_osnovna_sredstva
                WHERE
                    history_id = :P256_ID OR history_id = :P256_HISTORY_ID
                ORDER BY
                    history_date DESC
                    
                ```
        }
        layout {
            sequence: 70
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column CREATED_BY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Ažurirao korisnik
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column HISTORY_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Datum ažuriranja
            }
            layout {
                sequence: 20
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column HISTORY_KOMENTAR (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Komentar ažuriranja
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Pregled
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 256
                    items: {
                        P256_ID: #ID#
                    }
                    clearCache: 256
                }
                linkText: <img src="#APEX_FILES#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    region održavanja-i-servisi (
        name: Održavanja i servisi
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    naziv,
                    opis,
                    datum,
                    cijena,
                    sledeci_servis
                FROM
                    sec_osnovno_sredstvo_odrzavanje
                WHERE
                    osnovno_sredstvo_id = :P256_ID
                ORDER BY
                    datum DESC
                    
                ```
        }
        layout {
            sequence: 60
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM sec_osnovna_sredstva
                WHERE
                    id = :P256_ID
                    AND priprema = 'N'
                ```
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column CIJENA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Cijena
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            columnFormatting {
                htmlExpression: #CIJENA# KM
            }
            sorting {
                sortable: false
            }
        )

        column DATUM (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Pregled
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 268
                    items: {
                        P268_ID: #ID#
                    }
                    clearCache: 268
                }
                linkText: <img src="#APEX_FILES#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Naziv
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column OPIS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Opis
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column SLEDECI_SERVIS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Sledeći servis
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

    )

    region opšti-podaci (
        name: Opšti podaci
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    klasa_id,
                    klasa_sifra,
                    klasa_naziv,
                    inventurni_naziv,
                    stari_inventurni_broj,
                    naziv,
                    kolicina,
                    jm_naziv,
                    datum,
                    automatska_amortizacija,
                    priprema,
                    priprema_id,
                    priprema_inventurni_naziv,
                    priprema_naziv,
                    aktivirano,
                    status_naziv,
                    valid
                FROM
                    vw_osnovna_sredstva
                WHERE
                    id = :P256_ID
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }

        column AKTIVIRANO (
            reportColumnQueryId: 15
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Aktivirano
            }
            lov {
                type: sharedComponent
                lov: @da-ne
            }
            layout {
                sequence: 160
            }
        )

