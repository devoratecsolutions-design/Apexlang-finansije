    region pregledate-istoriju (
        name: Pregledate istoriju
        type: staticContent
        source {
            htmlCode: <b>Komentar ažuriranja: </b>&P256_HISTORY_KOMENTAR.
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--danger
            ]
            cssClasses: u-color-9
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P256_HISTORY_ID
        }
    )

    region tabs (
        name: Tabs
        type: staticContent
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @tabs-container
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                t-TabsRegion-mod--simple
            ]
        }
    )

    region vrijednosti (
        name: Vrijednosti
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    pripremna_vrijednost,
                    nabavna_vrijednost,
                    knjigovodstvena_vrijednost,
                    -- vrijednost_poreske_amortizacije,
                    -- revalorizovana_vrijednost,
                    vrijednost_donacija,
                    odlozeni_porezi,
                    amortizacija_vrijednost,
                    -- povecanje_vrijednost,
                    prodajna_vrijednost,
                    manjak_vrijednost,
                    otpis_vrijednost
                FROM
                    vw_osnovna_sredstva
                WHERE
                    id = :P256_ID
                ```
        }
        layout {
            sequence: 50
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT
                    1
                FROM
                    glavna_knjiga_stavke
                WHERE
                    osnovno_sredstvo_id = :P256_ID
                ```
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
