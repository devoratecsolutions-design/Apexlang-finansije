            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Klasa
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 266
                    items: {
                        P266_ID: #KLASA_ID#
                        P266_ORIG: 256
                    }
                    clearCache: 266
                }
                linkText: #KLASA_SIFRA# - #KLASA_NAZIV#
            }
        )

        column KOLICINA (
            reportColumnQueryId: 7
            derivedColumn: N
