    button activate (
        buttonName: ACTIVATE
        label: Aktiviraj
        layout {
            sequence: 60
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-5
            icon: fa-check-circle-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 267
                items: {
                    P267_ID: &P256_ID.
                }
                clearCache: 267
                request: start
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM sec_osnovna_sredstva
                WHERE
                    id = :P256_ID
                    AND priprema = 'Y'
                    AND :P256_HISTORY_ID IS null
                    AND valid = 'Y'
                ```
        }
        security {
            authorizationScheme: @osnovna-sredstva-izmjena
        }
    )

