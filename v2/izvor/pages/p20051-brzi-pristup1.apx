            type: itemIsNotNull
            item: P20051_ID
        }
    )

    button set-invalid (
        buttonName: SET_INVALID
        label: Proglasi nevažećim
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-stop
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P20051_VALID
            value: Y
        }
    )

    button set-valid (
        buttonName: SET_VALID
        label: Proglasi važećim
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-5
            icon: fa-check-square-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                RETURN core.korisnik_pkg.can_update_brzi_pristup (
                    p_korisnik_id => :P20051_KORISNIK_ID,
                    p_valid       => :P20051_VALID
                );
                ```
        }
    )

    dynamicAction close (
        name: Close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @cancel-2
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.korisnik_pkg.delete_brzi_pristup (
                    p_id    => :P20051_ID
                );
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 385592109144110514
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.korisnik_pkg.get_brzi_pristup (
                    p_id          => :P20051_ID,
                    p_korisnik_id => :P20051_KORISNIK_ID,
                    p_page_id     => :P20051_PAGE_ID,
                    p_title       => :P20051_TITLE,
                    p_icon        => :P20051_ICON,
                    p_sequence    => :P20051_SEQUENCE,
                    p_valid       => :P20051_VALID,
                    p_created     => :P20051_CREATED,
