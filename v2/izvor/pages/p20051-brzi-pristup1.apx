            slot: regionBody
        }
    )

    pageItem P20051_ID (
        type: hidden
        layout {
            sequence: 10
            region: @brzi-pristup
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P20051_KORISNIK_ID (
        type: hidden
        layout {
            sequence: 20
            region: @brzi-pristup
            slot: regionBody
        }
    )

    pageItem P20051_PAGE_ID (
        type: hidden
        layout {
