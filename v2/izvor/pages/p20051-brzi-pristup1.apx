    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.korisnik_pkg.update_brzi_pristup (
                    p_id       => :P20051_ID,
                    p_title    => :P20051_TITLE,
                    p_sequence => :P20051_SEQUENCE
                );
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 385591786606110515
        }
        serverSideCondition {
