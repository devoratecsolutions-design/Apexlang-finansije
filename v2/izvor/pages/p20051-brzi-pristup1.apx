                    p_updated     => :P20051_UPDATED,
                    p_updated_by  => :P20051_UPDATED_BY,
                    p_row_version => :P20051_ROW_VERSION
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 385590595264110515
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P20051_ID
        }
    )

    process set-invalid (
        name: Set invalid
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.korisnik_pkg.update_valid (
                    p_id    => :P20051_ID,
                    p_valid => 'N'
                );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 385591341530110515
