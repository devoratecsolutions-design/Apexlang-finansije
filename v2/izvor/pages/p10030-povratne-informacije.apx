page 10030 (
    name: Povratne informacije
    alias: POVRATNE-INFORMACIJE
    title: Povratne informacije
    pageGroup: @erp-globalne-stranice
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .feedback-positive, .feedback-negative, .feedback-neutral { padding: 8px; border-radius: 100%; background-color: white; margin: 4px; }
            .feedback-positive { color: var(--ut-feedback-positive-text-color, var(--ut-palette-success)); }
            .feedback-neutral { color: var(--ut-feedback-neutral-text-color, var(--ut-palette-warning)); }
            .feedback-negative { color: var(--ut-feedback-negative-text-color, var(--ut-palette-danger)); }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    config {
        buildOption: @feature-feedback
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form-on-feedback (
        name: Form on Feedback
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P10030_APPLICATION_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-feedback
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10030_FEEDBACK (
        type: textarea
        label {
            label: Povratne informacije
            alignment: left
        }
        settings {
            autoHeight: true
            charCounter: true
        }
        layout {
            sequence: 40
            region: @form-on-feedback
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 64
            height: 4
        }
        validation {
            maxLength: 4000
        }
    )

    pageItem P10030_PAGE_ID (
        type: hidden
        layout {
            sequence: 20
            region: @form-on-feedback
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10030_RATING (
        type: radioGroup
        label {
            label: Vaše iskustvo
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sharedComponent
            lov: @feedback-rating
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 35
            region: @form-on-feedback
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        security {
            escapeSpecialChars: false
        }
    )

    pageItem P10030_USER_AGENT (
        type: hidden
        layout {
            sequence: 30
            region: @form-on-feedback
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select sys.owa_util.get_cgi_env('user-agent') x
                from dual
                ```
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Pošalji povratne informacije
        layout {
            sequence: 10
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation at-least-one-feedback-required (
        name: At least One Feedback Required
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if :P10030_FEEDBACK is null and :P10030_RATING is null then
                    return false;
                else
                    return true;
                end if;
                ```
        }
        error {
            errorMessage: Please provide feedback or your experience.
            displayLocation: inlineInNotification
        }
    )

    process submit-feedback (
        name: Submit Feedback
        type: invokeApi
        invoke {
            package: APEX_UTIL
            procedureOrFunction: SUBMIT_FEEDBACK
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Feedback Submitted
        }
        advanced {
            executionMappingIdentifier: 132387210775732908
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }

        parameter p_application_id (
            parameter {
                hasDefault: true
            }
            value {
                type: staticValue
                staticValue: &APP_ID.
            }
            advanced {
                displaySequence: 2
            }
        )

        parameter p_comment (
            parameter {
                hasDefault: true
            }
            value {
                type: item
                item: P10030_FEEDBACK
            }
            advanced {
                displaySequence: 1
            }
        )

        parameter p_page_id (
            parameter {
                hasDefault: true
            }
            value {
                type: item
                item: P10030_PAGE_ID
            }
            advanced {
                displaySequence: 3
            }
        )

        parameter p_rating (
            parameter {
                dataType: number
                hasDefault: true
            }
            value {
                type: item
                item: P10030_RATING
            }
            advanced {
                displaySequence: 4
            }
        )

    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 10031
                action: resetPagination
                successMessage: false
            }
        }
    )

)

