page 11 (
    name: Poslovni partner / Detalji
    alias: KLIJENT-DETALJI
    title: Poslovni partner
    pageGroup: @klijenti
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Osnovni podaci, adresa i kontakt poslovnog partnera (kupca, dobavljača ili oba).
            Kod dvojnog knjigovodstva partneru se dodjeljuju <b>konta za knjiženje</b> - može ih imati više
            (npr. kupac 2110 i dobavljač 4330). U svakoj kontnoj grupi (prva cifra konta) jedno aktivno konto je
            <b>podrazumijevano</b> - po njemu se knjiže fakture i izvodi. Ako se označi novo podrazumijevano konto,
            ranije u istoj grupi se automatski isključuje; ako nijedno nije označeno, podrazumijevano je prvo po šifri.
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region partner-detalji (
        name: Poslovni partner / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
    )

    region osnovno (
        name: Osnovni podaci
        title: Osnovni podaci
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @partner-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region adresa (
        name: Adresa i kontakt
        title: Adresa i kontakt
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @partner-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region konta-sekcija (
        name: Konta za knjiženje
        title: Konta za knjiženje
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @partner-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
        serverSideCondition {
            type: itemIsNotInColonDelimitedList
            item: APP_TIP_PREDUZETNIKA_SIFRA
            list: [
                msp
                vsp_prosto
            ]
        }
    )

    region konta (
        name: Konta partnera
        title: Konta partnera
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT kk.id,
                       kk.sec_klijent_id,
                       kk.kontna_klasa_id,
                       kk.podrazumijevano,
                       kk.valid
                FROM sec_klijent_konta kk
                LEFT JOIN sif.acc_kontni_okvir_klase ko ON ko.id = kk.kontna_klasa_id
                WHERE kk.sec_klijent_id = :P11_ID
                ORDER BY ko.code
                ```
            pageItemsToSubmit: P11_ID
        }
        layout {
            sequence: 10
            parentRegion: @konta-sekcija
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ig
        }
        headerAndFooter {
            footerText: <span class="fin-sub">Partner može imati više konta; u svakoj kontnoj grupi (prva cifra) jedno je podrazumijevano za knjiženje faktura i izvoda i uparivanje otvorenih stavki.</span>
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Partner nema konta. Dodajte konto za knjiženje (npr. kupci 2xxx, dobavljači 4xxx).
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = "Dodaj konto"; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("search");
                    toolbarData.toolbarRemove("actions");
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: false };
                    return options;
                }
                ```
        }
        advanced {
            htmlDomId: partner_konta
            savedReportMappingIdentifier: 270563304789033340
        }

        savedReport 2716424 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 50
                    sequence: 1
                }
            )

            displayColumn (
                column: @KONTNA_KLASA_ID
                layout {
                    width: 380
                    sequence: 2
                }
            )

            displayColumn (
                column: @PODRAZUMIJEVANO
                layout {
                    width: 130
                    sequence: 3
                }
            )

            displayColumn (
                column: @VALID
                layout {
                    width: 80
                    sequence: 4
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @SEC_KLIJENT_ID
                layout {
                    sequence: 6
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SEC_KLIJENT_ID (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SEC_KLIJENT_ID
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column KONTNA_KLASA_ID (
            type: popupLov
            heading {
                heading: Konto
            }
            settings {
                popupWidth: 600
                popupHeight: 420
            }
            lov {
                type: sharedComponent
                lov: @kontni-okvir-klase-ooj
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: KONTNA_KLASA_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            enableUsersTo {
                hide: false
            }
        )

        column PODRAZUMIJEVANO (
            type: checkbox
            heading {
                heading: Podrazumijevano
                alignment: center
            }
            layout {
                sequence: 55
                columnAlignment: center
            }
            source {
                databaseColumn: PODRAZUMIJEVANO
                dataType: varchar2
            }
            default {
                type: expression
                plsqlExpression: 'N'
            }
            enableUsersTo {
                hide: false
            }
        )

        column VALID (
            type: checkbox
            heading {
                heading: Aktivno
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: VALID
                dataType: varchar2
            }
            default {
                type: expression
                plsqlExpression: 'Y'
            }
            enableUsersTo {
                hide: false
            }
        )

    )

