    process konta-snimi (
        name: Konta partnera - snimi redove
        type: executeCode
        editableRegion: @konta
        source {
            plsqlCode:
                ```plsql
                begin
                    declare
                        l_id number := kuf_pkg.broj(:ID);
                    begin
                        if :APEX$ROW_STATUS = 'D' then
                            sec_partner_pkg.obrisi_konto(p_id => l_id);
                        else
                            sec_partner_pkg.snimi_konto(
                                p_id              => l_id,
                                p_klijent_id      => :P11_ID,
                                p_konto_id        => kuf_pkg.broj(:KONTNA_KLASA_ID),
                                p_podrazumijevano => nvl(:PODRAZUMIJEVANO, 'N'),
                                p_valid           => nvl(:VALID, 'N'));
                            :ID := l_id;
                        end if;
                    end;
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 271636578665161305
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

