page 11 (
    name: Klijent / Detalji
    alias: KLIJENT-DETALJI
    title: Klijent / Detalji
    pageGroup: @klijenti
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region klijent-detalji (
        name: Klijent / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region kontaig (
        name: KontaIG
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from accounting.sec_klijent_konta acc
                where acc.sec_klijent_id=:P11_ID
                ```
        }
        layout {
            sequence: 230
            parentRegion: @klijent-detalji
            slot: regionBody
            column: 1
            columnSpan: 8
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
                margin-top-md
            ]
        }
        headerAndFooter {
            footerText: <span style="font-size:10px; font-style:italic; font-weight:bold">Definisanjem konta poslovnog partnera omogućavate automatiku knjiženja ulaznih/izlaznih faktura, izvoda i automatsko uparivanje otvarenih stavki.</span>
        }
        serverSideCondition {
            type: itemIsNotInColonDelimitedList
            item: APP_TIP_PREDUZETNIKA_SIFRA
            list: [
                msp
                vsp_prosto
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    let $ = apex.jQuery,
                        toolbarData = $.apex.interactiveGrid.copyDefaultToolbar();
                        addrowAction = toolbarData.toolbarFind("selection-add-row"),
                        addrowAction.label = "Nova stavka"; // Pick name you need
                        editrowAction = toolbarData.toolbarFind("edit"),
                        editrowAction.label = "Izmjeni"; // Pick name you need
                        saverowAction = toolbarData.toolbarFind("save"),
                        saverowAction.label = "Sačuvaj izmjene"
                    options.toolbarData = toolbarData;
                    
                    options.defaultGridViewOptions = {
                        reorderColumns: false
                    }
                    return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 270563304789033340
        }

        savedReport 2716424 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SEC_KLIJENT_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @KONTNA_KLASA_ID
                layout {
                    width: 350
                    sequence: 4
                }
            )

            displayColumn (
                column: @VALID
                layout {
                    width: 50
                    sequence: 5
                }
            )

            displayColumn (
                column: @ROW_VERSION
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @CREATED
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @CREATED_BY
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @UPDATED
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @UPDATED_BY
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 50
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CREATED (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: CREATED
                dataType: date
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column CREATED_BY (
            type: hidden
            layout {
                sequence: 90
            }
            source {
                databaseColumn: CREATED_BY
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column KONTNA_KLASA_ID (
            type: popupLov
            heading {
                heading: Konta poslovnog partnera
            }
            settings {
                popupWidth: 500
                popupHeight: 400
            }
            lov {
                type: sharedComponent
                lov: @kontni-okvir-klase-ooj
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: KONTNA_KLASA_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            enableUsersTo {
                hide: false
            }
        )

        column ROW_VERSION (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ROW_VERSION
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SEC_KLIJENT_ID (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SEC_KLIJENT_ID
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column UPDATED (
            type: hidden
            layout {
                sequence: 100
            }
            source {
                databaseColumn: UPDATED
                dataType: date
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column UPDATED_BY (
            type: hidden
            layout {
                sequence: 110
            }
            source {
                databaseColumn: UPDATED_BY
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column VALID (
            type: checkbox
            heading {
                heading: Aktivno
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: VALID
                dataType: varchar2
            }
            default {
                type: expression
                plsqlExpression: 'Y'
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            enableUsersTo {
                hide: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

