    process save-kontoig (
        name: Save KontoIG
        type: executeCode
        editableRegion: @kontaig
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS = 'D' THEN -- DELETE
                    accounting.sec_pkg.delete_klijent_konto (
                                            p_id => :ID
                        );
                ELSIF :APEX$ROW_STATUS  IN ('C','I') THEN 
                
                    accounting.sec_pkg.insert_klijent_konto (
                                            p_sec_klijent_id => :P11_ID,
                                            p_kontna_klasa_id => :KONTNA_KLASA_ID,
                                            p_valid => :VALID,
                                            p_id => :ID
                        );
                
                
                ELSIF :APEX$ROW_STATUS  IN ('U') THEN
                    accounting.sec_pkg.update_klijent_konto (
                                            p_id => :ID,
                                            p_sec_klijent_id => :P11_ID,
                                            p_kontna_klasa_id => :KONTNA_KLASA_ID,
                                            p_valid => :VALID
                                            
                        );
                
                END IF;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 271636578665161305
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: requestIsContainedInValue
            value: CREATE,SAVE, DELETE
        }
    )

