    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction change (
        name: Change
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P11_TIP_KLIJENTA_ID
        }
        clientSideCondition {
            type: item=value
            item: P11_TIP_KLIJENTA_ID
            value: 3
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P11_RADNIK_ID
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P11_RADNIK_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction check-for-bih (
        name: Check for BIH
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P11_DRZAVA_ID
        }
        clientSideCondition {
            type: item=value
            item: P11_DRZAVA_ID
            value: 28
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P11_ENTITET_ID
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P11_ENTITET_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function zameniX() {
                        var topWin = window.top;
                        var $ = topWin.apex.jQuery;
                        var btn = $('.ui-dialog-titlebar-close', topWin.document);
                    
                        if (btn.length) {
                            btn.off('click').on('click', function(e) {
                                e.preventDefault();
                                e.stopImmediatePropagation();
                    
                                apex.page.cancelWarnOnUnsavedChanges();
                                topWin.apex.navigation.dialog.close(true);
                            });
                        }
                    }
                    
                    var observer = new MutationObserver(zameniX);
                    observer.observe(window.top.document.documentElement, {
                        childList: true,
                        subtree: true,
                        attributes: true,
                        attributeFilter: ['style', 'class']
                    });
                    
                    zameniX();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    validation adresa-not-null (
        name: Adresa NOT NULL
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
