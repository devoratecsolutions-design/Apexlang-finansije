page 433 (
    name: Cjenovnik radnika / Detalji
    alias: CJENOVNIK-RADNIKA-DETALJI1
    title: Cjenovnik radnika / Detalji
    pageGroup: @proizvodnja
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P433_CIJENA_SATA (
        type: numberField
        label {
            label: Cijena sata
            alignment: left
        }
        layout {
            sequence: 20
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 30
        }
    )

    pageItem P433_RADNIK_ID (
        type: displayOnly
        label {
            label: Radnik
            alignment: left
        }
        settings {
            basedOn: lov
        }
        lov {
            type: sharedComponent
            lov: @hr-radnici
        }
        layout {
            sequence: 10
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 30
            region: @buttons-bar
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 20
            region: @buttons-bar
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation cijena-sata-not-null (
        name: Cijena sata NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P433_CIJENA_SATA
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P433_CIJENA_SATA
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 151300214365367123
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hrm.evidencija_pkg.update_radnik_cijena (
                    p_radnik_id   => :P433_RADNIK_ID,
                    p_cijena_sata => null
                );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 151299860122367123
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hrm.evidencija_pkg.get_radnik_cijena (
                    p_radnik_id   => :P433_RADNIK_ID,
                    p_cijena_sata => :P433_CIJENA_SATA
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 151299043405367123
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P433_RADNIK_ID
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hrm.evidencija_pkg.update_radnik_cijena (
                    p_radnik_id   => :P433_RADNIK_ID,
                    p_cijena_sata => to_number(:P433_CIJENA_SATA, '999G999G999G999G990D00')
                );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 151299465810367123
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

