page 311 (
    name: Skladište / Detalji
    alias: SKLADIŠTE-DETALJI
    title: Skladište
    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--md
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .ui-dialog-titlebar-close {
                display: none !important;
            }
            ```
    }
    security {
        authorizationScheme: @robno-materijalno-konfiguracija-skladišta
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region zakljucano (
        name: Skladište ima dokumente
        type: staticContent
        source {
            htmlCode: Skladište ima dokumente – mogu se mijenjati samo zaduženi radnik, adresa, fax, napomena i aktivnost. Skladište se ne može deaktivirati dok ima robe na stanju.
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P311_ZAKLJUCANO = 'Y'
        }
    )

    region skladiste-detalji (
        name: Skladište / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
    )

    region osnovno (
        name: Osnovni podaci
        title: Osnovni podaci
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @skladiste-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region organizacija (
        name: Organizacija i odgovornost
        title: Organizacija i odgovornost
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @skladiste-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region kontakt (
        name: Adresa i napomena
        title: Adresa i napomena
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @skladiste-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region korisnici (
        name: Korisnici skladišta
        title: Korisnici skladišta
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    k.id,
                    k.korisnik_naziv,
                    k.korisnicko_ime
                FROM vw_skladiste_korisnici k
                WHERE k.skladiste_id = :P311_ID
                ORDER BY k.korisnik_naziv
                ```
            pageItemsToSubmit: P311_ID
        }
        layout {
            sequence: 40
            parentRegion: @skladiste-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
            cssClasses: fin-section
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Nijedan korisnik nema pristup ovom skladištu. Dodajte korisnike koji će raditi sa dokumentima skladišta.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P311_ID
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 310
            }
        )

        column KORISNIK_NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Korisnik
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-sb-red"><span><span class="fa fa-user-circle-o" aria-hidden="true"></span> #KORISNIK_NAZIV#<span class="fin-sub">#KORISNICKO_IME#</span></span><a class="fin-act fin-act--danger fin-korisnik-brisi" href="javascript:void(0)" data-id="#ID#" title="Ukloni" aria-label="Ukloni"><span class="fa fa-times" aria-hidden="true"></span></a></span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column KORISNICKO_IME (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 330
            }
        )

    )

    pageItem P311_ID (
        type: hidden
        layout {
            sequence: 1
            region: @skladiste-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P311_ZAKLJUCANO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 2
            region: @skladiste-detalji
            slot: regionBody
        }
    )

    pageItem P311_RAZLOG_BRISANJA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 3
            region: @skladiste-detalji
            slot: regionBody
        }
    )

    pageItem P311_ROB_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 4
            region: @skladiste-detalji
            slot: regionBody
        }
    )

    pageItem P311_DVOJNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 5
            region: @skladiste-detalji
            slot: regionBody
        }
    )

    pageItem P311_KORISNIK_DEL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 6
            region: @skladiste-detalji
            slot: regionBody
        }
    )

    pageItem P311_SIFRA (
        type: textField
        label {
            label: Šifra
            alignment: left
        }
        validation {
            maxLength: 64
        }
        layout {
            sequence: 10
            region: @osnovno
            slot: regionBody
            columnSpan: 4
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            plsqlExpression: :P311_ZAKLJUCANO = 'Y'
        }
    )

    pageItem P311_NAZIV (
        type: textField
        label {
            label: Naziv
            alignment: left
        }
        validation {
            maxLength: 255
        }
        layout {
            sequence: 20
            region: @osnovno
            slot: regionBody
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            plsqlExpression: :P311_ZAKLJUCANO = 'Y'
        }
    )

    pageItem P311_TIP_SKLADISTA_ID (
        type: selectOne
        label {
            label: Tip skladišta
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT naziv AS d, id AS r
                FROM sif.acc_tipovi_skladista
                WHERE valid = 'Y'
                  AND (CASE WHEN upper(sifra) = 'ROB' THEN 'ROB' ELSE 'MAT' END = nvl(:A_RM_MODUL, 'ROB')
                       OR id = :P311_TIP_SKLADISTA_ID)
                ORDER BY CASE WHEN upper(sifra) IN ('ROB', 'MAT') THEN 0 ELSE 1 END, naziv
                ```
        }
        layout {
            sequence: 30
            region: @osnovno
            slot: regionBody
            columnSpan: 4
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Robno skladište služi za robu namijenjenu prodaji i radi po cjenovniku. Ostali tipovi su materijalna skladišta (prosječna nabavna cijena).
        }
        readOnly {
            type: expression
            plsqlExpression: :P311_ZAKLJUCANO = 'Y'
        }
    )

    pageItem P311_CJENOVNIK_ID (
        type: selectOne
        label {
            label: Cjenovnik
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT sifra || ' - ' || naziv || CASE tip WHEN 'M' THEN ' (maloprodaja)' WHEN 'V' THEN ' (veleprodaja)' END AS d,
                       id AS r
                FROM cjenovnici
                WHERE ooj_id = :APP_OOJ_ID
                  AND (valid = 'Y' OR id = :P311_CJENOVNIK_ID)
                ORDER BY sifra
                ```
        }
        layout {
            sequence: 40
            region: @osnovno
            slot: regionBody
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Cjenovnik određuje način rada robnog skladišta: maloprodajni (stanje po MP cijeni, nivelacije) ili veleprodajni (prosječna nabavna cijena).
        }
        readOnly {
            type: expression
            plsqlExpression: :P311_ZAKLJUCANO = 'Y'
        }
    )

    pageItem P311_VALID (
        type: switch
        label {
            label: Skladište je aktivno
            alignment: left
        }
        default {
            type: static
            staticValue: Y
        }
        layout {
            sequence: 50
            region: @osnovno
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P311_OJ_ID (
        type: selectOne
        label {
            label: Organizaciona jedinica
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @oj
        }
        layout {
            sequence: 10
            region: @organizacija
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            plsqlExpression: :P311_ZAKLJUCANO = 'Y'
        }
    )

    pageItem P311_NADREDJENO_ID (
        type: selectOne
        label {
            label: U sastavu skladišta (nadređeno)
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT sifra || ' - ' || naziv AS d, id AS r
                FROM skladista
                WHERE ooj_id = :APP_OOJ_ID
                  AND id <> nvl(:P311_ID, -1)
                ORDER BY sifra
                ```
        }
        layout {
            sequence: 20
            region: @organizacija
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            plsqlExpression: :P311_ZAKLJUCANO = 'Y'
        }
    )

    pageItem P311_RADNIK_ID (
        type: selectOne
        label {
            label: Zaduženi radnik (skladištar)
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT r.ime || ' ' || r.prezime || CASE WHEN r.naziv_oj IS NOT NULL THEN ' (' || r.naziv_oj || ')' END AS d,
                       r.id AS r
                FROM sif.vw_acc_radnici r
                WHERE r.ooj_id = :APP_OOJ_ID
                  AND (r.valid = 'Y' OR r.id = :P311_RADNIK_ID)
                ORDER BY r.ime, r.prezime
                ```
        }
        layout {
            sequence: 30
            region: @organizacija
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P311_KONTNA_KLASA_ID (
        type: selectOne
        label {
            label: Konto skladišta
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @kontni-okvir-klase-ooj
        }
        layout {
            sequence: 40
            region: @organizacija
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Konto zaliha na koji se knjiže dokumenti skladišta (samo dvojno knjigovodstvo).
        }
        readOnly {
            type: expression
            plsqlExpression: :P311_ZAKLJUCANO = 'Y'
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_TIP_PREDUZETNIKA_SIFRA in ('doo', 'ad', 'vsp_dvojno')
        }
    )

    pageItem P311_ADRESA (
        type: textField
        label {
            label: Adresa
            alignment: left
        }
        validation {
            maxLength: 255
        }
        layout {
            sequence: 10
            region: @kontakt
            slot: regionBody
            columnSpan: 8
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P311_FAX (
        type: textField
        label {
            label: Telefon / fax
            alignment: left
        }
        validation {
            maxLength: 255
        }
        layout {
            sequence: 20
            region: @kontakt
            slot: regionBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P311_NAPOMENA (
        type: textarea
        label {
            label: Napomena
            alignment: left
        }
        validation {
            maxLength: 1000
        }
        layout {
            sequence: 30
            region: @kontakt
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            height: 2
        }
    )

    button cancel (
        buttonName: ZATVORI
        label: Zatvori
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Obrisati skladište?
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P311_ID is not null and :P311_RAZLOG_BRISANJA is null
        }
    )

    button save (
        buttonName: SAVE
        label: Snimi
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button dodaj-korisnike (
        buttonName: DODAJ_KORISNIKE
        label: Dodaj korisnike
        layout {
            sequence: 10
            region: @korisnici
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-user-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 312
                items: {
                    P312_SKLADISTE_ID: &P311_ID.
                }
                clearCache: 312
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation sifra-obavezno (
        name: P311_SIFRA obavezno
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P311_SIFRA
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P311_SIFRA
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'SAVE'
        }
    )

    validation naziv-obavezno (
        name: P311_NAZIV obavezno
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P311_NAZIV
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P311_NAZIV
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'SAVE'
        }
    )

    validation tip-obavezno (
        name: P311_TIP_SKLADISTA_ID obavezno
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P311_TIP_SKLADISTA_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P311_TIP_SKLADISTA_ID
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'SAVE'
        }
    )

    validation oj-obavezno (
        name: P311_OJ_ID obavezno
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P311_OJ_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P311_OJ_ID
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'SAVE'
        }
    )

    validation skladiste (
        name: Provjera skladišta (RM_SKLADISTE_PKG)
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return rm_skladiste_pkg.provjeri(
                    p_id               => :P311_ID,
                    p_ooj_id           => :APP_OOJ_ID,
                    p_sifra            => :P311_SIFRA,
                    p_naziv            => :P311_NAZIV,
                    p_tip_skladista_id => :P311_TIP_SKLADISTA_ID,
                    p_cjenovnik_id     => case when :P311_TIP_SKLADISTA_ID = :P311_ROB_ID then :P311_CJENOVNIK_ID end,
                    p_oj_id            => :P311_OJ_ID,
                    p_nadredjeno_id    => :P311_NADREDJENO_ID,
                    p_kontna_klasa_id  => :P311_KONTNA_KLASA_ID,
                    p_radnik_id        => :P311_RADNIK_ID,
                    p_valid            => :P311_VALID,
                    p_dvojno           => :P311_DVOJNO
                );
                ```
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'SAVE'
        }
    )

    dynamicAction tip-skladista (
        name: Cjenovnik samo za robno skladište
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P311_TIP_SKLADISTA_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#P311_CJENOVNIK_ID_CONTAINER').toggle($v('P311_TIP_SKLADISTA_ID') !== '' && $v('P311_TIP_SKLADISTA_ID') === $v('P311_ROB_ID'));
            }
            execution {
                sequence: 10
                fireOnInit: true
            }
        )

    )

    dynamicAction korisnik-brisi (
        name: Ukloni korisnika
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .fin-korisnik-brisi
        }

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).data('id')
            }
            affectedElements {
                selectionType: items
                items: P311_KORISNIK_DEL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: rm_skladiste_pkg.obrisi_korisnika(p_id => :P311_KORISNIK_DEL);
                itemsToSubmit: P311_KORISNIK_DEL
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @korisnici
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction korisnici-dodati (
        name: Korisnici dodati - osvježi
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @dodaj-korisnike
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @korisnici
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process ucitaj (
        name: Učitavanje skladišta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for s in (select * from skladista where id = :P311_ID and ooj_id = :APP_OOJ_ID) loop
                    :P311_SIFRA            := s.sifra;
                    :P311_NAZIV            := s.naziv;
                    :P311_TIP_SKLADISTA_ID := s.tip_skladista_id;
                    :P311_CJENOVNIK_ID     := s.cjenovnik_id;
                    :P311_VALID            := s.valid;
                    :P311_OJ_ID            := s.oj_id;
                    :P311_NADREDJENO_ID    := s.nadredjeno_id;
                    :P311_RADNIK_ID        := s.radnik_id;
                    :P311_KONTNA_KLASA_ID  := s.kontna_klasa_id;
                    :P311_ADRESA           := s.adresa;
                    :P311_FAX              := s.fax;
                    :P311_NAPOMENA         := s.napomena;
                end loop;
                :P311_ZAKLJUCANO := rm_skladiste_pkg.ima_dokumenata(:P311_ID);
                :P311_RAZLOG_BRISANJA := rm_skladiste_pkg.razlog_zabrane_brisanja(:P311_ID);
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P311_ID
        }
    )

    process pripremi (
        name: Pomoćne vrijednosti
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select max(id) into :P311_ROB_ID from sif.acc_tipovi_skladista where upper(sifra) = 'ROB';
                :P311_DVOJNO := case when :APP_TIP_PREDUZETNIKA_SIFRA in ('doo', 'ad', 'vsp_dvojno') then 'Y' else 'N' end;
                if :P311_ID is null then
                    :P311_ZAKLJUCANO := 'N';
                    :P311_VALID := nvl(:P311_VALID, 'Y');
                    if :P311_TIP_SKLADISTA_ID is null then
                        select max(id) into :P311_TIP_SKLADISTA_ID from sif.acc_tipovi_skladista
                         where upper(sifra) = case nvl(:A_RM_MODUL, 'ROB') when 'ROB' then 'ROB' else 'MAT' end;
                    end if;
                end if;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    process snimi (
        name: Snimi skladište
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P311_ID := rm_skladiste_pkg.snimi(
                    p_id               => :P311_ID,
                    p_ooj_id           => :APP_OOJ_ID,
                    p_sifra            => :P311_SIFRA,
                    p_naziv            => :P311_NAZIV,
                    p_tip_skladista_id => :P311_TIP_SKLADISTA_ID,
                    p_cjenovnik_id     => case when :P311_TIP_SKLADISTA_ID = :P311_ROB_ID then :P311_CJENOVNIK_ID end,
                    p_oj_id            => :P311_OJ_ID,
                    p_nadredjeno_id    => :P311_NADREDJENO_ID,
                    p_kontna_klasa_id  => :P311_KONTNA_KLASA_ID,
                    p_radnik_id        => :P311_RADNIK_ID,
                    p_adresa           => :P311_ADRESA,
                    p_fax              => :P311_FAX,
                    p_napomena         => :P311_NAPOMENA,
                    p_valid            => :P311_VALID,
                    p_dvojno           => :P311_DVOJNO
                );
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Skladište je snimljeno.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'SAVE'
        }
    )

    process obrisi (
        name: Obriši skladište
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                rm_skladiste_pkg.obrisi(p_id => :P311_ID);
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Skladište je obrisano.
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process close-dialog (
        name: Zatvori dijalog
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,ZATVORI
        }
    )

    branch (
        name: Ostani na skladištu
        execution {
            sequence: 50
        }
        behavior {
            target: {
                page: 311
                items: {
                    P311_ID: &P311_ID.
                }
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE
        }
    )

)
