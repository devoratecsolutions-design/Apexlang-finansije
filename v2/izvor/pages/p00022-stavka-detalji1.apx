    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                stavke_pkg.update_stavka (
                    p_id               => :P22_ID,
                    p_ooj_id           => :APP_OOJ_ID,
                    p_tip_stavke_id    => :P22_TIP_STAVKE_ID,
                    p_grupa_id         => :P22_GRUPA_ID,
                    p_jm_id            => :P22_JM_ID,
                    p_naziv            => :P22_NAZIV,
                    p_sifra            => :P22_SIFRA,
                    p_marza            => :P22_MARZA,
                    p_klasa_id         => :P22_KLASA_ID,
                    p_pdv_indikator    => :P22_PDV_INDIKATOR,
                    p_pdv_indikator_id => :P22_PDV_INDIKATOR_ID,
                    p_ino_usluga       => :P22_INO_USLUGA,
                    p_serijski_broj    => :P22_SERIJSKI_BROJ,
                    p_valid            => :P22_VALID
                );
                
                IF :P22_NAZIV != :P22_NAZIV_OLD THEN
                    IF :P22_RETROAKTIVNO = 'Y' THEN
                        -- v2 (O-02): samo fakture koje nisu fiskalizovane ni proknjižene
                        UPDATE kif_stavke ks
                           SET naziv = :P22_NAZIV
                         WHERE ks.stavka_id = :P22_ID
                           AND EXISTS (SELECT 1 FROM kif k
                                        WHERE k.id = ks.kif_id
                                          AND k.glavna_knjiga_id IS NULL
                                          AND nvl(k.fiskalizovano, 'N') = 'N');
                    END IF;
                END IF;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 189206802055047292
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

