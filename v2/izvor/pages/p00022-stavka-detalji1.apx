            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @pracenje
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P22_ID
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT
                    1
                FROM
                    vw_skladiste_stavke
                WHERE
                    stavka_id = :P22_ID
                    AND stanje_kolicina > 0
                ```
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P22_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P22_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P22_ID
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 100
        }
        when {
            event: ready
        }

        action native-show (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function zameniX() {
                        var topWin = window.top;
                        var $ = topWin.apex.jQuery;
                        var btn = $('.ui-dialog-titlebar-close', topWin.document);
                    
                        if (btn.length) {
                            btn.off('click').on('click', function(e) {
                                e.preventDefault();
                                e.stopImmediatePropagation();
                    
                                apex.page.cancelWarnOnUnsavedChanges();
                                topWin.apex.navigation.dialog.close(true);
                            });
                        }
                    }
                    
                    var observer = new MutationObserver(zameniX);
                    observer.observe(window.top.document.documentElement, {
                        childList: true,
                        subtree: true,
                        attributes: true,
                        attributeFilter: ['style', 'class']
                    });
                    
                    zameniX();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction retroaktivna-izmjena (
        name: Retroaktivna izmjena
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P22_NAZIV
        }
        clientSideCondition {
            type: item!=value
            item: P22_NAZIV
            value: &P22_NAZIV_OLD.
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P22_RETROAKTIVNO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P22_RETROAKTIVNO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction toggle-pdv-indikator-id (
        name: Toggle / Pdv indikator ID
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P22_PDV_INDIKATOR
        }
        clientSideCondition {
            type: item=value
            item: P22_PDV_INDIKATOR
            value: N
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: :P22_PDV_INDIKATOR_ID := null;
                itemsToSubmit: P22_PDV_INDIKATOR_ID
                itemsToReturn: P22_PDV_INDIKATOR_ID
                showProcessing: true
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P22_PDV_INDIKATOR_ID
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P22_PDV_INDIKATOR_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction grupa-konta (
        name: Grupa - provjera konta
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P22_GRUPA_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_broj NUMBER;
                    BEGIN
                        :P22_GRUPA_INFO := NULL;
                        IF :P22_GRUPA_ID IS NOT NULL THEN
                            SELECT count(*) INTO l_broj
                              FROM sif.acc_grupe_stavki_konta
                             WHERE grupa_stavke_id = :P22_GRUPA_ID AND valid = 'Y';
                            IF l_broj = 0 THEN
                                :P22_GRUPA_INFO := 'Grupa nema podešena konta - fakture sa ovom stavkom se neće automatski proknjižiti.';
                            END IF;
                        END IF;
                    END;
                    ```
                itemsToSubmit: P22_GRUPA_ID
                itemsToReturn: P22_GRUPA_INFO
            }
            execution {
                sequence: 10
            }
        )

    )

    validation marza-pozitivna (
        name: Marža >= 0
        execution {
            sequence: 70
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                RETURN :P22_MARZA IS NULL
                    OR nvl(to_number(:P22_MARZA DEFAULT -1 ON CONVERSION ERROR), -1) >= 0;
                ```
        }
        error {
            errorMessage: Marža mora biti broj veći ili jednak nuli.
            associatedItem: @P22_MARZA
        }
    )

    validation sifra-jedinstvena (
        name: Šifra jedinstvena
        execution {
            sequence: 65
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM sec_stavke
                WHERE ooj_id = :APP_OOJ_ID
                  AND upper(trim(sifra)) = upper(trim(:P22_SIFRA))
                  AND id != nvl(:P22_ID, -1)
                ```
        }
        error {
            errorMessage: Stavka sa šifrom &P22_SIFRA. već postoji.
            associatedItem: @P22_SIFRA
        }
    )

    validation klasa-not-null (
        name: Klasa NOT NULL
        execution {
            sequence: 55
        }
        validation {
            type: itemIsNotNull
            item: P22_KLASA_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P22_KLASA_ID
        }
    )

    validation grupa-not-null (
        name: Grupa NOT NULL
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P22_GRUPA_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P22_GRUPA_ID
        }
        serverSideCondition {
            type: itemIsNotInColonDelimitedList
            item: APP_TIP_PREDUZETNIKA_SIFRA
            list: [
                msp
                vsp_prosto
            ]
        }
    )

    validation jm-not-null (
        name: JM NOT NULL
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P22_JM_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P22_JM_ID
        }
    )

    validation naziv-not-null (
        name: Naziv NOT NULL
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P22_NAZIV
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P22_NAZIV
        }
    )

    validation pdv-indikator-id-not-null (
        name: Pdv indikator ID NOT NULL
        execution {
            sequence: 80
        }
        validation {
            type: itemIsNotNull
            item: P22_PDV_INDIKATOR_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P22_PDV_INDIKATOR_ID
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P22_PDV_SISTEM = 'Y' AND :P22_PDV_INDIKATOR = 'N'
        }
    )

    validation pdv-indikator-not-null (
        name: Pdv indikator NOT NULL
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P22_PDV_INDIKATOR
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P22_PDV_INDIKATOR
        }
        serverSideCondition {
            type: item=value
            item: P22_PDV_SISTEM
            value: Y
        }
    )

    validation retroaktivno-not-null (
        name: Retroaktivno NOT NULL
        execution {
            sequence: 110
        }
        validation {
            type: itemIsNotNull
            item: P22_RETROAKTIVNO
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P22_RETROAKTIVNO
        }
        serverSideCondition {
            whenButtonPressed: @save
            type: expression
            plsqlExpression: :P22_NAZIV != :P22_NAZIV_OLD
        }
    )

    validation serijski-broj-not-null (
        name: Serijski broj NOT NULL
        execution {
            sequence: 100
        }
        validation {
            type: itemIsNotNull
            item: P22_SERIJSKI_BROJ
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P22_SERIJSKI_BROJ
        }
    )

    validation sifra-not-null (
        name: Sifra NOT NULL
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
            item: P22_SIFRA
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P22_SIFRA
        }
    )

    validation tip-stavke-not-null (
        name: Tip stavke NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P22_TIP_STAVKE_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P22_TIP_STAVKE_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 189205637703047291
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- v2: stavka iz dokumenata se ne briše (paket javlja poruku -20101)
                stavke_pkg.delete_stavka(p_id => :P22_ID);
                ```
        }
        execution {
