    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                stavke_pkg.get_stavka (
                    p_id               => :P22_ID,
                    p_ooj_id           => :P22_OOJ_ID,
                    p_tip_stavke_id    => :P22_TIP_STAVKE_ID,
                    p_grupa_id         => :P22_GRUPA_ID,
                    p_jm_id            => :P22_JM_ID,
                    p_naziv            => :P22_NAZIV,
                    p_sifra            => :P22_SIFRA,
                    p_marza            => :P22_MARZA,
                    p_klasa_id         => :P22_KLASA_ID,
                    p_pdv_indikator    => :P22_PDV_INDIKATOR,
                    p_pdv_indikator_id => :P22_PDV_INDIKATOR_ID,
                    p_ino_usluga       => :P22_INO_USLUGA,
                    p_serijski_broj    => :P22_SERIJSKI_BROJ,
                    p_valid            => :P22_VALID
                );

                :P22_NAZIV_OLD := :P22_NAZIV;
                :P22_PDV_SISTEM := nvl(core.ooj_pkg.get_ooj_pdv_sistem(:APP_OOJ_ID), 'N');

                IF :P22_ID IS NULL THEN
                    :P22_MARZA := 0;
                    :P22_SERIJSKI_BROJ := 'N';
                    IF :P22_PDV_SISTEM = 'Y' THEN
                        :P22_PDV_INDIKATOR := 'Y';
                    END IF;
                    -- v2: JM "kom" (O-07), klasa "Ostalo" (O-06) kao prijedlog
                    SELECT min(id) INTO :P22_JM_ID
                      FROM sif.acc_jedinice_mjere
                     WHERE valid = 'Y' AND lower(trim(naziv)) IN ('kom', 'kom.', 'komad');
                    :P22_KLASA_ID := stavke_pkg.klasa_ostalo(:APP_OOJ_ID);
                    -- šifra: najveća numerička + 1, najmanje 6 cifara (O-04)
                    :P22_SIFRA := stavke_pkg.sljedeca_sifra(:APP_OOJ_ID);
                END IF;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 189206016703047292
        }
    )

