page 22 (
    name: Stavka / Detalji
    alias: STAVKA-DETALJI1
    title: Stavka / Detalji
    pageGroup: @stavke
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region stavka-detalji (
        name: Stavka / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
    )

    region osnovno (
        name: Osnovni podaci
        title: Osnovni podaci
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @stavka-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region klasifikacija (
        name: Klasifikacija
        title: Klasifikacija
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @stavka-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region porez (
        name: Porez (PDV)
        title: Porez (PDV)
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @stavka-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
        serverSideCondition {
            type: item=value
            item: P22_PDV_SISTEM
            value: Y
        }
    )

    region pracenje (
        name: Praćenje i status
        title: Praćenje i status
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @stavka-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    pageItem P22_GRUPA_INFO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 30
            region: @klasifikacija
            slot: regionBody
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
            cssClasses: fin-warn-item
        }
    )

    pageItem P22_GRUPA_ID (
        type: selectOne
        label {
            label: Grupa za knjiženje
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @acc-grupe-stavki
        }
        layout {
            sequence: 20
            region: @klasifikacija
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotInColonDelimitedList
            item: APP_TIP_PREDUZETNIKA_SIFRA
            list: [
                msp
                vsp_prosto
            ]
        }
        help {
            helpText: Grupa određuje konta prihoda za automatsko knjiženje faktura. Konta se podešavaju u meniju Grupe za knjiženje.
        }
    )

    pageItem P22_ID (
