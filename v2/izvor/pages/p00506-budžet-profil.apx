    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @osnovne-informacije-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @osnovne-informacije-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P506_OJ_ID
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                budzet_pkg.get_budzet (
                    p_id           => :P506_BUDZET_ID,
                    p_broj_mjeseci => :P506_BROJ_MJESECI,
                    p_godina       => :P506_GODINA,
                    p_status_sifra => :P506_BUDZET_STATUS_SIFRA
                );
                
                
                IF :P506_OJ_ID IS NOT null THEN
                    budzet_pkg.get_budzet_oj (
                        p_budzet_id    => :P506_BUDZET_ID,
                        p_oj_id        => :P506_OJ_ID,
                        p_status_sifra => :P506_STATUS_SIFRA
                    );
                
                    budzet_pkg.get_budzet_oj (
                        p_budzet_id => :P506_BUDZET_ID,
                        p_oj_id     => :P506_OJ_ID,
                        p_max_iznos => :P506_MAX_IZNOS,
                        p_suma      => :P506_SUMA
                    );
                ELSE
                    budzet_pkg.get_budzet (
                        p_id        => :P506_BUDZET_ID,
                        p_max_iznos => :P506_MAX_IZNOS,
                        p_suma      => :P506_SUMA
                    );
                END IF;
                
                :P506_MAX_IZNOS := to_char(:P506_MAX_IZNOS, '999G999G999G999G990D00');
                :P506_SUMA := to_char(:P506_SUMA, '999G999G999G999G990D00');
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 145465627674621312
        }
    )

