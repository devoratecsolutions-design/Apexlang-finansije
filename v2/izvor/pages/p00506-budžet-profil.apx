page 506 (
    name: Profil
    alias: BUDŽET-PROFIL
    title: Profil
    pageGroup: @budžet
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region budžet-stavke (
        name: Budžet stavke
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    stavka_id,
                    oj_id,
                    projekat_id,
                    jan, 
                    feb, 
                    mar, 
                    apr, 
                    may, 
                    jun,
                    jul, 
                    aug, 
                    sep, 
                    oct, 
                    nov, 
                    dec,
                    coalesce(jan, 0) + coalesce(feb, 0) + coalesce(mar, 0) + coalesce(apr, 0) + coalesce(may, 0) + coalesce(jun, 0) +
                    coalesce(jul, 0) + coalesce(aug, 0) + coalesce(sep, 0) + coalesce(oct, 0) + coalesce(nov, 0) + coalesce(dec, 0) AS ukupno
                FROM (
                    SELECT 
                        stavka_id, 
                        oj_id,
                        projekat_id,
                        TO_CHAR(period,'MON', 'NLS_DATE_LANGUAGE=ENGLISH') AS mon,
                        iznos
                    FROM 
                        budzet_stavke bs
                    WHERE
                        budzet_id = :P506_BUDZET_ID
                        AND oj_id = :P506_OJ_ID
                        AND EXISTS (
                            SELECT
                                1
                            FROM
                                vw_budzet_oj oj
                            WHERE
                                bs.budzet_id = oj.budzet_id
                                AND bs.oj_id = oj.oj_id
                                AND oj.status_sifra != 10
                        )
                )
                PIVOT (
                    MAX(iznos) 
                    FOR mon IN ('JAN' AS JAN, 'FEB' AS FEB, 'MAR' AS MAR, 'APR' AS APR,
                                'MAY' AS MAY, 'JUN' AS JUN, 'JUL' AS JUL, 'AUG' AS AUG,
                                'SEP' AS SEP, 'OCT' AS OCT, 'NOV' AS NOV, 'DEC' AS DEC)
                )
                ORDER BY
                    oj_id,
                    stavka_id,
                    projekat_id
                ```
        }
        layout {
            sequence: 120
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P506_OJ_ID IS NOT null AND :P506_STATUS_SIFRA != 10
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        breakFormatting {
            reportSumLabel: Ukupno
        }
        heading {
            type: plsqlFunctionBody
            plsqlFunctionBody: RETURN budzet_pkg.get_column_headings(:P506_BROJ_MJESECI);
        }

