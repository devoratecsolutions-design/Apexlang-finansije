    region organizaciona-jedinica (
        name: Organizaciona jedinica
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    oj_naziv,
                    max_iznos,
                    stavke_sum,
                    status_naziv,
                    status_color_code
                FROM
                    vw_budzet_oj
                WHERE
                    budzet_id = :P506_BUDZET_ID
                    AND oj_id = :P506_OJ_ID
                ```
            pageItemsToSubmit: [
                P506_OJ_ID
                P506_BUDZET_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @left-side-wrapper
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P506_OJ_ID
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column MAX_IZNOS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Maksimalan iznos budžeta
            }
            layout {
                sequence: 30
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column OJ_NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Organizaciona jedinica
            }
            layout {
                sequence: 20
            }
        )

        column STATUS_COLOR_CODE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 60
            }
        )

        column STATUS_NAZIV (
            reportColumnQueryId: 5
            derivedColumn: N
