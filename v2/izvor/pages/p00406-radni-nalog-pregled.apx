                    collection_name = 'RN_RADNA_SNAGA'
                ```
        }
        layout {
            sequence: 40
            parentRegion: @radni-nalog-pregled
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
