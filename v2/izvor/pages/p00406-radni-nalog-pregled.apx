    region wizard-progress (
        name: Wizard Progress
        type: list
        source {
            list: @wizard-radni-nalog
        }
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @wizard-progress
            templateOptions: [
                #DEFAULT#
                js-wizardProgressLinks
                t-WizardSteps--displayLabels
            ]
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--danger
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button finish (
        buttonName: FINISH
        label: Završi
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Nazad
        layout {
            sequence: 20
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-chevron-left
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 151272036912362084
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR c_stavke IS (
                        SELECT
                            c001 AS stavka_id,
                            c002 AS jm_id,
                            to_number(c003) AS kolicina
                
                        FROM
                            apex_collections
                        WHERE
                            collection_name = 'RN_STAVKE'
                    );
                
                    CURSOR c_radna_snaga IS (
                        SELECT
                            c001 AS obrazovanje_id,
                            to_number(c002) AS broj_sati
                
                        FROM
                            apex_collections
                        WHERE
                            collection_name = 'RN_RADNA_SNAGA'
                    );
                
                    CURSOR c_troskovi IS (
                        SELECT
                            c001 AS opis,
                            to_number(c002) AS iznos
                
                        FROM
                            apex_collections
                        WHERE
                            collection_name = 'RN_TROSKOVI'
                    );
                
                    l_radni_nalog_id NUMBER;
                BEGIN
                    l_radni_nalog_id := proizvodnja_pkg.insert_radni_nalog (
                        p_ooj_id           => :APP_OOJ_ID,
                        p_radnik_id        => :APP_RADNIK_ID,
                        p_skladiste_id     => :P402_SKLADISTE_ID,
                        p_oj_id            => :P402_OJ_ID,
                        p_normativ_id      => :P402_NORMATIV_ID,
                        p_stavka_id        => :P402_STAVKA_ID,
                        p_naziv            => :P402_NAZIV,
                        p_broj             => :P402_BROJ,
                        p_kolicina         => :P402_KOLICINA,
                        p_godina           => :APP_GODINA,
                        p_datum            => :P402_DATUM,
                        p_opis             => :P402_OPIS
                    );
                
                    FOR c1 IN c_stavke LOOP
                        proizvodnja_pkg.insert_radni_nalog_stavka (
                            p_radni_nalog_id => l_radni_nalog_id,
                            p_stavka_id      => c1.stavka_id,
                            p_jm_id          => c1.jm_id,
                            p_kolicina       => c1.kolicina,
                            p_iznos          => null
                        );
                    END LOOP;
                
                    FOR c1 IN c_radna_snaga LOOP
                        proizvodnja_pkg.insert_radni_nalog_radna_snaga (
                            p_radni_nalog_id => l_radni_nalog_id,
                            p_obrazovanje_id => c1.obrazovanje_id,
                            p_broj_sati      => c1.broj_sati,
                            p_iznos          => null
                        );
                    END LOOP;
                
                    FOR c1 IN c_troskovi LOOP
                        proizvodnja_pkg.insert_radni_nalog_trosak (
                            p_radni_nalog_id => l_radni_nalog_id,
                            p_opis           => c1.opis,
                            p_iznos          => c1.iznos
                        );
                    END LOOP;
                
                
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 151942289631806230
        }
        serverSideCondition {
            whenButtonPressed: @finish
        }
    )

    branch (
        execution {
            sequence: 10
            point: validating
        }
        behavior {
            target: {
                page: 405
            }
        }
        serverSideCondition {
            whenButtonPressed: @previous
        }
    )

)

