page 406 (
    name: Radni nalog / Pregled
    alias: RADNI-NALOG-PREGLED
    title: Radni nalog / Pregled
    pageGroup: @proizvodnja
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        height: 400
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region osnovne-informacije (
        name: Osnovne informacije
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    :P402_NAZIV AS naziv,
                    :P402_NORMATIV AS normativ,
                    :P402_SKLADISTE_ID AS skladiste_id,
                    :P402_OJ_ID AS oj_id,
                    :P402_NORMATIV_ID AS normativ_id,
                    :P402_STAVKA_ID AS stavka_id,
                    :P402_KOLICINA AS kolicina,
                    :P402_DATUM AS datum,
                    :P402_OPIS AS opis
                FROM
                    dual
                ```
        }
        layout {
            sequence: 10
            parentRegion: @radni-nalog-pregled
            slot: subRegions
            columnSpan: 3
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }

        column DATUM (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 80
            }
        )

        column KOLICINA (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Količina
            }
            layout {
                sequence: 70
            }
        )

        column NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Radni nalog
            }
            layout {
                sequence: 10
            }
        )

        column NORMATIV (
            reportColumnQueryId: 2
