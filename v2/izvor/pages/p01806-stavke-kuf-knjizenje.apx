    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region referentne-fakture (
        name: Referentne fakture
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vk.godina, vk.broj, vk.datum_fakture, vk.datum_valute,vk.tip_dokumenta as vrsta_fakture, vk.partner_naziv, vk.pdv_indikator,vk.iznos_bez_pdv, vk.iznos_sa_pdv, vk.naziv_fakture, vk.kuf_id as dodaj_stavku 
                from vw_kufovi vk 
                join (select distinct n003 as dok_id
                      from apex_collections
                      where collection_name = 'SADRZAJ_GK_UF') kol on vk.kuf_id=kol.dok_id
                order by vk.datum_fakture
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 553464812658867503
        }

