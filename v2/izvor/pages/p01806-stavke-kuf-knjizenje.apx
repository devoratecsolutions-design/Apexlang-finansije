page 1806 (
    name: Stavke KUF-knjizenje
    alias: STAVKE-KUF-KNJIZENJE
    title: Stavke KUF-knjizenje
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1600
        height: 800
        maxWidth: 1600
    }
    navigation {
        cursorFocus: doNotFocusCursor
