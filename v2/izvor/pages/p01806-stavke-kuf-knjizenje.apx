    pageItem P1806_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @referentne-fakture
            slot: regionBody
        }
    )

    dynamicAction odabir-transakcije (
        name: Odabir transakcije
        execution {
            sequence: 10
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .add-st
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --dodajemo faktururu u templejt za knjiženje
                    for r in (select k.naziv_fakture as opis_transakcije,k.datum_fakture as datum_dokumenta, k.partner_id as partner,k.pdv_indikator_id as id_pdv_indikatora, k.pdv_indikator_sifra as sifra_pdv_indikatora, k.tip_dokumenta_sifra as vrsta_dokumenta, 
                                   k.valuta_id, k.iznos_bez_pdv, k.iznos_sa_pdv, k.kuf_id, 
                                   'Ulazne fakture - UF/'||k.broj||'/'||k.godina as dokument
                               from vw_kufovi k
                               where k.kuf_id=:P1806_ID)
                    loop
                       apex_collection.add_member(
                                p_collection_name => 'SADRZAJ_GK_UF',
                                p_c001 => r.opis_transakcije,
                                p_c002 => null,
                                p_c003 => null,
                                p_c004 => null,
                                p_c005 => 'D',
                                p_c006 => null,
                                p_c007 => r.valuta_id,
                                p_c008 => null,
                                p_c009 => r.dokument,
                                p_c010 => r.opis_transakcije,
                                p_n001 => r.iznos_sa_pdv,
                                p_n002 => 1,
                                p_n003 => r.kuf_id,
                                p_d001 => r.datum_dokumenta
                            ); 
                           
                    end loop;       
                    ```
                itemsToSubmit: P1806_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).parent().data('id');
            }
            affectedElements {
                selectionType: items
                items: P1806_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process zatvori-modal (
        name: Zatvori modal
        type: closeDialog
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 281242249895292804
        }
    )

)

