page 273 (
    name: Zaduživanje
    alias: ZADUŽIVANJE
    title: Zaduživanje
    pageGroup: @osnovna-sredstva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @osnovna-sredstva-pregled
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Stranica <b><em>“Zaduživanje”</em></b> namijenjena je za pregled zaduženih osnovnih sredstava, sredstava koja 
            su ostala evidentirana na radnicima koji više nisu zaposleni, kao i onih koja su trenutno 
            nezadužena, čime se omogućava jasan uvid u stanje i identifikacija sredstava koja je 
            potrebno dodijeliti. </br>
            </br>
            Nakon unosa zaduženja podaci se prikazuju u tabu <b><em>“Zadužena osnovna sredstva”.</em></b>
            Klikom na ikonicu pregleda otvara se stranica <b><em>“Osnovno sredstvo / Profil”</em></b> na kojoj su prikazani 
            svi relevantni podaci o sredstvu. </br>
            Odabirom opcije <b><em>“Transfer”</em></b> otvara se stranica <b><em>“Osnovno sredstvo / Zaduživanje”,</em></b>
            gdje su dostupne informacije o samom osnovnom sredstvu i radniku kojem je sredstvo dodijeljeno. </br>
            Ukoliko želite da izvršite pojedinačni transfer, potrebno je da izaberete novog 
            radnika kojem se sredstvo dodjeljuje i da unesete komentar ažuriranja, nakon čega se promjena potvrđuje. </br>
            </br>
            Klikom na dugme <b><em>“Grupni transfer”</em></b> otvara se modalni dijalog u kojem je potrebno odabrati 
            radnika sa kojeg se vrši transfer, označiti sredstva koja se prenose, definisati radnika 
            na kojeg se sredstva prebacuju, odabrati organizacionu jedinicu i unijeti komentar 
            ažuriranja, a zatim potvrditi izbor klikom na dugme <b><em>“Transfer”.</em></b>
            ```
    }

    region nezadužena-osnovna-sredstva-report (
        name: Nezadužena osnovna sredstva Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    naziv,
                    inventurni_naziv,
                    kolicina,
                
                    radnik_naziv,
                    oj_naziv,
                    lokacija_naziv,
                    prostorija_naziv,
                
                    apex_page.get_url (
                        p_page        => 274,
                        p_items       => 'P274_OSNOVNO_SREDSTVO_ID',
                        p_values      => id,
                        p_clear_cache => 274
                    ) AS transfer_link,
                
                    radnik_id,
                    oj_id,
                    lokacija_id,
                    prostorija_id
                FROM
                    vw_osnovna_sredstva
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND radnik_id IS null
                    AND history_id IS null
                    AND aktivirano = 'Y'
                    AND priprema = 'N'
                    AND valid = 'Y'
                ORDER BY
                    inventurni_broj DESC
                ```
        }
        layout {
            sequence: 20
            parentRegion: @nezadužena-osnovna-sredstva-wrapper
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        download {
            csvExportEnabled: true
        }
        printing {
            enabled: true
        }
        output {
            linkText: Print
            format: pdf
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Pregled
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 256
                    items: {
                        P256_ID: #ID#
                    }
                    clearCache: 256
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
