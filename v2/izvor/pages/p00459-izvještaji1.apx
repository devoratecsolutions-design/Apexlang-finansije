        }
    )

    process konto-uspjeh (
        name: Konto - Uspjeh
        type: executeCode
        executionChain: @generate
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR c_aop IS 
                        WITH
                        -- Fetch relevant acc_izvjestaji_aop rows for the given IZVJESTAJ_ID
                        relevant_aop AS (
                            SELECT 
                                id, 
                                naziv, 
                                aop, 
                                tip
                            FROM 
                                sif.acc_izvjestaji_aop
                            WHERE
                                izvjestaj_id = :P459_IZVJESTAJ_ID
                                AND tip = 'K'
                        ),
                        -- Aggregate ledger entries with filters
                        ledger_entries AS (
                            SELECT
                                kontna_klasa_code,
                                SUM(CASE 
                                    WHEN glavna_knjiga_datum_knjizenja BETWEEN TO_DATE(:P459_PERIOD_OD, 'DD.MM.YYYY') AND TO_DATE(:P459_PERIOD_DO, 'DD.MM.YYYY') THEN 
                                        iznos
                                    ELSE 
                                        0 
                                END) AS current_year,
                                SUM(CASE 
                                    WHEN glavna_knjiga_datum_knjizenja BETWEEN ADD_MONTHS(TO_DATE(:P459_PERIOD_OD, 'DD.MM.YYYY'), -12) AND ADD_MONTHS(TO_DATE(:P459_PERIOD_DO, 'DD.MM.YYYY'), -12) THEN 
                                        iznos
                                    ELSE 
                                        0 
                                END) AS previous_year
                            FROM 
                                vw_glavna_knjiga_stavke
                            WHERE 
                                glavna_knjiga_datum_knjizenja <= TO_DATE(:P459_PERIOD_DO, 'DD.MM.YYYY')
                                AND ooj_id = :APP_OOJ_ID
                                AND lower(vrsta_naloga_sifra) != 'pdv'
                                AND proknjizeno = 'Y'
                            GROUP BY 
                                kontna_klasa_code
                        ),
                
                        -- Process calculations for 'konto'
                        konto_calculations AS (
                            SELECT
                                ak.aop_id,
                                SUM(CASE
                                    WHEN ak.sum_tip = 'P' THEN abs(le.current_year)
                                    WHEN ak.sum_tip = 'M' THEN -(abs(le.current_year))
                                END) AS bruto,
                                
                                SUM(CASE
                                    WHEN ak.sum_tip = 'P' THEN abs(le.previous_year)
                                    WHEN ak.sum_tip = 'M' THEN -(abs(le.previous_year))
                                END) AS prethodna_godina
                                
                            FROM 
                                sif.acc_aop_konta ak
                                LEFT JOIN sif.acc_kontni_okvir_klase k ON ak.kontna_klasa_id = k.id
                                LEFT JOIN ledger_entries le ON le.kontna_klasa_code LIKE k.code || '%'
                            GROUP BY aop_id
                        ),
                        final_calculations AS (
                            SELECT
                                ra.id as aop_id,
                                ra.aop,
                                coalesce(kc.bruto, 0) AS bruto,
                                coalesce(kc.prethodna_godina, 0) AS prethodna_godina
                            FROM 
                                relevant_aop ra
                                LEFT JOIN konto_calculations kc ON ra.id = kc.aop_id
                        )
                        SELECT
                            aop_id,
                            bruto,
                            prethodna_godina
                        FROM
                            final_calculations;
                
                BEGIN
                    FOR c1 IN c_aop LOOP
                        izvjestaji_pkg.insert_izvjestaj_aop (
                            p_izvjestaj_id     => :P459_ID,
                            p_aop_id           => c1.aop_id,
                            p_bruto            => greatest(c1.bruto, 0),
                            p_ispravka         => null,
                            p_prethodna_godina => greatest(c1.prethodna_godina, 0)
                        );
                
                    END LOOP;
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 192246420358963513
        }
    )

