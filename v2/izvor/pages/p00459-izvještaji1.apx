page 459 (
    name: Izvještaji
    alias: IZVJEŠTAJI1
    title: Izvještaji
    pageGroup: @blagajna
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#jasper-server#MIN#.js
    }
    security {
        authorizationScheme: @blagajna-izvještaji
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Stranica <b><em>"Izvještaji"</em></b> kreirana je tako da povlači 
            sve izvještaje iz <b><em>"Glavne knjige."</em></b> 
            Izvještaji su grupisani po tabovima i klikom na određeni tab otvara se željeni izvještaj. </br>
            Za svaki izvještaj potrebno je unijeti određene parametre kako bi se prikazali rezultati.</br>
            </br>
            Najčešće se unose period od, period do, klasa konta, konto, organizaciona jedinica, klijenti, 
            vrsta naloga, PDV indikator i vrsta klijenta, ali se parametri razlikuju zavisno od izvještaja. </br>
            Nakon unosa podataka, izborom opcije <b><em>"Generiši"</em></b> izvještaj dobijate traženi prikaz.
            ```
    }

    region dnevni-promet-blagajne-dp (
        name: Dnevni promet blagajne - dp
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    blagajna_naziv,
                    dnevnik_datum,
                    tip_promjene_naziv,
                    radnik_naziv,
                    klijent_naziv,
                    oj_naziv,
                    tip,
                    CASE
                        WHEN tip = 'U' THEN
                            iznos
                        ELSE
                            0
                    END AS uplata,
                    CASE
                        WHEN tip = 'I' THEN
                            iznos
                        ELSE
                            0
                    END AS isplata,
                    CASE
                        WHEN tip = 'I' THEN
                            iznos
                        ELSE
                            -iznos
                    END AS iznos_sum
                
                
                FROM
                    vw_blagajna_dnevnik_stavke
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND godina = :APP_GODINA
                    AND zakljucano = 'Y'
                    AND dnevnik_datum = :P459_PERIOD_OD
                    AND (blagajna_id IN (
                        SELECT
                            column_value
                        FROM
                            apex_string.split(:P459_BLAGAJNA_ID, ':')
                    ) OR :P459_BLAGAJNA_ID IS null)
                ORDER BY
                    blagajna_naziv ASC,
                    dnevnik_datum DESC
                ```
            pageItemsToSubmit: [
                P459_BLAGAJNA_ID
                P459_PERIOD_OD
            ]
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: item=value
            item: P459_IZVJESTAJ_SIFRA
            value: dp
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        breakFormatting {
            reportSumLabel: Ukupno
        }

        column BLAGAJNA_NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Blagajna
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column DNEVNIK_DATUM (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column ISPLATA (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Isplata
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column IZNOS_SUM (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Iznos
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
