    region sastav (
        name: Sastav nabavne cijene
        title: Sastav nabavne cijene
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    i.vrsta,
                    i.naziv,
                    to_char(sum(r.iznos), 'FM999G999G999G990D00') AS iznos,
                    rtrim(rtrim(to_char(sum(r.iznos) / nullif(sum(ks.kolicina), 0), 'FM999G999G999G990D000000'), '0'), '.,') AS po_jedinici
                FROM kalkulacija_raspodjela r
                JOIN kalkulacija_stavke ks ON ks.id = r.kalkulacija_stavka_id
                JOIN vw_rm_kalkulacija_izvori i
                  ON i.kalkulacija_id = ks.kalkulacija_id
                 AND i.izvor = CASE WHEN r.kalkulacija_kuf_id IS NOT NULL THEN 'F:' || r.kalkulacija_kuf_id ELSE 'T:' || r.kalkulacija_trosak_id END
                WHERE ks.kalkulacija_id = :P341_ID
                  AND ks.stavka_id = :P341_ARTIKL
                GROUP BY i.vrsta, i.naziv, i.redoslijed
                ORDER BY i.redoslijed
                ```
            pageItemsToSubmit: [
                P341_ID
                P341_ARTIKL
            ]
        }
        layout {
            sequence: 20
            parentRegion: @tab-cijene
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
