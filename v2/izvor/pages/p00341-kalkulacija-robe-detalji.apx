    validation datum-obavezno (
        name: Datum obavezno
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P341_DATUM
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P341_DATUM
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P341_IZMJENJIVA = 'Y'
        }
    )

    process ucitaj (
        name: Učitavanje kalkulacije
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for k in (select * from vw_rm_kalkulacije where id = :P341_ID and ooj_id = :APP_OOJ_ID) loop
                    :P341_NAZIV            := k.naziv;
                    :P341_DATUM            := k.datum;
                    :P341_OPIS             := k.opis;
                    :P341_SKLADISTE_ID     := k.skladiste_id;
                    :P341_SKLADISTE        := k.skladiste;
                    :P341_ROBNO            := k.robno;
                    :P341_STATUS           := k.status;
                    :P341_STATUS_KLASA     := case when k.status = 'Z' then 'zakljucena' else 'priprema' end;
                    :P341_STATUS_NAZIV     := case when k.status = 'Z' then 'Zaključena' else 'U pripremi' end;
                    :P341_STATUS_IKONA     := case when k.status = 'Z' then 'fa-lock' else 'fa-pencil' end;
                    :P341_IZNOS_FAKTURA    := to_char(k.iznos_faktura, 'FM999G999G999G990D00');
                    :P341_IZNOS_TROSKOVA   := to_char(k.iznos_troskova, 'FM999G999G999G990D00');
                    :P341_UKUPNO           := to_char(k.iznos_faktura + k.iznos_troskova, 'FM999G999G999G990D00');
                    :P341_RASPOREDJENO     := to_char(k.nabavna_vrijednost, 'FM999G999G999G990D00');
                    :P341_RAZLIKA          := to_char(k.iznos_faktura + k.iznos_troskova - k.nabavna_vrijednost, 'FM999G999G999G990D00');
                    :P341_RAZLIKA_KLASA    := case when abs(k.iznos_faktura + k.iznos_troskova - k.nabavna_vrijednost) > 0.005 then 'greska' else 'ok' end;
                end loop;
                :P341_ADMIN := case when apex_authorization.is_authorized('MAIN ADMIN') then 'Y' else 'N' end;
                -- materijalno skladište nema prodajnih cijena
                :P341_TAB_CIJENE := case when :P341_ROBNO = 'Y' then 'Nabavne i prodajne cijene' else 'Nabavne cijene' end;
                :P341_RAZLOG := rm_kalkulacija_pkg.razlog_zabrane(:P341_ID);
                :P341_IZMJENJIVA := rm_kalkulacija_pkg.izmjenjiva(:P341_ID);
                :P341_RAZLOG_OTKLJ := rm_kalkulacija_pkg.razlog_zabrane_otkljucavanja(:P341_ID, :P341_ADMIN);
                :P341_SVE_RASP := rm_kalkulacija_pkg.sve_rasporedjeno(:P341_ID);
                -- zaključena kalkulacija: korisnik vidi i zašto se ne može otključati
                if :P341_STATUS = 'Z' and :P341_RAZLOG_OTKLJ is not null then
                    :P341_RAZLOG := :P341_RAZLOG || ' Otključavanje nije moguće: ' || :P341_RAZLOG_OTKLJ;
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P341_ID
        }
    )

    process nova (
        name: Nova kalkulacija - početne vrijednosti
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P341_IZMJENJIVA       := 'Y';
                :P341_STATUS           := 'P';
                :P341_STATUS_KLASA     := 'priprema';
                :P341_STATUS_NAZIV     := 'U pripremi';
                :P341_STATUS_IKONA     := 'fa-pencil';
                :P341_NAZIV            := 'Nova kalkulacija';
                :P341_DATUM            := nvl(:P341_DATUM, trunc(sysdate));
                :P341_SKLADISTE_ID     := :A_SKLADISTE_ID;
                :P341_RAZLOG_OTKLJ     := 'nova';
                :P341_SVE_RASP         := 'N';
                for s in (select sifra || ' - ' || naziv as n from skladista where id = :A_SKLADISTE_ID) loop
                    :P341_SKLADISTE := s.n;
                end loop;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNull
            item: P341_ID
        }
    )

    process snimi (
        name: Snimi zaglavlje
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P341_ID := rm_kalkulacija_pkg.snimi(
                    p_id               => :P341_ID,
                    p_ooj_id           => :APP_OOJ_ID,
                    p_godina           => :APP_GODINA,
                    p_skladiste_id     => nvl(:P341_SKLADISTE_ID, :A_SKLADISTE_ID),
                    p_datum            => :P341_DATUM,
                    p_nacin_raspodjele => 'V',
                    p_opis             => :P341_OPIS
                );
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Kalkulacija je snimljena.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P341_IZMJENJIVA = 'Y'
        }
    )

    process cijene-snimi (
        name: Cijene po artiklu - snimi
        type: executeCode
        editableRegion: @kalk-cijene
        source {
            plsqlCode:
                ```plsql
                begin
                    rm_kalkulacija_pkg.snimi_cijene_artikla(
                        p_id             => :P341_ID,
                        p_stavka_id      => kuf_pkg.broj(:ID),
                        p_marza_procenat => kuf_pkg.broj(:MARZA_PROCENAT),
                        p_vpc            => kuf_pkg.broj(:VPC),
                        p_mpc            => kuf_pkg.broj(:MPC)
                    );
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 11
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P341_IZMJENJIVA = 'Y' and :P341_SVE_RASP = 'Y' and :P341_ROBNO = 'Y'
        }
    )

    process prijemnice-snimi (
        name: Prijemnice - snimi redove
        type: executeCode
        editableRegion: @kalk-prijemnice
        source {
            plsqlCode:
                ```plsql
                begin
                    declare
                        l_id number := kuf_pkg.broj(:ID);
                    begin
                        if :APEX$ROW_STATUS = 'D' then
                            rm_kalkulacija_pkg.obrisi_prijemnicu_red(l_id);
                        else
                            rm_kalkulacija_pkg.snimi_prijemnicu_red(l_id, :P341_ID, kuf_pkg.broj(:OPERACIJA_ID));
                            :ID := l_id;
                        end if;
                    end;
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 12
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P341_IZMJENJIVA = 'Y'
        }
    )

    process kuf-snimi (
        name: Fakture - snimi redove
        type: executeCode
        editableRegion: @kalk-kuf
