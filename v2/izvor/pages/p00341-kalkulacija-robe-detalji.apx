    region izvori-panel (
        name: Fakture i troškovi
        title: Fakture i troškovi
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    izvor,
                    vrsta,
                    naziv,
                    CASE nacin WHEN 'V' THEN 'automatski – po vrijednosti' WHEN 'K' THEN 'automatski – po količini'
                               WHEN 'L' THEN 'automatski – linearno' WHEN 'J' THEN 'ručno – jedinična cijena'
                               WHEN 'P' THEN 'ručno – cijena sa prijemnice'
                               ELSE 'ručno – ukupan iznos' END AS nacin,
                    to_char(iznos, 'FM999G999G999G990D00') AS iznos,
                    to_char(rasporedjeno, 'FM999G999G999G990D00') AS rasporedjeno,
                    rasporedjen
                FROM vw_rm_kalkulacija_izvori
                WHERE kalkulacija_id = :P341_ID
                ORDER BY redoslijed
                ```
            pageItemsToSubmit: P341_ID
        }
        layout {
            sequence: 10
            parentRegion: @tab-raspodjela
            slot: subRegions
            columnSpan: 4
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
            cssClasses: fin-section fin-kalk-izvori
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Dodajte fakture ili zavisne troškove na prvom tabu.
        }
        advanced {
            htmlDomId: kalk_izvori
        }

