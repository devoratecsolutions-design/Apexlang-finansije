        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    apex_util.prn(rm_kalkulacija_pkg.izvor_json(:P341_ID, apex_application.g_x01), false);
                exception
                    when others then
                        sys.htp.p('{"greska":"' || apex_escape.json(regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-RM: )?', '')) || '"}');
                end;
                ```
