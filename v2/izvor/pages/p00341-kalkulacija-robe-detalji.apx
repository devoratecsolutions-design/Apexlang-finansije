page 341 (
    name: Kalkulacija
    alias: KALKULACIJA-ROBE-DETALJI
    title: Kalkulacija
    pageGroup: @robno-materijalno
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            finRmKalk.init('P341');
            ```
    }
    security {
        authorizationScheme: @robno-materijalno-kalkulacije-robe
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region kalkulacija-naslov (
        name: Kalkulacija
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region kalk-traka (
        name: Traka kalkulacije
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="fin-docbar">
                  <span class="fin-docbar__no">&P341_NAZIV.</span>
                  <span class="fin-status fin-status--&P341_STATUS_KLASA."><span class="fa &P341_STATUS_IKONA." aria-hidden="true"></span>&P341_STATUS_NAZIV.</span>
                  <span class="fin-docbar__meta">&P341_SKLADISTE.</span>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region zakljucana (
        name: Kalkulacija se ne može mijenjati
        type: staticContent
        source {
            htmlCode: &P341_RAZLOG.
        }
        layout {
            sequence: 7
            slot: body
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P341_ID is not null and :P341_IZMJENJIVA = 'N'
        }
    )

    region kalk-detalji (
        name: Kalkulacija / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
        readOnly {
            type: expression
            plsqlExpression: :P341_IZMJENJIVA = 'N'
        }
    )

    region osnovno (
        name: Osnovni podaci
        title: Osnovni podaci
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @kalk-detalji
            slot: subRegions
            columnSpan: 6
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region pregled (
        name: Pregled iznosa
        title: Pregled iznosa
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="fin-kalk-zbir"><div class="fin-kalk-zbir__k"><span>Fakture</span><b id="kzFak">&P341_IZNOS_FAKTURA.</b></div><div class="fin-kalk-zbir__k"><span>Zavisni troškovi</span><b id="kzTr">&P341_IZNOS_TROSKOVA.</b></div><div class="fin-kalk-zbir__k fin-kalk-zbir__k--glavni"><span>Za raspodjelu</span><b id="kzUk">&P341_UKUPNO.</b></div><div class="fin-kalk-zbir__k"><span>Raspoređeno</span><b id="kzRas">&P341_RASPOREDJENO.</b></div><div id="kzRazK" class="fin-kalk-zbir__k fin-kalk-zbir__k--&P341_RAZLIKA_KLASA."><span>Razlika</span><b id="kzRaz">&P341_RAZLIKA.</b></div></div>
                ```
        }
        layout {
            sequence: 20
            parentRegion: @kalk-detalji
            slot: subRegions
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P341_ID
        }
    )

    region kalk-tabovi (
        name: Tabovi
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
                js-useLocalStorage
            ]
            cssClasses: fin-kalk-tabovi
        }
    )

    region tab-dokumenti (
        name: Prijemnice, fakture i troškovi
        title: Prijemnice, fakture i troškovi
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @kalk-tabovi
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-form fin-kalk-tab
        }
    )

    region tab-raspodjela (
        name: Raspodjela
        title: Raspodjela
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @kalk-tabovi
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-form fin-kalk-tab
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P341_ID
        }
    )

    region tab-cijene (
        name: Nabavne i prodajne cijene
        title: &P341_TAB_CIJENE.
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @kalk-tabovi
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-form fin-kalk-tab
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P341_ID
        }
    )

    region prijemnice-sekcija (
        name: Prijemnice
        title: Prijemnice
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @tab-dokumenti
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region kalk-prijemnice (
        name: Prijemnice - tabela
        title: Prijemnice - tabela
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    ko.id,
                    ko.operacija_id,
                    to_char(o.datum, 'DD.MM.YYYY') AS datum,
                    o.klijent_naziv AS dobavljac,
                    to_char(o.iznos, 'FM999G999G999G990D00') AS vrijednost
                FROM kalkulacija_operacije ko
                JOIN vw_rm_dokumenti o ON o.id = ko.operacija_id
                WHERE ko.kalkulacija_id = :P341_ID
                ORDER BY o.datum, o.id
                ```
            pageItemsToSubmit: [
                P341_ID
                P341_SKLADISTE_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @prijemnice-sekcija
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ig
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Dodajte prijemnice (u pripremi) sa skladišta čija se nabavna vrijednost računa.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = "Dodaj prijemnicu"; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("search");
                    toolbarData.toolbarRemove("actions");
                    
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: false, autoAddRecord: false };
                    if (options.editable) { options.editable.autoAddRow = false; }
                    return options;
                }
                ```
        }
        advanced {
            htmlDomId: kalk_prijemnice
            savedReportMappingIdentifier: 34100000000051
        }
        readOnly {
            type: expression
            plsqlExpression: :P341_IZMJENJIVA = 'N'
        }

