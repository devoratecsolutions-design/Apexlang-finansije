    region troskovi-sekcija (
        name: Zavisni troškovi
        title: Zavisni troškovi
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @tab-dokumenti
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region kalk-troskovi (
        name: Zavisni troškovi - tabela
        title: Zavisni troškovi - tabela
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    t.id,
                    t.kuf_id,
                    nvl(t.sa_pdv, 'N') AS sa_pdv,
                    CASE WHEN t.kuf_id IS NOT NULL
                         THEN to_char(rm_kalkulacija_pkg.kuf_raspolozivo(t.kuf_id, nvl(t.sa_pdv, 'N'), null, t.id), 'FM999G999G999G990D00')
                    END AS raspolozivo,
                    t.opis,
                    nvl(t.nacin_raspodjele, 'V') AS nacin_raspodjele,
                    CASE WHEN rm_kalkulacija_pkg.izvor_rasporedjen(null, t.id) = 'Y' THEN '✓ raspoređeno' ELSE 'nije raspoređeno' END AS stanje,
                    to_char(t.iznos, 'FM999G999G999G990D00') AS iznos
                FROM kalkulacija_troskovi t
                WHERE t.kalkulacija_id = :P341_ID
                ORDER BY t.id
                ```
            pageItemsToSubmit: [
                P341_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @troskovi-sekcija
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ig
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Prevoz, carina, osiguranje... Izaberite ulaznu fakturu troška ili ostavite fakturu praznu i upišite opis i iznos (npr. vlastiti prevoz).
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = "Dodaj trošak"; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("search");
                    toolbarData.toolbarRemove("actions");
                    
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: false, autoAddRecord: false };
                    if (options.editable) { options.editable.autoAddRow = false; }
                    return options;
                }
                ```
        }
