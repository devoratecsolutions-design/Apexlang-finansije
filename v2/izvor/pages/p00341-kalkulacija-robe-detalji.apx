                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P341_IZMJENJIVA = 'Y'
        }
    )

