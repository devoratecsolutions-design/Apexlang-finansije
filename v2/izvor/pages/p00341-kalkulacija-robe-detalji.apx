    region kalk-cijene (
        name: Cijene po artiklu - tabela
        title: Cijene po artiklu - tabela
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    ks.stavka_id AS id,
                    st.sifra || ' - ' || st.naziv AS artikal,
                    jm.naziv AS jm_naziv,
                    rtrim(to_char(sum(ks.kolicina), 'FM999G999G999G990D999999'), '.,') AS kolicina,
                    rtrim(rtrim(to_char(max(ks.nabavna_cijena), 'FM999G999G999G990D000000'), '0'), '.,') AS nabavna_cijena,
                    to_char(sum(ks.nabavna_vrijednost), 'FM999G999G999G990D00') AS nabavna_vrijednost,
                    rtrim(rtrim(to_char(max(ks.marza_procenat), 'FM999G990D9999'), '0'), '.,') AS marza_procenat,
                    rtrim(rtrim(to_char(max(ks.vpc), 'FM999G999G999G990D0000'), '0'), '.,') AS vpc,
                    rtrim(rtrim(to_char(max(ks.pdv_stopa), 'FM990D99'), '0'), '.,') AS pdv_stopa,
                    to_char(max(ks.mpc), 'FM999G999G999G990D00') AS mpc
                FROM kalkulacija_stavke ks
                JOIN sec_stavke st ON st.id = ks.stavka_id
                LEFT JOIN sif.acc_jedinice_mjere jm ON jm.id = st.jm_id
                WHERE ks.kalkulacija_id = :P341_ID
                GROUP BY ks.stavka_id, st.sifra, st.naziv, jm.naziv
                ORDER BY st.sifra
                ```
            pageItemsToSubmit: [
                P341_ID
                P341_ROBNO
            ]
        }
        layout {
            sequence: 10
            parentRegion: @cijene-sekcija
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ig
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        messages {
            whenNoDataFound: Artikli se pojavljuju kad se dodaju prijemnice.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = ""; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("search");
                    toolbarData.toolbarRemove("actions");
                    toolbarData.toolbarRemove("selection-add-row");
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: false, autoAddRecord: false };
                    if (options.editable) { options.editable.autoAddRow = false; }
                    return options;
                }
                ```
        }
