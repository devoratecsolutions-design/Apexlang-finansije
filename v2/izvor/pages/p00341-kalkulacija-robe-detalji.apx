    process ajax-rasp-snimi (
        name: RASP_SNIMI
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_art apex_t_varchar2 := apex_t_varchar2();
                    l_izn apex_t_varchar2 := apex_t_varchar2();
                begin
                    for i in 1 .. apex_application.g_f01.count loop
                        apex_string.push(l_art, apex_application.g_f01(i));
                        apex_string.push(l_izn, apex_application.g_f02(i));
                    end loop;
                    apex_util.prn(rm_kalkulacija_pkg.snimi_raspodjelu_izvora(:P341_ID, apex_application.g_x01, l_art, l_izn), false);
                exception
                    when others then
                        sys.htp.p('{"greska":"' || apex_escape.json(regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-RM: )?', '')) || '"}');
                end;
                ```
