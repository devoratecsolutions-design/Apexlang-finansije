                databaseColumn: OPERACIJA_ID
                dataType: number
            }
            validation {
                valueRequired: true
            }
        )

        column DATUM (
            type: textField
            heading {
                heading: Datum
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: DATUM
                dataType: varchar2
                queryOnly: true
            }
        )

        column DOBAVLJAC (
            type: textField
            heading {
                heading: Dobavljač
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: DOBAVLJAC
                dataType: varchar2
                queryOnly: true
            }
        )

        column VRIJEDNOST (
            type: textField
            heading {
                heading: Vrijednost prijemnice
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                databaseColumn: VRIJEDNOST
                dataType: varchar2
                queryOnly: true
            }
        )

    )

    region fakture-sekcija (
        name: Ulazne fakture
        title: Ulazne fakture
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @tab-dokumenti
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region kalk-kuf (
        name: Ulazne fakture - tabela
        title: Ulazne fakture - tabela
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    kk.id,
                    kk.kuf_id,
                    kk.sa_pdv,
                    nvl(kk.nacin_raspodjele, 'V') AS nacin_raspodjele,
                    CASE WHEN rm_kalkulacija_pkg.izvor_rasporedjen(kk.id, null) = 'Y' THEN '✓ raspoređeno' ELSE 'nije raspoređeno' END AS stanje,
                    to_char(rm_kalkulacija_pkg.kuf_raspolozivo(kk.kuf_id, kk.sa_pdv, kk.id), 'FM999G999G999G990D00') AS raspolozivo,
                    to_char(kk.iznos, 'FM999G999G999G990D00') AS iznos
                FROM kalkulacija_kuf kk
                WHERE kk.kalkulacija_id = :P341_ID
                ORDER BY kk.id
                ```
            pageItemsToSubmit: [
                P341_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @fakture-sekcija
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ig
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Dodajte zaključene ulazne fakture za robu i iznos koji se raspoređuje. Fakture za prevoz, carinu i sl. dodajte kao zavisne troškove.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = "Dodaj fakturu"; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("search");
                    toolbarData.toolbarRemove("actions");
                    
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: false, autoAddRecord: false };
                    if (options.editable) { options.editable.autoAddRow = false; }
                    return options;
                }
                ```
        }
        advanced {
            htmlDomId: kalk_kuf
            savedReportMappingIdentifier: 34100000000011
        }
        readOnly {
            type: expression
            plsqlExpression: :P341_IZMJENJIVA = 'N'
        }

