    region niste-izabrali-skladište (
        name: Niste izabrali prodajno mjesto
        type: staticContent
        layout {
            sequence: 80
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--wizard
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if :A_SKLADISTE_ID is null then
                
                        return true;
                
                else 
                        return false;
                
                end if;
                ```
        }
    )

    region potrebna-konfiguracija (
        name: Potrebna konfiguracija
        type: staticContent
        source {
            htmlCode: Neophodno je da konfigurišete formu numeracije dokumenata.
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: RETURN NOT core.protokoli_pkg.check_brojac(:APP_OOJ_ID, 'if', :APP_GODINA);
        }
    )

    region pretraga (
        name: Pretraga
        type: smartFilters
        source {
            filteredRegion: @izlazne-fakture-report
        }
        layout {
            sequence: 5
            parentRegion: @wrapper
            slot: subRegions
            columnSpan: 9
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P50_SEARCH (
            type: search
            label {
                label: Pretraga
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga po broju, kupcu, iznosu...
            }
        )

        filter P50_PORESKI_PERIOD (
            type: checkboxGroup
            label {
                label: Period
            }
            lov {
                type: sharedComponent
                lov: @poreski-period-char
            }
            layout {
                sequence: 20
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: PORESKI_PERIOD
            }
        )

        filter P50_NAPLATA (
            type: checkboxGroup
            label {
                label: Naplata
            }
            lov {
                type: staticValues
                staticValues: STATIC2:Naplaćena;paid,Djelimično;partial,Nenaplaćena;open,Dospjela;overdue,Predračun;na,Stornirana;void
            }
            layout {
                sequence: 30
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: NAPLATA_STATUS
            }
        )

        filter P50_KLIJENT_ID (
