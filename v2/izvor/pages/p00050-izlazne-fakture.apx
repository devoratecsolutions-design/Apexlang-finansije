page 50 (
    name: Izlazne fakture
    alias: IZLAZNE-FAKTURE
    title: Izlazne fakture
    pageGroup: @fakture-računi
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#jasper-server#MIN#.js
    }
    security {
        authorizationScheme: @fakture-kif
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            U okviru modula <b><em>„Finansije”</em></b>, na stranici <b><em>„Fakture i računi”</em></b>, korisnicima je dostupna funkcionalnost 
            rada sa izlaznim fakturama. Kreirane fakture se mogu filtrirati po parametrima unosa i periodima 
            u kojima su kreirane.</br>
            </br>
            Na stranici Izlazne fakture nalaze se kolone <b>Izvod</b> i <b>Ručno</b> koje 
            omogućavaju pregled načina plaćanja svake fakture. </br> 
            Klikom na iznos u koloni <b>Izvod</b> otvara se dijalog u kojem se prikazuje detaljan 
            pregled plaćanja fakture putem izvoda a klikom na iznos u koloni <b>Ručno</b> otvara se 
            dijalog koji prikazuje prethodno uplaćen iznos i omogućava unos dodatnog 
            iznosa koji je eventualno sada uplaćen, pri čemu se krajnje stanje automatski izračunava kao zbir 
            oba iznosa. </br>
            </br>
            Ukoliko želite ubrzati proces kreiranja fakture koja je već ranije izrađena, 
            i ponovo koristiti slične unose kao na prethodnoj fakturi za određenog klijenta, 
            kliknite na dugme <b><em>„Kopiraj”</em></b>. </br>
            </br>
            Pomoću dugmadi <b><em>„El. štampa”</em></b> i <b><em>„Štampa”</em></b> možete odštampati fakturu, 
            dok se opcija <b><em>„Edit”</em></b> koristi za ažuriranje postojeće fakture — 
            klikom na nju otvara se modalni dijalog sa svim dostupnim poljima za izmjene.
            ```
    }

    region izlazne-fakture (
        name: Izlazne fakture
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region izlazne-fakture-report (
        name: Izlazne fakture Report
        title: Izlazne fakture
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    klijent_naziv,
                    naziv_fakture,
                    datum_fakture,
                    datum_valute,
                    iznos_fakture_nopdv,
                    iznos_fakture,
                    uio_kif_count,
                    uplaceno,
                    uplaceno_izvod,
                    CASE
                        WHEN uplaceno_izvod >= iznos_fakture THEN
                            'is-paid'
                        WHEN uplaceno_izvod > 0 THEN
                            'is-partial'
                        ELSE
                            'is-zero'
                    END AS uplaceno_izvod_color_code,
                    uplaceno_rucno,
                    CASE
                        WHEN uplaceno_rucno >= iznos_fakture THEN
                            'is-paid'
                        WHEN uplaceno_rucno > 0 THEN
                            'is-partial'
                        ELSE
                            'is-zero'
                    END AS uplaceno_rucno_color_code,
                
                
                    vrsta_fakture_naziv,
                    glavna_knjiga_id,
                    klijent_id,
                    to_char(trunc(datum_fakture, 'MM'), 'MM.YYYY') as poreski_period,
                    CASE 
                        WHEN glavna_knjiga_id IS null THEN 
                            apex_page.get_url (
                                p_page        => 60,
                                p_items       => 'P60_ID,P60_VIEW_ONLY,P60_ORIG',
                                p_values      => id || ',N,50',
                                p_clear_cache => 60
                            )
                        ELSE 
                            null
                    END AS proknjizeno,
                    created_by,
                
                    apex_page.get_url (
                        p_page        => 51,
                        p_items       => 'P51_COPY_ID,P51_ORIG',
                        p_values      => '' || id || ',50',
                        p_request     => 'copy',
                        p_clear_cache => '51,52,53'
                    ) as copy_link,
                
                
                    vrsta_fakture_id,
                    system,
                    stornirano,
                    fiskalizovano,
                    faktura_broj,
                    oj_id,
                    -- v2: kolone za Smart Filters i prikaz statusa
                    nvl2(glavna_knjiga_id, 'Y', 'N') AS proknjizeno_dn,
                    CASE
                        WHEN stornirano = 'Y' THEN 'void'
                        WHEN je_predracun = 'Y' THEN 'na'
                        WHEN uplaceno = 'Y'
                          OR nvl(uplaceno_izvod, 0) + nvl(uplaceno_rucno, 0) >= iznos_fakture THEN 'paid'
                        WHEN nvl(uplaceno_izvod, 0) + nvl(uplaceno_rucno, 0) > 0 THEN 'partial'
                        WHEN datum_valute < trunc(sysdate) THEN 'overdue'
                        ELSE 'open'
                    END AS naplata_status,
                    CASE
                        WHEN stornirano = 'Y' THEN 'Stornirana'
                        WHEN je_predracun = 'Y' THEN 'Predračun'
                        WHEN uplaceno = 'Y'
                          OR nvl(uplaceno_izvod, 0) + nvl(uplaceno_rucno, 0) >= iznos_fakture THEN 'Naplaćena'
                        WHEN nvl(uplaceno_izvod, 0) + nvl(uplaceno_rucno, 0) > 0 THEN 'Djelimično'
                        WHEN datum_valute < trunc(sysdate) THEN 'Dospjela ' || to_char(trunc(sysdate) - trunc(datum_valute)) || ' d'
                        ELSE 'Nenaplaćena'
                    END AS naplata_label,
                    CASE WHEN uio_kif_count > 0 THEN 'Y' ELSE 'N' END AS uio_dn
                FROM
                    (
                        SELECT
                            k.*,
                            (
                                SELECT
                                    CASE WHEN lower(vn.sifra) = 'pr' THEN 'Y' ELSE 'N' END
                                FROM
                                    sif.vrste_dokumenata vd
                                    JOIN sif.sif_vrste_naloga vn ON vn.id = vd.vrsta_naloga_id
                                WHERE
                                    vd.id = k.vrsta_fakture_id
                            ) AS je_predracun
                        FROM
                            vw_kif k
                    )
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND godina = :APP_GODINA
                    and (skladiste_id = :A_SKLADISTE_ID)
                ORDER BY
                    datum_fakture DESC, faktura_broj DESC
                ```
        }
        orderBy {
            type: item
            item: {
                itemName: P50_ORDER_BY
                orderBys: {
                    FAKTURA_BROJ1: faktura_broj DESC
                    FAKTURA_BROJ: faktura_broj ASC
                    DATUM_FAKTURE1: datum_fakture DESC
                    DATUM_FAKTURE: datum_fakture ASC
                    DATUM_VALUTE1: datum_valute DESC
                    DATUM_VALUTE: datum_valute ASC
                }
            }
        }
        layout {
            sequence: 10
            parentRegion: @wrapper
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema faktura za izabrane filtere.
        }
        breakFormatting {
            reportSumLabel: Ukupno
        }

        column COPY_LINK (
            reportColumnQueryId: 20
            derivedColumn: N
            heading {
                heading: Akcije
            }
            layout {
                sequence: 100
            }
            columnFormatting {
                cssClasses: fin-col-actions
                htmlExpression:
                    ```html
                    <span class="fin-actions">
                    {if ?COPY_LINK/}<a class="fin-act" href="#COPY_LINK#" title="Kopiraj u novu fakturu" aria-label="Kopiraj u novu fakturu"><span class="fa fa-copy" aria-hidden="true"></span></a>{endif/}
                    <button type="button" class="fin-act js-print-el" data-id="#ID#" title="Elektronska štampa (PDF)" aria-label="Elektronska štampa"><span class="fa fa-print" aria-hidden="true"></span></button>
                    <button type="button" class="fin-act js-print-potpis" data-id="#ID#" title="Štampa sa potpisom" aria-label="Štampa sa potpisom"><span class="fa fa-file-signature" aria-hidden="true"></span></button>
                    </span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column CREATED_BY (
            reportColumnQueryId: 19
            derivedColumn: N
            type: hidden
            layout {
                sequence: 220
            }
        )

        column DATUM_FAKTURE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
