            }
            layout {
                sequence: 70
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: PROKNJIZENO_DN
            }
        )

        filter P50_FISKALIZOVANO (
            type: radioGroup
            label {
                label: Fiskalizovano
            }
            lov {
                type: sharedComponent
                lov: @da-ne
            }
            layout {
                sequence: 80
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: FISKALIZOVANO
            }
        )

        filter P50_STORNIRANO (
            type: radioGroup
            label {
                label: Stornirano
            }
            lov {
                type: sharedComponent
                lov: @da-ne
            }
            layout {
                sequence: 90
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: STORNIRANO
            }
        )

        filter P50_SYSTEM (
            type: radioGroup
            label {
                label: Sistemska faktura
            }
            lov {
                type: sharedComponent
                lov: @da-ne
            }
            layout {
                sequence: 100
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: SYSTEM
            }
            serverSideCondition {
                type: item=value
                item: P50_ESSCOM_OOJ_ID
                value: &APP_OOJ_ID.
            }
        )

    )

    region sortiranje (
        name: Sortiranje
        type: staticContent
        layout {
            sequence: 6
            parentRegion: @wrapper
            slot: subRegions
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: fin-sort
        }
    )

    region wrapper (
        name: Wrapper
        type: staticContent
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: return core.protokoli_pkg.check_brojac(:APP_OOJ_ID, 'if', :APP_GODINA);
        }
    )

