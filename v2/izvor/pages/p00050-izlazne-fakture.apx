    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @izlazne-fakture-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @izlazne-fakture-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-2 (
        name: Dialog Closed - Refresh 2
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @izlazne-fakture-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction print-elektronski (
        name: Print - Elektronski
        execution {
            sequence: 70
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .js-print-el
        }
        config {
            buildOption: @feature-printing
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    finansije_pkg.get_kif (
                        p_id            => :P50_KIF_ID,
                        p_naziv_fakture => :P50_FILENAME
                    );
                    
                    :P50_FILENAME := :P50_FILENAME || '.pdf';
                    ```
                itemsToSubmit: [
                    P50_KIF_ID
                    P50_FILENAME
                ]
                itemsToReturn: [
                    P50_KIF_ID
                    P50_FILENAME
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    generate_report(
                        filename = $v("P50_FILENAME"), 
                        report_path = '/reports/ACCOUNTING/kif' + $v("P50_PATH"), 
                        report_parameters = {
                            ID: $v("P50_KIF_ID"),
                            POTPIS: "N"
                        },
                        new_tab = true
                    );
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).data('id')
            }
            affectedElements {
                selectionType: items
                items: P50_KIF_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction print-potpis (
        name: Print - Potpis
        execution {
            sequence: 80
            eventScope: dynamic
        }
        when {
