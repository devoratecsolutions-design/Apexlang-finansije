    computation p50-path (
        itemName: P50_PATH
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    obrazac_fakture_path
                FROM
                    core.vw_firme
                WHERE
                    id = :APP_FIRMA_ID
                ```
        }
    )

    process ooj-id (
        name: OOJ ID
        type: executeCode
        source {
            plsqlCode: :P50_ESSCOM_OOJ_ID := apex_app_setting.get_value('ESSCOM_OOJ_ID');
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 157139849553744086
        }
    )

