                        filename = $v("P50_FILENAME"), 
                        report_path = '/reports/ACCOUNTING/kif' + $v("P50_PATH"), 
                        report_parameters = {
                            ID: $v("P50_KIF_ID"),
                            POTPIS: "Y"
                        },
                        new_tab = true
                    );
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).data('id')
            }
            affectedElements {
                selectionType: items
                items: P50_KIF_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

