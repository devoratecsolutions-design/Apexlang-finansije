            label: Status Id
            alignment: right
        }
        layout {
            sequence: 40
            region: @radni-nalog-hist
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
