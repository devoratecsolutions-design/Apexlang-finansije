            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @radni-nalog-hist
            column: RADNI_NALOG_ID
            dataType: number
        }
    )

    pageItem P412_ROWID (
        type: hidden
        layout {
            sequence: 10
            region: @radni-nalog-hist
            slot: regionBody
        }
        source {
            formRegion: @radni-nalog-hist
            column: ROWID
            dataType: varchar2
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P412_ROW_VERSION (
        type: numberField
