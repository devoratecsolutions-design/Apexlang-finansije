page 412 (
    name: Radni Nalog Hist
    alias: RADNI-NALOG-HIST
    title: Radni Nalog Hist
    pageGroup: @proizvodnja
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region radni-nalog-hist (
        name: Radni Nalog Hist
        type: form
        source {
            location: localDatabase
            tableName: RADNI_NALOG_HIST
            includeRowidColumn: true
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P412_CREATED (
        type: datePicker
        label {
            label: Created
            alignment: left
        }
        layout {
            sequence: 80
            region: @radni-nalog-hist
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @radni-nalog-hist
            column: CREATED
            dataType: date
        }
    )

    pageItem P412_CREATED_BY (
        type: textField
        label {
            label: Created By
            alignment: left
        }
        layout {
            sequence: 90
            region: @radni-nalog-hist
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @radni-nalog-hist
            column: CREATED_BY
            dataType: varchar2
        }
    )

    pageItem P412_ID (
        type: numberField
        label {
            label: Id
            alignment: left
        }
        layout {
            sequence: 20
            region: @radni-nalog-hist
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @radni-nalog-hist
            column: ID
            dataType: number
        }
    )

    pageItem P412_KOMENTAR (
        type: textarea
        label {
            label: Komentar
            alignment: right
        }
        layout {
            sequence: 60
            region: @radni-nalog-hist
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @radni-nalog-hist
            column: KOMENTAR
            dataType: varchar2
        }
    )

    pageItem P412_RADNIK_ID (
        type: numberField
        label {
            label: Radnik Id
            alignment: right
        }
        layout {
            sequence: 50
            region: @radni-nalog-hist
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @radni-nalog-hist
