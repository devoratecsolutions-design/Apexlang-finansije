            region: @radni-nalog-hist
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @radni-nalog-hist
            column: ROW_VERSION
            dataType: number
        }
    )

    pageItem P412_STATUS_ID (
        type: numberField
