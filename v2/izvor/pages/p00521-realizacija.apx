page 521 (
    name: Realizacija
    alias: REALIZACIJA
    title: Realizacija
    pageGroup: @budžet
    appearance {
        pageTemplate: @left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#left-side-toggle#MIN#.js
    }
    css {
        fileUrls: #WORKSPACE_FILES#left-side-toggle#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region budžet-stavke (
        name: Budžet stavke
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    stavka_id,
                    oj_id,
                    projekat_id,
                    jan, 
                    feb, 
                    mar, 
                    apr, 
                    may, 
                    jun,
                    jul, 
                    aug, 
                    sep, 
                    oct, 
                    nov, 
                    dec,
                    coalesce(jan, 0) + coalesce(feb, 0) + coalesce(mar, 0) + coalesce(apr, 0) + coalesce(may, 0) + coalesce(jun, 0) +
                    coalesce(jul, 0) + coalesce(aug, 0) + coalesce(sep, 0) + coalesce(oct, 0) + coalesce(nov, 0) + coalesce(dec, 0) AS ukupno
                FROM (
                    SELECT 
                        stavka_id, 
                        oj_id,
                        projekat_id,
                        TO_CHAR(period,'MON', 'NLS_DATE_LANGUAGE=ENGLISH') AS mon,
                        iznos
                    FROM 
                        budzet_stavke
                    WHERE
                        budzet_id = :P521_BUDZET_ID
                )
                PIVOT (
                    MAX(iznos) 
                    FOR mon IN ('JAN' AS JAN, 'FEB' AS FEB, 'MAR' AS MAR, 'APR' AS APR,
                                'MAY' AS MAY, 'JUN' AS JUN, 'JUL' AS JUL, 'AUG' AS AUG,
                                'SEP' AS SEP, 'OCT' AS OCT, 'NOV' AS NOV, 'DEC' AS DEC)
                )
                ORDER BY
                    oj_id,
                    stavka_id,
                    projekat_id
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        breakFormatting {
            reportSumLabel: Ukupno
        }
        heading {
            type: plsqlFunctionBody
            plsqlFunctionBody: RETURN budzet_pkg.get_column_headings(:P521_BROJ_MJESECI);
        }

        column APR (
            reportColumnQueryId: 7
            derivedColumn: N
            type: link
            heading {
                heading: Apr
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            link {
                target: {
                    page: 510
                    items: {
                        P510_BUDZET_ID: &P521_BUDZET_ID.
                        P510_STATUS_SIFRA: &P521_STATUS_SIFRA.
                        P510_STAVKA_ID: #STAVKA_ID#
                        P510_PERIOD: 04
                    }
                    clearCache: 510
                }
                linkText: #APR#
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
            serverSideCondition {
                type: itemIsInColonDelimitedList
                item: P521_BROJ_MJESECI
                list: [
                    12
                    3
                ]
            }
        )

