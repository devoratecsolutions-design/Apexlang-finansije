    region button-wrapper (
        name: Button Wrapper
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @left-wrapper
            slot: regionBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P521_OJ_ID IS NOT null AND :P521_STATUS_SIFRA = 10
        }
    )

    region buttons-wrapper (
        name: Buttons Wrapper
        type: staticContent
        layout {
            sequence: 40
            slot: fullWidthContent
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
        advanced {
            htmlDomId: FW_BAR
        }
    )

    region left-wrapper (
        name: Left Wrapper
        type: staticContent
