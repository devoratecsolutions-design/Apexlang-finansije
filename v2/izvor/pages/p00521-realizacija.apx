            sequence: 60
            slot: leftColumn
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-side
        }
        advanced {
            htmlDomId: filter-region
        }
    )

    region organizaciona-jedinica (
        name: Organizaciona jedinica
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    oj_naziv,
                    max_iznos,
                    status_naziv,
                    status_color_code
                FROM
                    vw_budzet_oj
                WHERE
                    budzet_id = :P521_BUDZET_ID
                    AND oj_id = :P521_OJ_ID
                ```
            pageItemsToSubmit: [
                P521_OJ_ID
                P521_BUDZET_ID
            ]
        }
        layout {
            sequence: 30
            parentRegion: @left-wrapper
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column MAX_IZNOS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Maksimalan iznos budžeta
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column OJ_NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Organizaciona jedinica
            }
            layout {
                sequence: 20
            }
        )

        column STATUS_COLOR_CODE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column STATUS_NAZIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Status
