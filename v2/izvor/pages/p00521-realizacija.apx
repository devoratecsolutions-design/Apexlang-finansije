            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="t-Button t-Button--icon #STATUS_COLOR_CODE#">
                        #STATUS_NAZIV#
                    </span>
                    ```
            }
        )

    )

    region osnovne-informacije-report (
