    pageItem P521_OJ_ID (
        type: selectOne
        label {
            label: Organizaciona jedinica
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    oj_naziv || ' ( ' || status_naziv || ' ) ' AS d,
                    oj_id AS r
                FROM
                    vw_budzet_oj
                WHERE
                    budzet_id = :P521_BUDZET_ID
                ```
        }
        layout {
            sequence: 20
            region: @left-wrapper
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: [
                #DEFAULT#
                margin-top-none
                margin-bottom-md
            ]
            width: 30
        }
    )

    button realokacija (
        buttonName: REALOKACIJA
        label: Realokacija stavki
        layout {
            sequence: 10
            region: @unos-budžetskih-stavki
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 520
                items: {
                    P520_BUDZET_ID: &P521_BUDZET_ID.
                }
                clearCache: 520
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P521_OJ_ID
        }
    )

    button realokacija-oj (
        buttonName: REALOKACIJA_OJ
        label: Realokacija unutar stavki org. jedinice
        layout {
            sequence: 20
            region: @unos-budžetskih-stavki
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 520
                items: {
                    P520_BUDZET_ID: &P521_BUDZET_ID.
                    P520_OJ_ID: &P521_OJ_ID.
                }
                clearCache: 520
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P521_OJ_ID
        }
    )

    button send (
        buttonName: SEND
        label: Završi nacrt budžeta
        layout {
            sequence: 10
            region: @button-wrapper
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 514
                items: {
                    P514_BUDZET_ID: &P521_BUDZET_ID.
                    P514_OJ_ID: &P521_OJ_ID.
                }
                clearCache: 514
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button toggle (
        buttonName: TOGGLE
        label: Expand / Collapse Side Column
        layout {
            sequence: 10
            region: @buttons-wrapper
            slot: regionBody
        }
        appearance {
            buttonTemplate: @icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--pillEnd
            ]
            icon: fa-chevron-left
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: toggle-btn
        }
    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @realokacija-oj
        }
    )

    dynamicAction dialog-closed-refresh-2 (
        name: Dialog Closed - Refresh 2
        execution {
            sequence: 50
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @realokacija
        }
    )

    dynamicAction expand-collapse-side-column (
        name: Expand / Collapse Side Column
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @toggle
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: toggleSidebar();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P521_OJ_ID
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: REFRESH
                showProcessing: false
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process setup-oj (
        name: Setup OJ
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hrm.evidencija_pkg.get_radnik (
                    p_radnik_id => :APP_RADNIK_ID,
                    p_oj_id     => :P521_OJ_ID
                );
                
                budzet_pkg.get_budzet (
                    p_id           => :P521_BUDZET_ID,
                    p_broj_mjeseci => :P521_BROJ_MJESECI,
                    p_godina       => :P521_GODINA,
                    p_status_sifra => :P521_BUDZET_STATUS_SIFRA
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 147049042362410995
        }
        serverSideCondition {
            type: request=Value
            value: setup
        }
    )

)

