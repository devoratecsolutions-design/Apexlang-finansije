            }
        )

        column NAZIV (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Artikal
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-doc"><span class="fin-doc__no">#SIFRA#</span><span class="fin-sub">#NAZIV#</span></span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column KOLICINA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 340
            }
        )

        column SB_UNESENO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Uneseno / količina
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-sb #SB_KLASA#">#SB_UNESENO# / #KOLICINA#</span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column SB_KLASA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 360
            }
        )

        column URL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 370
            }
        )

