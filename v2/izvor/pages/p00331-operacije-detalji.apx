        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ', 'POVRAT') and :P331_IZMJENJIVA = 'Y' and :P331_VRSTA_SIFRA = 'MPR'
        }
    )

    validation zaglavlje (
        name: Provjera zaglavlja (RM_DOKUMENT_PKG)
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return rm_dokument_pkg.provjeri_zaglavlje(
                    p_id                 => :P331_ID,
                    p_ooj_id             => :APP_OOJ_ID,
                    p_godina             => :APP_GODINA,
                    p_vrsta_dokumenta_id => :P331_VRSTA_DOKUMENTA_ID,
                    p_skladiste_id       => :P331_SKLADISTE_ID,
                    p_datum              => :P331_DATUM,
                    p_klijent_id         => case when rm_dokument_pkg.ima_komitenta(:P331_VRSTA_SIFRA) = 'Y' then :P331_KOMITENT_ID else :P331_KLIJENT_ID end,
                    p_otpremnica_datum   => :P331_OTPREMNICA_DATUM,
                    p_ugovor_id          => :P331_UGOVOR_ID,
                    p_mjesto_troska_id   => :P331_MJESTO_TROSKA_ID,
                    p_tip_preduzetnika   => :APP_TIP_PREDUZETNIKA_SIFRA,
                    p_radnik_id          => :P331_ZADUZENI_RADNIK_ID,
                    p_skladiste_prenos_id => :P331_SKLADISTE_PRENOS_ID,
                    p_radnik_prenos_id   => :P331_RADNIK_PRENOS_ID
                );
                ```
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ', 'POVRAT') and :P331_IZMJENJIVA = 'Y'
        }
    )

    dynamicAction sb-odustao (
        name: Unos serijskih brojeva zatvoren (X) - osvježi
        execution {
            sequence: 25
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @serijski-brojevi
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @serijski-brojevi
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stavke
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction sb-zatvoren (
        name: Unos serijskih brojeva zatvoren - osvježi
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @serijski-brojevi
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @serijski-brojevi
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stavke
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process ucitaj (
        name: Učitavanje dokumenta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for d in (select * from vw_rm_dokumenti where id = :P331_ID and ooj_id = :APP_OOJ_ID) loop
                    :P331_VRSTA_DOKUMENTA_ID := d.vrsta_dokumenta_id;
                    :P331_VRSTA_SIFRA        := d.vrsta_sifra;
                    :P331_VRSTA_NAZIV        := d.vrsta_naziv;
                    :P331_TIP_KRETANJA       := d.tip_kretanja;
                    :P331_ZBIR               := to_char(d.iznos, 'FM999G999G999G990D00');
                    :P331_NAZIV              := d.naziv;
                    :P331_STATUS             := d.status;
                    :P331_SKLADISTE_ID       := d.skladiste_id;
                    :P331_SKLADISTE          := d.skladiste_sifra || ' - ' || d.skladiste_naziv;
                    :P331_DATUM              := d.datum;
                    :P331_OPIS               := d.opis;
                    :P331_KLIJENT_ID         := d.klijent_id;
                    :P331_OTPREMNICA_BROJ    := d.otpremnica_broj;
                    :P331_OTPREMNICA_DATUM   := d.otpremnica_datum;
                    :P331_UGOVOR_ID          := d.ugovor_id;
                    :P331_MJESTO_TROSKA_ID   := d.mjesto_troska_id;
                    :P331_ZADUZENI_RADNIK_ID := d.zaduzeni_radnik_id;
                    :P331_KOMITENT_ID        := d.klijent_id;
                    :P331_POVRAT             := rm_dokument_pkg.je_povrat(d.vrsta_sifra);
                    :P331_SKLADISTE_PRENOS_ID := d.skladiste_prenos_id;
                    :P331_RADNIK_PRENOS_ID   := d.radnik_prenos_id;
                    :P331_SKLADISTE_PRENOS   := d.skladiste_prenos_naziv;
                    :P331_VEZA_INFO          := case when d.vrsta_sifra = 'MPP' then 'Preuzet prenos ' || d.veza_naziv
                                                     when d.vrsta_sifra = 'MPR' and d.preuzeto_naziv is not null then 'Preuzeto prijemom ' || d.preuzeto_naziv
                                                     when d.vrsta_sifra = 'MPR' and d.status = 'Z' then 'Čeka prijem na skladištu ' || d.skladiste_prenos_naziv
                                                end;
                    :P331_KALKULACIJA        := case when d.kalkulacija_naziv is not null then 'Kalkulacija ' || d.kalkulacija_naziv
                                                     when d.popis_naziv is not null and d.vrsta_sifra = 'RIV' and d.status <> 'Z'
                                                     then 'Iz popisa ' || d.popis_naziv || ' - količine su utvrđene popisom, unesite cijene i zaključite'
                                                     when d.popis_naziv is not null then 'Iz popisa ' || d.popis_naziv end;
                    :P331_STATUS_KLASA       := case when d.stornirano = 'Y' or d.storniran_id is not null then 'storno'
                                                     when d.glavna_knjiga_id is not null then 'proknjizena'
                                                     when d.status = 'Z' then 'zakljucena' else 'priprema' end;
                    :P331_STATUS_NAZIV       := case when d.stornirano = 'Y' then 'Storniran' || nvl2(d.storno_naziv, ' (' || d.storno_naziv || ')', '')
                                                     when d.storniran_id is not null then 'Storno dokumenta ' || d.storniran_naziv
                                                     when d.glavna_knjiga_id is not null then 'Proknjižen'
                                                     when d.status = 'Z' then 'Zaključen'
                                                     when d.u_kalkulaciji_id is not null then 'U kalkulaciji'
                                                     else 'U pripremi' end;
                    :P331_STATUS_IKONA       := case when d.stornirano = 'Y' or d.storniran_id is not null then 'fa-ban'
                                                     when d.glavna_knjiga_id is not null then 'fa-book'
                                                     when d.status = 'Z' then 'fa-lock'
                                                     when d.u_kalkulaciji_id is not null then 'fa-calculator'
                                                     else 'fa-pencil' end;
                end loop;
                :P331_RAZLOG := rm_dokument_pkg.razlog_zabrane(:P331_ID);
                :P331_IZMJENJIVA := rm_dokument_pkg.izmjenjiv(:P331_ID);
                :P331_ADMIN := case when apex_authorization.is_authorized('MAIN ADMIN') then 'Y' else 'N' end;
                :P331_STORNO_RAZLOG := rm_dokument_pkg.razlog_zabrane_storna(:P331_ID);
                -- naslovi: zaduženje / mjesto troška, kolona stanja (ulaz: stanje, izlaz: raspoloživo)
                :P331_NASLOV_MT := case when rm_dokument_pkg.ima_mjesto_troska(:P331_VRSTA_SIFRA) = 'N' then 'Zaduženje'
                                        when rm_dokument_pkg.ima_radnika(:P331_VRSTA_SIFRA) = 'Y' then 'Mjesto troška i zaduženje'
                                        else 'Mjesto troška' end;
                :P331_NASLOV_RASP := case when rm_dokument_pkg.je_si(:P331_VRSTA_SIFRA) = 'Y' then 'Zaduženo kod radnika'
                                          when :P331_POVRAT = 'Y' then 'Dostupno za povrat'
                                          when :P331_TIP_KRETANJA = 'I' then 'Raspoloživo'
                                          when :P331_VRSTA_SIFRA = 'FDK' then 'Stanje · vrijednost' else 'Stanje' end;
                :P331_NASLOV_CIJENA := case when :P331_VRSTA_SIFRA = 'FDK' then 'Iznos doknjiženja (+/-)'
                                             when :P331_VRSTA_SIFRA = 'NIVM' then 'Razlika po jedinici' else 'Jed. cijena' end;
                :P331_NASLOV_RADNIK := case when :P331_VRSTA_SIFRA = 'PSI' then 'Sa radnika'
                                            when rm_dokument_pkg.je_si(:P331_VRSTA_SIFRA) = 'Y' then 'Radnik' else 'Zaduženi radnik' end;
                :P331_NASLOV_POVRAT := case when rm_dokument_pkg.je_si(:P331_VRSTA_SIFRA) = 'Y' then 'Preuzmi zaduženja radnika'
                                            else 'Preuzmi dostupno za povrat' end;
                -- poruke potvrde: materijalni modul govori o materijalu; prezaduženje / razduženje SI bez cijena i skladišta
                :P331_POTVRDA_ZAK := case
                    when :P331_VRSTA_SIFRA = 'PSI' then 'Zaključiti prezaduženje? Zaduženje se prenosi na izabranog radnika (stavke sa količinom 0 se ne prenose).'
                    when :P331_VRSTA_SIFRA = 'RSR' then 'Zaključiti rashod? Radnik se razdužuje za navedene količine.'
                    when :P331_VRSTA_SIFRA = 'RIV' then 'Zaključiti dokument? Višak iz popisa se zadužuje po unesenim cijenama.'
                    when :P331_VRSTA_SIFRA = 'FDK' then 'Zaključiti doknjiženje? Vrijednost zaliha artikala se mijenja za unesene iznose (količina ostaje ista), pa se mijenja i prosječna cijena.'
                    when :P331_VRSTA_SIFRA = 'ZSA' then 'Zaključiti zamjenu šifara? Artikli se skidaju sa stanja po prosječnoj cijeni, a zamjenski artikli se dodaju na stanje u istoj količini i po istoj cijeni.'
                    when :P331_POVRAT = 'Y' then 'Zaključiti povrat? Vraćene količine se zadužuju na skladištu.'
                    else 'Zaključiti dokument? Cijene stavki se upisuju po prosječnoj cijeni skladišta na datum dokumenta, a '
                         || case when rm_skladiste_pkg.modul(:P331_SKLADISTE_ID) = 'ROB' then 'roba' else 'materijal' end
                         || ' se skida sa stanja.' end;
                :P331_POTVRDA_OTK := case
                    when rm_dokument_pkg.je_si(:P331_VRSTA_SIFRA) = 'Y' then 'Otključati dokument? Zaduženje radnika se vraća na stanje prije dokumenta dok se dokument ponovo ne zaključi.'
                    else 'Otključati dokument? ' || case when rm_skladiste_pkg.modul(:P331_SKLADISTE_ID) = 'ROB' then 'Roba' else 'Materijal' end
                         || ' se vraća na stanje dok se dokument ponovo ne zaključi.' end;
                :P331_POTVRDA_STO := case
                    when rm_dokument_pkg.je_si(:P331_VRSTA_SIFRA) = 'Y' then 'Stornirati dokument? Pravi se storno dokument sa današnjim datumom, a zaduženje radnika se vraća. Storno se ne može poništiti.'
                    else 'Stornirati dokument? Pravi se storno dokument sa današnjim datumom, a '
                         || case when rm_skladiste_pkg.modul(:P331_SKLADISTE_ID) = 'ROB' then 'roba' else 'materijal' end
                         || ' se vraća na stanje. Storno se ne može poništiti.' end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P331_ID
        }
    )

    process nova (
        name: Novi dokument - početne vrijednosti
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P331_IZMJENJIVA    := 'Y';
                :P331_STATUS        := 'P';
                :P331_STATUS_KLASA  := 'priprema';
                :P331_STATUS_NAZIV  := 'U pripremi';
                :P331_STATUS_IKONA  := 'fa-pencil';
                :P331_SKLADISTE_ID  := :A_SKLADISTE_ID;
                :P331_DATUM         := trunc(sysdate);
                for s in (select sifra || ' - ' || naziv as n from skladista where id = :A_SKLADISTE_ID) loop
                    :P331_SKLADISTE := s.n;
                end loop;
                -- iz menija: vrsta zadata šifrom (npr. PRI) -> vrsta iste firme u modulu MAT
                if :P331_VRSTA_DOKUMENTA_ID is null and :P331_VRSTA_SIFRA is not null then
                    select max(vd.id) into :P331_VRSTA_DOKUMENTA_ID
                      from sif.vrste_dokumenata vd
                      join sif.acc_moduli m on m.id = vd.acc_modul_id and upper(m.sifra) = 'MAT'
                     where vd.ooj_id = :APP_OOJ_ID and upper(vd.sifra) = upper(:P331_VRSTA_SIFRA) and vd.valid = 'Y';
                end if;
                for v in (select vd.sifra, vd.naziv from sif.vrste_dokumenata vd where vd.id = :P331_VRSTA_DOKUMENTA_ID) loop
                    :P331_VRSTA_SIFRA := upper(v.sifra);
                    :P331_TIP_KRETANJA := rm_dokument_pkg.tip_kretanja(v.sifra);
                    :P331_POVRAT := rm_dokument_pkg.je_povrat(v.sifra);
                    :P331_ZBIR := '0.00';
                    :P331_NASLOV_MT := case when rm_dokument_pkg.ima_mjesto_troska(v.sifra) = 'N' then 'Zaduženje'
                                            when rm_dokument_pkg.ima_radnika(v.sifra) = 'Y' then 'Mjesto troška i zaduženje'
                                            else 'Mjesto troška' end;
                    :P331_NASLOV_RADNIK := case when upper(v.sifra) = 'PSI' then 'Sa radnika'
                                                when rm_dokument_pkg.je_si(v.sifra) = 'Y' then 'Radnik' else 'Zaduženi radnik' end;
                    :P331_NASLOV_POVRAT := case when rm_dokument_pkg.je_si(v.sifra) = 'Y' then 'Preuzmi zaduženja radnika'
                                                else 'Preuzmi dostupno za povrat' end;
                    :P331_NASLOV_RASP := case when rm_dokument_pkg.je_si(v.sifra) = 'Y' then 'Zaduženo kod radnika'
                                              when rm_dokument_pkg.je_povrat(v.sifra) = 'Y' then 'Dostupno za povrat'
                                              when rm_dokument_pkg.tip_kretanja(v.sifra) = 'I' then 'Raspoloživo'
                                              when upper(v.sifra) = 'FDK' then 'Stanje · vrijednost' else 'Stanje' end;
                    :P331_NASLOV_CIJENA := case when upper(v.sifra) = 'FDK' then 'Iznos doknjiženja (+/-)'
                                                 when upper(v.sifra) = 'NIVM' then 'Razlika po jedinici' else 'Jed. cijena' end;
                    :P331_VRSTA_NAZIV := v.naziv;
                    :P331_NAZIV       := case when upper(v.sifra) = 'PRI' then 'Nova prijemnica' when upper(v.sifra) = 'IZD' then 'Nova izdatnica' else 'Novi dokument: ' || v.naziv end;
                end loop;
                -- poruke potvrde: materijalni modul govori o materijalu; prezaduženje / razduženje SI bez cijena i skladišta
                :P331_POTVRDA_ZAK := case
                    when :P331_VRSTA_SIFRA = 'PSI' then 'Zaključiti prezaduženje? Zaduženje se prenosi na izabranog radnika (stavke sa količinom 0 se ne prenose).'
                    when :P331_VRSTA_SIFRA = 'RSR' then 'Zaključiti rashod? Radnik se razdužuje za navedene količine.'
                    when :P331_VRSTA_SIFRA = 'RIV' then 'Zaključiti dokument? Višak iz popisa se zadužuje po unesenim cijenama.'
                    when :P331_VRSTA_SIFRA = 'FDK' then 'Zaključiti doknjiženje? Vrijednost zaliha artikala se mijenja za unesene iznose (količina ostaje ista), pa se mijenja i prosječna cijena.'
                    when :P331_VRSTA_SIFRA = 'ZSA' then 'Zaključiti zamjenu šifara? Artikli se skidaju sa stanja po prosječnoj cijeni, a zamjenski artikli se dodaju na stanje u istoj količini i po istoj cijeni.'
                    when :P331_POVRAT = 'Y' then 'Zaključiti povrat? Vraćene količine se zadužuju na skladištu.'
                    else 'Zaključiti dokument? Cijene stavki se upisuju po prosječnoj cijeni skladišta na datum dokumenta, a '
                         || case when rm_skladiste_pkg.modul(:P331_SKLADISTE_ID) = 'ROB' then 'roba' else 'materijal' end
                         || ' se skida sa stanja.' end;
                :P331_POTVRDA_OTK := case
                    when rm_dokument_pkg.je_si(:P331_VRSTA_SIFRA) = 'Y' then 'Otključati dokument? Zaduženje radnika se vraća na stanje prije dokumenta dok se dokument ponovo ne zaključi.'
                    else 'Otključati dokument? ' || case when rm_skladiste_pkg.modul(:P331_SKLADISTE_ID) = 'ROB' then 'Roba' else 'Materijal' end
                         || ' se vraća na stanje dok se dokument ponovo ne zaključi.' end;
                :P331_POTVRDA_STO := case
                    when rm_dokument_pkg.je_si(:P331_VRSTA_SIFRA) = 'Y' then 'Stornirati dokument? Pravi se storno dokument sa današnjim datumom, a zaduženje radnika se vraća. Storno se ne može poništiti.'
                    else 'Stornirati dokument? Pravi se storno dokument sa današnjim datumom, a '
                         || case when rm_skladiste_pkg.modul(:P331_SKLADISTE_ID) = 'ROB' then 'roba' else 'materijal' end
                         || ' se vraća na stanje. Storno se ne može poništiti.' end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNull
            item: P331_ID
        }
    )

    process snimi (
        name: Snimi zaglavlje
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P331_ID := rm_dokument_pkg.snimi(
                    p_id                 => :P331_ID,
                    p_ooj_id             => :APP_OOJ_ID,
                    p_godina             => :APP_GODINA,
                    p_vrsta_dokumenta_id => :P331_VRSTA_DOKUMENTA_ID,
                    p_skladiste_id       => :P331_SKLADISTE_ID,
                    p_datum              => :P331_DATUM,
                    p_klijent_id         => case when rm_dokument_pkg.ima_komitenta(:P331_VRSTA_SIFRA) = 'Y' then :P331_KOMITENT_ID else :P331_KLIJENT_ID end,
                    p_otpremnica_broj    => :P331_OTPREMNICA_BROJ,
                    p_otpremnica_datum   => :P331_OTPREMNICA_DATUM,
                    p_opis               => :P331_OPIS,
                    p_ugovor_id          => :P331_UGOVOR_ID,
                    p_mjesto_troska_id   => :P331_MJESTO_TROSKA_ID,
                    p_tip_preduzetnika   => :APP_TIP_PREDUZETNIKA_SIFRA,
                    p_radnik_id          => :P331_ZADUZENI_RADNIK_ID,
                    p_skladiste_prenos_id => :P331_SKLADISTE_PRENOS_ID,
                    p_radnik_prenos_id   => :P331_RADNIK_PRENOS_ID
                );
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ', 'POVRAT') and :P331_IZMJENJIVA = 'Y'
        }
    )

    process stavke-snimi (
        name: Stavke - snimi redove
        type: executeCode
        editableRegion: @stavke
        source {
            plsqlCode:
                ```plsql
                begin
                    declare
                        -- vrijednosti iz tabele su tekst; novi red ima privremeni ID (t1000) -> kuf_pkg.broj vraća null
                        l_id number := kuf_pkg.broj(:ID);
                    begin
                        if :APEX$ROW_STATUS = 'D' then
                            rm_dokument_pkg.obrisi_stavku(p_id => l_id);
                        else
                            rm_dokument_pkg.snimi_stavku(
                                p_id          => l_id,
                                p_dokument_id => :P331_ID,
                                p_stavka_id   => kuf_pkg.broj(:STAVKA_ID),
                                p_kolicina    => kuf_pkg.broj(:KOLICINA),
                                p_cijena      => kuf_pkg.broj(:CIJENA),
                                p_zamjena_stavka_id => kuf_pkg.broj(:ZAMJENA_STAVKA_ID)
                            );
                            :ID := l_id;
                        end if;
                    end;
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Dokument je snimljen.
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ', 'POVRAT') and :P331_IZMJENJIVA = 'Y'
        }
    )

    process povrat-dostupno (
        name: Povrat - preuzmi dostupne količine
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    apex_application.g_print_success_message := rm_dokument_pkg.dodaj_dostupno_za_povrat(:P331_ID);
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 25
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'POVRAT' and :P331_IZMJENJIVA = 'Y'
        }
    )

    process ajax-po-sb (
        name: DODAJ_PO_SB
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_util.prn(rm_dokument_pkg.dodaj_po_sb_json(kuf_pkg.broj(:P331_ID), apex_application.g_x01), false);
                ```
        }
        execution {
            sequence: 31
            point: ajaxCallback
        }
    )

    process preuzmi-prenos (
        name: Preuzmi međuskladišni prenos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    :P331_ID := rm_dokument_pkg.preuzmi_prenos(
                        p_prenos_id    => kuf_pkg.broj(:P331_PRENOS_ID),
                        p_ooj_id       => :APP_OOJ_ID,
                        p_godina       => :APP_GODINA,
                        p_skladiste_id => :A_SKLADISTE_ID
                    );
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 35
        }
        successMessage {
            successMessage: Prenos je preuzet - međuskladišni prijem je napravljen i zaključen.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: PREUZMI
        }
    )

    process zakljucaj (
        name: Zaključaj izlazni dokument
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    rm_dokument_pkg.zakljucaj(p_id => :P331_ID, p_tip_preduzetnika => :APP_TIP_PREDUZETNIKA_SIFRA);
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Dokument je zaključen.
        }
        serverSideCondition {
            whenButtonPressed: @zakljucaj
        }
    )

    process otkljucaj (
        name: Otključaj izlazni dokument
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    rm_dokument_pkg.otkljucaj(p_id    => :P331_ID,
                                              p_admin => case when apex_authorization.is_authorized('MAIN ADMIN') then 'Y' else 'N' end);
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 45
        }
        successMessage {
            successMessage: Dokument je otključan.
        }
        serverSideCondition {
            whenButtonPressed: @otkljucaj
        }
    )

    process storniraj (
        name: Storniraj izlazni dokument
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_storno number;
                begin
                    l_storno := rm_dokument_pkg.storniraj(p_id     => :P331_ID,
                                                          p_ooj_id => :APP_OOJ_ID,
                                                          p_godina => :APP_GODINA);
                    select 'Dokument je storniran - storno dokument ' || naziv || '.' into :P331_PORUKA
                      from operacije where id = l_storno;
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 46
        }
        successMessage {
            successMessage: &P331_PORUKA.
        }
        serverSideCondition {
            whenButtonPressed: @storniraj
        }
    )

    process ajax-artikl-info (
        name: ARTIKL_INFO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sys.htp.p(rm_dokument_pkg.artikl_info(
                    p_stavka_id    => apex_application.g_x01,
                    p_dokument_id  => :P331_ID,
                    p_skladiste_id => :P331_SKLADISTE_ID,
                    p_datum        => :P331_DATUM,
                    p_vrsta_sifra  => :P331_VRSTA_SIFRA,
