            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-doc"><span class="fin-doc__no">#REVERS_NAZIV#</span><span class="fin-sub">#DATUM#</span></span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column DATUM (
