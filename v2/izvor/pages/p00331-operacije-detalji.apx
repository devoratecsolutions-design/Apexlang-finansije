        }
        serverSideCondition {
            type: expression
            plsqlExpression: rm_dokument_pkg.mjesto_troska_obavezno(:P331_VRSTA_SIFRA, :APP_TIP_PREDUZETNIKA_SIFRA, :APP_OOJ_ID) = 'Y'
        }
    )

    pageItem P331_ZADUZENI_RADNIK_ID (
        type: selectOne
        label {
            label: Zaduženi radnik
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        messages {
            noDataFoundMessage: Nema pronađenih podataka.
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT r.ime || ' ' || r.prezime || nvl2(r.interni_broj, ' (' || r.interni_broj || ')', '') AS d,
                       r.id AS r
                FROM sif.acc_radnici r
                WHERE r.ooj_id = :APP_OOJ_ID
                  AND (r.valid = 'Y' OR r.id = :P331_ZADUZENI_RADNIK_ID)
                ORDER BY r.prezime, r.ime
                ```
        }
        layout {
            sequence: 20
            region: @mjesto-troska
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Radnik koji se zadužuje osnovnim sredstvom / sitnim inventarom.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: rm_dokument_pkg.ima_radnika(:P331_VRSTA_SIFRA) = 'Y'
        }
    )

