    region revers-preostalo (
        name: Preostalo po reversima
        title: Preostalo za povrat po reversima
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    r.revers_naziv,
                    to_char(r.datum, 'DD.MM.YYYY') AS datum,
                    r.sifra,
                    r.naziv,
                    r.jm_naziv,
                    rtrim(to_char(r.izdato, 'FM999G999G999G990D999999'), '.,') AS izdato,
                    rtrim(to_char(r.preostalo, 'FM999G999G999G990D999999'), '.,') AS preostalo
                FROM vw_rm_revers_preostalo r
                WHERE r.ooj_id = :APP_OOJ_ID
                  AND r.revers_sifra = rm_dokument_pkg.revers_za_povrat(:P331_VRSTA_SIFRA)
                  AND r.partner_id = CASE WHEN rm_dokument_pkg.ima_radnika(:P331_VRSTA_SIFRA) = 'Y'
                                          THEN to_number(:P331_ZADUZENI_RADNIK_ID) ELSE to_number(:P331_KOMITENT_ID) END
                  AND r.preostalo > 0
                ORDER BY r.datum, r.revers_id, r.sifra
                ```
            pageItemsToSubmit: [
                P331_VRSTA_SIFRA
                P331_ZADUZENI_RADNIK_ID
                P331_KOMITENT_ID
            ]
        }
        layout {
            sequence: 50
            parentRegion: @dokument-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
            cssClasses: fin-section
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Izaberite radnika / komitenta - prikazuju se zaključeni reversi sa preostalom količinom (povrati se raspoređuju na najstarije reverse).
        }
        advanced {
            htmlDomId: rm_revers_preostalo
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_POVRAT = 'Y'
        }

        column REVERS_NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Revers
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-doc"><span class="fin-doc__no">#REVERS_NAZIV#</span><span class="fin-sub">#DATUM#</span></span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column DATUM (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 310
            }
        )

        column SIFRA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Šifra
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column NAZIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Artikal
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column JM_NAZIV (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: JM
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column IZDATO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Izdato
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column PREOSTALO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Preostalo
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            columnFormatting {
                cssClasses: fin-num
            }
            sorting {
                sortable: false
            }
        )

    )

    region dokument (
