    process ajax-artikl-info (
        name: ARTIKL_INFO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sys.htp.p(rm_dokument_pkg.artikl_info(
                    p_stavka_id    => apex_application.g_x01,
                    p_dokument_id  => :P331_ID,
                    p_skladiste_id => :P331_SKLADISTE_ID,
                    p_datum        => :P331_DATUM,
                    p_vrsta_sifra  => :P331_VRSTA_SIFRA,
                    p_radnik_id    => kuf_pkg.broj(:P331_ZADUZENI_RADNIK_ID),
                    p_klijent_id   => kuf_pkg.broj(:P331_KOMITENT_ID)
                ));
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
    )

    process obrisi (
        name: Obriši
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    rm_dokument_pkg.obrisi(p_id => :P331_ID);
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Dokument je obrisan.
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process close-dialog (
        name: Zatvori dijalog
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,ZATVORI
        }
    )

    branch (
        name: Ostani na dokumentu
        execution {
            sequence: 50
        }
        behavior {
            target: {
                page: 331
                items: {
                    P331_ID: &P331_ID.
                }
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,ZAKLJUCAJ,OTKLJUCAJ,PREUZMI,POVRAT
        }
    )

)
