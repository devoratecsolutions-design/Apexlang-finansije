        title: Dokument
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @dokument-detalji
            slot: subRegions
            columnSpan: 5
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region dobavljac (
        name: Dobavljač i ugovor
        title: Dobavljač i ugovor
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @dokument-detalji
            slot: subRegions
            startNewRow: false
            columnSpan: 7
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
        serverSideCondition {
            type: expression
            plsqlExpression: nvl(:P331_VRSTA_SIFRA, 'PRI') = 'PRI'
        }
    )

    region skladiste-prenosa (
        name: Međuskladišni prenos
        title: Međuskladišni prenos
        type: staticContent
        layout {
            sequence: 22
            parentRegion: @dokument-detalji
            slot: subRegions
            startNewRow: false
            columnSpan: 7
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
        serverSideCondition {
            type: expression
            plsqlExpression: rm_dokument_pkg.ima_skladiste_prenosa(:P331_VRSTA_SIFRA) = 'Y'
        }
    )

    region mjesto-troska (
        name: Mjesto troška i zaduženje
        title: Mjesto troška i zaduženje
        type: staticContent
        layout {
            sequence: 25
            parentRegion: @dokument-detalji
            slot: subRegions
            startNewRow: false
            columnSpan: 7
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
