    region sb-unos (
        name: Unos po serijskom broju
        type: staticContent
        source {
            htmlCode: <div class="fin-sb-unos__dugme"><button type="button" class="t-Button t-Button--iconLeft fin-sb-dodaj"><span class="t-Icon t-Icon--left fa fa-barcode" aria-hidden="true"></span>Dodaj</button></div>
        }
        layout {
            sequence: 10
            parentRegion: @stavke-sekcija
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: fin-sb-unos
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and :P331_TIP_KRETANJA = 'I' and :P331_IZMJENJIVA = 'Y'
        }
    )

    region zbir (
        name: Zbir
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @stavke-sekcija
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: fin-totals
        }
    )

    region serijski-brojevi (
        name: Serijski brojevi
        title: Serijski brojevi
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    s.id,
                    s.sifra,
                    s.naziv,
                    to_char(s.kolicina, 'FM999G999G990') AS kolicina,
                    s.sb_uneseno,
                    CASE WHEN s.sb_ok = 'Y' THEN 'is-ok' ELSE 'is-nok' END AS sb_klasa,
                    apex_page.get_url(p_page => 337, p_items => 'P337_STAVKA_DOK_ID', p_values => s.id, p_clear_cache => 337) AS url
                FROM vw_rm_dokument_stavke s
                WHERE s.operacija_id = :P331_ID
                  AND s.prati_sb = 'Y'
                ORDER BY s.redni_broj, s.id
                ```
            pageItemsToSubmit: P331_ID
        }
        layout {
            sequence: 40
            parentRegion: @dokument-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
            cssClasses: fin-section
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Nema artikala koji se prate po serijskom broju.
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                for s in (select 1 from vw_rm_dokument_stavke where operacija_id = :P331_ID and prati_sb = 'Y' fetch first 1 row only) loop
                    return true;
                end loop;
                return false;
                ```
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Serijski brojevi
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: #URL#
                }
                linkText: <span class="fin-act" title="Unos serijskih brojeva" aria-label="Unos serijskih brojeva"><span class="fa fa-barcode" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column SIFRA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 320
            }
        )

        column NAZIV (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Artikal
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-doc"><span class="fin-doc__no">#SIFRA#</span><span class="fin-sub">#NAZIV#</span></span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column KOLICINA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 340
            }
        )

        column SB_UNESENO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Uneseno / količina
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-sb #SB_KLASA#">#SB_UNESENO# / #KOLICINA#</span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column SB_KLASA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 360
            }
        )

        column URL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 370
            }
        )

    )

