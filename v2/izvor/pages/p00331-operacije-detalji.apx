        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Skenirajte barkod ili QR kod (ili upišite serijski broj i pritisnite Enter). Artikal se prepoznaje po serijskom broju raspoloživom na skladištu; ako stavka postoji količina se povećava, inače se dodaje nova. QR kod može sadržati više brojeva (razdjelnici: razmak, novi red, ; , : /).
        }
    )

    pageItem P331_SKLADISTE_PRENOS_ID (
        type: selectOne
        label {
            label: Na skladište
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        messages {
            noDataFoundMessage: Nema pronađenih podataka.
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT s.sifra || ' - ' || s.naziv AS d, s.id AS r
                FROM skladista s
                WHERE s.ooj_id = :APP_OOJ_ID
                  AND (s.valid = 'Y' OR s.id = :P331_SKLADISTE_PRENOS_ID)
                  AND s.id <> nvl(:P331_SKLADISTE_ID, -1)
                ORDER BY s.sifra
                ```
        }
        layout {
            sequence: 10
            region: @skladiste-prenosa
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Skladište firme na koje se roba prenosi. Prijem na tom skladištu nastaje preuzimanjem ovog prenosa kad se prenos zaključi.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_VRSTA_SIFRA = 'MPR'
        }
    )

