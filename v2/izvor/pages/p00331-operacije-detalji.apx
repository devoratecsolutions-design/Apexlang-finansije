            message: Zaključati dokument? Cijene stavki se upisuju po prosječnoj cijeni skladišta na datum dokumenta, a roba se skida sa stanja.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and (:P331_TIP_KRETANJA = 'I' or :P331_POVRAT = 'Y') and :P331_IZMJENJIVA = 'Y'
        }
    )

