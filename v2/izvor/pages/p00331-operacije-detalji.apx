page 331 (
    name: Dokument skladišta
    alias: OPERACIJE-DETALJI
    title: Dokument skladišta
    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--xl
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            finRmStavke.init('rm_stavke', 'P331');
            finRmSbUnos.init('P331');
            /* međuskladišni prijem: izbor prenosa prikazuje njegove stavke */
            apex.jQuery(document).on("click", ".fin-prenos-izbor", function () {
                var id = String(apex.jQuery(this).data("id"));
                apex.jQuery(".fin-prenos-izbor").closest("tr").removeClass("is-izabran");
                apex.jQuery(this).closest("tr").addClass("is-izabran");
                $s("P331_PRENOS_ID", id);
                apex.region("rm_prenos_stavke").refresh();
            });
            if (apex.jQuery(".fin-prenos-izbor").length) { apex.jQuery(".fin-prenos-izbor").first().trigger("click"); }
            /* povrat: promjena radnika / komitenta osvježava preostalo po reversima */
            apex.jQuery("#P331_ZADUZENI_RADNIK_ID, #P331_KOMITENT_ID").on("change", function () {
                if (apex.region("rm_revers_preostalo")) { apex.region("rm_revers_preostalo").refresh(); }
            });
            /* međuskladišni prijem: preuzimanje prenosa na čekanju */
            apex.jQuery(document).on("click", ".fin-preuzmi", function () {
                var b$ = apex.jQuery(this);
                apex.page.confirm("Preuzeti prenos " + b$.data("naziv") + "? Prijem se pravi sa količinama i cijenama iz prenosa i odmah se zaključuje (bez mogućnosti izmjena).",
                    { request: "PREUZMI", set: { "P331_PRENOS_ID": String(b$.data("id")) } });
            });
            ```
    }
    css {
        inline:
            ```css
            .ui-dialog-titlebar-close {
                display: none !important;
            }
            ```
    }
    security {
        authorizationScheme: @robno-materijalno-dokumenti
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region dokument-traka (
        name: Traka dokumenta
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="fin-docbar">
                  <span class="fin-docbar__no">&P331_NAZIV.</span>
                  <span class="fin-status fin-status--&P331_STATUS_KLASA."><span class="fa &P331_STATUS_IKONA." aria-hidden="true"></span>&P331_STATUS_NAZIV.</span>
                  <span class="fin-docbar__meta">&P331_VRSTA_NAZIV.</span>
                  <span class="fin-docbar__meta">&P331_SKLADISTE.</span>
                  <span class="fin-docbar__meta">&P331_KALKULACIJA.</span>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region zakljucan (
        name: Dokument se ne može mijenjati
        type: staticContent
        source {
            htmlCode: &P331_RAZLOG.
        }
        layout {
            sequence: 7
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and :P331_IZMJENJIVA = 'N'
        }
    )

    region dokument-detalji (
        name: Dokument / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
        readOnly {
            type: expression
            plsqlExpression: :P331_IZMJENJIVA = 'N'
        }
        serverSideCondition {
            type: expression
            plsqlExpression: not (nvl(:P331_VRSTA_SIFRA, '-') = 'MPP' and :P331_ID is null)
        }
    )

    region prenosi-cekanje (
        name: Prenosi na čekanju
        title: Prenosi na čekanju za ovo skladište (zaglavlja)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    p.id,
                    p.naziv,
                    to_char(p.datum, 'DD.MM.YYYY') AS datum,
                    p.sa_skladista,
                    p.opis,
                    p.stavki,
                    to_char(p.iznos, 'FM999G999G999G990D00') AS iznos
                FROM vw_rm_prenosi_cekanje p
                WHERE p.ooj_id = :APP_OOJ_ID
                  AND p.skladiste_prenos_id = :A_SKLADISTE_ID
                ORDER BY p.datum, p.id
                ```
        }
        layout {
            sequence: 8
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
            cssClasses: fin-section
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Nema zaključenih prenosa upućenih na ovo skladište koji čekaju prijem.
        }
        advanced {
            htmlDomId: rm_prenosi
        }
        serverSideCondition {
            type: expression
            plsqlExpression: nvl(:P331_VRSTA_SIFRA, '-') = 'MPP' and :P331_ID is null
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: &nbsp;
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <button type="button" class="t-Button t-Button--hot t-Button--small t-Button--iconLeft fin-preuzmi" data-id="#ID#" data-naziv="#NAZIV#"><span class="t-Icon t-Icon--left fa fa-download" aria-hidden="true"></span>Preuzmi</button>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Prenos
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a href="javascript:void(0)" class="fin-doc fin-prenos-izbor" data-id="#ID#"><span class="fin-doc__no">#NAZIV#</span><span class="fin-sub">#DATUM# · sa skladišta #SA_SKLADISTA#</span><span class="fin-sub">#OPIS#</span></a>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column DATUM (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 310
            }
        )

        column SA_SKLADISTA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 320
            }
        )

        column OPIS (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 330
            }
        )

        column STAVKI (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Stavki
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column IZNOS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Vrijednost
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            columnFormatting {
                cssClasses: fin-num
            }
            sorting {
                sortable: false
            }
        )


    )

    region prenos-stavke (
        name: Stavke izabranog prenosa
        title: Stavke izabranog prenosa
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    s.redni_broj,
                    s.sifra,
                    s.naziv,
                    s.jm_naziv,
                    rtrim(to_char(s.kolicina, 'FM999G999G999G990D999999'), '.,') AS kolicina,
                    to_char(s.cijena, 'FM999G999G999G990D00') AS cijena,
                    to_char(s.iznos, 'FM999G999G999G990D00') AS iznos,
                    CASE WHEN s.prati_sb = 'Y' THEN to_char(s.sb_uneseno) END AS sb
                FROM vw_rm_dokument_stavke s
                WHERE s.operacija_id = :P331_PRENOS_ID
                  AND EXISTS (SELECT 1 FROM vw_rm_prenosi_cekanje p
                               WHERE p.id = s.operacija_id AND p.ooj_id = :APP_OOJ_ID AND p.skladiste_prenos_id = :A_SKLADISTE_ID)
                ORDER BY s.redni_broj, s.id
                ```
            pageItemsToSubmit: P331_PRENOS_ID
        }
        layout {
            sequence: 9
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
            cssClasses: fin-section
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Izaberite prenos u tabeli iznad da vidite njegove stavke.
        }
        advanced {
            htmlDomId: rm_prenos_stavke
        }
        serverSideCondition {
            type: expression
            plsqlExpression: nvl(:P331_VRSTA_SIFRA, '-') = 'MPP' and :P331_ID is null
        }

        column REDNI_BROJ (
            reportColumnQueryId: 1
            derivedColumn: N
