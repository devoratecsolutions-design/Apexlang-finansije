    region stavke-sekcija (
        name: Stavke
        title: Stavke
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @dokument-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region stavke (
        name: Stavke - tabela
        title: Stavke
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    s.id,
                    s.redni_broj,
                    s.stavka_id,
                    s.jm_naziv,
                    CASE WHEN :P331_VRSTA_SIFRA = 'FDK'
                         THEN rtrim(to_char(rm_dokument_pkg.obradjeno(:P331_SKLADISTE_ID, s.stavka_id, null, s.operacija_id),
                                            'FM999G999G999G990D999999'), '.,')
                              || ' · ' || to_char(rm_dokument_pkg.vrijednost_zaliha(:P331_SKLADISTE_ID, s.stavka_id, null, s.operacija_id),
                                                  'FM999G999G999G990D00') || ' KM'
                         ELSE rtrim(to_char(CASE WHEN :P331_POVRAT = 'Y'
                         THEN rm_dokument_pkg.dostupno_za_povrat_dok(s.operacija_id, s.stavka_id)
                         WHEN :P331_TIP_KRETANJA = 'I'
                         THEN rm_dokument_pkg.raspolozivo(:P331_SKLADISTE_ID, s.stavka_id, null, s.operacija_id)
                         ELSE rm_dokument_pkg.stanje(:P331_SKLADISTE_ID, s.stavka_id, null, s.operacija_id) END,
                         'FM999G999G999G990D999999'), '.,') END AS raspolozivo,
                    rtrim(to_char(s.kolicina, 'FM999999999990D999999'), '.,') AS kolicina,
                    CASE WHEN s.cijena = round(s.cijena, 2) THEN to_char(s.cijena, 'FM999G999G999G990D00')
                         ELSE rtrim(to_char(s.cijena, 'FM999G999G999G990D9999'), '0') END AS cijena,
                    s.iznos,
                    CASE WHEN s.prati_sb = 'Y' AND :P331_VRSTA_SIFRA <> 'FDK' THEN s.sb_uneseno || ' / ' || s.kolicina || CASE WHEN s.sb_ok = 'N' THEN '  ⚠' END END AS sb,
                    s.zamjena_stavka_id,
                    -- R23 nivelacija: stara / nova MPC i PDV u razlici
                    to_char(s.mpc_stara, 'FM999G999G999G990D00') AS mpc_stara,
                    to_char(s.mpc, 'FM999G999G999G990D00') AS mpc_nova,
                    to_char(round(s.iznos * nvl(s.porez_procenat, 0) / (100 + nvl(s.porez_procenat, 0)), 2), 'FM999G999G999G990D00') AS pdv_razlika
                FROM vw_rm_dokument_stavke s
                WHERE s.operacija_id = :P331_ID
                ORDER BY s.redni_broj, s.id
                ```
            pageItemsToSubmit: [
                P331_ID
                P331_TIP_KRETANJA
                P331_SKLADISTE_ID
                P331_POVRAT
                P331_VRSTA_SIFRA
            ]
        }
        layout {
            sequence: 20
            parentRegion: @stavke-sekcija
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ig
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Dodajte artikle dokumenta.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = "Dodaj artikal"; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("search");
                    toolbarData.toolbarRemove("actions");
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: false, autoAddRecord: false };
                    if (options.editable) { options.editable.autoAddRow = false; }
                    return options;
                }
                ```
        }
