            plsqlExpression: rm_dokument_pkg.ima_mjesto_troska(:P331_VRSTA_SIFRA) = 'Y' or rm_dokument_pkg.ima_radnika(:P331_VRSTA_SIFRA) = 'Y' or rm_dokument_pkg.ima_komitenta(:P331_VRSTA_SIFRA) = 'Y'
        }
