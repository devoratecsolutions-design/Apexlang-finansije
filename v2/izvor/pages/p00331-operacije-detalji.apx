            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT prikaz AS d, id AS r
                FROM vw_kuf_ugovori
                WHERE ooj_id = :APP_OOJ_ID
                  AND klijent_id = :P331_KLIJENT_ID
                  AND (aktivan = 'Y' OR id = :P331_UGOVOR_ID)
                ORDER BY broj DESC
                ```
        }
        cascadingLov {
            parentItems: P331_KLIJENT_ID
            itemsToSubmit: P331_UGOVOR_ID
        }
        layout {
            sequence: 40
            region: @dobavljac
