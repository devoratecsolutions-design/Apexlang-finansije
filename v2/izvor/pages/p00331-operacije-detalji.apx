    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Obrisati dokument sa svim stavkama?
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and :P331_IZMJENJIVA = 'Y' and rm_dokument_pkg.je_inventura(:P331_VRSTA_SIFRA) = 'N'
        }
    )

    button save (
        buttonName: SAVE
        label: Snimi
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_IZMJENJIVA = 'Y' and not (nvl(:P331_VRSTA_SIFRA, '-') = 'MPP' and :P331_ID is null)
        }
    )

    button zakljucaj (
        buttonName: ZAKLJUCAJ
        label: Zaključaj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-lock
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &P331_POTVRDA_ZAK.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and (:P331_TIP_KRETANJA = 'I' or :P331_POVRAT = 'Y' or :P331_VRSTA_SIFRA in ('RIV', 'FDK')) and :P331_IZMJENJIVA = 'Y'
        }
    )

