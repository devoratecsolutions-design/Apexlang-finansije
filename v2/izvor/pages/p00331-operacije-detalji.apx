        layout {
            sequence: 10
            region: @mjesto-troska
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Mjesto troška na koje se knjiži izlaz materijala (obavezno za dvojno knjigovodstvo).
        }
    )

    pageItem P331_ADMIN (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 16
            region: @dokument-detalji
            slot: regionBody
        }
    )

    pageItem P331_ZBIR (
        type: displayOnly
