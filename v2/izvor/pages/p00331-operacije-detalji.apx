    region revers-preostalo (
        name: Preostalo po reversima
        title: Preostalo za povrat po reversima
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    r.revers_naziv,
                    to_char(r.datum, 'DD.MM.YYYY') AS datum,
                    r.sifra,
                    r.naziv,
                    r.jm_naziv,
                    rtrim(to_char(r.izdato, 'FM999G999G999G990D999999'), '.,') AS izdato,
                    rtrim(to_char(r.preostalo, 'FM999G999G999G990D999999'), '.,') AS preostalo
                FROM vw_rm_revers_preostalo r
                WHERE r.ooj_id = :APP_OOJ_ID
                  AND r.revers_sifra = rm_dokument_pkg.revers_za_povrat(:P331_VRSTA_SIFRA)
                  AND r.partner_id = CASE WHEN rm_dokument_pkg.ima_radnika(:P331_VRSTA_SIFRA) = 'Y'
                                          THEN to_number(:P331_ZADUZENI_RADNIK_ID) ELSE to_number(:P331_KOMITENT_ID) END
                  AND r.preostalo > 0
                ORDER BY r.datum, r.revers_id, r.sifra
                ```
            pageItemsToSubmit: [
                P331_VRSTA_SIFRA
                P331_ZADUZENI_RADNIK_ID
                P331_KOMITENT_ID
            ]
        }
        layout {
            sequence: 50
            parentRegion: @dokument-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
            cssClasses: fin-section
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
