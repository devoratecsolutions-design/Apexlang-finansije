    region sb-unos (
        name: Unos po serijskom broju
        type: staticContent
        source {
            htmlCode: <span class="fin-sub">Skenirajte ili upišite serijski broj i pritisnite Enter - artikal se prepoznaje, stavka se dodaje ili joj se povećava količina.</span>
        }
        layout {
            sequence: 10
            parentRegion: @stavke-sekcija
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: fin-sb-unos
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and (:P331_TIP_KRETANJA = 'I' or :P331_VRSTA_SIFRA in ('PSI', 'RSR')) and :P331_VRSTA_SIFRA <> 'ZSA' and :P331_IZMJENJIVA = 'Y'
        }
    )

    region zbir (
