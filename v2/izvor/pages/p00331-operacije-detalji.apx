            sorting {
                sortable: false
            }
        )

        column CIJENA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Cijena
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column IZNOS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Iznos
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            columnFormatting {
                cssClasses: fin-num
