    button cancel (
        buttonName: ZATVORI
        label: Zatvori
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Obrisati dokument sa svim stavkama?
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and :P331_IZMJENJIVA = 'Y'
        }
    )

    button save (
        buttonName: SAVE
        label: Snimi
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_IZMJENJIVA = 'Y'
        }
    )

    button zakljucaj (
        buttonName: ZAKLJUCAJ
        label: Zaključaj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-lock
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Zaključati dokument? Cijene stavki se upisuju po prosječnoj cijeni skladišta na datum dokumenta, a roba se skida sa stanja.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and :P331_TIP_KRETANJA = 'I' and :P331_IZMJENJIVA = 'Y'
        }
    )

    button otkljucaj (
        buttonName: OTKLJUCAJ
        label: Otključaj
        layout {
            sequence: 15
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-unlock
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Otključati dokument? Roba se vraća na stanje dok se dokument ponovo ne zaključi.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and rm_dokument_pkg.razlog_zabrane_otkljucavanja(:P331_ID, :P331_ADMIN) is null
        }
    )

    validation datum-obavezno (
        name: P331_DATUM obavezno
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P331_DATUM
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P331_DATUM
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P331_IZMJENJIVA = 'Y'
        }
    )

    validation klijent-obavezno (
        name: P331_KLIJENT_ID obavezno
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P331_KLIJENT_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P331_KLIJENT_ID
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P331_IZMJENJIVA = 'Y' and nvl(:P331_TIP_KRETANJA, 'U') = 'U'
        }
    )

    validation mjesto-troska-obavezno (
        name: P331_MJESTO_TROSKA_ID obavezno
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P331_MJESTO_TROSKA_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P331_MJESTO_TROSKA_ID
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P331_IZMJENJIVA = 'Y' and rm_dokument_pkg.mjesto_troska_obavezno(:P331_VRSTA_SIFRA, :APP_TIP_PREDUZETNIKA_SIFRA) = 'Y'
        }
    )

    validation zaglavlje (
        name: Provjera zaglavlja (RM_DOKUMENT_PKG)
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return rm_dokument_pkg.provjeri_zaglavlje(
                    p_id                 => :P331_ID,
                    p_ooj_id             => :APP_OOJ_ID,
                    p_godina             => :APP_GODINA,
                    p_vrsta_dokumenta_id => :P331_VRSTA_DOKUMENTA_ID,
                    p_skladiste_id       => :P331_SKLADISTE_ID,
                    p_datum              => :P331_DATUM,
                    p_klijent_id         => :P331_KLIJENT_ID,
                    p_otpremnica_datum   => :P331_OTPREMNICA_DATUM,
                    p_ugovor_id          => :P331_UGOVOR_ID,
                    p_mjesto_troska_id   => :P331_MJESTO_TROSKA_ID,
                    p_tip_preduzetnika   => :APP_TIP_PREDUZETNIKA_SIFRA
                );
                ```
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P331_IZMJENJIVA = 'Y'
        }
    )

    dynamicAction sb-odustao (
        name: Unos serijskih brojeva zatvoren (X) - osvježi
        execution {
            sequence: 25
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @serijski-brojevi
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @serijski-brojevi
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stavke
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction sb-zatvoren (
        name: Unos serijskih brojeva zatvoren - osvježi
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @serijski-brojevi
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @serijski-brojevi
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stavke
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process ucitaj (
        name: Učitavanje dokumenta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for d in (select * from vw_rm_dokumenti where id = :P331_ID and ooj_id = :APP_OOJ_ID) loop
                    :P331_VRSTA_DOKUMENTA_ID := d.vrsta_dokumenta_id;
                    :P331_VRSTA_SIFRA        := d.vrsta_sifra;
                    :P331_VRSTA_NAZIV        := d.vrsta_naziv;
                    :P331_TIP_KRETANJA       := d.tip_kretanja;
                    :P331_ZBIR               := to_char(d.iznos, 'FM999G999G999G990D00');
                    :P331_NAZIV              := d.naziv;
                    :P331_STATUS             := d.status;
                    :P331_SKLADISTE_ID       := d.skladiste_id;
                    :P331_SKLADISTE          := d.skladiste_sifra || ' - ' || d.skladiste_naziv;
                    :P331_DATUM              := d.datum;
                    :P331_OPIS               := d.opis;
                    :P331_KLIJENT_ID         := d.klijent_id;
                    :P331_OTPREMNICA_BROJ    := d.otpremnica_broj;
                    :P331_OTPREMNICA_DATUM   := d.otpremnica_datum;
                    :P331_UGOVOR_ID          := d.ugovor_id;
                    :P331_MJESTO_TROSKA_ID   := d.mjesto_troska_id;
                    :P331_KALKULACIJA        := case when d.kalkulacija_naziv is not null then 'Kalkulacija ' || d.kalkulacija_naziv end;
                    :P331_STATUS_KLASA       := case when d.stornirano = 'Y' then 'storno'
                                                     when d.glavna_knjiga_id is not null then 'proknjizena'
                                                     when d.status = 'Z' then 'zakljucena' else 'priprema' end;
                    :P331_STATUS_NAZIV       := case when d.stornirano = 'Y' then 'Storniran'
                                                     when d.glavna_knjiga_id is not null then 'Proknjižen'
                                                     when d.status = 'Z' then 'Zaključen'
                                                     when d.u_kalkulaciji_id is not null then 'U kalkulaciji'
                                                     else 'U pripremi' end;
                    :P331_STATUS_IKONA       := case when d.stornirano = 'Y' then 'fa-ban'
                                                     when d.glavna_knjiga_id is not null then 'fa-book'
                                                     when d.status = 'Z' then 'fa-lock'
                                                     when d.u_kalkulaciji_id is not null then 'fa-calculator'
                                                     else 'fa-pencil' end;
                end loop;
                :P331_RAZLOG := rm_dokument_pkg.razlog_zabrane(:P331_ID);
                :P331_IZMJENJIVA := rm_dokument_pkg.izmjenjiv(:P331_ID);
                :P331_ADMIN := case when apex_authorization.is_authorized('MAIN ADMIN') then 'Y' else 'N' end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P331_ID
        }
    )

    process nova (
        name: Novi dokument - početne vrijednosti
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P331_IZMJENJIVA    := 'Y';
                :P331_STATUS        := 'P';
                :P331_STATUS_KLASA  := 'priprema';
                :P331_STATUS_NAZIV  := 'U pripremi';
                :P331_STATUS_IKONA  := 'fa-pencil';
                :P331_SKLADISTE_ID  := :A_SKLADISTE_ID;
                :P331_DATUM         := nvl(:P331_DATUM, trunc(sysdate));
                for s in (select sifra || ' - ' || naziv as n from skladista where id = :A_SKLADISTE_ID) loop
                    :P331_SKLADISTE := s.n;
                end loop;
                -- iz menija: vrsta zadata šifrom (npr. PRI) -> vrsta iste firme u modulu MAT
                if :P331_VRSTA_DOKUMENTA_ID is null and :P331_VRSTA_SIFRA is not null then
                    select max(vd.id) into :P331_VRSTA_DOKUMENTA_ID
                      from sif.vrste_dokumenata vd
                      join sif.acc_moduli m on m.id = vd.acc_modul_id and upper(m.sifra) = 'MAT'
                     where vd.ooj_id = :APP_OOJ_ID and upper(vd.sifra) = upper(:P331_VRSTA_SIFRA) and vd.valid = 'Y';
                end if;
                for v in (select vd.sifra, vd.naziv from sif.vrste_dokumenata vd where vd.id = :P331_VRSTA_DOKUMENTA_ID) loop
                    :P331_VRSTA_SIFRA := upper(v.sifra);
                    :P331_TIP_KRETANJA := rm_dokument_pkg.tip_kretanja(v.sifra);
                    :P331_ZBIR := '0,00';
                    :P331_VRSTA_NAZIV := v.naziv;
                    :P331_NAZIV       := 'Nova ' || lower(v.naziv);
                end loop;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNull
            item: P331_ID
        }
    )

    process snimi (
        name: Snimi zaglavlje
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P331_ID := rm_dokument_pkg.snimi(
                    p_id                 => :P331_ID,
                    p_ooj_id             => :APP_OOJ_ID,
                    p_godina             => :APP_GODINA,
                    p_vrsta_dokumenta_id => :P331_VRSTA_DOKUMENTA_ID,
                    p_skladiste_id       => :P331_SKLADISTE_ID,
                    p_datum              => :P331_DATUM,
                    p_klijent_id         => :P331_KLIJENT_ID,
                    p_otpremnica_broj    => :P331_OTPREMNICA_BROJ,
                    p_otpremnica_datum   => :P331_OTPREMNICA_DATUM,
                    p_opis               => :P331_OPIS,
                    p_ugovor_id          => :P331_UGOVOR_ID,
                    p_mjesto_troska_id   => :P331_MJESTO_TROSKA_ID,
                    p_tip_preduzetnika   => :APP_TIP_PREDUZETNIKA_SIFRA
                );
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P331_IZMJENJIVA = 'Y'
        }
    )

    process stavke-snimi (
        name: Stavke - snimi redove
        type: executeCode
        editableRegion: @stavke
        source {
            plsqlCode:
                ```plsql
                begin
                    declare
                        -- vrijednosti iz tabele su tekst; novi red ima privremeni ID (t1000) -> kuf_pkg.broj vraća null
                        l_id number := kuf_pkg.broj(:ID);
                    begin
                        if :APEX$ROW_STATUS = 'D' then
                            rm_dokument_pkg.obrisi_stavku(p_id => l_id);
                        else
                            rm_dokument_pkg.snimi_stavku(
                                p_id          => l_id,
                                p_dokument_id => :P331_ID,
                                p_stavka_id   => kuf_pkg.broj(:STAVKA_ID),
                                p_kolicina    => kuf_pkg.broj(:KOLICINA),
                                p_cijena      => kuf_pkg.broj(:CIJENA)
                            );
                            :ID := l_id;
                        end if;
                    end;
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Dokument je snimljen.
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ') and :P331_IZMJENJIVA = 'Y'
        }
    )

    process zakljucaj (
        name: Zaključaj izlazni dokument
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                rm_dokument_pkg.zakljucaj(p_id => :P331_ID, p_tip_preduzetnika => :APP_TIP_PREDUZETNIKA_SIFRA);
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Dokument je zaključen.
        }
        serverSideCondition {
            whenButtonPressed: @zakljucaj
        }
    )

    process otkljucaj (
        name: Otključaj izlazni dokument
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                rm_dokument_pkg.otkljucaj(p_id    => :P331_ID,
                                          p_admin => case when apex_authorization.is_authorized('MAIN ADMIN') then 'Y' else 'N' end);
                ```
        }
        execution {
            sequence: 45
        }
        successMessage {
            successMessage: Dokument je otključan.
        }
        serverSideCondition {
            whenButtonPressed: @otkljucaj
        }
    )

    process ajax-artikl-info (
        name: ARTIKL_INFO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sys.htp.p(rm_dokument_pkg.artikl_info(
                    p_stavka_id    => apex_application.g_x01,
                    p_dokument_id  => :P331_ID,
                    p_skladiste_id => :P331_SKLADISTE_ID,
                    p_datum        => :P331_DATUM
                ));
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
    )

    process obrisi (
        name: Obriši
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                rm_dokument_pkg.obrisi(p_id => :P331_ID);
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Dokument je obrisan.
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process close-dialog (
        name: Zatvori dijalog
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,ZATVORI
        }
    )

    branch (
        name: Ostani na dokumentu
        execution {
            sequence: 50
        }
        behavior {
            target: {
                page: 331
                items: {
                    P331_ID: &P331_ID.
                }
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,ZAKLJUCAJ,OTKLJUCAJ
        }
    )

)
