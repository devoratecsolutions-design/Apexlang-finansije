            }
            validation {
                valueRequired: true
            }
        )

        column CIJENA (
            type: textField
            heading {
                heading: Jed. cijena
                alignment: end
            }
            layout {
                sequence: 62
                columnAlignment: end
            }
            source {
                databaseColumn: CIJENA
                dataType: varchar2
            }
        )

        column IZNOS (
            type: numberField
            heading {
                heading: Iznos
                alignment: end
            }
            layout {
                sequence: 64
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
