        }
        validation {
            type: itemIsNotNull
            item: P331_KLIJENT_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P331_KLIJENT_ID
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'ZAKLJUCAJ', 'POVRAT') and :P331_IZMJENJIVA = 'Y' and nvl(:P331_VRSTA_SIFRA, 'PRI') = 'PRI'
        }
    )

    validation mjesto-troska-obavezno (
        name: P331_MJESTO_TROSKA_ID obavezno
