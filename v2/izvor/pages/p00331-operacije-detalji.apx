page 331 (
    name: Dokument skladišta
    alias: OPERACIJE-DETALJI
    title: Dokument skladišta
    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--xl
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            finRmStavke.init('rm_stavke', 'P331');
            ```
    }
    css {
        inline:
            ```css
            .ui-dialog-titlebar-close {
                display: none !important;
            }
            ```
    }
    security {
        authorizationScheme: @robno-materijalno-dokumenti
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region dokument-traka (
        name: Traka dokumenta
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="fin-docbar">
                  <span class="fin-docbar__no">&P331_NAZIV.</span>
                  <span class="fin-status fin-status--&P331_STATUS_KLASA."><span class="fa &P331_STATUS_IKONA." aria-hidden="true"></span>&P331_STATUS_NAZIV.</span>
                  <span class="fin-docbar__meta">&P331_VRSTA_NAZIV.</span>
                  <span class="fin-docbar__meta">&P331_SKLADISTE.</span>
                  <span class="fin-docbar__meta">&P331_KALKULACIJA.</span>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region zakljucan (
        name: Dokument se ne može mijenjati
        type: staticContent
        source {
            htmlCode: &P331_RAZLOG.
        }
        layout {
            sequence: 7
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and :P331_IZMJENJIVA = 'N'
        }
    )

    region dokument-detalji (
        name: Dokument / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
        readOnly {
            type: expression
            plsqlExpression: :P331_IZMJENJIVA = 'N'
        }
    )

    region dokument (
        name: Dokument
        title: Dokument
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @dokument-detalji
            slot: subRegions
            columnSpan: 5
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region dobavljac (
        name: Dobavljač i ugovor
        title: Dobavljač i ugovor
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @dokument-detalji
            slot: subRegions
            startNewRow: false
            columnSpan: 7
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
        serverSideCondition {
            type: expression
            plsqlExpression: nvl(:P331_TIP_KRETANJA, 'U') = 'U'
        }
    )

    region mjesto-troska (
        name: Mjesto troška
        title: Mjesto troška
        type: staticContent
        layout {
            sequence: 25
            parentRegion: @dokument-detalji
            slot: subRegions
            startNewRow: false
            columnSpan: 7
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
        serverSideCondition {
            type: expression
            plsqlExpression: rm_dokument_pkg.mjesto_troska_obavezno(:P331_VRSTA_SIFRA, :APP_TIP_PREDUZETNIKA_SIFRA) = 'Y'
        }
    )

    region stavke-sekcija (
        name: Stavke
        title: Stavke
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @dokument-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region stavke (
        name: Stavke - tabela
        title: Stavke
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    s.id,
                    s.redni_broj,
                    s.stavka_id,
                    s.jm_naziv,
                    rtrim(to_char(CASE WHEN :P331_TIP_KRETANJA = 'I'
                         THEN rm_dokument_pkg.raspolozivo(:P331_SKLADISTE_ID, s.stavka_id, null, s.operacija_id)
                         ELSE rm_dokument_pkg.stanje(:P331_SKLADISTE_ID, s.stavka_id, null, s.operacija_id) END,
                         'FM999G999G999G990D999999'), '.,') AS raspolozivo,
                    rtrim(to_char(s.kolicina, 'FM999999999990D999999'), '.,') AS kolicina,
                    CASE WHEN s.cijena = round(s.cijena, 2) THEN to_char(s.cijena, 'FM999G999G999G990D00')
                         ELSE rtrim(to_char(s.cijena, 'FM999G999G999G990D999999'), '0') END AS cijena,
                    s.iznos,
                    CASE WHEN s.prati_sb = 'Y' THEN s.sb_uneseno || ' / ' || s.kolicina || CASE WHEN s.sb_ok = 'N' THEN '  ⚠' END END AS sb
                FROM vw_rm_dokument_stavke s
                WHERE s.operacija_id = :P331_ID
                ORDER BY s.redni_broj, s.id
                ```
            pageItemsToSubmit: [
                P331_ID
                P331_TIP_KRETANJA
                P331_SKLADISTE_ID
            ]
        }
        layout {
            sequence: 20
            parentRegion: @stavke-sekcija
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ig
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Dodajte artikle dokumenta.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = "Dodaj artikal"; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("search");
                    toolbarData.toolbarRemove("actions");
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: false, autoAddRecord: false };
                    if (options.editable) { options.editable.autoAddRow = false; }
                    return options;
                }
                ```
        }
        advanced {
            htmlDomId: rm_stavke
            savedReportMappingIdentifier: 3310000000000001
        }
        readOnly {
            type: expression
            plsqlExpression: :P331_IZMJENJIVA = 'N'
        }

        savedReport 3310000000000002 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @STAVKA_ID
                layout {
                    sequence: 2
                    width: 380
                }
            )

            displayColumn (
                column: @JM_NAZIV
                layout {
                    sequence: 3
                    width: 55
                }
            )

            displayColumn (
                column: @RASPOLOZIVO
                layout {
                    sequence: 4
                    width: 100
                }
            )

            displayColumn (
                column: @KOLICINA
                layout {
                    sequence: 5
                    width: 100
                }
            )

            displayColumn (
                column: @CIJENA
                layout {
                    sequence: 6
                    width: 110
                }
            )

            displayColumn (
                column: @IZNOS
                layout {
                    sequence: 7
                    width: 110
                }
            )

            displayColumn (
                column: @SB
                layout {
                    sequence: 8
                    width: 80
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )

        column REDNI_BROJ (
            type: hidden
            layout {
                sequence: 35
            }
            source {
                databaseColumn: REDNI_BROJ
                dataType: number
                queryOnly: true
            }
        )

        column STAVKA_ID (
            type: popupLov
            heading {
                heading: Artikal
            }
            settings {
                popupWidth: 640
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT sifra || ' - ' || naziv || CASE WHEN prati_sb = 'Y' THEN ' (SB)' END AS d,
                           id AS r
                    FROM vw_rm_artikli
                    WHERE ooj_id = :APP_OOJ_ID
                      AND valid = 'Y'
                      AND nvl(tip_stavke_id, 0) <> 3
                    ORDER BY sifra
                    ```
                displayExtraValues: true
                displayNullValue: true
                nullDisplayValue: - izaberite artikal -
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: STAVKA_ID
                dataType: number
            }
            validation {
                valueRequired: true
            }
        )

        column JM_NAZIV (
            type: textField
            heading {
                heading: JM
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: JM_NAZIV
                dataType: varchar2
                queryOnly: true
            }
        )

        column RASPOLOZIVO (
            type: textField
            heading {
                heading: Na skladištu
                alignment: end
            }
            layout {
                sequence: 55
                columnAlignment: end
            }
            source {
                databaseColumn: RASPOLOZIVO
                dataType: varchar2
                queryOnly: true
            }
        )

        column KOLICINA (
            type: textField
            heading {
                heading: Količina
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: KOLICINA
