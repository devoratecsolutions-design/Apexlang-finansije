        }
        serverSideCondition {
            type: expression
            plsqlExpression: rm_dokument_pkg.mjesto_troska_obavezno(:P331_VRSTA_SIFRA, :APP_TIP_PREDUZETNIKA_SIFRA, :APP_OOJ_ID) = 'Y' or rm_dokument_pkg.ima_radnika(:P331_VRSTA_SIFRA) = 'Y' or rm_dokument_pkg.ima_komitenta(:P331_VRSTA_SIFRA) = 'Y'
        }
    )

    region stavke-sekcija (
        name: Stavke
        title: Stavke
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @dokument-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region stavke (
        name: Stavke - tabela
        title: Stavke
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    s.id,
                    s.redni_broj,
                    s.stavka_id,
                    s.jm_naziv,
                    rtrim(to_char(CASE WHEN :P331_POVRAT = 'Y'
                         THEN rm_dokument_pkg.dostupno_za_povrat_dok(s.operacija_id, s.stavka_id)
                         WHEN :P331_TIP_KRETANJA = 'I'
                         THEN rm_dokument_pkg.raspolozivo(:P331_SKLADISTE_ID, s.stavka_id, null, s.operacija_id)
                         ELSE rm_dokument_pkg.stanje(:P331_SKLADISTE_ID, s.stavka_id, null, s.operacija_id) END,
                         'FM999G999G999G990D999999'), '.,') AS raspolozivo,
                    rtrim(to_char(s.kolicina, 'FM999999999990D999999'), '.,') AS kolicina,
                    CASE WHEN s.cijena = round(s.cijena, 2) THEN to_char(s.cijena, 'FM999G999G999G990D00')
                         ELSE rtrim(to_char(s.cijena, 'FM999G999G999G990D999999'), '0') END AS cijena,
                    s.iznos,
                    CASE WHEN s.prati_sb = 'Y' THEN s.sb_uneseno || ' / ' || s.kolicina || CASE WHEN s.sb_ok = 'N' THEN '  ⚠' END END AS sb
                FROM vw_rm_dokument_stavke s
                WHERE s.operacija_id = :P331_ID
                ORDER BY s.redni_broj, s.id
                ```
            pageItemsToSubmit: [
                P331_ID
                P331_TIP_KRETANJA
                P331_SKLADISTE_ID
                P331_POVRAT
            ]
        }
        layout {
            sequence: 20
            parentRegion: @stavke-sekcija
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ig
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Dodajte artikle dokumenta.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = "Dodaj artikal"; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("search");
                    toolbarData.toolbarRemove("actions");
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: false, autoAddRecord: false };
                    if (options.editable) { options.editable.autoAddRow = false; }
                    return options;
                }
                ```
        }
        advanced {
            htmlDomId: rm_stavke
            savedReportMappingIdentifier: 3310000000000001
        }
        readOnly {
            type: expression
            plsqlExpression: :P331_IZMJENJIVA = 'N'
        }

        savedReport 3310000000000002 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @STAVKA_ID
                layout {
                    sequence: 2
                    width: 380
                }
            )

            displayColumn (
                column: @JM_NAZIV
                layout {
                    sequence: 3
                    width: 55
                }
            )

            displayColumn (
                column: @RASPOLOZIVO
                layout {
                    sequence: 4
                    width: 100
                }
            )

            displayColumn (
                column: @KOLICINA
                layout {
                    sequence: 5
                    width: 100
                }
            )

            displayColumn (
                column: @CIJENA
                layout {
                    sequence: 6
                    width: 110
                }
            )

            displayColumn (
                column: @IZNOS
                layout {
                    sequence: 7
                    width: 110
                }
            )

            displayColumn (
                column: @SB
                layout {
                    sequence: 8
                    width: 80
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )

        column REDNI_BROJ (
            type: hidden
            layout {
                sequence: 35
            }
            source {
                databaseColumn: REDNI_BROJ
                dataType: number
                queryOnly: true
            }
        )

        column STAVKA_ID (
            type: popupLov
            heading {
                heading: Artikal
            }
            settings {
                popupWidth: 640
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT sifra || ' - ' || naziv || CASE WHEN prati_sb = 'Y' THEN ' (SB)' END AS d,
                           id AS r
                    FROM vw_rm_artikli
                    WHERE ooj_id = :APP_OOJ_ID
                      AND valid = 'Y'
                      AND nvl(tip_stavke_id, 0) <> 3
                      AND (nvl(:P331_POVRAT, 'N') <> 'Y' OR :P331_ID IS NULL
                           OR rm_dokument_pkg.dostupno_za_povrat_dok(:P331_ID, id) > 0
                           OR id IN (SELECT os.stavka_id FROM operacija_stavke os WHERE os.operacija_id = :P331_ID))
                    ORDER BY sifra
                    ```
                displayExtraValues: true
                displayNullValue: true
                nullDisplayValue: - izaberite artikal -
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: STAVKA_ID
                dataType: number
            }
            validation {
                valueRequired: true
            }
        )

        column JM_NAZIV (
            type: textField
            heading {
                heading: JM
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: JM_NAZIV
                dataType: varchar2
                queryOnly: true
            }
        )

