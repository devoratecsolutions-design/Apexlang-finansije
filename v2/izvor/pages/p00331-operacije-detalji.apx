        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Nema preostalih količina za povrat kod izabranog radnika / komitenta (prikazuju se zaključeni reversi sa preostalom količinom; povrati se raspoređuju na najstarije reverse).
        }
        advanced {
            htmlDomId: rm_revers_preostalo
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_POVRAT = 'Y' and rm_dokument_pkg.je_si(:P331_VRSTA_SIFRA) = 'N'
        }

        column REVERS_NAZIV (
            reportColumnQueryId: 1
