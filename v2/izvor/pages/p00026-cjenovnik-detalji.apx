page 26 (
    name: Cjenovnik / Detalji
    alias: CJENOVNIK-DETALJI
    title: Cjenovnik / Detalji
    pageGroup: @stavke
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region cjenovnik-detalji (
        name: Cjenovnik / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
    )

    region stavka-cjenovnik (
        name: Stavka i cjenovnik
        title: Stavka i cjenovnik
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @cjenovnik-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region cijene (
        name: Cijene
        title: Cijene
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @cjenovnik-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region status (
        name: Status
        title: Status
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @cjenovnik-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    pageItem P26_LBL_VPC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 150
            region: @cjenovnik-detalji
            slot: regionBody
        }
    )

    pageItem P26_PDV_SISTEM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 150
            region: @cjenovnik-detalji
            slot: regionBody
        }
    )

    pageItem P26_CJENOVNIK_ID (
        type: selectOne
        label {
            label: Cjenovnik
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @cjenovnici
        }
        layout {
            sequence: 10
            region: @stavka-cjenovnik
            slot: regionBody
            columnSpan: 8
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: itemIsNotNull
            item: P26_ID
        }
    )

    pageItem P26_DATUM (
        type: displayOnly
        label {
            label: Datum unosa
            alignment: left
        }
        layout {
            sequence: 20
            region: @stavka-cjenovnik
            slot: regionBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P26_ID (
        type: hidden
        layout {
            sequence: 20
            region: @cjenovnik-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P26_MARZA (
        type: numberField
        label {
            label: Marža (%)
            alignment: left
        }
        settings {
            numberAlignment: end
        }
        layout {
            sequence: 20
            region: @cijene
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            formatMask: FM999G990D00
        }
        help {
            helpText: Pomoć za račun, ne čuva se. Izmjena marže preračunava VPC i MPC; izmjena nabavne cijene, VPC ili MPC preračunava maržu = (VPC - nabavna) / nabavna x 100. Za usluge je dovoljno unijeti VPC.
        }
    )

    pageItem P26_MPC (
        type: numberField
        label {
            label: Maloprodajna cijena
            alignment: left
        }
        settings {
            numberAlignment: end
        }
        layout {
            sequence: 40
            region: @cijene
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G999G990D00
        }
        validation {
            maxLength: 255
        }
        help {
            helpText: Cijena po kojoj se roba/usluga prodaje krajnjem kupcu u prodavnici. U cijenu je uračunat PDV.
        }
        serverSideCondition {
            type: item=value
            item: P26_PDV_SISTEM
            value: Y
        }
    )

    pageItem P26_NABAVNA_CIJENA (
        type: textField
        label {
            label: Prosječna nabavna cijena
            alignment: left
        }
        layout {
            sequence: 10
            region: @cijene
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G999G990D0000
        }
        help {
            helpText: Prosječnu nabavnu cijenu određuju kalkulacija i prijemi. Izmjena u veleprodajnom cjenovniku (korekcija greške) usklađuje vrijednost zaliha svih skladišta tog cjenovnika automatskim finansijskim doknjiženjem; u maloprodaji je informativna. Izmjena MPC u maloprodajnom cjenovniku nivelira zalihe svih maloprodajnih skladišta cjenovnika.
        }
    )

    pageItem P26_NAPOMENA (
        type: textarea
        label {
            label: Napomena (razlog izmjene)
            alignment: left
        }
        validation {
            maxLength: 1000
        }
        layout {
            sequence: 90
            region: @cijene
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            height: 2
        }
        help {
            helpText: Upisuje se u istoriju cjenovnika i u opis automatskih dokumenata (finansijsko doknjiženje / nivelacija).
        }
    )

