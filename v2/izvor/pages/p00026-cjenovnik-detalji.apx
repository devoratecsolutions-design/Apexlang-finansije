    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction get-data-for-stavke (
        name: Popuni podatke za stavku
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P26_STAVKA_ID
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P26_STAVKA_ID
        }

        action native-javascript-code-pocetak (
            action: executeJsCode
            settings {
                jsCode: window.finCijenaUcitava = true;
            }
            execution {
                sequence: 1
                fireOnInit: false
            }
        )

        action native-set-value (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        SELECT st.naziv, st.tip_stavke_id, to_char(round(st.marza, 2), 'FM999G990D00'),
                               stavke_pkg.pdv_stopa(st.id, :APP_OOJ_ID)
                          INTO :P26_STAVKA_NAZIV, :P26_TIP_USLUGE, :P26_MARZA, :P26_PDV
                          FROM sec_stavke st
                          LEFT JOIN sif.acc_pdv_indikatori p ON p.id = st.pdv_indikator_id
                         WHERE st.id = :P26_STAVKA_ID;
                    END;
                    ```
                itemsToSubmit: [
                    P26_STAVKA_ID
                    P26_PDV_SISTEM
                ]
                itemsToReturn: [
                    P26_STAVKA_NAZIV
                    P26_TIP_USLUGE
                    P26_MARZA
                    P26_PDV
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code-kraj (
            action: executeJsCode
            settings {
                jsCode: window.finCijenaUcitava = false; finCijena.upozori('P26');
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

    )

    dynamicAction popuni-podatke-iz-cjenovnika (
        name: Popuni podatke iz cjenovnika
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: [
                P26_CJENOVNIK_ID
                P26_STAVKA_ID
            ]
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression:
                ```javascript-browser
                $v('P26_CJENOVNIK_ID') !== "" && 
                $v('P26_STAVKA_ID') !== ""
                
                ```
        }

        action native-javascript-code-pocetak (
            action: executeJsCode
            settings {
                jsCode: window.finCijenaUcitava = true;
            }
            execution {
                sequence: 1
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: finCijena.upozori('P26');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-show (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        c_maska CONSTANT VARCHAR2(30) := 'FM999G999G999G999G990D00';
                    BEGIN
                        :P26_NABAVNA_CIJENA := NULL;
                        :P26_VPC := NULL;
                        :P26_MPC := NULL;
                        :P26_MARZA := NULL;
                        FOR c IN (SELECT cs.nabavna_cijena, cs.vpc, cs.mpc,
                                         CASE WHEN cs.nabavna_cijena > 0 THEN (cs.vpc / cs.nabavna_cijena - 1) * 100 END AS marza
                                    FROM cjenovnik_stavke cs
                                   WHERE cs.cjenovnik_id = :P26_CJENOVNIK_ID AND cs.stavka_id = :P26_STAVKA_ID
                                     AND cs.valid = 'Y'
                                   ORDER BY cs.datum DESC NULLS LAST, cs.id DESC
                                   FETCH FIRST 1 ROWS ONLY) LOOP
                            :P26_NABAVNA_CIJENA := to_char(round(c.nabavna_cijena, 4), 'FM999G999G999G999G990D0000');
                            :P26_VPC := to_char(round(c.vpc, 2), c_maska);
                            :P26_MPC := to_char(round(c.mpc, 2), c_maska);
                            :P26_MARZA := to_char(round(c.marza, 2), 'FM999G990D00');
                        END LOOP;
                        IF :P26_MARZA IS NULL THEN
                            SELECT max(to_char(round(marza, 2), 'FM999G990D00')) INTO :P26_MARZA
                              FROM sec_stavke WHERE id = :P26_STAVKA_ID;
                        END IF;
                    END;
                    ```
                itemsToSubmit: [
                    P26_STAVKA_ID
                    P26_CJENOVNIK_ID
                ]
                itemsToReturn: [
                    P26_NABAVNA_CIJENA
                    P26_VPC
                    P26_MPC
                    P26_MARZA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code-kraj (
            action: executeJsCode
            settings {
                jsCode: window.finCijenaUcitava = false; finCijena.upozori('P26');
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

    )

    validation marza-nenegativna (
        name: P26_MARZA >= 0
        execution {
            sequence: 72
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                RETURN :P26_MARZA IS NULL
                    OR nvl(to_number(:P26_MARZA DEFAULT -1 ON CONVERSION ERROR, 'FM999G990D00'), -1) >= 0;
                ```
        }
        error {
            errorMessage: #LABEL# mora biti broj veći ili jednak nuli, sa najviše dvije decimale.
            associatedItem: @P26_MARZA
        }
    )

    validation mpc-nenegativna (
        name: P26_MPC >= 0
        execution {
            sequence: 71
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                RETURN :P26_MPC IS NULL
                    OR nvl(to_number(:P26_MPC DEFAULT -1 ON CONVERSION ERROR, 'FM999G999G999G999G990D00'), -1) >= 0;
                ```
        }
        error {
            errorMessage: #LABEL# mora biti broj veći ili jednak nuli, sa najviše dvije decimale.
            associatedItem: @P26_MPC
        }
    )

    validation vpc-nenegativna (
        name: P26_VPC >= 0
        execution {
            sequence: 70
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                RETURN :P26_VPC IS NULL
                    OR nvl(to_number(:P26_VPC DEFAULT -1 ON CONVERSION ERROR, 'FM999G999G999G999G990D00'), -1) >= 0;
                ```
        }
        error {
            errorMessage: #LABEL# mora biti broj veći ili jednak nuli, sa najviše dvije decimale.
            associatedItem: @P26_VPC
        }
    )

    validation vpc-not-null (
        name: VPC NOT NULL
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P26_VPC
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P26_VPC
        }
    )

    validation cjenovnik-not-null (
        name: Cjenovnik NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P26_CJENOVNIK_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P26_CJENOVNIK_ID
        }
    )

    validation datum-not-null (
