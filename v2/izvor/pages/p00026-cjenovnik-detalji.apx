        }
        layout {
            sequence: 10
            region: @status
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P26_ID
        }
    )

    pageItem P26_VPC (
        type: numberField
        label {
            label: &P26_LBL_VPC.
            alignment: left
        }
        settings {
            numberAlignment: end
        }
        layout {
            sequence: 30
            region: @cijene
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G999G990D00
        }
        validation {
            maxLength: 255
        }
        help {
            helpText: Cijena po kojoj se roba prodaje pravnim licima i preduzetnicima, najčešće radi dalje prodaje ili upotrebe u poslovanju. Iskazuje se bez PDV-a.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: never
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 10
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P26_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 20
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P26_ID
        }
    )

    dynamicAction racun-marza-ucitavanje (
        name: Marža pri otvaranju
        execution {
            sequence: 37
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    finCijena.izmjenaNabavne('P26');
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

