        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process new (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_datum DATE;
                BEGIN
                    :P26_PDV_SISTEM := nvl(core.ooj_pkg.get_ooj_pdv_sistem(:APP_OOJ_ID), 'N');
                    :P26_LBL_VPC := CASE WHEN :P26_PDV_SISTEM = 'Y' THEN 'Veleprodajna cijena (bez PDV)' ELSE 'Prodajna cijena' END;

                    IF :P26_ID IS NULL THEN
                        :P26_DATUM := to_char(sysdate, 'DD.MM.YYYY HH24:MI');
                    ELSE
                        stavke_pkg.get_cjenovnik_stavka(
                            p_id             => :P26_ID,
                            p_cjenovnik_id   => :P26_CJENOVNIK_ID,
                            p_stavka_id      => :P26_STAVKA_ID,
                            p_datum          => l_datum,
                            p_nabavna_cijena => :P26_NABAVNA_CIJENA,
                            p_mpc            => :P26_MPC,
                            p_vpc            => :P26_VPC,
                            p_valid          => :P26_VALID);
                        :P26_DATUM := to_char(l_datum, 'DD.MM.YYYY HH24:MI');
                        FOR c IN (SELECT s.naziv, s.tip_stavke_id,
                                         coalesce(CASE WHEN cs.nabavna_cijena > 0 THEN (cs.vpc / cs.nabavna_cijena - 1) * 100 END,
                                                  s.marza) AS marza,
                                         stavke_pkg.pdv_stopa(s.id, :APP_OOJ_ID) AS pdv
                                    FROM cjenovnik_stavke cs
                                    LEFT JOIN sec_stavke s ON s.id = cs.stavka_id
                                    LEFT JOIN sif.acc_pdv_indikatori p ON p.id = s.pdv_indikator_id
                                   WHERE cs.id = :P26_ID) LOOP
                            :P26_STAVKA_NAZIV := c.naziv;
                            :P26_TIP_USLUGE := c.tip_stavke_id;
                            :P26_MARZA := to_char(round(c.marza, 2), 'FM999G990D00');
                            :P26_PDV := c.pdv;
                        END LOOP;
                        :P26_NABAVNA_CIJENA := to_char(round(to_number(:P26_NABAVNA_CIJENA), 4), 'FM999G999G999G999G990D0000');
                        :P26_VPC := to_char(round(to_number(:P26_VPC), 2), 'FM999G999G999G999G990D00');
                        :P26_MPC := to_char(round(to_number(:P26_MPC), 2), 'FM999G999G999G999G990D00');
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 42786217664541211
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P26_VALID = 'Y' THEN
                -- R23: ručna izmjena kroz RM_CJENOVNIK_PKG (napomena, doknjiženje / nivelacija)
                declare
                    l_vpc number := kuf_pkg.broj(:P26_VPC);
                begin
                    apex_application.g_print_success_message := rm_cjenovnik_pkg.rucna_izmjena(
                        p_cjenovnik_id => :P26_CJENOVNIK_ID,
                        p_stavka_id    => :P26_STAVKA_ID,
                        p_nabavna      => kuf_pkg.broj(:P26_NABAVNA_CIJENA),
                        p_vpc          => l_vpc,
                        p_mpc          => case when :P26_PDV_SISTEM = 'Y' then kuf_pkg.broj(:P26_MPC) else l_vpc end,
                        p_napomena     => :P26_NAPOMENA);
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ELSE
                    stavke_pkg.deaktiviraj_cjenovnik_stavka (
                        p_id => :P26_ID
                    );
                END IF;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Cijena je snimljena u cjenovnik (po potrebi su napravljeni finansijsko doknjiženje ili nivelacija).
        }
        advanced {
            executionMappingIdentifier: 42788039489541229
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

