    dynamicAction racun-iz-nabavne (
        name: Račun iz nabavne i marže
        execution {
            sequence: 30
        }
        when {
            event: keyup
            selectionType: items
            items: P26_MARZA
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    finCijena.izNabavne('P26');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

