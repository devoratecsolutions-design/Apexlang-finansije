        name: Račun MPC iz VPC
        execution {
            sequence: 31
        }
        when {
            event: keyup
            selectionType: items
            items: P26_VPC
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    finCijena.izVpc('P26');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

