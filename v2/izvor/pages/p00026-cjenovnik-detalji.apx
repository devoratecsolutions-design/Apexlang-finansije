    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- R23: ručna izmjena kroz RM_CJENOVNIK_PKG (napomena, doknjiženje / nivelacija)
                declare
                    l_vpc number := kuf_pkg.broj(:P26_VPC);
                begin
                    apex_application.g_print_success_message := rm_cjenovnik_pkg.rucna_izmjena(
                        p_cjenovnik_id => :P26_CJENOVNIK_ID,
                        p_stavka_id    => :P26_STAVKA_ID,
                        p_nabavna      => kuf_pkg.broj(:P26_NABAVNA_CIJENA),
                        p_vpc          => l_vpc,
                        p_mpc          => case when :P26_PDV_SISTEM = 'Y' then kuf_pkg.broj(:P26_MPC) else l_vpc end,
                        p_napomena     => :P26_NAPOMENA);
                exception
                    when others then
                        if sqlcode between -20999 and -20000 then
                            apex_error.add_error(
                                p_message          => regexp_replace(sqlerrm, '^ORA-[0-9]+: (Greška CORP-[A-Z]+: )?', ''),
                                p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Cijena je snimljena u cjenovnik (po potrebi su napravljeni finansijsko doknjiženje ili nivelacija).
        }
