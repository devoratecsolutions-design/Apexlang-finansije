page 10041 (
    name: Pomoć
    alias: POMOĆ
    title: Pomoć
    pageGroup: @erp-globalne-stranice
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region search-dialog (
        name: Search Dialog
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                for l_page in ( select page_title,
                                       help_text
                                  from apex_application_pages
                                 where application_id = :APP_ID
                                   and page_id = :P10041_PAGE_ID )
                loop
                    if l_page.help_text is null then
                        return 'No help is available for this page.';
                    else
                        return case when substr(l_page.help_text, 1, 3) != '<p>' then '<p>' end ||
                               apex_application.do_substitutions(l_page.help_text) ||
                               case when substr(trim(l_page.help_text), -4) != '</p>' then '</p>' end;
                    end if;
                end loop;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P10041_PAGE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @search-dialog
            slot: regionBody
        }
    )

)

