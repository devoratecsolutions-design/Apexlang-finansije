                htmlExpression:
                    ```html
                    {if ?RENAME_LINK/}
                    <a href="#RENAME_LINK#">
                        <span class="t-Button t-Button--noLabel u-hot t-Button--iconLeft">
                            <span class="t-Icon t-Icon--left fa fa-edit"></span>
                        </span>
                    </a>
                    {endif/}
                    
                    {if ?DELETE_LINK/}
