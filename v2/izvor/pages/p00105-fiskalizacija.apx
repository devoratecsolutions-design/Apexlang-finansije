page 105 (
    name: Fiskalizacija
    alias: FISKALIZACIJA
    title: Fiskalizacija
    pageGroup: @konfiguracija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @finansije-konfiguracija
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            U okviru sekcije <b><em>Fiskalizacija</em></b> nalaze se dvije podsekcije: 
            <ul>
                <li>Kase</li> 
                <li>Middleware.</li>
            </ul>
            Podsekcija <b><em>"Kase"</em></b> namijenjena je za unos i pregled fiskalnih kasa koje preduzeće koristi. </br>
            Naziv kase unosi sa vaše strane, preostale parametre (Bearer, PIN i Host) obezbjeđuje 
            ovlašćeni serviser fiskalnih kasa. </br>
            Nakon unosa svih potrebnih podataka, klikom na dugme <b><em>"Kreiraj"</em></b> fiskalna kasa 
            će biti uspješno registrovana u sistemu. </br>
            </br>
             
            Podsekcija <b><em>"Middleware"</em></b> omogućava preuzimanje instalacionog fajla 
            koji je vezan za vašu fiskalnu kasu. </br>
            Klikom na odabranu kasu započinje preuzimanje fajla, 
            koji se zatim instalira na vaš računar kako bi kasa mogla 
            pravilno funkcionisati u sistemu fiskalizacije.
            ```
    }

    region fiskalizacija (
        name: Fiskalizacija
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region kase (
        name: Kase
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    null as list_title,
                    null as list_text,
                    null as list_badge,
                    
                    naziv,
                    host,
                    updated,
                    updated_by,
                
                    apex_page.get_url(
                        p_page   => 108,
                        p_items  => 'P108_ID',
                        p_values => id
                    ) as link,
                    case 
                        when valid = 'Y' then
                            'u-color-5'
                        else
                            'u-color-9'
                    end as icon_color_class,
                    'fa fa-cash-register' as icon_class
                FROM
                    sec_kase
                WHERE
                    ooj_id = :APP_OOJ_ID
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: [
                fin-list
                fin-list--media
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                t-MediaList--stack
                t-MediaList--iconsRounded
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column HOST (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Host
            }
            layout {
                sequence: 120
            }
        )

        column ICON_CLASS (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Icon Class
            }
            layout {
                sequence: 110
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Icon Color Class
            }
            layout {
                sequence: 100
            }
        )

        column LINK (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Link
            }
            layout {
                sequence: 90
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: List Badge
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="t-Button t-Button--icon #ICON_COLOR_CLASS#">
                        #UPDATED# / #UPDATED_BY#
                    </span>
                    ```
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: List Text
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: #HOST#
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: List Title
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: #NAZIV#
            }
        )

        column NAZIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Naziv
            }
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )

        column UPDATED (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Updated
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: SINCE
            }
        )

        column UPDATED_BY (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Updated By
            }
            layout {
                sequence: 70
            }
            sorting {
                defaultSequence: 1
            }
        )

    )

    region middleware-development (
        name: Middleware - Development
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    null as list_title,
                    null as list_text,
                    null as list_badge,
                    null as link,
                    null as icon_color_class,
                
                    c001 as name,
                    sif.utils_pkg.format_size(c002) as l_size,
                    to_date(c003, 'MM/DD/YYYY') as time_created,
                    c004 as storage_tier,
                    c005 as archival_state,
                    'erp-middleware-dev' AS bucket_name,
                
                    CASE
                        WHEN sif.utils_pkg.is_authorized_wrapper('MAIN ADMIN') = 1 THEN
                            apex_page.get_url(
                                p_page        => 107,
                                p_items       => 'P107_ID,P107_BUCKET_NAME,P107_OLD_NAME',
                                p_values      => '' || seq_id || ',erp-middleware-dev,' || c001 || '',
                                p_clear_cache => 107
                            ) 
                        ELSE
                            null
                    END AS rename_link,
                    
                    CASE
                        WHEN sif.utils_pkg.is_authorized_wrapper('MAIN ADMIN') = 1 THEN
                            apex_page.get_url(
                                p_page    => 105,
                                p_items   => 'P105_BUCKET_NAME,P105_OBJECT_NAME',
                                p_values  => 'erp-middleware-dev,' || c001 || '',
                                p_request => 'APPLICATION_PROCESS=DELETE_SDK'
                            ) 
                        ELSE
                            null
                    END AS delete_link,
                    apex_page.get_url(
                        p_page    => 105,
                        p_items   => 'P105_BUCKET_NAME,P105_OBJECT_NAME',
                        p_values  => 'erp-middleware-dev,' || c001 || '',
                        p_request => 'APPLICATION_PROCESS=DOWNLOAD_SDK'
                    ) as download_link,
                    'fa fa-gears' as icon_class
                    
                FROM
                    apex_collections
                WHERE
                    collection_name = 'DEVELOPMENT'
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: [
                fin-list
                fin-list--media
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            authorizationScheme: @main-admin
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                t-MediaList--stack
                t-MediaList--iconsRounded
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

