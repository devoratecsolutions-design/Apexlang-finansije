    region rds (
        name: RDS
        type: regionDisplaySelector
        layout {
            sequence: 30
            slot: breadcrumbBar
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            includeShowAll: false
        }
    )

    pageItem P105_BUCKET_NAME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            slot: body
        }
    )

    pageItem P105_OBJECT_NAME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            slot: body
        }
    )

    button create-kasa (
        buttonName: CREATE_KASA
        label: Novi unos
        layout {
            sequence: 10
            region: @kase
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 108
                clearCache: 108
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button upload (
        buttonName: UPLOAD
        label: Novi unos
        layout {
            sequence: 30
            region: @middleware-development
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 107
                clearCache: 107
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @main-admin
        }
    )

    dynamicAction delete (
        name: Delete
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .delete_sdk
        }

        action native-alert (
            action: alert
            settings {
                message: Da li ste sigurni da želite izbrisati izabrani objekat?
                style: danger
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    sif.oci_pkg.delete_object (
                        p_bucket_name => :P105_BUCKET_NAME,
                        p_object_name => :P105_OBJECT_NAME
                    );
                    ```
                itemsToSubmit: [
                    P105_OBJECT_NAME
                    P105_BUCKET_NAME
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $s('P105_OBJECT_NAME', $(this.triggeringElement).data('object'));
                    $s('P105_BUCKET_NAME', $(this.triggeringElement).data('bucket'));
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                showProcessing: false
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 2
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @kase
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @kase
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-2 (
        name: Dialog Closed - Refresh 3
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @middleware-development
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @middleware-development
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @middleware-relases
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-3 (
        name: Dialog Closed - Refresh 4
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @middleware-relases
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @middleware-relases
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
