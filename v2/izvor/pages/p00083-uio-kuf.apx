    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                uio_pkg.delete_uio_kuf (
                    p_id => :P83_DELETE_ID
                );
                
                :P83_DELETE_ID := null;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 29599664391573842
        }
        serverSideCondition {
            type: request=Value
            value: delete
        }
    )

    process delete-pp (
        name: Delete PP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                uio_pkg.delete_uio_kuf (
                    p_ooj_id         => :APP_OOJ_ID,
                    p_poreski_period => :P83_PORESKI_PERIOD
                );
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 29599291357573838
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process update-uio-kuf (
        name: Update UIO KUF
        type: executeCode
        editableRegion: @uio-kuf-grid
        source {
            plsqlCode:
                ```plsql
                uio_pkg.update_uio_kuf (
                    p_id                     => :ID, 
                    p_ooj_id                 => :APP_OOJ_ID,
                    p_vrsta_sloga            => :VRSTA_SLOGA, 
                    p_redni_br               => :REDNI_BR, 
                    p_tip_dokumenta          => :TIP_DOKUMENTA, 
                    p_broj_fakture           => :BROJ_FAKTURE, 
                    p_datum_fakture          => :DATUM_FAKTURE, 
                    p_datum_prijema_fakture  => :DATUM_PRIJEMA_FAKTURE, 
                    p_naziv_dobavljaca       => :NAZIV_DOBAVLJACA, 
                    p_sjediste_dobavljaca    => :SJEDISTE_DOBAVLJACA, 
                    p_pdv_broj_dobavljaca    => :PDV_BROJ_DOBAVLJACA, 
                    p_jib_broj_dobavljaca    => :JIB_BROJ_DOBAVLJACA, 
                    p_iznos_fakture_bezpdv   => :IZNOS_FAKTURE_BEZPDV, 
                    p_iznos_fakture_sapdv    => :IZNOS_FAKTURE_SAPDV, 
                    p_iznos_pausal           => :IZNOS_PAUSAL, 
                    p_iznos_ulaznog_pdv      => :IZNOS_ULAZNOG_PDV, 
                    p_iznos_ulazpdv_odbiti   => :IZNOS_ULAZPDV_ODBITI, 
                    p_iznos_ulazpdv_neodbiti => :IZNOS_ULAZPDV_NEODBITI, 
                    p_iznos_pdv_32polje      => :IZNOS_PDV_32POLJE, 
                    p_iznos_pdv_33polje      => :IZNOS_PDV_33POLJE, 
                    p_iznos_pdv_34polje      => :IZNOS_PDV_34POLJE, 
                    p_poreski_period         => :PORESKI_PERIOD
                );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 29498813024291741
        }
        serverSideCondition {
            whenButtonPressed: @save
            executionScope: allSubmittedRows
        }
    )

    branch (
        name: Go To Page 85 - Download Only
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 85
                items: {
                    P85_DOWNLOAD_TOKEN: &P83_DOWNLOAD_TOKEN.
                    P85_PORESKI_PERIOD: &P83_PORESKI_PERIOD.
                    P85_TYPE: 1
                }
                clearCache: 85
                request: DOWNLOAD_UIO
            }
        }
        serverSideCondition {
            type: request=Value
            value: DOWNLOAD_UIO
        }
    )

)

