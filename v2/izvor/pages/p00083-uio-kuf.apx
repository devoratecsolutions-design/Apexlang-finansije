page 83 (
    name: UIO - KUF
    alias: UIO-KUF
    title: UIO - KUF
    pageGroup: @uio-dokumentacija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#download_with_token#MIN#.js
    }
    css {
        inline:
            ```css
            #kuf_grid_ig_report_settings {
                display: none;
            }
            ```
    }
    security {
        authorizationScheme: @uio-kuf
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Na stranici <b><em>"UIO KUF"</em></b> kao i na stranici UIO KIF potrebno je unijeti poreski 
            period i odabrati mjesec za koji želite da dobijete podatke o unosima. </br>
            Ako ne postoje kreirani podaci, novi unos se pokreće klikom na dugme <b><em>"Novi unos".</em></b> </br>
            </br>
            Odabirom određenog perioda u izvještaju se prikazuju detaljne informacije, 
            a putem linka <b><em>"Obriši"</em></b> moguće je ukloniti ulaznu fakturu za UIO. </br>
            Dvoklikom na neko od polja u izvještaju 
            otvara se opcija za ažuriranje, koje se potvrđuje klikom na dugme <b><em>"Ažuriraj – UIO KUF."</em></b></br>
            </br>
            Funkcija <b><em>"Generiši CSV"</em></b> omogućava kreiranje datoteke sa podacima iz KUF-a, pri čemu se nakon 
            potvrde otvara stranica sa opcijom preuzimanja. </br>
            </br>Dostupna je i opcija <b><em>"Obriši poreski period"</em></b> koja uklanja sve podatke za izabrani period, 
            što je korisno u slučaju grešaka ili potrebe za ponovnim unosom. 
            Na dugme <b><em>"Generiši KUF"</em></b> otvara se modalni dijalog u kojem se bira željeni period, a odabirom 
            mjeseca dobija se izvještaj faktura koje se trebaju generisati. 
            Klikom na dugme <b><em>"Generiši"</em></b> postupak se završava i fakture se uspješno generišu.
            ```
    }

    region download-overlay (
        name: Download Overlay
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="text-align:center;">
                    <div style="font-size:14px; color:#666; margin-bottom:8px;">Molimo sačekajte...</div>
                    <div style="font-weight:600; font-size:18px; margin-bottom:16px;">Generisanje vašeg fajla</div>
                    <div class="dl-spinner" style="width:36px; height:36px; margin:0 auto 14px; border:3px solid rgba(0,0,0,.1); border-top-color:#2271B1; border-radius:50%; animation:dlspin 1s linear infinite;"></div>
                    <div style="font-size:12px; color:#888;">Ne osvježavajte stranicu dok se ne završi.</div>
                </div>
                
                <style>
                    @keyframes dlspin { 
                    to { transform: rotate(360deg); } 
                    }
                </style>
                
                ```
        }
        layout {
            sequence: 50
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @inline-popup
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-size480x320
            ]
        }
        advanced {
            htmlDomId: download_popup
        }
    )

    region uio-kuf (
        name: UIO - KUF
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region uio-kuf-grid (
        name: UIO KUF - Grid
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    vrsta_sloga,
                    redni_br,
                    broj_fakture,
                    poreski_period,
                    tip_dokumenta,
                    datum_fakture,
                    datum_prijema_fakture,
                    naziv_dobavljaca,
                    sjediste_dobavljaca,
                    pdv_broj_dobavljaca,
                    jib_broj_dobavljaca,
                    iznos_fakture_bezpdv,
                    iznos_fakture_sapdv,
                    iznos_pausal,
                    iznos_ulaznog_pdv,
                    iznos_ulazpdv_odbiti,
                    iznos_ulazpdv_neodbiti,
                    iznos_pdv_32polje,
                    iznos_pdv_33polje,
                    iznos_pdv_34polje
                FROM
                    vw_uio_kuf
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND poreski_period = to_char(:P83_PORESKI_PERIOD)
                ```
            pageItemsToSubmit: P83_PORESKI_PERIOD
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
            cssClasses: fin-grid
        }
        advanced {
            htmlDomId: kuf_grid
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P83_PORESKI_PERIOD
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        toolbar {
            controls: actionsMenu
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
        }
        download {
            formats: [
                pdf
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    options.defaultGridViewOptions = {
                        reorderColumns:false,
                        hideEmptyFooter:true,
                        noDataIcon:"fa fa-404",
                        skipReadonlyCells:true,
                        rowsPerPage:25
                    }
                    return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 29104315168969150
        }

