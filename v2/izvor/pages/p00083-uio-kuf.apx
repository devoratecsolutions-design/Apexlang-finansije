    button delete (
        buttonName: DELETE
        label: Obriši poreski period
        layout {
            sequence: 20
            region: @wrapper
            slot: buttonEnd
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Da li ste sigurni da želite obrisati izabrani poreski period?
            style: danger
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_count NUMBER;
                BEGIN
                    IF uio_pkg.is_pp_editable(:APP_OOJ_ID, :P83_PORESKI_PERIOD) THEN
                        RETURN true;
                    END IF;
                
                    SELECT
                        count(*)
                    INTO
                        l_count
                    FROM
                        uio_kuf
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND poreski_period = to_char(:P83_PORESKI_PERIOD);
                    
                    IF l_count > 0 THEN
                        RETURN true;
                    END IF;
                
                    RETURN false; 
                
                END;
                ```
        }
    )

    button generate-csv (
        buttonName: GENERATE_CSV
        label: Generiši CSV
        layout {
            sequence: 10
            region: @wrapper
            slot: buttonEnd
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-file-csv-o
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT
                    1
                FROM
                    uio_kuf
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND poreski_period = to_char(:P83_PORESKI_PERIOD)
                ```
        }
    )

    button generate-kuf-uio (
        buttonName: GENERATE_KUF_UIO
        label: Generiši KUF
        layout {
            sequence: 10
            region: @uio-kuf
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 90
                items: {
                    P90_TIP: KUF
                }
                clearCache: 90
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj - UIO KUF
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: return uio_pkg.is_pp_editable(:APP_OOJ_ID, :P83_PORESKI_PERIOD);
        }
    )

    dynamicAction brisi-kif-stavku (
        name: Brisi kif stavku
        execution {
            sequence: 10
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .delete-kuf
        }

        action native-confirm (
            action: confirm
            settings {
                title: Da li ste sigurni
                message: Da li ste sigurni?
                style: warning
                icon: fa-remove
                confirmLabel: Da, obirši
                cancelLabel: Ne, odustani
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    uio_pkg.delete_uio_kuf (
                        p_id => :P83_DELETE_ID
                    );
                    
                    :P83_DELETE_ID := null;
                    ```
                itemsToSubmit: P83_DELETE_ID
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @uio-kuf-grid
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).parent().data('id')
            }
            affectedElements {
                selectionType: items
                items: P83_DELETE_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @generate-kuf-uio
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @uio-kuf-grid
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P90_PP
            }
            affectedElements {
                selectionType: items
                items: P83_PORESKI_PERIOD
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction start-download (
        name: Start Download
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @generate-csv
        }

        action native-confirm (
            action: confirm
            settings {
                title: Generisanje CSV fajlova
                message: Da li ste sigurni da želite preuzeti CSV fajlove?
                style: information
                icon: fa-arrow-circle-o-down fa-lg
                confirmLabel: Preuzmi
                cancelLabel: Odustani
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: startDownload('P83_DOWNLOAD_TOKEN');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DOWNLOAD_UIO
                showProcessing: false
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction submit-page (
        name: Submit Page
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P83_PORESKI_PERIOD
        }

        action native-submit-page (
            action: submitPage
            settings {
                showProcessing: false
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

