    process save-stavke-izvoda-ig (
        name: Save stavke izvoda IG
        type: executeCode
        editableRegion: @stavke-izvoda
        source {
            plsqlCode:
                ```plsql
                declare 
                
                v_vpl varchar2(100);
                v_vpr varchar2(100);
                v_vo varchar2(100);
                v_bo varchar2(100);
                begin 
                
                IF :APEX$ROW_STATUS = 'D' THEN -- DELETE
                        accounting.finansije_pkg.delete_izvod_stavka (
                                            p_id => :ID
                        );
                
                ELSIF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN -- CREATE
                
                
                
                            accounting.finansije_pkg.insert_izvod_stavka (
                                            p_izvod_id              => :P1012_ID,
                                            p_rbr                   => :RBR,
                                            p_datum_transakcije     => :DATUM_TRANSAKCIJE,
                                            p_smjer                 => :SMJER,
                                            p_uplatio               => :UPLATIO,
                                            p_svrha_doznake         => :SVRHA_DOZNAKE,
                                            p_poziv_na_broj         => :POZIV_NA_BROJ,
                                            p_ref_ziro_racun        => :REF_ZIRO_RACUN,
                                            p_vrsta_placanja        => :VRSTA_PLACANJA,
                                            p_vrsta_prihoda         => :VRSTA_PRIHODA,
                                            p_opstina               => :OPSTINA,
                                            p_budzetska_organizacija =>:BUDZETSKA_ORGANIZACIJA,
                                            p_iznos                 => sif.acc_pkg.get_kurs_na_dan(:VALUTA_ID,:APP_OOJ_ID,:P1012_DATUM)*TO_NUMBER(:IZNOS_VALUTNO,'999G999G999G999G990D00'),
                                            p_iznos_valutno         => TO_NUMBER(:IZNOS_VALUTNO,'999G999G999G999G990D00'),
                                            p_valuta_id             => :VALUTA_ID,
                                            p_klijent_id            => :KLIJENT_ID,
                                            p_konto_id              => :KONTO_ID, 
                                            p_id                    => :ID
                            );
                
                ELSIF :APEX$ROW_STATUS = 'U' THEN -- UPDATE
                
                
                
                
                          accounting.finansije_pkg.update_izvod_stavka (
                                            p_id                    => :ID,
                                            p_izvod_id              => :P1012_ID,
                                            p_rbr                   => :RBR,
                                            p_datum_transakcije     => :DATUM_TRANSAKCIJE,
                                            p_smjer                 => :SMJER,
                                            p_uplatio               => :UPLATIO,
                                            p_svrha_doznake         => :SVRHA_DOZNAKE,
                                            p_poziv_na_broj         => :POZIV_NA_BROJ,
                                            p_ref_ziro_racun        => :REF_ZIRO_RACUN,
                                            p_vrsta_placanja        => :VRSTA_PLACANJA,
                                            p_vrsta_prihoda         => :VRSTA_PRIHODA,
                                            p_opstina               => :OPSTINA,
                                            p_budzetska_organizacija =>:BUDZETSKA_ORGANIZACIJA,
                                            p_iznos                 =>  sif.acc_pkg.get_kurs_na_dan(:VALUTA_ID,:APP_OOJ_ID,:P1012_DATUM)*TO_NUMBER(:IZNOS_VALUTNO,'999G999G999G999G990D00'),
                                            p_iznos_valutno         =>  TO_NUMBER(:IZNOS_VALUTNO,'999G999G999G999G990D00'),
                                            p_valuta_id             => :VALUTA_ID,
                                            p_klijent_id            => :KLIJENT_ID,
                                            p_konto_id              => :KONTO_ID
                            );
                
                END IF;
                
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 270219840855414016
        }
        serverSideCondition {
            whenButtonPressed: @snimi-stavke
        }
    )

    process unlock-izvod (
        name: Unlock Izvod
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update accounting.izvodi i
                set i.zakljucan='N'
                where i.id=:P1012_ID;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 270562177465033328
        }
        serverSideCondition {
            whenButtonPressed: @otkljucaj
        }
    )

    branch (
        name: Go to Sadrzaj GK
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1801
                items: {
                    P1801_IZVOD_ID: &P1012_ID.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @proknjizi
        }
    )

