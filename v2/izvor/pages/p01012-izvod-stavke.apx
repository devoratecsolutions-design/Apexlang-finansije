    dynamicAction set-column-iznos (
        name: SET COLUMN IZNOS
        execution {
            sequence: 150
        }
        when {
            selectionType: columns
            interactiveGrid: @stavke-izvoda
            columns: [
                IZNOS_VALUTNO
                VALUTA_ID
            ]
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare 
                    
                    v_kurs number;
                    v_iznos number;
                    
                    begin 
                    
                        if :VALUTA_ID is not null and :IZNOS_VALUTNO is not null then 
                    
                            v_kurs:=sif.acc_pkg.get_kurs_na_dan(:VALUTA_ID,:APP_OOJ_ID,:P1012_DATUM);
                    
                            if v_kurs is null then 
                    
                                return null;
                            else
                    
                                v_iznos:=to_number(:IZNOS_VALUTNO, '999G999G999G999G990D00')*v_kurs;
                                return v_iznos;
                    
                            end if;
                            
                        else
                    
                            return null;
                    
                        end if;
                    
                    exception when others then 
                    
                          apex_error.add_error(
                                p_message          => 'Pogrešni podaci u kolonama valuta i iznos valutno!',
                                p_display_location => apex_error.c_inline_in_notification
                            );
                    
                    end;
                    ```
                itemsToSubmit: [
                    IZNOS_VALUTNO
                    VALUTA_ID
                ]
            }
            affectedElements {
                selectionType: columns
                columns: IZNOS
            }
            execution {
                sequence: 10
            }
        )

    )

