    region izvod (
        name: IZVOD
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    zr.sifra as šifra_računa,
                    zr.broj as broj_računa,
                    v.sifra as valuta, 
                    i.broj, 
                    i.datum,
                    i.prethodni_saldo prethodno_stanje, 
                    i.novi_saldo as novo_stanje, 
                    i.opis
                FROM
                    accounting.izvodi i
                    join sif.sif_ziro_racuni zr on i.ziro_racun_id=zr.id
                    join sif.acc_valute v on v.id=zr.valuta_id
                WHERE
                    I.id = :P1012_ID
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                js-master-region
                fin-list
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1012_ID
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No Record Selected
        }
