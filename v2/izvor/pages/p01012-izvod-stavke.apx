                              p_c004 => r.partner,
                              p_c005 => r.opstina,
                              p_c006 => r.radnik,
                              p_c007 => r.smjer_placanja,
                              p_c008 => r.mjesto_tr,
                              p_c009 => r.strana_knjizenja,
                              p_c010 => r.pracenje_os,
                              p_c011 => v_id_os, --id otvorene stavke
                              p_c012 => v_broj_vd, -- vezni dokument otvorene stavke 
                              p_c013 => v_opis_vd, --opis veznog dokumenta
                              p_c014 => 'Y', -- red zakljucan za brisanje
                              p_c015 => r.konto, -- red zakljucan za brisanje,
                              p_c016 => r.valuta_id,
                              p_n001 => abs(r.iznos),
                              p_n002 => r.iznos,
                              p_n003 => r.rbr,
                              p_n004 => r.izvod_stavka_id,
                              p_n005 => r.izvod_id,
                              p_d001 => r.datum_dokumenta
                            );        
                
                
                 
                  END LOOP;*/
                END;
