    validation zakljucaj-izvod (
        name: ZAKLJUCAJ IZVOD
        execution {
            sequence: 50
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                
                v_promet_valutno_st number;
                v_promet_st number;
                v_promet number;
                
                begin 
                
                     select sum(case when s.smjer='P' then s.iznos_valutno else -s.iznos_valutno end) as v_promet_valutno_S, 
                            sum(case when s.smjer='P' then s.iznos else -s.iznos end) as v_promet_s
                     into v_promet_valutno_st, v_promet_st
                     from accounting.izvod_stavke s
                     where s.izvod_id=:P1012_ID;
                
                     v_promet:=:P1012_PROMET_VALUTNO*sif.acc_pkg.get_kurs_na_dan(:P1012_VALUTA,:APP_OOJ_ID,:P1012_DATUM);
                
                     if :P1012_PROMET_VALUTNO<>v_promet_valutno_st then 
                
                        return 'Zbir priliva i odliva u valuti po transakcijama se razlikuje od ukupnog prometa na izvodu.';
                
                     elsif  v_promet<>v_promet_st then 
                
                        return 'Zbir priliva i odliva u domaćoj valuti po transakcijama se razlikuje od ukupnog prometa na izvodu.';
                
                     end if; 
                
                    return null;
                
                end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @zakljucaj
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                 declare
                 v_ooj_id number;
                
                
                 begin 
                
                
                     select i.datum, i.storno, i.zakljucan, i.proknjizen,zr.valuta_id, i.novi_saldo-i.prethodni_saldo, zr.kontna_klasa_id, zr.vrsta_naloga_id
                     into   :P1012_DATUM, :P1012_STORNO, :P1012_ZAKLJUCAN, :P1012_PROKNIZEN, :P1012_VALUTA, :P1012_PROMET_VALUTNO,:P1012_KONTNA_KLASA_ID, :P1012_VRSTA_NALOGA_ID
                     from accounting.izvodi i 
                     join sif.sif_ziro_racuni zr on i.ziro_racun_id=zr.id
                     where i.id=:P1012_ID;
                
                     select to_char(nvl(sum(case when st.smjer='P' then st.iznos_valutno else 0 end ),0),'999G999G999G999G990D00') as priliv, to_char(nvl(sum(case when st.smjer='O' then st.iznos_valutno else 0 end ),0),'999G999G999G999G990D00') as odliv
                     into :P1012_PRILIV, :P1012_ODLIV
                     from accounting.izvod_stavke st 
                     where st.izvod_id=:P1012_ID;
                 
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 270559824582033305
        }
    )

    process lock-izvod (
        name: Lock Izvod
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update accounting.izvodi i
                set i.zakljucan='Y'
                where i.id=:P1012_ID;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 270561681829033323
        }
        serverSideCondition {
            whenButtonPressed: @zakljucaj
        }
    )

    process sadrzaj-gk (
        name: Sadrzaj GK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  l_seq  NUMBER;
                  v_postoji_klijent_konto_os number;
                  v_klijent_konto_os number;
                  v_broj_os  NUMBER;
                  v_id_os number;
                  v_broj_vd varchar2(500);
                  v_opis_vd varchar2(1000);
                  v_ids SYS.ODCINUMBERLIST := SYS.ODCINUMBERLIST();
                BEGIN
                
                v_ids.EXTEND;
                v_ids(v_ids.COUNT) := :P1012_ID;
                
                accounting.sadrzaj_gk_pkg.izvodi_sgk (
                    p_izvod_ids => v_ids
                );
                /*
                  -- kreiranje kolekcije--
                  IF APEX_COLLECTION.COLLECTION_EXISTS('SADRZAJ_GK_IZVODI') THEN
                    APEX_COLLECTION.DELETE_COLLECTION('SADRZAJ_GK_IZVODI');
                  END IF;
                
                  APEX_COLLECTION.CREATE_COLLECTION('SADRZAJ_GK_IZVODI');
                
                  --templejt za stavke glavne knjige----
                  FOR r IN (select * from 
                                            (select 'A' as tip,izs.id as izvod_stavka_id, iz.id as izvod_id,iz.datum as datum_dokumenta, iz.opis opis_izvoda,  
                                                   izs.svrha_doznake as opis_transkacije,
                                                   izs.klijent_id as partner, izs.opstina as opstina, null as radnik,
                                                   izs.smjer as smjer_placanja,
                                                   izs.konto_id as konto,nvl(ko.otvorene_stavke,'N') as pracenje_os,  null as mjesto_tr, 
                                                   case when izs.smjer='P' then 'P' else 'D' end as strana_knjizenja,
                                                   case when izs.smjer='P' then -izs.iznos else izs.iznos  end as iznos, izs.rbr, 
                                                   izs.valuta_id
                                            from accounting.izvodi iz 
                                            join accounting.izvod_stavke izs on iz.id=izs.izvod_id
                                            left join sif.acc_kontni_okvir_klase ko on ko.id=izs.konto_id
                                            where iz.id=:P1012_ID
                                            union 
                                            select 'S' as tip,0 as izvod_stavka_id, iz.id as izvod_id,iz.datum as datum_dokumenta, iz.opis as opis_izvoda, 
                                                   iz.opis as opis_transkacije,
                                                   null as partner, null as opstina, null as radnik,
                                                   izs.smjer as smjer_placanja,
                                                   zr.kontna_klasa_id as konto,null pracenje_os, null as mjesto_tr,
                                                   case when izs.smjer='P' then 'D' else 'P' end as strana_knjizenja,
                                                   sum(case when izs.smjer='P' then izs.iznos else -izs.iznos   end) as iznos, 999999 as rbr, 
                                                   izs.valuta_id
                                            from accounting.izvodi iz 
                                            join accounting.izvod_stavke izs on iz.id=izs.izvod_id
                                            join sif.sif_ziro_racuni zr  on zr.id=iz.ziro_racun_id
                                            where iz.id=:P1012_ID
                                            group by iz.id, iz.datum, iz.opis,izs.smjer,zr.kontna_klasa_id,izs.valuta_id)
                            order by rbr
                            )
                    loop
                   
                    --provera da li postoji otvorena stavka za stavku izvoda, moguće samo ako je na prethodnom koraku unešen partner ili konto
                
                    if r.partner is not null or r.konto is not null then 
                
                        if r.partner is null then --konto izabrano ali nije partner
                
                            if r.pracenje_os='N' then  --konto se ne prati kao otvorena stavka tako da nema potrebe tražiti otvorenu stavku
                
                                  v_id_os:=null;
                                  v_broj_vd:=null;
                                  v_opis_vd:=null;
                
                            else  --- provjeravamo da li postoji tačno jedna otvorena stavka za izabrano konto i iznos
                
                                    select COUNT(*)
                                    into  v_broj_os
                                    from accounting.glavna_knjiga_stavke gks
                                    left join(
                                            select to_number(c011) AS id_os
                                            from  apex_collections
                                            where collection_name = 'SADRZAJ_GK_IZVODI'
                                            and c011 is not null ) kol ON kol.id_os = gks.id
                                    where gks.otvorena!='Z'
                                    and gks.kontna_klasa_id=r.konto
                                    and gks.otvoreni_iznos=-r.iznos
                                    and kol.id_os is null;
                                    
                                    if v_broj_os=1 then -- ako je tačno jedna onda možemo jednoznačno upariti otvorene stavke
                
                                    select gks.id, gsd.dokument, gsd.opis
                                    into v_id_os,v_broj_vd,v_opis_vd
                                    from accounting.glavna_knjiga_stavke gks
                                    left join accounting.gk_stavke_dokument gsd on gsd.glavna_knjiga_stavka_id=gks.id
                                    left join(
                                            select to_number(c011) AS id_os
                                            from  apex_collections
                                            where collection_name = 'SADRZAJ_GK_IZVODI'
                                            and c011 is not null ) kol ON kol.id_os = gks.id
                                    where gks.otvorena!='Z'
                                    and gks.kontna_klasa_id=r.konto
                                    and gks.otvoreni_iznos=-r.iznos
                                    and kol.id_os is null;
                
                                    else -- u suprotnom ostavljamo neupareno
                
                                        v_id_os:=null;
                                        v_broj_vd:=null;
                                        v_opis_vd:=null;
                
                                    end if;
                
                
                
                            end if;
                
                
                        elsif r.konto is null then -- partner izabran ali nije konto 
                
                             --- provjera da li za partnera postoji samo jedno aktivno vezano konto koje se prati kao otvorena stavka---
                            select count(k.id)
                            into  v_postoji_klijent_konto_os
                            from accounting.sec_klijenti k
                            join accounting.sec_klijent_konta kk on kk.sec_klijent_id=k.id
                            join sif.acc_kontni_okvir_klase ko on ko.id=kk.kontna_klasa_id and ko.otvorene_stavke='Y'
                            where kk.valid='Y'
                            and k.id=r.partner;
                
                            if v_postoji_klijent_konto_os=1 then ---ako postoji pokušavamo na tom kontu naći samo jednu otvorenu stavku
                
                                    select ko.id
                                    into  v_klijent_konto_os
                                    from accounting.sec_klijenti k
                                    join accounting.sec_klijent_konta kk on kk.sec_klijent_id=k.id
                                    join sif.acc_kontni_okvir_klase ko on ko.id=kk.kontna_klasa_id and ko.otvorene_stavke='Y'
                                    where kk.valid='Y'
                                    and k.id=r.partner;
                
                
                                    select COUNT(*)
                                    into  v_broj_os
                                    from accounting.glavna_knjiga_stavke gks
                                    left join(
                                            select to_number(c011) AS id_os
                                            from  apex_collections
                                            where collection_name = 'SADRZAJ_GK_IZVODI'
                                            and c011 is not null ) kol ON kol.id_os = gks.id
                                    where gks.otvorena!='Z'
                                    and gks.kontna_klasa_id=v_klijent_konto_os
                                    and gks.klijent_id=r.partner
                                    and gks.otvoreni_iznos=-r.iznos
                                    and kol.id_os is null;
                                    
                                    if v_broj_os=1 then -- ako je tačno jedna onda možemo jednoznačno upariti otvorene stavke
                
                                    select gks.id, gsd.dokument, gsd.opis
                                    into v_id_os,v_broj_vd,v_opis_vd
                                    from accounting.glavna_knjiga_stavke gks
                                    left join accounting.gk_stavke_dokument gsd on gsd.glavna_knjiga_stavka_id=gks.id
                                    left join(
                                            select to_number(c011) AS id_os
                                            from  apex_collections
                                            where collection_name = 'SADRZAJ_GK_IZVODI'
                                            and c011 is not null ) kol ON kol.id_os = gks.id
                                    where gks.otvorena!='Z'
                                    and gks.kontna_klasa_id=v_klijent_konto_os
                                    and gks.klijent_id=r.partner
                                    and gks.otvoreni_iznos=-r.iznos
                                    and kol.id_os is null;
                
                                    else -- u suprotnom ostavljamo neupareno
                
                                        v_id_os:=null;
                                        v_broj_vd:=null;
                                        v_opis_vd:=null;
                
                                    end if;
                
                                    
                
                
                
                
                            end if;
                
                
                        else  --izabrani i partner i konto, provjeravamo otvorene stavke za ta dva parametra
                
                            select COUNT(*)
                            into  v_broj_os
                            from accounting.glavna_knjiga_stavke gks
                            left join(
                                            select to_number(c011) AS id_os
                                            from  apex_collections
                                            where collection_name = 'SADRZAJ_GK_IZVODI'
                                            and c011 is not null ) kol ON kol.id_os = gks.id
                            where gks.otvorena!='Z'
                            and gks.kontna_klasa_id=r.konto
                            and gks.klijent_id=r.partner
                            and gks.otvoreni_iznos=-r.iznos
                            and kol.id_os is null;
                
                            
                            if v_broj_os>0 then -- ako postoji barem jedna onda uparujemo najstariju otvorenu stavku
                
                            select gks.id, gsd.dokument, gsd.opis
                            into v_id_os,v_broj_vd,v_opis_vd
                            from accounting.glavna_knjiga_stavke gks
                            left join accounting.gk_stavke_dokument gsd on gsd.glavna_knjiga_stavka_id=gks.id
                             left join(
                                            select to_number(c011) AS id_os
                                            from  apex_collections
                                            where collection_name = 'SADRZAJ_GK_IZVODI'
                                            and c011 is not null ) kol ON kol.id_os = gks.id
                            where gks.otvorena!='Z'
                            and gks.kontna_klasa_id=r.konto
                            and gks.klijent_id=r.partner
                            and gks.otvoreni_iznos=-r.iznos
                            and kol.id_os is null
                            order by gks.datum_dokumenta
                            fetch first 1 row only;
                
                            else -- u suprotnom ostavljamo neupareno
                
                                v_id_os:=null;
                                v_broj_vd:=null;
                                v_opis_vd:=null;
                
                            end if;
                
                
                        end if;
                
                    end if;
                
                
                    APEX_COLLECTION.ADD_MEMBER(
                              p_collection_name => 'SADRZAJ_GK_IZVODI',
                              p_c001 => r.tip,
                              p_c002 => r.opis_izvoda,
