page 107 (
    name: Middleware / Detalji
    alias: MIDDLEWARE-DETALJI
    title: Middleware / Detalji
    pageGroup: @konfiguracija
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P107_BUCKET_NAME (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P107_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P107_MIDDLEWARE (
        type: fileUpload
        label {
            label: Middleware
            alignment: left
        }
        display {
            displayAs: blockDropzone
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 50
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNull
            item: P107_ID
        }
    )

    pageItem P107_NEW_NAME (
        type: textField
        label {
            label: New Name
            alignment: left
        }
        layout {
            sequence: 40
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P107_ID
        }
    )

    pageItem P107_OLD_NAME (
        type: displayOnly
        label {
            label: Old Name
            alignment: left
        }
        layout {
            sequence: 30
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P107_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button rename (
        buttonName: RENAME
        label: Promijeni ime
        layout {
            sequence: 20
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P107_ID
        }
    )

    button upload (
        buttonName: UPLOAD
        label: Upload middleware
        layout {
            sequence: 30
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P107_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 96565605328690703
        }
    )

    process rename (
        name: Rename
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sif.oci_pkg.rename_object (
                    p_bucket_name => :P107_BUCKET_NAME,
                    p_old_name    => :P107_OLD_NAME,
                    p_new_name    => :P107_NEW_NAME
                );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 96565581707690702
        }
        serverSideCondition {
            whenButtonPressed: @rename
        }
    )

    process upload (
        name: Upload
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sif.oci_pkg.create_object (
                    p_bucket_name => 'erp-middleware-releases',
                    p_object_name => :P107_MIDDLEWARE
                );
                
                sif.oci_pkg.create_object (
                    p_bucket_name => 'erp-middleware-dev',
                    p_object_name => :P107_MIDDLEWARE
                );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 96565442941690701
        }
        serverSideCondition {
            whenButtonPressed: @upload
        }
    )

)

