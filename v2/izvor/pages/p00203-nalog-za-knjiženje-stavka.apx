    pageItem P203_PDV_INDIKATOR_ID (
        type: selectOne
        label {
            label: PDV indikator
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF :P203_VRSTA_NALOGA_SIFRA IN ('if', 'ifs', 'av', 'avs') THEN
                    RETURN 'select sifra||''-''||naziv as d, id as r from sif.acc_pdv_indikatori where ui=''I''';
                ELSE
                    RETURN 'select sifra ||''-''||naziv as d, id as r from sif.acc_pdv_indikatori where ui= ''U''';
                END IF;
                ```
        }
        cascadingLov {
            parentItems: P203_VRSTA_NALOGA_SIFRA
        }
        layout {
            sequence: 170
            region: @nalog-za-knjiženje-stavka
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsInColonDelimitedList
            item: P203_VRSTA_NALOGA_SIFRA
            list: [
                uf
                if
                av
                ifs
                avs
            ]
        }
    )

