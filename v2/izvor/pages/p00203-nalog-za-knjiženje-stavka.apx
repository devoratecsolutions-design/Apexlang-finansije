page 203 (
    name: Nalog za knjiženje / Stavka
    alias: NALOG-ZA-KNJIŽENJE-STAVKA
    title: Nalog za knjiženje / Stavka
    pageGroup: @glavna-knjiga
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region nalog-za-knjiženje-stavka (
        name: Nalog za knjiženje / Stavka
        type: staticContent
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P203_DATUM_DOKUMENTA (
        type: hidden
        layout {
            sequence: 30
            region: @nalog-za-knjiženje-stavka
            slot: regionBody
        }
    )

    pageItem P203_DODJELA (
        type: textarea
        label {
            label: Dodjela
            alignment: left
        }
        settings {
            autoHeight: true
            charCounter: true
        }
        layout {
            sequence: 200
            region: @nalog-za-knjiženje-stavka
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P203_GLAVNA_KNJIGA_ID (
        type: hidden
        layout {
            sequence: 20
            region: @nalog-za-knjiženje-stavka
            slot: regionBody
        }
    )

    pageItem P203_GRAD_ID (
        type: selectOne
        label {
            label: Grad
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        messages {
            noDataFoundMessage: Nema pronađenih podataka.
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv || ' ( ' || lpad(sifra, 3, '0') || ' )' as d,
                    id as r
                FROM
                    sif.sif_gradovi g
                WHERE
                    (
                        :P203_KLIJENT_ID IS NOT NULL 
                        AND g.drzava_id = (
                            SELECT k.drzava_id
                            FROM sec_klijenti k
                            WHERE k.id = :P203_KLIJENT_ID
                        )
                    ) OR (
                        :P203_KLIJENT_ID IS NULL 
                        AND drzava_id = 28
                    )
                ```
        }
        cascadingLov {
            parentItems: P203_KLIJENT_ID
        }
        layout {
            sequence: 120
            region: @nalog-za-knjiženje-stavka
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P203_ID (
        type: hidden
        layout {
            sequence: 10
            region: @nalog-za-knjiženje-stavka
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P203_INTERNI_NALOG (
        type: radioGroup
        label {
            label: Interni nalog
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 160
            region: @nalog-za-knjiženje-stavka
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsInColonDelimitedList
            item: P203_VRSTA_NALOGA_SIFRA
            list: [
                uf
                os
            ]
        }
    )

    pageItem P203_IZNOS (
        type: numberField
        label {
            label: Iznos
            alignment: left
        }
        layout {
            sequence: 90
