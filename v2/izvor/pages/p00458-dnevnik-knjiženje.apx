page 458 (
    name: Dnevnik / Knjiženje
    alias: DNEVNIK-KNJIŽENJE
    title: Dnevnik / Knjiženje
    pageGroup: @blagajna
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region dnevnik (
        name: Dnevnik
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    blagajna_id,
                    datum,
                    pocetno_stanje,
                    zakljucno_stanje,
                    (zakljucno_stanje - pocetno_stanje) AS razlika
                FROM
                    blagajna_dnevnik
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND glavna_knjiga_id IS null
                    AND zakljucno_stanje IS NOT null
                    AND to_char(datum, 'YYMM') = :P458_PP
                ORDER BY
                    datum DESC
                ```
            pageItemsToSubmit: P458_PP
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column BLAGAJNA_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Blagajna
            }
            lov {
                type: sharedComponent
                lov: @blagajne
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column DATUM (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column POCETNO_STANJE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Početno stanje
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column RAZLIKA (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Razlika
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column ZAKLJUCNO_STANJE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Zaključno stanje
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P458_KNJIZI_YN (
        type: radioGroup
        label {
            label: Proknjiži komplet
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        help {
            helpText:
                ```html
                Ukoliko je odabrana opcije "NE" u tom slučaju će biti omogućena naknadna korekcija u pregledu "Naloga za knjiženje"
                
                ```
        }
    )

    pageItem P458_NALOG_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P458_PP (
        type: selectOne
        label {
            label: Poreski period
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @poreski-period-yymm
        }
        layout {
            sequence: 20
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button knjizi (
        buttonName: KNJIZI
        label: Knjiži
        layout {
            sequence: 20
            region: @buttons-bar
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P458_PP
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @dnevnik
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process knjizenje (
        name: Knjizenje
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P458_NALOG_ID := glavna_knjiga_pkg.knjizi_blagajnu (
                    p_ooj_id      => :APP_OOJ_ID,
                    p_godina      => :APP_GODINA,
                    p_pp          => to_date(:P458_PP, 'YYMM'),
                    p_proknjizeno => :P458_KNJIZI_YN
                );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 136358826728614707
        }
        serverSideCondition {
            whenButtonPressed: @knjizi
        }
    )

    branch (
        name: Go To Page 201
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 201
                items: {
                    P201_ID: &P458_NALOG_ID.
                }
                clearCache: 201
            }
        }
        serverSideCondition {
            whenButtonPressed: @knjizi
        }
    )

)

