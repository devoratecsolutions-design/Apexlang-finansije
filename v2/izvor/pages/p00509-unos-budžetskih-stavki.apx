                enabled: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
        )

        column PERIOD (
            type: selectList
            heading {
                heading: Period
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH params AS (
                        -- Parameters
                        SELECT :P509_BROJ_MJESECI AS p_months,
                               :P509_GODINA AS p_year
                        FROM dual
                    ),
                    months AS (
                        SELECT LEVEL AS month_num,
                               ADD_MONTHS(TRUNC(TO_DATE(p.p_year, 'YYYY'), 'YYYY'), LEVEL - 1) AS first_day
                        FROM dual
                        CROSS JOIN params p
                        CONNECT BY LEVEL <= 12
                    ),
                    periods AS (
                        SELECT m.month_num,
                               m.first_day,
                               CEIL(m.month_num / p.p_months) AS q_num,
                               p.p_months
                        FROM months m
                        CROSS JOIN params p
                    )
                    SELECT 
                        'P' || q_num || ' = ' ||
                        TRIM(TO_CHAR(MIN(first_day), 'Month', 'NLS_DATE_LANGUAGE=''LATIN SERBIAN''')) ||
                        CASE WHEN p_months > 1 
                             THEN ' - ' || TRIM(TO_CHAR(MAX(first_day), 'Month', 'NLS_DATE_LANGUAGE=''LATIN SERBIAN'''))
                             ELSE ''
                        END AS display,
                        TRUNC(MIN(first_day)) AS return_date
                    FROM periods
                    GROUP BY q_num, p_months
                    ORDER BY q_num;
                    
                    ```
                nullDisplayValue: - Izaberite period -
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: PERIOD
                dataType: date
            }
            default {
                duplicateCopiesExistingValue: false
            }
            columnFilter {
                enabled: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
        )

        column PROJEKAT_ID (
            type: selectList
            heading {
                heading: Projekat
            }
            lov {
                type: sharedComponent
                lov: @hr-projekti
                nullDisplayValue: - Izaberite projekat -
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: PROJEKAT_ID
                dataType: number
            }
            columnFilter {
                enabled: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
        )

        column STAVKA_ID (
            type: popupLov
            heading {
                heading: Stavka
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        lpad(naziv, length(naziv) + (level - 1 ) * 4, '.') AS d,
                        id AS r
                    FROM
                        vw_budzetske_stavke
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND (oj_id = :P509_OJ_ID OR oj_id IS null)
                    CONNECT BY
                        PRIOR id = stavka_id
                    START WITH
                        stavka_id IS null
                    ORDER SIBLINGS BY
                        id
                    ```
                nullDisplayValue: - Izaberite stavku -
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: STAVKA_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
        )

    )

