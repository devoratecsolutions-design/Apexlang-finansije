            event: click
            selectionType: button
            button: @toggle
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: toggleSidebar();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P509_OJ_ID
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: REFRESH
                showProcessing: false
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process get-oj-data (
        name: Get OJ data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                budzet_pkg.get_budzet_oj (
                    p_budzet_id    => :P509_BUDZET_ID,
                    p_oj_id        => :P509_OJ_ID,
                    p_status_sifra => :P509_STATUS_SIFRA
                );
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 145404685097423413
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P509_OJ_ID
        }
    )

    process setup-oj (
        name: Setup OJ
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hrm.evidencija_pkg.get_radnik (
                    p_radnik_id => :APP_RADNIK_ID,
                    p_oj_id     => :P509_OJ_ID
                );
                
                budzet_pkg.get_budzet (
                    p_id           => :P509_BUDZET_ID,
                    p_broj_mjeseci => :P509_BROJ_MJESECI,
                    p_godina       => :P509_GODINA,
                    p_status_sifra => :P509_BUDZET_STATUS_SIFRA
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 144394648155239242
        }
        serverSideCondition {
            type: request=Value
            value: setup
        }
    )

    process stavke-stavke-ig (
        name: Stavke stavke IG
        type: executeCode
        editableRegion: @unos-budžetskih-stavki-ig
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS = 'D' THEN -- DELETE
                    budzet_pkg.delete_budzet_stavka (
                        p_id => :ID
                    );
                
                ELSIF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN -- CREATE
                    budzet_pkg.insert_budzet_stavka (
                        p_budzet_id         => :P509_BUDZET_ID,
                        p_oj_id             => :P509_OJ_ID,
                        p_stavka_id         => :STAVKA_ID,
                        p_projekat_id       => :PROJEKAT_ID,
                        p_period            => :PERIOD,
                        p_iznos             => to_number(:IZNOS, '999G999G999G999G990D00'),
                        p_napomena          => :NAPOMENA
                    );
                
                    RETURN;
                ELSIF :APEX$ROW_STATUS = 'U' THEN -- UPDATE
                    budzet_pkg.update_budzet_stavka (
                        p_id                => :ID,
                        p_budzet_id         => :P509_BUDZET_ID,
                        p_oj_id             => :P509_OJ_ID,
                        p_stavka_id         => :STAVKA_ID,
                        p_projekat_id       => :PROJEKAT_ID,
                        p_period            => :PERIOD,
                        p_iznos             => to_number(:IZNOS, '999G999G999G999G990D00'),
                        p_napomena          => :NAPOMENA
                    );
                
                    RETURN;
                END IF;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 144769267410894001
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: requestIsContainedInValue
            value: SAVE,SAVE_DOWN
        }
    )

)

