    region unos-budžetskih-stavki-ig (
        name: Unos budžetskih stavki IG
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH stavke AS (
                    SELECT
                        id,
                        stavka_id,
                        projekat_id,
                        period,
                        iznos,
                        napomena
                    FROM
                        vw_budzet_stavke
                    WHERE
                        budzet_id = :P509_BUDZET_ID
                        AND oj_id = :P509_OJ_ID
                    ORDER BY
                        stavka_id,
                        period,
                        projekat_id
                )
                SELECT
                    id,
                    stavka_id,
                    projekat_id,
                    period,
                    iznos,
                    napomena
                FROM
                    stavke
                ```
            pageItemsToSubmit: [
                P509_BUDZET_ID
                P509_OJ_ID
            ]
        }
        layout {
            sequence: 20
            parentRegion: @wrapper
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-grid
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        toolbar {
            controls: actionsMenu
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    let $ = apex.jQuery,
                        toolbarData = $.apex.interactiveGrid.copyDefaultToolbar();
                        addrowAction = toolbarData.toolbarFind("selection-add-row"),
                        addrowAction.label = "Nova stavka"; // Pick name you need
                        editrowAction = toolbarData.toolbarFind("edit"),
                        editrowAction.label = "Izmjeni"; // Pick name you need
                        saverowAction = toolbarData.toolbarFind("save"),
                        saverowAction.label = "Sačuvaj izmjene"
                        options.toolbarData = toolbarData;
                    
                    options.defaultGridViewOptions = {
                        reorderColumns: false
                    }
                    return options;
                }
                
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 144449117325588973
        }

        savedReport 1444496 (
