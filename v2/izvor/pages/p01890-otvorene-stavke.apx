    dynamicAction obriši-nacrt (
        name: Obriši nacrt
        execution {
            sequence: 240
        }
        when {
            event: click
            selectionType: button
            button: @obrisi-nacrt
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                        if APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => 'NACRT_UPARIVANJA') then
                    
                            APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => 'NACRT_UPARIVANJA');
                            
                        end if;
                    
                        
                        select null, null, null, null, null
                        into   :P1890_PARTNER_U, :P1890_KONTO_U, :P1890_MJESTO_TROSKA_U, :P1890_OPSTINA_U, :P1890_RADNIK_U
                        from dual;
                        
                    end;
                    ```
                itemsToReturn: [
                    P1890_PARTNER_U
                    P1890_OPSTINA_U
                    P1890_RADNIK_U
                    P1890_MJESTO_TROSKA_U
