page 1890 (
    name: Otvorene stavke
    alias: OTVORENE-STAVKE
    title: Otvorene stavke
    pageGroup: @glavna-knjiga
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#left-side-toggle#MIN#.js
        executeWhenPageLoads:
            ```javascript-browser
            document.querySelectorAll('#reg-US th').forEach(function(th) {
                if (th.textContent.trim().endsWith(' O')) {
                    th.style.color = '#C62828';
                }else{
                    th.style.color = '#C62828';
                }
            });    
            
            ```
    }
    css {
        fileUrls: #WORKSPACE_FILES#left-side-toggle#MIN#.css
        inline:
            ```css
            .schDate{
                --a-datepicker-calendar-day-background-color: #62e284;
                --a-datepicker-calendar-day-text-color: #ffffff;
                --a-datepicker-calendar-day-border-color: #62e284;
            }
            .t-Body-side {
                width: auto;
            }
            
            #reg-OS tr {
                background-color: #ffdedb !important;
            }
            #reg-SZ tr {
                background-color: #ebfff5 !important;
            }
            
            .naziv-crveno th {
                color: #ffdedb  !important;
            }
            
            .naziv-zeleno th {
                color: #ebfff5  !important;
            }
            ```
    }
    security {
        authorizationScheme: @glavna-knjiga-izvodi
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    help {
        helpText:
            ```html
            Na ovoj stranici dostupan je detaljan pregled izvoda, a prvi korak prije korištenja 
            funkcionalnosti jeste unos banke. Unos banke nije moguć ukoliko banka prethodno 
            nije evidentirana u sistemu. </br>
            Postoje dva načina za unos banke: 
            <ul>
                <li>Prvi način je kroz <b><em>"Administraciju"</em></b></li> 
                <li>Drugi način je kroz modul <b><em>"Finansija"</em></b>, 
                gdje se u opciji <b><em>"Konfiguracija"</em></b> nalaze banke.</li>
            </ul> </br>
            Klikom na dugme <b><em>"Novi unos"</em></b> otvara se forma za unos novog izvoda. 
            Na ovoj stranici obavezno je odabrati banku, dok se broj izvoda popunjava automatski, 
            uz mogućnost ručnog unosa. </br>
            </br>
            Početno stanje se preuzima iz prethodnog izvoda, dok se zaključno stanje unosi ručno. 
            Unos početnog i zaključnog stanja izvoda služi za sistemsku kontrolu unosa prometa izvoda. </br>
            Datum knjiženja je datum pod kojim se nalog za 
            knjiženje izvoda kreira u glavnoj knjizi. </br>
            Polje <b><em>"Opis"</em></b> se automatski popunjava vrijednošću 
            sastavljenom od prvih tri cifre koje označavaju banku, naredne tri koje predstavljaju broj 
            izvoda i preostalog dijela koji sadrži datum kreiranja izvoda. </br> 
            </br>
            Za stavke je obavezan unos konta sa subanalitike. Prilikom unosa, uplate odnosno prilivi unose 
            se s negativnim vrijednostima, dok se isplate odnosno odlivi unose kao pozitivne vrijednosti. 
            ```
    }

    region analitika-zatvaranja (
        name: Analitika zatvaranja
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ost.*,ost.id as razvezi_stavke
                from accounting.vw_gk_analitika_zatvaranja ost
                where 1=1
                AND :P1890_U_IZV=1
                and ost.ooj_id=:APP_OOJ_ID
                and (:P1890_PARTNER_Z is null or ost.partner_id=:P1890_PARTNER_Z)
                and (:P1890_OPSTINA_Z is null or ost.opstina_id=:P1890_OPSTINA_Z)
                and (:P1890_RADNIK_Z is null or ost.radnik_id=:P1890_RADNIK_Z)
                and (:P1890_MJESTO_TROSKA_Z is null or ost.mt_id=:P1890_MJESTO_TROSKA_Z)
                and (:P1890_KONTO_Z is null or ost.konto_id=:P1890_KONTO_Z)
                order by  ost.id desc
                /*and not exists (
                                select 1 
                                from apex_collections kol 
                                where kol.collection_name = 'NACRT_UPARIVANJA' 
                                and kol.n001 = ost.id
                               )*/
                ```
            pageItemsToSubmit: [
                P1890_PARTNER_Z
                P1890_OPSTINA_Z
                P1890_RADNIK_Z
                P1890_MJESTO_TROSKA_Z
                P1890_KONTO_Z
                P1890_U_IZV
            ]
        }
