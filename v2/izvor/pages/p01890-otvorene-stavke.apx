    region otvorene-stavke (
        name: Otvorene stavke
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ost.*,ost.id as izaberi_stavku
                from accounting.vw_gk_otvorene_stavke ost 
                where 1=1
                AND :P1890_O_IZV=1
                and ost.ooj_id=:APP_OOJ_ID
                and (:P1890_PARTNER is null or ost.partner_id=:P1890_PARTNER)
                and (:P1890_OPSTINA is null or ost.opstina_id=:P1890_OPSTINA)
                and (:P1890_RADNIK is null or ost.radnik_id=:P1890_RADNIK)
                and (:P1890_MJESTO_TROSKA is null or ost.mt_id=:P1890_MJESTO_TROSKA)
                and (:P1890_KONTO is null or ost.konto_id=:P1890_KONTO)
                and not exists (
                                select 1 
                                from apex_collections kol 
                                where kol.collection_name = 'NACRT_UPARIVANJA' 
                                and kol.n001 = ost.id
                               )
                ```
            pageItemsToSubmit: [
                P1890_PARTNER
                P1890_OPSTINA
                P1890_RADNIK
                P1890_MJESTO_TROSKA
                P1890_KONTO
                P1890_O_IZV
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
            cssClasses: fin-ir
        }
        advanced {
            htmlDomId: reg-OSS
        }
