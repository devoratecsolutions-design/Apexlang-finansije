    dynamicAction odaberi-stavku (
        name: Odaberi stavku
        execution {
            sequence: 230
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .add-st
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                    v_st_knji varchar2(1);
                    v_ot_iznos number;
                    v_postoji_os number;
                    v_ukupno_nacrt number;
                    v_analitika number;
                    
                    begin 
                    
                        select gks.otvoreni_iznos, gks.tip_stavke
                        into   v_ot_iznos,v_st_knji
                        from accounting.glavna_knjiga_stavke gks 
                        where gks.id=:P1890_STAVKA_ID_POM;
                    
                        :P1890_ERROR_FLAG:='N'; :P1890_ERROR_MESSAGE:='';
                    
                        -----------provjera da li kolekcija postoji i da li je os dodata---
                        if not APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => 'NACRT_UPARIVANJA') then  -- ne postoji
                    
                            if v_ot_iznos>0 then 
                    
                                :P1890_ERROR_FLAG:='Y'; :P1890_ERROR_MESSAGE:='Najprije je potrebno dodati stavku kod koje je otvoreni iznos manji od 0!';
                    
                            else 
                    
                                APEX_COLLECTION.CREATE_COLLECTION(p_collection_name => 'NACRT_UPARIVANJA');
                                APEX_COLLECTION.ADD_MEMBER(
                                    p_collection_name => 'NACRT_UPARIVANJA',
                                    p_n001            => :P1890_STAVKA_ID_POM, 
                                    p_n002            => v_ot_iznos,
                                    p_c001            => v_st_knji
                                );
                    
                                select a.partner, a.konto, a.mjesto_troska, a.opstina, a.radnik
                                into   :P1890_PARTNER_U, :P1890_KONTO_U, :P1890_MJESTO_TROSKA_U, :P1890_OPSTINA_U, :P1890_RADNIK_U
                                from accounting.vw_gk_otvorene_stavke a  
                                where a.id=:P1890_STAVKA_ID_POM;
                           
                            end if;
                    
                        else ----postoji 
                    
                            ----provjera da li se dodaje os ili stavka zatvaranja---
                            if v_ot_iznos<0 then --os
                    
                                select count(*) into v_postoji_os from apex_collections where collection_name = 'NACRT_UPARIVANJA' and n002 < 0 and rownum = 1; 
                    
                                if v_postoji_os > 0 then -- da li postoji već dodata os u nacrtu
                                    
                                    :P1890_ERROR_FLAG:='Y'; :P1890_ERROR_MESSAGE:='U nacrtu može biti samo jedna stavka kod koje je otvoreni iznos manji od 0!';
                    
                                else
                                    APEX_COLLECTION.ADD_MEMBER(
                                        p_collection_name => 'NACRT_UPARIVANJA',
                                            p_n001            => :P1890_STAVKA_ID_POM, 
                                            p_n002            => v_ot_iznos,
                                            p_c001            => v_st_knji
                                        );
                                end if;
                    
                    
                            else --- stavka zatvaranja 
                    
                                ---najprije se provjera da li kompletna analitika odgovara analitici otvorene stavke---
                                select count(*)
                                into v_analitika
                                from (
                                    select b.klijent_id, b.kontna_klasa_id, b.mjesto_troska_id, b.grad_id, b.acc_radnik_id 
                                    from accounting.glavna_knjiga_stavke b 
                                    join apex_collections kol on b.id=kol.n001
                                    where kol.collection_name='NACRT_UPARIVANJA'
                                    minus
                                    select a.klijent_id, a.kontna_klasa_id, a.mjesto_troska_id, a.grad_id, a.acc_radnik_id 
                                    from accounting.glavna_knjiga_stavke a where a.id = :P1890_STAVKA_ID_POM
                                );
                    
                                if v_analitika = 0 then
                                    -- sve dimenzije se poklapaju
                                    select sum(n002) into v_ukupno_nacrt from apex_collections where collection_name = 'NACRT_UPARIVANJA';
                    
                                    if v_ukupno_nacrt>=0 then --provjera da li već postoji dovoljan za zatvaranje
                    
                                        :P1890_ERROR_FLAG:='Y'; :P1890_ERROR_MESSAGE:='Već postoji dovoljan iznos za zatvaranje izabrane stavke!';
                    
                                    else
                                        APEX_COLLECTION.ADD_MEMBER(
                                            p_collection_name => 'NACRT_UPARIVANJA',
                                            p_n001            => :P1890_STAVKA_ID_POM, 
                                            p_n002            => v_ot_iznos,
                                            p_c001            => v_st_knji
                                        );
                    
                                    end if;
                    
                                else
                                   
                                    :P1890_ERROR_FLAG:='Y'; :P1890_ERROR_MESSAGE:='Analitika stavke zatvaranja ne odgovara analitici otvorene stavke!';
                                end if;
                    
                            end if; 
                    
                        end if;
                    
                    end;
                    ```
                itemsToSubmit: P1890_STAVKA_ID_POM
                itemsToReturn: [
                    P1890_ERROR_FLAG
                    P1890_ERROR_MESSAGE
                    P1890_PARTNER_U
                    P1890_OPSTINA_U
                    P1890_RADNIK_U
                    P1890_MJESTO_TROSKA_U
                    P1890_KONTO_U
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.message.clearErrors();
                    if ($v('P1890_ERROR_FLAG') === 'Y') {
                        apex.message.showErrors([{
                            type: "error",
                            location: "page",
                            message: $v('P1890_ERROR_MESSAGE'),
                            unsafe: false
                        }]);
                    
                        setTimeout(function() {
                            apex.message.clearErrors();
                        }, 3000);
                    }else{
                     
                        apex.region("reg-OS").refresh();
                        apex.region("reg-SZ").refresh();
                        apex.region("reg-OSS").refresh();
                    }
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).parent().data('id');
            }
            affectedElements {
                selectionType: items
                items: P1890_STAVKA_ID_POM
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

