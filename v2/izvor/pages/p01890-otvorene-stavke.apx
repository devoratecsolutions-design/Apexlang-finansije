    region stavke-zatvaranja (
        name: Stavke zatvaranja
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select kol.seq_id as ukloni,ost.opis_stavke, ost. referentni_dokument, ost.opis_referentnog_dokumenta,
                       ost.iznos, ost.otvoreni_iznos,ost.strana_knjizena,ost.datum_dokumenta
                from apex_collections kol
                join accounting.vw_gk_otvorene_stavke ost  on ost.id=kol.n001
                where kol.collection_name = 'NACRT_UPARIVANJA' 
                and kol.n002>0
                ```
        }
        layout {
            sequence: 20
            parentRegion: @nacrt-uparivanja
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: fin-ir
        }
        advanced {
            htmlDomId: reg-SZ
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
