    validation uveži-otvorene-stavke (
        name: Uveži otvorene stavke
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                
                
                    l_broj_strana number;
                    v_stanje_os number;
                
                
                begin
                
                 
                       if not APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => 'NACRT_UPARIVANJA') then
                
                            return 'Neophodno je dodati stavke za uparivanje!';
                        
                       end if;
                
                    
                       select count(distinct sign(n002))
                       into l_broj_strana
                       from apex_collections
                       where collection_name = 'NACRT_UPARIVANJA'
                       and n002 != 0;
                
                       if l_broj_strana != 2 then
                           return 'Neophodno je dodati barem po jednu otvorenu stavku i stavku za zatvaranje!'; 
                       end if;
                
                
                       select count(*)
                       into v_stanje_os
                       from apex_collections kol
                       left join accounting.vw_gk_otvorene_stavke ost  on ost.id=kol.n001
                       where collection_name = 'NACRT_UPARIVANJA'
                       and kol.n002<>ost.otvoreni_iznos;
                
                       if v_stanje_os>0 then 
                            return 'Došlo je do promjene na otvorenim stavkama od strane drugog korisnika, najprije uklonite sve izabrane stavke pa ponovite proces!'; 
                       end if;
                
                
                end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @upari
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                    if APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => 'NACRT_UPARIVANJA') then
                
                        APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => 'NACRT_UPARIVANJA');
                        
                    end if;
                
                    
                    select null, null, null, null, null
                    into   :P1890_PARTNER_U, :P1890_KONTO_U, :P1890_MJESTO_TROSKA_U, :P1890_OPSTINA_U, :P1890_RADNIK_U
                    from dual;
                    
                    
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 273322126593892407
        }
    )

    process uveži-otvorene-stavke (
        name: Uveži otvorene stavke
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                
                v_godina number;
                v_broj_naloga number;
                v_id_naloga_gk number;
                v_id_stavke_gk number;
                v_id_gks_ot number;
                v_id_gks_zat number;
                v_iznos_ot_uk number;
                v_iznos_zat_uk number;
                v_iznos_zat number;
                v_preostali_iznos number;
                v_broj_zat number;
                
                
                
                begin 
                
                    SELECT  n001  AS stavka_id, n002 as otvoreni_iznos
                    INTO v_id_gks_ot,v_iznos_ot_uk
                    FROM apex_collections
                    WHERE collection_name = 'NACRT_UPARIVANJA'
                    AND n002<0;
                
                    v_preostali_iznos:=v_iznos_ot_uk;
                    v_broj_zat:=accounting.glavna_knjiga_pkg.get_broj_zatvaranja(:APP_OOJ_ID);
                
                    for r in (SELECT c001  AS st_knji,
                                     n001  AS stavka_zat,
                                     n002  AS iznos_zatvaranja
                                FROM apex_collections
                                WHERE collection_name = 'NACRT_UPARIVANJA'
                                AND n002>0)
                    loop
                
                      ----zatvaraju se kompletno obje stavke i prekida se dalje izvršavanje----
                      if v_preostali_iznos+r.iznos_zatvaranja=0 then 
                                
                            accounting.glavna_knjiga_pkg.insert_gk_analitika_zatvaranja (
                                p_ooj_id            => :APP_OOJ_ID,
                                p_broj              => v_broj_zat,
                                p_o_stavka_id       =>v_id_gks_ot,
                                p_z_stavka_id       =>r.stavka_zat,
                                p_iznos_zatvaranja  =>r.iznos_zatvaranja,
                                P_storno            =>null,
                                p_id                =>v_id_gks_zat
                            );
                
                            update accounting.glavna_knjiga_stavke gks
                            set gks.otvoreni_iznos=0,
                                gks.otvorena='Z'
                             where id in (r.stavka_zat,v_id_gks_ot);
                
                            exit;
                
                
                      ---zatvara se otovorena stavka i djelimično stavka zatvaranja, takođe se prekida dalje izvršavanje
                      elsif v_preostali_iznos+r.iznos_zatvaranja>0 then 
                
                            accounting.glavna_knjiga_pkg.insert_gk_analitika_zatvaranja (
                                p_ooj_id            => :APP_OOJ_ID,
                                p_broj              => v_broj_zat,
                                p_o_stavka_id       =>v_id_gks_ot,
                                p_z_stavka_id       =>r.stavka_zat,
                                p_iznos_zatvaranja  =>-v_preostali_iznos,
                                P_storno            =>null,
                                p_id                =>v_id_gks_zat
                            );
                
                            update accounting.glavna_knjiga_stavke gks
                            set gks.otvoreni_iznos=0,
                                gks.otvorena='Z'
                            where gks.id=v_id_gks_ot;
                
                            update accounting.glavna_knjiga_stavke gks
                            set gks.otvoreni_iznos=gks.otvoreni_iznos+v_preostali_iznos,
                                gks.otvorena='DZ'
                            where gks.id=r.stavka_zat;
                
                
                            exit;
                
                
                         ----otvorena stavka se djelimično zatvara, stavka zatvaranja kompletnno i nastavlja se dalje izvršaavnje
                       else 
                
                            accounting.glavna_knjiga_pkg.insert_gk_analitika_zatvaranja (
                                p_ooj_id            => :APP_OOJ_ID,
                                p_broj              => v_broj_zat,                
                                p_o_stavka_id       =>v_id_gks_ot,
                                p_z_stavka_id       =>r.stavka_zat,
                                p_iznos_zatvaranja  =>r.iznos_zatvaranja,
                                P_storno            =>null,
                                p_id                =>v_id_gks_zat
                            );
                
                            update accounting.glavna_knjiga_stavke gks
                            set gks.otvoreni_iznos=gks.otvoreni_iznos+r.iznos_zatvaranja,
                                gks.otvorena='DZ'
                            where gks.id=v_id_gks_ot;
                
                            update accounting.glavna_knjiga_stavke gks
                            set gks.otvoreni_iznos=0,
                                gks.otvorena='Z'
                            where gks.id=r.stavka_zat;
                
                            v_preostali_iznos:=v_preostali_iznos+r.iznos_zatvaranja;
                      end if;
                
                    end loop;
                
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Stavke uspješno uparene
        }
        advanced {
            executionMappingIdentifier: 273145931332360100
        }
        serverSideCondition {
            whenButtonPressed: @upari
        }
    )

)

