    dynamicAction storno-zatvaranja (
        name: Storno zatvaranja
        execution {
            sequence: 200
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .delete-st
        }

        action native-confirm (
            action: confirm
            settings {
                message: Da li ste sigurni da želite stornirati zatvaranje?
                style: danger
                confirmLabel: DA
                cancelLabel: NE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                    v_pom number;
                    v_storno number;
                    begin
                    
                        select count(*)
                        into v_storno
                        from accounting.gk_analitika_zatvaranja z 
                        where z.id=:P1890_ZATVARANJE_ID 
                        and z.storno is not null;
                    
                        :P1890_ERROR_FLAG:='N'; :P1890_ERROR_MESSAGE:='';
                    
                    
                        if v_storno=0 then
                    
                            
                    
                            accounting.glavna_knjiga_pkg.razvezi_uparene_stavke_gk(:P1890_ZATVARANJE_ID);
                    
                    
                            if APEX_COLLECTION.COLLECTION_EXISTS(p_collection_name => 'NACRT_UPARIVANJA') then
                    
                                APEX_COLLECTION.DELETE_COLLECTION(p_collection_name => 'NACRT_UPARIVANJA');
                                
                            end if;
                    
                        else
                    
                            :P1890_ERROR_FLAG:='Y'; :P1890_ERROR_MESSAGE:='Nije moguće stornirati stornirano zatvaranje!';
                    
                        end if;
                    
                    
                    end;
                    ```
                itemsToSubmit: P1890_ZATVARANJE_ID
                itemsToReturn: [
                    P1890_ERROR_MESSAGE
                    P1890_ERROR_FLAG
