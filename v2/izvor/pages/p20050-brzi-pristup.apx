page 20050 (
    name: Brzi pristup
    alias: BRZI-PRISTUP
    title: Brzi pristup
    pageGroup: @erp-globalne-stranice
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region brzi-pristup-lista (
        name: Brzi pristup (Lista)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    id,
                    page_id,
                    title as list_title,
                    'Sekvenca: ' || sequence as list_text,
                    icon as icon_class,
                    apex_page.get_url(
                        p_page   => 20051,
                        p_items  => 'P20051_ID',
                        p_values => id
                    ) as link,
                
                    updated as list_badge,
                    case 
                        when valid = 'Y' then
                            'u-color-5'
                        else
                            'u-color-9'
                    end as icon_color_class
                
                from core.korisnik_brzi_pristupi
                where
                    korisnik_id = :APP_USER_ID
                order by sequence
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-top-sm
            ]
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                t-MediaList--stack
                t-MediaList--iconsRounded
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column ICON_CLASS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Icon Class
            }
            layout {
                sequence: 23
            }
            sorting {
                sortable: false
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Icon Color Class
            }
            layout {
                sequence: 53
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 0
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LINK (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Link
            }
            layout {
                sequence: 33
            }
            sorting {
                sortable: false
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: List Badge
            }
            layout {
                sequence: 43
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="t-Button t-Button--icon #ICON_COLOR_CLASS#">
                        #LIST_BADGE#
                    </span>
                    
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: List Text
            }
            layout {
                sequence: 63
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: List Title
            }
            layout {
                sequence: 13
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page ID
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

    button cancel (
        buttonName: CANCEL
        label: Podešavanja
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--link
                t-Button--iconLeft
            ]
            cssClasses: t-Button--inlineLink
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 20000
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @brzi-pristup-lista
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @brzi-pristup-lista
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

