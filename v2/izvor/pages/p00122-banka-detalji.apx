page 122 (
    name: Banka / Detalji
    alias: BANKA-DETALJI
    title: Banka / Detalji
    pageGroup: @konfiguracija
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region osnovna-organizaciona-jedinica-banka-detalji (
        name: Osnovna organizaciona jedinica / Banka / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P122_BANKA_ID (
        type: selectOne
        label {
            label: Banka
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @sif-banke
        }
        layout {
            sequence: 30
            region: @osnovna-organizaciona-jedinica-banka-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P122_ID (
        type: hidden
        layout {
            sequence: 10
            region: @osnovna-organizaciona-jedinica-banka-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P122_KONTNA_KLASA_ID (
        type: selectOne
        label {
            label: Konto
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    rpad(code, core.ooj_pkg.get_konto_duzina(:APP_OOJ_ID), '0') || ' - ' || naziv as d,
                    id as r
                FROM
                    sif.acc_kontni_okvir_klase
                WHERE
                    length(code) >= 4 
                    AND (ooj_id = :APP_OOJ_ID or ooj_id is null)
                ```
        }
        layout {
            sequence: 40
            region: @osnovna-organizaciona-jedinica-banka-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: itemIsNotInColonDelimitedList
            item: APP_TIP_PREDUZETNIKA_SIFRA
            list: [
                msp
                vsp_prosto
            ]
        }
    )

    pageItem P122_OOJ_ID (
        type: hidden
        layout {
            sequence: 20
            region: @osnovna-organizaciona-jedinica-banka-detalji
            slot: regionBody
        }
    )

    pageItem P122_VALID (
        type: radioGroup
        label {
            label: Aktivno
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @osnovna-organizaciona-jedinica-banka-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P122_ID
        }
    )

    pageItem P122_ZA_PLATE (
        type: radioGroup
        label {
            label: Račun za isplatu plata
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @osnovna-organizaciona-jedinica-banka-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
    )

    pageItem P122_ZIRO_RACUN (
        type: textField
        label {
            label: Žiro račun
            alignment: left
        }
        layout {
            sequence: 60
            region: @osnovna-organizaciona-jedinica-banka-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P122_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P122_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P122_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation banka-not-null (
        name: Banka NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P122_BANKA_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P122_BANKA_ID
        }
    )

    validation kontna-klasa-not-null (
        name: Kontna klasa NOT NULL
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P122_KONTNA_KLASA_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P122_KONTNA_KLASA_ID
        }
        serverSideCondition {
            type: itemIsNotInColonDelimitedList
            item: APP_TIP_PREDUZETNIKA_SIFRA
            list: [
                msp
                vsp_prosto
            ]
        }
    )

    validation za-plate-not-null (
        name: ZA PLATE NOT NULL
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P122_ZA_PLATE
        }
        error {
            errorMessage: #LABEL# obavezno za unos.
            associatedItem: @P122_ZA_PLATE
        }
    )

    validation ziro-racun-not-null (
        name: Ziro racun NOT NULL
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P122_ZIRO_RACUN
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P122_ZIRO_RACUN
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 53162704677146984
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.ooj_pkg.delete_ooj_banka (
                    p_id => :P122_ID
                );
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 53162328809146984
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.ooj_pkg.get_ooj_banka (
                    p_id              => :P122_ID,
                    p_ooj_id          => :P122_OOJ_ID,
                    p_banka_id        => :P122_BANKA_ID,
                    p_kontna_klasa_id => :P122_KONTNA_KLASA_ID,
                    p_ziro_racun      => :P122_ZIRO_RACUN,
                    p_za_plate        => :P122_ZA_PLATE,
                    p_valid           => :P122_VALID
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 53161124239146983
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P122_ID
        }
    )

    process insert-msp-vsp-prosto (
        name: Insert - msp:vsp_prosto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.ooj_pkg.insert_ooj_banka (
                    p_ooj_id          => :APP_OOJ_ID,
                    p_banka_id        => :P122_BANKA_ID,
                    p_kontna_klasa_id => null,
                    p_ziro_racun      => :P122_ZIRO_RACUN,
                    p_za_plate        => :P122_ZA_PLATE
                );
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 53161539980146984
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: itemIsInColonDelimitedList
            item: APP_TIP_PREDUZETNIKA_SIFRA
            list: [
                msp
                vsp_prosto
            ]
        }
    )

    process insert-not-msp-vsp-prosto (
        name: "Insert - NOT msp:vsp_prosto "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.ooj_pkg.insert_ooj_banka (
                    p_ooj_id          => :APP_OOJ_ID,
                    p_banka_id        => :P122_BANKA_ID,
                    p_kontna_klasa_id => :P122_KONTNA_KLASA_ID,
                    p_ziro_racun      => :P122_ZIRO_RACUN,
                    p_za_plate        => :P122_ZA_PLATE
                );
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 140353725148982301
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: itemIsNotInColonDelimitedList
            item: APP_TIP_PREDUZETNIKA_SIFRA
            list: [
                msp
                vsp_prosto
            ]
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.ooj_pkg.update_ooj_banka (
                    p_id              => :P122_ID,
                    p_ooj_id          => :P122_OOJ_ID,
                    p_banka_id        => :P122_BANKA_ID,
                    p_kontna_klasa_id => :P122_KONTNA_KLASA_ID,
                    p_ziro_racun      => :P122_ZIRO_RACUN,
                    p_za_plate        => :P122_ZA_PLATE,
                    p_valid           => :P122_VALID
                );
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 53161946590146984
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

