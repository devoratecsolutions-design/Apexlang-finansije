    dynamicAction avansna-faktura-zatvaranje (
        name: AVZ, KO, KZ - disable pdv items
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P51_VRSTA_FAKTURE_SIFRA
        }
        serverSideCondition {
            type: item=value
            item: APP_PDV_SISTEM
            value: Y
        }

        action avz-ko-kz-disable-pdv-iteme (
            name: AVZ, KO, KZ - disable pdv iteme
            action: disable
            affectedElements {
                selectionType: items
                items: P51_PDV_INDIKATOR_ID
            }
            execution {
                sequence: 20
            }
            clientSideCondition {
                type: itemIsInList
                item: P51_VRSTA_FAKTURE_SIFRA
                list: [
                    AVZ
                    KO
                    KZ
                ]
            }
        )

    )

    dynamicAction avz (
        name: AVZ disable items
        execution {
            sequence: 110
        }
        when {
            selectionType: items
            items: P51_VRSTA_FAKTURE_SIFRA
        }

        action avz-disable (
            name: AVZ - disable items
            action: disable
            affectedElements {
                selectionType: items
                items: [
                    P51_DANI
                    P51_TIP_PLACANJA_ID
                ]
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item=value
                item: P51_VRSTA_FAKTURE_SIFRA
                value: AVZ
            }
        )

    )

    dynamicAction avz-enable-items (
        name: Not AVZ -  enable items
        execution {
            sequence: 120
        }
        when {
            selectionType: items
            items: P51_VRSTA_FAKTURE_SIFRA
        }

        action avz-disable (
            name: Not AVZ -enable items
            action: enable
            affectedElements {
                selectionType: items
                items: [
                    P51_DANI
                    P51_TIP_PLACANJA_ID
                ]
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item!=value
                item: P51_VRSTA_FAKTURE_SIFRA
                value: AVZ
            }
        )

    )

    dynamicAction avz-ko-kz-diseble-valuta (
        name: AVZ, KO, KZ - diseble valuta
        execution {
            sequence: 100
        }
        when {
            selectionType: items
            items: P51_VRSTA_FAKTURE_SIFRA
        }

        action avz-disable-items (
            name: AVZ - disable items
            action: disable
            affectedElements {
                selectionType: items
                items: P51_VALUTA_ID
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: itemIsInList
                item: P51_VRSTA_FAKTURE_SIFRA
                list: [
                    AVZ
                    KO
                    KZ
                ]
            }
        )

    )

    dynamicAction calculate-datum-valute (
        name: Calculate - Datum valute
        execution {
            sequence: 150
        }
        when {
            selectionType: items
            items: [
                P51_DANI
                P51_DATUM_FAKTURE
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P51_DANI_NEW IS NOT null THEN
                        :P51_DANI := :P51_DANI_NEW;
                        :P51_DATUM_VALUTE := trunc(to_date(:P51_DATUM_FAKTURE,'DD.MM.YYYY')) + numtodsinterval(:P51_DANI_NEW, 'day');
                    
                    ELSE
                        :P51_DATUM_VALUTE := trunc(to_date(:P51_DATUM_FAKTURE,'DD.MM.YYYY')) + numtodsinterval(:P51_DANI, 'day');
                    
                    END IF;
                    ```
                itemsToSubmit: [
                    P51_DANI
                    P51_DATUM_FAKTURE
                    P51_DATUM_VALUTE
                    P51_DANI_NEW
                ]
                itemsToReturn: P51_DATUM_VALUTE
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction dialog-closed-set-item (
        name: Dialog Closed - Set item
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @new-client
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P51_KLIJENT_ID
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P11_ID
            }
            affectedElements {
                selectionType: items
                items: P51_KLIJENT_ID
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction not-avz-ko-kz-enable-pdv-items (
