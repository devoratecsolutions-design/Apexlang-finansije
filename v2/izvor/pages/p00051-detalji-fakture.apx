    process copy (
        name: Copy
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR c_stavke IS (
                        SELECT
                            stavka_id,
                            jm_id,
                            kolicina,
                            cijena,
                            rabat,
                            pdv,
                            iznos,
                            pdv_indikator_id
                        FROM
                            kif_stavke
                        WHERE
                            kif_id = :P51_COPY_ID
                    );
                BEGIN
                    apex_collection.create_or_truncate_collection (
                        p_collection_name => 'FAKTURA_STAVKE'
                    );
                
                    finansije_pkg.get_kif (
                        p_id                   => :P51_COPY_ID,
                        p_klijent_id           => :P51_KLIJENT_ID,
                        p_vrsta_fakture_id     => :P51_VRSTA_FAKTURE_ID,
                        p_uio_tip_dokumenta_id => :P51_TIP_DOKUMENTA_ID,
                        p_faktura_id           => :P51_FAKTURA_ID,
                        p_tip_placanja_id      => :P51_TIP_PLACANJA_ID,
                        p_valuta_id            => :P51_VALUTA_ID,
                        p_print_pn             => :P53_PRINT_PN,
                        p_posebne_napomene     => :P53_POSEBNE_NAPOMENE,
                        p_tip_cijene           => :P51_TIP_CIJENE
                    );
                
                    FOR c1 IN c_stavke LOOP
                        apex_collection.add_member (
                            p_collection_name => 'FAKTURA_STAVKE',
                            p_c001            => c1.stavka_id,
                            p_c002            => c1.jm_id,
                            p_c003            => c1.kolicina,
                            p_c004            => c1.cijena,
                            p_c005            => c1.rabat,
                            p_c006            => c1.pdv,
                            p_c007            => c1.iznos,
                            p_c008            => c1.iznos + (c1.iznos * c1.pdv / 100),
                            p_c010            => c1.pdv_indikator_id
                        );
                
                    END LOOP;
                
                    :P52_SEQ_ID := null;
                END;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 157161652207756916
        }
        serverSideCondition {
            type: request=Value
            value: copy
        }
    )

    process setup-default (
        name: Setup default
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P51_TIP_CIJENE := core.ooj_pkg.get_tip_cijene (
                    p_ooj_id => :APP_OOJ_ID
                );
                
                accounting.skladista_pkg.get_skladiste_cjenovnik(:A_SKLADISTE_ID, :P51_CJENOVNIK);
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 101099244627362011
        }
    )

    process submit-items (
        name: Submit items
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                
                l_dani number;
                l_tip_placanja_id number;
                
                begin 
                
                    IF :P51_VRSTA_FAKTURE_SIFRA  IN ('KO','KZ','AVZ')  then 
                
                
                        select k.pdv_indikator_id, k.valuta_id,0, k.tip_placanja_id
                        into :P51_PDV_INDIKATOR_ID, :P51_VALUTA_ID,l_dani,l_tip_placanja_id
                        from kif k
                        where k.id=:P51_FAKTURA_ID;
                
                        if :P51_VRSTA_FAKTURE_SIFRA  IN ('AVZ')  then
                
                            :P51_TIP_PLACANJA_ID:= l_tip_placanja_id;
                            :P51_DANI_NEW:=l_dani;
                            :P51_DATUM_VALUTE:=:P51_DATUM_FAKTURE;
                
                        end if;
                
                    END IF;
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 79186848356964032
        }
    )

    branch (
        name: Go To Page 52
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 52
                items: {
                    P53_KLIJENT_ID: &P51_KLIJENT_ID.
                    P53_NAZIV_FAKTURE: &P51_NAZIV_FAKTURE.
                    P53_DANI: &P51_DANI.
                    P53_DATUM_FAKTURE: &P51_DATUM_FAKTURE.
                    P53_DATUM_VALUTE: &P51_DATUM_VALUTE.
                    P53_TIP_PLACANJA_ID: &P51_TIP_PLACANJA_ID.
                    P53_VALUTA_ID: &P51_VALUTA_ID.
                    P53_FAKTURA_BROJ: &P51_FAKTURA_BROJ.
                    P53_ORIG: &P51_ORIG.
                    P52_VALUTA_ID: &P51_VALUTA_ID.
                    P53_FISKAL_BR: &P51_FISKAL_BR.
                    P53_TIP_DOKUMENTA_ID: &P51_TIP_DOKUMENTA_ID.
                    P53_VRSTA_FAKTURE_ID: &P51_VRSTA_FAKTURE_ID.
                    P52_TIP_CIJENE: &P51_TIP_CIJENE.
                    P52_PDV_HIDDEN: &P51_PDV.
                    P52_SEQ_ID: 0
                    P52_KURS: &P51_KURS.
                    P53_PDV_INDIKATOR_ID: &P51_PDV_INDIKATOR_ID.
                    P52_TIP_DOKUMENTA_ID: &P51_TIP_DOKUMENTA_ID.
                    P52_PDV_INDIKATOR_DOKUMENT_ID: &P51_PDV_INDIKATOR_ID.
                    P52_PDV_INDIKATOR_ID: &P51_PDV_INDIKATOR_ID.
                }
                request: stavke
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: NEXT_1,NEXT_2
        }
    )

)

