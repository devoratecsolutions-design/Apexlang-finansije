            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 40
            region: @ulazne-fakture
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 41
                items: {
                    P41_ORIG: 40
                }
                clearCache: 41
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: RETURN core.protokoli_pkg.check_brojac(:APP_OOJ_ID, 'uf', :APP_GODINA);
        }
    )

