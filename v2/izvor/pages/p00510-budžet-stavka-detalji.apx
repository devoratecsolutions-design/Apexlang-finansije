page 510 (
    name: Budžet stavka / Detalji
    alias: BUDŽET-STAVKA-DETALJI
    title: Budžet stavka / Detalji
    pageGroup: @budžet
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region detalji-report (
        name: Detalji Report
        title: Detalji
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    oj_naziv,
                    stavka_naziv,
                    projekat_naziv,
                    period,
                    iznos,
                    napomena
                
                FROM
                    vw_budzet_stavke
                WHERE
                    id = :P510_ID
                ```
        }
        layout {
            sequence: 110
            slot: contentBody
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }

        column IZNOS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Iznos
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column NAPOMENA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Napomena
            }
            layout {
                sequence: 60
            }
        )

        column OJ_NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Organizaciona jedinica
            }
            layout {
                sequence: 10
            }
        )

        column PERIOD (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Period
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH params AS (
                        -- Parameters
                        SELECT :P510_BROJ_MJESECI AS p_months,
                               :P510_GODINA AS p_year
                        FROM dual
                    ),
                    months AS (
                        SELECT LEVEL AS month_num,
                               ADD_MONTHS(TRUNC(TO_DATE(p.p_year, 'YYYY'), 'YYYY'), LEVEL - 1) AS first_day
                        FROM dual
                        CROSS JOIN params p
                        CONNECT BY LEVEL <= 12
                    ),
                    periods AS (
                        SELECT m.month_num,
                               m.first_day,
                               CEIL(m.month_num / p.p_months) AS q_num,
                               p.p_months
                        FROM months m
                        CROSS JOIN params p
                    )
                    SELECT 
                        'P' || q_num || ' = ' ||
                        TRIM(TO_CHAR(MIN(first_day), 'Month', 'NLS_DATE_LANGUAGE=''LATIN SERBIAN''')) ||
                        CASE WHEN p_months > 1 
                             THEN ' - ' || TRIM(TO_CHAR(MAX(first_day), 'Month', 'NLS_DATE_LANGUAGE=''LATIN SERBIAN'''))
                             ELSE ''
                        END AS display,
                        TRUNC(MIN(first_day)) AS return_date
                    FROM periods
                    GROUP BY q_num, p_months
                    ORDER BY q_num;
                    
                    ```
            }
            layout {
                sequence: 40
            }
        )

        column PROJEKAT_NAZIV (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Projekat
            }
            layout {
                sequence: 30
            }
        )

        column STAVKA_NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Stavka
            }
            layout {
                sequence: 20
            }
        )

    )

    region dokumentacija-wrapper (
        name: Dokumentacija Wrapper
        title: Dokumentacija
        type: staticContent
        layout {
            sequence: 140
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region dokumenti-report (
        name: Dokumenti Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    dbms_lob.getlength(dokument) AS dokument,
                    dokument_filename,
                    dokument_mimetype
                FROM
                    budzet_stavka_dokumenti
                WHERE
                    stavka_id = :P510_ID
                ```
        }
        layout {
            sequence: 20
            parentRegion: @dokumentacija-wrapper
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DERIVED$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            heading {
                heading: Obriši
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="t-Button t-Button--noLabel u-color-9 t-Button--iconLeft delete-dokument" data-id=#ID#>
                        <span class="t-Icon t-Icon--left fa fa-trash-o"></span>
                    </span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column DOKUMENT (
            reportColumnQueryId: 2
            derivedColumn: N
            type: downloadBlob
            heading {
                heading: Preuzmi
            }
            layout {
                sequence: 30
            }
            blobAttributes {
                tableName: BUDZET_STAVKA_DOKUMENTI
                blobColumn: DOKUMENT
                primaryKeyColumn1: ID
                mimeTypeColumn: DOKUMENT_MIMETYPE
                filenameColumn: DOKUMENT_FILENAME
                lastUpdatedColumn: DOKUMENT_LASTUPD
                charSetColumn: DOKUMENT_CHARSET
            }
            sorting {
                sortable: false
            }
        )

        column DOKUMENT_FILENAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Naziv
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column DOKUMENT_MIMETYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Pregled
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 512
                    items: {
                        P512_ID: #ID#
                    }
                    clearCache: 512
                }
                linkText: <img src="#APEX_FILES#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            sorting {
                sortable: false
            }
        )

    )

    region item-wrapper-dokumenti (
        name: Item Wrapper - Dokumenti
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @dokumentacija-wrapper
            slot: subRegions
        }
        appearance {
            template: @item-container
            templateOptions: [
                #DEFAULT#
                t-ItemContainer--alignStretch
            ]
        }
    )

    region item-wrapper-komentar (
        name: Item Wrapper - Komentar
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @komentari-wrapper
            slot: subRegions
        }
        appearance {
            template: @item-container
            templateOptions: [
                #DEFAULT#
                t-ItemContainer--alignStretch
            ]
        }
    )

    region komentari-report (
        name: Komentari Report
        type: themeTemplateComponent/comments
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    radnik_naziv,
                    foto,
                    foto_mimetype,
                    foto_filename,
                    komentar,
                    to_char(datum, 'DD.MM.YYYY HH24:MI') AS datum
                FROM
                    vw_budzet_stavka_komentari
                WHERE
                    stavka_id = :P510_ID
                ```
        }
        layout {
            sequence: 30
            parentRegion: @komentari-wrapper
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            display: report
        }
        settings {
            commentText: KOMENTAR
            userName: RADNIK_NAZIV
            date: DATUM
            style: chatSpeechBubbles
            applyThemeColors: false
        }
        plugin-avatar {
            type: image
            image: {
                type: blobColumn
                blobColumn: FOTO
                filenameColumn: FOTO_FILENAME
                mimeTypeColumn: FOTO_MIMETYPE
            }
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATUM (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: DATUM
                dataType: varchar2
            }
        )

        column FOTO (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: FOTO
                dataType: blob
            }
        )

        column FOTO_FILENAME (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: FOTO_FILENAME
                dataType: varchar2
            }
        )

        column FOTO_MIMETYPE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: FOTO_MIMETYPE
                dataType: varchar2
            }
        )

        column ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )

        column KOMENTAR (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: KOMENTAR
                dataType: varchar2
            }
        )

        column RADNIK_NAZIV (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: RADNIK_NAZIV
                dataType: varchar2
            }
        )

        action obriši (
            position: actions
            template: link
            label: Obriši
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: javascript:void(null);
                linkAttributes: data-id=&ID.
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1
                    FROM 
                        budzet_stavka_komentari
                    WHERE
                        radnik_id = :APP_RADNIK_ID
                        AND id = :ID
                    ```
            }
        )

    )

    region komentari-wrapper (
        name: Komentari Wrapper
        title: Komentari
        type: staticContent
        layout {
            sequence: 130
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region rds (
        name: RDS
        type: regionDisplaySelector
        layout {
            sequence: 120
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            includeShowAll: false
        }
    )

    pageItem P510_BROJ_MJESECI (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
    )

    pageItem P510_BUDZET_ID (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P510_BUDZET_STATUS_SIFRA (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P510_DELETE_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            slot: contentBody
        }
    )

    pageItem P510_DOKUMENT (
        type: fileUpload
        label {
            label: Dokument
            alignment: left
        }
        display {
            displayAs: blockDropzone
        }
        storage {
            type: appTempFiles
            allowMultipleFiles: true
            maxFileSize: 1024
        }
        layout {
            sequence: 10
            region: @item-wrapper-dokumenti
            slot: item
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P510_GODINA (
        type: hidden
        layout {
            sequence: 80
            slot: contentBody
        }
    )

    pageItem P510_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P510_KOMENTAR (
        type: textarea
        label {
            label: Komentar
            alignment: left
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 10
            region: @item-wrapper-komentar
            slot: item
            alignment: left
        }
        appearance {
            template: @optional-floating
