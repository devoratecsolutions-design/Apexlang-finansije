            width: 30
            height: 3
        }
        validation {
            maxLength: 1000
        }
    )

    pageItem P510_OJ_ID (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    pageItem P510_PERIOD (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P510_STATUS_SIFRA (
        type: hidden
        layout {
            sequence: 90
            slot: contentBody
        }
    )

    pageItem P510_STAVKA_ID (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    button add (
        buttonName: ADD
        label: Komentar
        layout {
            sequence: 10
            region: @item-wrapper-komentar
            slot: buttonEnd
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
            icon: fa-send-o
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: item!=value
            item: P510_BUDZET_STATUS_SIFRA
            value: 70
        }
    )

    button add-dokument (
        buttonName: ADD_DOKUMENT
        label: Dokument
        layout {
            sequence: 10
            region: @item-wrapper-dokumenti
            slot: buttonEnd
        }
        appearance {
            buttonTemplate: @icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
            icon: fa-upload
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item!=value
            item: P510_BUDZET_STATUS_SIFRA
            value: 70
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons-bar
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P510_STATUS_SIFRA
            value: 10
        }
    )

    button edit (
        buttonName: EDIT
        label: Ažuriraj
        layout {
            sequence: 10
            region: @detalji-report
            slot: edit
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 511
                items: {
                    P511_ID: &P510_ID.
                    P511_OJ_ID: &P510_OJ_ID.
                }
                clearCache: 511
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P510_STATUS_SIFRA
            value: 10
        }
    )

    dynamicAction add-komentar (
        name: Add Komentar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @add
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P510_KOMENTAR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    budzet_pkg.insert_budzet_stavka_komentar (
                        p_stavka_id => :P510_ID,
                        p_radnik_id => :APP_RADNIK_ID,
                        p_komentar  => :P510_KOMENTAR
                    );
                    
                    :P510_KOMENTAR := null;
                    ```
                itemsToSubmit: P510_KOMENTAR
                itemsToReturn: P510_KOMENTAR
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @komentari-report
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-dokument (
        name: Delete Dokument
        execution {
            sequence: 50
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .delete-dokument
        }

        action native-confirm (
            action: confirm
            settings {
                message: Da li ste sigurni da želite obrisati dokument? Nakon brisanja nije moguće vratiti obrisani dokument!
                style: danger
                cssClasses: u-color-9
                confirmLabel: Obriši
                cancelLabel: Odustani
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    budzet_pkg.delete_budzet_stavka_dokument (
                        p_id => :P510_DELETE_ID
                    );
                    
                    :P510_DELETE_ID := null;
                    ```
                itemsToSubmit: P510_DELETE_ID
                itemsToReturn: P510_DELETE_ID
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @dokumenti-report
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).data('id')
            }
            affectedElements {
                selectionType: items
                items: P510_DELETE_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-komentar (
        name: Delete Komentar
        execution {
            sequence: 30
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: span.t-Comments-actions
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    budzet_pkg.delete_budzet_stavka_komentar (
                        p_id => :P510_DELETE_ID
                    );
                    
                    :P510_DELETE_ID := null;
                    ```
                itemsToSubmit: P510_DELETE_ID
                itemsToReturn: P510_DELETE_ID
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @komentari-report
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).children().first().data('id')
            }
            affectedElements {
                selectionType: items
                items: P510_DELETE_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refersh (
        name: Dialog Closed - Refersh 1
        execution {
            sequence: 60
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @detalji-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detalji-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation dokument-not-null (
        name: Dokument NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P510_DOKUMENT
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P510_DOKUMENT
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 144822889330024534
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                budzet_pkg.delete_budzet_stavka (
                    p_id => :P510_ID
                );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 144822745216024533
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P510_STAVKA_ID IS NOT null THEN
                    budzet_pkg.get_budzet_stavka (
                        p_budzet_id => :P510_BUDZET_ID,
                        p_stavka_id => :P510_STAVKA_ID,
                        p_period    => :P510_PERIOD,
                        p_id        => :P510_ID,
                        p_oj_id     => :P510_OJ_ID
                    );
                END IF;
                
                
                budzet_pkg.get_budzet (
                    p_id           => :P510_BUDZET_ID,
                    p_broj_mjeseci => :P510_BROJ_MJESECI,
                    p_godina       => :P510_GODINA,
                    p_status_sifra => :P510_BUDZET_STATUS_SIFRA
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
