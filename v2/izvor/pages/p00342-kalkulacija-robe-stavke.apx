    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--xl
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region buttons-bar-save (
        name: Buttons Bar - SAVE
        type: staticContent
        layout {
            sequence: 70
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
    )

    region kuf (
        name: KUF
        title: KUF
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    kk.id,
                    k.klijent_naziv,
                    k.naziv_fakture,
                    k.naziv,
                    k.datum_prijema,
                    k.datum_fakture,
                    k.datum_valute,
                    to_char(k.iznos_bez_pdv, '999G999G999G999G990D00') AS iznos_bez_pdv,
                    to_char(coalesce(kk.rasporedjen_iznos, 0), '999G999G999G999G990D00') AS rasporedjen_iznos,
                    to_char(k.iznos_bez_pdv - coalesce(kk.rasporedjen_iznos, 0), '999G999G999G999G990D00') AS preostalo,
                
                    apex_item.text_from_lov(kk.tip_kalkulacije, 'TIPOVI_KALKULACIJE') AS tip
                FROM 
                    kalkulacija_kuf kk
                    LEFT JOIN vw_kuf k ON kk.kuf_id = k.id
                WHERE
                    kk.kalkulacija_id = :P342_ID
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: tip
        }
        layout {
            sequence: 60
            slot: contentBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: &KLIJENT_NAZIV.
            title: &NAZIV_FAKTURE.
            description: &NAZIV.
            miscellaneous:
                ```html
                <b>Ukupno: </b>&IZNOS_BEZ_PDV.
                <br>
                <b>Raspoređeno: </b>&RASPOREDJEN_IZNOS.
                <br>
                <b>Preostalo: </b>&PREOSTALO.
                ```
        }
        plugin-appearance {
            applyThemeColors: false
            style2: compact
        }
        plugin-grouping {
            title2: &TIP.
        }
        rowSelection {
            type: singleSelection
            currentSelectionPageItem: P342_KUF_ID
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATUM_FAKTURE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: DATUM_FAKTURE
                dataType: date
            }
        )

        column DATUM_PRIJEMA (
