    region kuf-sum (
        name: KUF - Sum
        title: KUF
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    to_char(sum(k.iznos_bez_pdv), '999G999G999G999G990D00') AS iznos_bez_pdv,
                    to_char(sum(coalesce(kk.rasporedjen_iznos, 0)), '999G999G999G999G990D00') AS rasporedjen_iznos,
                    to_char(sum(k.iznos_bez_pdv - coalesce(kk.rasporedjen_iznos, 0)), '999G999G999G999G990D00') AS preostalo
                FROM 
                    kalkulacija_kuf kk
                    LEFT JOIN vw_kuf k ON kk.kuf_id = k.id
                WHERE
                    kk.kalkulacija_id = :P342_ID
                ```
        }
        layout {
            sequence: 80
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            display: report
        }
        settings {
            title: Ukupno KUF
            miscellaneous:
                ```html
                <b>Ukupno: </b>&IZNOS_BEZ_PDV.
                <br>
                <b>Raspoređeno: </b>&RASPOREDJEN_IZNOS.
                <br>
                <b>Preostalo: </b>&PREOSTALO.
                ```
        }
        plugin-appearance {
            applyThemeColors: false
            style2: compact
        }

        column IZNOS_BEZ_PDV (
            layout {
                sequence: 120
            }
            source {
                databaseColumn: IZNOS_BEZ_PDV
                dataType: varchar2
            }
        )

        column PREOSTALO (
