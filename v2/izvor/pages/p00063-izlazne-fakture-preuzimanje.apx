page 63 (
    name: Izlazne fakture / Preuzimanje
    alias: IZLAZNE-FAKTURE-PREUZIMANJE
    title: Izlazne fakture / Preuzimanje
    pageGroup: @fakture-računi
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#jasper-server#MIN#.js
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P63_PATH (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P63_PP (
        type: selectOne
        label {
            label: Poreski period
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @poreski-period-yymm
        }
        layout {
            sequence: 10
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button download (
        buttonName: DOWNLOAD
        label: Preuzmi
        layout {
            sequence: 20
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-download
        }
        behavior {
            action: definedByDynamicAction
        }
        config {
            buildOption: @feature-printing
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction print-elektronski (
        name: Print - Elektronski
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @download
        }
        config {
            buildOption: @feature-printing
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    generate_report(
                        filename = 'kif-' + $v("P63_PP") + '.pdf', 
                        report_path = '/reports/ACCOUNTING/kif' + $v("P63_PATH"), 
                        report_parameters = {
                            OOJ_ID: &APP_OOJ_ID.,
                            POTPIS: "N",
                            PP: $v("P63_PP")
                        },
                        new_tab = false
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            config {
                buildOption: @feature-printing
            }
        )

    )

    computation p63-path (
        itemName: P63_PATH
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    obrazac_fakture_path
                FROM
                    core.vw_firme
                WHERE
                    id = :APP_FIRMA_ID
                ```
        }
    )

)

