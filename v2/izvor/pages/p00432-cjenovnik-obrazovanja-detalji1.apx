            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region cjenovnik-obrazovanja-detalji (
        name: Cjenovnik obrazovanja / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P432_CIJENA_SATA (
        type: numberField
        label {
            label: Cijena sata
            alignment: left
        }
        layout {
            sequence: 60
            region: @cjenovnik-obrazovanja-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P432_ID (
        type: hidden
        layout {
            sequence: 10
            region: @cjenovnik-obrazovanja-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P432_OBRAZOVANJE_ID (
        type: selectOne
        label {
            label: Obrazovanje
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @hr-obrazovanje
        }
        layout {
            sequence: 50
            region: @cjenovnik-obrazovanja-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
