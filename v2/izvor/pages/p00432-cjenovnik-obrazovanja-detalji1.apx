                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 151292826598365823
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P432_ID
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hrm.evidencija_pkg.insert_obrazovanje_cijena (
                    p_ooj_id         => :APP_OOJ_ID,
                    p_oj_id          => :P432_OJ_ID,
                    p_obrazovanje_id => :P432_OBRAZOVANJE_ID,
                    p_cijena_sata    => to_number(:P432_CIJENA_SATA, '999G999G999G999G990D00')
                );
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 151293292888365824
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                hrm.evidencija_pkg.update_obrazovanje_cijena (
                    p_id             => :P432_ID,
                    p_ooj_id         => :APP_OOJ_ID,
                    p_oj_id          => :P432_OJ_ID,
                    p_obrazovanje_id => :P432_OBRAZOVANJE_ID,
                    p_cijena_sata    => to_number(:P432_CIJENA_SATA, '999G999G999G999G990D00')
                );
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 151293664759365824
