    process avansne-fakture (
        name: Avansne fakture
        type: executeCode
        executionChain: @insert-update-konta
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR c_sabloni_konta IS (
                        SELECT
                            seq_id,
                            c001 as id,
                            c002 as automatsko_knjizenje_id,
                            c003 as automatsko_knjizenje_naziv,
                            c004 as kontna_klasa_id
                        FROM
                            apex_collections
                        WHERE
                            collection_name = 'SABLONI_KONTA_AV'
                    );
                BEGIN
                    FOR c1 IN c_sabloni_konta LOOP
                        IF c1.id IS null THEN
                            sabloni_pkg.insert_sablon_konto (
                                p_sablon_id               => :P120_ID,
                                p_automatsko_knjizenje_id => c1.automatsko_knjizenje_id,
                                p_kontna_klasa_id         => c1.kontna_klasa_id
                            );
                        ELSE
                            sabloni_pkg.update_sablon_konto (
                                p_id                      => c1.id,
                                p_sablon_id               => :P120_ID,
                                p_automatsko_knjizenje_id => c1.automatsko_knjizenje_id,
                                p_kontna_klasa_id         => c1.kontna_klasa_id
                            );
                        END IF;
                    END LOOP;
                END;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 156102144244662422
        }
    )

    process avansne-fakture-ig (
        name: Avansne fakture - IG
        type: executeCode
        executionChain: @update-collection
        editableRegion: @avansne-fakture
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN -- CREATE
                    apex_collection.add_member (
                        p_collection_name => 'SABLONI_KONTA_AV',
                        p_c001            => null,
                        p_c002            => :AUTOMATSKO_KNJIZENJE_ID,
                        p_c003            => :AUTOMATSKO_KNJIZENJE_NAZIV,
                        p_c004            => :KONTNA_KLASA_ID
                    );
                
                ELSIF :APEX$ROW_STATUS = 'U' THEN -- UPDATE
                    apex_collection.update_member (
                        p_collection_name => 'SABLONI_KONTA_AV',
                        p_seq             => :SEQ_ID,
                        p_c001            => :ID,
                        p_c002            => :AUTOMATSKO_KNJIZENJE_ID,
                        p_c003            => :AUTOMATSKO_KNJIZENJE_NAZIV,
                        p_c004            => :KONTNA_KLASA_ID
                    );
                END IF;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 155856280693435345
        }
        serverSideCondition {
            executionScope: allSubmittedRows
        }
    )

