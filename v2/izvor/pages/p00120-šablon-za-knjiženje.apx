    process copy-basic (
        name: Copy basic
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_id NUMBER;
                BEGIN
                    l_id := sabloni_pkg.get_basic_sablon_id;
                apex_debug.message('copy basic');
                
                    sabloni_pkg.get_sablon (
                        p_id           => l_id,
                        p_ooj_id       => :P120_OOJ_ID,
                        p_naziv        => :P120_NAZIV,
                        p_opis         => :P120_OPIS,
                        p_subscribe_id => :P120_SUBSCRIBE_ID,
                        p_valid        => :P120_VALID
                    );
                
                    :P120_SUBSCRIBE_ID := l_id;
                
                    IF apex_collection.collection_exists ('SABLONI_KONTA_IF') THEN
                        apex_collection.delete_collection(
                            p_collection_name => 'SABLONI_KONTA_IF'
                        );
                    END IF;
                
                    IF apex_collection.collection_exists ('SABLONI_KONTA_AV') THEN
                        apex_collection.delete_collection(
                            p_collection_name => 'SABLONI_KONTA_AV'
                        );
                    END IF;
                
                    apex_collection.create_collection_from_query (
                        p_collection_name => 'SABLONI_KONTA_IF',
                        p_query           => '
                            SELECT
                                null,
                                automatsko_knjizenje_id,
                                automatsko_knjizenje_naziv,
                                kontna_klasa_id
                            FROM
                                vw_sabloni_konta
                            WHERE
                                sablon_id = ' || l_id || '
                                AND lower(vrsta_naloga_sifra) = ''if''
                    ');
                
                    apex_collection.create_collection_from_query (
                        p_collection_name => 'SABLONI_KONTA_AV',
                        p_query           => '
                            SELECT
                                null,
                                automatsko_knjizenje_id,
                                automatsko_knjizenje_naziv,
                                kontna_klasa_id
                            FROM
                                vw_sabloni_konta
                            WHERE
                                sablon_id = ' || l_id || '
                                AND lower(vrsta_naloga_sifra) = ''av''
                    ');
                END;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 157491633347763006
        }
        serverSideCondition {
            type: request=Value
            value: copy_basic
        }
    )

