    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sabloni_pkg.get_sablon (
                    p_id           => :P120_ID,
                    p_ooj_id       => :P120_OOJ_ID,
                    p_naziv        => :P120_NAZIV,
                    p_opis         => :P120_OPIS,
                    p_subscribe_id => :P120_SUBSCRIBE_ID,
                    p_valid        => :P120_VALID
                );
                apex_debug.message('dbg get data');
                
                IF apex_collection.collection_exists ('SABLONI_KONTA_IF') THEN
                    apex_collection.delete_collection(
                        p_collection_name => 'SABLONI_KONTA_IF'
                    );
                END IF;
                
                IF apex_collection.collection_exists ('SABLONI_KONTA_AV') THEN
                    apex_collection.delete_collection(
                        p_collection_name => 'SABLONI_KONTA_AV'
                    );
                END IF;
                
                apex_collection.create_collection_from_query (
                    p_collection_name => 'SABLONI_KONTA_IF',
                    p_query           => '
                        SELECT
                            id,
                            automatsko_knjizenje_id,
                            automatsko_knjizenje_naziv,
                            kontna_klasa_id
                        FROM
                            vw_sabloni_konta
                        WHERE
                            sablon_id = ' || :P120_ID || '
                            AND lower(vrsta_naloga_sifra) = ''if''
                ');
                
                apex_collection.create_collection_from_query (
