page 123 (
    name: Potpisi
    alias: POTPISI
    title: Potpisi
    pageGroup: @konfiguracija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @finansije-konfiguracija
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Sekcija <b><em>"Potpisi"</em></b> namijenjena je administrativnom unosu i upravljanju elektronskim 
            potpisima korisnika. </br>
            </br>
            Potpisi se koriste kao sastavni dio različitih dokumenata i procesa unutar sistema, 
            čime se obezbjeđuje dodatna identifikacija i formalna potvrda unosa. </br>
            Dodavanje potpisa odvija se kroz jednostavnu proceduru:</br> 
            klikom na dugme <b><em>"Novi unos"</em></b> 
            otvara se forma u kojoj je potrebno izabrati korisnika iz ponuđene liste, 
            nakon čega se dodaje njegov elektronski potpis.
            ```
    }

    region potpisi (
        name: Potpisi
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    null as list_title,
                    null as list_text,
                    null as list_badge,
                
                    korisnicko_ime,
                    korisnik_naziv,
                
                    apex_page.get_url(
                        p_page   => 124,
                        p_items  => 'P124_KORISNIK_ID',
                        p_values => id
                    ) as link,
                    case 
                        when valid = 'Y' then
                            'u-color-5'
                        else
                            'u-color-9'
                    end as icon_color_class,
                    'fa fa-signature' as icon_class
                
                FROM
                    core.vw_korisnici
                WHERE
                    firma_id = :APP_FIRMA_ID
                    AND email_potpis IS NOT null
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: [
                fin-list
                fin-list--media
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--stack
                t-MediaList--iconsRounded
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column ICON_CLASS (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Icon Class
            }
            layout {
                sequence: 90
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Icon Color Class
            }
            layout {
                sequence: 80
            }
        )

        column KORISNICKO_IME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Korisnicko Ime
            }
            layout {
                sequence: 40
            }
        )

        column KORISNIK_NAZIV (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Korisnik Naziv
            }
            layout {
                sequence: 50
            }
        )

        column LINK (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Link
            }
            layout {
                sequence: 70
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: List Badge
            }
            layout {
                sequence: 30
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: List Text
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: #KORISNICKO_IME#
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: List Title
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: #KORISNIK_NAZIV#
            }
        )

    )

    region potpisi-2 (
        name: Potpisi
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region pretraga (
        name: Pretraga
        type: smartFilters
        source {
            filteredRegion: @potpisi
        }
        layout {
            sequence: 9
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P123_SEARCH (
            type: search
            label {
                label: Pretraga
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 10
            region: @potpisi-2
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 124
                clearCache: 124
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 2
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @potpisi
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-2 (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @potpisi
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @potpisi
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

