page 370 (
    name: Izvještaji
    alias: IZVJEŠTAJI-RM
    title: Izvještaji
    pageGroup: @robno-materijalno
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @robno-materijalno-izvještaji
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region izvještaji (
        name: Izvještaji
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region menu (
        name: Menu
        type: list
        source {
            list: @menu-robno-materijalno-izvještaji
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--cols
                t-Cards--hideBody
                t-Cards--iconsRounded
                t-Cards--animColorFill
            ]
        }
    )

)

