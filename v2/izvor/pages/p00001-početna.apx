        serverSideCondition {
            type: itemIsNotNull
            item: APP_KASA_ID
        }
    )

    computation p1-kasa-naziv (
        itemName: P1_KASA_NAZIV
        execution {
            sequence: 10
        }
        computation {
            type: functionBody
            plsqlFunctionBody: RETURN sec_pkg.get_kasa_naziv(:APP_KASA_ID);
        }
    )

    process read-all-notification (
        name: Read all Notification
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.notifikacije_pkg.read_all_notification (
                    p_user_id => :APP_USER_ID
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 385778331198770742
        }
        serverSideCondition {
            type: request=Value
            value: readAllNotification
        }
    )

    process set-year (
        name: Set Year
        type: executeCode
        source {
            plsqlCode: null;
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        successMessage {
            successMessage: Uspješno ste promijenili poslovnu godinu.
        }
        advanced {
            executionMappingIdentifier: 101098386008362002
        }
        serverSideCondition {
            type: request=Value
