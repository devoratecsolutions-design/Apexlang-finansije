page 1 (
    name: Početna
    alias: POČETNA
    title: Početna
    pageGroup: @erp-globalne-stranice
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region menu-godine (
        name: Menu - Godine
        type: list
        source {
            list: @menu-godine
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: godine
        }
        serverSideCondition {
            type: itemIsNotNull
            item: APP_OOJ_ID
        }
        componentAppearance {
            listTemplate: @menu-popup
            templateOptions: [
                #DEFAULT#
                js-addActions
            ]
        }
    )

    region menu-kase (
        name: Menu - Kase
        type: list
        source {
            list: @menu-kase
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: kase
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT
                    1
                FROM
                    sec_kase
                WHERE
                    valid = 'Y'
                    AND ooj_id = :APP_OOJ_ID
                ```
        }
        componentAppearance {
            listTemplate: @menu-popup
            templateOptions: [
                #DEFAULT#
                js-addActions
            ]
        }
    )

    region navigation-menu-početna (
        name: Navigation Menu - Početna
        title: Brzi pristup
        type: list
        source {
            list: @navigation-menu-početna
        }
        layout {
            sequence: 200
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
            cssClasses: fin-modules
        }
        componentAppearance {
            listTemplate: @cards
            templateOptions: [
                #DEFAULT#
                t-Cards--compact
                t-Cards--displayIcons
                t-Cards--spanHorizontally
                t-Cards--hideBody
                t-Cards--iconsRounded
                t-Cards--animColorFill
            ]
        }
    )

    region obavjestenje (
        name: Obavjestenje
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                RETURN hrm.ankete_pkg.get_obavjestenje_html (
                    p_ooj_id => :APP_OOJ_ID
                );
                ```
        }
        layout {
            sequence: 30
            slot: banner
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region početna (
        name: Početna
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region pokazatelji (
        name: Pregled poslovanja
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                RETURN dashboard_pkg.kpi_pocetna(:APP_OOJ_ID, :APP_GODINA);
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region promet-po-mjesecima (
        name: Izlazne i ulazne fakture po mjesecima (sa PDV)
        type: chart
        layout {
            sequence: 110
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: fin-panel
        }
        chartLayout {
            height: 280
        }
        messages {
            whenNoDataFound: Nema podataka za izabrani period.
        }

        series kif (
            name: Izlazne fakture
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH m AS (
                        SELECT level AS mj FROM dual CONNECT BY level <= 12
                    )
                    SELECT
                        substr('JanFebMarAprMajJunJulAvgSepOktNovDec', (m.mj - 1) * 3 + 1, 3) AS mjesec,
                        coalesce(sum(k.iznos), 0) AS vrijednost
                    FROM
                        m
                        LEFT JOIN vw_dash_kif k
                            ON  k.ooj_id = :APP_OOJ_ID
                            AND k.godina = :APP_GODINA
                            AND extract(month FROM k.datum_fakture) = m.mj
                            AND k.je_predracun = 'N'
                    GROUP BY
                        m.mj
                    ORDER BY
                        m.mj
                    ```
            }
            columnMapping {
                label: MJESEC
                value: VRIJEDNOST
            }
            appearance {
                color: #2271b1
            }
        )

        series kuf (
            name: Ulazne fakture
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH m AS (
                        SELECT level AS mj FROM dual CONNECT BY level <= 12
                    )
                    SELECT
                        substr('JanFebMarAprMajJunJulAvgSepOktNovDec', (m.mj - 1) * 3 + 1, 3) AS mjesec,
                        coalesce(sum(k.iznos), 0) AS vrijednost
                    FROM
                        m
                        LEFT JOIN vw_dash_kuf k
                            ON  k.ooj_id = :APP_OOJ_ID
                            AND k.godina = :APP_GODINA
                            AND extract(month FROM k.datum_fakture) = m.mj
                    GROUP BY
                        m.mj
                    ORDER BY
                        m.mj
                    ```
            }
            columnMapping {
                label: MJESEC
                value: VRIJEDNOST
            }
            appearance {
                color: #9aa7b6
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            minorTicks {
                show: false
            }
        )

    )

    region starost-potraživanja (
        name: Starost potraživanja
        type: chart
        layout {
            sequence: 120
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: fin-panel
        }
        chartLayout {
            height: 280
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: Nema podataka za izabrani period.
        }

        series potrazivanja (
            name: Otvoreno
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        b.kategorija,
                        coalesce(sum(d.otvoreno), 0) AS iznos
                    FROM
                        (
                            SELECT 1 AS rb, 'Nije dospjelo' AS kategorija FROM dual UNION ALL
                            SELECT 2, '1-30 dana'  FROM dual UNION ALL
                            SELECT 3, '31-60 dana' FROM dual UNION ALL
                            SELECT 4, '61-90 dana' FROM dual UNION ALL
                            SELECT 5, 'Preko 90'   FROM dual
                        ) b
                        LEFT JOIN (
                            SELECT
                                CASE
                                    WHEN datum_valute IS NULL OR datum_valute >= trunc(sysdate) THEN 1
                                    WHEN trunc(sysdate) - datum_valute <= 30 THEN 2
                                    WHEN trunc(sysdate) - datum_valute <= 60 THEN 3
                                    WHEN trunc(sysdate) - datum_valute <= 90 THEN 4
                                    ELSE 5
                                END AS rb,
                                otvoreno
                            FROM
                                vw_dash_kif
                            WHERE
                                ooj_id = :APP_OOJ_ID
                                AND otvoreno > 0
                                AND je_predracun = 'N'
                        ) d ON d.rb = b.rb
                    GROUP BY
                        b.rb,
                        b.kategorija
                    ORDER BY
                        b.rb
                    ```
            }
            columnMapping {
                label: KATEGORIJA
                value: IZNOS
            }
            appearance {
                color: #c98a12
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            minorTicks {
                show: false
            }
        )

    )

