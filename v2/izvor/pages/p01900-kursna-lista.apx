page 1900 (
    name: Kursna lista
    alias: KURSNA-LISTA
    title: Kursna lista
    pageGroup: @konfiguracija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#jasper-server#MIN#.js
    }
    security {
        authorizationScheme: @glavna-knjiga-nalozi
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    help {
        helpText:
            ```html
            Sekcija <b><em>"Žiro računi"</em></b> predstavlja ključni dio konfiguracije finansijskog modula, 
            jer omogućava analitičko prećanje bankovnih izvoda. </br>
            U zavisnosti od tipa korisnika omogućeno je i odgovarajuće knjiženje izvoda u Glavnu knjigu.
            
            </br>
            
            Klikom na dugme <b><em>"Novi unos"</em></b> otvara se modalni dijalog u kojem je potrebno:
            <ul>
                <li>Odabrati banku iz padajućeg menija (lista registrovanih poslovnih banaka),</li>
                <li>Unijeti šifru račun radi lakšeg praćenja izvoda po računu</li>
                <li>Unijeti valutu u kojoj je otvoren račun</li>
                <li>Opciono unijeti opis namjene žiro računa</li>
                <li>Unijeti žiro račun banke</li>
                <li>Definisati konto (ako se koristi dvojno knjigovodstvo) računa– najčešće je to konto 241xxx</li>
                <li>Definisati vrstu naloga Glavne knjige preko kojeg se vrši knjiženje izvoda (ako se koristi dvojno knjigovodstvo)</li>
                <li>Potvrditi unos klikom na dugme Kreiraj.</li>
            </ul>
            ```
    }

    region kursna-lista (
        name: Kursna lista
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 90
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region master-records (
        name: Master  Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                
                    k.*,
                    apex_page.get_url(
                        p_page   => 1901,
                        p_items  => 'P1901_ID',
                        p_values => id
                    ) as pregled
                
                FROM
                    sif.vw_acc_valuta_kursevi k
                
                WHERE
                    ooj_id = :APP_OOJ_ID
                ORDER BY
                    datum desc
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: [
                search-results
                fin-list
            ]
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlightOff
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">Nema pronađenih podataka.</div>
        }

        column DATUM (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Datum kursa
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 90
            }
        )

        column KURS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Kurs
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D000000
            }
            sorting {
                sortable: false
            }
        )

        column NAZIV (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Naziv valute
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column OOJ_ID (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

        column PREGLED (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                heading: Pregled
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: #PREGLED#
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column VALUTA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Valuta
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column VALUTA_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

    )

    region search (
        name: Search
        type: smartFilters
        source {
            filteredRegion: @master-records
        }
        layout {
            sequence: 19
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P1900_SEARCH (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 20
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

        filter P1900_VALUTA_ID (
            type: radioGroup
            label {
                label: Aktivno
            }
            lov {
                type: sharedComponent
                lov: @sif-valute
            }
            layout {
                sequence: 40
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: VALUTA_ID
                dataType: number
            }
        )

    )

    pageItem P1900_PRINT_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 20
            slot: NEXT
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 202
                clearCache: 202
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create-bank (
        buttonName: CREATE_BANK
        label: Novi unos
        layout {
            sequence: 10
            slot: NEXT
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1002
                items: {
                    P1002_ID:
                }
                clearCache: 122
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create-kurs (
        buttonName: CREATE_KURS
        label: Novi unos
        layout {
            sequence: 10
            region: @kursna-lista
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1901
                items: {
                    P1901_ID:
                }
                clearCache: 122
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-data-create (
        name: Refresh data - create
        execution {
            sequence: 80
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create-kurs
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-data-update (
        name: Refresh data - update
        execution {
            sequence: 70
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @master-records
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

