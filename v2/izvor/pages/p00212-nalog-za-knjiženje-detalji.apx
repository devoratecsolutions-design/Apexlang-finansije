    region stavke-fakture (
        name: Stavke fakture
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    valuta_naziv,
                    stavka_naziv,
                    jm_naziv,
                    kolicina,
                    cijena_char,
                    cijena_pdv_char,
                    rabat,
                    pdv,
                    iznos_char,
                    iznos_pdv_char,
                    pdv_indikator_sifra,
                    pdv_indikator_naziv
                FROM 
                    vw_kif_stavke
                WHERE
                    kif_id IN (
                        SELECT 
                            id 
                        FROM 
                            kif 
                        WHERE
                            glavna_knjiga_id = :P212_GLAVNA_KNJIGA_ID
                    )
