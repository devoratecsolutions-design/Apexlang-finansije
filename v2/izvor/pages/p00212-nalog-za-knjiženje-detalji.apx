    region stavke-naloga-report (
        name: Stavke naloga Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    redni_broj,
                	glavna_knjiga_id,
                  	kontna_klasa_id,
                    iznos,
                    tip_stavke,
                    opis,
                    klijent_id,
                    grad_id,
                    osnovno_sredstvo_id,
                    transakcija_id,
                    pdv_indikator_sifra || ' - ' || pdv_indikator_naziv AS pdv_indikator_naziv,
                    oj_id,
                    radnik_id
                FROM
                    vw_glavna_knjiga_stavke
                WHERE
                    glavna_knjiga_id = :P212_GLAVNA_KNJIGA_ID
                ORDER BY
                    redni_broj ASC
                ```
            pageItemsToSubmit: P212_ID
        }
        layout {
            sequence: 60
            parentRegion: @stavke-naloga
            slot: regionBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
            cssClasses: js-detail-region
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column GLAVNA_KNJIGA_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column GRAD_ID (
            reportColumnQueryId: 9
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Grad
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        lpad(sifra, 3, '0') as d,
                        id as r
                    FROM
                        sif.sif_gradovi
                    WHERE
                        (
                            :KLIJENT_ID IS NOT NULL 
                            AND drzava_id = (
                                SELECT drzava_id
                                FROM sec_klijenti k
                                WHERE k.id = :KLIJENT_ID
                            )
                        ) OR (
                            :KLIJENT_ID IS NULL 
                            AND drzava_id = 28
                        )
                    ```
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
        )

