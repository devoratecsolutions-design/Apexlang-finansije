page 212 (
    name: Nalog za knjiženje / Detalji
    alias: NALOG-ZA-KNJIŽENJE-DETALJI
    title: Nalog za knjiženje / Detalji
    pageGroup: @glavna-knjiga
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--xl
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region dodatne-informacije (
        name: Dodatne informacije
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT    
                    tip_placanja_naziv,
                    fiskalni_racun_broj,
                    uio_tip_dokumenta_code,
                    uio_tip_dokumenta_naziv,
                    system,
                    stornirano,
                    storniran_naziv,
                    vrsta_fakture_naziv,
                    vrsta_naloga_naziv
                FROM
                    vw_kif
                WHERE
                    glavna_knjiga_id = :P212_GLAVNA_KNJIGA_ID
                ```
            pageItemsToSubmit: P212_GLAVNA_KNJIGA_ID
        }
        layout {
            sequence: 30
            parentRegion: @faktura
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-Report--hideNoPagination
            ]
        }

        column FISKALNI_RACUN_BROJ (
            reportColumnQueryId: 2
