            }
            lov {
                type: sharedComponent
                lov: @sec-stavke-robe
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

    )

    region tabs (
        name: Tabs
        type: staticContent
        layout {
            sequence: 70
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @tabs-container
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                t-TabsRegion-mod--fillLabels
                t-TabsRegion-mod--pill
                t-TabsRegion-mod--large
            ]
        }
    )

    pageItem P322_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P322_ODOBRAVANJE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P322_REALIZACIJA (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P322_STATUS_SIFRA (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    button odbij (
        buttonName: ODBIJ
        label: Odbij
        layout {
            sequence: 10
            region: @buttons-bar
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
            cssClasses: u-color-9
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P322_STATUS_SIFRA = 'NEW'
        }
    )

    button odobri (
        buttonName: ODOBRI
        label: Odobri
        layout {
            sequence: 20
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
            cssClasses: u-color-5
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P322_STATUS_SIFRA = 'NEW'
        }
    )

    button realizuj (
        buttonName: REALIZUJ
        label: Realizuj
        layout {
            sequence: 10
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
            cssClasses: u-color-5
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P322_STATUS_SIFRA = 'ACCEPTED'
        }
    )

    computation p322-status-sifra (
        itemName: P322_STATUS_SIFRA
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    status_sifra
                FROM
                    vw_trebovanja
                WHERE
                    id = :P322_ID
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 189671101008493542
        }
    )

    process odbij (
        name: Odbij
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                skladista_pkg.update_trebovanje_odbij (
                    p_id          => :P322_ID,
                    p_radnik_id   => :APP_RADNIK_ID,
                    p_korisnik_id => :APP_USER_ID
                );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 189670501203493536
        }
        serverSideCondition {
            whenButtonPressed: @odbij
        }
    )

    process odobri (
        name: Odobri
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                skladista_pkg.update_trebovanje_odobri (
                    p_id          => :P322_ID,
                    p_radnik_id   => :APP_RADNIK_ID,
                    p_korisnik_id => :APP_USER_ID
                );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 189670408712493535
        }
        serverSideCondition {
            whenButtonPressed: @odobri
        }
    )

    process realizuj (
        name: Realizuj
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                skladista_pkg.update_trebovanje_realizuj (
                    p_id          => :P322_ID,
                    p_radnik_id   => :APP_RADNIK_ID,
                    p_korisnik_id => :APP_USER_ID
                );
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 189671008884493541
        }
        serverSideCondition {
            whenButtonPressed: @realizuj
        }
    )

)

