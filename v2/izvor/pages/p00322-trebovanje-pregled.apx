            type: plainTextBasedOnLov
            heading {
                heading: Skladište
            }
            lov {
                type: sharedComponent
                lov: @skladista
            }
            layout {
                sequence: 13
            }
            sorting {
                defaultSequence: 1
            }
        )

        column SKLADISTE_PRENOS_ID (
            reportColumnQueryId: 13
