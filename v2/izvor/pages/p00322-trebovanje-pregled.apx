page 322 (
    name: Trebovanje / Pregled
    alias: TREBOVANJE-PREGLED
    title: Trebovanje / Pregled
    pageGroup: @robno-materijalno
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--xl
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 60
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P322_ODOBRAVANJE = 'Y' OR :P322_REALIZACIJA = 'Y'
        }
    )

    region istorija (
        name: Istorija
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    korisnik_naziv,
                    status_naziv,
                    status_color_code,
                    datum
                FROM
                    vw_trebovanje_history
                WHERE
                    trebovanje_id = :P322_ID
                ORDER BY
                    datum DESC
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATUM (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 40
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column KORISNIK_NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Korisnik
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column STATUS_COLOR_CODE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column STATUS_NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="t-Button #STATUS_COLOR_CODE# t-Button--small">
                        <span class="t-Button-label">#STATUS_NAZIV#</span>
                    </span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

    )

    region osnovne-infomracije (
        name: Osnovne infomracije
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    tip_kretanja_id,
                    osnovno_sredstvo_id,
                    radni_nalog_id,
                    oj_id,
                    naziv,
                    godina,
                    datum,
                    opis,
                    faktura_id,
                    zakljucano,
                    veza_id,
                    skladiste_prenos_id,
                    klijent_id,
                    ugovor_id,
                    radnik_id,
                    primio_radnik_id,
                    odobrio_radnik_id,
                    status_id,
                    status_naziv,
                    status_color_code,
                    skladiste_id
                FROM
                    vw_trebovanja
                WHERE
                    id = :P322_ID
                ```
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-item--stacked
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATUM (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 73
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI
            }
        )

        column FAKTURA_ID (
            reportColumnQueryId: 10
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Faktura
            }
            lov {
                type: sharedComponent
                lov: @kif-naziv-fakture
            }
            layout {
                sequence: 103
            }
            sorting {
                defaultSequence: 1
            }
        )

        column GODINA (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Godina
                alignment: end
            }
            layout {
                sequence: 63
                columnAlignment: end
            }
        )

