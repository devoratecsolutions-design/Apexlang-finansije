page 501 (
    name: Budžetske stavke
    alias: BUDŽETSKE-STAVKE
    title: Budžetske stavke
    pageGroup: @budžet
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region budzetske-stavke-report (
        name: Budzetske stavke Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    lpad(naziv, length(naziv) + (level - 1) * 4, '.') AS naziv,
                    oj_id,
                    oj_naziv
                
                
                FROM
                    vw_budzetske_stavke
                WHERE
                    ooj_id = :APP_OOJ_ID
                START WITH
                    stavka_id IS null
                CONNECT BY
                    PRIOR id = stavka_id
                ORDER SIBLINGS BY
                    stavka_id
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 502
                    items: {
                        P502_ID: #ID#
                    }
                    clearCache: 502
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Naziv
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column OJ_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column OJ_NAZIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Organizaciona jedinica
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

    )

    region budžetske-stavke (
        name: Budžetske stavke
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region search (
        name: Search
        type: smartFilters
        source {
            filteredRegion: @budzetske-stavke-report
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P501_OJ_ID (
            type: checkboxGroup
            label {
                label: Organizaciona jedinica
            }
            lov {
                type: sharedComponent
                lov: @oj
            }
            layout {
                sequence: 20
            }
            listEntries {
                sortByTopCounts: false
            }
            source {
                databaseColumn: OJ_ID
            }
        )

        filter P501_SEARCH (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 10
            region: @budžetske-stavke
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 502
                clearCache: 502
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @budzetske-stavke-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh-2 (
        name: Dialog Closed - Refresh 2
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @budzetske-stavke-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @budzetske-stavke-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

