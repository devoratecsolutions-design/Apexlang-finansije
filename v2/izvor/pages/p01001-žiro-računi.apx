page 1001 (
    name: Žiro računi
    alias: ŽIRO-RAČUNI
    title: Žiro računi
    pageGroup: @konfiguracija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#jasper-server#MIN#.js
    }
    security {
        authorizationScheme: @glavna-knjiga-nalozi
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    help {
        helpText:
            ```html
            Sekcija <b><em>"Žiro računi"</em></b> predstavlja ključni dio konfiguracije finansijskog modula, 
            jer omogućava analitičko prećanje bankovnih izvoda. </br>
            U zavisnosti od tipa korisnika omogućeno je i odgovarajuće knjiženje izvoda u Glavnu knjigu.
            
            </br>
            
            Klikom na dugme <b><em>"Novi unos"</em></b> otvara se modalni dijalog u kojem je potrebno:
            <ul>
                <li>Odabrati banku iz padajućeg menija (lista registrovanih poslovnih banaka),</li>
                <li>Unijeti šifru račun radi lakšeg praćenja izvoda po računu</li>
                <li>Unijeti valutu u kojoj je otvoren račun</li>
                <li>Opciono unijeti opis namjene žiro računa</li>
                <li>Unijeti žiro račun banke</li>
                <li>Definisati konto (ako se koristi dvojno knjigovodstvo) računa– najčešće je to konto 241xxx</li>
                <li>Definisati vrstu naloga Glavne knjige preko kojeg se vrši knjiženje izvoda (ako se koristi dvojno knjigovodstvo)</li>
                <li>Potvrditi unos klikom na dugme Kreiraj.</li>
            </ul>
            ```
    }

    region master-records (
        name: Master  Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                
                    banka_naziv,
                    valuta,
                    ziro_racun,
                    sifra_racuna,
                    opis, 
                    kontna_klasa_code,
                    kontna_klasa_naziv,
                
                    apex_page.get_url(
                        p_page   => 1002,
                        p_items  => 'P1002_ID',
                        p_values => id
                    ) as pregled,
                     
                    valid as aktivan, 
                    banka_id
                    
                
                
                FROM
                    core.vw_ooj_ziro_racuni
                
                
                WHERE
                    ooj_id = :APP_OOJ_ID
                ORDER BY
                    id ASC
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: [
                search-results
                fin-list
            ]
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlightOff
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">Nema pronađenih podataka.</div>
        }

        column AKTIVAN (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 100
            }
        )

        column BANKA_ID (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 110
            }
        )

        column BANKA_NAZIV (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Banka Naziv
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column KONTNA_KLASA_CODE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Konto
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: itemIsNotInColonDelimitedList
                item: APP_TIP_PREDUZETNIKA_SIFRA
                list: [
                    msp
                    vsp_prosto
                ]
            }
        )

        column KONTNA_KLASA_NAZIV (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Naziv konta
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: itemIsNotInColonDelimitedList
                item: APP_TIP_PREDUZETNIKA_SIFRA
                list: [
                    msp
                    vsp_prosto
                ]
            }
        )

        column OPIS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Opis
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column PREGLED (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                heading: Pregled
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: #PREGLED#
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
        )

        column SIFRA_RACUNA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Šifra
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column VALUTA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Valuta
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column ZIRO_RACUN (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Broj računa
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

    )

    region search (
        name: Search
        type: smartFilters
        source {
            filteredRegion: @master-records
        }
        layout {
            sequence: 19
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P1001_AKTIVAN (
            type: radioGroup
            label {
                label: Aktivno
            }
            lov {
                type: sharedComponent
                lov: @da-ne
            }
            layout {
                sequence: 40
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: AKTIVAN
            }
        )

        filter P1001_BANKA_ID (
            type: radioGroup
            label {
                label: Banka
            }
            lov {
                type: sharedComponent
                lov: @sif-banke
            }
            layout {
                sequence: 50
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: BANKA_ID
            }
        )

        filter P1001_SEARCH (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 20
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

    )

    region žiro-računi (
        name: Žiro računi
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 90
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1001_PRINT_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    button create (
        buttonName: CREATE
        label: Novi unos
        layout {
            sequence: 20
            slot: NEXT
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 202
                clearCache: 202
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create-bank (
        buttonName: CREATE_BANK
        label: Novi unos
        layout {
            sequence: 10
            region: @žiro-računi
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1002
                items: {
                    P1002_ID:
                }
                clearCache: 122
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-data-create (
        name: Refresh data - create
        execution {
            sequence: 80
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create-bank
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-data-update (
        name: Refresh data - update
        execution {
            sequence: 70
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @master-records
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

