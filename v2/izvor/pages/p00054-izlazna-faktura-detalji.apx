    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 10
            region: @buttons-bar
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: "Da li ste sigurni da želite obrisati fakturu? "
            style: danger
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_max_broj        NUMBER;
                    l_broj            NUMBER;
                    l_vrsta_naloga_id NUMBER;
                    l_godina          NUMBER;
                BEGIN
                    SELECT faktura_broj, vrsta_naloga_id, godina
                    INTO l_broj, l_vrsta_naloga_id, l_godina
                    FROM vw_kif
                    WHERE
                        id = :P54_ID;
                
                    SELECT max(faktura_broj)
                    INTO l_max_broj
                    FROM vw_kif
                    WHERE 
                        ooj_id = :APP_OOJ_ID
                        AND godina = l_godina
                        AND vrsta_naloga_id = l_vrsta_naloga_id;
                
                    apex_debug.message('l_godina ' || l_godina);
                    apex_debug.message('l_vrsta_naloga_id ' || l_vrsta_naloga_id);
                    apex_debug.message('l_broj ' || l_broj);
                    apex_debug.message('l_max_broj ' || l_max_broj);
                
                    IF l_max_broj != l_broj THEN
                        RETURN false;
                    END IF;
                
                    IF finansije_pkg.is_kif_editable(:P54_ID) = true THEN
                        RETURN true;
                    END IF;
                
                    RETURN false;
                
                END;
                ```
        }
    )

