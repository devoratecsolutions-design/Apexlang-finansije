    region potrebna-konfiguracija (
        name: Potrebna konfiguracija
        type: staticContent
        source {
            htmlCode: Neophodno je da izaberete šablon fakture da biste mogli štampati fakturu.
        }
        layout {
            sequence: 170
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody: return not core.firma_pkg.check_firma_obrazac(:APP_FIRMA_ID);
        }
    )

