    validation kurs-not-null (
        name: Kurs not null
        execution {
            sequence: 90
        }
        validation {
            type: itemIsNotNull
            item: P54_KURS
        }
        error {
            errorMessage: Za izbaranu valutu na datum fakture ne postoji definisan valutni kurs.
            associatedItem: @P54_KURS
        }
        serverSideCondition {
            whenButtonPressed: @edit
        }
    )

