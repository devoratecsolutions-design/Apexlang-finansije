page 54 (
    name: Izlazna faktura / Detalji
    alias: IZLAZNA-FAKTURA-DETALJI
    title: Izlazna faktura / Detalji
    pageGroup: @fakture-računi
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    dialog {
        width: 600
        maxWidth: 600
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#jasper-server#MIN#.js
    }
    css {
        inline:
            ```css
            /* Scroll Results Only in Side Column */
            .t-Body-side {
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            .search-results {
                flex: 1;
                overflow: auto;
            }
            /* Format Search Region */
            .search-region {
                border-bottom: 1px solid rgba(0,0,0,.1);
                flex-shrink: 0;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }

    region ažuriranje-detalja-fakture (
        name: Ažuriranje detalja fakture
        type: staticContent
        layout {
            sequence: 160
            parentRegion: @detalji-fakture
            slot: regionBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 100
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region detalji-fakture (
        name: Detalji fakture
        type: staticContent
        layout {
            sequence: 180
            slot: contentBody
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
            cssClasses: js-master-region
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P54_ID
        }
    )

    region lista-stavki (
        name: Lista stavki
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    stavka_sifra,
                    stavka_naziv,
                    jm_naziv,
                    kolicina,
                    cijena,
                    (cijena/:P54_KURS) as cijena_valuta, 
                    rabat,
                    pdv,
                    iznos,
                    iznos/:P54_KURS iznos_valuta,
                    iznos_pdv, 
                    iznos_pdv/:P54_KURS iznos_pdv_valuta,
                    iznos_pdv - iznos as pdv_iznos,
                    (iznos_pdv - iznos)/:P54_KURS as pdv_iznos_valuta,
                
                
                    pdv_indikator_sifra || ' - ' || pdv_indikator_naziv as pdv_indikator
                FROM
                    vw_kif_stavke
                WHERE
                    kif_id = :P54_ID
                ORDER BY
                    id ASC
                ```
        }
        layout {
            sequence: 190
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: js-detail-region
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P54_ID
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlightOff
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        breakFormatting {
            reportSumLabel: Ukupno
        }
        componentAdvanced {
            stripHtml: true
        }

        column CIJENA (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Cijena
                alignment: end
            }
            layout {
                sequence: 52
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: item=value
                item: P54_VALUTA_SIFRA
                value: BAM
            }
        )

        column CIJENA_VALUTA (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Cijena (&P54_VALUTA_SIFRA.)
                alignment: end
            }
            layout {
                sequence: 62
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: item!=value
                item: P54_VALUTA_SIFRA
                value: BAM
            }
        )

        column DERIVED$01 (
            reportColumnQueryId: 10
            derivedColumn: Y
            type: link
            heading {
                heading: Detalji
            }
            layout {
                sequence: 162
            }
            link {
                target: {
                    page: 58
                    items: {
                        P58_ID: #ID#
                    }
                    clearCache: 58
                }
                linkText: <img  src="#APP_FILES#icons/pencil.png" class="apex-edit-view"   style="height:22px !important; width:22px !important" alt="" >
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody: return finansije_pkg.is_kif_editable(:P54_ID);
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column IZNOS (
            reportColumnQueryId: 10
