    dynamicAction dialog-closed (
        name: Dialog Closed - Fiskalizacija
        execution {
            sequence: 250
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: button
            button: @fiskalizacija
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT fiskalizovano
                    INTO  :P54_FISKALIZOVANO
                    FROM   kif
                    WHERE id = :P54_ID;
                    ```
                itemsToSubmit: P54_FISKALIZOVANO
                itemsToReturn: P54_FISKALIZOVANO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @fiskalizacija
            }
            execution {
                sequence: 20
            }
            clientSideCondition {
                type: item=value
                item: P54_FISKALIZOVANO
                value: Y
            }
        )

    )

