    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 157270232465779921
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_max_broj NUMBER;
                    l_broj     NUMBER;
                BEGIN
                    SELECT max(faktura_broj)
                    INTO l_max_broj
                    FROM kif
                    WHERE 
                        ooj_id = :APP_OOJ_ID;
                    
                    SELECT faktura_broj
                    INTO l_broj
                    FROM kif
                    WHERE
                        id = :P54_ID;
                
                    finansije_pkg.delete_kif (
                        p_id => :P54_ID
                    );
                
                    IF l_max_broj = l_broj THEN
                        core.protokoli_pkg.update_brojac (
                            p_ooj_id             => :APP_OOJ_ID,
                            p_vrsta_naloga_sifra => 'if',
                            p_godina             => :APP_GODINA,
                            p_value              => -1
                        );
                    END IF;
                
                
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 157269821301779921
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                accounting.finansije_pkg.get_kif (
                        :P54_ID,
                        :P54_NAZIV_FAKTURE,      
                        :P54_KLIJENT_ID,
                        :P54_VALUTA_ID,
                        :P54_TIP_PLACANJA_ID,
                        :P54_DATUM_FAKTURE,
                        :P54_DATUM_VALUTE,
                        :P54_IZNOS_FAKTURE_NOPDV,
                        :P54_IZNOS_FAKTURE,
                        :P54_VALUTA_IZNOS,       
                        :P54_IZNOS_SLOVIMA,  
                        :P54_PRINT_PN,       
                        :P54_POSEBNE_NAPOMENE, 
                        :P54_TIP_DOKUMENTA_ID ,
                        :P54_UGOVOR_ID,   
                        :P54_OJ_ID ,   
                        :P54_STATUS
                    );
                
                    :P54_IZNOS_FAKTURE_NOPDV:=to_char(:P54_IZNOS_FAKTURE_NOPDV,'999G999G999G999G990D00');
                    :P54_IZNOS_FAKTURE:=to_char(:P54_IZNOS_FAKTURE,'999G999G999G999G990D00');
                    :P54_VALUTA_IZNOS:=to_char(:P54_VALUTA_IZNOS,'999G999G999G999G990D00');
                
                  accounting.finansije_pkg.get_pdv_indikator (:P54_ID,:P54_PDV_INDIKATOR_ID);
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25812215689123526
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                finansije_pkg.update_kif (
                    p_id                   => :P54_ID,
                    p_klijent_id           => :P54_KLIJENT_ID,
                    p_valuta_id            => :P54_VALUTA_ID,
                    p_tip_placanja_id      => :P54_TIP_PLACANJA_ID,
                    p_datum_fakture        => :P54_DATUM_FAKTURE,
                    p_datum_valute         => :P54_DATUM_VALUTE,
                    p_iznos_slovima        => :P54_IZNOS_SLOVIMA,
                    p_print_pn             => :P54_PRINT_PN,
                    p_posebne_napomene     => :P54_POSEBNE_NAPOMENE,
                    p_uio_tip_dokumenta_id => :P54_TIP_DOKUMENTA_ID,
                    p_ugovor_id            => :P54_UGOVOR_ID,
                    p_oj_id                => :P54_OJ_ID
                );
                
                finansije_pkg.calculate_kif (
                    p_id => :P54_ID
                );
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Izmjene sačuvane.
        }
        advanced {
            executionMappingIdentifier: 25812495893123528
        }
        serverSideCondition {
            whenButtonPressed: @edit
        }
    )

