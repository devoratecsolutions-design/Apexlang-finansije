    region stepen-amortizovanosti-report (
        name: Stepen amortizovanosti Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    inventurni_naziv,
                    naziv,
                    kolicina,
                
                    oj_naziv,
                    lokacija_naziv,
                    prostorija_naziv,
                
                    nabavna_vrijednost,
                    knjigovodstvena_vrijednost,
                    amortizacija_vrijednost,
                    datum,
                    stepen_amortizovanosti
                FROM
                    vw_osnovna_sredstva
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND history_id IS null
                    AND aktivirano = 'Y'
                    AND stepen_amortizovanosti >= :P250_STEPEN_OD
                    AND stepen_amortizovanosti <= :P250_STEPEN_DO
                ORDER BY
                    inventurni_broj DESC
                ```
            pageItemsToSubmit: [
                P250_STEPEN_OD
                P250_STEPEN_DO
            ]
        }
        layout {
            sequence: 50
            parentRegion: @stepen-amortizovanosti
            slot: regionBody
        }
        appearance {
