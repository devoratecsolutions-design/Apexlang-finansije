    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P250_STEPEN_OD
                P250_STEPEN_DO
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stepen-amortizovanosti-report
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-datum (
        name: "Refresh - Datum "
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: [
                P250_DATUM_OD
                P250_DATUM_DO
            ]
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression:
                ```javascript-browser
                $v('P250_DATUM_OD') !== "" 
                && $v('P250_DATUM_DO') !== ""
                
                ```
        }

        action refresh-obračun-amortizacije-za-period (
            name: Refresh - Obračun amortizacije za period
            action: refresh
            affectedElements {
                selectionType: region
                region: @obračun-amortizacije-za-period
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action refresh-spisak-osnovnih-sredstava (
            name: Refresh - Spisak osnovnih sredstava
            action: refresh
            affectedElements {
                selectionType: region
                region: @spisak-osnovnih-sredstava
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-kontna-klasa (
