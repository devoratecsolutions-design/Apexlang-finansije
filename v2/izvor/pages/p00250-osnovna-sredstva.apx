    dynamicAction set (
        name: Set 0-20
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @button
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P250_STEPEN_OD := 0;
                    :P250_STEPEN_DO := 20;
                    ```
                itemsToSubmit: [
                    P250_STEPEN_OD
                    P250_STEPEN_DO
                ]
                itemsToReturn: [
                    P250_STEPEN_OD
                    P250_STEPEN_DO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-2 (
        name: Set 21-50
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @button-2
