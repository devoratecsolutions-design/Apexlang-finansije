page 250 (
    name: Osnovna sredstva
    alias: OSNOVNA-SREDSTVA
    title: Osnovna sredstva
    pageGroup: @osnovna-sredstva
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @osnovna-sredstva-osnovna
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <b><em>"Sredstva preduzeća"</em></b> predstavljaju ekonomske vrijednosti materijalnog i novčanog 
            oblika pomoću kojih se ostvaruju ciljevi poslovanja i obavljaju zadaci. </br>
            Ona se dijele na sredstva za rad i predmete rada. </br>
            Osnovna sredstva ili stalna sredstva koriste se duži vremenski period i zamjenjuju se novim tek 
            kada više ne mogu biti u upotrebi.
            ```
    }

