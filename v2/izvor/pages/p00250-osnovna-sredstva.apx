    region obračun-amortizacije-za-period (
        name: Obračun amortizacije za period
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH osnovna_sredstva AS (
                    SELECT
                        id,
                        naziv,
                        oj_naziv,
                        konto_nabavke_id,
                        klasa_sifra,
                        nabavna_vrijednost
                    FROM
                        vw_osnovna_sredstva
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND priprema = 'N'
                        AND history_id IS null
                        AND aktivirano = 'Y'
                        AND (oj_id = :P250_OJ_ID OR :P250_OJ_ID IS null)
                        AND (konto_nabavke_id = :P250_KONTNA_KLASA_ID OR :P250_KONTNA_KLASA_ID IS null)
                ), vrijednosti AS (
                    SELECT
                        gks.osnovno_sredstvo_id,
                        SUM(
                            CASE
                                WHEN gks.transakcija_sifra = 'am_p' AND gks.glavna_knjiga_datum_knjizenja <= to_date(:P250_DATUM_OD, 'DD.MM.YYYY') THEN
                                    iznos
                                ELSE
                                    0
                            END
                        ) AS ispravak_do,
                        SUM(
                            CASE
                                WHEN gks.transakcija_sifra = 'am_p' AND gks.glavna_knjiga_datum_knjizenja >= to_date(:P250_DATUM_OD, 'DD.MM.YYYY') AND gks.glavna_knjiga_datum_knjizenja <= to_date(:P250_DATUM_DO, 'DD.MM.YYYY') THEN
                                    iznos
                                ELSE
                                    0
                            END
                        ) AS ispravak_period
                    FROM
                        vw_glavna_knjiga_stavke gks
                        LEFT JOIN osnovna_sredstva os ON gks.osnovno_sredstvo_id = os.id
                    WHERE
                        gks.glavna_knjiga_datum_knjizenja <= to_date(:P250_DATUM_DO, 'DD.MM.YYYY')
                        AND gks.osnovno_sredstvo_id IS NOT null
                    GROUP BY
                        gks.osnovno_sredstvo_id
                )
                SELECT
                    naziv,
                    oj_naziv,
                    konto_nabavke_id,
                    klasa_sifra,
                    
                    ispravak_do,
                    ispravak_period,
                    
                    nabavna_vrijednost,
                    (ispravak_do + ispravak_period) as ispravak_ukupno,
                    nabavna_vrijednost - (ispravak_do + ispravak_period) as trenutna_vrijednost
                FROM
                    osnovna_sredstva os
                    LEFT JOIN vrijednosti v ON v.osnovno_sredstvo_id = os.id
                ORDER BY
                    naziv
                ```
            pageItemsToSubmit: [
                P250_DATUM_OD
                P250_DATUM_DO
                P250_OJ_ID
                P250_KONTNA_KLASA_ID
            ]
        }
