    region spisak-osnovnih-sredstava (
        name: Spisak osnovnih sredstava
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv,
                    oj_naziv,
                    konto_nabavke_id,
                    klasa_sifra,
                    kolicina,
                    to_char(amortizaciona_stopa, '999G999G999G999G990D000') as amortizaciona_stopa,
                    nabavna_vrijednost,
                    amortizacija_vrijednost,
                    knjigovodstvena_vrijednost
                FROM
                    vw_osnovna_sredstva os
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND priprema = 'N'
                    AND history_id IS null
                    AND aktivirano = 'Y'
                    AND (
                        SELECT count(*)
                        FROM vw_glavna_knjiga_stavke gks
                        WHERE
                            os.ooj_id = :APP_OOJ_ID
                            AND gks.osnovno_sredstvo_id = os.id
                            AND gks.glavna_knjiga_datum_knjizenja >= to_date(:P250_DATUM_OD, 'DD.MM.YYYY') 
                            AND gks.glavna_knjiga_datum_knjizenja <= to_date(:P250_DATUM_DO, 'DD.MM.YYYY')
                    ) > 0
                    AND (oj_id = :P250_OJ_ID OR :P250_OJ_ID IS null)
                    AND (konto_nabavke_id = :P250_KONTNA_KLASA_ID OR :P250_KONTNA_KLASA_ID IS null)
                ORDER BY
                    naziv
                    
                ```
            pageItemsToSubmit: [
                P250_DATUM_OD
                P250_DATUM_DO
                P250_OJ_ID
                P250_KONTNA_KLASA_ID
            ]
        }
