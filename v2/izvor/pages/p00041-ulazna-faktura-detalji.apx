        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Broj sa fakture dobavljača i kratak opis (npr. 1234/26 - zakup prostora). Isti dobavljač i isti broj ne mogu se unijeti dva puta u istoj godini.
        }
    )

    pageItem P41_UGOVOR_ID (
        type: popupLov
        label {
            label: Ugovor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT prikaz AS d, id AS r
                FROM vw_kuf_ugovori
                WHERE ooj_id = :APP_OOJ_ID
                  AND klijent_id = :P41_KLIJENT_ID
                  AND (aktivan = 'Y' OR id = :P41_UGOVOR_ID)
                ORDER BY broj DESC
                ```
        }
        cascadingLov {
            parentItems: P41_KLIJENT_ID
            itemsToSubmit: P41_UGOVOR_ID
        }
        layout {
            sequence: 90
            region: @dokument
            slot: regionBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
    )

    pageItem P41_VEZA_KUF_ID (
        type: popupLov
        label {
            label: Odnosi se na fakturu
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT prikaz
                       || CASE WHEN :P41_VRSTA_SIFRA IN ('UKO', 'UAVZ')
                               THEN ' – raspoloživo ' || to_char(raspolozivo, 'FM999G999G990D00') END AS d,
                       id AS r
                FROM vw_kuf_veze
                WHERE ooj_id = :APP_OOJ_ID
                  AND klijent_id = :P41_KLIJENT_ID
                  AND id <> nvl(:P41_ID, -1)
                  AND (   (:P41_VRSTA_SIFRA = 'UAVZ' AND vrsta_sifra = 'UAV' AND status = 'Z'
                           AND (raspolozivo > 0 OR id = :P41_VEZA_KUF_ID))
                       OR (:P41_VRSTA_SIFRA = 'UKZ' AND vrsta_sifra = 'UF' AND status = 'Z')
                       OR (:P41_VRSTA_SIFRA = 'UKO' AND vrsta_sifra = 'UF' AND status = 'Z' AND ima_zatvaranje_avansa = 'N'
                           AND (raspolozivo > 0 OR id = :P41_VEZA_KUF_ID)))
                ORDER BY datum_fakture DESC
                ```
        }
        cascadingLov {
            parentItems: [
                P41_KLIJENT_ID
                P41_VRSTA_SIFRA
            ]
            itemsToSubmit: [
                P41_ID
                P41_VEZA_KUF_ID
            ]
        }
        layout {
            sequence: 100
            region: @dokument
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Za knjižno odobrenje i zaduženje: zaključena ulazna faktura (ne avansna). Za zatvaranje avansa: zaključena avansna faktura.
        }
    )

