    region dokumenti-lista (
        name: Priloženi dokumenti
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    d.id,
                    d.naziv,
                    d.opis,
                    d.velicina_kb,
                    to_char(d.created, 'DD.MM.YYYY HH24:MI') AS dodato,
                    CASE
                        WHEN d.mime_tip = 'application/pdf' THEN 'fa-file-pdf-o'
                        WHEN d.mime_tip LIKE 'image/%' THEN 'fa-file-image-o'
                        ELSE 'fa-file-o'
                    END AS ikona,
                    apex_page.get_url(p_page => 42, p_items => 'P42_ID,P42_DOK_ID', p_values => d.kuf_id || ',' || d.id,
                                      p_request => 'PRIKAZ', p_plain_url => true) AS url_prikaz,
                    CASE WHEN :P41_IZMJENJIVA = 'Y' THEN 'Y' END AS brisanje
                FROM vw_kuf_dokumenti d
                WHERE d.kuf_id = :P41_ID
                  AND d.ooj_id = :APP_OOJ_ID
                ORDER BY d.id DESC
                ```
            pageItemsToSubmit: [
                P41_ID
                P41_IZMJENJIVA
            ]
        }
        layout {
            sequence: 30
            parentRegion: @dokumenti
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: fin-doclist
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Nema priloženih dokumenata.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_ID
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column OPIS (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column VELICINA_KB (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column DODATO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column IKONA (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 60
            }
        )

        column URL_PRIKAZ (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 70
            }
        )

        column BRISANJE (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

        column NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Dokument
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="fin-prilog fin-prilog--red"><span class="fa #IKONA# fin-prilog__ikona" aria-hidden="true"></span><a class="fin-prilog__naziv" href="#URL_PRIKAZ#" target="_blank" rel="noopener" title="#NAZIV#">#NAZIV#</a><input type="text" class="fin-prilog__unos" data-id="#ID#" value="#OPIS#" maxlength="500" placeholder="Komentar…" aria-label="Komentar uz dokument"><span class="fin-prilog__meta">#DODATO# · #VELICINA_KB# KB</span><a class="fin-act" href="#URL_PRIKAZ#" target="_blank" rel="noopener" title="Otvori" aria-label="Otvori"><span class="fa fa-external-link" aria-hidden="true"></span></a>{if BRISANJE/}<a class="fin-act fin-act--danger fin-doc-brisi" href="javascript:void(0)" data-id="#ID#" title="Obriši" aria-label="Obriši"><span class="fa fa-trash-o" aria-hidden="true"></span></a>{endif/}</div>
                    ```
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P41_ID (
        type: hidden
        layout {
            sequence: 1
            region: @ulazna-faktura-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P41_ORIG (
        type: hidden
        default {
            type: static
            staticValue: 0
        }
        settings {
            valueProtected: false
        }
        layout {
            sequence: 2
            region: @ulazna-faktura-detalji
            slot: regionBody
        }
    )

    pageItem P41_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 3
