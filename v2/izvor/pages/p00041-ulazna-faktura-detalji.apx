    validation zaglavlje (
        name: Provjera zaglavlja (KUF_PKG)
        execution {
            sequence: 80
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return kuf_pkg.provjeri_zaglavlje(
                    p_id                 => :P41_ID,
                    p_ooj_id             => :APP_OOJ_ID,
                    p_godina             => :APP_GODINA,
                    p_vrsta_dokumenta_id => :P41_VRSTA_DOKUMENTA_ID,
                    p_klijent_id         => :P41_KLIJENT_ID,
                    p_broj_fakture       => :P41_NAZIV_FAKTURE,
                    p_datum_fakture      => :P41_DATUM_FAKTURE,
                    p_datum_prijema      => :P41_DATUM_PRIJEMA,
                    p_datum_valute       => :P41_DATUM_VALUTE,
                    p_ugovor_id          => :P41_UGOVOR_ID,
                    p_veza_kuf_id        => :P41_VEZA_KUF_ID,
                    p_valuta_id          => :P41_VALUTA_ID
                );
                ```
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'SAVE_UIO') or (:REQUEST = 'ZAKLJUCAJ' and :P41_IZMJENJIVA = 'Y')
        }
    )

    process ucitaj (
        name: Učitavanje fakture
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                kuf_pkg.pripremi_specifikaciju(:P41_ID);
                for f in (select * from vw_kuf_forma where id = :P41_ID and ooj_id = :APP_OOJ_ID) loop
                    :P41_VRSTA_DOKUMENTA_ID   := f.vrsta_dokumenta_id;
                    :P41_VRSTA_SIFRA          := f.vrsta_sifra;
                    :P41_VRSTA_NAZIV          := f.vrsta_naziv;
                    :P41_KLIJENT_ID           := f.klijent_id;
                    :P41_NAZIV_FAKTURE        := f.naziv_fakture;
                    :P41_UGOVOR_ID            := f.ugovor_id;
                    :P41_VEZA_KUF_ID          := f.veza_kuf_id;
                    :P41_TIP_PLACANJA_ID      := f.tip_placanja_id;
                    :P41_FISKALNI_RACUN_BROJ  := f.fiskalni_racun_broj;
                    :P41_DATUM_FAKTURE        := f.datum_fakture;
                    :P41_DATUM_PRIJEMA        := f.datum_prijema;
                    :P41_DATUM_VALUTE         := f.datum_valute;
                    :P41_VALUTA_ID            := f.valuta_id;
                    :P41_UIO_TIP              := f.uio_tip_prikaz;
                    :P41_NAZIV                := f.naziv;
                    :P41_STATUS               := f.status;
                    :P41_STATUS_NAZIV         := f.status_naziv;
                    :P41_STATUS_NAZIV_MALO    := lower(f.status_naziv);
                    :P41_STATUS_BOJA          := f.status_boja;
                    :P41_STORNIRANO           := f.stornirano;
                    :P41_STORNIRAN_ID         := f.storniran_id;
                    :P41_GLAVNA_KNJIGA_ID     := f.glavna_knjiga_id;
                    :P41_NALOG                := case when f.nalog is not null then 'Nalog ' || f.nalog end;
                    :P41_UIO_BROJ             := f.uio_broj;
                    :P41_IZNOS_KM             := to_char(f.iznos_sa_pdv, 'FM999G999G999G999G990D00');
                    :P41_AVANS_URACUNAT       := f.ima_avans;
                    :P41_VEZE_HTML            := kuf_pkg.veze_html(f.id, :P41_ORIG);
                end loop;
                :P41_IZMJENJIVA := case when kuf_pkg.je_izmjenjiva(:P41_ID) then 'Y' else 'N' end;
                :P41_KURS := kuf_pkg.kurs_prikaz(:P41_VALUTA_ID, :APP_OOJ_ID, :P41_DATUM_FAKTURE);
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_ID
        }
    )

    process nova (
        name: Nova faktura - početne vrijednosti
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P41_IZMJENJIVA := 'Y';
                :P41_STATUS := 'P';
                :P41_NAZIV := 'Nova ulazna faktura';
                if :P41_VRSTA_DOKUMENTA_ID is null then
                    for v in (select id, sifra from vw_kuf_vrste_dokumenata
                               where ooj_id = :APP_OOJ_ID and sifra = 'UF') loop
                        :P41_VRSTA_DOKUMENTA_ID := v.id;
                        :P41_VRSTA_SIFRA := v.sifra;
                    end loop;
                end if;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNull
            item: P41_ID
        }
    )

    process stope (
        name: Stope PDV indikatora (za račun u pregledaču)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P41_STOPE := kuf_pkg.stope_json;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
    )

    process snimi (
        name: Snimi zaglavlje
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P41_ID := kuf_pkg.snimi(
                    p_id                  => :P41_ID,
                    p_ooj_id              => :APP_OOJ_ID,
                    p_godina              => :APP_GODINA,
                    p_vrsta_dokumenta_id  => :P41_VRSTA_DOKUMENTA_ID,
                    p_klijent_id          => :P41_KLIJENT_ID,
                    p_broj_fakture        => :P41_NAZIV_FAKTURE,
                    p_datum_fakture       => :P41_DATUM_FAKTURE,
                    p_datum_prijema       => :P41_DATUM_PRIJEMA,
                    p_datum_valute        => :P41_DATUM_VALUTE,
                    p_valuta_id           => :P41_VALUTA_ID,
                    p_tip_placanja_id     => :P41_TIP_PLACANJA_ID,
                    p_fiskalni_racun_broj => :P41_FISKALNI_RACUN_BROJ,
                    p_ugovor_id           => :P41_UGOVOR_ID,
                    p_veza_kuf_id         => :P41_VEZA_KUF_ID
                );
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'SAVE_UIO') or (:REQUEST = 'ZAKLJUCAJ' and :P41_IZMJENJIVA = 'Y')
        }
    )

    process pdv-specifikacija-snimi (
        name: PDV specifikacija - snimi redove
        type: executeCode
        editableRegion: @pdv-specifikacija
        source {
            plsqlCode:
                ```plsql
                declare
                    -- vrijednosti iz tabele su tekst; novi red ima privremeni ID (t1000) -> kuf_pkg.broj vraća null
                    l_id number := kuf_pkg.broj(:ID);
                begin
                    if :APEX$ROW_STATUS = 'D' then
                        kuf_pkg.obrisi_pdv_red(p_id => l_id);
                    else
                        kuf_pkg.snimi_pdv_red(
                            p_id               => l_id,
                            p_kuf_id           => :P41_ID,
                            p_redni_broj       => kuf_pkg.broj(:REDNI_BROJ),
                            p_pdv_indikator_id => kuf_pkg.broj(:PDV_INDIKATOR_ID),
                            p_valuta_osnovica  => kuf_pkg.broj(:VALUTA_OSNOVICA),
                            -- u PDV sistemu PDV se ne unosi: računa ga paket iz osnovice i stope indikatora
                            p_valuta_pdv       => case when :APP_PDV_SISTEM = 'Y' then null
                                                       else kuf_pkg.broj(:VALUTA_PDV) end,
                            p_izvor_red_id     => kuf_pkg.broj(:IZVOR_RED_ID)
                        );
                        :ID := l_id;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'SAVE_UIO') or (:REQUEST = 'ZAKLJUCAJ' and :P41_IZMJENJIVA = 'Y')
        }
    )

    process preracunaj (
        name: Preračunaj iznose i dodaj dokument
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                kuf_pkg.preracunaj(:P41_ID);
                kuf_pkg.dodaj_dokument(p_kuf_id => :P41_ID, p_naziv_fajla => :P41_DOCUMENT);
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Faktura je snimljena.
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'SAVE_UIO') or (:REQUEST = 'ZAKLJUCAJ' and :P41_IZMJENJIVA = 'Y')
        }
    )

    process provjeri-stavke (
        name: Dokument mora imati PDV specifikaciju
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                kuf_pkg.provjeri_stavke(:P41_ID);
                ```
        }
        execution {
            sequence: 31
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE', 'SAVE_UIO') or (:REQUEST = 'ZAKLJUCAJ' and :P41_IZMJENJIVA = 'Y')
        }
    )

    process avansi-snimi (
        name: Uračunati avansi - snimi redove
        type: executeCode
        editableRegion: @uracunati-avansi
        source {
            plsqlCode:
                ```plsql
                declare
                    -- vrijednosti iz tabele su tekst; novi red ima privremeni ID (t1000) -> kuf_pkg.broj vraća null
                    l_id number := kuf_pkg.broj(:ID);
                begin
                    if :APEX$ROW_STATUS = 'D' then
                        kuf_pkg.obrisi_avans_red(p_id => l_id);
                    elsif :P41_AVANS_URACUNAT = 'Y' then
                        kuf_pkg.snimi_avans_red(
                            p_id       => l_id,
                            p_kuf_id   => :P41_ID,
                            p_avans_id => kuf_pkg.broj(:AVANS_ID),
                            p_iznos    => kuf_pkg.broj(:IZNOS)
                        );
                        :ID := l_id;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 33
        }
        serverSideCondition {
            executionScope: allSubmittedRows
            type: expression
            plsqlExpression: :P41_VRSTA_SIFRA = 'UF' and (:REQUEST in ('SAVE', 'SAVE_UIO') or (:REQUEST = 'ZAKLJUCAJ' and :P41_IZMJENJIVA = 'Y'))
        }
    )

    process avansi-uskladi (
        name: Uračunati avansi - usklađivanje sa fakturom
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                kuf_pkg.uskladi_avanse(p_kuf_id => :P41_ID, p_uracunat => :P41_AVANS_URACUNAT);
                ```
        }
        execution {
            sequence: 35
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P41_VRSTA_SIFRA = 'UF' and (:REQUEST in ('SAVE', 'SAVE_UIO') or (:REQUEST = 'ZAKLJUCAJ' and :P41_IZMJENJIVA = 'Y'))
        }
    )

    process ajax-preuzmi-stavke (
        name: PREUZMI_STAVKE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sys.htp.p(kuf_pkg.stavke_za_preuzimanje(
                    p_veza_id     => apex_application.g_x01,
                    p_vrsta_sifra => apex_application.g_x02,
                    p_kuf_id      => :P41_ID
                ));
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
    )

    process ajax-dokument-opis (
        name: DOKUMENT_OPIS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                kuf_pkg.opis_dokumenta(
                    p_id     => apex_application.g_x01,
                    p_ooj_id => :APP_OOJ_ID,
                    p_opis   => apex_application.g_x02
                );
                sys.htp.p('{"ok":true}');
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
    )

    process ajax-veza-valuta (
        name: VEZA_VALUTA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sys.htp.p('{"v":"' || kuf_pkg.veza_valuta(apex_application.g_x01) || '"}');
                ```
        }
        execution {
            sequence: 40
            point: ajaxCallback
        }
    )

    process ajax-avans-info (
        name: AVANS_INFO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sys.htp.p(kuf_pkg.avans_info(
                    p_avans_id => apex_application.g_x01,
                    p_kuf_id   => :P41_ID
                ));
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
    )

    process dodaj-dokumente (
        name: Dodaj dokumente
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                kuf_pkg.dodaj_dokument(p_kuf_id => :P41_ID, p_naziv_fajla => :P41_DOCUMENT);
                ```
        }
        execution {
            sequence: 38
        }
        successMessage {
            successMessage: Dokumenti su dodati.
        }
        serverSideCondition {
            whenButtonPressed: @dodaj-dokumente
        }
    )

    process zakljucaj (
        name: Zaključaj
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                kuf_pkg.zakljucaj(:P41_ID);
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Faktura je zaključana.
        }
        serverSideCondition {
            whenButtonPressed: @zakljucaj
        }
    )

    process otkljucaj (
        name: Otključaj
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                kuf_pkg.otkljucaj(:P41_ID);
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Faktura je otključana za izmjene.
        }
        serverSideCondition {
            whenButtonPressed: @otkljucaj
        }
    )

    process storniraj (
        name: Storniraj
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P41_STORNO_ID := kuf_pkg.storniraj(:P41_ID, trunc(sysdate));
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Faktura je stornirana.
        }
        serverSideCondition {
            whenButtonPressed: @storniraj
        }
    )

    process obrisi (
        name: Obriši
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                kuf_pkg.obrisi(p_id => :P41_ID, p_ooj_id => :APP_OOJ_ID);
                ```
        }
        execution {
            sequence: 70
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process close-dialog (
        name: Zatvori dijalog
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,ZAKLJUCAJ,STORNIRAJ
        }
    )

    branch (
        name: Nazad na UIO KUF
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 84
                items: {
                    P84_FAKTURA_ID: &P41_ID.
                }
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P41_ORIG = 84 and :REQUEST not in ('DELETE', 'STORNIRAJ')
        }
    )

    branch (
        name: Ostani na fakturi
        execution {
            sequence: 50
        }
        behavior {
            target: {
                page: 41
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,OTKLJUCAJ,DOKUMENT
        }
    )

)
