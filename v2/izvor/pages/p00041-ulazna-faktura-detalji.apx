page 41 (
    name: Ulazna faktura / Detalji
    alias: ULAZNA-FAKTURA-DETALJI
    title: Ulazna faktura
    pageGroup: @fakture-računi
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            finKufPdv.init('pdv_spec', 'P41', '&APP_PDV_SISTEM.');
            finKufAvansi.init('avansi_ig', 'P41');
            finKurs.provjeri('P41');
            ```
    }
    css {
        inline:
            ```css
            .ui-dialog-titlebar-close {
                display: none !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region dokument-traka (
        name: Traka dokumenta
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="fin-docbar">
                  <span class="fin-docbar__no">&P41_NAZIV.</span>
                  <span class="fin-badge fin-badge--&P41_STATUS_BOJA.">&P41_STATUS_NAZIV.</span>
                  <span class="fin-docbar__meta">&P41_VRSTA_NAZIV.</span>
                  <span class="fin-docbar__meta">&P41_NALOG.</span>
                  <span class="fin-docbar__veze">&P41_VEZE_HTML!RAW.</span>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_ID
        }
    )

    region zakljucana (
        name: Faktura se ne može mijenjati
        type: staticContent
        source {
            htmlCode: Faktura je &P41_STATUS_NAZIV_MALO. i ne može se mijenjati. Za izmjenu je otključajte (ako nije proknjižena ni unesena u UIO KUF) ili je stornirajte.
        }
        layout {
            sequence: 7
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P41_ID is not null and :P41_IZMJENJIVA = 'N'
        }
    )

    region ulazna-faktura-detalji (
        name: Ulazna faktura / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
        readOnly {
            type: expression
            plsqlExpression: :P41_IZMJENJIVA = 'N'
        }
    )

    region dokument (
        name: Dokument i dobavljač
        title: Dokument i dobavljač
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @ulazna-faktura-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region datumi (
        name: Datumi
        title: Datumi
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @ulazna-faktura-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region iznosi (
        name: Iznosi i PDV
        title: Iznosi i PDV
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @ulazna-faktura-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region avans (
        name: Uračunati avansi
        title: Uračunati avansi
        type: staticContent
        layout {
            sequence: 35
            parentRegion: @ulazna-faktura-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region uracunati-avansi (
        name: Uračunati avansi
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    a.id,
                    a.avans_id,
                    a.valuta_sifra,
                    kuf_pkg.avans_raspolozivo(a.avans_id, :P41_ID) AS raspolozivo,
                    a.iznos,
                    a.iznos_km,
                    a.zatvaranje_naziv
                FROM vw_kuf_uracunati_avansi a
                WHERE a.kuf_id = :P41_ID
                ORDER BY a.id
                ```
            pageItemsToSubmit: P41_ID
        }
        layout {
            sequence: 20
            parentRegion: @avans
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ig
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Dodajte avans koji je uračunat u fakturu. Nude se zaključeni avansi istog dobavljača sa raspoloživim iznosom.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = "Dodaj avans"; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("search");
                    toolbarData.toolbarRemove("actions");
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: false, autoAddRecord: false };
                    if (options.editable) { options.editable.autoAddRow = false; }
                    return options;
                }
                ```
        }
        advanced {
            htmlDomId: avansi_ig
            savedReportMappingIdentifier: 410000000000000201
        }
        readOnly {
            type: expression
            plsqlExpression: :P41_IZMJENJIVA = 'N'
        }

        savedReport 410000000000000202 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @AVANS_ID
                layout {
                    sequence: 2
                    width: 250
                }
            )

            displayColumn (
                column: @VALUTA_SIFRA
                layout {
                    sequence: 3
                    width: 60
                }
            )

            displayColumn (
                column: @RASPOLOZIVO
                layout {
                    sequence: 4
                    width: 105
                }
            )

            displayColumn (
                column: @IZNOS
                layout {
                    sequence: 5
                    width: 115
                }
            )

            displayColumn (
                column: @IZNOS_KM
                layout {
                    sequence: 6
                    width: 95
                }
            )

            displayColumn (
                column: @ZATVARANJE_NAZIV
                layout {
                    sequence: 7
                    width: 115
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )

        column AVANS_ID (
            type: popupLov
            heading {
                heading: Avans
            }
            settings {
                popupWidth: 640
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT prikaz || ' - ' || valuta_sifra || ' - raspoloživo ' || to_char(raspolozivo, 'FM999G999G990D00') AS d,
                           id AS r
                    FROM vw_kuf_avansi
                    WHERE ooj_id = :APP_OOJ_ID
                      AND klijent_id = :P41_KLIJENT_ID
                      AND kuf_pkg.valute_dozvoljene(:P41_VALUTA_ID, valuta_id) = 'Y'
                      AND (raspolozivo > 0
                           OR id IN (SELECT u.avans_id FROM vw_kuf_uracunati_avansi u WHERE u.kuf_id = :P41_ID))
                    ORDER BY datum_fakture
                    ```
                displayExtraValues: true
                displayNullValue: true
                nullDisplayValue: - izaberite avans -
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: AVANS_ID
                dataType: number
            }
            validation {
                valueRequired: true
            }
        )

        column VALUTA_SIFRA (
            type: textField
            heading {
                heading: Valuta
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: VALUTA_SIFRA
                dataType: varchar2
                queryOnly: true
            }
        )

        column RASPOLOZIVO (
            type: numberField
            heading {
                heading: Raspoloživo
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G999G990D00
            }
            source {
                databaseColumn: RASPOLOZIVO
                dataType: number
                queryOnly: true
            }
        )

        column IZNOS (
            type: numberField
            heading {
                heading: Zatvara se (bez PDV-a)
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G999G990D00
            }
            source {
                databaseColumn: IZNOS
                dataType: number
            }
            validation {
                valueRequired: true
            }
        )

        column IZNOS_KM (
            type: numberField
            heading {
                heading: U KM
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G999G990D00
            }
            source {
                databaseColumn: IZNOS_KM
                dataType: number
                queryOnly: true
            }
            readOnly {
                type: always
            }
        )

        column ZATVARANJE_NAZIV (
            type: textField
            heading {
                heading: Dokument zatvaranja
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: ZATVARANJE_NAZIV
                dataType: varchar2
                queryOnly: true
            }
            readOnly {
                type: always
            }
        )

    )

    region dokumenti-okvir (
