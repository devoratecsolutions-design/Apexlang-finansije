    dynamicAction dokument-brisi (
        name: Obriši dokument
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .fin-doc-brisi
        }

        action native-confirm (
            action: confirm
            settings {
                message: Obrisati dokument? Brisanje se ne može poništiti.
                style: danger
                confirmLabel: Obriši
                cancelLabel: Odustani
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).data('id')
            }
            affectedElements {
                selectionType: items
                items: P41_DOK_ID
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: kuf_pkg.obrisi_dokument(p_id => :P41_DOK_ID);
                itemsToSubmit: P41_DOK_ID
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @dokumenti-lista
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction kurs (
        name: Kurs na datum fakture
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: [
                P41_VALUTA_ID
                P41_DATUM_FAKTURE
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P41_KURS := kuf_pkg.kurs_prikaz(
                        p_valuta_id => :P41_VALUTA_ID,
                        p_ooj_id    => :APP_OOJ_ID,
                        p_datum     => :P41_DATUM_FAKTURE
                    );
                    ```
                itemsToSubmit: [
                    P41_VALUTA_ID
                    P41_DATUM_FAKTURE
                ]
                itemsToReturn: P41_KURS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: finKurs.provjeri('P41');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

