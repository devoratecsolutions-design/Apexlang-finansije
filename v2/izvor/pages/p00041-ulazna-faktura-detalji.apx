    region preuzete-stavke (
        name: Preuzete stavke
        type: staticContent
        source {
            htmlCode: <span class="fa fa-info-circle" aria-hidden="true"></span><span>Stavke su preuzete sa izabrane fakture. Iznos možete samo smanjiti, najviše do raspoloživog.</span>
        }
