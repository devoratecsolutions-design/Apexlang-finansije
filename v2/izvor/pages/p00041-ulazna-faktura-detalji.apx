    dynamicAction close-dialog (
        name: Zatvaranje dijaloga (X)
        execution {
            sequence: 90
            eventScope: dynamic
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function zameniX() {
                        var topWin = window.top;
                        var $ = topWin.apex.jQuery;
                        var btn = $('.ui-dialog-titlebar-close', topWin.document);
                        if (btn.length) {
                            btn.off('click').on('click', function(e) {
                                e.preventDefault();
                                e.stopImmediatePropagation();
                                apex.page.cancelWarnOnUnsavedChanges();
                                topWin.apex.navigation.dialog.close(true);
                            });
                        }
                    }
                    var observer = new MutationObserver(zameniX);
                    observer.observe(window.top.document.documentElement, {
                        childList: true,
                        subtree: true,
                        attributes: true,
                        attributeFilter: ['style', 'class']
                    });
                    zameniX();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction novi-dobavljac (
        name: Novi dobavljač - osvježi listu
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @nova-osoba
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P41_KLIJENT_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction vrsta-dokumenta (
        name: Vrsta dokumenta - šifra
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P41_VRSTA_DOKUMENTA_ID
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT sifra
                    FROM vw_kuf_vrste_dokumenata
                    WHERE id = :P41_VRSTA_DOKUMENTA_ID
                    ```
                itemsToSubmit: P41_VRSTA_DOKUMENTA_ID
            }
            affectedElements {
                selectionType: items
                items: P41_VRSTA_SIFRA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

