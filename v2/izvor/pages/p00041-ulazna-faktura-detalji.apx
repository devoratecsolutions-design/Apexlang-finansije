            templateOptions: #DEFAULT#
            cssClasses: fin-totals
        }
    )

    region pdv-specifikacija (
        name: PDV specifikacija
        title: PDV specifikacija
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    s.red_id                                                    AS id,
                    s.redni_broj,
                    s.izvor_red_id,
                    s.pdv_indikator_id,
                    s.valuta_osnovica * kuf_pkg.predznak(:P41_VRSTA_DOKUMENTA_ID) AS valuta_osnovica,
                    s.valuta_pdv * kuf_pkg.predznak(:P41_VRSTA_DOKUMENTA_ID)      AS valuta_pdv,
                    CASE WHEN s.izvor_red_id IS NOT NULL
                         THEN kuf_pkg.raspolozivo_reda(s.izvor_red_id, s.red_id) END AS raspolozivo
                FROM vw_kuf_pdv_spec s
                WHERE s.kuf_id = :P41_ID
                  AND s.izvor = 'R'
                ORDER BY s.redni_broj
                ```
            pageItemsToSubmit: [
                P41_ID
                P41_VRSTA_DOKUMENTA_ID
            ]
        }
        layout {
            sequence: 40
            parentRegion: @iznosi
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
            ]
            cssClasses: fin-ig
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Dodajte red sa iznosom fakture.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    var toolbarData = apex.jQuery.apex.interactiveGrid.copyDefaultToolbar(),
                        addrow = toolbarData.toolbarFind("selection-add-row");
                    if (addrow) { addrow.label = "Dodaj red"; }
                    toolbarData.toolbarRemove("save");
                    toolbarData.toolbarRemove("search");
                    toolbarData.toolbarRemove("actions");
                    options.toolbarData = toolbarData;
                    options.defaultGridViewOptions = { reorderColumns: false, footer: false };
                    return options;
                }
                ```
        }
        advanced {
            htmlDomId: pdv_spec
            savedReportMappingIdentifier: 410000000000000101
        }

