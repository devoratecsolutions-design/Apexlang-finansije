    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P222_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P222_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction change-calculate-iznos (
        name: Change - Calculate iznos
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: [
                P222_KURS
                P222_VALUTA_IZNOS
            ]
        }
        clientSideCondition {
            type: item!=value
            item: P222_VALUTA_ID
            value: 1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_datum DATE;
                    BEGIN
                        glavna_knjiga_pkg.get_glavna_knjiga (
                            p_id              => :P222_GLAVNA_KNJIGA_ID,
                            p_datum_dokumenta => l_datum
                        );
                    
                        :P222_IZNOS := sif.acc_pkg.convert_to_bam (
                            p_valuta_id  => :P222_VALUTA_ID,
                            p_vrijednost => TO_NUMBER(:P222_VALUTA_IZNOS,'999G999G999G999G990D00'),
                            p_datum      => l_datum,
                            p_kurs       => :P222_KURS
                        );
                    END;
                    ```
                itemsToSubmit: [
                    P222_VALUTA_IZNOS
                    P222_IZNOS
                    P222_VALUTA_ID
                    P222_KURS
                ]
                itemsToReturn: P222_IZNOS
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode: :P222_VALUTA_IZNOS := null;
                itemsToSubmit: P222_VALUTA_IZNOS
                itemsToReturn: P222_VALUTA_IZNOS
                showProcessing: true
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

    )

    dynamicAction change-get-kurs (
        name: Change - Get kurs
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P222_VALUTA_ID
        }
        clientSideCondition {
            type: item!=value
            item: P222_VALUTA_ID
            value: 1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_datum DATE;
                    BEGIN
                        glavna_knjiga_pkg.get_glavna_knjiga (
                            p_id              => :P222_GLAVNA_KNJIGA_ID,
                            p_datum_dokumenta => l_datum
                        );
                    
                        sif.acc_pkg.get_valuta_history (
                            p_valuta_id => :P222_VALUTA_ID,
                            p_datum     => l_datum,
                            p_kurs      => :P222_KURS
                        );
                    
                    END;
                    ```
                itemsToSubmit: [
                    P222_VALUTA_ID
                    P222_KURS
                ]
                itemsToReturn: P222_KURS
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode: :P222_KURS := null;
                itemsToSubmit: P222_KURS
                itemsToReturn: P222_KURS
                showProcessing: true
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

    )

    dynamicAction change-prihod (
        name: Change - Prihod
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P222_PRIHOD_RASHOD
        }
        clientSideCondition {
            type: item=value
            item: P222_PRIHOD_RASHOD
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P222_VRSTA_PRIHODA_ID
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P222_VRSTA_PRIHODA_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction change-rashod (
        name: Change  - Rashod
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P222_PRIHOD_RASHOD
        }
        clientSideCondition {
            type: item=value
            item: P222_PRIHOD_RASHOD
