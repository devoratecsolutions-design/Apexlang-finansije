page 222 (
    name: Izvod / Stavka
    alias: IZVOD-STAVKA
    title: Izvod / Stavka
    pageGroup: @glavna-knjiga
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region izvod-stavka (
        name: Izvod / Stavka
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P222_GLAVNA_KNJIGA_ID (
        type: hidden
        layout {
            sequence: 20
            region: @izvod-stavka
            slot: regionBody
        }
    )

    pageItem P222_GRAD_ID (
        type: selectOne
        label {
            label: Šifra grada
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv || ' ( ' || lpad(sifra, 3, '0') || ' )' as d,
                    id as r
                FROM
                    sif.sif_gradovi g
                WHERE
                    (
                        :P222_KLIJENT_ID IS NOT NULL 
                        AND g.drzava_id = (
                            SELECT k.drzava_id
                            FROM sec_klijenti k
                            WHERE k.id = :P222_KLIJENT_ID
                        )
                    ) OR (
                        :P222_KLIJENT_ID IS NULL 
                        AND drzava_id = 28
                    )
                ```
        }
        cascadingLov {
            parentItems: P222_KLIJENT_ID
        }
        layout {
            sequence: 100
            region: @izvod-stavka
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P222_ID (
        type: hidden
        layout {
            sequence: 10
            region: @izvod-stavka
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P222_IZNOS (
        type: numberField
        label {
            label: Iznos
            alignment: left
        }
        layout {
            sequence: 70
            region: @izvod-stavka
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P222_KIF_ID (
        type: selectOne
        label {
            label: Izlazna faktura
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv_fakture AS d,
                    id AS r
                FROM
                    vw_kif
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND uplaceno = 'N'
                    AND lower(vrsta_naloga_sifra) != 'pr'
                    AND klijent_id = :P222_KLIJENT_ID
                ORDER BY
                    faktura_broj
                ```
        }
        cascadingLov {
            parentItems: P222_KLIJENT_ID
        }
        layout {
            sequence: 220
            region: @izvod-stavka
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P222_KLIJENT_ID (
        type: selectOne
        label {
            label: Klijent
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @sec-klijenti
        }
        layout {
            sequence: 90
            region: @izvod-stavka
            slot: regionBody
            alignment: left
