    validation iznos-not-null (
        name: Iznos NOT NULL
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P222_IZNOS
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P222_IZNOS
        }
    )

    validation konto-not-null (
        name: Konto NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P222_KONTNA_KLASA_ID
