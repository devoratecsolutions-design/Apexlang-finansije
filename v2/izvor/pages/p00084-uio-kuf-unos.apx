page 84 (
    name: UIO KUF - Unos
    alias: UIO-KUF-UNOS
    title: UIO KUF - Unos
    pageGroup: @uio-dokumentacija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region faktura-wrapper (
        name: Faktura Wrapper
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @kuf-unos
            slot: regionBody
        }
        appearance {
            template: @item-container
            templateOptions: [
                #DEFAULT#
                t-ItemContainer--alignStretch
            ]
        }
    )

    region kuf-unos (
        name: KUF - Unos
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P84_BROJ_FAKTURE (
        type: textField
        label {
            label: Broj fakture
            alignment: left
        }
        layout {
            sequence: 110
            region: @kuf-unos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        help {
            inlineHelpText: Za objašnjenje klikni upitnik.
            helpText:
                ```html
                Ako je tip dokumenta 01-03 – za broj fakture ili drugog dokumenta unosi se broj fakture. <br>
                Ako je tip dokumenta 04 - za broj fakture ili drugog dokumenta unosi se broj JCI. <br>
                Ako je tip dokumenta 05 - za broj fakture ili drugog dokumenta unosi se broj dokumenta koji se evidentira u poslovnim knjigama.<br>
                Ako je tip dokumenta 06 - za broj fakture ili drugog dokumenta unosi se broj KO po kojima je primljeno odobrenje od domaćih dobavljača i KO po kojima je primljeno odobrenje od INO dobavljača. <br>
                Ako je tip dokumenta 07-09 - za broj fakture ili drugog dokumenta unosi se broj dokumenta koji se evidentira u poslovnim knjigama.
                ```
        }
    )

    pageItem P84_DATUM_FAKTURE (
        type: datePicker
        label {
            label: Datum fakture
            alignment: left
        }
        layout {
            sequence: 120
            region: @kuf-unos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            inlineHelpText: Za objašnjenje klikni upitnik.
            helpText:
                ```html
                Ako je Tip dokumenta 01-03 – za datum fakture ili drugog dokumenta unosi se datum fakture <br>
                Ako je Tip dokumenta 04 - za datum fakture ili drugog dokumenta unosi se datum JCI <br>
                Ako je Tip dokumenta 05 - za datum fakture ili drugog dokumenta unosi se datum dokumenta koji se evidentira u poslovnim knjigama<br>
                Ako je Tip dokumenta 06, za datum fakture ili drugog dokumenta unosi se datum <b>KO</b><br>
                Ako je Tip dokumenta 07-09, za datum fakture ili drugog dokumenta, unosi se datum dokumenta koji se evidentira u poslovnim knjigama
                ```
        }
    )

    pageItem P84_DATUM_PRIJEMA_FAKTURE (
        type: datePicker
        label {
            label: Datum prijema fakture
            alignment: left
        }
        layout {
            sequence: 130
            region: @kuf-unos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            inlineHelpText: Za objašnjenje klikni upitnik.
            helpText: Unosi se datum kad je obveznik zaista zaprimio predmetnu fakturu ili drugi dokument, tj. datum kada je evidentirana faktura ili dokument. Ako se ova dva datuma razlikuju onda se unosi datum kada je faktura evidentirana u knjigovodstvenim evidencijama.
        }
    )

    pageItem P84_DUMMY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @kuf-unos
            slot: regionBody
        }
    )

    pageItem P84_FAKTURA_ID (
        type: selectOne
        label {
            label: Faktura
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv_fakture || ' - ' || klijent_naziv || '(' || naziv || ')' AS d,
                    id AS r
                FROM
                    vw_kuf_lista
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND status = 'Z'
                    AND id not IN (
                        SELECT faktura_id
                        FROM uio_kuf
                        WHERE
                            ooj_id = :APP_OOJ_ID
                            and faktura_id is not null
                    )
                    
                ORDER BY
                    broj
                ```
        }
        layout {
            sequence: 10
            region: @faktura-wrapper
            slot: item
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            authorizationScheme: @fakture-kuf
        }
    )

