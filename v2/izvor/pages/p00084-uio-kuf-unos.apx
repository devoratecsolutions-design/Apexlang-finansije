    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 83
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Sačuvaj unos u KUF
        layout {
            sequence: 10
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P84_ID
        }
    )

    button new-kuf (
        buttonName: NEW_KUF
        label: Nova ulazna faktura
        layout {
            sequence: 10
            region: @faktura-wrapper
            slot: buttonEnd
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 41
                items: {
                    P41_ORIG: 84
                }
                clearCache: 41
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction clear-on-change (
        name: clear on change
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P84_PS
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P84_IZNOS_FAKTURE_BEZPDV
                    P84_IZNOS_FAKTURE_SAPDV
                    P84_IZNOS_PAUSAL
                    P84_IZNOS_ULAZNOG_PDV
                    P84_IZNOS_ULAZPDV_ODBITI
                    P84_IZNOS_ULAZPDV_NEODBITI
                    P84_IZNOS_PDV_32POLJE
                    P84_IZNOS_PDV_33POLJE
                    P84_IZNOS_PDV_34POLJE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction get-kuf-data (
        name: GET KUF DATA
        execution {
            sequence: 9
        }
        when {
            selectionType: items
            items: P84_FAKTURA_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P84_FAKTURA_ID IS NOT null THEN
                        finansije_pkg.get_kuf (  
                            p_id                    => :P84_FAKTURA_ID,
                            p_glavna_knjiga_id      => :P84_DUMMY,
                            p_ooj_id                => :P84_DUMMY,
                            p_klijent_id            => :P84_DUMMY,
                            p_datum_prijema         => :P84_DATUM_PRIJEMA_FAKTURE,
                            p_datum_fakture         => :P84_DATUM_FAKTURE,
                            p_datum_valute          => :P84_DUMMY,
                            p_iznos_bez_pdv         => :P84_IZNOS_FAKTURE_BEZPDV,
                            p_iznos_sa_pdv          => :P84_IZNOS_FAKTURE_SAPDV,
                            p_valuta_id             => :P84_DUMMY,
                            p_valuta_iznos_bez_pdv  => :P84_DUMMY,
                            p_valuta_iznos_sa_pdv   => :P84_DUMMY,
                            p_tip_placanja_id       => :P84_DUMMY,
                            p_fiskalni_racun_broj   => :P84_DUMMY,
                            p_naziv_fakture         => :P84_BROJ_FAKTURE,
                            p_uio_tip_dokumenta_id  => :P84_TIP_DOKUMENTA,
                            p_naziv                 => :P84_DUMMY,
                            p_broj                  => :P84_DUMMY,
                            p_valid                 => :P84_DUMMY
                        ); 
                    END IF;
                    ```
                itemsToSubmit: [
                    P84_FAKTURA_ID
                    P84_TIP_DOKUMENTA
                ]
                itemsToReturn: [
                    P84_DATUM_PRIJEMA_FAKTURE
                    P84_DATUM_FAKTURE
                    P84_IZNOS_FAKTURE_BEZPDV
                    P84_IZNOS_FAKTURE_SAPDV
                    P84_BROJ_FAKTURE
                    P84_TIP_DOKUMENTA
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P84_PORESKI_PERIOD
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P84_REDNI_BR := uio_pkg.get_uio_kif_redni_broj (
                        p_ooj_id         => :APP_OOJ_ID,
                        p_poreski_period => :P84_PORESKI_PERIOD
                    );
                    ```
                itemsToSubmit: [
                    P84_PORESKI_PERIOD
                    P84_REDNI_BR
                ]
                itemsToReturn: P84_REDNI_BR
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction racunaj-polja (
        name: racunaj polja
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P84_IZNOS_FAKTURE_BEZPDV
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: [
                    P84_IZNOS_FAKTURE_BEZPDV
                    P84_IZNOS_FAKTURE_SAPDV
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_sa_pdv number;
                    v_pdv_in number;
                    v_zarez number;
                    -- V_APP_PDV_BROJ varchar2(13);
                    begin
                    select instr(:P84_IZNOS_FAKTURE_BEZPDV,',') into v_zarez from dual;
                    if (V_zarez > 0) then
                        null;
                        else
                    
                    case when :P84_PS ='Y' then
                            if(:P84_PIB_BROJ_DOBAVLJACA is not null and :P84_PIB_BROJ_DOBAVLJACA<> '000000000000') then
                             v_sa_pdv := to_char(:P84_IZNOS_FAKTURE_BEZPDV*1.17,'fm999999990.00');
                             v_pdv_in := v_sa_pdv - :P84_IZNOS_FAKTURE_BEZPDV;
                             :P84_IZNOS_FAKTURE_SAPDV := to_char( v_sa_pdv, 'fm99999990.00');
                             :P84_IZNOS_ULAZNOG_PDV := to_char ( v_pdv_in, 'fm99999990.00');
                             :P84_IZNOS_ULAZPDV_ODBITI := to_char ( v_pdv_in, 'fm99999990.00');
                             :P84_IZNOS_ULAZPDV_NEODBITI :=null;
                             :P84_IZNOS_PDV_32POLJE := null;
                             :P84_IZNOS_PDV_33POLJE := null;
                             :P84_IZNOS_PDV_34POLJE := null;
                            else
                             :P84_IZNOS_FAKTURE_SAPDV := to_char(:P84_IZNOS_FAKTURE_BEZPDV,'fm99999990.00');
                             :P84_IZNOS_ULAZNOG_PDV := null;
                             :P84_IZNOS_ULAZPDV_ODBITI := null;
                             :P84_IZNOS_ULAZPDV_NEODBITI :=null;
                             :P84_IZNOS_PDV_32POLJE := null;
                             :P84_IZNOS_PDV_33POLJE := null;
                             :P84_IZNOS_PDV_34POLJE := null;
                            end if;
                        when :P84_PS = 'N' then
                            if(:P84_PIB_BROJ_DOBAVLJACA is not null and :P84_PIB_BROJ_DOBAVLJACA<> '000000000000') then
                             v_sa_pdv := to_char(:P84_IZNOS_FAKTURE_BEZPDV*1.17,'fm99999990.00');
                             v_pdv_in := v_sa_pdv - :P84_IZNOS_FAKTURE_BEZPDV;
                             :P84_IZNOS_FAKTURE_SAPDV := to_char( v_sa_pdv, 'fm99999990.00');
                             :P84_IZNOS_ULAZNOG_PDV := to_char ( v_pdv_in, 'fm99999990.00');
                             :P84_IZNOS_ULAZPDV_ODBITI :=null;         
                             :P84_IZNOS_ULAZPDV_NEODBITI := to_char ( v_pdv_in, 'fm99999990.00');
                                case when substr(:APP_PDV_BROJ,0,1) in (2,3) then
                                    :P84_IZNOS_PDV_32POLJE := to_char(v_pdv_in,'fm99999990.00');
                                    when substr(:APP_PDV_BROJ,0,1) in (4,5) then
                                    :P84_IZNOS_PDV_33POLJE := to_char(v_pdv_in,'fm99999990.00');
                                    when substr(:APP_PDV_BROJ,0,1) in (6,7) then
                                    :P84_IZNOS_PDV_34POLJE := to_char(v_pdv_in,'fm99999990.00');
                                    else
                                    null;
                                end case;
                                
                            else
                             :P84_IZNOS_FAKTURE_SAPDV := :P84_IZNOS_FAKTURE_BEZPDV;
                             :P84_IZNOS_ULAZNOG_PDV := null;
                             :P84_IZNOS_ULAZPDV_ODBITI := null;
                             :P84_IZNOS_ULAZPDV_NEODBITI :=null;
                             :P84_IZNOS_PDV_32POLJE := null;
                             :P84_IZNOS_PDV_33POLJE := null;
                             :P84_IZNOS_PDV_34POLJE := null;
                            end if;
                        /*else
                            null;*/
                        end case;
                    end if;
                    end;
                    ```
                itemsToSubmit: [
                    P84_IZNOS_FAKTURE_BEZPDV
                    P84_IZNOS_FAKTURE_SAPDV
                    P84_IZNOS_PAUSAL
                    P84_IZNOS_ULAZNOG_PDV
                    P84_IZNOS_ULAZPDV_ODBITI
                    P84_IZNOS_ULAZPDV_NEODBITI
                    P84_IZNOS_PDV_32POLJE
                    P84_IZNOS_PDV_33POLJE
                    P84_IZNOS_PDV_34POLJE
                    P84_PS
                ]
                itemsToReturn: [
                    P84_IZNOS_PAUSAL
                    P84_IZNOS_ULAZNOG_PDV
                    P84_IZNOS_ULAZPDV_ODBITI
                    P84_IZNOS_ULAZPDV_NEODBITI
                    P84_IZNOS_PDV_32POLJE
                    P84_IZNOS_PDV_33POLJE
                    P84_IZNOS_PDV_34POLJE
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction set-poreski-period (
        name: set poreski period
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P84_FAKTURA_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: null;
                itemsToSubmit: P84_FAKTURA_ID
            }
            execution {
                sequence: 10
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_mj varchar2(2);
                    v_god varchar2(2);
                    v_sa_pdv number;
                    v_pdv_in number;
                    v_app_pdv varchar2(12);
                    begin
                    if :P84_FAKTURA_ID is not null then
                    
                        select substr(datum_fakture,9,2),substr(datum_fakture,4,2),klijent_id into v_god,v_mj,:P84_KLIJENT_ID
                        from kuf
                        where id = :P84_FAKTURA_ID;
                        select pib into v_app_pdv from core.ooj where id = :APP_OOJ_ID;
                    
                        :P84_PORESKI_PERIOD := v_god||v_mj;
                    
                        SEC_PKG.get_klijent (
                                p_id     => :P84_KLIJENT_ID,
                                p_naziv  => :P84_NAZIV_DOBAVLJACA,
                                p_sjediste => :P84_SJEDISTE_DOBAVLJACA,
                                
                                p_pib    =>   :P84_PIB_BROJ_DOBAVLJACA,
                                p_jib    =>   :P84_JIB_BROJ_DOBAVLJACA
                            );
                    else null;
                    end if;
                    end;
                    ```
                itemsToSubmit: [
                    P84_FAKTURA_ID
                    P84_PORESKI_PERIOD
                    P84_KLIJENT_ID
                ]
                itemsToReturn: [
                    P84_PORESKI_PERIOD
                    P84_KLIJENT_ID
                    P84_PIB_BROJ_DOBAVLJACA
                    " P84_JIB_BROJ_DOBAVLJACA"
                    P84_IZNOS_FAKTURE_BEZPDV
                    P84_NAZIV_DOBAVLJACA
                    P84_SJEDISTE_DOBAVLJACA
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

    )

