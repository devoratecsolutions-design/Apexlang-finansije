    process inser-uio-kuf (
        name: inser uio kuf
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    tip_doc VARCHAR2(2);
                BEGIN
                    SELECT 
                        code  
                    INTO  
                        tip_doc 
                    FROM  
                        sif.acc_uio_tipovi_dokumenata 
                    WHERE 
                        id =:P84_TIP_DOKUMENTA;
                 
                 
                 UIO_PKG.insert_uio_kuf(
                    P_OOJ_ID                                  => :APP_OOJ_ID,
                    P_FAKTURA_ID                              => :P84_FAKTURA_ID,
                    P_VRSTA_SLOGA                             => 2,
                    P_REDNI_BR                                => :P84_REDNI_BR,
                    P_TIP_DOKUMENTA                           => tip_doc,
                    P_BROJ_FAKTURE                            => :P84_BROJ_FAKTURE,
                    P_DATUM_FAKTURE                           => :P84_DATUM_FAKTURE,
                    P_DATUM_PRIJEMA_FAKTURE                   => :P84_DATUM_PRIJEMA_FAKTURE,
                    P_NAZIV_DOBAVLJACA                        => :P84_NAZIV_DOBAVLJACA,
                    P_SJEDISTE_DOBAVLJACA                     => :P84_SJEDISTE_DOBAVLJACA,
                    P_PDV_BROJ_DOBAVLJACA                     => lpad(:P84_PIB_BROJ_DOBAVLJACA,12,0),
                    P_JIB_BROJ_DOBAVLJACA                     => lpad(:P84_JIB_BROJ_DOBAVLJACA,13,0),
                    P_IZNOS_FAKTURE_BEZPDV                    => to_char(nvl(:P84_IZNOS_FAKTURE_BEZPDV,0) ,'fm9999999990.00'),
                    P_IZNOS_FAKTURE_SAPDV                     => to_char(nvl(:P84_IZNOS_FAKTURE_SAPDV ,0) ,'fm9999999990.00'),
                    P_IZNOS_PAUSAL                            => to_char(nvl(:P84_IZNOS_PAUSAL        ,0) ,'fm9999999990.00'),
