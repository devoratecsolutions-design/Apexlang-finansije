page 20080 (
    name: Sekretarica
    alias: SEKRETARICA
    title: Sekretarica
    pageGroup: @erp-globalne-stranice
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        width: 640
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @sekretarica-ima-sekretaricu
        formAutoComplete: false
    }

    pageItem P20080_SEKRETARICE (
        type: selectMany
        label {
            label: Sekretarice
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sharedComponent
            lov: @sekretarice
        }
        layout {
            sequence: 20
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                margin-top-sm
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Podešavanja
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--link
                t-Button--iconLeft
            ]
            cssClasses: t-Button--inlineLink
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 20000
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button change (
        buttonName: CHANGE
        label: Promijeni sekretaricu
        layout {
            sequence: 40
            slot: contentBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 30
            slot: contentBody
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
    )

    validation sekretarice-not-null (
        name: Sekretarice NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P20080_SEKRETARICE
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P20080_SEKRETARICE
        }
        serverSideCondition {
            whenButtonPressed: @change
        }
    )

    process close-dialog (
        name: Close dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Uspješno promjenjena lozinka.
        }
        advanced {
            executionMappingIdentifier: 185186262159489097
        }
        serverSideCondition {
            whenButtonPressed: @cancel
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.korisnik_pkg.delete_korisnik_sekretarice (
                    p_korisnik_id => :APP_USER_ID
                );
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Uspješno promijenjena sekretarica.
        }
        advanced {
            executionMappingIdentifier: 185185492935489097
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.korisnik_pkg.get_korisnik_sekretarice (
                    p_korisnik_id => :APP_USER_ID,
                    p_sekretarice => :P20080_SEKRETARICE
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 185185097543489096
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.korisnik_pkg.insert_korisnik_sekretarice (
                    p_korisnik_id => :APP_USER_ID,
                    p_sekretarice => :P20080_SEKRETARICE
                );
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Uspješno promijenjena sekretarica.
        }
        advanced {
            executionMappingIdentifier: 185185895875489097
        }
        serverSideCondition {
            whenButtonPressed: @change
        }
    )

)

