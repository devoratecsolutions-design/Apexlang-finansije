    region knjiga-stalnih-sredstava (
        name: Knjiga stalnih sredstava
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH os AS (
                    SELECT
                        row_number() OVER (ORDER BY inventurni_broj) AS redni_broj,
                        naziv,
                        nabavna_vrijednost,
                        os_pkg.get_amortizacija_do_datuma(id, trunc(to_date(:P210_PORESKA_GODINA, 'YYYY'))) AS ispravka_vrijednosti,
                        vijek_trajanja,
                        amortizaciona_stopa,
                        os_pkg.get_amortizacija_za_godinu(id, :P210_PORESKA_GODINA) AS iznos_amortizacija,
                        prodajna_vrijednost
                        
                    FROM
                        vw_osnovna_sredstva
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND os_pkg.get_amortizacija_za_godinu(id, :P210_PORESKA_GODINA) > 0
                        AND aktivirano = 'Y'
                        AND priprema = 'N'
                    ORDER BY
                        inventurni_broj
                        
                )
                SELECT
                    redni_broj,
                    naziv,
                    nabavna_vrijednost,
                    ispravka_vrijednosti,
                    nabavna_vrijednost - ispravka_vrijednosti AS sadasnja_vrijednost,
                    vijek_trajanja,
                    amortizaciona_stopa,
                    iznos_amortizacija,
                    (nabavna_vrijednost - ispravka_vrijednosti - iznos_amortizacija) AS neotpisana_vrijednost,
                    prodajna_vrijednost,
                    (prodajna_vrijednost) - (nabavna_vrijednost - ispravka_vrijednosti - iznos_amortizacija) AS kapitalna_vrijednost
                            
                FROM
                    os
                ```
            pageItemsToSubmit: P210_PORESKA_GODINA
        }
        layout {
            sequence: 320
            slot: body
        }
