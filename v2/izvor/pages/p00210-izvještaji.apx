    pageItem P210_KONTNA_KLASA_ID (
        type: selectMany
        label {
            label: Konto
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        messages {
            noDataFoundMessage: Nema pronađenih podataka.
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv AS d,
                    kontna_klasa_id AS r
                FROM (
                    SELECT DISTINCT
                        kontna_klasa_code,
                        rpad(kontna_klasa_code, :APP_KONTO_DUZINA, '0') || ' - ' || kontna_klasa_naziv AS naziv,
                        kontna_klasa_id
                    FROM
                        vw_glavna_knjiga_stavke
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND proknjizeno = 'Y'
                        AND trunc(glavna_knjiga_datum_knjizenja) >= trunc(to_date(:P210_PERIOD_OD, 'DD.MM.YYYY'))
                        AND trunc(glavna_knjiga_datum_knjizenja) <= trunc(to_date(:P210_PERIOD_DO, 'DD.MM.YYYY'))
                    ORDER BY
                        to_number(rpad(kontna_klasa_code, :APP_KONTO_DUZINA, '0')) ASC
                )
                WHERE
                    kontna_klasa_id IS NOT null
                ```
        }
        cascadingLov {
            parentItems: [
                P210_PERIOD_OD
                P210_PERIOD_DO
