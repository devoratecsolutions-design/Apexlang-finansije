            }
            columnFormatting {
                htmlExpression: #CODE# - #NAZIV#
            }
            sorting {
                sortable: false
            }
        )

        column PROMET_D (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Promet - Duguje
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column PROMET_P (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Promet - Potražuje
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column SALDO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Saldo
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

    )

    region bruto-bilans-rekapitulacija (
        name: Bruto bilans - Rekapitulacija
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH kontni_okvir_hierarchy AS (
                    SELECT
                        id AS child_id,
                        CONNECT_BY_ROOT id AS parent_id
                    FROM 
                        sif.acc_kontni_okvir_klase
                    START WITH kontna_klasa_id IS NULL
                    CONNECT BY PRIOR id = kontna_klasa_id 
                ),
                
                kontna_klasa_ids AS (
                    SELECT DISTINCT 
                        k.child_id AS kontni_okvir_id,
                        k.parent_id AS root_parent_id
                    FROM 
                        kontni_okvir_hierarchy k
                    JOIN vw_glavna_knjiga_stavke v ON k.child_id = v.kontna_klasa_id
                    WHERE 
                        v.ooj_id = :APP_OOJ_ID
                        AND v.proknjizeno = 'Y'
                        -- AND v.glavna_knjiga_datum_knjizenja >= to_date(:P210_PERIOD_OD, 'DD.MM.YYYY')
                        AND v.glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY')
                        
                    UNION ALL
                    
                    SELECT 
                        to_number(column_value) AS kontni_okvir_id,
                        NULL AS root_parent_id  -- Direct inputs
                    FROM 
                        apex_string.split(:P210_KONTNA_KLASA_ID, ':')
                ),
                
                aggregated_data AS (
                    SELECT
                        h.parent_id AS root_parent_id,
                        SUM(CASE 
                                WHEN v.glavna_knjiga_datum_knjizenja <= TRUNC(ADD_MONTHS(to_date(:P210_PERIOD_OD, 'DD.MM.YYYY'), -12), 'YEAR') + INTERVAL '1' YEAR - INTERVAL '1' DAY 
                                THEN v.iznos ELSE 0 
                            END) AS godina,
                        SUM(CASE 
                                WHEN v.glavna_knjiga_datum_knjizenja >= TRUNC(to_date(:P210_PERIOD_OD, 'DD.MM.YYYY'), 'YEAR')
                                 AND v.glavna_knjiga_datum_knjizenja < to_date(:P210_PERIOD_OD, 'DD.MM.YYYY') 
                                THEN v.iznos ELSE 0 
                            END) AS kumulativno,
                            
                        SUM(CASE WHEN v.glavna_knjiga_datum_knjizenja >= to_date(:P210_PERIOD_OD, 'DD.MM.YYYY')
                                      AND v.glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY')
                                 AND v.tip_stavke = 'D' THEN (v.iznos) ELSE 0 
                            END) AS promet_d,
                        SUM(CASE WHEN v.glavna_knjiga_datum_knjizenja >= to_date(:P210_PERIOD_OD, 'DD.MM.YYYY')
                                      AND v.glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY')
                                 AND v.tip_stavke = 'P' THEN (v.iznos) ELSE 0 
                            END) AS promet_p,
                            
                            
                        SUM(CASE WHEN v.glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY') 
                                THEN v.iznos ELSE 0 
                            END) AS saldo
                    FROM 
                        vw_glavna_knjiga_stavke v
                    JOIN kontni_okvir_hierarchy h ON v.kontna_klasa_id = h.child_id
                    WHERE 
                        v.ooj_id = :APP_OOJ_ID
                        AND v.proknjizeno = 'Y'
                    GROUP BY 
                        h.parent_id
                )
                
                SELECT 
                    ko.code AS code,
                    ko.naziv AS naziv,
                    NVL(ad.godina, 0) AS godina,
                    NVL(ad.kumulativno, 0) AS kumulativno,
                    NVL(ad.promet_d, 0) AS promet_d,
                    NVL(ad.promet_p, 0) AS promet_p,
                    NVL(ad.saldo, 0) AS saldo
                FROM 
                    aggregated_data ad
                LEFT JOIN sif.acc_kontni_okvir_klase ko ON ad.root_parent_id = ko.id
                ORDER BY 
                    TO_NUMBER(ko.code);
                ```
            pageItemsToSubmit: [
                P210_KONTNA_KLASA_ID
                P210_PERIOD_OD
                P210_PERIOD_DO
            ]
        }
        layout {
            sequence: 250
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: item=value
            item: P210_IZVJESTAJ_SIFRA
            value: bbr
        }
        reportLayout {
            numberOfRows: 200
        }
        componentAppearance {
            template: @standard
            templateOptions: [
