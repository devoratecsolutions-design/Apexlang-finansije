                    valid = 'Y'
                    AND ooj_id = :APP_OOJ_ID
                    AND ((
                        :P210_VRSTA_KLIJENTA = 'K' AND vrsta_klijenta IN ('K', 'O')
                        OR :P210_VRSTA_KLIJENTA = 'D' AND vrsta_klijenta IN ('D', 'O')
                        OR :P210_VRSTA_KLIJENTA = 'O' AND vrsta_klijenta = 'O'
                
