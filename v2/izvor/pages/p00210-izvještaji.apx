    region bruto-bilans (
        name: Bruto bilans
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH 
                -- Parse kontna_klasa_list into a table (only if not empty)
                kontna_klasa_ids AS (
                    SELECT DISTINCT 
                        kontna_klasa_id AS kontni_okvir_id
                    FROM 
                        vw_glavna_knjiga_stavke
                    WHERE 
                        ooj_id = :APP_OOJ_ID
                        AND proknjizeno = 'Y'
                        AND (oj_id = :P210_OJ_ID OR :P210_OJ_ID is null)
                        AND glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY')
                        AND (:P210_KONTNA_KLASA_ID IS NULL OR :P210_KONTNA_KLASA_ID = '')
                      
                    UNION ALL
                    
                    SELECT
                        to_number(column_value) as kontni_okvir_id
                    FROM
                        apex_string.split(:P210_KONTNA_KLASA_ID, ':')
                ),
                -- Previous year's data
                previous_year_data AS (
                    SELECT 
                        kontna_klasa_id,
                        SUM(iznos) AS godina
                    FROM 
                        vw_glavna_knjiga_stavke
                    WHERE 
                        ooj_id = :APP_OOJ_ID
                        AND proknjizeno = 'Y'
                        AND (oj_id = :P210_OJ_ID OR :P210_OJ_ID is null)
                        AND glavna_knjiga_datum_knjizenja <= TRUNC(ADD_MONTHS(to_date(:P210_PERIOD_OD, 'DD.MM.YYYY'), -12), 'YEAR') + INTERVAL '1' YEAR - INTERVAL '1' DAY
                        AND kontna_klasa_id IN (SELECT kontni_okvir_id FROM kontna_klasa_ids)
                    GROUP BY 
                        kontna_klasa_id
                ),
                -- Cumulative data from the beginning of the current year to P210_PERIOD_OD
                cumulative_data AS (
                    SELECT 
                        kontna_klasa_id,
                        SUM(iznos) AS kumulativno
                    FROM 
                        vw_glavna_knjiga_stavke
                    WHERE 
                        ooj_id = :APP_OOJ_ID
                        AND proknjizeno = 'Y'
                        AND (oj_id = :P210_OJ_ID OR :P210_OJ_ID is null)
                        AND glavna_knjiga_datum_knjizenja >= TRUNC(to_date(:P210_PERIOD_OD, 'DD.MM.YYYY'), 'YEAR')
                        AND glavna_knjiga_datum_knjizenja < to_date(:P210_PERIOD_OD, 'DD.MM.YYYY')
                        AND kontna_klasa_id IN (SELECT kontni_okvir_id FROM kontna_klasa_ids)
                    GROUP BY 
                        kontna_klasa_id
                ),
                promet_data AS (
                    SELECT
                        kontna_klasa_id,
                        SUM(CASE WHEN tip_stavke = 'D' THEN iznos END) as promet_d,
                        SUM(CASE WHEN tip_stavke = 'P' THEN iznos END) as promet_p
                    FROM 
                        vw_glavna_knjiga_stavke
                    WHERE 
                        ooj_id = :APP_OOJ_ID
                        AND proknjizeno = 'Y'
                        AND (oj_id = :P210_OJ_ID OR :P210_OJ_ID is null)
                        AND glavna_knjiga_datum_knjizenja >= to_date(:P210_PERIOD_OD, 'DD.MM.YYYY')
                        AND glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY')
                        AND kontna_klasa_id IN (SELECT kontni_okvir_id FROM kontna_klasa_ids)
                    GROUP BY 
                        kontna_klasa_id
                ),
                -- Data for the start to P210_PERIOD_DO
                saldo_data AS (
                    SELECT 
                        kontna_klasa_id,
                        SUM(iznos) AS saldo
                    FROM 
                        vw_glavna_knjiga_stavke
                    WHERE 
                        ooj_id = :APP_OOJ_ID
                        AND proknjizeno = 'Y'
                        AND (oj_id = :P210_OJ_ID OR :P210_OJ_ID is null)
                        AND glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY')
                        AND kontna_klasa_id IN (SELECT kontni_okvir_id FROM kontna_klasa_ids)
                    GROUP BY 
                        kontna_klasa_id
                )
                -- Combine results into the final report
                SELECT 
                    rpad(code, :APP_KONTO_DUZINA, '0') AS code,
                    ko.naziv AS naziv,
                    NVL(py.godina, 0) AS godina,
                    NVL(cd.kumulativno, 0) AS kumulativno,
                    NVL(pd.promet_d, 0) AS promet_d,
                    NVL(pd.promet_p, 0) AS promet_p,
                    NVL(sd.saldo, 0) AS saldo
                FROM 
                    kontna_klasa_ids k
                    LEFT JOIN previous_year_data py ON k.kontni_okvir_id = py.kontna_klasa_id
                    LEFT JOIN cumulative_data cd ON k.kontni_okvir_id = cd.kontna_klasa_id
                    LEFT JOIN promet_data pd ON k.kontni_okvir_id = pd.kontna_klasa_id
                    LEFT JOIN saldo_data sd ON k.kontni_okvir_id = sd.kontna_klasa_id
                    LEFT JOIN sif.acc_kontni_okvir_klase ko ON k.kontni_okvir_id = ko.id
                ORDER BY 
                    to_number(rpad(code, :APP_KONTO_DUZINA, '0')) ASC
                ```
            pageItemsToSubmit: [
                P210_KONTNA_KLASA_ID
                P210_PERIOD_OD
                P210_PERIOD_DO
                P210_OJ_ID
            ]
        }
        layout {
            sequence: 240
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: item=value
            item: P210_IZVJESTAJ_SIFRA
            value: bb
        }
        reportLayout {
            numberOfRows: 200
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlightOff
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        breakFormatting {
            reportSumLabel: Ukupno
        }

