    region knjiga-potraživanja-i-obaveza-kuf (
        name: Knjiga potraživanja i obaveza / KUF
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH kuf AS (
                    SELECT
                        row_number() OVER (ORDER BY datum_fakture, broj) AS redni_broj,
                        id,
                        klijent_naziv,
                        naziv_fakture,
                        datum_fakture,
                        iznos_bez_pdv,
                        pdv,
                        iznos_sa_pdv
                        
                    FROM
                        vw_kuf
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND godina = :P210_PORESKA_GODINA
                ),
                izvodi AS (
                    SELECT
                        kuf_id,
                        glavna_knjiga_opis,
                        glavna_knjiga_datum_knjizenja,
                        abs(iznos) as iznos
                    FROM
                        vw_glavna_knjiga_stavke gks
                        LEFT JOIN kuf ON gks.kuf_id = kuf.id
                    WHERE
                        vrsta_naloga_sifra = 'IZ'
                        AND proknjizeno = 'Y'
                ),
                kalkulacija AS (
                    SELECT
                        kuf.redni_broj,
                        kuf.klijent_naziv,
                        kuf.naziv_fakture,
                        kuf.datum_fakture,
                        kuf.iznos_bez_pdv,
                        kuf.pdv,
                        kuf.iznos_sa_pdv,
                        
                        i.glavna_knjiga_opis,
                        i.glavna_knjiga_datum_knjizenja,
                        i.iznos,
                
                        (kuf.iznos_sa_pdv - 
                         SUM(coalesce(i.iznos, 0)) OVER (
                             PARTITION BY kuf.id 
                             ORDER BY i.glavna_knjiga_datum_knjizenja
                         )
                        ) AS saldo
                        
                --        (coalesce(kif.iznos_fakture, 0) - coalesce(i.iznos, 0)) AS saldo
                    FROM
                        kuf
                        LEFT JOIN izvodi i ON i.kuf_id = kuf.id
                ),
                final AS (
                    SELECT
                        k.*,
                        CASE
                            WHEN ROW_NUMBER() OVER (
                                PARTITION BY redni_broj
                                ORDER BY glavna_knjiga_datum_knjizenja DESC
                            ) = 1
                            THEN saldo
                            ELSE null
                        END AS saldo_for_cumulative
                    FROM kalkulacija k
                )
                SELECT
                    redni_broj,
                    klijent_naziv,
                    naziv_fakture,
                    datum_fakture,
                    iznos_bez_pdv,
                    pdv,
                    iznos_sa_pdv,
                    glavna_knjiga_opis,
                    glavna_knjiga_datum_knjizenja,
                    iznos,
                    saldo,
                    SUM(coalesce(saldo_for_cumulative, 0)) OVER (ORDER BY redni_broj) AS kumulativni_saldo
                FROM final
                ORDER BY 
                    redni_broj,
                    glavna_knjiga_datum_knjizenja ASC
                
                ```
            pageItemsToSubmit: P210_PORESKA_GODINA
        }
        layout {
            sequence: 340
            slot: body
        }
