    dynamicAction print-izvjestaj (
        name: Print - Izvjestaj
        execution {
            sequence: 170
        }
        when {
            event: click
            selectionType: button
            button: @print
        }
        config {
            buildOption: @feature-printing
        }

        action bb-print (
            name: BB - Print
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    generate_report(  
                        filename = 'bruto_bilans_' + $v("P210_PERIOD_OD") + '-' + $v("P210_PERIOD_DO"), 
                        report_path = '/reports/ACCOUNTING/izvjestaji/bruto_bilans', 
                        report_parameters = {
                            OOJ_ID: &APP_OOJ_ID.,
                            PERIOD_OD: $v("P210_PERIOD_OD"),
                            PERIOD_DO: $v("P210_PERIOD_DO"),
                            KONTNA_KLASA_ID: $v("P210_KONTNA_KLASA_ID")
                        },
                        new_tab = false
                    );
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsInList
                item: P210_IZVJESTAJ_SIFRA
                list: [
                    bb
                    bbr
                ]
            }
            config {
                buildOption: @feature-printing
            }
        )

        action kp-print (
            name: KP - Print
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var app_ooj_id = '&APP_OOJ_ID.';
                    generate_report(
                      
                        filename = 'KP '+$v("P210_PORESKA_GODINA"), 
                        report_path = '/reports/ACCOUNTING/izvjestaji/knjiga_prometa', 
                        report_parameters = {
                            OOJ_ID: app_ooj_id,
                            GODINA: $v("P210_PORESKA_GODINA")
                        },
                        new_tab = false
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P210_IZVJESTAJ_SIFRA
                value: kp
            }
            config {
                buildOption: @feature-printing
            }
        )

        action kzr-print (
            name: KZR - Print
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var app_ooj_id = '&APP_OOJ_ID.';
                    generate_report(
                      
                        filename = 'KZR '+$v("P210_PORESKA_GODINA"), 
                        report_path = '/reports/ACCOUNTING/izvjestaji/knjiga_ziro_racuna', 
                        report_parameters = {
