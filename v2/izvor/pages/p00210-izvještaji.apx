page 210 (
    name: Izvještaji
    alias: IZVJEŠTAJI
    title: &P210_TITLE.
    pageGroup: @glavna-knjiga
    appearance {
        pageTemplate: @left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: [
            #WORKSPACE_FILES#jasper-server#MIN#.js
            #WORKSPACE_FILES#left-side-toggle#MIN#.js
        ]
    }
    css {
        fileUrls: #WORKSPACE_FILES#left-side-toggle#MIN#.css
    }
    security {
        authorizationScheme: @glavna-knjiga-izvještaji
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            Stranica <b><em>"Izvještaji"</em></b> kreirana je tako da povlači 
            sve izvještaje iz <b><em>"Glavne knjige."</em></b> 
            Izvještaji su grupisani po tabovima i klikom na određeni tab otvara se željeni izvještaj. </br>
            Za svaki izvještaj potrebno je unijeti određene parametre kako bi se prikazali rezultati.</br>
            </br>
            Najčešće se unose period od, period do, klasa konta, konto, organizaciona jedinica, klijenti, 
            vrsta naloga, PDV indikator i vrsta klijenta, ali se parametri razlikuju zavisno od izvještaja. </br>
            Nakon unosa podataka, izborom opcije <b><em>"Generiši"</em></b> izvještaj dobijate traženi prikaz.
            ```
    }

    region bilans-stanja (
        name: Bilans stanja
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    datum_do,
                    created,
                    created_by
                FROM
                    sec_izvjestaji
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND izvjestaj_id = :P210_IZVJESTAJ_ID
                ORDER BY
                    id DESC
                ```
