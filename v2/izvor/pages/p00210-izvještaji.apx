    dynamicAction calculate-kontna-klasa (
        name: Calculate - Kontna klasa
        execution {
            sequence: 1
        }
        when {
            selectionType: items
            items: P210_KLASA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT
                        listagg(kontna_klasa_id, ':')
                    INTO
                        :P210_KONTNA_KLASA_ID
                    FROM (
                        SELECT DISTINCT
                            kontna_klasa_id
                        FROM
                            vw_glavna_knjiga_stavke
                        WHERE
                            ooj_id = :APP_OOJ_ID
                            AND proknjizeno = 'Y'
                            AND trunc(glavna_knjiga_datum_knjizenja) >= trunc(to_date(:P210_PERIOD_OD, 'DD.MM.YYYY'))
                            AND trunc(glavna_knjiga_datum_knjizenja) <= trunc(to_date(:P210_PERIOD_DO, 'DD.MM.YYYY'))
                            AND kontna_klasa_code LIKE (
                                SELECT s.code || '%'
                                FROM sif.acc_kontni_okvir_klase s
                                WHERE
                                    s.id = :P210_KLASA
                            )
                    );
                    
                    IF :P210_KONTNA_KLASA_ID IS null THEN
                        :P210_KONTNA_KLASA_ID := :P210_KLASA;
                    END IF;
                    ```
                itemsToSubmit: [
                    P210_KONTNA_KLASA_ID
                    P210_KLASA
                ]
                itemsToReturn: P210_KONTNA_KLASA_ID
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

