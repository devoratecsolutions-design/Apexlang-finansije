    region kartica-konta (
        name: Kartica konta
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    glavna_knjiga_id,
                    lpad(glavna_knjiga_broj, 6, '0') as glavna_knjiga_broj,
                    glavna_knjiga_datum_knjizenja as poreski_period,
                    vrsta_naloga_naziv,
                    tip_stavke_naziv,
                    opis,
                    iznos,
                    kontna_klasa_id,
                    pdv_indikator_id,
                    klijent_id,
                    grad_id,
                    glavna_knjiga_godina as godina
                FROM 
                    vw_glavna_knjiga_stavke
                where 
                    ooj_id = :APP_OOJ_ID
                    AND trunc(glavna_knjiga_datum_knjizenja) >= :P210_PERIOD_OD
                    AND trunc(glavna_knjiga_datum_knjizenja) <= :P210_PERIOD_DO
                    AND (pdv_indikator_id IN (
                        SELECT column_value
                        FROM apex_string.split(:P210_PDV_INDIKATOR_ID, ':')
