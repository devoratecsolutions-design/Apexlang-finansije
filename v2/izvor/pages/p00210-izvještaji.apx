    region obrazac-1007-godišnje (
        name: Obrazac 1007 - godišnje
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH obrazac_1007 AS (
                    SELECT
                        ooj.jib,
                        ooj.naziv,
                        ooj.adresa,
                        lpad(ooj.grad_sifra, 3, '0') AS grad_sifra,
                        ooj.tel,
                        ooj.email,
                        gks.iznos,
                        trunc(gks.glavna_knjiga_datum_knjizenja, 'YYYY') AS datum_knjizenja
                    FROM
                        vw_glavna_knjiga_stavke gks
                        LEFT JOIN core.vw_ooj ooj ON gks.ooj_id = ooj.id
                    WHERE
                        prihod_rashod = 'P'
                        AND lower(vrsta_naloga_sifra) = 'iz'
                        AND ooj_id = :APP_OOJ_ID
                        AND extract(year from gks.glavna_knjiga_datum_knjizenja)= :P210_PORESKA_GODINA
                )
                SELECT
                    jib,
                    naziv,
                    adresa,
                    grad_sifra,
                    tel,
                    email,
                    greatest(sum(abs(iznos)) * 0.02, 600) AS porez,
                    sum(abs(iznos)) AS naplaceni_prihod,
                
                    datum_knjizenja AS poreski_period_od,
                    add_months(datum_knjizenja, 12) - 1 AS poreski_period_do
                FROM
                    obrazac_1007
                GROUP BY
                    jib,
                    naziv,
                    adresa,
                    grad_sifra,
                    tel,
                    email,
                    datum_knjizenja
                ```
            pageItemsToSubmit: P210_PORESKA_GODINA
        }
