    region promet-klijenta (
        name: Promet klijenta
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH klijenti AS (
                    SELECT
                        id,
                        naziv,
                        adresa,
                        grad,
                        ziro_racun,
                        tel
                    FROM
                        sec_klijenti
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND (vrsta_klijenta = :P210_VRSTA_KLIJENTA OR :P210_VRSTA_KLIJENTA IS null)
                        AND (id IN (
                            SELECT 
                                column_value
                            FROM 
                                apex_string.split(:P210_KLIJENT_ID, ':')
                        ) OR :P210_KLIJENT_ID IS null)
                        AND id IN (
                            SELECT 
                                gks.klijent_id
                            FROM 
                                vw_glavna_knjiga_stavke gks
                            WHERE
                                gks.klijent_id IS NOT null
                                AND gks.proknjizeno = 'Y'
                                AND gks.glavna_knjiga_datum_knjizenja >= to_date(:P210_PERIOD_OD, 'DD.MM.YYYY')
                                AND gks.glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY')
                                AND (
                                    CASE
                                        WHEN :P210_VRSTA_KLIJENTA = 'K' AND (gks.kontna_klasa_code LIKE '2%' OR gks.kontna_klasa_code LIKE '430%') THEN 1
                                        WHEN :P210_VRSTA_KLIJENTA = 'D' AND (gks.kontna_klasa_code LIKE '4%') THEN 1
                                        WHEN :P210_VRSTA_KLIJENTA = 'O' AND (gks.kontna_klasa_code LIKE '2%' OR gks.kontna_klasa_code LIKE '4%') THEN 1
                                        ELSE 0
                                    END
                                )  = 1
                        )
                ), glavna_knjiga_stavke AS (
                    SELECT
                        gks.klijent_id,
                        gks.kontna_klasa_id,
                        SUM(
                            CASE WHEN gks.tip_stavke = 'P' THEN 
                                iznos
                            ELSE
                                0
                        END) AS sum_p,
                        SUM(
                            CASE WHEN gks.tip_stavke = 'D' THEN 
                                iznos
                            ELSE
                                0
                        END) AS sum_d
                    FROM
                        vw_glavna_knjiga_stavke gks
                        LEFT JOIN klijenti k ON gks.klijent_id = k.id
                    WHERE
                        gks.klijent_id IS NOT null
                        AND gks.proknjizeno = 'Y'
                        AND gks.glavna_knjiga_datum_knjizenja >= to_date(:P210_PERIOD_OD, 'DD.MM.YYYY')
                        AND gks.glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY')
                        AND (
                            CASE
                                WHEN :P210_VRSTA_KLIJENTA IN ('K', 'O') AND (gks.kontna_klasa_code LIKE '2%' OR gks.kontna_klasa_code LIKE '430%') THEN 1
                                WHEN :P210_VRSTA_KLIJENTA IN ('D', 'O') AND (gks.kontna_klasa_code LIKE '4%' AND gks.kontna_klasa_code NOT LIKE '430%') THEN 1
                                ELSE 0
                            END
                        )  = 1
                    GROUP BY
                        gks.klijent_id,
                        gks.kontna_klasa_id
                )
                SELECT
                    id,
                    naziv,
                    adresa,
                    grad,
                    ziro_racun,
                    tel,
                    kontna_klasa_id,
                    sum_d,
                    sum_p,
                    (sum_d + sum_p) as sum_saldo
                FROM
                    klijenti k
                    LEFT JOIN glavna_knjiga_stavke gks ON gks.klijent_id = k.id
                ```
            pageItemsToSubmit: [
                P210_PERIOD_OD
                P210_PERIOD_DO
                P210_VRSTA_KLIJENTA
                P210_KLIJENT_ID
            ]
        }
        layout {
            sequence: 280
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
