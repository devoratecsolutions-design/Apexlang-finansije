    region kartica-klijenta (
        name: Kartica klijenta
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH klijenti AS (
                    SELECT
                        id as klijent_id,
                        naziv
                    FROM
                        sec_klijenti
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND (
                            CASE
                                WHEN :P210_VRSTA_KLIJENTA = 'K' AND vrsta_klijenta IN ('K', 'O') THEN 1
                                WHEN :P210_VRSTA_KLIJENTA = 'D' AND vrsta_klijenta IN ('D', 'O') THEN 1
                                WHEN :P210_VRSTA_KLIJENTA = 'O' AND vrsta_klijenta IN ('O') THEN 1
                                WHEN :P210_VRSTA_KLIJENTA IS null THEN 1
                                ELSE 0
                            END
                        ) = 1
                        AND (id IN (
                            SELECT 
                                column_value
                            FROM 
                                apex_string.split(:P210_KLIJENT_ID, ':')
                        ) OR :P210_KLIJENT_ID IS null)
                        AND id IN (
                            SELECT 
                                gks.klijent_id
                            FROM 
                                vw_glavna_knjiga_stavke gks
                            WHERE
                                gks.klijent_id IS NOT null
                                AND gks.proknjizeno = 'Y'
                                AND gks.glavna_knjiga_datum_knjizenja >= to_date(:P210_PERIOD_OD, 'DD.MM.YYYY')
                                AND gks.glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY')
                                -- AND (vrsta_naloga_id = :P210_VRSTA_NALOGA_ID OR :P210_VRSTA_NALOGA_ID IS null)
                                AND (
                                    vrsta_naloga_id IN (
                                        SELECT 
                                            column_value
                                        FROM 
                                            apex_string.split(:P210_VRSTA_NALOGA_ID, ':')
                                    ) OR :P210_VRSTA_NALOGA_ID IS null
                                )
                                AND (
                                    CASE
                                        WHEN :P210_VRSTA_KLIJENTA IN ('K', 'O') AND (gks.kontna_klasa_code LIKE '2%' OR gks.kontna_klasa_code LIKE '430%') THEN 1
                                        WHEN :P210_VRSTA_KLIJENTA IN ('D', 'O') AND (gks.kontna_klasa_code LIKE '4%' AND gks.kontna_klasa_code NOT LIKE '430%') THEN 1
                                        ELSE 0
                                    END
                                ) = 1
                        )
                ), glavna_knjiga_stavke AS (
                    SELECT
                        gks.klijent_id,
                        gks.glavna_knjiga_id,
                        lpad(gks.glavna_knjiga_broj, 6, '0') as glavna_knjiga_broj,
                        CASE
                            WHEN lower(vrsta_naloga_sifra) = 'iz' THEN
                                gks.glavna_knjiga_opis
                            WHEN lower(vrsta_naloga_sifra) IN ('if', 'ifs', 'av', 'avs', 'ko', 'kos', 'kz', 'kzs', 'in', 'ins') THEN
                                (
                                    SELECT naziv_fakture
                                    FROM kif k
                                    WHERE
                                        k.glavna_knjiga_id = gks.glavna_knjiga_id
                                )
                            WHEN lower(vrsta_naloga_sifra) IN ('uf') THEN
                                (
                                    SELECT
                                        naziv_fakture
                                    FROM
                                        kuf k
                                    WHERE
                                        k.glavna_knjiga_id = gks.glavna_knjiga_id
                                )
                        END AS informacije,
                        gks.glavna_knjiga_datum_knjizenja,
                        gks.vrsta_naloga_naziv,
                        gks.tip_stavke_naziv,
                        gks.opis,
                        gks.iznos,
                        gks.kontna_klasa_id
                    FROM
                        vw_glavna_knjiga_stavke gks
                        LEFT JOIN klijenti k ON gks.klijent_id = k.klijent_id
                    WHERE
                        gks.klijent_id IS NOT null
                        AND gks.proknjizeno = 'Y'
                        AND gks.glavna_knjiga_datum_knjizenja >= to_date(:P210_PERIOD_OD, 'DD.MM.YYYY')
                        AND gks.glavna_knjiga_datum_knjizenja <= to_date(:P210_PERIOD_DO, 'DD.MM.YYYY')
                        AND (vrsta_naloga_id = :P210_VRSTA_NALOGA_ID OR :P210_VRSTA_NALOGA_ID IS null)
                        AND (
                            CASE
                                WHEN :P210_VRSTA_KLIJENTA IN ('K', 'O') AND (gks.kontna_klasa_code LIKE '2%' OR gks.kontna_klasa_code LIKE '430%') THEN 1
                                WHEN :P210_VRSTA_KLIJENTA IN ('D', 'O') AND (gks.kontna_klasa_code LIKE '4%' AND gks.kontna_klasa_code NOT LIKE '430%') THEN 1
                                ELSE 0
                            END
                        )  = 1
                )
                SELECT
                    gks.glavna_knjiga_id,
                    k.klijent_id,
                    k.naziv,
                    gks.informacije,
                    lpad(gks.glavna_knjiga_broj, 6, '0') as glavna_knjiga_broj,
                    gks.glavna_knjiga_datum_knjizenja,
                    gks.vrsta_naloga_naziv,
                    gks.tip_stavke_naziv,
                    gks.opis,
                    gks.iznos,
                    gks.kontna_klasa_id
                    
                FROM
                    klijenti k
                    LEFT JOIN glavna_knjiga_stavke gks ON gks.klijent_id = k.klijent_id
                ```
            pageItemsToSubmit: [
                P210_PERIOD_OD
                P210_PERIOD_DO
                P210_VRSTA_KLIJENTA
                P210_KLIJENT_ID
                P210_VRSTA_NALOGA_ID
            ]
        }
