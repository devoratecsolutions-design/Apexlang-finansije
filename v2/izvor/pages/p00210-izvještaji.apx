    region knjiga-prihoda (
        name: Knjiga prihoda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    row_number() OVER (ORDER BY glavna_knjiga_datum_knjizenja) as redni_broj,
                    glavna_knjiga_datum_knjizenja,
                    opis,
                    CASE
                        WHEN vrsta_prihoda_sifra = 1 THEN
                            abs(iznos)
                    END AS proizvod,
                    CASE
                        WHEN vrsta_prihoda_sifra = 2 THEN
                            abs(iznos)
                    END AS roba,
                    CASE
                        WHEN vrsta_prihoda_sifra = 3 THEN
                            abs(iznos)
                    END AS usluga,
                    CASE
                        WHEN vrsta_prihoda_sifra = 4 THEN
                            abs(iznos)
                    END AS finansiranje,
                    CASE
                        WHEN vrsta_prihoda_sifra = 5 THEN
                            abs(iznos)
                    END AS ostali_prihodi,
                    abs(iznos) AS ukupno,
                    abs(iznos) * 0.145299 as ukupno_pdv
                FROM
                    vw_glavna_knjiga_stavke
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND lower(vrsta_naloga_sifra) = 'iz'
                    AND extract(year from glavna_knjiga_datum_knjizenja) = :P210_PORESKA_GODINA
                    AND prihod_rashod = 'P'
                    AND automatska = 'N'
                    AND proknjizeno = 'Y'
                ```
            pageItemsToSubmit: P210_PORESKA_GODINA
        }
        layout {
            sequence: 300
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
