    region knjiga-potraživanja-i-obaveza-kif (
        name: Knjiga potraživanja i obaveza / KIF
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH kif AS (
                    SELECT
                        row_number() OVER (ORDER BY datum_fakture, faktura_broj) AS redni_broj,
                        id,
                        klijent_naziv,
                        naziv_fakture,
                        datum_fakture,
                        iznos_fakture_nopdv,
                        pdv,
                        iznos_fakture
                        
                    FROM
                        vw_kif
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND godina = :P210_PORESKA_GODINA
                        AND vrsta_naloga_sifra = 'if'
                ),
                izvodi AS (
                    SELECT
                        kif_id,
                        glavna_knjiga_opis,
                        glavna_knjiga_datum_knjizenja,
                        abs(iznos) as iznos
                    FROM
                        vw_glavna_knjiga_stavke gks
                        LEFT JOIN kif ON gks.kif_id = kif.id
                    WHERE
                        vrsta_naloga_sifra = 'IZ'
                        AND proknjizeno = 'Y'
                ),
                kalkulacija AS (
                    SELECT
                        kif.redni_broj,
                        kif.klijent_naziv,
                        kif.naziv_fakture,
                        kif.datum_fakture,
                        kif.iznos_fakture_nopdv,
                        kif.pdv,
                        kif.iznos_fakture,
                        
                        i.glavna_knjiga_opis,
                        i.glavna_knjiga_datum_knjizenja,
                        i.iznos,
                
                        (kif.iznos_fakture - 
                         SUM(coalesce(i.iznos, 0)) OVER (
                             PARTITION BY kif.id 
                             ORDER BY i.glavna_knjiga_datum_knjizenja
                         )
                        ) AS saldo
                        
                --        (coalesce(kif.iznos_fakture, 0) - coalesce(i.iznos, 0)) AS saldo
                    FROM
                        kif
                        LEFT JOIN izvodi i ON i.kif_id = kif.id
                ),
                final AS (
                    SELECT
                        k.*,
                        CASE
                            WHEN ROW_NUMBER() OVER (
                                PARTITION BY redni_broj
                                ORDER BY glavna_knjiga_datum_knjizenja DESC
                            ) = 1
                            THEN saldo
                            ELSE null
                        END AS saldo_for_cumulative
                    FROM kalkulacija k
                )
                SELECT
                    redni_broj,
                    klijent_naziv,
                    naziv_fakture,
                    datum_fakture,
                    iznos_fakture_nopdv,
                    pdv,
                    iznos_fakture,
                    glavna_knjiga_opis,
                    glavna_knjiga_datum_knjizenja,
                    iznos,
                    saldo,
                    SUM(coalesce(saldo_for_cumulative, 0)) OVER (ORDER BY redni_broj) AS kumulativni_saldo
                FROM final
                ORDER BY 
                    redni_broj,
                    glavna_knjiga_datum_knjizenja ASC
                
                ```
            pageItemsToSubmit: P210_PORESKA_GODINA
        }
        layout {
            sequence: 330
            slot: body
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-expanded
                t-Region--scrollBody
            ]
            cssClasses: fin-ir
        }
        serverSideCondition {
            type: item=value
            item: P210_IZVJESTAJ_SIFRA
            value: potrazivanja_obaveze
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            filter: false
            rowsPerPage: false
            sort: false
            controlBreak: false
