    region obrazac-1007-mjesečno (
        name: Obrazac 1007 - mjesečno
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH obrazac_1007 AS (
                    SELECT
                        ooj.jib,
                        ooj.naziv,
                        ooj.adresa,
                        lpad(ooj.grad_sifra, 3, '0') AS grad_sifra,
                        ooj.tel,
                        ooj.email,
                        gks.iznos,
                        trunc(gks.glavna_knjiga_datum_knjizenja, 'MM') AS datum_knjizenja
                    FROM
                        vw_glavna_knjiga_stavke gks
                        LEFT JOIN core.vw_ooj ooj ON gks.ooj_id = ooj.id
                    WHERE
                        prihod_rashod = 'P'
                        AND lower(vrsta_naloga_sifra) = 'iz'
                        AND ooj_id = :APP_OOJ_ID
                        AND trunc(glavna_knjiga_datum_knjizenja, 'MM') = :P210_PP
                )
                SELECT
                    jib,
                    naziv,
                    adresa,
                    grad_sifra,
                    tel,
                    email,
                    greatest(sum(abs(iznos)) * 0.02, 50) AS porez,
                    sum(abs(iznos)) AS naplaceni_prihod,
                    
                    datum_knjizenja AS poreski_period_od,
                    last_day(datum_knjizenja) AS poreski_period_do
                FROM
                    obrazac_1007
                GROUP BY
                    jib,
                    naziv,
                    adresa,
                    grad_sifra,
                    tel,
                    email,
                    datum_knjizenja
                ```
            pageItemsToSubmit: P210_PP
