    region knjiga-prometa (
        name: Knjiga prometa
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH stavke AS (
                    SELECT 
                        ooj_id,
                        glavna_knjiga_datum_knjizenja AS datum,
                        EXTRACT(MONTH FROM glavna_knjiga_datum_knjizenja) AS mjesec,
                
                        glavna_knjiga_opis,
                        CASE 
                            WHEN gks.nacin_placanja_izvoda = 'G' THEN 
                                gks.iznos 
                            ELSE 
                                0 
                        END AS iznos_gotovina,
                        CASE 
                            WHEN upper(gks.nacin_placanja_izvoda) = 'Z' THEN 
                                gks.iznos 
                            ELSE 0 
                        END AS iznos_banka
                    FROM 
                        vw_glavna_knjiga_stavke gks
                    WHERE
                        lower(vrsta_naloga_sifra) = 'iz'
                        AND ooj_id = :APP_OOJ_ID 
                        AND EXTRACT(YEAR FROM glavna_knjiga_datum_knjizenja) = :P210_PORESKA_GODINA
                        -- AND proknjizeno = 'Y'
                )
                
                SELECT 
                    datum,
                    glavna_knjiga_opis,
                    iznos_gotovina,
                    iznos_banka,
                    (iznos_gotovina + iznos_banka) AS ukupno_iznos,
                    mjesec,
                    'N' AS bold
                FROM 
                    stavke
                
                UNION ALL
                
                SELECT
                    null AS datum,
                    'Ukupno za ' || mjesec || '. mjesec' AS glavna_knjiga_opis,
                    sum(iznos_gotovina) AS iznos_gotovina,
                    sum(iznos_banka) AS iznos_banka,
                    sum(iznos_gotovina + iznos_banka) AS ukupno_iznos,
                    mjesec,
                    'Y' AS bold
                FROM
                    stavke
                GROUP BY
                    mjesec
                
                UNION ALL
                
                SELECT
                    null AS datum,
                    'Ukupno za godinu' AS glavna_knjiga_opis,
                    sum(iznos_gotovina) AS iznos_gotovina,
                    sum(iznos_banka) AS iznos_banka,
                    sum(iznos_gotovina + iznos_banka) AS ukupno_iznos,
                    null AS mjesec,
                    'Y' AS bold
                FROM
                    stavke
                
                ORDER BY 
                    mjesec NULLS LAST, 
                    datum NULLS LAST
                
                
                ```
            pageItemsToSubmit: P210_PORESKA_GODINA
        }
        layout {
            sequence: 210
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
