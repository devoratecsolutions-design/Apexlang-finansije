    region knjiga-rashoda (
        name: Knjiga rashoda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    row_number() OVER (ORDER BY glavna_knjiga_datum_knjizenja) as redni_broj,
                    glavna_knjiga_datum_knjizenja,
                    opis,
                    CASE
                        WHEN vrsta_rashoda_sifra = 5 THEN
                            abs(iznos)
                    END AS nabavna_vrijednost,
                    CASE
                        WHEN vrsta_rashoda_sifra = 6  THEN
                            abs(iznos)
                    END AS materijal,
                    CASE
                        WHEN vrsta_rashoda_sifra = 7 THEN
                            abs(iznos)
                    END AS bruto,
                    CASE
                        WHEN vrsta_rashoda_sifra = 8 THEN
                            abs(iznos)
                    END AS proizvodne_usluge,
                    CASE
                        WHEN vrsta_rashoda_sifra = 9 THEN
                            abs(iznos)
                    END AS ostali_rashodi,
                    CASE
                        WHEN vrsta_rashoda_sifra = 10 THEN
                            abs(iznos)
                    END AS finansijski_rashodi,
                    CASE
                        WHEN vrsta_rashoda_sifra = 11 THEN
                            abs(iznos)
                    END AS amortizacija,
                    CASE
                        WHEN vrsta_rashoda_sifra = 12 THEN
                            abs(iznos)
                    END AS manjak,
                    
                    abs(iznos) * 0.145299 as ukupno_pdv,
                    
                    CASE
                        WHEN priznat_rashod = 'Y' THEN
                            abs(iznos)
                        ELSE
                            null
                    END AS ukupni_priznat_rashod,
                    
                    CASE
                        WHEN priznat_rashod = 'N' THEN
                            abs(iznos)
                        ELSE
                            null
                    END AS ukupni_nepriznat_rashod
                    
                FROM
                    vw_glavna_knjiga_stavke
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND lower(vrsta_naloga_sifra) = 'iz'
                    AND extract(year from glavna_knjiga_datum_knjizenja) = :P210_PORESKA_GODINA
                    AND prihod_rashod = 'R'
                    AND automatska = 'N'
                    AND proknjizeno = 'Y'
                ```
            pageItemsToSubmit: P210_PORESKA_GODINA
        }
        layout {
            sequence: 310
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-ir
        }
        serverSideCondition {
            type: item=value
            item: P210_IZVJESTAJ_SIFRA
            value: rashod
        }
