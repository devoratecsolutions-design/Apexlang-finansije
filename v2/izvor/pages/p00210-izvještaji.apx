    region knjiga-žiro-računa (
        name: Knjiga žiro računa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH
                	izvodi AS (
                		SELECT
                			1 AS order_no,
                			id,
                			broj_izvoda,
                			datum_knjizenja,
                			opis,
                			pocetno_stanje,
                			zakljucno_stanje,
                        	row_number() OVER (ORDER BY datum_knjizenja, id) AS main_seq
                        FROM
                        	vw_glavna_knjiga
                        WHERE
                        	ooj_id = :APP_OOJ_ID
                            AND ooj_banka_id = :P210_BANKA_ID
                        	AND lower(vrsta_naloga_sifra) = 'iz'
                        	AND extract(year from datum_knjizenja) = :P210_PORESKA_GODINA
                            AND proknjizeno = 'Y'
                	),
                	izvodi_stavke AS (
                		SELECT
                			2 AS order_no,
                			glavna_knjiga_id,
                        	redni_broj,
                			glavna_knjiga_opis AS broj_izvoda_stavke,
                			glavna_knjiga_datum_knjizenja,
                			opis,
                	        CASE 
                	        	WHEN gks.prihod_rashod = 'R' THEN abs(gks.iznos)
                	        END AS isplata,
                	        CASE 
                	        	WHEN gks.prihod_rashod = 'P' THEN abs(gks.iznos) 
                	        END AS uplata
                	    FROM
                	    	vw_glavna_knjiga_stavke gks
                	    WHERE
                	    	EXISTS (
                	    		SELECT 
                	    			1
                	    		FROM
                	    			izvodi i
                	    		WHERE
                	    			gks.glavna_knjiga_id = i.id
                	    	)
                            AND automatska = 'N'
                            AND proknjizeno = 'Y'
                	),
                	izvodi_zakljucno AS (
                		SELECT
                			3 AS order_no,
                			id,
                			broj_izvoda,
                			datum_knjizenja,
                			opis,
                			zakljucno_stanje,
                			main_seq
                		FROM
                			izvodi
                		WHERE
                			main_seq = (
                				SELECT 
                					max(main_seq)
                				FROM
                					izvodi
                			)
                	)
                
                SELECT
                	order_no,
                	datum_knjizenja AS order_datum,
                    id AS glavna_knjiga_id,
                	null AS redni_broj,
                    null AS broj_izvoda,
                    null AS datum,
                    null AS opis,
                    null AS isplata,
                    null AS uplata,
                    pocetno_stanje AS stanje
                FROM
                	izvodi
                
                UNION ALL
                
                SELECT
                	s.order_no,
                	s.glavna_knjiga_datum_knjizenja AS order_datum,
                    glavna_knjiga_id,
                	s.redni_broj,
                    s.broj_izvoda_stavke,
                    s.glavna_knjiga_datum_knjizenja AS datum,
                    s.opis,
                    s.isplata,
                    s.uplata,
                    null AS stanje
                FROM
                	izvodi_stavke s
                	JOIN izvodi i ON s.glavna_knjiga_id = i.id
                
                UNION ALL
                
                SELECT
                	order_no,
                	datum_knjizenja AS order_datum,
                    id AS glavna_knjiga_id,
                	null AS redni_broj,
                    null AS broj_izvoda,
                    null AS datum,
                    null AS opis,
                    null AS isplata,
                    null AS uplata,
                    zakljucno_stanje AS stanje
                FROM
                	izvodi_zakljucno
                
                ORDER BY
                	order_datum,
                	order_no,
                    redni_broj
                ```
            pageItemsToSubmit: [
                P210_PORESKA_GODINA
                P210_BANKA_ID
            ]
        }
        layout {
            sequence: 220
            slot: body
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
