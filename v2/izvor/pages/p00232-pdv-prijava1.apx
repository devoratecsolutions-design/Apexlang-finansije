page 232 (
    name: PDV Prijava
    alias: PDV-PRIJAVA1
    title: PDV Prijava
    pageGroup: @glavna-knjiga
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#jasper-server#MIN#.js
    }
    css {
        inline:
            ```css
            #pdv .a-GV-header {
            
                height: 60px;
            
            }
            ```
    }
    security {
        authorizationScheme: @glavna-knjiga-pdv-prijava
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region izlaz (
        name: Izlaz
        type: staticContent
        layout {
            sequence: 70
            slot: contentBody
            columnSpan: 3
            columnCssClasses: u-flex
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--noIcon
                t-Alert--info
            ]
            cssClasses: u-flex-grow-1
        }
        accessibility {
            useLandmark: false
        }
        config {
            buildOption: @commented-out
        }
    )

