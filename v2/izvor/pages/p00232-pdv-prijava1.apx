    dynamicAction print-pdv (
        name: Print - PDV
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @print
        }
        config {
            buildOption: @feature-printing
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    generate_report(
                        filename = 'pdv_prijava_' + $v("P232_PORESKI_PERIOD"), 
                        report_path = '/reports/ACCOUNTING/izvjestaji/pdv_prijava', 
                        report_parameters = {
                            ID: $v("P232_ID")
                        },
                        new_tab = false
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            config {
                buildOption: @feature-printing
            }
        )

    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pdv_pkg.get_pdv_prijava (
                    p_id                        => :P232_ID,
                    p_ooj_id                    => :P232_OOJ_ID,
                    p_poreski_period            => :P232_PORESKI_PERIOD,
                    p_isporuke_p11              => :P232_P11,
                    p_izvoz_p12                 => :P232_P12,
                    p_isporuke_osl_pdv_p13      => :P232_P13,
                    p_nabavke_p21               => :P232_P21,
                    p_uvoz_p22                  => :P232_P22,
                    p_nabavke_poljoprivreda_p23 => :P232_P23,
                    p_pdv_izlaz_p51             => :P232_P51,
                    p_pdv_ulaz_p61              => :P232_P61,
                    p_pdv_reg_obveznici_p41     => :P232_P41,
                    p_pdv_uvoz_p42              => :P232_P42,
                    p_pausal_poljoprivreda_p43  => :P232_P43,
                    p_fbih_p32                  => :P232_P32,
                    p_rs_p33                    => :P232_P33,
                    p_dbr_p34                   => :P232_P34,
                    p_pdv_uplata_povrat_p71     => :P232_P71,
                    p_valid                     => :P232_VALID
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 110812020044280208
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P232_ID
        }
    )

    process knjizi-pdv-prijavu (
        name: Knjizi PDV prijavu
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P232_NALOG_ID := glavna_knjiga_pkg.knjizi_pdv_prijava (
                    p_ooj_id         => :APP_OOJ_ID,
                    p_godina         => :APP_GODINA,
                    p_pdv_prijava_id => :P232_ID,
                    p_proknjizeno    => 'N'
                );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 113290558313712135
        }
        serverSideCondition {
            whenButtonPressed: @knjizi
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 201
                items: {
                    P201_ID: &P232_NALOG_ID.
                }
                clearCache: 201
            }
        }
        serverSideCondition {
            whenButtonPressed: @knjizi
        }
    )

)

