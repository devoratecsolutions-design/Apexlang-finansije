    region pdv-prijava (
        name: PDV Prijava
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT    
                    isporuke_p11,
                    izvoz_p12,
                    isporuke_osl_pdv_p13,
                    nabavke_p21,
                    uvoz_p22,
                    nabavke_poljoprivreda_p23,
                    pdv_izlaz_p51,
                    pdv_ulaz_p61,
                    pdv_reg_obveznici_p41,
                    pdv_uvoz_p42,
                    pausal_poljoprivreda_p43,
                    fbih_p32,
                    rs_p33,
                    dbr_p34,
                    pdv_uplata_povrat_p71
                FROM
                    pdv_prijave
                WHERE
                    id = :P232_ID
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--rightAligned
            ]
        }

        column DBR_P34 (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Brčko Distrikt - polje 34
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

