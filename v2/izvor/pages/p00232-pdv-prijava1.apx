    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction copy (
        name: Copy - 11
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @copy
        }

        action copy (
            name: Copy 11
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    let str = apex.item('P232_P11').getValue();
                    navigator.clipboard.writeText(str.trim());
                    
                    apex.message.showPageSuccess('Uspješno kopirano polje 11')
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

