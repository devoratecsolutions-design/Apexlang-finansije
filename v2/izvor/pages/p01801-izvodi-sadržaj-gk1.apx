    dynamicAction razveži-uvezanu-stavku (
        name: Razveži  uvezanu stavku
        execution {
            sequence: 200
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .delete-st
        }

        action native-confirm (
            action: confirm
            settings {
                message: Da li ste sigurni da želite razvezati uvezanu stavku?
                style: danger
                confirmLabel: DA
                cancelLabel: NE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                        for r in (SELECT c001  AS tip,
                                            c002  AS opis_izvoda,
                                            c003  AS opis_transkacije,
                                            c004  AS partner,
                                            c005  AS opstina,
                                            c006  AS radnik,
                                            c007  AS smjer_placanja,
                                            c008  AS mjesto_tr,
                                            c009  AS strana_knjizenja,
                                            c010  AS pracenje_os,
                                            c011  AS id_os,
                                            c012  AS broj_vd,
                                            c013  AS opis_vd,
                                            c014  AS zakljucan,
                                            c015  AS konto,
                                            n001  AS iznos_original,
                                            n002  AS iznos,
                                            n003  AS rbr,
                                            n004  AS izvod_stavka_id,
                                            n005  AS izvod_id,
                                            d001  AS datum_dokumenta
                                        FROM apex_collections
                                        WHERE collection_name = 'SADRZAJ_GK_IZVODI'
                                        AND SEQ_ID=:P1801_SEQ_ID_POM)
                    
                        loop
                    
                    
                           APEX_COLLECTION.UPDATE_MEMBER(
                                  p_collection_name => 'SADRZAJ_GK_IZVODI',
                                  p_seq  => :P1801_SEQ_ID_POM,
                                  p_c001 => r.tip,
                                  p_c002 => r.opis_izvoda,
                                  p_c003 => r.opis_transkacije,
                                  p_c004 => r.partner,
                                  p_c005 => r.opstina,
                                  p_c006 => r.radnik,
                                  p_c007 => r.smjer_placanja,
                                  p_c008 => r.mjesto_tr,
                                  p_c009 => r.strana_knjizenja,
                                  p_c010 => r.pracenje_os,
                                  p_c011 => null, --id otvorene stavke
                                  p_c012 => null, -- vezni dokument otvorene stavke 
                                  p_c013 => null, --opis veznog dokumenta
                                  p_c014 => r.zakljucan, -- red zakljucan za brisanje
                                  p_c015 => r.konto, -- red zakljucan za brisanje
                                  p_n001 => r.iznos_original,
                                  p_n002 => r.iznos,
                                  p_n003 => r.rbr,
                                  p_n004 => r.izvod_stavka_id,
                                  p_n005 => r.izvod_id,
                                  p_d001 => r.datum_dokumenta
                                ); 
                    
                            end loop;  
                    ```
                itemsToSubmit: P1801_SEQ_ID_POM
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.message.showPageSuccess("Stavka uspješno razvezana!");
                    
                    setTimeout(function() {
                        apex.message.hidePageSuccess();
                    }, 2000);
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stavke-konta-grid
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).parent().data('id');
            }
            affectedElements {
                selectionType: items
                items: P1801_SEQ_ID_POM
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation proknjiži-izvod (
        name: Proknjiži izvod
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                
                    v_stavka_suma_knjig number;
                    v_stavka_suma_izvod number;
                    v_rbr number:=0;
                    v_ukupno number;
                    v_izvod_porknjizen varchar2(1);
                    v_konto_unesen number;
                
                
                
                begin
                
                
                
                        if :P1801_DATUM_NALOGA is null then 
                
                            return 'Datum naloga je obavezno polje!';
                
                        elsif :P1801_OPIS_NALOGA is null then 
                
                             return 'Opis naloga je obavezno polje!';
                        end if;
                
                
                        ------provjera da li je svaka pojedinačna stavka izvoda ispravno razbijena za knjiženje-----
                
                        for r in (SELECT 
                                           case when c007='P' then n001 else -n001 end AS iznos_original,
                                            sum(n002)  AS iznos,
                                            n003  AS rbr
                                        FROM apex_collections
                                        WHERE collection_name = 'SADRZAJ_GK_IZVODI'
                                        and n004!=0
                                        group by n003,n001, c007
                                        order by n003)
                
                        loop
                
                            if r.iznos_original+r.iznos<>0 then 
                                return 'Za stavku izvoda broj '||r.rbr||' knjiženje nije u ravnoteži!';
                            end if;
                
                        end loop;
                
                        
                        -----------provjera da li je nalog u ravnoteži-------
                
                        SELECT sum(n002)  AS iznos
                        into v_ukupno
                        FROM apex_collections
                        WHERE collection_name = 'SADRZAJ_GK_IZVODI';
                
                        if v_ukupno!=0 then 
                
                           return 'Nalog nije u ravnoteži!'; 
                
                        end if;
                        --------
                
                        --------- provjera da li je došlo u međuvremenu do knjiženja od strane drugog korisnika----
                
                        /*select  iz.proknjizen 
                        into v_izvod_porknjizen
                        from accounting.izvodi iz 
                        where iz.id=:P1801_IZVOD_ID ;
                
                        if v_izvod_porknjizen='Y' then 
                            return 'Izvod je u međuvremenu proknjižen!'; 
                        end if;*/
                
                        ------
                
                        --------- provjera da li su konta sva unesena----
                        select count(n002)
                        into v_konto_unesen
                        from  apex_collections
                        where collection_name = 'SADRZAJ_GK_IZVODI'
                        and c015 is null;
                
                        if v_konto_unesen>0 then 
                            return 'Neophodno je za savki red unijeti odgovarajuće konto!'; 
                        end if;
                
                        ---------------provjera da li su za izabrana konta unijeti obavezni parametri----
                       for r in (SELECT 
                                    c004  AS partner,
                                    c005  AS opstina,
                                    c006  AS radnik,
                                    c008  AS mjesto_tr,
                                    c015  AS konto
                                 FROM apex_collections
                                 WHERE collection_name = 'SADRZAJ_GK_IZVODI')
                
                        loop
                
                        return sif.acc_pkg.validate_konto_obavezna_polja(
                                p_kontna_klasa_id     => r.konto,
                                p_ooj_id              => :APP_OOJ_ID,
                                p_klijent_id          => r.partner,
                                p_oj_id               => r.mjesto_tr,
                                p_radnik_id           => r.radnik,
                                p_pdv_indikator_id    => null,
                                p_osnovno_sredstvo_id => null
                            );
                
                        end loop;
                
                
                end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @proknjizi
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                SELECT to_char(sum (case when c009='D' then n002 else 0 end ), '999G999G999G999G990D00') as duguje,
                       to_char(sum (case when c009='P' then n002 else 0 end), '999G999G999G999G990D00') as potrazuje 
                into :P1801_DUGUJE, :P1801_POTRAZUJE
                FROM apex_collections
                WHERE collection_name = 'SADRZAJ_GK_IZVODI';
                
                
                
                select  max(sn.id),max(sn.sifra||' - '||sn.naziv),'Izvod - '||listagg(grp.dio_opisa, ': ') within group (order by grp.sifra)
                into :P1801_VRSTA_NALOGA_ID, :P1801_VRSTA_NALOGA, :P1801_OPIS_NALOGA
                from (
                        select 
                            zr.sifra,
                            zr.vrsta_naloga_id,
                            iz.godina,
                            zr.sifra || '/' || 
                            listagg(to_char(iz.broj), ',') within group (order by iz.broj) || '/' || iz.godina as dio_opisa
                        from accounting.izvodi iz
                        join sif.sif_ziro_racuni zr on iz.ziro_racun_id = zr.id
                        where iz.id in (
                                        select distinct n005
                                        from apex_collections
                                        where collection_name = 'SADRZAJ_GK_IZVODI'
                                       )
                        group by zr.sifra, zr.vrsta_naloga_id, iz.godina
                    ) grp
                join sif.sif_vrste_naloga sn on sn.id = grp.vrsta_naloga_id;
                
                --:P1801_DOKUMENT:=:P1801_OPIS_NALOGA;
                :P1801_DATUM_NALOGA:=trunc(sysdate);
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 271815378810416437
        }
    )

    process proknjiži-izvod (
        name: Proknjiži izvod
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                
                v_godina number;
                v_broj_naloga number;
                v_id_naloga_gk number;
                v_id_stavke_gk number;
                v_id_gks_dok number;
                v_id_gks_zat number;
                v_broj_zat number;
                v_opis_dok varchar2(1000);
                
                begin 
                
                ---------- kreiranje zaglavlja glavne knjige -------
                    v_godina:=EXTRACT(YEAR FROM TO_DATE(:P1801_DATUM_NALOGA, 'DD.MM.YYYY'));
                    v_broj_naloga:=accounting.glavna_knjiga_pkg.get_broj_naloga(:APP_OOJ_ID,:P1801_VRSTA_NALOGA_ID,v_godina);
                
                
                    v_id_naloga_gk:=accounting.glavna_knjiga_pkg.insert_glavna_knjiga (
                                                                p_ooj_id           => :APP_OOJ_ID,
                                                                p_vrsta_naloga_id  => :P1801_VRSTA_NALOGA_ID,
                                                                p_godina           => v_godina,
                                                                p_broj             => v_broj_naloga,
                                                                p_datum_dokumenta  => :P1801_DATUM_DOKUMENTA,
                                                                p_datum_knjizenja  => :P1801_DATUM_NALOGA,
                                                                p_opis             => :P1801_OPIS_NALOGA,
                                                                p_stornirano       => 'N',
                                                                p_storniran_id     => NULL,
                                                                p_ooj_banka_id     => NULL,
                                                                p_broj_izvoda      => NULL,
                                                                p_pocetno_stanje   => NULL,
                                                                p_zakljucno_stanje => NULL, 
                                                                p_proknjizeno      => 'Y'
                                                            );
                --------------------------------------------------
                
                ------kreiranje stavke glavne knjige-------------
                
                
                    for r in (SELECT c001  AS tip,
                                        c002  AS opis_izvoda,
                                        c003  AS opis_transkacije,
                                        c004  AS partner,
                                        c005  AS opstina,
                                        c006  AS radnik,
                                        c007  AS smjer_placanja,
                                        c008  AS mjesto_tr,
                                        c009  AS strana_knjizenja,
                                        c010  AS pracenje_os,
                                        c011  AS id_os,
                                        c012  AS broj_vd,
                                        c013  AS opis_vd,
                                        c014  AS zakljucan,
                                        c015  AS konto,
                                        c016  as valuta_id,
                                        n001  AS iznos_original,
                                        n002  AS iznos,
                                        n003  AS rbr,
                                        n004  AS izvod_stavka_id,
                                        n005  AS izvod_id,
                                        d001  AS datum_dokumenta
                                FROM apex_collections
                                WHERE collection_name = 'SADRZAJ_GK_IZVODI'
                                ORDER BY n005, n003)
                    loop
                
                            accounting.glavna_knjiga_pkg.insert_glavna_knjiga_stavka (
                                p_glavna_knjiga_id      => v_id_naloga_gk,
                                p_kontna_klasa_id       => r.konto,
                                p_klijent_id            => r.partner,
                                p_tip_stavke            => r.strana_knjizenja,
                                p_opis                  => r.opis_transkacije,
                                p_iznos                 => r.iznos,
                                p_oj_id                 => null,
                                p_grad_id               => r.opstina,
                                p_prihod_rashod         => null,
                                p_vrsta_prihoda_id      => null,
                                p_vrsta_rashoda_id      => null,
                                p_nacin_placanja_izvoda => null,
                                p_automatska            => null,
                                p_valuta_id             => r.valuta_id,
                                p_valuta_iznos          => round(r.iznos/sif.acc_pkg.get_kurs_na_dan(r.valuta_id,:APP_OOJ_ID,r.datum_dokumenta),2),
                                p_kurs                  => null,
                                p_kif_id                => null,
                                p_kuf_id                => null,
                                p_priznat_rashod        => null,
                                p_datum_dokumenta       => r.datum_dokumenta,
                                p_otvorena              => case when NVL(r.pracenje_os,'N')='N' then 'Z' else  case when nvl(r.id_os,0)=0 then 'O' else 'Z' end end,
                                p_otvoreni_iznos        => case when NVL(r.pracenje_os,'N')='N' then 0   else  case when nvl(r.id_os,0)=0 then r.iznos else 0 end end,
                                p_mjesto_troska_id      => r.mjesto_tr,
                                p_acc_radnik_id         => r.radnik,   
                                p_id                    => v_id_stavke_gk
                            );
                
                
                
                
                --------------------------------------------------
                
                ---------------kreiranje veze stavke glavne knjige sa originalnim dokumentom----
                
                    select 'Izvod - '||zr.sifra||'/'||iz.broj||'/'||iz.godina, iz.opis
                    into :P1801_DOKUMENT, v_opis_dok
                    from accounting.izvodi iz
                    join sif.sif_ziro_racuni zr on  iz.ziro_racun_id=zr.id
                    where iz.id=r.izvod_id;
                        
                    accounting.glavna_knjiga_pkg.insert_gk_stavka_dokument (
                        p_ooj_id                  => :APP_OOJ_ID,
                        p_modul_id                => 1,
                        p_dokument_id             => r.izvod_id,
                        p_dokument                => :P1801_DOKUMENT,
                        p_opis                    => v_opis_dok,
                        p_glavna_knjiga_stavka_id => v_id_stavke_gk,
                        p_id                      => v_id_gks_dok
                    );
                --------
                
                --------------kreiranje analitike zatvaranja i updejt otovrene stavke glavne knjige-------
                    if NVL(r.pracenje_os,'N')='Y' and nvl(r.id_os,0)!=0 then 
                
                        --kreiranje analitike zatvaranja
                            v_broj_zat:=accounting.glavna_knjiga_pkg.get_broj_zatvaranja(:APP_OOJ_ID);
                            accounting.glavna_knjiga_pkg.insert_gk_analitika_zatvaranja (
                                p_ooj_id            => :APP_OOJ_ID,
                                p_broj              => v_broj_zat,
                                p_o_stavka_id       => r.id_os,
                                p_z_stavka_id       => v_id_stavke_gk,
                                p_iznos_zatvaranja  => r.iznos,
                                p_storno            => null,
                                p_id                => v_id_gks_zat
                            );
                
                        --updejt otovrene stavke glavne knjige
                        update accounting.glavna_knjiga_stavke gks
                        set gks.otvoreni_iznos=gks.otvoreni_iznos+r.iznos,
                            gks.otvorena=case when gks.otvoreni_iznos+r.iznos=0 then 'O' else 'DZ' end 
                        where id=r.id_os;
                
                    end if;
                
                ------------------------------------------------------------------
                end loop;
                
                -----------updejt izvoda-----
                update accounting.izvodi i
                set i.proknjizen='Y', i.nalog_gk_id=v_id_naloga_gk
                where i.id in ( select distinct n005 
                                FROM apex_collections
                                WHERE collection_name = 'SADRZAJ_GK_IZVODI');
                -----------------------------
                
                
                :P1801_NALOG_ID:=v_id_naloga_gk;
                
                
                
                
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Izvodi uspješno proknjižen.
        }
        advanced {
            executionMappingIdentifier: 272710707142771649
        }
        serverSideCondition {
            whenButtonPressed: @proknjizi
        }
    )

    process save-stavke (
        name: Save stavke
        type: executeCode
        editableRegion: @stavke-konta-grid
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                v_otvorena_stavka varchar2(1);
                v_mt_naziv varchar2(500);
                v_konto_naziv varchar2(500);
                
                BEGIN
                
                
                
                        IF :APEX$ROW_STATUS = 'D' THEN
                
                            if :ZAKLJUCAN='Y' THEN 
                
                                apex_error.add_error(
                                p_message          => 'Podrazumijevane vrijednosti nije moguće brisati, već samo korigovati!',
                                p_display_location => apex_error.c_inline_in_notification);
                
                            else
                
                                APEX_COLLECTION.DELETE_MEMBER(
                                p_collection_name => 'SADRZAJ_GK_IZVODI',
                                p_seq             => :SEQ_ID 
                              );
                
                            end if;
                
                            
                
                
                        ELSIF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN
                
                        NULL;
                
                        ELSIF :APEX$ROW_STATUS = 'U' THEN
                
                
                            for r in (SELECT c001  AS tip,
                                                c002  AS opis_izvoda,
                                                c003  AS opis_transkacije,
                                                c004  AS partner,
                                                c005  AS opstina,
                                                c006  AS radnik,
                                                c007  AS smjer_placanja,
                                                c008  AS mjesto_tr,
                                                c009  AS strana_knjizenja,
                                                c010  AS pracenje_os,
                                                c011  AS id_os,
                                                c012  AS broj_vd,
                                                c013  AS opis_vd,
                                                c014  AS zakljucan,
                                                c015  AS konto,
                                                c016  AS valuta,
                                                n001  AS iznos_original,
                                                n002  AS iznos,
                                                n003  AS rbr,
                                                n004  AS izvod_stavka_id,
                                                n005  AS izvod_id,
                                                d001  AS datum_dokumenta
                                            FROM apex_collections
                                            WHERE collection_name = 'SADRZAJ_GK_IZVODI'
                                            AND SEQ_ID=:SEQ_ID
                                            and n004!=0 and c011 is null) -- za zaključane redove se ne čuvaju izmjene iz IG
                
                            loop
                
                
                                IF :KONTO is not null then 
                
                                        select nvl(acc.otvorene_stavke,'N'), acc.naziv 
                                        into v_otvorena_stavka, v_konto_naziv
                                        from sif.acc_kontni_okvir_klase acc 
                                        where acc.id=:KONTO;
                
                                end if;
                                
                                if :MJESTO_TR IS NOT NULL then 
                
                                        select mt.naziv
                                        into v_mt_naziv
                                        from sif.acc_mjesta_troska mt 
                                        where mt.id=:MJESTO_TR;
                
                                end if;
                
                
                
                                if to_number(:IZNOS,'999G999G999G999G990D00')=0 then 
                
                                        apex_error.add_error(
                                        p_message          => 'Vrijednost u polju iznos mora biti različita od nule!',
                                        p_display_location => apex_error.c_inline_in_notification);
                
                                end if;
                
                               
                
                               APEX_COLLECTION.UPDATE_MEMBER(
                                      p_collection_name => 'SADRZAJ_GK_IZVODI',
                                      p_seq  => :SEQ_ID,
                                      p_c001 => r.tip,
                                      p_c002 => r.opis_izvoda,
                                      p_c003 => :OPIS_TRANSKACIJE,
                                      p_c004 => :PARTNER,
                                      p_c005 => :OPSTINA,
                                      p_c006 => :RADNIK,
                                      p_c007 => r.smjer_placanja,
                                      p_c008 => :MJESTO_TR,
                                      p_c009 => :STRANA_KNJIZENJA,
                                      p_c010 => v_otvorena_stavka,
                                      p_c011 => r.id_os, --id otvorene stavke
                                      p_c012 => r.broj_vd, -- vezni dokument otvorene stavke 
                                      p_c013 => r.opis_vd, --opis veznog dokumenta
                                      p_c014 => r.zakljucan, -- red zakljucan za brisanje
                                      p_c015 => :KONTO,
                                      P_C016 => r.valuta, 
                                      p_c017 => v_mt_naziv, 
                                      p_c018 => v_konto_naziv, 
                                      p_n001 => r.iznos_original,
                                      p_n002 => to_number(:IZNOS,'999G999G999G999G990D00'),
                                      p_n003 => r.rbr,
                                      p_n004 => r.izvod_stavka_id,
                                      p_n005 => r.izvod_id,
                                      p_d001 => r.datum_dokumenta
                                    ); 
                
                                end loop;       
                
                        END IF;
                
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 271806742873416379
        }
        serverSideCondition {
            whenButtonPressed: @snimi-stavke
            executionScope: allSubmittedRows
        }
    )

    branch (
        name: Go to pregled naloga
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1851
                items: {
                    P1851_NALOG_ID: &P1801_NALOG_ID.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @proknjizi
        }
    )

)

