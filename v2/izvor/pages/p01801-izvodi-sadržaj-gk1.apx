page 1801 (
    name: Izvodi/Sadržaj GK
    alias: IZVODI-SADRŽAJ-GK1
    title: Izvodi/Sadržaj GK
    pageGroup: @glavna-knjiga
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #WORKSPACE_FILES#left-side-toggle#MIN#.js
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function checkDugujePotrazuje() {
                var duguje = parseFloat($v('P1801_DUGUJE').replace(/\./g, '').replace(',', '.')) || 0;
                var potrazuje = parseFloat($v('P1801_POTRAZUJE').replace(/\./g, '').replace(',', '.')) || 0;
                
                if (duguje === -potrazuje) {
                    $('#P1801_DUGUJE').css('background-color', '#d0f1cc');
                    $('#P1801_POTRAZUJE').css('background-color', '#d0f1cc');
                } else {
                    $('#P1801_DUGUJE').css('background-color', '#ffd6d2');
                    $('#P1801_POTRAZUJE').css('background-color', '#ffd6d2');
                }
            }
            
            function moveAndEdit(keyName, keyCodeVal) {
                var activeEl = document.activeElement;
            
                // 1. Pusti native strelicu da prvo pomjeri fokus (JET grid to hvata)
                var arrowEvent = new KeyboardEvent('keydown', {
                    key: keyName,
                    code: keyName,
                    keyCode: keyCodeVal,
                    which: keyCodeVal,
                    bubbles: true,
                    cancelable: true
                });
                activeEl.dispatchEvent(arrowEvent);
            
                // 2. Nakon kratke pauze, simuliraj Enter da uđe u edit mode na novoj ćeliji
                setTimeout(function() {
                    var newActiveEl = document.activeElement;
                    var enterEvent = new KeyboardEvent('keydown', {
                        key: 'Enter',
                        code: 'Enter',
                        keyCode: 13,
                        which: 13,
                        bubbles: true,
                        cancelable: true
                    });
                    newActiveEl.dispatchEvent(enterEvent);
                }, 50);
            }
            
            ```
        executeWhenPageLoads:
            ```javascript-browser
                
                var btnAdd = document.getElementById('btn-new');
                var btnSave = document.getElementById('btn-save');
                var toolbarContainer = document.querySelector('#IGstavke .a-Toolbar-groupContainer.a-Toolbar-groupContainer--start');
                toolbarContainer.querySelector('.a-Toolbar-group:last-child').appendChild(btnAdd);
                toolbarContainer.querySelector('.a-Toolbar-group:last-child').appendChild(btnSave);
                apex.region("IGstavke").widget().interactiveGrid("getActions").hide("selection-add-row");
                
                checkDugujePotrazuje();
            
            
            ```
    }
    css {
        fileUrls: #WORKSPACE_FILES#left-side-toggle#MIN#.css
        inline:
            ```css
            .schDate{
                --a-datepicker-calendar-day-background-color: #62e284;
