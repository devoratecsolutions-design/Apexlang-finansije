    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @nova-stavka
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT to_char(sum (case when c009='D' then n002 else 0 end ), '999G999G999G999G990D00') as duguje,
                           to_char(sum (case when c009='P' then n002 else 0 end), '999G999G999G999G990D00') as potrazuje 
                    into :P1801_DUGUJE, :P1801_POTRAZUJE
                    FROM apex_collections
                    WHERE collection_name = 'SADRZAJ_GK_IZVODI';
                    ```
                itemsToReturn: [
                    P1801_DUGUJE
                    P1801_POTRAZUJE
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: checkDugujePotrazuje();
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stavke-konta-grid
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-refresh (
        name: "Dialog Closed - Refresh "
        execution {
            sequence: 150
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @stavke-konta-grid
        }
        serverSideCondition {
            type: never
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stavke-konta-grid
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

