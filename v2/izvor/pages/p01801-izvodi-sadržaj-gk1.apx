    region referentni-dokumenti (
        name: Referentni dokumenti
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rd.* 
                from vw_gk_referentni_dokumenti rd
                join (select distinct n005 as izvod_id
                      from apex_collections
                      where collection_name = 'SADRZAJ_GK_IZVODI') kol on rd.dokument_id=kol.izvod_id and rd.modul_id=1
                ```
        }
        layout {
            sequence: 10
            parentRegion: @nalog
            slot: subRegions
            columnSpan: 8
        }
        appearance {
            template: @collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

