    region stavke-konta-grid (
        name: Stavke konta Grid
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    seq_id,
                    c001  AS tip,
                    c002  AS opis_izvoda,
                    c003  AS opis_transkacije,
                    c004  AS partner,
                    c005  AS opstina,
                    c006  AS radnik,
                    c007  AS smjer_placanja,
                    c008  AS mjesto_tr,
                    c009  AS strana_knjizenja,
                    c010  AS pracenje_os,
                    c011  AS id_os,
                    c012  AS broj_vd,
                    c013  AS opis_vd,
                    c014  AS zakljucan,
                    c015  AS konto,
                    c016  AS kurs,
                    c017  AS naziv_mt,
                    c018  AS naziv_konta,
                    n001  AS iznos_original,
                    n002  AS iznos,
                    n003  AS rbr,
                    n004  AS izvod_stavka_id,
                    n005  AS izvod_id,
                    d001  AS datum_dokumenta, 
                    seq_id AS ukloni_os,
                    row_number() over (ORDER BY n005, n003) AS redosled_prikaza
                FROM apex_collections
                WHERE collection_name = 'SADRZAJ_GK_IZVODI'
                ```
        }
        layout {
            sequence: 20
            parentRegion: @nalog
            slot: subRegions
        }
