    region stavke-ig (
        name: Stavke IG
        title: Stavke
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH stavke AS (
                    SELECT
                        id,
                        tip,
                        tip_promjene_id,
                        iznos,
                        radnik_id,
                        klijent_id,
                        oj_id
                    FROM
                        blagajna_dnevnik_stavke
                    WHERE
                        dnevnik_id = :P455_DNEVNIK_ID
                    ORDER BY
                        redni_broj ASC
                )
                SELECT
                    id,
                    tip,
                    tip_promjene_id,
                    iznos,
                    radnik_id,
                    klijent_id,
                    oj_id
                FROM 
                    stavke
                
                ```
            pageItemsToSubmit: P455_DNEVNIK_ID
        }
        layout {
            sequence: 20
            parentRegion: @wrapper-dnevnik-exist
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: fin-grid
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    let $ = apex.jQuery,
                        toolbarData = $.apex.interactiveGrid.copyDefaultToolbar();
                        addrowAction = toolbarData.toolbarFind("selection-add-row"),
                        addrowAction.label = "Nova stavka"; // Pick name you need
                        editrowAction = toolbarData.toolbarFind("edit"),
                        editrowAction.label = "Izmjeni"; // Pick name you need
                        options.toolbarData = toolbarData;
                    
                    options.defaultGridViewOptions = {
                        reorderColumns: false
                    }
                    return options;
                }
                
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 136248263231877512
        }

