    process save-stavke (
        name: Save stavke
        type: executeCode
        editableRegion: @stavke-ig
        source {
            plsqlCode:
                ```plsql
                IF :APEX$ROW_STATUS = 'D' THEN -- DELETE
                    blagajna_pkg.delete_blagajna_dnevnik_stavka (
                        p_id => :ID
                    );
                
                ELSIF :APEX$ROW_STATUS = 'I' OR :APEX$ROW_STATUS = 'C' THEN -- CREATE
                    blagajna_pkg.insert_blagajna_dnevnik_stavka (
                        p_dnevnik_id      => :P455_DNEVNIK_ID,
                        p_tip_promjene_id => :TIP_PROMJENE_ID,
                        p_radnik_id       => :RADNIK_ID,
                        p_klijent_id      => :KLIJENT_ID,
                        p_oj_id           => :OJ_ID,
                        p_tip             => :TIP,
                        p_iznos           => to_number(:IZNOS, '999G999G999G999G990D00')
                    );
                
                    RETURN;
                ELSIF :APEX$ROW_STATUS = 'U' THEN -- UPDATE
                    blagajna_pkg.update_blagajna_dnevnik_stavka (  
                        p_id              => :ID,
                        p_dnevnik_id      => :P455_DNEVNIK_ID,
                        p_tip_promjene_id => :TIP_PROMJENE_ID,
                        p_radnik_id       => :RADNIK_ID,
                        p_klijent_id      => :KLIJENT_ID,
                        p_oj_id           => :OJ_ID,
                        p_tip             => :TIP,
                        p_iznos           => to_number(:IZNOS, '999G999G999G999G990D00')
                    );
                
                    RETURN;
                END IF;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 136249957161877529
        }
        serverSideCondition {
            whenButtonPressed: @save-stavke
            executionScope: allSubmittedRows
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 456
                items: {
