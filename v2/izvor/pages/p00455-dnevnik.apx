    pageItem P455_DNEVNIK_ID (
        type: selectOne
        label {
            label: Dnevnik
            alignment: left
        }
        settings {
            infiniteScroll: false
            maxValuesInList: 7
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    datum || CASE 
                        WHEN zakljucno_stanje IS null THEN
                            ''
                        ELSE
                            ' - Zaključano'
                    END AS d,
                    id AS r
                FROM
                    blagajna_dnevnik
                WHERE
                    blagajna_id = :P455_BLAGAJNA_ID
                    AND godina = :APP_GODINA
                ORDER BY
                    datum DESC
                ```
        }
        cascadingLov {
            parentItems: P455_BLAGAJNA_ID
            itemsToSubmit: P455_BLAGAJNA_ID
        }
        layout {
            sequence: 40
            region: @item-wrapper
            slot: item
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
