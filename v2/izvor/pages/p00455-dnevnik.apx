                plsqlCode:
                    ```plsql
                    SELECT
                        'dnevnik-' || datum || '.pdf'
                    INTO
                        :P455_FILENAME
                    FROM
                        blagajna_dnevnik
                    WHERE
                        id = :P455_DNEVNIK_ID;
                    ```
                itemsToSubmit: [
                    P455_DNEVNIK_ID
                    P455_FILENAME
                ]
                itemsToReturn: P455_FILENAME
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

