page 340 (
    name: Kalkulacije
    alias: KALKULACIJE-ROBE
    title: Kalkulacije
    pageGroup: @robno-materijalno
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @robno-materijalno-kalkulacije-robe
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region kalkulacije-naslov (
        name: Kalkulacije
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region wrapper (
        name: Wrapper
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: fin-page
        }
    )

    region faceted-search (
        name: Faceted Search
        type: smartFilters
        source {
            filteredRegion: @kalkulacije-report
        }
        layout {
            sequence: 9
            parentRegion: @wrapper
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P340_SEARCH (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

        filter P340_STATUS (
            type: checkboxGroup
            label {
                label: Status
            }
            lov {
                type: staticValues
                staticValues: STATIC2:U pripremi;priprema,Zaključena;zakljucena
            }
            layout {
                sequence: 20
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: DOK_STATUS
            }
        )

    )

    region kalkulacije-report (
        name: Kalkulacije
        title: Kalkulacije
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    naziv,
                    opis,
                    datum,
                    prijemnice,
                    fakture,
                    broj_prijemnica,
                    to_char(nabavna_vrijednost, 'FM999G999G999G990D00') AS nabavna_vrijednost,
                    to_char(iznos_faktura, 'FM999G999G999G990D00') AS iznos_faktura,
                    to_char(iznos_troskova, 'FM999G999G999G990D00') AS iznos_troskova,
                    status,
                    CASE WHEN status = 'Z' THEN 'zakljucena' ELSE 'priprema' END AS dok_status,
                    CASE WHEN status = 'Z' THEN 'Zaključena' ELSE 'U pripremi' END AS dok_status_naziv,
                    CASE WHEN status = 'Z' THEN 'fa-lock' ELSE 'fa-pencil' END AS dok_status_ikona,
                    apex_page.get_url(p_page => 341, p_items => 'P341_ID', p_values => id, p_clear_cache => 341) AS url
                FROM vw_rm_kalkulacije
                WHERE ooj_id = :APP_OOJ_ID
                  AND godina = :APP_GODINA
                  AND skladiste_id = :A_SKLADISTE_ID
                ORDER BY datum DESC, id DESC
                ```
        }
        layout {
            sequence: 10
            parentRegion: @wrapper
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema kalkulacija za izabrano skladište.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Kalkulacija
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                cssClasses: u-nowrap
            }
            link {
                target: {
                    type: url
                    url: #URL#
                }
                linkText: <span class="fin-doc"><span class="fin-doc__no">#NAZIV#</span>{if OPIS/}<span class="fin-sub">#OPIS#</span>{endif/}</span>
            }
            sorting {
                sortable: false
            }
        )

        column NAZIV (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 320
            }
        )

        column OPIS (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 330
            }
        )

        column DATUM (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                cssClasses: u-nowrap
                htmlExpression:
                    ```html
                    <span class="fin-date">#DATUM#</span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column PRIJEMNICE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Prijemnice / fakture
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    #PRIJEMNICE#{if FAKTURE/}<span class="fin-sub"><span class="fa fa-file-text-o" aria-hidden="true"></span> #FAKTURE#</span>{endif/}
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column FAKTURE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 360
            }
        )

        column BROJ_PRIJEMNICA (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 370
            }
        )

        column NABAVNA_VRIJEDNOST (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Nabavna vrijednost
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            columnFormatting {
                cssClasses: fin-num fin-num--strong
                htmlExpression:
                    ```html
                    #NABAVNA_VRIJEDNOST#<span class="fin-num-sub">fakture #IZNOS_FAKTURA# · troškovi #IZNOS_TROSKOVA#</span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column IZNOS_FAKTURA (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 390
            }
        )

        column IZNOS_TROSKOVA (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 400
            }
        )

        column STATUS (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 410
            }
        )

        column DOK_STATUS (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 420
            }
        )

        column DOK_STATUS_NAZIV (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="fin-status fin-status--#DOK_STATUS#"><span class="fa #DOK_STATUS_IKONA#" aria-hidden="true"></span>#DOK_STATUS_NAZIV#</span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column DOK_STATUS_IKONA (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 440
            }
        )

        column URL (
            reportColumnQueryId: 15
            derivedColumn: N
            type: hidden
            layout {
                sequence: 450
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Nova kalkulacija
        layout {
            sequence: 10
            region: @kalkulacije-naslov
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 341
                clearCache: 341
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: A_SKLADISTE_ID
        }
    )

)
