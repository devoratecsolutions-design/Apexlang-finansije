page 253 (
    name: Organizaciona pripadnost
    alias: ORGANIZACIONA-PRIPADNOST
    title: Organizaciona pripadnost
    pageGroup: @osnovna-sredstva
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        height: 400
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region informacije-o-mjestu-troška (
        name: Informacije o mjestu troška
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
    )

    region wizard-progress (
        name: Wizard Progress
        type: list
        source {
            list: @wizard-osnovna-sredstva
        }
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @wizard-progress
        }
    )

    pageItem P253_LOKACIJA_ID (
        type: selectOne
        label {
            label: Lokacija
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        messages {
            noDataFoundMessage: Nema pronađenih podataka.
        }
        lov {
            type: sharedComponent
            lov: @lokacije
        }
        layout {
            sequence: 20
            region: @informacije-o-mjestu-troška
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            helpText: Lokacije možete kreirati i uređivati u okviru aplikacije Administracija > Lokacije.
        }
    )

    pageItem P253_OJ_ID (
        type: selectOne
        label {
            label: Organizaciona jedinica
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        messages {
            noDataFoundMessage: Nema pronađenih podataka.
        }
        lov {
            type: sharedComponent
            lov: @oj
        }
        layout {
            sequence: 10
            region: @informacije-o-mjestu-troška
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P253_PROSTORIJA_ID (
        type: selectOne
        label {
            label: Prostorija
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        messages {
            noDataFoundMessage: Nema pronađenih podataka.
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv as d,
                    id as r
                FROM
                    core.ooj_lokacija_prostorije
                WHERE
                    lokacija_id = :P253_LOKACIJA_ID
                    AND valid = 'Y'
                ```
        }
        cascadingLov {
            parentItems: P253_LOKACIJA_ID
        }
        layout {
            sequence: 40
            region: @informacije-o-mjestu-troška
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            helpText: "Upravljanje prostorijama vrši se kroz meni Administracija > Lokacije > [Odabrana lokacija] > Prostorije."
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--danger
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button next (
        buttonName: NEXT
        label: Dalje
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconRight
            ]
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Nazad
        layout {
            sequence: 20
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-chevron-left
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation oj-id-not-null (
        name: "OJ_ID NOT NULL "
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P253_OJ_ID
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P253_OJ_ID
        }
    )

    branch (
        execution {
            sequence: 10
            point: validating
        }
        behavior {
            target: {
                page: 252
            }
        }
        serverSideCondition {
            whenButtonPressed: @previous
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 254
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)

