    dynamicAction create-collection (
        name: Create collection
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @add
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_exist BOOLEAN;
                        l_query VARCHAR2(1000);
                    BEGIN
                        l_exist := apex_collection.collection_exists (
                            p_collection_name => 'OS_LIST'
                        );
                    
                        IF l_exist = True THEN
                            apex_collection.delete_collection (
                                p_collection_name => 'OS_LIST'
                            );
                        END IF;
                    
                        l_query := '
                            select 
                                column_value
                            from
                                apex_string.split(''' || :P267_OS_LIST || ''', '':'')
                        ';
                        apex_debug.message('DBG: ' || l_query);
                        apex_collection.create_collection_from_query (
                            p_collection_name => 'OS_LIST',
                            p_query => l_query
                        );
                    
                    END;
                    ```
                itemsToSubmit: P267_OS_LIST
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @vrijednosti-ig
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction sum (
        name: Sum
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P267_GLAVNA_KNJIGA_ID
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT
                        sum(iznos)
                    INTO
                        :P267_NABAVNA_VRIJEDNOST
                    FROM
                        glavna_knjiga_stavke
                    WHERE
                        glavna_knjiga_id = :P267_GLAVNA_KNJIGA_ID
                        AND osnovno_sredstvo_id = :P267_ID;
                    ```
                itemsToSubmit: [
                    P267_GLAVNA_KNJIGA_ID
                    P267_NABAVNA_VRIJEDNOST
                ]
                itemsToReturn: P267_NABAVNA_VRIJEDNOST
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation datum-not-null (
        name: Datum NOT NULL
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P267_DATUM
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P267_DATUM
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P267_SUM_VRIJEDNOSTI
        }
    )

    validation procenat-not (
        name: Procenat NOT > 100
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @vrijednosti-ig
            plsqlExpression: :PROCENAT <= 100
        }
        error {
            errorMessage: #COLUMN_HEADER# mora biti manja od 100
            associatedColumn: PROCENAT
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    validation sum (
        name: Sum
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P267_SUM_VRIJEDNOSTI <= :P267_NABAVNA_VRIJEDNOST
        }
        error {
            errorMessage: Suma vrijednosti ne može biti veća od nabavne sume.
        }
        serverSideCondition {
            whenButtonPressed: @activate
        }
    )

    process activate-chain (
        name: Activate - Chain
        type: executionChain
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 96439306202554230
        }
        serverSideCondition {
            whenButtonPressed: @activate
        }
    )

    process aktiviraj (
        name: Aktiviraj
        type: executeCode
        executionChain: @activate-chain
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    CURSOR os_list IS (
                        SELECT
                            c001,
                            c002
                        FROM
                            apex_collections
                        WHERE
                            collection_name = 'OS_LIST'
                    );
                     
                BEGIN
                    FOR os IN os_list LOOP
                        :P267_NALOG_ID := os_pkg.aktiviraj_osnovno_sredstvo (
                            p_id               => os.c001,
                            p_vrijednost       => os.c002,
                            p_godina           => :APP_GODINA,
                            p_datum            => :P267_DATUM,
                            p_glavna_knjiga_id => :P267_GLAVNA_KNJIGA_ID
                        );
                
                    END LOOP;
                END;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 96439954956554236
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        executionChain: @activate-chain
        settings {
            itemsToReturn: P267_NALOG_ID
        }
        execution {
            sequence: 60
        }
