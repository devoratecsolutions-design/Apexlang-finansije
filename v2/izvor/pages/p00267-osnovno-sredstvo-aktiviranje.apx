        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv || ' ( ' || inventurni_naziv || ' )' as d,
                    id as r
                FROM
                    sec_osnovna_sredstva
                WHERE
                    valid = 'Y'
                    AND ooj_id = :APP_OOJ_ID
                    AND priprema = 'N'
                    AND priprema_id = :P267_ID
                    AND history_id IS null
                ORDER BY
                    inventurni_broj ASC
