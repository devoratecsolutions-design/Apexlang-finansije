        name: Delete collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_exist BOOLEAN;
                BEGIN
                    l_exist := apex_collection.collection_exists (
                        p_collection_name => 'OS_LIST'
                    );
                
                    IF l_exist = True THEN
                        apex_collection.delete_collection (
                            p_collection_name => 'OS_LIST'
                        );
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 96436765337554204
        }
        serverSideCondition {
            type: request=Value
            value: start
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_os t_sec_osnovna_sredstva;
                BEGIN
                    l_os := t_sec_osnovna_sredstva();
                    l_os.id := :P267_ID;
                
                    os_pkg.get_osnovno_sredstvo (
                        p_os => l_os
                    );
                
                    :P267_INVENTURNI_NAZIV := l_os.inventurni_naziv;
                    :P267_NAZIV := l_os.naziv;
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 96437109801554208
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P267_ID
        }
    )

    process sum (
        name: Sum
        type: executeCode
        executionChain: @update-collection-chain
        source {
            plsqlCode:
                ```plsql
                SELECT 
                    sum(c002)
                INTO 
                    :P267_SUM_VRIJEDNOSTI
                FROM
                    apex_collections
                WHERE
                    collection_name = 'OS_LIST';
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 96439742338554234
        }
    )

    process update-collection-chain (
        name: Update collection - Chain
        type: executionChain
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 96439667359554233
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process update-collection-procentualna-vrijednost (
        name: Update collection - Procentualna vrijednost
        type: executeCode
        executionChain: @update-collection-chain
        editableRegion: @vrijednosti-ig
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_vrijednost NUMBER;
                BEGIN
                    l_vrijednost := to_number(:PROCENAT, '999G999G999G999G990D00') * :P267_NABAVNA_VRIJEDNOST / 100;
                
                    apex_collection.update_member_attribute (
                        p_collection_name => 'OS_LIST',
                        p_seq             => :SEQ_ID,
                        p_attr_number     => 2,
                        p_attr_value      => round(l_vrijednost, 2)
                    );
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 97429990875182231
        }
        serverSideCondition {
            type: item=value
            item: P267_TIP_VRIJEDNOSTI
            value: P
        }
    )

    process update-collection-tacna-vrijednost (
        name: Update collection - Tacna vrijednost
        type: executeCode
        executionChain: @update-collection-chain
        editableRegion: @vrijednosti-ig
        source {
            plsqlCode:
                ```plsql
                APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (
                    p_collection_name => 'OS_LIST',
                    p_seq             => :SEQ_ID,
                    p_attr_number     => 2,
                    p_attr_value      => to_number(:VRIJEDNOST, '999G999G999G999G990D00')
                );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 96437625508554213
        }
