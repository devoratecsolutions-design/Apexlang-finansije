                ```sql
                SELECT
                    c.seq_id,
                    os.id,
                    os.naziv,
                    os.inventurni_naziv,
                    os.inventurni_broj,
                    c.c002 as nabavna_vrijednost
                FROM
                    sec_osnovna_sredstva os
                    LEFT JOIN apex_collections c ON os.id = c.c001
                WHERE
                    c.collection_name = 'OS_LIST'
