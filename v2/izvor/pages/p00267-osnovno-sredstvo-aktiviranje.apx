    pageItem P267_GLAVNA_KNJIGA_ID (
        type: selectOne
        label {
            label: Nalog glavne knjige
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    vrsta_naloga_naziv || ' / ' || broj || ' ( ' || to_char(datum_knjizenja, 'DD.MM.YYYY') || ' )' AS d,
                    id AS r
                FROM (
                    SELECT
                        lpad(broj, 6, '0') as broj,
                        vrsta_naloga_naziv,
                        datum_knjizenja,
                        id
                    FROM
                        vw_glavna_knjiga gk
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND vrsta_naloga_sifra = 'UF'
                        AND proknjizeno = 'Y'
                        AND id NOT IN (
                            SELECT DISTINCT
                                glavna_knjiga_id
                            FROM
                                sec_osnovno_sredstvo_aktiviranja
                            WHERE
                                glavna_knjiga_id IS NOT null
                                AND priprema_id = :P267_ID
                        )
                        AND EXISTS (
                            SELECT
                                1
                            FROM
                                glavna_knjiga_stavke gks
                            WHERE
                                gks.glavna_knjiga_id = gk.id
                                AND osnovno_sredstvo_id = :P267_ID
                        )
                )
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

