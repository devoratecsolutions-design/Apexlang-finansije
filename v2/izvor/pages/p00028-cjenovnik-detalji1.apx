page 28 (
    name: Cjenovnik / Detalji
    alias: CJENOVNIK-DETALJI1
    title: Cjenovnik / Detalji
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region cjenovnik-detalji (
        name: Cjenovnik / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: fin-form
        }
    )

    region osnovno (
        name: Osnovni podaci
        title: Osnovni podaci
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @cjenovnik-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region opis-sekcija (
        name: Opis
        title: Opis
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @cjenovnik-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    region status (
        name: Status
        title: Status
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @cjenovnik-detalji
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Form--stretchInputs
            ]
            cssClasses: fin-section
        }
    )

    pageItem P28_ID (
        type: hidden
        layout {
            sequence: 10
            region: @cjenovnik-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P28_NAZIV (
        type: textField
        label {
            label: Naziv
            alignment: left
        }
        layout {
            sequence: 20
            region: @osnovno
            slot: regionBody
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P28_OOJ_ID (
        type: hidden
        layout {
            sequence: 20
            region: @cjenovnik-detalji
            slot: regionBody
        }
    )

    pageItem P28_OPIS (
        type: textarea
        label {
            label: Opis
            alignment: left
        }
        layout {
            sequence: 10
            region: @opis-sekcija
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @optional-above
            templateOptions: #DEFAULT#
            height: 4
        }
        validation {
            maxLength: 1000
        }
    )

    pageItem P28_SIFRA (
        type: textField
        label {
            label: Šifra
            alignment: left
        }
        layout {
            sequence: 10
            region: @osnovno
            slot: regionBody
            columnSpan: 4
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P28_TIP (
        type: radioGroup
        label {
            label: Vrsta cjenovnika
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @tip-cjenovnika
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @osnovno
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
    )

    pageItem P28_VALID (
        type: radioGroup
        label {
            label: Aktivno
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @status
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        validation {
            valueRequired: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P28_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P28_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P28_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P28_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation sifra-not-null (
        name: P28_SIFRA NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P28_SIFRA
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P28_SIFRA
        }
    )

    validation naziv-not-null (
        name: P28_NAZIV NOT NULL
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P28_NAZIV
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P28_NAZIV
        }
    )

    validation tip-not-null (
        name: P28_TIP NOT NULL
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P28_TIP
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P28_TIP
        }
    )

    validation sifra-jedinstvena (
        name: Šifra jedinstvena
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM cjenovnici
                WHERE ooj_id = :APP_OOJ_ID
                  AND upper(trim(sifra)) = upper(trim(:P28_SIFRA))
                  AND id != nvl(:P28_ID, -1)
                ```
        }
        error {
            errorMessage: Cjenovnik sa šifrom &P28_SIFRA. već postoji.
            associatedItem: @P28_SIFRA
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 248469345931804766
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_broj NUMBER;
                BEGIN
                    SELECT count(*) INTO l_broj FROM cjenovnik_stavke WHERE cjenovnik_id = :P28_ID;
                    IF l_broj = 0 THEN
                        SELECT count(*) INTO l_broj FROM skladista WHERE cjenovnik_id = :P28_ID;
                    END IF;
                    IF l_broj > 0 THEN
                        raise_application_error(-20104,
                            'Cjenovnik ima cijene ili je dodijeljen prodajnom mjestu i ne može se obrisati. Deaktivirajte ga (Aktivno = NE).');
                    END IF;
                    stavke_pkg.delete_cjenovnik(p_id => :P28_ID);
                END;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 240050588571044839
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                stavke_pkg.get_cjenovnik (
                    p_id     => :P28_ID,
                    p_ooj_id => :P28_OOJ_ID,
                    p_sifra  => :P28_SIFRA,
                    p_naziv  => :P28_NAZIV,
                    p_opis   => :P28_OPIS,
                    p_tip    => :P28_TIP,
                    p_valid  => :P28_VALID
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 240050221522044836
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P28_ID
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                stavke_pkg.insert_cjenovnik (
                    p_ooj_id => :APP_OOJ_ID,
                    p_sifra  => :P28_SIFRA,
                    p_naziv  => :P28_NAZIV,
                    p_opis   => :P28_OPIS,
                    p_tip    => :P28_TIP
                );
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 240050349901044837
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                stavke_pkg.update_cjenovnik (
                    p_id     => :P28_ID,
                    p_ooj_id => :APP_OOJ_ID,
                    p_sifra  => :P28_SIFRA,
                    p_naziv  => :P28_NAZIV,
                    p_opis   => :P28_OPIS,
                    p_tip    => :P28_TIP,
                    p_valid  => :P28_VALID
                );
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 240050483342044838
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

