page 425 (
    name: Normativ / Trošak / Detalji
    alias: NORMATIV-TROŠAK-DETALJI
    title: Normativ / Trošak / Detalji
    pageGroup: @proizvodnja
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region normativ-troskovi (
        name: Normativ Troskovi
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P425_ID (
        type: hidden
        layout {
            sequence: 20
            region: @normativ-troskovi
            slot: regionBody
        }
    )

    pageItem P425_IZNOS (
        type: numberField
        label {
            label: Iznos
            alignment: left
        }
        layout {
            sequence: 50
            region: @normativ-troskovi
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P425_NORMATIV_ID (
        type: hidden
        layout {
            sequence: 30
            region: @normativ-troskovi
            slot: regionBody
        }
    )

    pageItem P425_OPIS (
        type: textarea
        label {
            label: Opis
            alignment: left
        }
        settings {
            autoHeight: true
            charCounter: true
        }
        layout {
            sequence: 40
            region: @normativ-troskovi
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
            height: 5
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P425_VALID (
        type: radioGroup
        label {
            label: Aktivno
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @normativ-troskovi
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P425_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P425_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P425_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P425_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: REQUEST
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 151365267103383507
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                proizvodnja_pkg.delete_normativ_trosak (
                    p_id => :P425_ID
                );
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 151364898680383507
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                proizvodnja_pkg.get_normativ_trosak (
                    p_id          => :P425_ID,
                    p_normativ_id => :P425_NORMATIV_ID,
                    p_opis        => :P425_OPIS,
                    p_iznos       => :P425_IZNOS,
                    p_valid       => :P425_VALID
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 151363627911383506
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P425_ID
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                proizvodnja_pkg.insert_normativ_trosak (
                    p_normativ_id => :P425_NORMATIV_ID,
                    p_opis        => :P425_OPIS,
                    p_iznos       => to_number(:P425_IZNOS, '999G999G999G999G990D00')
                );
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 151364089774383506
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                proizvodnja_pkg.update_normativ_trosak (
                    p_id          => :P425_ID,
                    p_normativ_id => :P425_NORMATIV_ID,
                    p_opis        => :P425_OPIS,
                    p_iznos       => to_number(:P425_IZNOS, '999G999G999G999G990D00'),
                    p_valid       => :P425_VALID
                );
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 151364433595383507
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

