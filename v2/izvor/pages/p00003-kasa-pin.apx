page 3 (
    name: Kasa / PIN
    alias: KASA-PIN
    title: Kasa / PIN
    pageGroup: @kasa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_KASA_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P3_PIN (
        type: textField
        label {
            label: PIN
            alignment: left
        }
        layout {
            sequence: 20
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button accept (
        buttonName: ACCEPT
        label: Potvrdi
        layout {
            sequence: 10
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-arrow-circle-o-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation pin-check (
        name: PIN CHECK
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM sec_kase
                WHERE
                    id = :P3_KASA_ID
                    AND pin = :P3_PIN
                ```
        }
        error {
            errorMessage: Neispravan PIN.
            associatedItem: @P3_PIN
        }
    )

    process change (
        name: Change
        type: executeCode
        source {
            plsqlCode: :APP_KASA_ID := :P3_KASA_ID;
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Uspješno ste promijenili kasu.
        }
        advanced {
            executionMappingIdentifier: 44783825243024602
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1
            }
        }
    )

)

