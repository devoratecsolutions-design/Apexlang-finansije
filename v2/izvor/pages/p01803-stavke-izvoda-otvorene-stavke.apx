    dynamicAction odabir-transakcije (
        name: Odabir transakcije
        execution {
            sequence: 10
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .add-st
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --dodajemo transakciju izvoda u templejt za knjiženje
                    for r in (select 'A' as tip,izs.id as izvod_stavka_id, iz.id as izvod_id,iz.datum as datum_dokumenta, iz.opis opis_izvoda,  
                                                       izs.svrha_doznake as opis_transkacije,
                                                       izs.klijent_id as partner, izs.opstina as opstina, null as radnik,
                                                       izs.smjer as smjer_placanja,
                                                       izs.konto_id as konto,nvl(ko.otvorene_stavke,'N') as pracenje_os,  null as mjesto_tr, 
                                                       case when izs.smjer='P' then 'P' else 'D' end as strana_knjizenja,
                                                       case when izs.smjer='P' then -izs.iznos else izs.iznos  end as iznos, izs.rbr,
                                                       izs.valuta_id 
                                from accounting.izvodi iz 
                                join accounting.izvod_stavke izs on iz.id=izs.izvod_id
                                left join sif.acc_kontni_okvir_klase ko on ko.id=izs.konto_id
                                where izs.id=:P1803_ID)
                    loop
                        APEX_COLLECTION.ADD_MEMBER(
                                  p_collection_name => 'SADRZAJ_GK_IZVODI',
                                  p_c001 => r.tip,
                                  p_c002 => r.opis_izvoda,
                                  p_c003 => r.opis_transkacije,
                                  p_c004 => r.partner,
                                  p_c005 => r.opstina,
                                  p_c006 => r.radnik,
                                  p_c007 => r.smjer_placanja,
                                  p_c008 => r.mjesto_tr,
                                  p_c009 => r.strana_knjizenja,
                                  p_c010 => r.pracenje_os,
                                  p_c011 => null, --id otvorene stavke
                                  p_c012 => null, -- vezni dokument otvorene stavke 
                                  p_c013 => null, --opis veznog dokumenta
                                  p_c014 => 'N', -- red zakljucan za brisanje
                                  p_c015 => r.konto,
                                  p_c016 => r.valuta_id,
                                  p_n001 => abs(r.iznos),
                                  p_n002 => r.iznos,
                                  p_n003 => r.rbr,
                                  p_n004 => r.izvod_stavka_id,
                                  p_n005 => r.izvod_id,
                                  p_d001 => r.datum_dokumenta
                                ); 
                    end loop;       
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: console.log("test");
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    validation uvezivanje-stavki (
        name: Uvezivanje stavki
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE 
                
                v_d_p varchar2(1);
                v_predznak number;
                
                BEGIN 
                
                    ---da li je označena ijedna stavka --
                    IF APEX_APPLICATION.G_F01.COUNT = 0 THEN
                
                        return 'Neophodno je označiti barem jednu stavku!';
                
                    END IF;
                
                END ;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @uvezi-os
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                SELECT SIGN(n002) AS predznak_iznosa,c015 AS konto_id,c004  AS partner_id
                INTO       :P1803_PREDZNAK,:P1803_KONTO_ID,:P1803_PARTNER_ID
                FROM apex_collections
                WHERE collection_name = 'SADRZAJ_GK_IZVODI'
                AND seq_id = :P1803_SEQ_ID;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 272707767719771619
        }
    )

    process uvezivanje-stavki (
        name: Uvezivanje stavki
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                v_iznos_stavke_zatvaranja number;
                v_iznos_otvorene_stavke number;
                v_iznos_zatvaranja number;
                v_preostali_iznos_zatvaranja number:=1;
                v_partner_id number;
                v_konto_id number;
                v_radnik_id number;
                v_oj_id number;
                v_dokument varchar2(500);
                v_opis varchar2(1500);
                v_mt_naziv varchar2(500);
                v_konto_naziv varchar2(500);
                
                begin 
                
                SELECT n002
                INTO   v_iznos_stavke_zatvaranja
                FROM apex_collections
                WHERE collection_name = 'SADRZAJ_GK_IZVODI'
                AND seq_id = :P1803_SEQ_ID;
                
                FOR i IN 1 .. APEX_APPLICATION.G_F01.COUNT LOOP
                
                    select gs.otvoreni_iznos+nvl(kol.uparen_iznos,0), gs.klijent_id, gs.radnik_id, gs.kontna_klasa_id, gs.mjesto_troska_id,gsd.dokument, gsd.opis, mt.naziv, ko.naziv
                    into v_iznos_otvorene_stavke, v_partner_id, v_radnik_id, v_konto_id, v_oj_id,v_dokument,v_opis, v_mt_naziv, v_konto_naziv
                    from accounting.glavna_knjiga_stavke gs
                    left join sif.acc_mjesta_troska mt on mt.id=gs.mjesto_troska_id 
                    left join sif.acc_kontni_okvir_klase ko on ko.id = ko.kontna_klasa_id
                    LEFT JOIN accounting.gk_stavke_dokument gsd ON gsd.glavna_knjiga_stavka_id = gs.id
                    LEFT JOIN (
                                SELECT to_number(c011) AS id_os, SUM(n002) AS uparen_iznos
                                FROM apex_collections
                                WHERE collection_name = 'SADRZAJ_GK_IZVODI'
                                GROUP BY c011
                              ) kol ON kol.id_os = gs.id
                    where gs.id=APEX_APPLICATION.G_F01(i);
                
                    if v_preostali_iznos_zatvaranja!=0 then 
                
                        if i=1 then
                
                            if sign(v_iznos_stavke_zatvaranja)!=sign(v_iznos_stavke_zatvaranja+v_iznos_otvorene_stavke) then 
                
                                v_iznos_zatvaranja:=v_iznos_stavke_zatvaranja;
                                v_preostali_iznos_zatvaranja:=0;
                
                            else 
                
                                v_iznos_zatvaranja:=v_iznos_otvorene_stavke*-1;
                                v_preostali_iznos_zatvaranja:=v_iznos_stavke_zatvaranja+v_iznos_otvorene_stavke;
                
                            end if;
                
                                for r in (SELECT c001  AS tip,
                                        c002  AS opis_izvoda,
                                        c003  AS opis_transkacije,
                                        c004  AS partner,
                                        c005  AS opstina,
                                        c006  AS radnik,
                                        c007  AS smjer_placanja,
                                        c008  AS mjesto_tr,
                                        c009  AS strana_knjizenja,
                                        c010  AS pracenje_os,
                                        c011  AS id_os,
                                        c012  AS broj_vd,
                                        c013  AS opis_vd,
                                        c014  AS zakljucan,
                                        c015  AS konto,
                                        n001  AS iznos_original,
                                        n002  AS iznos,
                                        n003  AS rbr,
                                        n004  AS izvod_stavka_id,
                                        n005  AS izvod_id,
                                        d001  AS datum_dokumenta
                                    FROM apex_collections
                                    WHERE collection_name = 'SADRZAJ_GK_IZVODI'
                                    AND SEQ_ID=:P1803_SEQ_ID
                                    and n004!=0)
                
                                loop
                
                
                                   APEX_COLLECTION.UPDATE_MEMBER(
                                          p_collection_name => 'SADRZAJ_GK_IZVODI',
                                          p_seq  => :P1803_SEQ_ID,
                                          p_c001 => r.tip,
                                          p_c002 => r.opis_izvoda,
                                          p_c003 => r.opis_transkacije,
                                          p_c004 => v_partner_id,
                                          p_c005 => r.opstina,
                                          p_c006 => v_radnik_id,
                                          p_c007 => r.smjer_placanja,
                                          p_c008 => v_oj_id,
