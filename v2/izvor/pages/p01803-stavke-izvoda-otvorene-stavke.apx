    region stavka-izvoda (
        name: Stavka izvoda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    seq_id,
                    c003  AS opis_transkacije,
                    kl.naziv  AS partner,
                    lpad(gg.sifra, 3, '0')||'-'||gg.naziv AS opstina,
                    c006  AS radnik,
                    mt.sifra||'-'||mt.naziv  AS mjesto_tr,
                    rpad(ak.code, :APP_KONTO_DUZINA, '0')||'-'||ak.naziv AS konto,
                    case c009 when 'D' then 'Duguje' else 'Potražuje' end  AS strana_knjizenja,
                    n002  AS iznos,
                    n004  AS izvod_stavka_id
                FROM apex_collections k
                left join accounting.sec_klijenti kl on kl.id=k.c004
                left join sif.acc_kontni_okvir_klase ak on ak.id=k.c015
                left join sif.acc_mjesta_troska mt on mt.id=k.c008
                left join sif.sif_gradovi gg on gg.id=k.c005
                WHERE collection_name = 'SADRZAJ_GK_IZVODI'
                and seq_id=:P1803_SEQ_ID
                
                ```
        }
