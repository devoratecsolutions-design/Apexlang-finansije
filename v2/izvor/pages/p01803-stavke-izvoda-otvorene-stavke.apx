    region otvorene-stavke (
        name: Otvorene stavke
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_sql VARCHAR2(4000);
                BEGIN
                    l_sql := 'SELECT APEX_ITEM.CHECKBOX(1, gks.id) as označi, gks.id, gsd.dokument, gsd.opis, gks.iznos,gks.otvoreni_iznos+nvl(kol.uparen_iznos,0) otvoreni_iznos, 
                                     CASE WHEN gks.tip_stavke = ''P'' THEN ''Potražuje'' ELSE ''Duguje'' END AS strana_knjizena,
                                     RPAD(ak.code, :APP_KONTO_DUZINA, ''0'') || ''-'' || ak.naziv AS konto,
                                     LPAD(gg.sifra, 3, ''0'') || ''-'' || gg.naziv AS opstina,
                                     kl.naziv AS partner,
                                     gks.radnik_id,gks.datum_dokumenta
                                from accounting.glavna_knjiga gk 
                                join accounting.glavna_knjiga_stavke gks on gk.id=gks.glavna_knjiga_id
                                LEFT JOIN accounting.gk_stavke_dokument gsd ON gsd.glavna_knjiga_stavka_id = gks.id
                                LEFT JOIN accounting.sec_klijenti kl ON kl.id = gks.klijent_id
                                LEFT JOIN sif.acc_kontni_okvir_klase ak ON ak.id = gks.kontna_klasa_id
                                LEFT JOIN sif.sif_gradovi gg ON gg.id = gks.grad_id
                                LEFT JOIN (
                                            SELECT to_number(c011) AS id_os, SUM(n002) AS uparen_iznos
                                            FROM apex_collections
                                            WHERE collection_name = ''SADRZAJ_GK_IZVODI''
                                            GROUP BY c011
                                          ) kol ON kol.id_os = gks.id
                               WHERE gk.ooj_id=:APP_OOJ_ID
                               and gks.otvorena in (''O'',''DZ'') 
                               and (gks.otvoreni_iznos + NVL(kol.uparen_iznos, 0)) != 0 ';
                
                    IF :P1803_KONTO_ID IS NOT NULL AND :P1803_PARTNER_ID is  NOT NULL THEN
                        l_sql := l_sql || ' AND gks.kontna_klasa_id = :P1803_KONTO_ID AND gks.klijent_id = :P1803_PARTNER_ID ';
                    ELSIF :P1803_KONTO_ID IS NOT NULL THEN
                        l_sql := l_sql || ' AND gks.kontna_klasa_id = :P1803_KONTO_ID ';
                    ELSIF :P1803_PARTNER_ID IS NOT NULL THEN
                        l_sql := l_sql || ' AND gks.klijent_id = :P1803_PARTNER_ID ';
                    ELSE 
                        l_sql := l_sql || ' AND 1 = 0 ';
                    END IF;
                
                    IF :P1803_PREDZNAK = 1 THEN --isključivanje stvaki koje se ne mogu zatvoriti
                        l_sql := l_sql || ' AND gks.otvoreni_iznos < 0 ';
                    ELSIF :P1803_PREDZNAK = -1 THEN
                        l_sql := l_sql || ' AND gks.otvoreni_iznos > 0 ';
                    END IF;
                
                
                
                    l_sql := l_sql || ' ORDER BY gks.datum_dokumenta desc';
                
                    RETURN l_sql;
                END;
                ```
            pageItemsToSubmit: [
                P1803_PARTNER_ID
                P1803_KONTO_ID
                P1803_PREDZNAK
            ]
        }
