page 108 (
    name: Kasa / Detalji
    alias: KASA-DETALJI
    title: Kasa / Detalji
    pageGroup: @konfiguracija
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region kasa-detalji (
        name: Kasa / Detalji
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P108_BEARER (
        type: textField
        label {
            label: Bearer
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @kasa-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        help {
            helpText:
                ```html
                Obezbjeđene parametre (Bearer, PIN i Host) dobijate od ovlašćenog servisera i 
                unosite ih u pripadajuća polja radi aktivacije fiskalnog uređaja.
                ```
        }
    )

    pageItem P108_HOST (
        type: textField
        label {
            label: Host
            alignment: left
        }
        layout {
            sequence: 60
            region: @kasa-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P108_ID (
        type: hidden
        layout {
            sequence: 10
            region: @kasa-detalji
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P108_NAZIV (
        type: textField
        label {
            label: Naziv
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @kasa-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
    )

    pageItem P108_OOJ_ID (
        type: hidden
        layout {
            sequence: 20
            region: @kasa-detalji
            slot: regionBody
        }
    )

    pageItem P108_PIN (
        type: numberField
        label {
            label: PIN
            alignment: left
        }
        layout {
            sequence: 50
            region: @kasa-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 32
        }
    )

    pageItem P108_VALID (
        type: radioGroup
        label {
            label: Aktivno
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @kasa-detalji
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P108_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Kreiraj
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-plus-circle-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P108_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Obriši
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            cssClasses: u-color-9
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P108_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Ažuriraj
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-edit
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P108_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation bearer-not-null (
        name: Bearer NOT NULL
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P108_BEARER
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P108_BEARER
        }
    )

    validation host-not-null (
        name: Host NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P108_HOST
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P108_HOST
        }
    )

    validation naziv-not-null (
        name: Naziv NOT NULL
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P108_NAZIV
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P108_NAZIV
        }
    )

    validation pin-not-null (
        name: Pin NOT NULL
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P108_PIN
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P108_PIN
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 44746346608202831
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process delete (
        name: Delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sec_pkg.delete_kasa (
                    p_id => :P108_ID
                );
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 39642833270363938
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sec_pkg.get_kasa (
                    p_id     => :P108_ID,
                    p_ooj_id => :P108_OOJ_ID,
                    p_naziv  => :P108_NAZIV,
                    p_bearer => :P108_BEARER,
                    p_pin    => :P108_PIN,
                    p_host   => :P108_HOST,
                    p_valid  => :P108_VALID
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 39642582782363935
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P108_ID
        }
    )

    process insert (
        name: Insert
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sec_pkg.insert_kasa (
                    p_ooj_id => :APP_OOJ_ID,
                    p_naziv  => :P108_NAZIV,
                    p_bearer => :P108_BEARER,
                    p_host   => :P108_HOST,
                    p_pin    => :P108_PIN
                );
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 39642691772363936
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process update (
        name: Update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sec_pkg.update_kasa (
                    p_id     => :P108_ID,
                    p_ooj_id => :APP_OOJ_ID,
                    p_naziv  => :P108_NAZIV,
                    p_bearer => :P108_BEARER,
                    p_pin    => :P108_PIN,
                    p_host   => :P108_HOST,
                    p_valid  => :P108_VALID
                );
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 39642724593363937
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

