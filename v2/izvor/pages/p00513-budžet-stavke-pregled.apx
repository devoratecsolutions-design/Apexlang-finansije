    region suma-stavki-2 (
        name: Suma stavki
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH all_links AS (
                    -- Build parent-child relationships for all levels
                    SELECT CONNECT_BY_ROOT id AS root_id,
                           id AS child_id,
                           LEVEL AS lvl
                    FROM budzetske_stavke
                    WHERE
                        ooj_id = :APP_OOJ_ID
                    CONNECT BY PRIOR id = stavka_id
                    ORDER SIBLINGS BY
                        id
                ),
                sums AS (
                    SELECT bs.stavka_id,
                           SUM(bs.iznos) AS iznos
                    FROM vw_budzet_stavke bs
                    WHERE 
                        bs.budzet_id = :P513_BUDZET_ID
                        AND EXISTS (
                            SELECT
                                1
                            FROM
                                vw_budzet_oj oj
                            WHERE
                                oj.budzet_id = bs.budzet_id
                                AND oj.oj_id = bs.oj_id
                                AND oj.status_sifra != 10
                        )
                    GROUP BY bs.stavka_id
                )
                SELECT a.root_id AS stavka_id,
                       -- sum of itself
                       SUM(CASE WHEN a.root_id = a.child_id THEN NVL(s.iznos,0) END) AS sum_self,
                       -- sum of children only
                       SUM(CASE WHEN a.root_id <> a.child_id THEN NVL(s.iznos,0) END) AS sum_children,
                       -- total sum (self + children)
                       SUM(NVL(s.iznos,0)) AS sum_total
                FROM all_links a
                LEFT JOIN sums s
                       ON a.child_id = s.stavka_id
                GROUP BY a.root_id
                ORDER BY a.root_id;
                
                ```
        }
        layout {
            sequence: 20
            parentRegion: @suma-stavki-ukupno
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        breakFormatting {
            reportSumLabel: Ukupno
        }

