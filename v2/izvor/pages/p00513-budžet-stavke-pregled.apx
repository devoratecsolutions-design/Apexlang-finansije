    process get-data (
        name: Get data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                budzet_pkg.get_budzet (
                    p_id           => :P513_BUDZET_ID,
                    p_broj_mjeseci => :P513_BROJ_MJESECI,
                    p_godina       => :P513_GODINA,
                    p_status_sifra => :P513_BUDZET_STATUS_SIFRA
                );
                
                IF :P513_OJ_ID IS NOT null THEN
                    budzet_pkg.get_budzet_oj (
                        p_budzet_id => :P513_BUDZET_ID,
                        p_oj_id     => :P513_OJ_ID,
                        p_max_iznos => :P513_MAX_IZNOS,
                        p_suma      => :P513_SUMA
                    );
                ELSE
                    budzet_pkg.get_budzet (
                        p_id           => :P513_BUDZET_ID,
                        p_max_iznos    => :P513_MAX_IZNOS,
                        p_suma         => :P513_SUMA
                    );
                END IF;
                
                :P513_MAX_IZNOS := to_char(:P513_MAX_IZNOS, '999G999G999G999G990D00');
                :P513_SUMA := to_char(:P513_SUMA, '999G999G999G999G990D00');
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 145015409169488802
        }
    )

