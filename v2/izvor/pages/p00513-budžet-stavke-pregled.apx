    region suma-stavki (
        name: Suma stavki
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH all_links AS (
                    -- Build parent-child relationships for all levels
                    SELECT CONNECT_BY_ROOT id AS root_id,
                           id AS child_id,
                           LEVEL AS lvl
                    FROM budzetske_stavke
                    WHERE
                        ooj_id = :APP_OOJ_ID
                        AND (oj_id = :P513_OJ_ID OR oj_id is null)
                    CONNECT BY PRIOR id = stavka_id
                    ORDER SIBLINGS BY
                        id
                ),
                sums AS (
                    SELECT bs.stavka_id,
                           SUM(bs.iznos) AS iznos
                    FROM vw_budzet_stavke bs
                    WHERE bs.oj_id = :P513_OJ_ID
                      AND bs.budzet_id = :P513_BUDZET_ID
                    GROUP BY bs.stavka_id
                )
                SELECT a.root_id AS stavka_id,
                       -- sum of itself
                       SUM(CASE WHEN a.root_id = a.child_id THEN NVL(s.iznos,0) END) AS sum_self,
                       -- sum of children only
                       SUM(CASE WHEN a.root_id <> a.child_id THEN NVL(s.iznos,0) END) AS sum_children,
                       -- total sum (self + children)
                       SUM(NVL(s.iznos,0)) AS sum_total
                FROM all_links a
                LEFT JOIN sums s
                       ON a.child_id = s.stavka_id
                GROUP BY a.root_id
                ORDER BY a.root_id;
                
                ```
        }
        layout {
            sequence: 20
            parentRegion: @suma-stavki-oj
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
            showNullValuesAs: -
