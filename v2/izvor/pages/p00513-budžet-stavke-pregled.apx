                        #STATUS#
                    </span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column STATUS_COLOR_CODE (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 60
            }
        )

        column STATUS_SIFRA (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column STAVKA_ID (
            reportColumnQueryId: 1
            derivedColumn: N
