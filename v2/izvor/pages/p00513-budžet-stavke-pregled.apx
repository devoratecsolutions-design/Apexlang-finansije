page 513 (
    name: Budžet stavke / Pregled
    alias: BUDŽET-STAVKE-PREGLED
    title: Budžet stavke / Pregled
    pageGroup: @budžet
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region greške-u-unosu-oj (
        name: Greške u unosu / OJ
        title: Greške u unosu
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P513_OJ_ID
        }
    )

    region greške-u-unosu-ukupno (
        name: Greške u unosu / Ukupno
        title: Greške u unosu
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P513_OJ_ID
        }
    )

    region potrebni-periodi (
        name: Potrebni periodi
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH params AS (
                    -- Parameters
                    SELECT :P513_BROJ_MJESECI AS p_months,
                           :P513_GODINA AS p_year
                    FROM dual
                ),
                months AS (
                    SELECT LEVEL AS month_num,
                           ADD_MONTHS(TRUNC(TO_DATE(p.p_year, 'YYYY'), 'YYYY'), LEVEL - 1) AS first_day
                    FROM dual
                    CROSS JOIN params p
                    CONNECT BY LEVEL <= 12
                ),
                periods AS (
                    SELECT m.month_num,
                           m.first_day,
                           CEIL(m.month_num / p.p_months) AS q_num,
                           p.p_months
                    FROM months m
                    CROSS JOIN params p
                )
                SELECT 
                    'P' || q_num || ' = ' ||
                    TRIM(TO_CHAR(MIN(first_day), 'Month', 'NLS_DATE_LANGUAGE=''LATIN SERBIAN''')) ||
                    CASE WHEN p_months > 1 
                         THEN ' - ' || TRIM(TO_CHAR(MAX(first_day), 'Month', 'NLS_DATE_LANGUAGE=''LATIN SERBIAN'''))
                         ELSE ''
                    END AS display
                FROM periods
                GROUP BY q_num, p_months
                ORDER BY q_num;
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @value-attribute-pairs-row
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        heading {
            type: none
        }

        column DISPLAY (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Display
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

    )

    region premašen-budžet (
        name: Premašen budžet!
        type: staticContent
        source {
            htmlCode:
                ```html
                Maksimalan budžet organizacione jedinice iznosi: <b>&P513_MAX_IZNOS.</b>
                <br>
                Trenutni budžet iznosi: <b>&P513_SUMA.</b>
                ```
        }
        layout {
            sequence: 10
            parentRegion: @suma-stavki-oj
            slot: subRegions
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--wizard
                t-Alert--defaultIcons
                t-Alert--danger
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: to_number(:P513_SUMA, '999G999G999G999G990D00') > to_number(:P513_MAX_IZNOS, '999G999G999G999G990D00')
        }
    )

