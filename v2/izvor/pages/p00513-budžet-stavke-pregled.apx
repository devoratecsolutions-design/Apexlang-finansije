    region stavke-oj (
        name: Stavke OJ
        title: Stavke
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH params AS (
                    SELECT :P513_BROJ_MJESECI AS p_months,
                           :P513_GODINA AS p_year
                    FROM dual
                ),
                months AS (
                    SELECT LEVEL AS month_num,
                           ADD_MONTHS(TRUNC(TO_DATE(p.p_year, 'YYYY'), 'YYYY'), LEVEL - 1) AS first_day
                    FROM dual
                    CROSS JOIN params p
                    CONNECT BY LEVEL <= 12
                ),
                periods AS (
                    SELECT CEIL(m.month_num / p.p_months) AS q_num,
                           MIN(m.first_day) AS period_start,
                           MAX(m.first_day) AS period_end
                    FROM months m
                    CROSS JOIN params p
                    GROUP BY CEIL(m.month_num / p.p_months)
                ),
                stavke AS (
                    SELECT DISTINCT 
                        stavka_id 
                    FROM 
                        vw_budzet_stavke
                    WHERE
                        budzet_id = :P513_BUDZET_ID
                        AND oj_id = :P513_OJ_ID
                ),
                stavke_periods AS (
                    SELECT 
                        s.stavka_id,
                        p.q_num,
                        p.period_start,
                        p.period_end
                    FROM stavke s
                    CROSS JOIN periods p
                ),
                stavke_existing AS (
                    SELECT b.stavka_id,
                           CEIL(EXTRACT(MONTH FROM b.period) / p.p_months) AS q_num,
                           COUNT(DISTINCT NVL(b.projekat_id, -1)) AS projekti_cnt,
                           COUNT(*) AS cnt
                    FROM 
                        vw_budzet_stavke b
                        CROSS JOIN params p
                    WHERE 
                        EXTRACT(YEAR FROM b.period) = p.p_year
                        AND budzet_id = :P513_BUDZET_ID
                        AND oj_id = :P513_OJ_ID
                
                    GROUP BY 
                        b.stavka_id, 
                        CEIL(EXTRACT(MONTH FROM b.period) / p.p_months)
                )
                SELECT sp.stavka_id,
                       'P' || sp.q_num || ' = ' ||
                       TRIM(TO_CHAR(sp.period_start, 'Month', 'NLS_DATE_LANGUAGE=''LATIN SERBIAN''')) ||
                       CASE WHEN :P513_BROJ_MJESECI > 1 
                            THEN ' - ' || TRIM(TO_CHAR(sp.period_end, 'Month', 'NLS_DATE_LANGUAGE=''LATIN SERBIAN'''))
                            ELSE ''
                       END AS display,
                       sp.period_start,
                       se.cnt,
                       se.projekti_cnt,
                       CASE 
                            WHEN se.q_num IS NULL THEN 'Nepostojeći period'
                            WHEN se.cnt > se.projekti_cnt THEN 'Dupli period'
                            ELSE 'OK'
                       END AS status,
                       CASE 
                            WHEN se.q_num IS NULL THEN 'M'
                            WHEN se.cnt > se.projekti_cnt THEN 'D'
                            ELSE 'O'
                       END AS status_sifra,
                       CASE 
                            WHEN se.q_num IS NULL THEN 'u-color-9'
                            WHEN se.cnt > se.projekti_cnt THEN 'u-color-9'
                            ELSE 'u-color-5'
                       END AS status_color_code
                FROM stavke_periods sp
                LEFT JOIN stavke_existing se
                       ON sp.stavka_id = se.stavka_id
                      AND sp.q_num = se.q_num
                WHERE
                    se.q_num IS null 
                    OR se.cnt > se.projekti_cnt
                ORDER BY sp.stavka_id, sp.q_num;
                
                ```
        }
        layout {
            sequence: 30
            parentRegion: @greške-u-unosu-oj
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column CNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Broj stavki
            }
            layout {
