            templateOptions: [
                #DEFAULT#
                margin-bottom-sm
            ]
            cssClasses: fin-filters
        }
        serverSideCondition {
            type: item=value
            item: P251_VIEW_AS
            value: MAP
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P251_AKTIVIRANO_1 (
            type: radioGroup
