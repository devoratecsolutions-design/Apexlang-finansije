    region lista-osnovnih-sredstava-map (
        name: Lista osnovnih sredstava Map
        type: map
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    inventurni_naziv,
                    naziv,
                    nabavna_vrijednost,
                    datum,
                
                    oj_naziv,
                    oj_latitude,
                    oj_longitude,
                    lokacija_naziv,
                    lokacija_lat,
                    lokacija_lng,
                    prostorija_naziv,
                
                    indikator_id,
                    klasa_id,
                    oj_id,
                    lokacija_id,
                    prostorija_id,
                    priprema,
                    aktivirano,
                    valid
                FROM
                    vw_osnovna_sredstva
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND history_id IS null
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P251_VIEW_AS
            value: MAP
        }
        map {
            height: 480
        }
        controls {
            options: [
                mousewheelZoom
                scaleBar
                infiniteMap
                getBrowserLocation
            ]
        }
        initialPositionAndZoom {
            getPositionFromBrowser: true
        }
        attributes {
            messagesPosition: below
        }

        layer lokacija (
            name: Lokacija
            layout {
                sequence: 20
            }
            source {
                location: regionSource
            }
            columnMapping {
                geometryColumnDataType: longitudeLatitude
                longitudeColumn: LOKACIJA_LNG
                latitudeColumn: LOKACIJA_LAT
                primaryKeyColumn: ID
            }
            appearance {
                fillColor: #ffcc00
            }
            tooltip {
                advancedFormatting: true
                htmlExpression:
                    ```html
                    <b>Inventurni naziv: </b>&INVENTURNI_NAZIV.
                    <br>
                    <b>Naziv: </b>&NAZIV.
                    <br>
                    <b>Nabavna vrijednost: </b>&NABAVNA_VRIJEDNOST.
                    <br>
                    <b>Datum: </b>&DATUM.
                    ```
            }
            link {
                type: redirectThisApp
                target: {
                    page: 256
                    items: {
                        P256_ID: &ID.
                    }
                    clearCache: 256
                }
            }
            legend {
                enableToHide: false
            }
            messages {
                whenNoDataFound: Nema pronađenih podataka.
            }
        )

        layer organizaciona-jedinica (
            name: Organizaciona jedinica
            layout {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                geometryColumnDataType: longitudeLatitude
                longitudeColumn: OJ_LONGITUDE
                latitudeColumn: OJ_LATITUDE
                primaryKeyColumn: ID
            }
            appearance {
                fillColor: #ff9500
            }
            tooltip {
                advancedFormatting: true
                htmlExpression:
                    ```html
                    <b>Inventurni naziv: </b>&INVENTURNI_NAZIV.
                    <br>
                    <b>Naziv: </b>&NAZIV.
                    <br>
                    <b>Nabavna vrijednost: </b>&NABAVNA_VRIJEDNOST.
                    <br>
                    <b>Datum: </b>&DATUM.
                    ```
            }
            link {
                type: redirectThisApp
                target: {
                    page: 256
                    items: {
                        P256_ID: &ID.
                    }
                    clearCache: 256
                }
            }
            legend {
                enableToHide: false
            }
            messages {
                whenNoDataFound: Nema pronađenih podataka.
            }
        )

    )

    region lista-osnovnih-sredstava-report (
        name: Lista osnovnih sredstava Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    id,
                    inventurni_naziv,
                    naziv,
                    kolicina,
                
                    oj_naziv,
                    lokacija_naziv,
                    prostorija_naziv,
                
                    nabavna_vrijednost,
                    coalesce(knjigovodstvena_vrijednost, 0) as knjigovodstvena_vrijednost,
                    coalesce(amortizacija_vrijednost, 0) as amortizacija_vrijednost,
                    -- coalesce(povecanje_vrijednost, 0) as povecanje_vrijednost,
                    coalesce(prodajna_vrijednost, 0) as prodajna_vrijednost,
                    coalesce(manjak_vrijednost, 0) as manjak_vrijednost,
                    coalesce(otpis_vrijednost, 0) as otpis_vrijednost,
                    indikator_id,
                    indikator_naziv,
                    datum,
                    
                    klasa_id,
                    oj_id,
                    lokacija_id,
                    prostorija_id,
                    priprema,
                    aktivirano,
                    valid
                FROM
                    vw_osnovna_sredstva
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND history_id IS null
                ORDER BY
                    inventurni_broj DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: item=value
            item: P251_VIEW_AS
            value: REPORT
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlightOff
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }
        breakFormatting {
            reportSumLabel: Ukupno
        }
        download {
            csvExportEnabled: true
        }
        printing {
            enabled: true
        }
        output {
            linkText: Print
            format: pdf
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        column AKTIVIRANO (
            reportColumnQueryId: 22
            derivedColumn: N
            heading {
                heading: Aktivirano
            }
            layout {
                sequence: 250
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if AKTIVIRANO/}
                    <span class="t-Button t-Button--noLabel u-color-5 t-Button--iconLeft t-Button--small">
                        <span class="t-Icon t-Icon--left fa fa-check-circle-o"></span>
                    </span>
                    {else/}
                    <span class="t-Button t-Button--noLabel u-color-9 t-Button--iconLeft t-Button--small">
                        <span class="t-Icon t-Icon--left fa fa-circle-o"></span>
                    </span>
                    {endif/}
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column AMORTIZACIJA_VRIJEDNOST (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Amortizacija
                alignment: end
            }
            layout {
                sequence: 200
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
            serverSideCondition {
                type: item=value
                item: P251_ADDITIONAL
                value: Y
            }
        )

        column DATUM (
            reportColumnQueryId: 16
            derivedColumn: N
            heading {
                heading: Datum
            }
            layout {
                sequence: 120
            }
            sorting {
                sortable: false
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            layout {
                sequence: 40
            }
            link {
                target: {
                    page: 256
                    items: {
                        P256_ID: #ID#
                    }
                    clearCache: 256
                }
                linkText: <span class="fin-act" title="Uredi" aria-label="Uredi"><span class="fa fa-pencil" aria-hidden="true"></span></span>
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

