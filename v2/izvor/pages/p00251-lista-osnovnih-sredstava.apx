    process read-notification (
        name: Read notification
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                core.notifikacije_pkg.read_notification (
                    p_id => :P251_NOTIFICATION_ID
                );
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 108037412933600047
        }
        serverSideCondition {
            type: request=Value
            value: notification
        }
    )

