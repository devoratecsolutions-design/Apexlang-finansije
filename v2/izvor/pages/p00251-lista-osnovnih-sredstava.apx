        )

        filter P251_PRIPREMA_1 (
            type: radioGroup
            label {
                label: U pripremi
            }
            lov {
                type: sharedComponent
                lov: @da-ne
            }
            layout {
                sequence: 30
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: PRIPREMA
            }
        )

        filter P251_PROSTORIJA_ID_1 (
            type: checkboxGroup
            label {
                label: Prostorija
