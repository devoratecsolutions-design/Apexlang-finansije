            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        naziv as d,
                        id as r
                    FROM
                        core.ooj_lokacija_prostorije
                    ```
            }
            layout {
                sequence: 70
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: PROSTORIJA_ID
            }
        )

        filter P251_SEARCH_1 (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

        filter P251_VALID_1 (
            type: radioGroup
            label {
                label: Validno
            }
            lov {
                type: sharedComponent
                lov: @da-ne
            }
            layout {
                sequence: 90
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: VALID
            }
        )

    )

