page 60 (
    name: Izlazna faktura / Knjiženje
    alias: IZLAZNA-FAKTURA-KNJIŽENJE
    title: Izlazna faktura / Knjiženje
    pageGroup: @fakture-računi
    appearance {
        pageMode: modalDialog
        dialogTemplate: @drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons-bar (
        name: Buttons Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region informacije-o-fakturi (
        name: Informacije o fakturi
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    naziv_fakture,
                    datum_fakture,
                    iznos_fakture
                FROM
                    kif
                WHERE
                    id = :P60_ID
                ```
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                margin-top-none
            ]
        }
        componentAppearance {
            template: @contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-Report--hideNoPagination
            ]
        }

        column DATUM_FAKTURE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Datum
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column IZNOS_FAKTURE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Iznos
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column NAZIV_FAKTURE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Faktura
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

    )

    region stavke-naloga (
        name: Stavke naloga
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    lower(c001) AS automatsko_knjizenje_sifra,
                    c002 AS kontna_klasa_id,
                    c003 AS tip_stavke,
                    c004 AS iznos,
                    c005 AS pdv_indikator_id,
                    c006 AS klijent_id
                FROM
                    apex_collections
                WHERE
                    collection_name = 'KIF_KONTA'
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }

        column AUTOMATSKO_KNJIZENJE_SIFRA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Automatsko knjiženje šifra
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        naziv AS d,
                        lower(sifra) AS r
                    FROM
                        sif.acc_automatska_knjizenja
                        
                    ```
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column IZNOS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Iznos
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
        )

        column KLIJENT_ID (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Klijent
            }
            lov {
                type: sharedComponent
                lov: @sec-klijenti
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column KONTNA_KLASA_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Konto
            }
            lov {
                type: sharedComponent
                lov: @kontni-okvir-klase-ooj
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column PDV_INDIKATOR_ID (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: PDV indikator
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        sifra || ' - ' || naziv AS d,
                        id AS r
                    FROM
                        sif.acc_pdv_indikatori
                    WHERE
                        valid = 'Y'
                    ```
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column TIP_STAVKE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Tip stavke
            }
            lov {
                type: sharedComponent
                lov: @duguje-potrazuje
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P60_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P60_KNJIZI_YN (
        type: radioGroup
        label {
            label: Proknjiži komplet
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @da-ne
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        serverSideCondition {
            type: item=value
            item: P60_VIEW_ONLY
            value: N
        }
        help {
            helpText:
                ```html
                Ukoliko je odabrana opcije <b><em>"NE"</em></b> u tom slučaju će biti omogućena 
                naknadna korekcija u pregledu <b><em>"Naloga za knjiženje".</em></b>
                
                ```
        }
    )

    pageItem P60_NALOG_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P60_ORIG (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P60_VIEW_ONLY (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Odustani
        layout {
            sequence: 10
            region: @buttons-bar
            slot: close
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-box-arrow-in-west
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button knjizi (
        buttonName: KNJIZI
        label: Knjiži fakturu
        layout {
            sequence: 10
            region: @buttons-bar
            slot: create
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-book
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P60_VIEW_ONLY
            value: N
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation knjizi-not-null (
        name: Knjizi NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P60_KNJIZI_YN
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P60_KNJIZI_YN
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P60_NALOG_ID
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 157406321550873431
        }
        serverSideCondition {
            whenButtonPressed: @knjizi
            type: item=value
            item: P60_ORIG
            value: 54
        }
    )

    process knjizi (
        name: Knjizi
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P60_NALOG_ID := glavna_knjiga_pkg.knjizi_kif_single (
                    p_id              => :P60_ID,
                    p_ooj_id          => :APP_OOJ_ID,
                    p_godina          => :APP_GODINA,
                    p_proknjizeno     => :P60_KNJIZI_YN,
                    p_collection_only => 'N'
                );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 157406086445873428
        }
        serverSideCondition {
            whenButtonPressed: @knjizi
        }
    )

    process knjizi-collection-only (
        name: Knjizi - Collection only
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_nalog_id NUMBER;
                BEGIN
                    l_nalog_id := glavna_knjiga_pkg.knjizi_kif_single (
                        p_id              => :P60_ID,
                        p_ooj_id          => :APP_OOJ_ID,
                        p_godina          => :APP_GODINA,
                        p_proknjizeno     => 'N',
                        p_collection_only => 'Y'
                    );
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 157405721401873425
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P60_ID
        }
    )

    branch (
        name: Go To Page 201
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 201
                items: {
                    P201_ID: &P60_NALOG_ID.
                }
                clearCache: 201
            }
        }
        serverSideCondition {
            whenButtonPressed: @knjizi
            type: item=value
            item: P60_ORIG
            value: 50
        }
    )

)

