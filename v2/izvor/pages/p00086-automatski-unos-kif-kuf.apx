    region logovi-report (
        name: Logovi Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    null as list_title,
                    null as list_text,
                    null as list_badge,
                
                    filename,
                    komentar,
                    to_char(updated, 'DD.MM.YYYY HH24:MI:SS') as updated,
                
                    null as link,
                    status_color_code as icon_color_class,
                    'fa fa-gears' as icon_class
                FROM
                    vw_uio_history
                WHERE
                    ooj_id = :APP_OOJ_ID
                ORDER BY
                    id DESC
                ```
        }
        layout {
            sequence: 10
            parentRegion: @wrapper-logovi
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: [
                fin-list
                fin-list--media
            ]
        }
        componentAppearance {
            template: @media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                t-MediaList--stack
                t-MediaList--iconsRounded
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column FILENAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Filename
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column ICON_CLASS (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Icon Class
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
        )

        column ICON_COLOR_CLASS (
