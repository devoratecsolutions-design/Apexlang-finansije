    region učitani-kuf-fajl-pregled (
        name: Učitani KUF fajl (pregled)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH preview AS (
                    SELECT
                        rownum as rn,
                        p.line_number,
                        p.col001 as vrsta_sloga,
                        p.col002 as redni_br,
                        p.col003 as poreski_period,
                        p.col004 as tip_dokumenta,
                        p.col005 as broj_fakture,
                        p.col006 as datum_fakture,
                        p.col007 as datum_prijema_fakture,
                        p.col008 as naziv_dobavljaca,
                        p.col009 as sjediste_dobavljaca,
                        p.col010 as pdv_broj_dobavljaca,
                        p.col011 as jib_broj_dobavljaca,
                        p.col012 as iznos_fakture_bezpdv,
                        p.col013 as iznos_fakture_sapdv,
                        p.col014 as iznos_pausal,
                        p.col015 as iznos_ulaznog_pdv,
                        p.col016 as iznos_ulazpdv_odbiti,
                        p.col017 as iznos_ulazpdv_neodbiti,
                        p.col018 as iznos_pdv_32polje,
                        p.col019 as iznos_pdv_33polje,
                        p.col020 as iznos_pdv_34polje
                
                    FROM
                        apex_application_temp_files f, 
                        table( apex_data_parser.parse(
                            p_content      => f.blob_content,
                            p_file_name    => f.filename,
                            p_file_profile => apex_data_loading.get_file_profile( p_static_id => :P86_KUF_STATIC_ID ),
                            p_max_rows     => 500 ) 
                        ) p
                    WHERE 
                        f.name = :P86_KUF
                    ORDER BY
                        p.line_number
                )
                SELECT *
                FROM preview
                WHERE 
                    rn > :P86_KUF_BEFORE
                    -- AND rn <= (SELECT COUNT(*) FROM your_table) - N;
                ```
        }
