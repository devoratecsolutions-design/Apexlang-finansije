                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--danger
            ]
        }
        serverSideCondition {
            type: item=value
            item: P86_STATUS_SIFRA
            value: odbijeno
        }
    )

    region pretraga (
        name: Pretraga...
        type: smartFilters
        source {
            filteredRegion: @zahtjevi-report
        }
        layout {
            sequence: 10
            parentRegion: @svi-zahtjevi
            slot: subRegions
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P86_DATA_LOAD_STATUS_ID (
            type: radioGroup
            label {
                label: Status
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT
                        naziv as d,
                        id as r
                    FROM
                        sif.sif_statusi
                    WHERE
                        opis = 'Data Loading'
                    ```
            }
            layout {
                sequence: 20
            }
            listEntries {
                zeroCountEntries: disable
            }
            source {
                databaseColumn: DATA_LOAD_STATUS_ID
                dataType: number
            }
        )

        filter P86_SEARCH (
            type: search
            label {
                label: Pretraga...
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Pretraga...
            }
        )

    )

    region prihvaćeno (
