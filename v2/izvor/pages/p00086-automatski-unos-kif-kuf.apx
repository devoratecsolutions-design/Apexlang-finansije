    process load-kif (
        name: Load KIF
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_file            BLOB;
                    l_load_result     apex_data_loading.t_data_load_result;
                    l_collection_name VARCHAR2(64) := 'LOAD_KIF';
                BEGIN
                    SELECT 
                        blob_content
                    INTO 
                        l_file
                    FROM 
                        apex_application_temp_files
                    WHERE 
                        name = :P86_KIF;
                
                    l_load_result := apex_data_loading.load_data (
                        p_static_id    => :P86_KIF_STATIC_ID,
                        p_data_to_load => l_file 
                    );
                    :P86_KIF_ERROR_COUNT := l_load_result.error_rows;
                
                    <<RemoveRows>>
                    BEGIN
                        FOR c1 IN (
                            WITH preview AS (
                                SELECT  
                                    rownum as rn,
                                    seq_id
                                FROM
                                    apex_collections
                                WHERE
                                    collection_name = l_collection_name
                            )
                            SELECT *
                            FROM preview
                            WHERE
                                rn <= :P86_KIF_BEFORE
                                OR rn > (SELECT count(*) FROM apex_collections WHERE collection_name = l_collection_name) - :P86_KIF_AFTER
                        ) LOOP
                            apex_collection.delete_member (
                                p_collection_name => l_collection_name,
                                p_seq             => c1.seq_id
                            );
                        END LOOP;
                    END;
                
                END;
                
                
                
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 50555164486545136
        }
        serverSideCondition {
            whenButtonPressed: @upload-kif
        }
    )

