page 86 (
    name: Automatski unos KIF / KUF
    alias: AUTOMATSKI-UNOS-KIF-KUF
    title: Automatski unos KIF / KUF
    pageGroup: @uio-dokumentacija
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @uio-automatski-unos
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region automatski-unos-kif-kuf (
        name: Automatski unos KIF / KUF
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--showBreadcrumb
                t-BreadcrumbRegion--compactTitle
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region kif (
        name: KIF
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
