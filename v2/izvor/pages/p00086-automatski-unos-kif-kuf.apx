            }
            sorting {
                sortable: false
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: List Badge
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="t-Button t-Button--icon #ICON_COLOR_CLASS#">
                        #UPDATED#
                    </span>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: List Text
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: #KOMENTAR#
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: List Title
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: #FILENAME#
            }
            sorting {
                sortable: false
            }
        )

        column UPDATED (
