    region učitani-kif-fajl-pregled (
        name: Učitani KIF fajl (pregled)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH preview AS (
                    SELECT 
                        rownum as rn,
                        p.line_number,
                        p.col001 as vrsta_sloga, 
                        p.col002 as poreski_period, 
                        p.col003 as redni_br, 
                        p.col004 as tip_dokumenta, 
                        p.col005 as broj_fakture, 
                        p.col006 as datum_fakture, 
                        p.col007 as naziv_kupca, 
                        p.col008 as sjediste_kupca, 
                        p.col009 as pdv_broj_kupca, 
                        p.col010 as jib_broj_kupca, 
                        p.col011 as iznos_fakture, 
                        p.col012 as iznos_fakture_interne, 
                        p.col013 as iznos_fakture_izvozne, 
                        p.col014 as iznos_ostale_bez_pdv, 
                        p.col015 as iznos_osnovice_za_pdv, 
                        p.col016 as iznos_izlaz_pdv_za_pdv, 
                        p.col017 as iznos_osnovice_za_nepdv, 
                        p.col018 as iznos_izlaz_pdv_za_nepdv, 
                        p.col019 as iznos_pdv_32polje, 
                        p.col020 as iznos_pdv_33polje,
                        p.col021 as iznos_pdv_34polje
                    FROM
                        apex_application_temp_files f, 
                        table( apex_data_parser.parse (
                            p_content      => f.blob_content,
                            p_file_name    => f.filename,
                            p_file_profile => apex_data_loading.get_file_profile( p_static_id => :P86_KIF_STATIC_ID ),
                            p_max_rows     => 500 ) 
                        ) p
                    WHERE 
                        f.name = :P86_KIF
                    ORDER BY
                        p.line_number
                )
                SELECT *
                FROM preview
                WHERE 
                    rn > :P86_KIF_BEFORE
                    -- AND rn <= (SELECT COUNT(*) FROM your_table) - N;
                ```
        }
        layout {
            sequence: 50
            parentRegion: @kif
            slot: regionBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: fin-list
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P86_KIF
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }

        column BROJ_FAKTURE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Broj fakture
            }
            layout {
                sequence: 70
            }
            sorting {
