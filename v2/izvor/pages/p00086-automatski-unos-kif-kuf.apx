    dynamicAction dialog-closed-refresh (
        name: Dialog Closed - Refresh 1
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @zahtjevi-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @zahtjevi-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction submit-page-kif (
        name: Submit Page KIF
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P86_KIF
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P86_KIF
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction submit-page-kuf (
        name: Submit Page KUF
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P86_KUF
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P86_KUF
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation kif-example-not-null (
        name: KIF EXAMPLE NOT NULL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P86_KIF_EXAMPLE
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P86_KIF_EXAMPLE
        }
        serverSideCondition {
            whenButtonPressed: @upload
        }
    )

    validation kif-valid-type (
        name: KIF - VALID TYPE
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if apex_data_parser.assert_file_type(
                    p_file_name => :P86_KIF_FILENAME,
                    p_file_type => apex_data_parser.c_file_type_csv )
                then
                    return true;
                elsif apex_data_parser.assert_file_type(
                    p_file_name => :P86_KIF_FILENAME,
                    p_file_type => apex_data_parser.c_file_type_xlsx )
                then
                    return true;
                else
                    :P86_KIF := null;
                    return false;
                end if;
                ```
        }
        error {
            errorMessage: Pogrešan tip fajla.
            associatedItem: @P86_KIF
        }
        serverSideCondition {
            whenButtonPressed: @upload-kif
        }
    )

    validation kuf-example-not-null (
        name: KUF EXAMPLE NOT NULL
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P86_KUF_EXAMPLE
        }
        error {
            errorMessage: #LABEL# je obavezno polje za unos.
            associatedItem: @P86_KUF_EXAMPLE
        }
        serverSideCondition {
            whenButtonPressed: @upload
        }
    )

    validation kuf-valid-type (
        name: KUF - VALID TYPE
        execution {
            sequence: 40
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if apex_data_parser.assert_file_type(
                    p_file_name => :P86_KUF_FILENAME,
                    p_file_type => apex_data_parser.c_file_type_csv )
                then
                    return true;
                elsif apex_data_parser.assert_file_type(
                    p_file_name => :P86_KUF_FILENAME,
                    p_file_type => apex_data_parser.c_file_type_xlsx )
                then
                    return true;
                else
                    :P86_KUF := null;
                    return false;
                end if;
                ```
        }
        error {
            errorMessage: Pogrešan tip fajla.
            associatedItem: @P86_KUF
        }
        serverSideCondition {
            whenButtonPressed: @upload-kuf
        }
    )

    computation p86-kif-filename (
        itemName: P86_KIF_FILENAME
        execution {
            sequence: 30
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    filename
                FROM
                    apex_application_temp_files
                WHERE
                    name = :P86_KIF
                ```
        }
    )

    computation p86-kuf-filename (
        itemName: P86_KUF_FILENAME
        execution {
            sequence: 20
        }
        computation {
            sqlQuery:
                ```sql
                SELECT
                    filename
                FROM
                    apex_application_temp_files
                WHERE
                    name = :P86_KUF
                ```
