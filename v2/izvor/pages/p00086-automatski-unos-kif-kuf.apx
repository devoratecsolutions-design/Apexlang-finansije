    region zahtjevi-report (
        name: Zahtjevi Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    null as list_title,
                    null as list_text,
                    null as list_badge,
                
                    naziv,
                    data_load_status_id,
                    data_load_status_naziv,
                    data_load_kif_example_filename,
                    data_load_kuf_example_filename,
                
                    apex_page.get_url(
                        p_page        => 87,
                        p_items       => 'P87_ID',
                        p_values      => id,
                        p_clear_cache => 87
                    ) as link,
                    data_load_color_code as icon_color_class,
                    'fa fa-upload-alt' as icon_class
                
                FROM
                    core.vw_ooj
                WHERE
                    data_load_status_id IS NOT NULL
                ```
        }
        layout {
            sequence: 20
            parentRegion: @svi-zahtjevi
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: [
                fin-list
                fin-list--media
            ]
        }
        componentAppearance {
            template: @media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                t-MediaList--stack
                t-MediaList--iconsRounded
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Nema pronađenih podataka.
        }

        column DATA_LOAD_KIF_EXAMPLE_FILENAME (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Data Load Kif Example Filename
            }
            layout {
                sequence: 100
            }
        )

        column DATA_LOAD_KUF_EXAMPLE_FILENAME (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Data Load Kuf Example Filename
            }
            layout {
                sequence: 110
            }
        )

        column DATA_LOAD_STATUS_ID (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Data Load Status Id
            }
            layout {
                sequence: 50
            }
        )

        column DATA_LOAD_STATUS_NAZIV (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data Load Status Naziv
            }
            layout {
                sequence: 60
            }
        )

        column ICON_CLASS (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Icon Class
            }
            layout {
                sequence: 90
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Icon Color Class
            }
            layout {
                sequence: 80
            }
        )

        column LINK (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Link
            }
            layout {
                sequence: 70
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: List Badge
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="t-Button t-Button--icon #ICON_COLOR_CLASS#">
                        #DATA_LOAD_STATUS_NAZIV#
                    </span>
                    ```
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: List Text
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: KIF: <b>#DATA_LOAD_KIF_EXAMPLE_FILENAME#</b> / KUF: <b>#DATA_LOAD_KUF_EXAMPLE_FILENAME#</b>
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: List Title
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: #NAZIV#
            }
        )

        column NAZIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Naziv
            }
            layout {
                sequence: 40
            }
        )

    )

