            warnOnUnsavedChanges: doNotCheck
        }
    )

    button toggle (
        buttonName: TOGGLE
        label: Expand / Collapse Side Column
        layout {
            sequence: 10
            region: @buttons-wrapper
            slot: regionBody
        }
        appearance {
            buttonTemplate: @icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--pillEnd
            ]
            icon: fa-chevron-left
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: toggle-btn
        }
    )

    dynamicAction dialog-closed (
        name: Dialog Closed
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @stavke
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @stavke
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-2 (
        name: Dialog Closed
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @radna-snaga
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @radna-snaga
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-3 (
        name: Dialog Closed
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @troškovi
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @troškovi
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-4 (
        name: Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @normativ
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @normativ
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction expand-collapse-side-column (
        name: Expand / Collapse Side Column
        execution {
            sequence: 160
        }
        when {
            event: click
            selectionType: button
            button: @toggle
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: toggleSidebar();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction perform-search (
        name: Perform Search
        execution {
            sequence: 150
        }
        when {
            event: keypress
            selectionType: items
            items: P421_SEARCH
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: this.browserEvent.which === apex.jQuery.ui.keyCode.ENTER
        }

        action native-cancel-event (
            action: cancelEvent
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @master-records
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

