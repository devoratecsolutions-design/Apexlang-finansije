plugin contactQr (
    name: Contact QR
    staticId: THEME_220$CONTACT_QR
    theme: @universal-theme
    templateComponent {
        availableAs: partial
        partial:
            ```html
            <style>
                .qr-code-container {
                  text-align: center;
                }
              </style>
              {if EMP_NAME/}
              {if EMP_CELL/}
              {if EMP_EMAIL/}
            <div class="qr-code-container">
              <img src="https://api.qrserver.com/v1/create-qr-code/?data=BEGIN%3AVCARD%0AVERSION%3A3.0%0AFN%3A#EMP_NAME#%0ATEL%3A#EMP_CELL#%0AEMAIL%3A#EMP_EMAIL#%0AEND%3AVCARD%0A&size=#X_SIZE#x#Y_SIZE#" alt="QR Code">
            </div>
            {endif/}
            {endif/}
            {endif/}
            ```
    }
    component {
        standardAttributes: regionTemplateAttr
    }
    information {
        version: 1.0
    }
    subscription {
        master: @/220/templateComponent/contactQr/universal-theme
    }
)

