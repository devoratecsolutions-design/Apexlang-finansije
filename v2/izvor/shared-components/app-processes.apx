)

appProcess quick-navigation (
    name: quick_navigation
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            DECLARE
                l_code VARCHAR2(1000) := '
                    document.addEventListener("keydown", function(e) {
                      if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === "p") {
                        e.preventDefault();
                        console.log("hello world 1423");
                        apex.item("P0_QUICK_NAVIGATION").setValue("");
                        apex.theme.openRegion("quick_navigation_popup");
                      }
                    });
                ';
            
            BEGIN
                apex_javascript.add_onload_code (
                    p_code => l_code
                );
            END;
            ```
    }
    execution {
        sequence: 1
        point: afterRegions
    }
    config {
        buildOption: @feature-quick-navigation
    }
    subscription {
        master: @/200/quick-navigation
    }
)

