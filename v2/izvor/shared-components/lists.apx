list navigation-bar-applications (
    name: Navigation Bar - Applications
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            WITH apps AS (
                SELECT
                    a.grupa,
                    decode(a.grupa, 'CORP', 0, 'HR', 10, 'FIN', 20, 'ADD_ON', 30, 'ADMIN', 40) AS grupa_sort,
                    a.sequence,
                    a.naziv AS label,
                    apex_page.get_url(
                        p_application => a.application_id,
                        p_page        => 1
                    ) AS target,
                    a.icon AS image_attribute,
                    ROW_NUMBER() OVER (PARTITION BY a.grupa ORDER BY a.sequence) rn,
                    COUNT(*)    OVER (PARTITION BY a.grupa) cnt
                FROM sif.sif_aplikacije a
                WHERE
                    a.hub = 'Y'
                    OR EXISTS (
                        SELECT 1
                        FROM sif.sif_aplikacija_role ar
                        WHERE ar.sif_application_id = a.id
                          AND ar.rola_id IN (
                              SELECT kr.rola_id
                              FROM core.korisnik_role kr
                              WHERE kr.korisnik_id = :APP_USER_ID
                          )
                    )
            ),
            unioned AS (
                SELECT
                    1 AS lvl,
                    label,
                    target,
                    NULL AS image,
                    image_attribute,
                    grupa_sort,
                    sequence
                FROM apps
            
                UNION ALL
            
                SELECT
                    1,
                    '---',
                    'separator',
                    NULL,
                    NULL,
                    grupa_sort,
                    sequence + 0.5
                FROM apps
                WHERE rn = cnt
            )
            SELECT
                lvl,
                label,
                target,
                image,
                image_attribute,
                null as image_alt_attribute,
                
                null as attribute1,
                null as attribute2,
                null as attribute3,
                null as attribute4,
                null as attribute5,
                null as attribute6,
                null as attribute7,
                null as attribute8,
                null as attribute9,
                null as attribute10
            
            FROM unioned
            ORDER BY
                grupa_sort,
                sequence;
            
            ```
    }
    subscription {
        master: @/200/navigation-bar-applications
    }
)

list navigation-bar-klijenti (
    name: Navigation Bar - Klijenti
    source {
        type: sqlQuery
