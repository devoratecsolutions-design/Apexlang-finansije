list navigation-menu-blagajna-izvještaji (
    name: Navigation Menu - Blagajna - Izvještaji
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                1,
                naziv as label,
                apex_page.get_url (
                    p_page   => 459,
                    p_items  => 'P459_IZVJESTAJ_ID',
                    p_values => id
                ) as target,
                null as image,
                icon as image_attribute,
                null as image_alt_attribute,
                
                null as attribute1,
                null as attribute2,
                210 as attribute3,
                null as attribute4,
                null as attribute5,
                null as attribute6,
                null as attribute7,
                null as attribute8,
                null as attribute9,
                null as attribute10
            
            FROM
                sif.acc_izvjestaji i
            WHERE
                EXISTS (
                    SELECT
                        izvjestaj_id
                    FROM
                        sif.vw_izvjestaj_preduzetnici
                    WHERE
                        izvjestaj_id = i.id
                        AND tip_preduzetnika_sifra = :APP_TIP_PREDUZETNIKA_SIFRA
                )
                AND tip = 'BL'
            ORDER BY
                sequence, naziv
            ```
    }
)

