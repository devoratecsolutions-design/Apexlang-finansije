list dashboard-moduli-finansije (
    name: Dashboard - Moduli - Finansije

    entry glavna-knjiga (
        label: Glavna knjiga
        icon {
            imageIconCssClasses: fa-book
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 199
            }
        }
        userDefinedAttributes {
            1: Nalozi za knjiženje, izvještaji, PDV prijava
            6: u-color-2
        }
        security {
            authorizationScheme: @glavna-knjiga-osnovna
        }
    )

    entry izvodi (
        label: Izvodi i banke
        icon {
            imageIconCssClasses: fa-bank
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 1010
            }
        }
        userDefinedAttributes {
            1: Bankovni izvodi, žiro računi, kursne liste
            6: u-color-4
        }
        security {
            authorizationScheme: @izvodi-osnovna
        }
    )

    entry blagajna (
        label: Blagajna
        icon {
            imageIconCssClasses: fa-money
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 450
            }
        }
        userDefinedAttributes {
            1: Blagajnički dnevnik i izvještaji
            6: u-color-6
        }
        security {
            authorizationScheme: @blagajna-osnovni-pristup
        }
    )

    entry uio-dokumentacija (
        label: PDV / UIO
        icon {
            imageIconCssClasses: fa-percent
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 80
            }
        }
        userDefinedAttributes {
            1: KIF / KUF evidencija za UIO
            6: u-color-8
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT
                    1
                FROM
                    core.ooj
                WHERE
                    id = :APP_OOJ_ID
                    AND pdv_sistem = 'Y'
                ```
        }
        security {
            authorizationScheme: @uio-osnovna
        }
    )

)

list dashboard-moduli-imovina (
    name: Dashboard - Moduli - Imovina i zalihe

    entry osnovna-sredstva (
        label: Osnovna sredstva
        icon {
            imageIconCssClasses: fa-building-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 250
            }
        }
        userDefinedAttributes {
            1: Evidencija, amortizacija, popis i zaduživanje
            6: u-color-9
        }
        serverSideCondition {
            type: itemIsInColonDelimitedList
            item: APP_TIP_PREDUZETNIKA_SIFRA
            list: [
                doo
                ad
                vsp_dvojno
                vsp_prosto
            ]
        }
        security {
            authorizationScheme: @osnovna-sredstva-osnovna
