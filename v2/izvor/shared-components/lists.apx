list menu-dokumenti-ulaz (
    name: Menu - Dokumenti - Novi
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                1,
                vd.naziv AS label,
                apex_page.get_url (
                    p_page        => 331,
                    p_items       => 'P331_VRSTA_DOKUMENTA_ID',
                    p_values      => vd.id,
                    p_clear_cache => 331
                ) target,
                null AS image,
                null AS image_attribute,
                null AS image_alt_attribute,
                null AS attribute1,
                null AS attribute2,
                null AS attribute3,
                null AS attribute4,
                null AS attribute5,
                null AS attribute6,
                null AS attribute7,
                null AS attribute8,
                null AS attribute9,
                null AS attribute10
            FROM
                sif.vrste_dokumenata vd
                JOIN sif.acc_moduli m ON m.id = vd.acc_modul_id AND upper(m.sifra) = 'MAT'
            WHERE
                vd.ooj_id = :APP_OOJ_ID
                AND vd.valid = 'Y'
                AND rm_dokument_pkg.podrzana(vd.sifra) = 'Y'
                AND rm_dokument_pkg.u_modulu(vd.sifra, nvl(:A_RM_MODUL, 'ROB')) = 'Y'
            ORDER BY
                CASE WHEN rm_dokument_pkg.tip_kretanja(vd.sifra) = 'U' THEN 1 ELSE 2 END,
                vd.naziv
            ```
    }
)

list menu-godine (
    name: Menu - Godine
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT
                1,
                godina as label,
                apex_page.get_url (
                    p_page        => 1,
                    p_items       => 'APP_GODINA',
                    p_values      => godina,
                    p_clear_cache => 1,
                    p_request     => 'set_year'
                ) as target,
                null AS is_current_list_entry,
                null AS image, 
                null AS image_attribute,
                null AS image_alt_attribute,
                null AS attribute1,
                null AS attribute2,
                null AS attribute3,
                null AS attribute4,
                null AS attribute5,
                null AS attribute6,
                null AS attribute7,
                null AS attribute8,
                null AS attribute9,
                null AS attribute10
            FROM (
                SELECT DISTINCT
                    godina
                FROM
                    core.protokoli
                WHERE
                    ooj_id = :APP_OOJ_ID
            
                UNION
            
                SELECT DISTINCT
                    godina
                FROM
                    glavna_knjiga
                WHERE
                    ooj_id = :APP_OOJ_ID
            
                UNION
            
                SELECT
                    extract(year from sysdate)
                FROM
                    dual
            )
            ```
    }
)

list menu-kase (
    name: Menu - Kase
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                1,
                naziv AS label,
                CASE
                    WHEN id = :APP_KASA_ID THEN
                        null
                    ELSE
                        apex_page.get_url (
                            p_page        => 3,
                            p_items       => 'P3_KASA_ID',
                            p_values      => id,
                            p_clear_cache => 3
                        )
            
                END AS target,
                null AS image,
                null AS image_attribute,
                null AS image_alt_attribute,
                
                null AS attribute1,
                null AS attribute2,
                null AS attribute3,
                null AS attribute4,
                null AS attribute5,
                null AS attribute6,
                null AS attribute7,
                null AS attribute8,
                null AS attribute9,
                null AS attribute10
            FROM
                accounting.sec_kase
            WHERE
                valid = 'Y'
                AND ooj_id = :APP_OOJ_ID
            ```
    }
)

