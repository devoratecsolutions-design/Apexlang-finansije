authorization admin-preuzimanje-sesije (
    name: Admin - Preuzimanje sesije
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            RETURN core.korisnik_pkg.user_authorization (
                p_korisnik_id => :APP_USER_ID,
                p_role        => 'MAIN_ADMIN_RLE,SEC_ADMIN_SESIJA_RLE'
            );
            ```
    }
    error {
        errorMessage: Nemate pravo pristupa ovom modulu aplikacije
    }
    advanced {
        evaluationType: perSession
    }
    subscription {
        master: @/200/admin-preuzimanje-sesije
    }
)

