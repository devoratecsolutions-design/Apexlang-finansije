emailTemplate UIO_ODGOVOR (
    name: UIO ODGOVOR
    emailSubject: #SUBJECT#
    htmlFormat {
        header: <h1>#SUBJECT#</h1>
        body:
            ```html
            <p>Poštovani <b style="color: #112340;">#NAME#</b>,</p>
            <p>Obavještavamo Vas povodom vašeg zahtjeva za automatski unos KIF / KUF fajlova. Vaš zahtjev je obrađen.</p>
            {if ODGOVOR/}
                <p><table cellpadding="0" cellspacing="0" border="0">
                    <tr>
                        <td style="padding: 10px 20px; background-color: #00b98f; color: #ffffff; border-radius: 5px;">
                            Vaš zahtjev je odobren.
                        </td>
                    </tr>
                </table></p>
            {else/}
                <p><table cellpadding="0" cellspacing="0" border="0">
                    <tr>
                        <td style="padding: 10px 20px; background-color: #ba3a3a; color: #ffffff; border-radius: 5px;">
                            Vaš zahtjev je nažalost odbijen.
                        </td>
                    </tr>
                </table></p>
            {endif/}
            
            <p>Koristite dugme ispod da pristupite <b style="color: #112340;">ERP</b> korisničkoj aplikaciji:</p>
            <p><table cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td style="padding: 10px 20px; background-color: #112340; color: #ffffff; border-radius: 5px;">
                        <a href="#LOGIN_URL#" target="_" style="text-decoration: none; color:white">Prijava</a>
                    </td>
                </tr>
            </table></p>
            ```
        footer: #MAIL_FOOTER!RAW#
    }
    advanced {
