lov sekretarice (
    name: SEKRETARICE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                initcap(ime) || ' ' || initcap(prezime) || ' - ' || email AS d,
                id AS r
            FROM
                core.korisnici
            WHERE
                firma_id = :APP_FIRMA_ID
                AND valid = 'Y'
                AND core.korisnik_pkg.user_has_role(id, 'HR_SEKRETARICA_RLE') > 0
            ORDER BY
                ime,
                prezime
            ```
    }
    columnMapping {
        return: R
        display: D
    }
    subscription {
        master: @/200/sekretarice
    }
)

