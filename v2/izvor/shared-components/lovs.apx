lov poreski-period (
    name: PORESKI_PERIOD
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                month_name || ', ' || year as d,
                month as r
            FROM (
                SELECT 
                    trim(to_char(add_months(sysdate, -LEVEL + 1), 'Month', 'NLS_DATE_LANGUAGE = ''LATIN SERBIAN''')) AS month_name,
                    to_char(add_months(sysdate, -LEVEL + 1), 'YYYY') as year,
                    trunc(add_months(sysdate, -LEVEL + 1), 'MM') as month
                FROM 
                    DUAL
                CONNECT BY 
                    LEVEL <= 12
            )
            WHERE
                year = :APP_GODINA
            ORDER BY
                month DESC
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov poreski-period-char (
    name: PORESKI_PERIOD_CHAR
    source {
