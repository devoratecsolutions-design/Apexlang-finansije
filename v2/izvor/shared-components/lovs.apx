    name: IZVJESTAJI_MATERIJALNO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                naziv as d,
                id as r
            FROM
                sif.acc_izvjestaji i
            WHERE
                EXISTS (
                    SELECT
                        izvjestaj_id
                    FROM
                        sif.vw_izvjestaj_preduzetnici
                    WHERE
                        izvjestaj_id = i.id
                        AND tip_preduzetnika_sifra = :APP_TIP_PREDUZETNIKA_SIFRA
                )
                AND tip = 'MAT'
                AND valid = 'Y'
            ORDER BY
                sequence, naziv
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

