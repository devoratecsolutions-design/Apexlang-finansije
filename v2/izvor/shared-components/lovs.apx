lov skladista (
    name: SKLADISTA
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                lpad('.', (level * 3) - 3, '.') || naziv as d,
                id as r
            FROM
                skladista
            WHERE
                ooj_id = :APP_OOJ_ID
                AND valid = 'Y'
            CONNECT BY
                PRIOR id = nadredjeno_id
            START WITH
                nadredjeno_id IS null
            
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

