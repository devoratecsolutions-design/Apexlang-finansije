)

lov uio-i-tip-dokumenta (
    name: UIO_I_TIP_DOKUMENTA
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT  
                code || ' - ' || naziv as d, 
                id as r
            FROM
                sif.acc_uio_tipovi_dokumenata
            WHERE
                ui = 'I'
            ORDER BY
                code
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov uio-td-pi-52 (
    name: UIO_TD_PI_51
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ti.pdv_indikator_id id, ti.pdv_indikator_sifra||' - '||ti.pdv_indikator_naziv as naziv
            from sif.vw_uio_tip_dokumenta_pdv_indikatori ti
            where ti.valid='Y'
            and (ti.entitet_id=:P51_ENTITET_ID or :P51_ENTITET_ID is null or ti.entitet_id is null)
            and ti.ui='I'
            order by ti.pdv_indikator_sifra
            ```
    }
    columnMapping {
        return: ID
        display: NAZIV
    }
)

lov uio-td-pi-53 (
    name: UIO_TD_PI
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ti.pdv_indikator_id id, ti.pdv_indikator_sifra||' - '||ti.pdv_indikator_naziv as naziv
            from sif.vw_uio_tip_dokumenta_pdv_indikatori ti
            where ti.valid='Y'
            and ti.ui='I'
            order by ti.pdv_indikator_sifra
            ```
    }
    columnMapping {
        return: ID
        display: NAZIV
    }

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column NAZIV (
        heading {
            heading: Naziv
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

)

