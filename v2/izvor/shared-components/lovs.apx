lov acc-grupe-stavki (
    name: ACC_GRUPE_STAVKI
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                sifra || ' - ' || naziv as d,
                id as r
            FROM
                sif.acc_grupe_stavki
            WHERE
                valid = 'Y'
                AND (ooj_id is null or ooj_id = :APP_OOJ_ID)
            ```
    }
    columnMapping {
        return: R
        display: D
        defaultSort: D
    }
)

lov acc-if-stavke (
    name: ACC_IF_STAVKE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                
                ts.naziv as tip_stavke, sc.id,sc.sifra, sc.naziv, to_char(case c.tip when 'M' then cs.mpc else cs.vpc end, 'FM999G999G999G999G990D00') as jedinična_cijena
                
            FROM
                skladista skl 
                join cjenovnici c on c.id=skl.cjenovnik_id
                join cjenovnik_stavke cs on cs.cjenovnik_id=c.id and cs.valid='Y'
                join sec_stavke sc on sc.id=cs.stavka_id and sc.valid='Y'
                join sif.acc_tipovi_stavki ts on ts.id=sc.tip_stavke_id
            
            WHERE  skl.ooj_id = :APP_OOJ_ID
            AND skl.id=:A_SKLADISTE_ID
            order by ts.id, sc.naziv
            ```
    }
    columnMapping {
        return: ID
        display: NAZIV
    }

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column JEDINIČNA_CIJENA (
        heading {
            heading: Jedinična Cijena
        }
        layout {
            sequence: 50
        }
        source {
            dataType: varchar2
        }
    )

    column NAZIV (
        heading {
            heading: Naziv
        }
        layout {
            sequence: 40
        }
        source {
            dataType: varchar2
        }
    )

    column SIFRA (
