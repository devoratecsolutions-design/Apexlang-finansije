lov sec-klase-stavki (
    name: SEC_KLASE_STAVKI
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select lpad(unistr('\2003'), (level-1)*2, unistr('\2003'))
                   || case when connect_by_isleaf = 0 then '▾ ' else '• ' end
                   || k.naziv                                        as naziv,
                   ltrim(sys_connect_by_path(k.naziv, ' / '), ' / ') as putanja,
                   id                                              as r
            from (select * from sec_klase_stavki p where p.ooj_id=:APP_OOJ_ID) k
            where k.id not in (select id
                                from sec_klase_stavki
                               start with id = :P126_ID
                             connect by prior id = nadredjeno_id)
            start with k.nadredjeno_id is null
            connect by prior k.id = k.nadredjeno_id
            order siblings by k.naziv
            ```
    }
