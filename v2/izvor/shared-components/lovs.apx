lov sec-stavke-popup (
    name: SEC_STAVKE_POPUP
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ts.naziv as tip_stavke,sc.id , sc.sifra, sc.naziv, case when sc.valid='Y' then 'Aktivno' else 'Neaktivno' end as status
            from accounting.sec_stavke sc
            left join sif.acc_tipovi_stavki ts on sc.tip_stavke_id=ts.id
            where sc.ooj_id=:APP_OOJ_ID
            order by ts.id, to_number(sc.sifra) desc
            ```
    }
    columnMapping {
        return: ID
        display: SIFRA
    }

