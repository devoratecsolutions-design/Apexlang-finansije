lov acc-vezane-if-51 (
    name: ACC_VEZANE_IF_51
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select k.id, k.naziv_fakture,k.datum_fakture,av.sifra as valuta,to_char(k.valuta_iznos, 'FM999G999G999G990D00') as iznos
            from kif k
            join sif.vrste_dokumenata vd on vd.id=k.vrsta_fakture_id
            join sif.acc_valute av on av.id=k.valuta_id
            where k.ooj_id=:APP_OOJ_ID
            and NVL(k.stornirano,'N')='N'
            and vd.sifra='IF'
            and k.klijent_id = :P51_KLIJENT_ID
            and :P51_VRSTA_FAKTURE_SIFRA IN ('KO','KZ')
            and k.skladiste_id=:A_SKLADISTE_ID
            union 
            select k.id, k.naziv_fakture,k.datum_fakture,av.sifra as valuta,to_char(sum(nvl(k.valuta_iznos,0)-nvl(kz.iznos,0)), 'FM999G999G999G990D00') iznos
            from kif k
            left join  kif_avansi_zatvaranje kz on kz.avans_id=k.id
            join sif.vrste_dokumenata vd on vd.id=k.vrsta_fakture_id
            join sif.acc_valute av on av.id=k.valuta_id
            where k.ooj_id=:APP_OOJ_ID
            and NVL(k.stornirano,'N')='N'
            and vd.sifra='AV'
            and k.klijent_id = :P51_KLIJENT_ID
            and :P51_VRSTA_FAKTURE_SIFRA='AVZ'
            and k.skladiste_id=:A_SKLADISTE_ID
            group by k.id, k.naziv_fakture,k.datum_fakture, av.sifra
            having sum(nvl(k.valuta_iznos,0)-nvl(kz.iznos,0))>0
            ```
    }
    columnMapping {
        return: ID
        display: NAZIV_FAKTURE
    }

    column DATUM_FAKTURE (
        heading {
            heading: Datum
        }
        layout {
            sequence: 30
        }
        source {
            dataType: date
        }
    )

    column ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column IZNOS (
        heading {
            heading: Raspoloživi iznos
        }
        layout {
            sequence: 50
        }
        source {
            dataType: varchar2
        }
    )

    column NAZIV_FAKTURE (
        heading {
            heading: Naziv
        }
