lov sif-aplikacije-dostupne (
    name: SIF_APLIKACIJE_DOSTUPNE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                naziv AS d,
                id AS r
            
            FROM
                sif.sif_aplikacije a
            WHERE
                hub = 'Y'
                OR EXISTS (
                    SELECT 1
                    FROM sif.sif_aplikacija_role ar
                    WHERE 
                        sif_application_id = a.id
                        AND rola_id IN (SELECT rola_id FROM core.korisnik_role WHERE korisnik_id = :APP_USER_ID)
                )
            ORDER BY
                sequence
            ```
    }
    columnMapping {
        return: R
        display: D
    }
    subscription {
        master: @/200/sif-aplikacije-dostupne
    }
)

