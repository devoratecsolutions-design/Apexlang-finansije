lov acc-mjesta-troska-hij (
    name: ACC_MJESTA_TROSKA_HIJ
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select lpad(unistr('\2003'), (level-1)*2, unistr('\2003'))
                   ||  case when connect_by_isleaf = 0 then '▾ ' else '• ' end
                   || k.sifra || ' - ' || k.naziv                   as naziv,
                   ltrim(sys_connect_by_path(k.sifra || ' - ' || k.naziv, ' / '), ' / ') as putanja,
                   k.id                                             as r
            from sif.acc_mjesta_troska k
            where k.valid <> 'N'
            and k.ooj_id=:APP_OOJ_ID
            and  k.id not in (select id
                                  from sif.acc_mjesta_troska
                                 start with id = :P131_ID
                               connect by prior id = nad_id)
            start with k.nad_id is null
            connect by prior k.id = k.nad_id
            order siblings by k.sifra
            
            ```
    }
    columnMapping {
        return: R
        display: NAZIV
    }

    column NAZIV (
        heading {
            heading: Naziv
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column PUTANJA (
        heading {
            heading: Putanja
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column R (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

)

