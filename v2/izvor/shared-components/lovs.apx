lov trebovanja (
    name: TREBOVANJA
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                naziv AS d,
                id AS r
            FROM
                trebovanja
            WHERE
                ooj_id = :APP_OOJ_ID
                AND valid = 'Y'
            ```
    }
    columnMapping {
        return: R
        display: D
        defaultSort: D
    }
)

lov ugovori (
    name: UGOVORI
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                naziv || ': ' || predmet AS d,
                id AS r
            FROM
                ugovori
            WHERE
                ooj_id = :APP_OOJ_ID
                AND valid = 'Y'
            ORDER BY
                broj DESC
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov ugovori-izvrsilac (
    name: UGOVORI_IZVRSILAC
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                naziv || ': ' || predmet AS d,
                id AS r
            FROM
                ugovori
            WHERE
                ooj_id = :APP_OOJ_ID
                AND valid = 'Y'
                AND izvrsilac_narucioc = 'I'
                AND (
                        (status = 'Z' AND (ugovor_end IS NULL OR ugovor_end >= trunc(sysdate)))
                        -- Uvijek vraća ugovor koji je već upisan na fakturi (stavka P<stranica>_UGOVOR_ID).
                        OR id = (SELECT to_number(v('P' || :APP_PAGE_ID || '_UGOVOR_ID')) FROM dual)
                    )
            ORDER BY
                broj DESC
            
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

