lov oj (
    name: OJ
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                lpad('.', (level * 3) - 3, '.') || naziv as d,
                id as r
            FROM
                core.oj
            WHERE
                ooj_id = :APP_OOJ_ID
                AND valid = 'Y'
            CONNECT BY
                PRIOR id = parent_id
            START WITH
                parent_id IS null
            ORDER SIBLINGS BY
                naziv
            ```
    }
    columnMapping {
        return: R
        display: D
    }
    subscription {
        master: @/200/oj
    }
)

