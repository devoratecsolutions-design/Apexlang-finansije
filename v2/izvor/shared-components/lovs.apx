lov sif-vrste-faktura (
    name: SIF_VRSTE_FAKTURA
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select vd.naziv as d, vd.id as r
            from sif.vrste_dokumenata vd
            join sif.acc_moduli am on vd.acc_modul_id = am.id
            where vd.valid = 'Y'
            and am.sifra = 'IF'
            and vd.id in (
                          select vrsta_naloga_id
                          from core.protokoli
                          where ooj_id = :APP_OOJ_ID
                          and godina = :APP_GODINA
                         )
            order by VD.id asc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

