                AND valid = 'Y'
                AND izvrsilac_narucioc = 'N'
                AND (
                        (status = 'Z' AND (ugovor_end IS NULL OR ugovor_end >= trunc(sysdate)))
                        -- Uvijek vraća ugovor koji je već upisan na fakturi (stavka P<stranica>_UGOVOR_ID).
                        OR id = (SELECT to_number(v('P' || :APP_PAGE_ID || '_UGOVOR_ID')) FROM dual)
                    )
