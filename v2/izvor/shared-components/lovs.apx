                    to_char(add_months(sysdate, -LEVEL + 1), 'YYYY') as year,
                    trunc(add_months(sysdate, -LEVEL + 1), 'MM') as month,
                    to_char(add_months(sysdate, -LEVEL + 1), 'MM.YYYY') as month_year
                FROM 
                    DUAL
                CONNECT BY 
                    LEVEL <= 12
            )
            WHERE
                year = :APP_GODINA
            ORDER BY
                month DESC
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

