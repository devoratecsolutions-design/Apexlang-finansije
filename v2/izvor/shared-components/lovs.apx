lov acc-klase-os (
    name: ACC_KLASE_OS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                lpad('.', (level * 3) - 3, '.') || sifra || ' - ' || naziv as d,
                id as r
            FROM
                sif.acc_klase_os
            WHERE
                ooj_id = :APP_OOJ_ID
                AND valid = 'Y'
            CONNECT BY
                PRIOR id = parent_id
            START WITH
                parent_id IS null
            ORDER SIBLINGS BY
                naziv
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov acc-klase-os-last-childs (
    name: ACC_KLASE_OS_LAST_CHILDS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT *
            FROM (
                SELECT
                    lpad('.', (level * 3) - 3, '.') || sifra || ' - ' || naziv as d,
                    id as r,
                    CONNECT_BY_ISLEAF as is_leaf
                FROM
                    sif.acc_klase_os
                WHERE
                    ooj_id = :APP_OOJ_ID
                    AND valid = 'Y'
                CONNECT BY
                    PRIOR id = parent_id
                START WITH
                    parent_id IS null
                ORDER SIBLINGS BY naziv 
            )
            WHERE
                is_leaf = 1
            ORDER BY
                d;
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

