lov global-godine (
    name: GLOBAL_GODINE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select extract(year from sysdate) - level + 1 as d,
                   extract(year from sysdate) - level + 1 as r
            from dual
            connect by level <= 10
            order by d desc;
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

