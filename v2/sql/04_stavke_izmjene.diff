+  1395      function klasa_ostalo (
+  1396          p_ooj_id in number
+  1397      ) return number is
+  1398          pragma autonomous_transaction;
+  1399          l_id number;
+  1400      begin
+  1401          select max(id) keep (dense_rank first order by case valid when 'Y' then 0 else 1 end, id)
+  1402            into l_id
+  1403            from sec_klase_stavki
+  1404           where ooj_id = p_ooj_id
+  1405             and nadredjeno_id is null
+  1406             and upper(trim(naziv)) = 'OSTALO';
+  1407  
+  1408          if l_id is null and p_ooj_id is not null then
+  1409              insert into sec_klase_stavki (ooj_id, nadredjeno_id, naziv)
+  1410              values (p_ooj_id, null, 'Ostalo')
+  1411              returning id into l_id;
+  1412              commit;
+  1413          end if;
+  1414  
+  1415          return l_id;
+  1416      end klasa_ostalo;
