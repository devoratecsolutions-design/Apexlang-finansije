+  1330      -- v2 (Stavke i cjenovnici) -----------------------------------------
+  1331      function pdv_stopa (
+  1332          p_stavka_id in number,
+  1333          p_ooj_id    in number default null
+  1334      ) return number is
+  1335          c_opsta_stopa constant number := 17;
+  1336      begin
+  1337          for c1 in (
+  1338              select
+  1339                  s.ooj_id,
+  1340                  s.pdv_indikator,
+  1341                  pi.vrijednost
+  1342              from
+  1343                  sec_stavke s
+  1344                  left join sif.acc_pdv_indikatori pi on pi.id = s.pdv_indikator_id
+  1345              where
+  1346                  s.id = p_stavka_id
+  1347          ) loop
+  1348              if nvl(core.ooj_pkg.get_ooj_pdv_sistem(coalesce(p_ooj_id, c1.ooj_id)), 'N') != 'Y' then
+  1349                  return 0;
+  1350              end if;
+  1351              -- poseban PDV indikator (oslobođenje, 0%) samo kad je izabran;
+  1352              -- "pun iznos" (ili bez indikatora) = opšta stopa
+  1353              if c1.pdv_indikator = 'N' and c1.vrijednost is not null then
+  1354                  return c1.vrijednost;
+  1355              end if;
+  1356              return c_opsta_stopa;
+  1357          end loop;
