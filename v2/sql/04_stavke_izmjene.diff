+  1362      function stavka_u_upotrebi (
+  1363          p_stavka_id in number
+  1364      ) return varchar2 is
+  1365          l_ima number;
+  1366      begin
+  1367          select count(*)
+  1368            into l_ima
+  1369            from dual
+  1370           where exists (select 1 from kif_stavke         where stavka_id = p_stavka_id)
+  1371              or exists (select 1 from ugovor_stavke      where stavka_id = p_stavka_id)
+  1372              or exists (select 1 from operacija_stavke   where stavka_id = p_stavka_id)
+  1373              or exists (select 1 from popis_stavke       where stavka_id = p_stavka_id)
+  1374              or exists (select 1 from trebovanje_stavke  where stavka_id = p_stavka_id)
+  1375              or exists (select 1 from normativi          where stavka_id = p_stavka_id)
+  1376              or exists (select 1 from normativ_stavke    where stavka_id = p_stavka_id)
+  1377              or exists (select 1 from radni_nalozi       where stavka_id = p_stavka_id)
+  1378              or exists (select 1 from radni_nalog_stavke where stavka_id = p_stavka_id);
+  1379  
+  1380          if l_ima = 0 then
+  1381              -- cijene modula (šema SIF): dinamički, da paket ne zavisi od granta
+  1382              begin
+  1383                  execute immediate
+  1384                      'select count(*) from sif.sif_moduli_cijene where stavka_id = :1 and rownum = 1'
+  1385                      into l_ima using p_stavka_id;
+  1386              exception
+  1387                  when others then
+  1388                      l_ima := 0;
+  1389              end;
+  1390          end if;
+  1391  
+  1392          return case when l_ima > 0 then 'Y' else 'N' end;
+  1393      end stavka_u_upotrebi;
